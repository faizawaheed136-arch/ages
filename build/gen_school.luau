AGES_SOURCES["src/server/content/LifeEvents/Adult.luau"] = "--!strict\n-- Ages 18 and up, including the elder years. Adulthood is the longest stretch\n-- of a life by far, so entries here are written to stay plausible across a wide\n-- age band rather than pinning to a specific year.\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal Types = require(ReplicatedStorage:WaitForChild(\"Types\"))\n\ntype LifeEvent = Types.LifeEvent\n\nlocal Adult: { LifeEvent } = {\n	{\n		id = \"adult_january\",\n		minAge = 18,\n		maxAge = 55,\n		delivery = \"NPCApproach\",\n		cast = \"neighbor\",\n		prompt = \"It's January and you've signed up for something that involves getting up early and hurting on purpose. The neighbor has seen you carrying the bag and has come to say what everyone is saying.\",\n		writesBack = { \"stat:happiness\", \"stat:health\", \"stat:looks\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"stick\",\n				label = \"Actually go, every week\",\n				outcome = \"You went for eleven months straight. You felt better than you had in years and became insufferable about it.\",\n				effects = { health = 7, looks = 4, happiness = 2 },\n			},\n			{\n				id = \"twice\",\n				label = \"Go twice and quietly stop\",\n				outcome = \"You went twice. The charge kept coming out for another fourteen months before you noticed.\",\n				effects = { happiness = -2, health = 1 },\n			},\n			{\n				id = \"own_way\",\n				label = \"Cancel it and just walk everywhere instead\",\n				outcome = \"You walked. Everywhere, in all weathers, for years. It did more than the membership ever would have.\",\n				effects = { health = 5, smarts = 2 },\n			},\n		},\n	},\n	{\n		id = \"adult_night_class\",\n		minAge = 20,\n		maxAge = 60,\n		delivery = \"Direct\",\n		prompt = \"There's a course you keep reading about. It runs on Tuesday evenings and you are, technically, free on Tuesday evenings.\",\n		writesBack = { \"stat:happiness\", \"stat:health\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"enroll\",\n				label = \"Enroll\",\n				outcome = \"You were the least experienced person in the room for about a month, and then you weren't.\",\n				effects = { smarts = 7, happiness = 3, health = -1 },\n			},\n			{\n				id = \"teach_self\",\n				label = \"Try to teach yourself instead\",\n				outcome = \"You got further than you expected and stalled at exactly the point a teacher would have helped.\",\n				effects = { smarts = 4, happiness = -1 },\n			},\n			{\n				id = \"next_year\",\n				label = \"Say you'll do it next year\",\n				outcome = \"You said that for six years running. You did eventually do it, and wished you'd started at the beginning.\",\n				effects = { happiness = -3, smarts = 1 },\n			},\n		},\n	},\n	{\n		id = \"adult_old_number\",\n		minAge = 25,\n		maxAge = 70,\n		delivery = \"NPCApproach\",\n		cast = \"friend\",\n		prompt = \"Someone you haven't seen in years is standing on the doorstep. You almost don't recognise them, and then you do.\",\n		writesBack = { \"stat:happiness\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"answer\",\n				label = \"Answer it\",\n				outcome = \"Two hours. You picked up somewhere in the middle of a conversation you'd left unfinished a decade earlier.\",\n				effects = { happiness = 7, smarts = 1 },\n			},\n			{\n				id = \"call_back\",\n				label = \"Let it ring and call back tomorrow\",\n				outcome = \"You called the next day, and the day after, and left it at that. You did meet up in the end, six months later.\",\n				effects = { happiness = 3 },\n			},\n			{\n				id = \"ignore\",\n				label = \"Leave it\",\n				outcome = \"You never called back. You thought about it every so often for years, usually late at night.\",\n				effects = { happiness = -5, smarts = 2 },\n			},\n		},\n	},\n	{\n		id = \"adult_check_up\",\n		minAge = 40,\n		maxAge = 75,\n		delivery = \"Direct\",\n		prompt = \"There's a letter about a routine appointment you've been putting off. It's been on the side for three weeks.\",\n		writesBack = { \"stat:happiness\", \"stat:health\" },\n		choices = {\n			{\n				id = \"go\",\n				label = \"Go\",\n				outcome = \"An hour of your life, mostly waiting. They found something small and early, and small and early is the whole game.\",\n				effects = { health = 8, happiness = -1 },\n			},\n			{\n				id = \"reschedule\",\n				label = \"Reschedule it for a better week\",\n				outcome = \"You rescheduled it twice and went in the end. It was fine, and you'd spent four months not knowing that.\",\n				effects = { health = 3, happiness = -2 },\n			},\n			{\n				id = \"throw_out\",\n				label = \"Throw it out, you feel fine\",\n				outcome = \"You threw it out. You did feel fine, right up until the point that stopped being the relevant question.\",\n				effects = { health = -6, happiness = 2 },\n			},\n		},\n	},\n	{\n		id = \"elder_early_walk\",\n		minAge = 65,\n		maxAge = 999,\n		delivery = \"Direct\",\n		prompt = \"You're awake before everyone else again. The light outside is doing something worth looking at.\",\n		writesBack = { \"stat:happiness\", \"stat:health\" },\n		choices = {\n			{\n				id = \"walk\",\n				label = \"Get up and go out into it\",\n				outcome = \"The same route, most mornings, for years. You knew every dog on it by name and half the owners by sight.\",\n				effects = { health = 5, happiness = 5 },\n			},\n			{\n				id = \"window\",\n				label = \"Watch it from the window with something hot\",\n				outcome = \"You sat with it until the street filled up. There are worse ways to start a day and you'd tried most of them.\",\n				effects = { happiness = 4, health = 1 },\n			},\n			{\n				id = \"back_to_sleep\",\n				label = \"Go back to sleep\",\n				outcome = \"You slept another two hours and missed it entirely. You'd earned it, and there would be other mornings.\",\n				effects = { health = 2, happiness = -1 },\n			},\n		},\n	},\n\n	-- Being unwell, grown up: the first illness with a job and a reason to go in\n	-- anyway. The doctor is a third answer only when money allows -- a price is a\n	-- gate, and a broke life has to make do with resting or pushing through.\n	{\n		id = \"adult_caught_something\",\n		minAge = 18,\n		maxAge = 75,\n		delivery = \"Direct\",\n		forbids = { \"sick\" },\n		weight = 0.5,\n		prompt = \"You're coming down with something, and you can't decide whether it's worth being sensible about. There's stuff that needs doing.\",\n		writesBack = { \"stat:happiness\", \"stat:health\", \"flag:sick\" },\n		choices = {\n			{\n				id = \"take_the_day\",\n				label = \"Take the day off\",\n				outcome = \"You stayed in and slept it off. The stuff waited, the way it always does, and you got back a day you'd have lost anyway.\",\n				effects = { health = 4, happiness = -1 },\n				sets = { \"sick\" },\n			},\n			{\n				id = \"power_through\",\n				label = \"Power through it\",\n				outcome = \"You did everything anyway, badly, with a hot face. It cost you more than it was worth, but you've never liked letting a day beat you.\",\n				effects = { happiness = 2, health = -3 },\n				sets = { \"sick\" },\n			},\n			{\n				id = \"see_a_doctor\",\n				label = \"See a doctor\",\n				outcome = \"You sat in a waiting room for an hour and a half and left with a prescription and a bill. You didn't feel clever. You did feel looked at.\",\n				cost = 120,\n				effects = { health = 6, happiness = 1 },\n				sets = { \"sick\" },\n			},\n		},\n	},\n}\n\nreturn Adult\n"
table.insert(AGES_MANIFEST, "src/server/content/LifeEvents/Adult.luau")
AGES_SOURCES["src/server/content/LifeEvents/Ambient.luau"] = "--!strict\n-- Events the world brings to you: mail on the mat, a phone ringing in the hall,\n-- someone at the door. Kept in their own file rather than mixed into the age\n-- files because they share a constraint the others don't -- none of them can\n-- fire below Ambient.MinAge, since a resolved event advances the year for a\n-- child and these arrive on their own schedule rather than on a birthday.\n--\n-- They also read differently on purpose. A letter or a call has already happened\n-- to you by the time you are reading it, so the prompt is what is in front of\n-- you rather than a situation you are standing in.\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal Types = require(ReplicatedStorage:WaitForChild(\"Types\"))\n\ntype LifeEvent = Types.LifeEvent\n\nlocal Ambient: { LifeEvent } = {\n	-- Letters. Patient by design -- they sit on the mat until the year turns --\n	-- so they suit the events where thinking about it is part of the point.\n	{\n		id = \"letter_school_report\",\n		minAge = 8,\n		maxAge = 12,\n		delivery = \"Letter\",\n		prompt = \"Your school report came in the post. It is face down on the mat and nobody has opened it yet.\",\n		writesBack = { \"stat:happiness\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"open_it\",\n				label = \"Open it yourself\",\n				outcome = \"You read it standing in the hall. It was worse in two places and better in one than you'd braced for, and knowing was easier than not knowing.\",\n				effects = { smarts = 3, happiness = -1 },\n			},\n			{\n				id = \"hand_it_over\",\n				label = \"Take it to your parents unopened\",\n				outcome = \"You handed it over and watched their face while they read it. They were kinder about it than you would have been.\",\n				effects = { happiness = 3, smarts = 1 },\n			},\n			{\n				id = \"hide_it\",\n				label = \"Put it under the stairs\",\n				outcome = \"It stayed under the stairs for eleven days. The school called on the twelfth, and the conversation you'd been avoiding happened anyway, just worse.\",\n				effects = { happiness = -5, smarts = 2 },\n			},\n		},\n	},\n	{\n		id = \"letter_the_thin_envelope\",\n		minAge = 17,\n		maxAge = 21,\n		delivery = \"Letter\",\n		prompt = \"The envelope you've been waiting on is here. It's thin. You've heard what a thin one usually means.\",\n		writesBack = { \"stat:happiness\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"read_now\",\n				label = \"Open it in the doorway\",\n				outcome = \"You tore it open on the spot. It was a no. You sat on the step for a while and then went inside and started working out what else there was.\",\n				effects = { happiness = -6, smarts = 5 },\n			},\n			{\n				id = \"wait\",\n				label = \"Put it in your pocket and open it later\",\n				outcome = \"You carried it around all day like it might change. It didn't, but by the time you opened it you'd already half-decided what you'd do either way.\",\n				effects = { smarts = 3, happiness = -2 },\n			},\n		},\n	},\n	{\n		id = \"letter_from_someone_gone\",\n		minAge = 30,\n		maxAge = 75,\n		delivery = \"Letter\",\n		prompt = \"Handwriting you recognize, from someone you stopped speaking to a long time ago. You don't know yet whether it's an apology.\",\n		writesBack = { \"stat:happiness\", \"stat:health\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"reply\",\n				label = \"Write back\",\n				outcome = \"You wrote back the same evening, badly, three times, and sent the third. It didn't fix it. It did end it properly, which turned out to be the thing you actually needed.\",\n				effects = { happiness = 7, health = 2 },\n			},\n			{\n				id = \"read_only\",\n				label = \"Read it and leave it at that\",\n				outcome = \"You read it twice and put it in a drawer. Some things you keep without answering, and that was allowed.\",\n				effects = { happiness = 2, smarts = 2 },\n			},\n			{\n				id = \"bin_it\",\n				label = \"Throw it away unopened\",\n				outcome = \"You put it straight in the bin and felt fine about it for about six years.\",\n				effects = { happiness = -4, smarts = 1 },\n			},\n		},\n	},\n\n	-- Calls. These expire, so they carry the events where being there mattered.\n	{\n		id = \"call_friend_at_midnight\",\n		minAge = 14,\n		maxAge = 22,\n		delivery = \"PhoneCall\",\n		prompt = \"It's late and the phone is ringing. It's your friend, and from the first word you can tell something has gone wrong.\",\n		writesBack = { \"stat:happiness\", \"stat:health\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"go_to_them\",\n				label = \"Get dressed and go to them\",\n				outcome = \"You walked twenty minutes in the cold and sat with them until it got light. Neither of you has ever really talked about it since, and neither of you has forgotten it.\",\n				effects = { happiness = 6, health = -2, smarts = 1 },\n			},\n			{\n				id = \"stay_on\",\n				label = \"Stay on the line as long as it takes\",\n				outcome = \"You stayed on until they were tired enough to sleep. Two hours, mostly quiet. It was enough.\",\n				effects = { happiness = 4, health = -1 },\n			},\n			{\n				id = \"tomorrow\",\n				label = \"Tell them you'll call in the morning\",\n				outcome = \"You did call in the morning, and they were fine, and it was never quite the same afterwards.\",\n				effects = { happiness = -4, health = 2 },\n			},\n		},\n	},\n	{\n		id = \"call_the_offer\",\n		minAge = 22,\n		maxAge = 55,\n		delivery = \"PhoneCall\",\n		prompt = \"They're offering you the job. More money, and a city you don't know anybody in. They want an answer on the phone.\",\n		writesBack = { \"stat:happiness\", \"stat:health\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"take_it\",\n				label = \"Say yes\",\n				outcome = \"You said yes before you could talk yourself out of it. The first year was lonely and the second one wasn't, and you'd do it again.\",\n				effects = { smarts = 6, happiness = -2, health = -1 },\n			},\n			{\n				id = \"decline\",\n				label = \"Say no\",\n				outcome = \"You turned it down and stayed where your people were. You thought about it now and then, without much regret.\",\n				effects = { happiness = 5, smarts = -2 },\n			},\n			{\n				id = \"negotiate\",\n				label = \"Ask for more and risk it\",\n				outcome = \"You asked. There was a long pause that took a year off your life, and then they agreed to most of it.\",\n				effects = { smarts = 5, happiness = 2, health = -2 },\n			},\n		},\n	},\n	{\n		id = \"call_from_the_hospital\",\n		minAge = 35,\n		maxAge = 80,\n		delivery = \"PhoneCall\",\n		prompt = \"It's the hospital. Someone you love is in, it isn't an emergency yet, and they're asking whether you want to come now or wait for news.\",\n		writesBack = { \"stat:happiness\", \"stat:health\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"go_now\",\n				label = \"Go now\",\n				outcome = \"You dropped everything and drove. You sat in a corridor for six hours for twenty minutes of being useful, and you have never once counted that as a bad trade.\",\n				effects = { happiness = 5, health = -3 },\n			},\n			{\n				id = \"wait_for_news\",\n				label = \"Wait for news\",\n				outcome = \"You waited by the phone and it was fine, and you were sensible, and it sat oddly with you for a long time after.\",\n				effects = { happiness = -3, health = 1, smarts = 1 },\n			},\n		},\n	},\n\n	-- Visitors. Someone walks in and says this to your face, so the choices are\n	-- things you say back rather than things you decide in private.\n	{\n		id = \"visit_come_out\",\n		minAge = 6,\n		maxAge = 14,\n		delivery = \"NPCApproach\",\n		cast = \"friend\",\n		prompt = \"Rae is at the door, out of breath, asking if you can come out. You're supposed to be doing something else.\",\n		writesBack = { \"stat:happiness\", \"stat:health\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"go\",\n				label = \"Go\",\n				outcome = \"You went. You were back late and in trouble for it, and it was one of about four afternoons from that whole year you can still see clearly.\",\n				effects = { happiness = 7, smarts = -2, health = 1 },\n			},\n			{\n				id = \"finish_first\",\n				label = \"Say you'll come when you're done\",\n				outcome = \"You finished what you were doing and went out an hour later. Rae had waited on the wall the whole time.\",\n				effects = { happiness = 3, smarts = 2 },\n			},\n			{\n				id = \"stay_in\",\n				label = \"Say you can't\",\n				outcome = \"You said no and watched from the window. You'd made the sensible call and it felt like nothing at all.\",\n				effects = { happiness = -3, smarts = 3 },\n			},\n		},\n	},\n	{\n		id = \"visit_the_ladder\",\n		minAge = 13,\n		maxAge = 65,\n		delivery = \"NPCApproach\",\n		cast = \"neighbor\",\n		prompt = \"Mr. Alderman is on the step. His gutter's come away at one end and he's asking, in a roundabout way that takes a while, whether you'd hold the ladder.\",\n		writesBack = { \"stat:happiness\", \"stat:health\", \"stat:looks\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"help\",\n				label = \"Hold the ladder\",\n				outcome = \"It took forty minutes and most of that was him talking. You learned more about the street in that time than in the ten years you'd lived on it.\",\n				effects = { happiness = 4, smarts = 2, health = -1 },\n			},\n			{\n				id = \"do_it_yourself\",\n				label = \"Send him inside and go up yourself\",\n				outcome = \"You went up instead. It was higher than it looked from the ground, and he made you a cup of tea you didn't want and stayed until you'd drunk it.\",\n				effects = { happiness = 3, health = -3, looks = 1 },\n			},\n			{\n				id = \"excuse\",\n				label = \"Say you're busy\",\n				outcome = \"You said you were busy, which was true, and closed the door. He got it done eventually. You still think about the noise the ladder made.\",\n				effects = { happiness = -3, smarts = 1 },\n			},\n		},\n	},\n	{\n		id = \"visit_the_quiet_word\",\n		minAge = 16,\n		maxAge = 40,\n		delivery = \"NPCApproach\",\n		cast = \"mom\",\n		prompt = \"Your mother has come round unannounced, which she doesn't do. She sits down before she says anything, which she really doesn't do.\",\n		writesBack = { \"stat:happiness\", \"stat:health\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"listen\",\n				label = \"Let her get to it\",\n				outcome = \"You let the silence run and she got there on her own. It took twenty minutes and it was worth every one of them.\",\n				effects = { happiness = 6, smarts = 2 },\n			},\n			{\n				id = \"press\",\n				label = \"Ask her outright what's wrong\",\n				outcome = \"You pushed and she told you, faster and flatter than she'd meant to. You both handled the rest of the afternoon carefully.\",\n				effects = { happiness = 2, smarts = 3 },\n			},\n			{\n				id = \"deflect\",\n				label = \"Fill the silence and talk about anything else\",\n				outcome = \"You talked about nothing for an hour and she left without saying it. She told you six months later, and by then it had been six months.\",\n				effects = { happiness = -5, health = -1 },\n			},\n		},\n	},\n\n	-- Being unwell, as something that came to the door. The one onset that can\n	-- reach any age it wants, so the health loop's sickness occasionally begins\n	-- here instead of on a birthday -- and being warned of it in person makes the\n	-- rest of the year read differently than a roll of the dice would.\n	{\n		id = \"ambient_flu\",\n		minAge = 13,\n		maxAge = 70,\n		delivery = \"NPCApproach\",\n		cast = \"friend\",\n		forbids = { \"sick\" },\n		weight = 0.5,\n		prompt = \"Rae is at the door, coat still on, voice half gone. 'I've got it,' they say. 'You've probably got it. I thought you'd want to know.'\",\n		writesBack = { \"stat:happiness\", \"stat:health\", \"stat:smarts\", \"flag:sick\" },\n		choices = {\n			{\n				id = \"let_them_in\",\n				label = \"Let them in anyway\",\n				outcome = \"You sat with them until it got dark, both of you wrecked and neither of you minded. Being ill with somebody is better than being ill alone.\",\n				effects = { happiness = 3, health = 2 },\n				sets = { \"sick\" },\n			},\n			{\n				id = \"send_them_home\",\n				label = \"Send them home to bed\",\n				outcome = \"You sent them off with a full kettle and watched them go. Sensible. You thought about them most of the evening, and then you went down with it yourself.\",\n				effects = { health = 1, happiness = -1, smarts = 1 },\n				sets = { \"sick\" },\n			},\n		},\n	},\n\n	-- Texture. These are the first repeatable ambient events, marked for exactly\n	-- the reason the field exists: a birthday comes round every year and a sale\n	-- comes round every few, and a life in this world should be able to live one\n	-- twice without the game pretending it is the first time either has happened.\n	-- Selection only reaches them after every fresh event has been lived, so they\n	-- are what the world does when it has no news, which is what a quiet life\n	-- mostly is.\n	{\n		id = \"ambient_neighbor_birthday\",\n		minAge = 12,\n		maxAge = 90,\n		delivery = \"NPCApproach\",\n		cast = \"neighbor\",\n		repeatable = true,\n		prompt = \"There's a knock and then the neighbor's voice through the letterbox, asking whether you're in. It is, it turns out, their birthday.\",\n		writesBack = { \"stat:happiness\", \"stat:health\", \"stat:looks\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"bring_something\",\n				label = \"Bring something over and stay for a bit\",\n				outcome = \"You crossed the street with whatever you had and sat in their kitchen until the evening ran out. They told you about the one before this one.\",\n				effects = { happiness = 5, looks = 1 },\n			},\n			{\n				id = \"sing_through_door\",\n				label = \"Sing badly through the letterbox\",\n				outcome = \"You did, from the pavement, and they laughed loud enough that the street heard. It was the right amount for the day.\",\n				effects = { happiness = 4, health = -1 },\n			},\n			{\n				id = \"wish_them\",\n				label = \"Wish them happy birthday and leave it there\",\n				outcome = \"You said it through the door and went back to what you were doing. They thanked you twice, which was worse than not thanking you.\",\n				effects = { happiness = -1, smarts = 1 },\n			},\n		},\n	},\n	{\n		id = \"ambient_shop_sale\",\n		minAge = 14,\n		maxAge = 999,\n		delivery = \"Letter\",\n		repeatable = true,\n		prompt = \"A leaflet came through the door -- the shop you actually use is having a clearance. There's a thing in the window you've looked at twice.\",\n		writesBack = { \"stat:happiness\", \"stat:looks\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"splurge\",\n				label = \"Buy the thing you keep looking at\",\n				outcome = \"You bought it at closing time. It was over in a week, and you got a month of looking at it first, which was the real part of the transaction.\",\n				cost = 20,\n				effects = { happiness = 4, looks = 1 },\n			},\n			{\n				id = \"browse\",\n				label = \"Browse and buy nothing\",\n				outcome = \"You went down and looked at everything and bought nothing, which is a free afternoon and one of the nicer kinds. The thing was still there the week after.\",\n				effects = { happiness = 2 },\n			},\n			{\n				id = \"bin_it\",\n				label = \"Put it straight in the recycling\",\n				outcome = \"You binned it without reading it. You walked past the shop twice that week and caught yourself wondering what you'd have spent.\",\n				effects = { smarts = 1, happiness = -1 },\n			},\n		},\n	},\n	{\n		id = \"ambient_first_frost\",\n		minAge = 16,\n		maxAge = 999,\n		delivery = \"NPCApproach\",\n		cast = \"neighbor\",\n		repeatable = true,\n		prompt = \"The first frost of the year is on the ground, and the neighbor is by the fence with a torch in one hand and a jacket in the other, asking if you've seen it.\",\n		writesBack = { \"stat:happiness\", \"stat:health\", \"stat:looks\" },\n		choices = {\n			{\n				id = \"join_them\",\n				label = \"Put on boots and go look at it\",\n				outcome = \"You walked the whole street with them in the dark, stamping on puddles to hear them crack. You knew every house by the light in its window.\",\n				effects = { happiness = 5, health = 2, looks = -1 },\n			},\n			{\n				id = \"window_frost\",\n				label = \"Look at it from the window\",\n				outcome = \"You waved from the warm side of the glass. The frost did its thing and the neighbor did theirs, and both were fine from where you stood.\",\n				effects = { happiness = 1, health = 1 },\n			},\n			{\n				id = \"not_yet\",\n				label = \"Tell them you'll see it tomorrow\",\n				outcome = \"You went back to bed, and the frost was gone by midday. It comes again every year, and you have never once caught the first one.\",\n				effects = { happiness = -3, health = 2 },\n			},\n		},\n	},\n}\n\nreturn Ambient\n"
table.insert(AGES_MANIFEST, "src/server/content/LifeEvents/Ambient.luau")
AGES_SOURCES["src/server/content/LifeEvents/CareerBranch.luau"] = "--!strict\n-- Career branching events. A life that has worked the shop floor once, or the\n-- office stairs, or the trades, carries a flag from that first time — and these\n-- events use it to ask whether the life goes deeper or wider.\n--\n-- They are not promotions. Promotions are numbers in a record. These are the\n-- moments where a life decides what kind of work it is, and the decision writes\n-- a new flag that only some future events will read.\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal Types = require(ReplicatedStorage:WaitForChild(\"Types\"))\n\ntype LifeEvent = Types.LifeEvent\n\nlocal CareerBranch: { LifeEvent } = {\n	-- The shop floor taught you the building. Now someone upstairs is asking\n	-- whether you would like to learn the other half, which is a different world\n	-- in the same walls and the same commute.\n	{\n		id = \"career_shop_to_office\",\n		minAge = 22,\n		maxAge = 55,\n		delivery = \"Direct\",\n		requires = { \"career_shop\" },\n		forbids = { \"career_office\" },\n		weight = 0.3,\n		prompt = \"Your manager's manager has seen you around. They ask whether you would like to shadow the office team for a week, which is a question nobody asks twice and you are not sure how to answer.\",\n		writesBack = { \"stat:happiness\", \"stat:smarts\", \"flag:career_office\" },\n		choices = {\n			{\n				id = \"shadow_yes\",\n				label = \"Take the week\",\n				outcome = \"You sat in meetings that moved at the speed of paper and learned the names of people you had passed in the corridor for a year. It was quieter and stranger than the shop and you wanted to stay.\",\n				effects = { smarts = 5, happiness = 2 },\n				sets = { \"career_office\" },\n			},\n			{\n				id = \"shadow_no\",\n				label = \"Say you're happier on the floor\",\n				outcome = \"You said it plainly and your manager nodded the way people nod when they have heard that answer before. The stairs stayed where they were.\",\n				effects = { happiness = 1, smarts = 1 },\n			},\n			{\n				id = \"shadow_sometimes\",\n				label = \"Ask to do it part-time\",\n				outcome = \"They said yes and you split your week between the two worlds. Neither one trusted you completely, which is the price of being good at more than one thing.\",\n				effects = { smarts = 4, happiness = -1 },\n				sets = { \"career_office\" },\n			},\n		},\n	},\n\n	-- The office had its logic. You learned it, and now you are tired of it, and\n	-- there is a trade that needs somebody who can read the paperwork as well as\n	-- they can hold a tool.\n	{\n		id = \"career_office_to_trades\",\n		minAge = 25,\n		maxAge = 50,\n		delivery = \"Direct\",\n		requires = { \"career_office\" },\n		forbids = { \"career_trades\" },\n		weight = 0.3,\n		prompt = \"A former colleague from the warehouse is buying a van and asking whether you want in. It is not a promotion and it pays worse at first, which is what makes the question feel real.\",\n		writesBack = { \"stat:happiness\", \"stat:health\", \"flag:career_trades\" },\n		choices = {\n			{\n				id = \"join_them\",\n				label = \"Take the van\",\n				outcome = \"Your hands learned a new alphabet. The paper you used to move with a pen you now moved with your arms, and it felt like leaving something and arriving somewhere at the same time.\",\n				effects = { health = 3, happiness = 2, smarts = -1 },\n				sets = { \"career_trades\" },\n			},\n			{\n				id = \"not_yet\",\n				label = \"Say you need more time\",\n				outcome = \"You meant it, and they understood, and they did not ask again for two years. By then it did not matter, because you had stopped wanting to.\",\n				effects = { happiness = -2, smarts = 1 },\n			},\n			{\n				id = \"consult\",\n				label = \"Ask for a trial day first\",\n				outcome = \"You spent eight hours in boots and got home with your back a different shape. You went back the next week, and the week after that, and the van was yours by the end of the month.\",\n				effects = { health = 2, happiness = 1, smarts = 1 },\n				sets = { \"career_trades\" },\n			},\n		},\n	},\n\n	-- The bakery taught you patience. Now someone wants to put you in the front\n	-- where people see you, which is a different kind of work and the same kind\n	-- of early morning.\n	{\n		id = \"career_bakery_front\",\n		minAge = 20,\n		maxAge = 60,\n		delivery = \"Direct\",\n		requires = { \"career_bakery\" },\n		weight = 0.2,\n		prompt = \"The owner has asked whether you would like to run the shop front on weekends. It means more customers and less flour, and a tip jar you do not have to share with anyone.\",\n		writesBack = { \"stat:happiness\", \"stat:looks\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"front_yes\",\n				label = \"Take the front\",\n				outcome = \"You learned the faces. Regulars became names, names became conversations, and the shop felt like a room you knew instead of a building you worked in.\",\n				effects = { looks = 2, happiness = 3, smarts = 1 },\n			},\n			{\n				id = \"back_yes\",\n				label = \"Stay in the back and bake more\",\n				outcome = \"You stayed where the heat was, and the bread got better, and the people who came in never knew how much of it had been your hands. That was fine.\",\n				effects = { smarts = 2, happiness = 1 },\n			},\n			{\n				id = \"neither\",\n				label = \"Ask for weekday mornings instead\",\n				outcome = \"They said yes and you traded the weekend crowd for the dawn, which was quieter and colder and exactly what you wanted.\",\n				effects = { health = 2, happiness = 2 },\n			},\n		},\n	},\n\n	-- You have been in the trades long enough to know which tools matter and which\n	-- ones are just there. Now someone is asking whether you can run a crew, which\n	-- is the difference between doing the work and deciding who does it.\n	{\n		id = \"career_trades_lead\",\n		minAge = 25,\n		maxAge = 60,\n		delivery = \"Direct\",\n		requires = { \"career_trades\" },\n		forbids = { \"career_office\", \"career_retired\" },\n		weight = 0.2,\n		prompt = \"The foreman has a bad knee and the company needs someone who can read the plans and tell the new people where to stand. It is not a promotion in title but it is one in practice.\",\n		writesBack = { \"stat:happiness\", \"stat:health\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"lead_take\",\n				label = \"Take it\",\n				outcome = \"You stood in different places now and talked to more people, and the work felt smaller and larger at the same time. The people listening to you had the same eyes you had had.\",\n				effects = { smarts = 4, happiness = 1, health = -1 },\n			},\n			{\n				id = \"lead_refuse\",\n				label = \"Stay on the tools\",\n				outcome = \"You said you were fine where you were, and the foreman believed you. The tools were heavy and the work was honest and you went home tired in a way that felt earned.\",\n				effects = { health = 2, happiness = 2 },\n			},\n			{\n				id = \"lead_split\",\n				label = \"Take it part-time, keep your crew\",\n				outcome = \"You split yourself between the plans and the ground, and some days you were good at neither. Both days were yours, which was the point and also the cost.\",\n				effects = { smarts = 2, happiness = -1, health = -1 },\n			},\n		},\n	},\n\n	-- Deliberate retirement. Not the kind that comes from a body that has had enough\n	-- but the kind a life chooses while it still can, which is the difference between\n	-- a number on a page and a sentence. Fires once the life has held any job for long\n	-- enough to have something to leave.\n	{\n		id = \"career_retire_deliberate\",\n		minAge = 55,\n		maxAge = 999,\n		delivery = \"Direct\",\n		requires = { \"career_shop\" },\n		forbids = { \"career_retired\" },\n		weight = 0.2,\n		prompt = \"You are tired of the thing you have been doing, and it has been a long thing. The question is not whether you can keep going — you can — but whether you want to, and that is a harder question than the first one.\",\n		writesBack = { \"flag:career_retired\", \"stat:happiness\", \"stat:health\" },\n		choices = {\n			{\n				id = \"leave_now\",\n				label = \"Leave while you still can\",\n				outcome = \"You walked out on a Tuesday and did not come back. The first month was the hardest and the second was the strangest, and by the third you had made a life that did not include the thing you had done for thirty years.\",\n				effects = { health = 3, happiness = 4 },\n				sets = { \"career_retired\" },\n			},\n			{\n				id = \"wind_down\",\n				label = \"Scale back instead\",\n				outcome = \"You moved to half-days and then quarter-days, and the people who depended on you found someone else. It was kinder than a door closing and slower than you expected.\",\n				effects = { health = 2, happiness = 2, smarts = 1 },\n				sets = { \"career_retired\" },\n			},\n			{\n				id = \"stay\",\n				label = \"Stay and do it until you cannot\",\n				outcome = \"You stayed, and the years kept coming, and one of them arrived when you could not climb the stairs anymore. You had known this might happen and you had chosen it anyway.\",\n				effects = { health = -2, happiness = -1 },\n			},\n		},\n	},\n}\n\nreturn CareerBranch\n"
table.insert(AGES_MANIFEST, "src/server/content/LifeEvents/CareerBranch.luau")
AGES_SOURCES["src/server/content/LifeEvents/Childhood.luau"] = "--!strict\n-- Ages 0-5. Answering one of these ends the year, so a life passes through\n-- roughly one per year and the pool has to be deep enough that two lives in a\n-- row don't look the same. The early ages are stocked hardest: a 0-1 band has\n-- the fewest eligible entries and is therefore the first place repetition shows.\n--\n-- Delivery is \"Wander\": the event is not handed over on the birthday, it is put\n-- somewhere across the room with its `lure` written over it and a line pointing at\n-- it, and crawling to it is what opens it. The writing always assumed a real place\n-- — a rug, a hedge, a plate — and this is that place finally existing. Adding an\n-- entry needs no code: copy the shape below.\n--\n--\n-- `lure` is not the prompt. It is what the thing says from thirty studs away and\n-- from behind, before the player knows what they are walking toward — the reason to\n-- go, never the content of what is there. \"Something big, and it has seen you\", not\n-- \"A dog wants to be petted\".\n--\n-- The outcomes are still written in the past tense, from before any of this was\n-- reachable (\"You have liked dogs unconditionally ever since\"). That is the next\n-- pass and it is content work, not code: the machinery had to be proved first.\n--\n-- Every entry here is answered by *doing* it rather than by picking off a panel\n-- — see the stamp at the bottom of the file, which is why no entry carries a\n-- `resolution` field of its own. This is where it earns the most: a toddler is\n-- already walking around a room, and a card appearing over that room is the thing\n-- that most obviously breaks it.\n--\n-- An entry whose choices carry an `act` goes further and has no panel at all. Its\n-- answers are objects put in the room around the player, and the answering is\n-- picking one up, pushing it, walking to it or standing still. A choice `label` on\n-- one of those is not a row, it is the words floating over the thing — so it is\n-- written as an instruction to a child who cannot read yet being read out by\n-- somebody who can, and it is capped by Config.Props.MaxLabelLength rather than the\n-- longer panel limit.\n--\n-- Every entry in this file now carries acts except one. `big_dog` is Enacted and stays\n-- that way: its three answers are gestures at an animal that reacts to each of them,\n-- so it has a subject to hang dots on and putting a rug in that room would be\n-- answering a different event. It is the only entry here with a subject, and that is\n-- not a coincidence -- an Enacted event without one has nothing to hang dots on and\n-- falls straight back to a panel, which is what the four \"vocal\" entries were quietly\n-- doing until they were converted.\n--\n-- Converting those four was the whole argument for the layer, because a word is the\n-- one answer with nothing to touch. The way through was that a word is always said\n-- *to* somebody: which word it was is the part the outcome can tell you, and who you\n-- crossed the room to say it at is the part only the player can decide, and they are\n-- the same decision. \"No\" turned out not to need saying at all -- refusing to move,\n-- shoving away the one thing you mind, and going out the door with them are the three\n-- things a two-year-old means by it.\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal Types = require(ReplicatedStorage:WaitForChild(\"Types\"))\n\ntype LifeEvent = Types.LifeEvent\n\nlocal Childhood: { LifeEvent } = {\n	{\n		id = \"childhood_first_word\",\n		minAge = 0,\n		maxAge = 1,\n		delivery = \"Wander\",\n		lure = \"The big faces are watching\",\n		-- A word is said to somebody, so the answer is who you take it to. Which word it\n		-- was is the part the outcome can tell you; who you crossed the room to say it\n		-- at is the part only the player can decide, and it is the same decision.\n		prompt = \"Sound is a game. Every noise you make, the big faces lean in and wait to find out what it was for.\",\n		writesBack = { \"stat:happiness\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"their_word\",\n				label = \"Say it back to them\",\n				act = { verb = \"Go\", at = { prop = \"grown_up\", distance = 11, offsetDegrees = -60 } },\n				outcome = \"You said it back. The room went up like you had won something.\",\n				effects = { smarts = 4, happiness = 3 },\n			},\n			{\n				id = \"own_word\",\n				label = \"Make up a word for this\",\n				act = { verb = \"Take\", at = { prop = \"bright_toy\", distance = 10, offsetDegrees = 60 } },\n				outcome = \"You said a word nobody had taught you, about a thing nobody had named. They laughed for a full minute and you have been chasing that sound ever since.\",\n				effects = { happiness = 5, smarts = 1 },\n			},\n			{\n				id = \"listen\",\n				label = \"Watch their mouths\",\n				act = { verb = \"Stay\" },\n				outcome = \"You stayed quiet for another month. Then you came out with a whole sentence.\",\n				effects = { smarts = 6, happiness = -1 },\n			},\n		},\n	},\n	{\n		id = \"childhood_across_the_rug\",\n		minAge = 0,\n		maxAge = 1,\n		-- The first entry whose answers are objects. The toy is a real distance away\n		-- and the rug really slides, so \"crawl to it\" and \"move the floor instead\"\n		-- are two different journeys rather than two rows that differ by a verb.\n		--\n		-- The rug is deliberately off to one side rather than between the player and\n		-- the toy, even though the writing wants it in the way. A rug on the path is\n		-- a rug you shove by accident on your way to the toy, and an event that\n		-- answers itself while you are walking somewhere else is the worst failure\n		-- this system has: the player did not choose, and has no way of knowing that.\n		delivery = \"Wander\",\n		lure = \"The room keeps going\",\n		prompt = \"The bright thing is all the way over there. You have never been all the way over there.\",\n		writesBack = { \"stat:happiness\", \"stat:health\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"crawl\",\n				label = \"Crawl all the way to it\",\n				act = { verb = \"Go\", at = { prop = \"bright_toy\", distance = 15 } },\n				outcome = \"You made it the whole way on your own. Your knees were red for an hour and it was worth every inch.\",\n				effects = { health = 4, happiness = 2 },\n			},\n			{\n				id = \"cry\",\n				-- No prop, so the instruction is written over the player's own head.\n				label = \"Stay put and cry for it\",\n				act = { verb = \"Stay\" },\n				outcome = \"It arrived in under ten seconds. You filed that information away carefully.\",\n				effects = { happiness = 3, smarts = 2, health = -1 },\n			},\n			{\n				id = \"rug\",\n				-- Was \"study your own hand\", which was the clever answer written as\n				-- giving up. Same stat shape, and now the clever answer is a thing you\n				-- can actually do: you cannot move yourself that far, so move the floor.\n				label = \"Push the rug across the floor\",\n				-- 60 degrees off, not 45. At 45 the rug's edge sits 4.9 studs from the\n				-- straight line to the toy, inside its own 5-stud reach, so crawling to\n				-- the toy would shove it on the way past and answer the wrong choice.\n				act = { verb = \"Push\", at = { prop = \"rug\", distance = 8, offsetDegrees = 60 } },\n				outcome = \"You shoved, and the whole floor moved. Nobody had told you the world was allowed to do that, and you spent the rest of the day testing what else was.\",\n				effects = { smarts = 5 },\n			},\n		},\n	},\n	{\n		id = \"childhood_first_steps\",\n		minAge = 1,\n		maxAge = 2,\n		delivery = \"Wander\",\n		lure = \"Someone is crouched with their arms out\",\n		prompt = \"You are upright, holding the edge of the couch. Someone is crouched a few feet away with their arms out.\",\n		writesBack = { \"stat:happiness\", \"stat:health\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"let_go\",\n				label = \"Let go and walk to them\",\n				act = { verb = \"Go\", at = { prop = \"grown_up\", distance = 12, offsetDegrees = -40 } },\n				outcome = \"Three steps, then the floor. You got up and did it again before anyone could reach you.\",\n				effects = { health = 5, happiness = 4 },\n			},\n			{\n				id = \"hold_on\",\n				label = \"Edge along the couch\",\n				act = { verb = \"Go\", at = { prop = \"couch\", distance = 10, offsetDegrees = 40 } },\n				outcome = \"You walked the entire length of the couch without letting go once. Slower, but you never fell.\",\n				effects = { smarts = 4, health = 1 },\n			},\n			{\n				id = \"sit_down\",\n				label = \"Sit down and laugh about it\",\n				act = { verb = \"Stay\" },\n				outcome = \"You sat down hard and found the whole situation hilarious. So did everyone else.\",\n				effects = { happiness = 5, health = -1 },\n			},\n		},\n	},\n	{\n		id = \"childhood_naming_things\",\n		minAge = 1,\n		maxAge = 3,\n		delivery = \"Wander\",\n		lure = \"Point at it and they say a word\",\n		prompt = \"You have discovered that everything has a name, and that adults will supply one for anything you point at.\",\n		writesBack = { \"stat:happiness\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"point_everything\",\n				label = \"Tip the whole box out\",\n				-- Pointing at everything is not a thing a room can watch you do. Emptying\n				-- the box is: it is the same answer -- name all of it -- made of an act\n				-- that has a floor covered in objects at the end of it.\n				act = { verb = \"Push\", at = { prop = \"toy_box\", distance = 10, offsetDegrees = -60 } },\n				outcome = \"You spent an entire afternoon pointing. By evening you had thirty new words and one very tired adult.\",\n				effects = { smarts = 6, happiness = 2 },\n			},\n			{\n				id = \"one_thing\",\n				label = \"Stand under the light\",\n				act = { verb = \"Stay\", at = { prop = \"lamp\", distance = 11 } },\n				outcome = \"It was the ceiling light. You made them say it forty times. You still remember the word.\",\n				effects = { smarts = 3, happiness = 4 },\n			},\n			{\n				id = \"make_up\",\n				label = \"Give this one your own name\",\n				act = { verb = \"Take\", at = { prop = \"stuffed_dog\", distance = 9, offsetDegrees = 60 } },\n				outcome = \"For a while the dog was called Bo and the moon was called Bo. Your family used your words for years afterward.\",\n				effects = { happiness = 6, smarts = 1 },\n			},\n		},\n	},\n	{\n		id = \"childhood_sandbox\",\n		minAge = 2,\n		maxAge = 4,\n		delivery = \"Wander\",\n		lure = \"Another child, and a red shovel\",\n		prompt = \"There is another child in the sandbox. They have a red shovel. You have no shovel.\",\n		writesBack = { \"stat:happiness\", \"stat:health\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"ask\",\n				label = \"Ask them to share\",\n				act = { verb = \"Go\", at = { prop = \"other_child\", distance = 11, offsetDegrees = -65 } },\n				outcome = \"They handed it over without looking up. You dug together until it got dark. That was your first friend.\",\n				effects = { happiness = 6, smarts = 2 },\n			},\n			{\n				id = \"dig_hands\",\n				label = \"Dig with your hands\",\n				act = { verb = \"Stay\", at = { prop = \"sand_pit\", distance = 13 } },\n				outcome = \"No shovel, no problem. By the end you had a hole deep enough to sit in and they asked to join you.\",\n				effects = { health = 3, happiness = 3, smarts = 1 },\n			},\n			{\n				id = \"watch\",\n				-- Watching needs somewhere to watch from that is not the sandbox, or the\n				-- answer is given by standing in the sandbox not digging -- which is the\n				-- other answer, held badly.\n				label = \"Sit on the wall and watch\",\n				act = { verb = \"Go\", at = { prop = \"low_wall\", distance = 10, offsetDegrees = 70 } },\n				outcome = \"You watched the whole time and learned exactly how they built it. You tried it yourself the next day and it worked.\",\n				effects = { smarts = 5, happiness = -2 },\n			},\n		},\n	},\n	{\n		id = \"childhood_end_of_yard\",\n		minAge = 2,\n		maxAge = 5,\n		delivery = \"Wander\",\n		lure = \"A gap in the hedge\",\n		prompt = \"The yard has a gap in the hedge at the far end. You have never been through it.\",\n		writesBack = { \"stat:happiness\", \"stat:health\", \"stat:smarts\", \"flag:wandered_off\" },\n		choices = {\n			{\n				id = \"go_through\",\n				label = \"Go through the gap\",\n				act = { verb = \"Go\", at = { prop = \"hedge_gap\", distance = 14 } },\n				outcome = \"It was another yard, almost the same as yours, with a cat in it. You were found twenty minutes later, filthy and delighted.\",\n				effects = { happiness = 6, health = -2, smarts = 3 },\n				sets = { \"wandered_off\" },\n			},\n			{\n				id = \"look_only\",\n				-- Not \"kneel at the gap\": the gap is the other answer, and an answer given\n				-- inside another answer's reach is a coin flip. Staying is done from here,\n				-- which is also what the choice has always actually meant.\n				label = \"Stay where you are\",\n				act = { verb = \"Stay\" },\n				outcome = \"You stayed on your side of the yard for a long time, working out what was over there. You went through eventually. Just not that day.\",\n				effects = { smarts = 4, happiness = 1 },\n			},\n			{\n				id = \"tell\",\n				label = \"Go and tell a grown-up\",\n				act = { verb = \"Go\", at = { prop = \"grown_up\", distance = 11, offsetDegrees = 75 } },\n				outcome = \"They came and looked, and said you were right, and held your hand while you went through together.\",\n				effects = { happiness = 4, health = 2 },\n			},\n		},\n	},\n	{\n		id = \"childhood_storm\",\n		minAge = 2,\n		maxAge = 5,\n		delivery = \"Wander\",\n		lure = \"The window is loud and white\",\n		prompt = \"The sky cracks open in the middle of the night. The window is loud and white.\",\n		writesBack = { \"stat:happiness\", \"stat:health\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"go_to_them\",\n				label = \"Go and find someone\",\n				act = { verb = \"Go\", at = { prop = \"grown_up\", distance = 12, offsetDegrees = -65 } },\n				outcome = \"They made room without a word. You slept through the rest of it.\",\n				effects = { happiness = 5, health = 2 },\n			},\n			{\n				id = \"watch_it\",\n				-- Stay rather than Go, because the answer is not reaching the window, it is\n				-- being at it long enough to count the gaps.\n				label = \"Kneel and watch it\",\n				act = { verb = \"Stay\", at = { prop = \"window\", distance = 11 } },\n				outcome = \"You counted the gaps between the light and the noise. You didn't know why yet, but you knew it meant something.\",\n				effects = { smarts = 6, happiness = -1 },\n			},\n			{\n				id = \"under_covers\",\n				label = \"Get under the covers\",\n				act = { verb = \"Go\", at = { prop = \"bed\", distance = 12, offsetDegrees = 65 } },\n				outcome = \"You stayed under there until it passed. In the morning it was just a wet yard and you felt a bit silly.\",\n				effects = { happiness = -2, smarts = 2, health = 1 },\n			},\n		},\n	},\n	{\n		id = \"childhood_last_cookie\",\n		minAge = 3,\n		maxAge = 5,\n		delivery = \"Wander\",\n		lure = \"One cookie left, and two of you\",\n		-- Three Carries on one cookie, which is the shape this event always wanted:\n		-- what you did with it was never the taking, it was where it ended up. Picking\n		-- it up commits to nothing, so a four-year-old can start toward the other child\n		-- and change their mind halfway, which is a thing four-year-olds do.\n		--\n		-- The three destinations are the labels the player actually reads, because the\n		-- cookie itself can only say \"Pick it up\" -- its three meanings are the three\n		-- places it can go.\n		prompt = \"There is one cookie left and two of you looking at it.\",\n		writesBack = { \"stat:happiness\", \"stat:health\", \"stat:looks\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"split\",\n				label = \"Put it back and split it\",\n				act = {\n					verb = \"Carry\",\n					at = { prop = \"cookie\", distance = 8 },\n					to = { prop = \"plate\", distance = 13, offsetDegrees = -55 },\n				},\n				outcome = \"You broke it badly and gave away the bigger piece. Somebody noticed, and mentioned it for years.\",\n				effects = { happiness = 4, smarts = 2 },\n			},\n			{\n				id = \"take\",\n				label = \"Eat it in the corner\",\n				act = {\n					verb = \"Carry\",\n					at = { prop = \"cookie\", distance = 8 },\n					to = { prop = \"cushion\", distance = 13, offsetDegrees = 55 },\n				},\n				outcome = \"You took it to the corner and ate the whole thing facing the wall. It was a very good cookie and you have thought about it more than you'd like to admit.\",\n				effects = { happiness = 3, looks = -1, smarts = 1 },\n			},\n			{\n				id = \"give\",\n				label = \"Give it to them\",\n				act = {\n					verb = \"Carry\",\n					at = { prop = \"cookie\", distance = 8 },\n					to = { prop = \"other_child\", distance = 12, offsetDegrees = 150 },\n				},\n				outcome = \"You said you weren't hungry, which was a lie. They remembered, and shared theirs the next time.\",\n				effects = { happiness = 2, smarts = 3, health = -1 },\n			},\n		},\n	},\n	{\n		id = \"childhood_same_story\",\n		minAge = 3,\n		maxAge = 5,\n		delivery = \"Wander\",\n		lure = \"The books, and you get to pick\",\n		-- The most natural Take in the whole band: \"you are allowed to pick\" already\n		-- meant putting a hand on one, and picking it off a list was the only part\n		-- that was ever a translation. The two books sit far enough apart that\n		-- reaching one is never ambiguously reaching the other.\n		prompt = \"It is bedtime and you are allowed to pick the story.\",\n		writesBack = { \"stat:happiness\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"same_again\",\n				label = \"The same one as last night\",\n				-- 35 degrees either side rather than 30, for the same reason the rug is at\n				-- 60: at 30 a book sits 4.5 studs off the line to the shelf, and reaching\n				-- for the shelf would pick a book up on the way.\n				act = { verb = \"Take\", at = { prop = \"book_worn\", distance = 9, offsetDegrees = -35 } },\n				outcome = \"The same one. Again. You knew every word and corrected them whenever they tried to skip a page.\",\n				effects = { happiness = 5, smarts = 2 },\n			},\n			{\n				id = \"longest\",\n				label = \"The longest one on the shelf\",\n				act = { verb = \"Take\", at = { prop = \"book_thick\", distance = 9, offsetDegrees = 35 } },\n				outcome = \"You picked it purely because it would take longest. You were asleep by the fourth page anyway.\",\n				effects = { smarts = 4, happiness = 2 },\n			},\n			{\n				id = \"make_one_up\",\n				-- Refusing the books has to be as physical as choosing one, or the third\n				-- answer is the only one still made of words.\n				label = \"Push the shelf away instead\",\n				act = { verb = \"Push\", at = { prop = \"shelf\", distance = 12 } },\n				outcome = \"You shoved the whole shelf away and asked for a new one. They invented it on the spot, about a dog that could drive. It was terrible. You asked for it every night for a month.\",\n				effects = { happiness = 6, smarts = 3 },\n			},\n		},\n	},\n	{\n		id = \"childhood_mirror\",\n		minAge = 0,\n		maxAge = 1,\n		delivery = \"Wander\",\n		lure = \"There is another baby in there\",\n		prompt = \"There is another baby in the shiny thing on the wall. They do everything you do, exactly when you do it.\",\n		writesBack = { \"stat:happiness\", \"stat:smarts\" },\n		-- The hard one, and the reason it went last. All three answers are aimed at a\n		-- single object, and one object can only ever be one answer -- so the third had\n		-- to become a second place in the house rather than a second face of the glass.\n		-- Which turned out to be truer anyway: a child who believes there is somebody in\n		-- there goes looking for the room they are standing in.\n		choices = {\n			{\n				id = \"test\",\n				-- Holding still is a better test than moving, and it is the one a\n				-- one-year-old can actually run. They stop when you stop.\n				label = \"Hold still and see\",\n				act = { verb = \"Stay\" },\n				outcome = \"You held still for as long as you could bear it. So did they. You worked at this for a long time and reached no conclusion you could have explained.\",\n				effects = { smarts = 5, happiness = 2 },\n			},\n			{\n				id = \"greet\",\n				label = \"Get right up to them\",\n				act = { verb = \"Go\", at = { prop = \"mirror\", distance = 11 } },\n				outcome = \"You got close enough to fog it and shouted. They shouted silently back. You decided you liked them and that was that.\",\n				effects = { happiness = 5, smarts = 1 },\n			},\n			{\n				id = \"behind\",\n				label = \"Round to the other side\",\n				act = { verb = \"Go\", at = { prop = \"other_side\", distance = 12, offsetDegrees = 65 } },\n				outcome = \"You went around to the other side and found nothing but wall. It was the first time the world had lied to you.\",\n				effects = { smarts = 6, happiness = -2 },\n			},\n		},\n	},\n	{\n		id = \"childhood_dropped_spoon\",\n		minAge = 0,\n		maxAge = 1,\n		delivery = \"Wander\",\n		lure = \"The spoon is on the floor again\",\n		prompt = \"Things go away when you push them, and come back when somebody else decides they should. You have a spoon.\",\n		writesBack = { \"stat:happiness\", \"stat:health\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"again\",\n				label = \"Send it away again\",\n				act = { verb = \"Push\", at = { prop = \"spoon\", distance = 9, offsetDegrees = -60 } },\n				outcome = \"Fourteen times. You learned that things go where you send them and that adults bring them back, which is two laws of the universe in one afternoon.\",\n				effects = { smarts = 6, happiness = 3 },\n			},\n			{\n				id = \"watch\",\n				label = \"Watch where it goes\",\n				act = { verb = \"Stay\" },\n				outcome = \"You sent it once and tracked it the whole way, without following. Then you were satisfied.\",\n				effects = { smarts = 4, health = -1 },\n			},\n			{\n				id = \"keep\",\n				-- The spoon is what the other answer shoves, so holding on has to be\n				-- holding something else. The bowl was always the other thing on the tray.\n				label = \"Hold onto the bowl instead\",\n				act = { verb = \"Take\", at = { prop = \"bowl\", distance = 9, offsetDegrees = 60 } },\n				outcome = \"You got both hands around the bowl and would not be talked out of it. Nobody saw that bowl again until you were asleep.\",\n				effects = { happiness = 3, health = 2 },\n			},\n		},\n	},\n	{\n		id = \"childhood_handed_over\",\n		minAge = 0,\n		maxAge = 2,\n		delivery = \"Wander\",\n		lure = \"A face you do not know\",\n		prompt = \"A face you don't know is leaning in with their arms out, and the person holding you is already letting go.\",\n		writesBack = { \"stat:happiness\", \"stat:health\", \"stat:looks\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"go\",\n				label = \"Go to them\",\n				act = { verb = \"Go\", at = { prop = \"stranger\", distance = 10, offsetDegrees = -55 } },\n				outcome = \"You went. They smelled wrong and sounded kind, and you were fine inside a minute.\",\n				effects = { happiness = 3, smarts = 2 },\n			},\n			{\n				id = \"object\",\n				label = \"Get back to the one you know\",\n				act = { verb = \"Go\", at = { prop = \"grown_up\", distance = 10, offsetDegrees = 55 } },\n				outcome = \"You were back in familiar arms within seconds and everyone apologized to you, which felt correct.\",\n				effects = { happiness = 2, smarts = 3, health = -1 },\n			},\n			{\n				id = \"stare\",\n				label = \"Stay put and stare\",\n				act = { verb = \"Stay\" },\n				outcome = \"You looked at them without blinking for the whole visit. They brought it up every time they saw you for years.\",\n				effects = { smarts = 5, looks = -1 },\n			},\n		},\n	},\n	{\n		id = \"childhood_the_word_no\",\n		minAge = 1,\n		maxAge = 3,\n		delivery = \"Wander\",\n		lure = \"The word that stops them\",\n		-- \"No\" is not a word here, it is a body. Refusing to move at all, shoving away\n		-- the one thing you actually object to, and going out the door with them are the\n		-- three things a two-year-old means by it, and none of them needed saying.\n		prompt = \"You have learned a word that stops adults where they stand. It has two letters. Today there is a bowl in front of you and a door somebody is holding open.\",\n		writesBack = { \"stat:happiness\", \"stat:health\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"everything\",\n				label = \"Refuse everything\",\n				act = { verb = \"Stay\" },\n				outcome = \"You said it to food, baths, shoes and the sun. It worked about a third of the time, which was enough to keep going.\",\n				effects = { happiness = 4, smarts = 3 },\n			},\n			{\n				id = \"sparingly\",\n				label = \"Push away the one you mind\",\n				act = { verb = \"Push\", at = { prop = \"bowl\", distance = 10, offsetDegrees = -60 } },\n				outcome = \"You used it rarely, and they listened when you did. You have negotiated that way ever since.\",\n				effects = { smarts = 6, happiness = 1 },\n			},\n			{\n				id = \"opposite\",\n				label = \"Say yes and go with them\",\n				act = { verb = \"Go\", at = { prop = \"front_door\", distance = 13, offsetDegrees = 60 } },\n				outcome = \"You said yes to everything for a week and ended up at a swimming pool, a wedding, and somebody else's birthday party.\",\n				effects = { happiness = 5, health = 1, smarts = -1 },\n			},\n		},\n	},\n	{\n		id = \"childhood_stairs\",\n		minAge = 1,\n		maxAge = 3,\n		delivery = \"Wander\",\n		lure = \"The stairs go up\",\n		prompt = \"The stairs go up. You have watched everyone else use them and it looks straightforward enough.\",\n		writesBack = { \"stat:happiness\", \"stat:health\", \"stat:smarts\", \"flag:climbed_stairs\", \"flag:stayed_put\" },\n		choices = {\n			{\n				id = \"climb\",\n				label = \"Climb them\",\n				act = { verb = \"Go\", at = { prop = \"stairs\", distance = 12, offsetDegrees = -35 } },\n				outcome = \"You made it four steps before anyone noticed, and the noise they made was far bigger than the situation warranted.\",\n				effects = { health = 3, happiness = 3, smarts = 1 },\n				sets = { \"climbed_stairs\" },\n				clears = { \"stayed_put\" },\n			},\n			{\n				id = \"backward\",\n				label = \"Hold onto the rail\",\n				act = { verb = \"Take\", at = { prop = \"stair_rail\", distance = 10, offsetDegrees = 35 } },\n				outcome = \"Somebody showed you once and you never did it any other way. It was slow, and you never fell.\",\n				effects = { smarts = 5, health = 2 },\n			},\n			{\n				id = \"hand\",\n				label = \"Wait with one arm up\",\n				act = { verb = \"Stay\" },\n				outcome = \"You stood there with one arm up until somebody took it. It worked every single time, so you kept doing it.\",\n				effects = { happiness = 3, smarts = 2 },\n				sets = { \"stayed_put\" },\n				clears = { \"climbed_stairs\" },\n			},\n		},\n	},\n	{\n		id = \"childhood_one_toy\",\n		minAge = 1,\n		maxAge = 4,\n		delivery = \"Wander\",\n		lure = \"It is where you left it\",\n		prompt = \"There is one thing you will not be separated from. It is not the newest or the nicest and it is starting to smell.\",\n		writesBack = { \"stat:happiness\", \"stat:health\", \"stat:smarts\" },\n		-- Three Carries on one object, the same shape as the cookie and for the same\n		-- reason: what you did with it was never the picking up, it was where it ended\n		-- up. Here it earns more than it does there, because \"you will not be separated\n		-- from it\" is a sentence that only means anything once the thing is in your arms\n		-- and following you around the room.\n		choices = {\n			{\n				id = \"everywhere\",\n				label = \"Take it out the front door\",\n				act = {\n					verb = \"Carry\",\n					at = { prop = \"worn_toy\", distance = 8 },\n					to = { prop = \"front_door\", distance = 14, offsetDegrees = -70 },\n				},\n				outcome = \"It came to the store, the doctor and both sets of grandparents. It lost an eye somewhere along the way and you loved it more.\",\n				effects = { happiness = 6, health = -1 },\n			},\n			{\n				id = \"hide\",\n				label = \"Hide it in the cupboard\",\n				act = {\n					verb = \"Carry\",\n					at = { prop = \"worn_toy\", distance = 8 },\n					to = { prop = \"cupboard\", distance = 13, offsetDegrees = 70 },\n				},\n				outcome = \"You hid it so well that you lost it for two days. Those were a bad two days for everyone in the house.\",\n				effects = { smarts = 3, happiness = -2 },\n			},\n			{\n				id = \"lend\",\n				label = \"Let them hold it\",\n				act = {\n					verb = \"Carry\",\n					at = { prop = \"worn_toy\", distance = 8 },\n					to = { prop = \"other_child\", distance = 12, offsetDegrees = 175 },\n				},\n				outcome = \"You handed it over and watched them the entire time. Getting it back was the best part.\",\n				effects = { happiness = 4, smarts = 2 },\n			},\n		},\n	},\n	{\n		id = \"childhood_hiding\",\n		minAge = 2,\n		maxAge = 4,\n		delivery = \"Wander\",\n		lure = \"Somebody has started counting\",\n		prompt = \"Somebody is counting. You need somewhere they will never find you.\",\n		writesBack = { \"stat:happiness\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"eyes\",\n				-- The joke lands because the player really does stand in the open doing\n				-- nothing while a set of perfectly good hiding places is on either side.\n				label = \"Cover your eyes\",\n				act = { verb = \"Stay\" },\n				outcome = \"You stood in the middle of the room with both hands over your face and could not be found for a remarkably long time, because they were being kind.\",\n				effects = { happiness = 6, smarts = -1 },\n			},\n			{\n				id = \"curtain\",\n				label = \"Get behind the curtain\",\n				act = { verb = \"Go\", at = { prop = \"curtain\", distance = 11, offsetDegrees = -60 } },\n				outcome = \"Your feet were in plain view. They walked past you three times announcing they had no idea where you could possibly be.\",\n				effects = { happiness = 5, smarts = 1 },\n			},\n			{\n				id = \"properly\",\n				label = \"Get inside the cupboard\",\n				act = { verb = \"Go\", at = { prop = \"cupboard\", distance = 12, offsetDegrees = 60 } },\n				outcome = \"You found a spot so good they stopped playing and started calling your name for real. You came out feeling powerful and a little guilty.\",\n				effects = { smarts = 5, happiness = 2 },\n			},\n		},\n	},\n	{\n		id = \"childhood_big_dog\",\n		minAge = 2,\n		maxAge = 5,\n		delivery = \"Wander\",\n		lure = \"Something big, and it has seen you\",\n		-- The first event that is about something rather than merely describing it.\n		-- Every clause of the prompt is now checkable against the room: the dog is\n		-- there, it really is 2.6 studs at the shoulder against a toddler's 2.3, and\n		-- it turns and looks at you. The choices had nothing to point at before this.\n		subject = \"dog\",\n		prompt = \"There is a dog. It is at least as tall as you are, and it has noticed you.\",\n		writesBack = { \"stat:happiness\", \"stat:health\", \"stat:smarts\", \"flag:dog_feared\", \"flag:dog_loved\" },\n		-- Reacted, so the dog does the thing the outcome line says it did. Every line\n		-- below already described something the animal was up to; until reactions\n		-- existed it stood there identically under all three of them, which is a game\n		-- telling the player their answer did not matter in the same breath as telling\n		-- them it did. This is the event that made reactions necessary.\n		choices = {\n			{\n				id = \"hand_out\",\n				label = \"Put your hand out\",\n				outcome = \"It shoved its whole head under your palm and nearly took you off your feet. You have liked dogs unconditionally ever since.\",\n				effects = { happiness = 6, health = 1 },\n				sets = { \"dog_loved\" },\n				clears = { \"dog_feared\" },\n				-- You went to it and it came the rest of the way. The choice the whole\n				-- event is built around: you crossed the room to a dog taller than you\n				-- are, and it closed the last of the distance itself.\n				reaction = \"approach\",\n			},\n			{\n				id = \"freeze\",\n				label = \"Stand completely still\",\n				outcome = \"You held still until it lost interest. You were proud of not running, which is a strange thing to be proud of at three.\",\n				effects = { smarts = 4, happiness = 1 },\n				-- \"Until it lost interest\" is a thing that happens rather than a thing\n				-- that is reported, and it is the whole payoff of the choice: nothing\n				-- you did made it leave, it simply stopped caring.\n				reaction = \"withdraw\",\n			},\n			{\n				id = \"behind\",\n				label = \"Get behind an adult\",\n				outcome = \"You watched it from behind somebody's leg. By the time you came out it was asleep, which was disappointing.\",\n				effects = { happiness = -1, smarts = 3 },\n				sets = { \"dog_feared\" },\n				clears = { \"dog_loved\" },\n				-- \"By the time you came out it was asleep, which was disappointing\" is\n				-- the joke this event ends on, and it only lands if the animal is\n				-- actually lying down when the player looks back at it.\n				reaction = \"settle\",\n			},\n		},\n	},\n	{\n		id = \"childhood_puddle\",\n		minAge = 2,\n		maxAge = 5,\n		delivery = \"Wander\",\n		lure = \"The whole path is underwater\",\n		prompt = \"A puddle covers the whole path, and you are wearing shoes that were clean this morning.\",\n		writesBack = { \"stat:happiness\", \"stat:health\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"jump\",\n				label = \"Straight in, both feet\",\n				act = { verb = \"Go\", at = { prop = \"puddle\", distance = 11 } },\n				outcome = \"You went in flat-footed and soaked yourself to the waist. Worth it then, and you would do it now.\",\n				effects = { happiness = 6, health = -2 },\n			},\n			{\n				id = \"around\",\n				label = \"Round the edge, stay dry\",\n				act = { verb = \"Go\", at = { prop = \"dry_path\", distance = 11, offsetDegrees = 70 } },\n				outcome = \"You got around it without a drop on you. You felt extremely sensible and slightly cheated.\",\n				effects = { smarts = 3, happiness = -1 },\n			},\n			{\n				id = \"test\",\n				-- Given from where the player is standing rather than at the puddle's edge,\n				-- because the edge is inside the puddle's own reach and going in is already\n				-- the first answer. Working it out first is the decision; going in anyway is\n				-- what the outcome is for.\n				label = \"Stop and work it out\",\n				act = { verb = \"Stay\" },\n				outcome = \"You stood at the edge of it like an engineer, established the depth, and then jumped in anyway.\",\n				effects = { smarts = 4, happiness = 3, health = -1 },\n			},\n		},\n	},\n	{\n		id = \"childhood_broke_it\",\n		minAge = 3,\n		maxAge = 5,\n		delivery = \"Wander\",\n		lure = \"It is in two pieces\",\n		prompt = \"It is in two pieces on the floor and nobody saw it happen.\",\n		writesBack = { \"stat:happiness\", \"stat:smarts\", \"flag:broke_it_hid_it\", \"flag:broke_it_owned_up\" },\n		-- The one event where picking the thing up and not yet knowing where you are\n		-- taking it is the whole feeling. A four-year-old holding the evidence, halfway\n		-- between the grown-up and the shelf, is the event.\n		choices = {\n			{\n				id = \"own_up\",\n				label = \"Take it to them\",\n				act = {\n					verb = \"Carry\",\n					at = { prop = \"broken_half\", distance = 8 },\n					to = { prop = \"grown_up\", distance = 13, offsetDegrees = -65 },\n				},\n				outcome = \"You told them immediately, in tears. They were considerably less angry than you had budgeted for.\",\n				effects = { smarts = 5, happiness = 2 },\n				sets = { \"broke_it_owned_up\" },\n				clears = { \"broke_it_hid_it\" },\n			},\n			{\n				id = \"repair\",\n				label = \"Put it back on the shelf\",\n				act = {\n					verb = \"Carry\",\n					at = { prop = \"broken_half\", distance = 8 },\n					to = { prop = \"shelf\", distance = 12, offsetDegrees = 65 },\n				},\n				outcome = \"You balanced the two halves against each other and walked away quickly. It held for about an hour.\",\n				effects = { smarts = 3, happiness = -2 },\n				sets = { \"broke_it_hid_it\" },\n				clears = { \"broke_it_owned_up\" },\n			},\n			{\n				id = \"silence\",\n				label = \"Say nothing\",\n				act = { verb = \"Stay\" },\n				outcome = \"You said nothing and waited. The waiting turned out to be the punishment.\",\n				effects = { happiness = -4, smarts = 4 },\n				sets = { \"broke_it_hid_it\" },\n				clears = { \"broke_it_owned_up\" },\n			},\n		},\n	},\n	{\n		id = \"childhood_helping\",\n		minAge = 3,\n		maxAge = 5,\n		delivery = \"Wander\",\n		lure = \"Tools, and nobody is using them\",\n		prompt = \"An adult is doing something with tools, and you have decided that you are helping.\",\n		writesBack = { \"stat:happiness\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"hold\",\n				label = \"Take them the flashlight\",\n				act = {\n					verb = \"Carry\",\n					at = { prop = \"flashlight\", distance = 8 },\n					to = { prop = \"grown_up\", distance = 13, offsetDegrees = -70 },\n				},\n				outcome = \"You held the flashlight, mostly pointing at the wrong thing. They said you were essential and they meant it.\",\n				effects = { happiness = 5, smarts = 3 },\n			},\n			{\n				id = \"parallel\",\n				label = \"Work alongside them\",\n				act = { verb = \"Stay\", at = { prop = \"workbench\", distance = 12, offsetDegrees = 70 } },\n				outcome = \"You worked on your own project next to theirs for an hour. Neither of you said a word and it was perfect.\",\n				effects = { smarts = 5, happiness = 3 },\n			},\n			{\n				id = \"names\",\n				-- Asking what everything is called is forty questions; the room can only\n				-- watch you ask one. So it is the one you would have asked -- the smallest\n				-- thing on the floor, picked up and held out.\n				label = \"Pick up the one you can't name\",\n				act = { verb = \"Take\", at = { prop = \"washer\", distance = 9, offsetDegrees = 150 } },\n				outcome = \"You asked forty questions and they answered every one. You still know what a washer is.\",\n				effects = { smarts = 6, happiness = 1 },\n			},\n		},\n	},\n	{\n		id = \"childhood_why\",\n		minAge = 3,\n		maxAge = 5,\n		delivery = \"Wander\",\n		lure = \"They are talking about something\",\n		prompt = \"You have found a question that works on absolutely anything, and it is one word long. Somebody is across the room, and so is the thing you were going to ask about.\",\n		writesBack = { \"stat:happiness\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"keep_going\",\n				label = \"Ask them, and keep asking\",\n				act = { verb = \"Go\", at = { prop = \"grown_up\", distance = 12, offsetDegrees = -60 } },\n				outcome = \"You got to the bottom of it in about nine steps and they admitted they didn't know. That was the day adults got smaller.\",\n				effects = { smarts = 6, happiness = 1 },\n			},\n			{\n				id = \"self_answer\",\n				-- Going to look at the thing instead of asking about it is what answering\n				-- it yourself is, before you have the words for either.\n				label = \"Work it out yourself\",\n				act = { verb = \"Go\", at = { prop = \"lamp\", distance = 11, offsetDegrees = 60 } },\n				outcome = \"You began supplying your own answers. They were confident, detailed, and almost entirely wrong.\",\n				effects = { happiness = 4, smarts = 2 },\n			},\n			{\n				id = \"read_the_room\",\n				label = \"Stop, and let them finish\",\n				act = { verb = \"Stay\" },\n				outcome = \"You heard the sigh and stopped. You were reading rooms before you could read words.\",\n				effects = { smarts = 5, happiness = -1 },\n			},\n		},\n	},\n	{\n		id = \"childhood_first_morning\",\n		minAge = 4,\n		maxAge = 5,\n		delivery = \"Wander\",\n		lure = \"A room full of children you have never met\",\n		prompt = \"First morning somewhere new, with a room full of children you have never met. Somebody lets go of your hand.\",\n		writesBack = { \"stat:happiness\", \"stat:health\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"join_in\",\n				label = \"Straight into the middle\",\n				act = { verb = \"Go\", at = { prop = \"other_child\", distance = 12 } },\n				outcome = \"You were building something with three other children inside a minute. You forgot to say goodbye.\",\n				effects = { happiness = 6, smarts = 1 },\n			},\n			{\n				id = \"corner\",\n				label = \"Find the corner by the window\",\n				act = { verb = \"Go\", at = { prop = \"window\", distance = 13, offsetDegrees = 70 } },\n				outcome = \"You sat by the window for most of the morning. By the afternoon someone had come to you, which was easier anyway.\",\n				effects = { smarts = 4, happiness = -1 },\n			},\n			{\n				id = \"cry\",\n				-- Standing exactly where you were left, doing nothing, for as long as it\n				-- takes. The one answer in the file where the mechanic is the feeling.\n				label = \"Stay where they left you\",\n				act = { verb = \"Stay\" },\n				outcome = \"You cried until you ran out, and then you were fine. Nobody held it against you.\",\n				effects = { happiness = -3, health = 1, smarts = 2 },\n			},\n		},\n	},\n}\n\n-- Stamped rather than written on every entry, because it is true of the whole\n-- file and always will be: this is the age band the player spends on their feet\n-- in one room, and there is no toddler event that would be better as a card.\n--\n-- Which of the two it gets is read off the entry rather than authored, because it\n-- is not a separate decision. Writing an act onto every choice *is* saying the\n-- answers are objects, and a second field agreeing with that would only ever be a\n-- field that could disagree with it. Left as an override so one entry can still opt\n-- out later without unpicking this.\nfor _, event in Childhood do\n	if event.resolution ~= nil then\n		continue\n	end\n	local handled = false\n	for _, choice in event.choices do\n		if choice.act ~= nil then\n			handled = true\n			break\n		end\n	end\n	event.resolution = if handled then \"Handled\" else \"Enacted\"\nend\n\nreturn Childhood\n"
table.insert(AGES_MANIFEST, "src/server/content/LifeEvents/Childhood.luau")
AGES_SOURCES["src/server/content/LifeEvents/Crime.luau"] = "--!strict\n-- Crime life events. These are the narrative consequences of the mechanical\n-- systems — theft, bounty, police, gangs — and they only fire when the player\n-- has done something that leaves a flag behind. No event here triggers a mini-game;\n-- they respond to one.\n--\n-- Every event writes at least one durable thing (flag, stat, or money) so the\n-- loader's writesBack check is satisfied, and every event has an outcome that\n-- reads like a memory rather than a tutorial.\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal Types = require(ReplicatedStorage:WaitForChild(\"Types\"))\n\ntype LifeEvent = Types.LifeEvent\n\nlocal Crime: { LifeEvent } = {\n	-- The first time a life crosses the line from wanting something to taking it.\n	-- Small, almost comic — eight dollars from a till — but the flag it sets is\n	-- the hinge everything else turns on. No cast, because the event is about\n	-- the player's own decision, not somebody else's presence.\n	{\n		id = \"crime_first_shoplift\",\n		minAge = 13,\n		maxAge = 17,\n		delivery = \"Direct\",\n		weight = 0.3,\n		prompt = \"The shop is quiet and the till is open. You have four dollars and the shelf is full of things you cannot afford. Nobody is watching.\",\n		writesBack = { \"flag:first_crime\", \"stat:happiness\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"take_it\",\n				label = \"Take it\",\n				outcome = \"You walked out with eight dollars in your pocket and your heart in your throat. It was the stupidest thing you had ever done, and you did not know that yet.\",\n				effects = { happiness = 3, smarts = -2 },\n				sets = { \"first_crime\" },\n			},\n			{\n				id = \"take_almost\",\n				label = \"Take something smaller and leave the rest\",\n				outcome = \"You took a single snack and put the rest back. The guilt was smaller, and the thrill was smaller still, and you wondered which was worse.\",\n				effects = { happiness = 1, smarts = -1 },\n				sets = { \"first_crime\" },\n			},\n			{\n				id = \"walk_away\",\n				label = \"Walk away and pretend you were never tempted\",\n				outcome = \"You walked out empty-handed and told yourself you had never wanted anything. The lie was easy, and it was also a choice.\",\n				effects = { smarts = 2, happiness = -1 },\n			},\n		},\n	},\n\n	-- The moment the line becomes a wall. Caught in the act, with the clerk's\n	-- voice still ringing in your ears. The bounty spike is real — the service\n	-- handles that — but this event is about what the moment feels like from\n	-- the inside.\n	{\n		id = \"crime_caught_shoplift\",\n		minAge = 14,\n		maxAge = 18,\n		delivery = \"Direct\",\n		requires = { \"first_crime\" },\n		forbids = { \"convicted\" },\n		weight = 0.6,\n		prompt = \"You are still in the aisle when the clerk's hand lands on your shoulder. You have not even reached the door yet. The other customers are looking, and you are not sure who is worse — the ones who recognise you or the ones who do not.\",\n		writesBack = { \"flag:busted\", \"stat:happiness\", \"stat:health\" },\n		choices = {\n			{\n				id = \"freeze\",\n				label = \"Stand still and say nothing\",\n				outcome = \"You stood there while the clerk called the police and you counted the seconds. It was the worst ten seconds of your life and also the shortest.\",\n				effects = { happiness = -5, health = -1 },\n				sets = { \"busted\" },\n			},\n			{\n				id = \"run\",\n				label = \"Run\",\n				outcome = \"You ran. The door caught your jacket and you tore it free, and then you were outside and the street was full of people who had just seen you run. You did not look back.\",\n				effects = { happiness = -3, health = -2, smarts = 1 },\n				sets = { \"busted\" },\n			},\n			{\n				id = \"apologize\",\n				label = \"Put it back and say sorry\",\n				outcome = \"You put it back and said sorry before the clerk could say anything. They did not believe you, but the police came anyway — sorry does not cancel a report, only softens it.\",\n				effects = { happiness = -2, smarts = 3 },\n				sets = { \"busted\" },\n			},\n		},\n	},\n\n	-- The first time somebody who runs with a gang notices you. This is not an\n	-- invitation to join — it is an invitation to be seen, which is the harder\n	-- choice. Gated on first_crime because a clean life is not interesting to\n	-- them, and on not_busted because a known kid is already taken care of.\n	{\n		id = \"crime_gang_approach\",\n		minAge = 15,\n		maxAge = 20,\n		delivery = \"NPCApproach\",\n		cast = \"neighbor\",\n		requires = { \"first_crime\" },\n		forbids = { \"busted\", \"convicted\", \"gang_recruited\" },\n		weight = 0.4,\n		prompt = \"A person you do not know but recognise — they live three streets over and you have seen them with people you do not want to know — stops you on the corner. ' heard you have nerve. We could use that.'\",\n		writesBack = { \"flag:gang_recruited\", \"stat:happiness\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"listen\",\n				label = \"Ask what they mean\",\n				outcome = \"They told you. It sounded easy in their voice, and harder in yours. You did not say yes, but you did not say no either, and that was the point.\",\n				effects = { happiness = 2, smarts = -1 },\n				sets = { \"gang_recruited\" },\n			},\n			{\n				id = \"refuse\",\n				label = \"Tell them you are not interested\",\n				outcome = \"They nodded the way people nod when they are counting on seeing you again. You walked away clean, and you knew you would be noticed again.\",\n				effects = { happiness = -1, smarts = 2 },\n			},\n			{\n				id = \"walk_away_silent\",\n				label = \"Walk away without answering\",\n				outcome = \"You kept walking. Behind you, the voice said nothing, which was worse than an answer would have been.\",\n				effects = { happiness = -3, smarts = 1 },\n			},\n		},\n	},\n\n	-- The loyalty test. A gang member asks you to do something small and illegal\n	-- as a way of proving you belong. The consequences are real — bounty, record,\n	-- a choice that cannot be undone — but the event is about the pressure of the\n	-- moment, not the arithmetic.\n	{\n		id = \"crime_gang_test\",\n		minAge = 16,\n		maxAge = 22,\n		delivery = \"NPCApproach\",\n		cast = \"neighbor\",\n		requires = { \"gang_recruited\" },\n		forbids = { \"convicted\" },\n		weight = 0.5,\n		prompt = \"The same person from the corner is back, and this time they are not asking for an answer — they are asking for a favour. 'Just this once. Nobody gets hurt.'\",\n		writesBack = { \"flag:escalated_to_big_crime\", \"stat:happiness\", \"stat:health\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"do_it\",\n				label = \"Do it\",\n				outcome = \"You did it. It was smaller than they made it sound and larger than you expected, and the look on their face when you finished was the first time you understood what loyalty costs.\",\n				effects = { happiness = -2, health = -1, smarts = 1 },\n				sets = { \"escalated_to_big_crime\" },\n			},\n			{\n				id = \"refuse_soft\",\n				label = \"Say you will think about it\",\n				outcome = \"You bought time, and they accepted the answer you did not give. The next time they ask will be harder.\",\n				effects = { happiness = -1, smarts = 2 },\n			},\n			{\n				id = \"refuse_hard\",\n				label = \"Say no\",\n				outcome = \"You said no out loud, and the silence after was louder than yes would have been. They did not threaten you — they did not need to.\",\n				effects = { happiness = -3, smarts = 3 },\n			},\n		},\n	},\n\n	-- The arrest aftermath. You are out of custody and the world has not changed,\n	-- but everything around you has. Employers ask different questions. Police\n	-- watch you differently. The flag is what matters — this event is the moment\n	-- you realise the record is real.\n	{\n		id = \"crime_arrest_aftermath\",\n		minAge = 16,\n		maxAge = 40,\n		delivery = \"Direct\",\n		requires = { \"convicted\" },\n		forbids = { \"on_parole\" },\n		weight = 0.5,\n		prompt = \"You are out. The door closed behind you and the street looked the same, but it did not. People you pass seem to know, or they think they know, and you are not sure which is worse.\",\n		writesBack = { \"stat:happiness\", \"stat:health\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"keep_head_down\",\n				label = \"Keep your head down and move on\",\n				outcome = \"You did. For a while it worked, and then it did not — staying invisible is exhausting, and the exhaustion shows.\",\n				effects = { happiness = -3, health = -2, smarts = 1 },\n			},\n			{\n				id = \"own_it\",\n				label = \"Own it and keep going\",\n				outcome = \"You told the people who asked and moved on. Some believed you, some did not, and the ones who did not were the ones who mattered.\",\n				effects = { happiness = 2, smarts = 2, health = -1 },\n			},\n			{\n				id = \"leave_town\",\n				label = \"Leave and do not look back\",\n				outcome = \"You left. The town was small enough that leaving was visible, and people talked about you after you went. Talking is a kind of presence.\",\n				effects = { happiness = -4, smarts = 1 },\n			},\n		},\n	},\n\n	-- The parole check-in. A uniformed person at a desk, a form to sign, a\n	-- question about where you have been. It is not dramatic — it is administrative,\n	-- which is the point. The record follows you into rooms you thought were yours.\n	{\n		id = \"crime_parole_check\",\n		minAge = 16,\n		maxAge = 40,\n		delivery = \"Direct\",\n		requires = { \"on_parole\" },\n		weight = 0.7,\n		prompt = \"You have to go to the office. The officer behind the desk does not look up when you sit down. 'Where have you been this month?' it is not a friendly question.\",\n		writesBack = { \"flag:on_parole\", \"stat:happiness\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"tell_truth\",\n				label = \"Tell the truth\",\n				outcome = \"You told them. It was harder than you expected and easier than you feared — the officer wrote it down and moved to the next line.\",\n				effects = { happiness = 1, smarts = 2 },\n				clears = { \"on_parole\" },\n			},\n			{\n				id = \"leave_out\",\n				label = \"Leave out the bits that sound bad\",\n				outcome = \"You edited. It was not a lie, exactly, but the officer had heard the other version and knew the difference between the two.\",\n				effects = { happiness = -3, smarts = 1 },\n			},\n			{\n				id = \"shut_down\",\n				label = \"Say nothing until they move on\",\n				outcome = \"You stayed quiet. Silence is not evidence, but it is not innocence either, and the officer filed it away.\",\n				effects = { happiness = -2, smarts = -1 },\n			},\n		},\n	},\n\n	-- Employment stigma. You apply for a job and the background check comes back.\n	-- The gate is not absolute — some employers do not care, some care too much —\n	-- but the flag is what opens the door that stays open.\n	{\n		id = \"crime_job_stigma\",\n		minAge = 18,\n		maxAge = 55,\n		delivery = \"Direct\",\n		requires = { \"convicted\" },\n		weight = 0.4,\n		prompt = \"You applied for a job that would have been fine if they had not asked about your record. They asked. You told the truth, and then they asked again, softer, like they hoped you had forgotten how to say it.\",\n		writesBack = { \"stat:happiness\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"try_again\",\n				label = \"Apply somewhere else\",\n				outcome = \"You applied somewhere else. The second place did not ask, or they asked and did not care, and you wondered which was luck and which was skill.\",\n				effects = { happiness = 1, smarts = 2 },\n			},\n			{\n				id = \"push\",\n				label = \"Push back and insist you are qualified\",\n				outcome = \"You pushed. It did not help — the record was the record, and your qualifications were real but secondary to a piece of paper neither of you could see.\",\n				effects = { happiness = -3, smarts = 1 },\n			},\n			{\n				id = \"give_up_temp\",\n				label = \"Take anything for now and hope it changes\",\n				outcome = \"You took anything. It paid, and it was beneath you, and you told yourself it was temporary — which is what you tell yourself until it is not.\",\n				effects = { happiness = -2, smarts = -1 },\n			},\n		},\n	},\n\n	-- The debt-crime spiral. Debt pushes you toward crime; crime pushes you\n	-- deeper into debt through fines, lost wages, and the attention it attracts.\n	-- This event is the moment you notice the circle.\n	{\n		id = \"crime_debt_spiral\",\n		minAge = 18,\n		maxAge = 40,\n		delivery = \"Direct\",\n		requires = { \"in_debt\", \"first_crime\" },\n		forbids = { \"convicted\" },\n		weight = 0.5,\n		prompt = \"The bill arrived and you looked at the number and then at the shop down the street with the open till. You have stolen before. You know how it works. The math is simple and the answer is not.\",\n		writesBack = { \"flag:escalated_to_big_crime\", \"stat:happiness\", \"stat:health\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"do_it_again\",\n				label = \"Do it again\",\n				outcome = \"You did. The money helped for three weeks and then the bounty did not, and the bill was still there, and now you were watching your back in the shop too.\",\n				effects = { happiness = -4, health = -2, smarts = 1 },\n				sets = { \"escalated_to_big_crime\" },\n			},\n			{\n				id = \"ask_for_help\",\n				label = \"Ask somebody for help instead\",\n				outcome = \"You asked. They said no, or they said maybe, or they said nothing at all — which is the same thing — and you went home and looked at the bill again.\",\n				effects = { happiness = -2, smarts = 2 },\n			},\n			{\n				id = \"find_another_way\",\n				label = \"Find another way\",\n				outcome = \"You found another way. It was slower and harder and paid less, but it was yours, and the bill shrank by a different amount than you expected.\",\n				effects = { happiness = 1, smarts = 3, health = -1 },\n			},\n		},\n	},\n\n	-- The escalation. You have stolen before, you are not busted, and somebody\n	-- with more experience offers you a bigger job. The offer is real and the\n	-- stakes are higher, and the choice is between the known risk and the unknown\n	-- one.\n	{\n		id = \"crime_escalation_offer\",\n		minAge = 17,\n		maxAge = 30,\n		delivery = \"NPCApproach\",\n		cast = \"neighbor\",\n		requires = { \"first_crime\" },\n		forbids = { \"busted\", \"convicted\", \"gang_recruited\" },\n		weight = 0.3,\n		prompt = \"Someone older than you, with the look of somebody who has done this before, catches your eye in the queue. 'You look like you know how to keep your mouth shut. I have a job that pays better than the shop.'\",\n		writesBack = { \"flag:escalated_to_big_crime\", \"stat:happiness\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"take_it\",\n				label = \"Take the job\",\n				outcome = \"You took it. It paid well and it went wrong in a way that had nothing to do with the money, and you wished you had said no before you wished for anything else.\",\n				effects = { happiness = -3, smarts = 2 },\n				sets = { \"escalated_to_big_crime\" },\n			},\n			{\n				id = \"ask_details\",\n				label = \"Ask what the job actually is\",\n				outcome = \"They told you. It was worse than you expected and better paid, and you understood why they had not led with the details.\",\n				effects = { smarts = 3, happiness = -1 },\n			},\n			{\n				id = \"refuse\",\n				label = \"Say no and keep walking\",\n				outcome = \"You said no. They did not look surprised, which was worse than anger would have been — it meant they had already decided you would come around.\",\n				effects = { happiness = 1, smarts = 1 },\n			},\n		},\n	},\n\n	-- The conviction that changes everything. A second arrest, a longer sentence,\n	-- and the realisation that the record is not a mark — it is a shape, and it\n	-- is reshaping the life around it. This only fires for lives that have been\n	-- convicted before and are caught again.\n	{\n		id = \"crime_second_conviction\",\n		minAge = 18,\n		maxAge = 50,\n		delivery = \"Direct\",\n		requires = { \"convicted\" },\n		forbids = { \"on_parole\" },\n		weight = 0.3,\n		prompt = \"You thought the first time was the only time. It was not. The second time is different — longer, louder, and with people who remember you from before. The court does not care that you have been here.\",\n		writesBack = { \"stat:happiness\", \"stat:health\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"accept\",\n				label = \"Accept it and move through it\",\n				outcome = \"You moved through it. The years went and then they did not, and you came out older and harder and not entirely sorry for the people you had become in between.\",\n				effects = { happiness = -5, health = -3, smarts = 2 },\n			},\n			{\n				id = \"fight\",\n				label = \"Fight it\",\n				outcome = \"You fought. It cost more than accepting would have, and it changed nothing, and you learned something about yourself that you wish you had not.\",\n				effects = { happiness = -4, health = -2, smarts = 1 },\n			},\n			{\n				id = \"break\",\n				label = \"Break and say nothing\",\n				outcome = \"You broke. The silence lasted through the whole thing, and when it was over you did not know who you were anymore, only that you were still here.\",\n				effects = { happiness = -7, health = -4 },\n			},\n		},\n	},\n\n	-- The release. You walk out of custody and the world is the same and not the\n	-- same. The on_parole flag is set here and drives the next set of events.\n	{\n		id = \"crime_release\",\n		minAge = 16,\n		maxAge = 50,\n		delivery = \"Direct\",\n		requires = { \"convicted\" },\n		forbids = { \"on_parole\" },\n		weight = 0.8,\n		prompt = \"The door closes behind you and the air outside is the same as it was before. It is not. You can feel the difference even if nobody else can, and that is the hardest part.\",\n		writesBack = { \"flag:on_parole\", \"stat:happiness\", \"stat:health\" },\n		choices = {\n			{\n				id = \"face_it\",\n				label = \"Face it head-on\",\n				outcome = \"You faced it. The first week was the hardest and then the weeks blurred together, and you learned that time passes differently when you are not running from it.\",\n				effects = { happiness = 2, health = 1 },\n				sets = { \"on_parole\" },\n			},\n			{\n				id = \"disappear\",\n				label = \"Disappear for a while\",\n				outcome = \"You disappeared. For two weeks nobody knew where you were, and then you came back and the world had kept turning without you, which was either comforting or devastating.\",\n				effects = { happiness = -3, smarts = 1 },\n				sets = { \"on_parole\" },\n			},\n			{\n				id = \"reach_out\",\n				label = \"Reach out to somebody\",\n				outcome = \"You reached out. They answered, or they did not, but the reaching was the point — the answer was just the answer.\",\n				effects = { happiness = 3, smarts = 2 },\n				sets = { \"on_parole\" },\n			},\n		},\n	},\n}\n\nreturn Crime\n"
table.insert(AGES_MANIFEST, "src/server/content/LifeEvents/Crime.luau")
AGES_SOURCES["src/server/content/LifeEvents/Debt.luau"] = "--!strict\n-- Debt life events. These only fire when a life is in the red, and they are the\n-- single thing that turns a penalty into a turning point: debt is the one number\n-- in the game that compounds against the player, so content that reaches in\n-- through it is the one that makes the whole economy legible.\n--\n-- Each event is gated by the `in_debt` flag and closes a door rather than only\n-- opening one. An answer may set `loan_shark_deal` or `debt_relief`, which are\n-- flags later events require, so debt does not just punish — it writes a path.\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal Types = require(ReplicatedStorage:WaitForChild(\"Types\"))\n\ntype LifeEvent = Types.LifeEvent\n\nlocal Debt: { LifeEvent } = {\n	-- The first time debt becomes a choice rather than a number. A man who comes\n	-- around on a Tuesday does not knock on the door — he waits until the door is\n	-- already open — and the offer is real and the terms are not.\n	{\n		id = \"debt_loan_shark\",\n		minAge = 18,\n		maxAge = 80,\n		delivery = \"Direct\",\n		requires = { \"in_debt\" },\n		weight = 0.4,\n		prompt = \"He knows your name and he knows the number you owe, and he is offering a number lower than both. 'Just a small fee up front,' he says, and it is not a small number.\",\n		writesBack = { \"flag:loan_shark_deal\", \"flag:debt_relief\" },\n		choices = {\n			{\n				id = \"take_it\",\n				label = \"Take the deal\",\n				outcome = \"The debt disappeared and the fee appeared on a different ledger. You did not sleep well for three months, but you slept at all, which was more than you had been doing.\",\n				sets = { \"loan_shark_deal\" },\n				clears = { \"in_debt\" },\n				effects = { happiness = -4, smarts = 2 },\n			},\n			{\n				id = \"refuse\",\n				label = \"Tell him to leave\",\n				outcome = \"He nodded the way people nod when they are counting on seeing you again. The bill was still there the next month, and so was he.\",\n				effects = { happiness = 2, smarts = 1 },\n			},\n			{\n				id = \"negotiate\",\n				label = \"Ask for more time\",\n				outcome = \"He gave you two more weeks and a number that was not kinder than the first one. You used the time, and it was not enough, which is what you should have known.\",\n				sets = { \"loan_shark_deal\" },\n				effects = { happiness = -2, smarts = 3 },\n			},\n		},\n	},\n\n	-- A community program that exists because the council thought this was a good\n	-- thing to name out loud. The counsellor is kind, which is the worst part: you\n	-- want to do right by someone who is trying, and doing right means admitting\n	-- the number was real.\n	{\n		id = \"debt_counselling\",\n		minAge = 18,\n		maxAge = 999,\n		delivery = \"Direct\",\n		requires = { \"in_debt\" },\n		forbids = { \"loan_shark_deal\" },\n		weight = 0.6,\n		prompt = \"A letter has arrived about a free session. You did not apply for it, which is the first thing you notice, and then you notice the rest of it.\",\n		writesBack = { \"flag:debt_relief\", \"stat:happiness\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"go\",\n				label = \"Go and be honest\",\n				outcome = \"You told a stranger the number and they wrote it down without looking up. It was the first time you had said it out loud, and the numbers on the page were the same ones you had been carrying.\",\n				effects = { happiness = 4, smarts = 3 },\n				sets = { \"debt_relief\" },\n			},\n			{\n				id = \"go_light\",\n				label = \"Go and downplay it\",\n				outcome = \"You left out the bits that felt small and the counsellor filled them in from the letter. They were kind about it, which was worse than being angry would have been.\",\n				effects = { smarts = 1, happiness = -1 },\n			},\n			{\n				id = \"do_nothing\",\n				label = \"Leave it unopened\",\n				outcome = \"You put it in the recycling and went to work. It arrived again next month, and the month after, and you were tired of the letter and tired of yourself in about equal measure.\",\n				effects = { happiness = -3, smarts = 1 },\n			},\n		},\n	},\n\n	-- Money from someone who does not expect it back, which is the difference between\n	-- help and a loan and also the thing that makes it complicated. You do not owe\n	-- them, and that is heavier than you thought it would be.\n	{\n		id = \"debt_family_help\",\n		minAge = 18,\n		maxAge = 60,\n		delivery = \"Direct\",\n		requires = { \"in_debt\" },\n		forbids = { \"loan_shark_deal\", \"debt_relief\" },\n		weight = 0.5,\n		prompt = \"Your sister has texted three times in a week. She is not asking about you, and you know what it is before she says it.\",\n		writesBack = { \"flag:debt_relief\", \"stat:happiness\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"accept\",\n				label = \"Take it\",\n				outcome = \"She put the money in an envelope and you did not ask how much. It cleared the debt and left the relationship with the same shape it had always had, which felt wrong and right at once.\",\n				effects = { happiness = 1, smarts = 2 },\n				sets = { \"debt_relief\" },\n			},\n			{\n				id = \"refuse\",\n				label = \"Say no and figure it out alone\",\n				outcome = \"You said no and she said she understood, and neither of you believed it. You paid the interest instead, which is what pride usually costs when it is honest about itself.\",\n				effects = { happiness = -3, smarts = 2 },\n			},\n			{\n				id = \"borrow\",\n				label = \"Call it a loan and write the amount down\",\n				outcome = \"You wrote it down and she signed it, and the paper made it feel like something other than a favour. It did not, and neither of you said so.\",\n				effects = { happiness = -1, smarts = 3 },\n				sets = { \"debt_relief\" },\n			},\n		},\n	},\n\n	-- The month after debt. The interest has accumulated and the bill has arrived\n	-- and the flags from the last event are still there, so this is the moment\n	-- where the path you took matters. Fired for anyone who did not resolve the\n	-- first event cleanly, or who took the shark deal and then needed more.\n	{\n		id = \"debt_consequences\",\n		minAge = 18,\n		maxAge = 999,\n		delivery = \"Direct\",\n		requires = { \"in_debt\" },\n		forbids = { \"debt_relief\" },\n		weight = 0.3,\n		prompt = \"The number has grown again, and you are not sure whether it is the interest or the new bill or both. The man came round on Tuesday and left a card for the month after.\",\n		writesBack = { \"stat:happiness\", \"stat:health\" },\n		choices = {\n			{\n				id = \"work_more\",\n				label = \"Pick up extra shifts until it shrinks\",\n				outcome = \"You did, and it shrank, and you were too tired to do anything else with the money once it was gone. The number went down and the year went by, which was the trade.\",\n				effects = { health = -4, happiness = -2, smarts = 1 },\n			},\n			{\n				id = \"sell_things\",\n				label = \"Sell what you can\",\n				outcome = \"You sold the things you said you would never sell and a few you thought you would. The house felt emptier and the bill was smaller, and you did not know which was worse.\",\n				effects = { happiness = -3, smarts = 2 },\n			},\n			{\n				id = \"walk_away\",\n				label = \"Stop paying and deal with the calls\",\n				outcome = \"The calls came, and you answered some and not others, and the number kept growing anyway. You learned what a collection agency sounds like on the telephone.\",\n				effects = { happiness = -5, health = -2 },\n			},\n		},\n	},\n}\n\nreturn Debt\n"
table.insert(AGES_MANIFEST, "src/server/content/LifeEvents/Debt.luau")
AGES_SOURCES["src/server/content/LifeEvents/Gym.luau"] = "--!strict\n-- Gym and fitness life events. The gym opens at age 13 (Ambient.MinAge) and is\n-- available for the rest of a life; these events fire as birthday moments or\n-- ambient triggers and offer stat choices around health, looks, happiness, and\n-- sometimes smarts. No performance scores (these are not shift events). Every\n-- event has at least one free choice and every choice moves at least one stat.\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal Types = require(ReplicatedStorage:WaitForChild(\"Types\"))\n\ntype LifeEvent = Types.LifeEvent\n\nlocal Gym: { LifeEvent } = {\n	-- The first time the gym becomes an option: a free trial card through the\n	-- door. Three ways to use it, all reasonable, none costing money.\n	{\n		id = \"gym_easy_start\",\n		minAge = 13,\n		maxAge = 50,\n		delivery = \"Direct\",\n		prompt = \"There's a free trial card on the counter at the gym. You've walked past it enough times to know where it is.\",\n		writesBack = { \"stat:happiness\", \"stat:health\", \"stat:looks\", \"flag:gym_joined\" },\n		choices = {\n			{\n				id = \"treadmill\",\n				label = \"Walk on the treadmill for half an hour\",\n				outcome = \"You walked, slowly, while people who clearly knew what they were doing moved around you. By the third visit the headphones felt natural.\",\n				effects = { health = 2, happiness = 1 },\n				sets = { \"gym_joined\" },\n			},\n			{\n				id = \"free_weights\",\n				label = \"Go straight for the free weights\",\n				outcome = \"You picked up something too heavy, put it back, and pretended you were just looking at it. A stranger showed you a different one and you both nodded.\",\n				effects = { health = 3, looks = 2, happiness = -1 },\n				sets = { \"gym_joined\" },\n			},\n			{\n				id = \"stretching\",\n				label = \"Just use the stretching area\",\n				outcome = \"You spent forty minutes on the mats, bending in ways that turned out to matter more than you expected. Your back stopped hurting in about three weeks.\",\n				effects = { health = 1, happiness = 2 },\n				sets = { \"gym_joined\" },\n			},\n		},\n	},\n	-- A specific, measurable goal. The training montage is the good ending;\n	-- the park is the healthy compromise; the cafe is the human one.\n	{\n		id = \"gym_goal\",\n		minAge = 16,\n		maxAge = 55,\n		delivery = \"Direct\",\n		prompt = \"There's a charity run in October. Six weeks away. You keep thinking about it and then not doing anything.\",\n		writesBack = { \"stat:happiness\", \"stat:health\", \"stat:smarts\", \"flag:gym_joined\" },\n		choices = {\n			{\n				id = \"train\",\n				label = \"Train for it seriously\",\n				outcome = \"Six weeks of interval training and a spreadsheet you'd never admit to. You finished in the top third and felt like you could do anything.\",\n				effects = { health = 4, smarts = 1, happiness = 2 },\n				sets = { \"gym_joined\" },\n			},\n			{\n				id = \"jog_park\",\n				label = \"Jog around the park instead\",\n				outcome = \"You ran three times a week, at your own pace, past the same dogs. You entered the run and finished it, which was the whole point.\",\n				effects = { health = 2, happiness = 3 },\n				sets = { \"gym_joined\" },\n			},\n			{\n				id = \"cafe\",\n				label = \"Watch it from the cafe\",\n				outcome = \"You sat with a coffee and watched five hundred people in luminous vests run past. You clapped. It was genuinely moving.\",\n				effects = { happiness = 2, smarts = 1 },\n			},\n		},\n	},\n	-- A social moment at the gym: strangers becoming a semi-regular group.\n	-- NPCApproach delivery with a neighbor cast.\n	{\n		id = \"gym_running_group\",\n		minAge = 18,\n		maxAge = 70,\n		delivery = \"NPCApproach\",\n		cast = \"neighbor\",\n		prompt = \"The neighbor from three doors down is stretching by the door in running gear. They've noticed you at the same time every week and have come over to ask.\",\n		writesBack = { \"stat:happiness\", \"stat:health\", \"stat:smarts\", \"flag:gym_joined\" },\n		choices = {\n			{\n				id = \"join\",\n				label = \"Join them\",\n				outcome = \"You ran together every Tuesday and Thursday for over a year. The conversation covered everything and nothing, which is what a run is for.\",\n				effects = { health = 3, happiness = 4 },\n				sets = { \"gym_joined\" },\n			},\n			{\n				id = \"own_pace\",\n				label = \"Wave and keep your pace\",\n				outcome = \"You nodded and carried on. They waved back and you both went your own way. You saw them next week and nodded again.\",\n				effects = { health = 2, happiness = -1 },\n			},\n			{\n				id = \"avoid\",\n				label = \"Cross to the other side\",\n				outcome = \"You dodged without thinking and spent the rest of the session wondering whether that was rude. It was, a bit.\",\n				effects = { happiness = -2, smarts = 1 },\n			},\n		},\n	},\n	-- Being new somewhere and having somebody show you around.\n	-- Friend cast, so capped at teen years.\n	{\n		id = \"gym_new_kid\",\n		minAge = 13,\n		maxAge = 17,\n		delivery = \"NPCApproach\",\n		cast = \"friend\",\n		prompt = \"Your friend has just joined the gym and is standing in the middle of the floor looking lost. They have seen you and are heading over.\",\n		writesBack = { \"stat:happiness\", \"stat:health\" },\n		choices = {\n			{\n				id = \"show_around\",\n				label = \"Show them around\",\n				outcome = \"You gave them the tour: which machines were broken, where the good mirrors were, and which treadmills had the wobble. They looked grateful.\",\n				effects = { happiness = 3 },\n			},\n			{\n				id = \"workout_together\",\n				label = \"Work out together\",\n				outcome = \"You ended up next to each other for an hour, swapping phones between sets. It was the most social either of you had been in weeks.\",\n				effects = { health = 2, happiness = 2 },\n			},\n			{\n				id = \"point_to_coach\",\n				label = \"Point them to the coach\",\n				outcome = \"You pointed at the desk and mouthed 'ask them' and went back to your set. They sorted it out. You met up afterwards for a drink.\",\n				effects = { happiness = 1 },\n			},\n		},\n	},\n	-- A workout that crosses the line from hard work to actual damage.\n	-- Has a costed doctor option, mirroring adult_caught_something. Sets\n	-- the \"sick\" flag so the event cannot repeat immediately.\n	{\n		id = \"gym_pushed_too_hard\",\n		minAge = 16,\n		maxAge = 70,\n		delivery = \"Direct\",\n		forbids = { \"sick\" },\n		prompt = \"You went hard yesterday and this morning something in your knee is clicking. It's not terrible but it's definitely there.\",\n		writesBack = { \"stat:happiness\", \"stat:health\", \"flag:sick\" },\n		choices = {\n			{\n				id = \"rest\",\n				label = \"Take a few days off\",\n				outcome = \"Three days of doing nothing and it sorted itself out. You'd been due a rest and your body had simply decided for you.\",\n				effects = { health = 2, happiness = -1 },\n				sets = { \"sick\" },\n			},\n			{\n				id = \"push_through\",\n				label = \"Push through it\",\n				outcome = \"You ran on it anyway and it got worse for a week before it got better. You learned something about pride, which is what pain is usually teaching.\",\n				effects = { happiness = 1, health = -3 },\n				sets = { \"sick\" },\n			},\n			{\n				id = \"see_doctor\",\n				label = \"See a doctor about it\",\n				outcome = \"A ten-minute appointment, a referral for a scan, and a bill. The scan was clear. You paid for the peace of mind and it was worth it.\",\n				cost = 120,\n				effects = { health = 5, happiness = 1 },\n				sets = { \"sick\" },\n			},\n		},\n	},\n	-- The long drift away from a routine. Only fires for someone who has\n	-- already been going -- gated by \"gym_joined\" which gym_first_membership\n	-- or any sustained attendance sets.\n	{\n		id = \"gym_lapsed\",\n		minAge = 22,\n		maxAge = 999,\n		delivery = \"Direct\",\n		requires = { \"gym_joined\" },\n		prompt = \"It has been four months. The direct debit keeps going out and you keep meaning to cancel it or go back, and you have done neither.\",\n		writesBack = { \"stat:happiness\", \"stat:health\" },\n		choices = {\n			{\n				id = \"go_back\",\n				label = \"Go back this week\",\n				outcome = \"You went back on a Tuesday. Everything hurt for the first session and nothing did after the third. The treadmill remembered your speed.\",\n				effects = { health = 3, happiness = 3 },\n			},\n			{\n				id = \"cancel\",\n				label = \"Cancel the membership\",\n				outcome = \"You cancelled it and felt relief and loss in about equal measure. The money stayed; the habit didn't.\",\n				effects = { happiness = -1, health = -1 },\n			},\n			{\n				id = \"keep_deferring\",\n				label = \"Keep putting it off\",\n				outcome = \"Another six months went by before you noticed. The money kept leaving and the bag stayed by the door.\",\n				effects = { happiness = -3, health = -1 },\n			},\n		},\n	},\n	-- The fun run: looks are the point, but the health is a side effect\n	-- nobody argues with. Direct, because it is a decision not a person.\n	{\n		id = \"gym_fun_run\",\n		minAge = 16,\n		maxAge = 60,\n		delivery = \"Direct\",\n		prompt = \"A local five-kilometre fun run is being advertised everywhere. It is not serious and that is the whole appeal.\",\n		writesBack = { \"stat:happiness\", \"stat:health\", \"stat:looks\", \"flag:gym_joined\" },\n		choices = {\n			{\n				id = \"enter_serious\",\n				label = \"Enter properly and train for it\",\n				outcome = \"You ran it in under thirty minutes, which put you in the top quarter. You wore the medal to the shop afterwards.\",\n				effects = { health = 3, looks = 3, happiness = 2 },\n				sets = { \"gym_joined\" },\n			},\n			{\n				id = \"enter_fun\",\n				label = \"Enter and just enjoy it\",\n				outcome = \"You ran in a silly costume with three friends and stopped for chips on the way back. Your time was terrible and your day was not.\",\n				effects = { health = 2, happiness = 4 },\n				sets = { \"gym_joined\" },\n			},\n			{\n				id = \"volunteer\",\n				label = \"Volunteer at the water station instead\",\n				outcome = \"You handed out cups and cheered strangers for two hours. You were in bed by eight, satisfied in a way that surprised you.\",\n				effects = { happiness = 3, health = 1 },\n			},\n		},\n	},\n}\n\nreturn Gym\n"
table.insert(AGES_MANIFEST, "src/server/content/LifeEvents/Gym.luau")
AGES_SOURCES["src/server/content/LifeEvents/Park.luau"] = "--!strict\n-- The park beside the garage. A place that changes meaning across a life:\n-- a field of grass and plastic seats for a child, a somewhere-to-be for a teen,\n-- a place to clear your head as an adult, and a bench you know by name in old\n-- age. Events here are tagged with \"park\" so the context picker prefers them\n-- when the player is at the park and lets them fire elsewhere when nothing\n-- better matches the room.\n--\n-- The west gang (The Old Line) has its boss at the park, so a small number of\n-- events thread through gang territory without turning the place into a gang\n-- map. The park is not a gang place first and foremost; it is a park that\n-- somebody happens to preside over.\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal Types = require(ReplicatedStorage:WaitForChild(\"Types\"))\n\ntype LifeEvent = Types.LifeEvent\n\nlocal Park: { LifeEvent } = {\n	-- The first time the park is not just somewhere you pass but somewhere you\n	-- stop. The swings are the obvious object and the right one: they make you\n	-- go higher if you want to, which is the whole lesson.\n	{\n		id = \"park_first_swings\",\n		minAge = 5,\n		maxAge = 8,\n		delivery = \"Direct\",\n		writesBack = { \"stat:happiness\", \"flag:park_first_swings\", \"flag:park_regular\" },\n		choices = {\n			{\n				id = \"swing_high\",\n				label = \"Go as high as you can\",\n				outcome = \"You pumped your legs until the sky was the whole world and then you were back in it. Your mum called you away and you did not want to go.\",\n				effects = { happiness = 4 },\n			},\n			{\n				id = \"swing_gentle\",\n				label = \"Swing slowly and watch the dogs\",\n				outcome = \"You went nice and easy and watched every dog that walked past with its person. One of them looked at you the way dogs do when they know something.\",\n				effects = { happiness = 2, smarts = 1 },\n			},\n			{\n				id = \"slide_first\",\n				label = \"Use the slide instead\",\n				outcome = \"The slide was faster than the swings and less exhausting. You did it seven times and then your legs gave out.\",\n				effects = { happiness = 3 },\n			},\n		},\n	},\n\n	-- A child who has been told to stay on the path finds the gap in the hedge.\n	-- The park is where this happens because the hedge borders it and the gap\n	-- is the same gap the west gang uses to come and go.\n	{\n		id = \"park_hedge_gap\",\n		minAge = 7,\n		maxAge = 11,\n		delivery = \"Direct\",\n		forbids = { \"park_regular\" },\n		writesBack = { \"stat:happiness\", \"stat:smarts\", \"flag:park_first_swings\" },\n		choices = {\n			{\n				id = \"squeeze_through\",\n				label = \"Squeeze through the gap\",\n				outcome = \"You made it. The grass on the other side was taller and the air felt different, like you were somewhere else even though it was the same park.\",\n				effects = { happiness = 3, smarts = 2 },\n			},\n			{\n				id = \"peer_through\",\n				label = \"Look through but stay on the path\",\n				outcome = \"You could see the old bench on the far side, the one with the crack in it. You decided you would sit there one day.\",\n				effects = { smarts = 1, happiness = 1 },\n			},\n			{\n				id = \"walk_away\",\n				label = \"Walk away and tell nobody\",\n				outcome = \"You walked home and never went back that way. The gap stayed there, waiting.\",\n				effects = { happiness = -1 },\n			},\n		},\n	},\n\n	-- A birthday at the park is the easy celebration: no hall to book, no cake\n	-- to bake, just running until you are tired and then sitting down somewhere\n	-- and eating what you brought. The cost is the cake.\n	{\n		id = \"park_birthday\",\n		minAge = 6,\n		maxAge = 10,\n		delivery = \"Direct\",\n		writesBack = { \"stat:happiness\", \"stat:looks\" },\n		choices = {\n			{\n				id = \"have_it\",\n				label = \"Have a birthday at the park\",\n				outcome = \"You ran until you could not run anymore and then you ate cake on the grass. It was the best birthday and you did not know why.\",\n				cost = 30,\n				effects = { happiness = 6, looks = 1 },\n			},\n			{\n				id = \"invite_friends\",\n				label = \"Invite two friends to come with you\",\n				outcome = \"You brought someone and they brought someone, and the park was suddenly full of people who knew your name. It was more than you expected.\",\n				cost = 50,\n				effects = { happiness = 7, smarts = 1 },\n			},\n			{\n				id = \"stay_home\",\n				label = \"Stay home and have a small one\",\n				outcome = \"You had cake at the kitchen table and went to bed early. It was fine. You were fine.\",\n				effects = { happiness = 2 },\n			},\n		},\n	},\n\n	-- Teen park hang. The park is the only public place where a teen can be\n	-- without an adult telling them what to do, which is why it matters.\n	{\n		id = \"park_after_school\",\n		minAge = 13,\n		maxAge = 17,\n		delivery = \"Direct\",\n		requires = { \"park_first_swings\" },\n		repeatable = true,\n		weight = 0.7,\n		tags = { \"park\" },\n		writesBack = { \"stat:happiness\", \"stat:health\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"hang_out\",\n				label = \"Just hang out and talk\",\n				outcome = \"You sat on the bench and talked about nothing for an hour. It was the best part of the day.\",\n				effects = { happiness = 4, smarts = 1 },\n			},\n			{\n				id = \"exercise\",\n				label = \"Do some proper exercise\",\n				outcome = \"You ran the loop around the park three times and then did some stretches you saw online. Your legs hurt for two days.\",\n				effects = { health = 3, happiness = 1 },\n			},\n			{\n				id = \"avoid_home\",\n				label = \"Stay until it is dark\",\n				outcome = \"You stayed until the lights came on and then walked home. Your parents asked where you had been and you did not quite know how to answer.\",\n				effects = { happiness = -2, smarts = 2, health = 1 },\n			},\n		},\n	},\n\n	-- A teen at the park with someone they like. The bench is the object.\n	{\n		id = \"park_first_kiss\",\n		minAge = 14,\n		maxAge = 17,\n		delivery = \"Direct\",\n		requires = { \"park_regular\" },\n		writesBack = { \"stat:happiness\", \"stat:looks\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"kiss\",\n				label = \"Kiss them on the bench\",\n				outcome = \"It was nothing like the movies and exactly better. You walked home feeling like you had learned something true.\",\n				effects = { happiness = 5, looks = 1 },\n			},\n			{\n				id = \"hold_hand\",\n				label = \"Just hold their hand\",\n				outcome = \"You held hands the whole way around the path and neither of you said anything about it. It was enough.\",\n				effects = { happiness = 4, smarts = 1 },\n			},\n			{\n				id = \"walk_away\",\n				label = \"Walk them to the gate and say goodnight\",\n				outcome = \"You walked them to the gate and stood there until they went inside. You went home and thought about it all evening.\",\n				effects = { happiness = 3, smarts = 2 },\n			},\n		},\n	},\n\n	-- The west gang is at the park. This event is about what you do when you\n	-- notice them, not about joining them -- that is GangService's job. This\n	-- is about the moment of choice: stay and risk it, or leave and pretend\n	-- you did not see anything.\n	{\n		id = \"park_gang_sight\",\n		minAge = 14,\n		maxAge = 18,\n		delivery = \"Direct\",\n		tags = { \"park\" },\n		writesBack = { \"stat:happiness\", \"stat:smarts\", \"flag:park_gang_untouched\" },\n		choices = {\n			{\n				id = \"keep_head_down\",\n				label = \"Keep walking and look nowhere\",\n				outcome = \"You walked past them with your eyes on the ground and they did not look up. Your heart was in your throat the whole way.\",\n				effects = { happiness = -2, smarts = 2 },\n			},\n			{\n				id = \"sit_away\",\n				label = \"Sit on the far bench and wait\",\n				outcome = \"You sat as far away as you could and waited until they left. They did not notice you at all, which was the point.\",\n				effects = { happiness = 1, smarts = 1 },\n			},\n			{\n				id = \"leave_immediately\",\n				label = \"Turn around and go home\",\n				outcome = \"You turned and walked home fast. You did not know what you had seen, but you knew you did not want to see it again.\",\n				effects = { happiness = -3, smarts = 3, health = 1 },\n			},\n		},\n	},\n\n	-- A teen who has been coming to the park long enough to know the regulars.\n	-- One of them notices you and speaks first.\n	{\n		id = \"park_teen_talk\",\n		minAge = 15,\n		maxAge = 17,\n		delivery = \"NPCApproach\",\n		cast = \"neighbor\",\n		requires = { \"park_regular\" },\n		repeatable = true,\n		weight = 0.5,\n		tags = { \"park\" },\n		writesBack = { \"stat:happiness\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"talk\",\n				label = \"Talk to them\",\n				outcome = \"They asked what you were doing there and you told them. They nodded like it made sense, which it sort of did.\",\n				effects = { happiness = 3, smarts = 1 },\n			},\n			{\n				id = \"nod\",\n				label = \"Nod and keep to yourself\",\n				outcome = \"You nodded and they nodded back. It was enough. You see each other at the park now and again and that is the relationship.\",\n				effects = { happiness = 1 },\n			},\n			{\n				id = \"walk_on\",\n				label = \"Keep walking\",\n				outcome = \"You kept walking and they called after you something you did not catch. You pretended you had not heard.\",\n				effects = { happiness = -2, smarts = 1 },\n			},\n		},\n	},\n\n	-- An adult who uses the park the way some people use a bar: to think.\n	-- The bench is theirs now, or at least the one near the old tree.\n	{\n		id = \"park_adult_bench\",\n		minAge = 22,\n		maxAge = 55,\n		delivery = \"Direct\",\n		requires = { \"park_regular\" },\n		repeatable = true,\n		weight = 0.6,\n		tags = { \"park\" },\n		writesBack = { \"stat:happiness\", \"stat:smarts\", \"stat:health\" },\n		choices = {\n			{\n				id = \"sit_think\",\n				label = \"Sit and think about nothing\",\n				outcome = \"You sat on your bench and watched the world go by. It was not productive and it was exactly what you needed.\",\n				effects = { happiness = 3, smarts = 2 },\n			},\n			{\n				id = \"walk_think\",\n				label = \"Walk the loop and sort it out\",\n				outcome = \"You walked the same loop you always walk and by the third time around you had the answer. It was always there; you just needed the space to find it.\",\n				effects = { health = 2, happiness = 2, smarts = 3 },\n			},\n			{\n				id = \"bring_food\",\n				label = \"Bring something to eat and make a meal of it\",\n				outcome = \"You brought bread and cheese and sat where the sun was. It was the best lunch you had in months.\",\n				effects = { happiness = 4, health = 1 },\n			},\n		},\n	},\n\n	-- An adult who has started a dog. The park is where the dog goes and where\n	-- the person goes with it. It is a different kind of regular.\n	{\n		id = \"park_dog_walk\",\n		minAge = 20,\n		maxAge = 60,\n		delivery = \"Direct\",\n		forbids = { \"park_regular\" },\n		writesBack = { \"stat:happiness\", \"stat:health\", \"flag:park_regular\" },\n		choices = {\n			{\n				id = \"walk_daily\",\n				label = \"Walk the dog here every day\",\n				outcome = \"You came here every day and the dog knew the path by heart. You started recognizing the other regulars and then you started saying hello.\",\n				effects = { health = 4, happiness = 3 },\n			},\n			{\n				id = \"walk_sometimes\",\n				label = \"Come here when the dog needs it\",\n				outcome = \"You came when you could. The dog loved it every time and you loved watching it love it. That was enough.\",\n				effects = { health = 2, happiness = 2 },\n			},\n			{\n				id = \"too_busy\",\n				label = \"Walk the dog around the block instead\",\n				outcome = \"The block is fine. The dog is fine. You are fine. It is just not the same.\",\n				effects = { health = 1, happiness = -1 },\n			},\n		},\n	},\n\n	-- A picnic. The park is the default venue because it is free and open and\n	-- somewhere everybody can get to. The cost is the food.\n	{\n		id = \"park_picnic\",\n		minAge = 22,\n		maxAge = 55,\n		delivery = \"Direct\",\n		writesBack = { \"stat:happiness\", \"stat:health\", \"flag:park_confession\" },\n		choices = {\n			{\n				id = \"family_picnic\",\n				label = \"Have a family picnic\",\n				outcome = \"You spread the blanket and everyone came. The kids ran and the adults talked and the food went faster than it should have.\",\n				cost = 80,\n				effects = { happiness = 6, health = 1 },\n			},\n			{\n				id = \"romantic_picnic\",\n				label = \"Have a picnic with your person\",\n				outcome = \"You brought a bottle and two glasses and sat where the light was good. It was not fancy and it was perfect.\",\n				cost = 60,\n				effects = { happiness = 7, looks = 1 },\n			},\n			{\n				id = \"solo_picnic\",\n				label = \"Bring a sandwich and sit alone\",\n				-- No cost, deliberately. Every answer here used to carry a price, which\n				-- made the whole event unanswerable to a player who could not afford the\n				-- cheapest one -- the prompt would sit open with no way to clear it, and\n				-- the require-time guard in LifeEvents/init refuses that as a liveness\n				-- bug rather than a balance one. This is the right choice to make free:\n				-- it is the one where you bring your own sandwich, so charging for it was\n				-- never coherent, and \"sit alone with what you already had\" is exactly the\n				-- walk-away answer the guard is insisting every event keeps open.\n				effects = { happiness = 3, smarts = 1 },\n			},\n		},\n	},\n\n	-- The park as a place to have a conversation that matters. Not a crisis --\n	-- just something that needs to be said and is too much for a kitchen table.\n	{\n		id = \"park_confession\",\n		minAge = 25,\n		maxAge = 55,\n		delivery = \"NPCApproach\",\n		cast = \"friend\",\n		requires = { \"park_regular\" },\n		writesBack = { \"stat:happiness\", \"stat:smarts\", \"flag:park_confession\" },\n		choices = {\n			{\n				id = \"listen\",\n				label = \"Listen without interrupting\",\n				outcome = \"They talked and you let them. When they were done, you said what you needed to say and it landed. Not perfectly, but landed.\",\n				effects = { happiness = 4, smarts = 3 },\n			},\n			{\n				id = \"share_first\",\n				label = \"Share your own trouble first\",\n				outcome = \"You went first and that made it easier for them to go. You both left lighter than you arrived.\",\n				effects = { happiness = 5, smarts = 2 },\n			},\n			{\n				id = \"change_subject\",\n				label = \"Talk about something else\",\n				outcome = \"You talked about the weather and the football and nothing at all. It was enough. Some things do not need to be said.\",\n				effects = { happiness = 1 },\n			},\n		},\n	},\n\n	-- An adult who is not okay and comes to the park because it is the one\n	-- place they can go without having to be anyone. This is the heavy one.\n	{\n		id = \"park_bad_day\",\n		minAge = 20,\n		maxAge = 55,\n		delivery = \"Direct\",\n		tags = { \"park\" },\n		writesBack = { \"stat:happiness\", \"stat:health\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"sit_it_out\",\n				label = \"Sit on the bench until it passes\",\n				outcome = \"You sat until the sun went down and the bad day became a bad afternoon and then just a bad day. It would have been worse inside.\",\n				effects = { happiness = 2, health = 1 },\n			},\n			{\n				id = \"walk_it_off\",\n				label = \"Walk until you are too tired to think\",\n				outcome = \"You walked until your legs hurt and your mind went quiet. You walked home in a different head than the one you arrived in.\",\n				effects = { health = 3, happiness = 1, smarts = 1 },\n			},\n			{\n				id = \"go_home\",\n				label = \"Go home and face it\",\n				outcome = \"You turned around and went home. The day was still bad but it was your bad day and you were in your own house.\",\n				effects = { happiness = -1, smarts = 2 },\n			},\n		},\n	},\n\n	-- An older adult who has been coming to this park for decades. The bench\n	-- is the same one they sat on as a child, if the park is the same park.\n	{\n		id = \"park_older_days\",\n		minAge = 60,\n		maxAge = 90,\n		delivery = \"Direct\",\n		requires = { \"park_regular\" },\n		repeatable = true,\n		weight = 0.5,\n		tags = { \"park\" },\n		writesBack = { \"stat:happiness\", \"stat:smarts\", \"stat:health\" },\n		choices = {\n			{\n				id = \"remember\",\n				label = \"Sit and remember\",\n				outcome = \"You sat on the bench and remembered every version of yourself that had sat on this bench. The one on the far side with the crack in it was still there.\",\n				effects = { happiness = 4, smarts = 2, health = 1 },\n			},\n			{\n				id = \"watch_young\",\n				label = \"Watch the young ones play\",\n				outcome = \"You watched a kid go down the slide and you smiled because you remembered what that felt like. It felt the same, somehow.\",\n				effects = { happiness = 5 },\n			},\n			{\n				id = \"doze\",\n				label = \"Doze in the sun\",\n				outcome = \"You dozed with your glasses on your belly and a dog came and lay down next to you. You did not move until it did.\",\n				effects = { health = 2, happiness = 2 },\n			},\n		},\n	},\n\n	-- An elder who feeds the ducks. Not everyone has ducks, but if the park\n	-- has them and you are old enough to have time, this is what you do.\n	{\n		id = \"park_ducks\",\n		minAge = 65,\n		maxAge = 999,\n		delivery = \"Direct\",\n		repeatable = true,\n		weight = 0.4,\n		tags = { \"park\" },\n		writesBack = { \"stat:happiness\", \"stat:health\" },\n		choices = {\n			{\n				id = \"feed_them\",\n				label = \"Feed the ducks\",\n				outcome = \"They came rushing like they had been starving and then they were gone again. You threw the rest and watched them circle.\",\n				effects = { happiness = 3, health = 1 },\n			},\n			{\n				id = \"watch_them\",\n				label = \"Just watch them\",\n				outcome = \"You sat and watched the ducks do what ducks do. It was peaceful and nothing more was needed.\",\n				effects = { happiness = 2 },\n			},\n			{\n				id = \"skip_today\",\n				label = \"Skip the ducks today\",\n				outcome = \"You walked past the water and kept going. The ducks would be there tomorrow.\",\n				effects = { happiness = -1 },\n			},\n		},\n	},\n\n	-- A repeatable ambient moment at the park. Not every visit needs a story;\n	-- some are just visits. This fires when the player is at the park and\n	-- nothing else more interesting is happening.\n	{\n		id = \"park_quiet_moment\",\n		minAge = 16,\n		maxAge = 80,\n		delivery = \"Direct\",\n		repeatable = true,\n		weight = 0.3,\n		tags = { \"park\" },\n		writesBack = { \"stat:happiness\" },\n		choices = {\n			{\n				id = \"breathe\",\n				label = \"Take a proper breath\",\n				outcome = \"You stood where you were and breathed in and out three times. The air was better here than anywhere else.\",\n				effects = { happiness = 2 },\n			},\n			{\n				id = \"people_watch\",\n				label = \"Watch people go by\",\n				outcome = \"You watched the stream of people and made up stories about them. The one with the red bag was going to propose. The old man was going home to his cat.\",\n				effects = { happiness = 1, smarts = 1 },\n			},\n			{\n				id = \"check_phone\",\n				label = \"Check your phone and keep walking\",\n				outcome = \"You checked everything and nothing mattered. You put the phone away and kept walking.\",\n				effects = { happiness = -1 },\n			},\n		},\n	},\n}\n\nreturn Park\n"
table.insert(AGES_MANIFEST, "src/server/content/LifeEvents/Park.luau")
AGES_SOURCES["src/server/content/LifeEvents/School.luau"] = "--!strict\n-- Ages 6-12. From here the player has an Age Up button, so these compete with\n-- the option to simply move on — they need to be worth stopping for.\n--\n-- Delivery is \"Direct\" for now. When step 3 lands a world, most of these become\n-- NPCApproach or Location events; only the delivery field changes.\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal Types = require(ReplicatedStorage:WaitForChild(\"Types\"))\n\ntype LifeEvent = Types.LifeEvent\n\nlocal School: { LifeEvent } = {\n	{\n		id = \"school_two_wheels\",\n		minAge = 6,\n		maxAge = 9,\n		delivery = \"NPCApproach\",\n		cast = \"friend\",\n		prompt = \"The training wheels are off. Someone is holding the back of the seat and promising not to let go.\",\n		writesBack = { \"stat:happiness\", \"stat:health\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"pedal\",\n				label = \"Pedal and don't look back\",\n				outcome = \"They let go about four seconds in. You were halfway down the road before you realized, and you stayed up.\",\n				effects = { health = 5, happiness = 4 },\n			},\n			{\n				id = \"check\",\n				label = \"Keep checking they're still there\",\n				outcome = \"You looked back, saw nobody, and went straight into the bushes. You were riding properly by the weekend anyway.\",\n				effects = { health = -3, happiness = 2, smarts = 3 },\n			},\n			{\n				id = \"quit\",\n				label = \"Say you'd rather do it another day\",\n				outcome = \"You went inside. It sat there in the shed for a month before you wheeled it out on your own and taught yourself.\",\n				effects = { smarts = 4, happiness = -2 },\n			},\n		},\n	},\n	{\n		id = \"school_new_kid\",\n		minAge = 6,\n		maxAge = 12,\n		delivery = \"NPCApproach\",\n		cast = \"friend\",\n		prompt = \"There's someone new in your class. At lunch they're sitting on their own at the end of a long table.\",\n		writesBack = { \"stat:happiness\", \"stat:looks\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"sit_with\",\n				label = \"Go and sit with them\",\n				outcome = \"You sat down and asked them something stupid about their lunch. They're still in your life, on and off, decades later.\",\n				effects = { happiness = 6, smarts = 1 },\n			},\n			{\n				id = \"invite\",\n				label = \"Wave them over to your table\",\n				outcome = \"You called across the cafeteria, which was mortifying for both of you, but they came over and stayed.\",\n				effects = { happiness = 4, looks = 1 },\n			},\n			{\n				id = \"nothing\",\n				label = \"Leave them to it\",\n				outcome = \"You meant to say something all week and never did. They moved schools again in the spring.\",\n				effects = { happiness = -3, smarts = 2 },\n			},\n		},\n	},\n	{\n		id = \"school_test_answers\",\n		minAge = 8,\n		maxAge = 12,\n		delivery = \"NPCApproach\",\n		cast = \"friend\",\n		prompt = \"You didn't study. The person in front has left their paper at a very readable angle.\",\n		writesBack = { \"stat:happiness\", \"stat:looks\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"copy\",\n				label = \"Read it\",\n				outcome = \"You got a good mark for work you didn't do, and it sat badly all week. It turned out they'd got question four wrong too, identically.\",\n				effects = { smarts = -3, happiness = -2, looks = 1 },\n			},\n			{\n				id = \"guess\",\n				label = \"Guess your way through it\",\n				outcome = \"You guessed, badly, and got a talking-to. You studied for the next one out of pure embarrassment.\",\n				effects = { smarts = 4, happiness = -2 },\n			},\n			{\n				id = \"own_up\",\n				label = \"Tell the teacher you weren't ready\",\n				outcome = \"You said it quietly at the end. They let you take it again on Friday, and you didn't waste it.\",\n				effects = { smarts = 5, happiness = 2 },\n			},\n		},\n	},\n	{\n		id = \"school_play\",\n		minAge = 7,\n		maxAge = 11,\n		delivery = \"NPCApproach\",\n		cast = \"friend\",\n		prompt = \"They're casting the school play. There's a lead, a tree, and a job doing the lights.\",\n		writesBack = { \"stat:happiness\", \"stat:looks\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"lead\",\n				label = \"Go for the lead\",\n				outcome = \"You got it, forgot two lines, and improvised something that got a bigger laugh than the real script.\",\n				effects = { looks = 4, happiness = 4, smarts = -1 },\n			},\n			{\n				id = \"tree\",\n				label = \"Ask to be the tree\",\n				outcome = \"You were an excellent tree. You had one line and you delivered it perfectly, and you enjoyed every second of not being looked at.\",\n				effects = { happiness = 3, smarts = 2 },\n			},\n			{\n				id = \"lights\",\n				label = \"Take the lights\",\n				outcome = \"You ran the whole board yourself. Nobody in the audience knew your name and the show didn't work without you.\",\n				effects = { smarts = 6, happiness = 2, looks = -1 },\n			},\n		},\n	},\n\n	-- Everything below here only exists in some lives.\n	--\n	-- These are the first events whose reason for being offered is a decision the\n	-- player made rather than a birthday they reached, and they are written so the\n	-- earlier decision is legible without being narrated. Nobody is told \"because you\n	-- knelt down to that dog at three\". They are simply the child who is not\n	-- frightened of the thing in the doorway, and if the player remembers why then the\n	-- game has done its job, and if they do not then it still has not lied to them.\n	--\n	-- Written in pairs on purpose. A branch that only pays out one way is a reward for\n	-- having guessed right, and the premise here is that there was nothing to guess: a\n	-- three-year-old backing away from an animal twice their size is not making a\n	-- mistake.\n	{\n		id = \"school_dog_again\",\n		minAge = 6,\n		maxAge = 10,\n		delivery = \"Direct\",\n		requires = { \"dog_loved\" },\n		prompt = \"There's a dog tied up outside the shop, and it has started making a noise at you that you're fairly sure is friendly.\",\n		writesBack = { \"stat:happiness\", \"stat:looks\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"straight_in\",\n				label = \"Go straight over\",\n				outcome = \"You were on your knees in front of it before its owner got out of the shop. They said it never does that with kids. You knew it would.\",\n				effects = { happiness = 6, looks = 1 },\n			},\n			{\n				id = \"ask_first\",\n				label = \"Wait and ask the owner first\",\n				outcome = \"You waited, asked properly, and got a yes and an extra minute for asking. Somebody's parent said something approving about you within earshot.\",\n				effects = { smarts = 5, happiness = 3 },\n			},\n			{\n				id = \"walk_on\",\n				label = \"Walk on past\",\n				outcome = \"You were late and you walked on, and thought about it again that evening. It is a small thing to still remember.\",\n				effects = { happiness = -2, smarts = 2 },\n			},\n		},\n	},\n	{\n		id = \"school_dog_still\",\n		minAge = 6,\n		maxAge = 10,\n		delivery = \"Direct\",\n		requires = { \"dog_feared\" },\n		prompt = \"There's a dog tied up outside the shop. The doorway is narrow and it is lying across most of it.\",\n		writesBack = { \"stat:happiness\", \"stat:health\", \"stat:smarts\", \"flag:dog_feared\" },\n		choices = {\n			{\n				id = \"long_way\",\n				label = \"Go round the long way\",\n				outcome = \"You went round the block rather than past it. Nobody noticed and nobody would have minded, and you were furious with yourself the whole way.\",\n				effects = { happiness = -3, smarts = 3 },\n			},\n			{\n				id = \"edge_past\",\n				label = \"Edge past it against the wall\",\n				outcome = \"You got past with your back flat to the brick and your breath held. It did not even lift its head. That helped, slightly.\",\n				effects = { health = 1, smarts = 4, happiness = 1 },\n			},\n			{\n				id = \"hand_out_again\",\n				label = \"Put your hand out, the way you were shown\",\n				outcome = \"You put your hand out the way somebody had told you to, and it sniffed you and went back to sleep. It was not the cure. It was the first day it was survivable.\",\n				effects = { happiness = 5, health = 2 },\n				-- The one place in the game where a flag is undone, and the reason\n				-- `clears` exists on a choice at all. Being frightened of dogs is not a\n				-- sentence handed down at three, and a system that could only ever add\n				-- to what you are would be a system quietly claiming it is. The price is\n				-- walking up to the thing you are afraid of, which is the correct price\n				-- and the whole reason this is allowed to work.\n				clears = { \"dog_feared\" },\n			},\n		},\n	},\n	{\n		id = \"school_the_gap\",\n		minAge = 6,\n		maxAge = 11,\n		delivery = \"Direct\",\n		requires = { \"wandered_off\" },\n		prompt = \"You know a way out of the school field that the teachers don't. You found it the same way you found the hedge.\",\n		writesBack = { \"stat:happiness\", \"stat:health\", \"stat:looks\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"use_it\",\n				label = \"Use it\",\n				outcome = \"You were home forty minutes early and nobody ever asked how. You used it for two more years.\",\n				effects = { happiness = 5, smarts = 3, health = -1 },\n			},\n			{\n				id = \"show_someone\",\n				label = \"Show someone else\",\n				outcome = \"You showed one person, who showed four, and it was fenced off inside a fortnight. You were briefly the most important person in your year.\",\n				effects = { looks = 4, happiness = 3, smarts = -2 },\n			},\n			{\n				id = \"keep_it\",\n				label = \"Keep it to yourself and never use it\",\n				outcome = \"You kept it. Knowing the way out turned out to be worth more than going through it, which is a lesson that took decades to stop being useful.\",\n				effects = { smarts = 6, happiness = 1 },\n			},\n		},\n	},\n	{\n		id = \"school_the_window\",\n		minAge = 7,\n		maxAge = 12,\n		delivery = \"Direct\",\n		requires = { \"broke_it_owned_up\" },\n		prompt = \"A window is broken and the whole class is being kept in until somebody says something. It was not you.\",\n		writesBack = { \"stat:happiness\", \"stat:looks\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"say_nothing\",\n				label = \"Say nothing\",\n				outcome = \"You said nothing, which was true and still somehow felt like lying. Everyone went home an hour late.\",\n				effects = { happiness = -3, smarts = 3 },\n			},\n			{\n				id = \"vouch\",\n				label = \"Say you saw who it was\",\n				outcome = \"You said it out loud in front of everybody. It was the right thing and it cost you two friendships, and you would do it again, which is the part that worries you.\",\n				effects = { smarts = 4, happiness = -2, looks = 2 },\n			},\n			{\n				id = \"take_it\",\n				label = \"Say it was you\",\n				outcome = \"You took it for somebody who never found out it was you. You have never told anyone and you are still slightly proud of it.\",\n				effects = { happiness = 4, smarts = 2, looks = -1 },\n			},\n		},\n	},\n\n	-- Being unwell. The birthday health loop (see LifeService) hands out sickness\n	-- as a number; these are the times it is handed over by name, so the response\n	-- to it is a choice instead of a notice. Forbids so an illness already begun\n	-- can never be begun again by content -- the flag is the state, and there is\n	-- nothing a second set would add. Weighted below an ordinary event on purpose:\n	-- either answer commits the rest of the year.\n	{\n		id = \"school_sick_day\",\n		minAge = 6,\n		maxAge = 12,\n		delivery = \"Direct\",\n		forbids = { \"sick\" },\n		weight = 0.5,\n		prompt = \"You wake up with a sore throat and a head full of cotton. It's a school morning, and you can feel in your bones that it isn't going to be one.\",\n		writesBack = { \"stat:happiness\", \"stat:health\", \"stat:smarts\", \"flag:sick\" },\n		choices = {\n			{\n				id = \"stay_in_bed\",\n				label = \"Stay in bed\",\n				outcome = \"You rolled over and slept until the house went quiet. You needed it, and the day was wasted in the one way that isn't.\",\n				effects = { health = 4, happiness = -2 },\n				sets = { \"sick\" },\n			},\n			{\n				id = \"go_anyway_school\",\n				label = \"Get up and go anyway\",\n				outcome = \"You went in and sat through it like a bad dream. You don't remember a word of any lesson, but nobody can say you missed school.\",\n				effects = { smarts = 2, health = -2, happiness = -1 },\n				sets = { \"sick\" },\n			},\n		},\n	},\n\n	-- Interact events: the player walks to something in the school and clicks the dots\n	-- on it. Zero events in the whole game used this delivery before these four, and\n	-- that is the gap these fill: school had a door and nothing inside, and these are\n	-- the things inside.\n	{\n		id = \"school_locker_note\",\n		minAge = 7,\n		maxAge = 12,\n		delivery = \"Interact\",\n		prompt = \"There's a note slipped through the grille of your locker. It's folded in the careful way people write things they don't want everyone to read.\",\n		writesBack = { \"stat:happiness\", \"stat:looks\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"read_alone\",\n				label = \"Read it right there\",\n				outcome = \"It was from someone who sat next to you and wanted to be your friend. You were too surprised to do anything about it until the next day.\",\n				effects = { happiness = 4, looks = 1 },\n			},\n			{\n				id = \"read_toilet\",\n				label = \"Take it to the bathroom to read\",\n				outcome = \"You read it alone and it made you smile for the rest of the afternoon. You kept it in your pocket for a week.\",\n				effects = { happiness = 3, smarts = 2 },\n			},\n			{\n				id = \"bin_it\",\n				label = \"Put it in the bin without reading it\",\n				outcome = \"You binned it, and it was only later you realised you'd never find out who wrote it. Sometimes you still wonder.\",\n				effects = { happiness = -2 },\n			},\n		},\n	},\n	{\n		id = \"school_water_fountain\",\n		minAge = 6,\n		maxAge = 12,\n		delivery = \"Interact\",\n		prompt = \"The water fountain is making that noise again -- half cough, half splutter -- but you haven't had a drink since break.\",\n		writesBack = { \"stat:happiness\", \"stat:health\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"drink_anyway\",\n				label = \"Drink anyway\",\n				outcome = \"You drank. It tasted like cold metal and the pipes, and you were fine. You were thirsty and it worked.\",\n				effects = { health = 2, happiness = 1 },\n			},\n			{\n				id = \"wait_for_it\",\n				label = \"Wait for the next person to try first\",\n				outcome = \"A year six went first and it worked, so you went second. You learned something about patience and something about plumbing.\",\n				effects = { smarts = 3, happiness = 1 },\n			},\n			{\n				id = \"tap_it\",\n				label = \"Tap the side of it firmly\",\n				outcome = \"You hit it once, hard, and the water came out clean. Nobody saw. You used the same trick for three years.\",\n				effects = { smarts = 4, happiness = 2 },\n			},\n		},\n	},\n	{\n		id = \"school_notice_board\",\n		minAge = 7,\n		maxAge = 12,\n		delivery = \"Interact\",\n		prompt = \"There's a notice pinned to the board that's been there since last term. Somebody has drawn a moustache on the headmaster's photo.\",\n		writesBack = { \"stat:happiness\", \"stat:looks\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"add_to_it\",\n				label = \"Add a pair of glasses\",\n				outcome = \"You added the glasses and three people laughed at lunch. The photo came down the next day and you felt briefly responsible for something good.\",\n				effects = { happiness = 5, looks = 2, smarts = -1 },\n			},\n			{\n				id = \"take_photo\",\n				label = \"Take a photo of it\",\n				outcome = \"You took a photo and showed it to three people on the way home. It was the first thing that made you laugh all week.\",\n				effects = { happiness = 3 },\n			},\n			{\n				id = \"ignore_board\",\n				label = \"Walk past it\",\n				outcome = \"You walked past and forgot about it by lunch. The headmaster's photo looked exactly the same tomorrow.\",\n				effects = { smarts = 1 },\n			},\n		},\n	},\n	{\n		id = \"school_library_book\",\n		minAge = 7,\n		maxAge = 12,\n		delivery = \"Interact\",\n		prompt = \"There's a book on the library shelf with your name in it -- not written, but printed. It's about something you've never heard of and it's got a torn jacket.\",\n		writesBack = { \"stat:happiness\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"borrow_it\",\n				label = \"Borrow it\",\n				outcome = \"You took it home and read it in two days. It was about a boy who built a radio, and you spent the next month trying to make one from parts in the kitchen drawer.\",\n				effects = { smarts = 6, happiness = 3 },\n			},\n			{\n				id = \"read_there\",\n				label = \"Read the first chapter right there\",\n				outcome = \"You sat on the floor and read until the librarian moved you on. You learned enough to want more but not enough to know what happened.\",\n				effects = { smarts = 4, happiness = 2 },\n			},\n			{\n				id = \"put_back\",\n				label = \"Put it back on the shelf\",\n				outcome = \"You put it back and walked out. The librarian reshelved it the next day and it sat there for another year.\",\n				effects = { happiness = -1 },\n			},\n		},\n	},\n}\n\nreturn School\n"
table.insert(AGES_MANIFEST, "src/server/content/LifeEvents/School.luau")
AGES_SOURCES["src/server/content/LifeEvents/Teen.luau"] = "--!strict\n-- Ages 13-17. The first years where a choice can cost something real, so the\n-- stat swings are wider than childhood's and more of them cut both ways.\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal Types = require(ReplicatedStorage:WaitForChild(\"Types\"))\n\ntype LifeEvent = Types.LifeEvent\n\nlocal Teen: { LifeEvent } = {\n	{\n		id = \"teen_night_before\",\n		minAge = 15,\n		maxAge = 17,\n		delivery = \"Direct\",\n		prompt = \"Big exam in the morning. It's already late and you've covered about half of what you meant to.\",\n		writesBack = { \"stat:happiness\", \"stat:health\", \"stat:looks\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"all_night\",\n				label = \"Stay up and do the rest\",\n				outcome = \"You got through it all by three in the morning and took the exam on four hours' sleep. You passed, and you felt terrible for two days.\",\n				effects = { smarts = 6, health = -4, looks = -2 },\n			},\n			{\n				id = \"sleep\",\n				label = \"Go to bed\",\n				outcome = \"You shut the book and slept properly. You didn't know everything, but what you did know came out cleanly.\",\n				effects = { health = 4, smarts = 2, happiness = 1 },\n			},\n			{\n				id = \"give_up\",\n				label = \"Give up and watch something\",\n				outcome = \"You watched three hours of nothing and went in cold. It went about as well as you'd expect, and it stung enough to change how you did it next time.\",\n				effects = { smarts = -3, happiness = 2, health = -1 },\n			},\n		},\n	},\n	{\n		id = \"teen_first_job\",\n		minAge = 15,\n		maxAge = 17,\n		delivery = \"Direct\",\n		prompt = \"There's a weekend job going. It's dull, it's badly paid, and it's yours if you want it.\",\n		writesBack = { \"stat:happiness\", \"stat:health\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"take_it\",\n				label = \"Take it\",\n				outcome = \"Six months of early Saturdays. You were tired constantly and you have never since been impressed by anyone complaining about hard work.\",\n				effects = { smarts = 4, health = -2, happiness = -1 },\n				-- Six hours a Saturday for six months at a teenager's rate, which is\n				-- well under the twenty an adult hour is worth in this game -- the\n				-- prompt says badly paid and the figure has to agree with it. Held as\n				-- one sum rather than paid weekly because the outcome covers the whole\n				-- six months in a sentence; when careers exist they will pay by the\n				-- hour and this stays what it is, a first job summarized.\n				payout = 1800,\n			},\n			{\n				id = \"study_instead\",\n				label = \"Turn it down and use the time to study\",\n				outcome = \"You kept your weekends and put them into your own work. It paid off later, though it didn't feel like it at the time.\",\n				effects = { smarts = 5, happiness = -2 },\n			},\n			{\n				id = \"free_time\",\n				label = \"Turn it down and do nothing in particular\",\n				outcome = \"You spent those Saturdays with your friends doing absolutely nothing. You'd defend that decision now.\",\n				effects = { happiness = 6, smarts = -2 },\n			},\n		},\n	},\n	{\n		id = \"teen_dance\",\n		minAge = 14,\n		maxAge = 17,\n		delivery = \"NPCApproach\",\n		cast = \"friend\",\n		prompt = \"There's a thing on Friday and everyone's going. Your friend has just turned up on the doorstep to make sure you're in.\",\n		writesBack = { \"stat:happiness\", \"stat:health\", \"stat:looks\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"go_alone\",\n				label = \"Go on your own and see who's there\",\n				outcome = \"You walked in alone, which was the hardest part, and then it was fine. It was better than fine.\",\n				effects = { happiness = 5, looks = 2, smarts = 1 },\n			},\n			{\n				id = \"go_with\",\n				label = \"Only go if someone goes with you\",\n				outcome = \"You found someone to walk in with. You spent most of it talking to them in a hallway, which turned out to be the good bit.\",\n				effects = { happiness = 4, looks = 1 },\n			},\n			{\n				id = \"stay_home\",\n				label = \"Stay home\",\n				outcome = \"You stayed in and heard about it all on Monday. You've wondered about it occasionally ever since.\",\n				effects = { happiness = -4, smarts = 2, health = 1 },\n			},\n		},\n	},\n	{\n		id = \"teen_borrowed_trouble\",\n		minAge = 13,\n		maxAge = 17,\n		delivery = \"NPCApproach\",\n		cast = \"friend\",\n		prompt = \"Your friends are walking out of the store with things they haven't paid for. One of them is holding the door for you.\",\n		writesBack = { \"stat:happiness\", \"stat:health\", \"stat:looks\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"walk_out\",\n				label = \"Walk out with them\",\n				outcome = \"Nothing happened, which was almost worse. You spent the next week convinced you'd be found out, and you never did it again.\",\n				effects = { happiness = -4, smarts = 2, health = -1 },\n			},\n			{\n				id = \"pay\",\n				label = \"Pay for yours and leave\",\n				outcome = \"You stood in line like an idiot while they waited outside laughing. Two of them got caught the following month.\",\n				effects = { smarts = 5, happiness = -1 },\n				-- The price of doing the right thing, and it is deliberately small: this\n				-- is whatever a teenager is holding in a store, not a purchase to weigh\n				-- up. What makes it worth having is what happens when the answer is no\n				-- -- a player with nothing in their pocket finds this choice locked and\n				-- has to walk out or speak up, which is a truer version of the moment\n				-- than one where paying is always available.\n				cost = 8,\n			},\n			{\n				id = \"stop_them\",\n				label = \"Tell them to put it back\",\n				outcome = \"You said it out loud and it landed badly. One of them listened, though, and told you so years later.\",\n				effects = { smarts = 4, happiness = -2, looks = 1 },\n			},\n		},\n	},\n\n	-- Being unwell, mid-teens: the first sickness that can cost you something you\n	-- chose. Forbids an illness the birthday roll already started, and weighted\n	-- below an ordinary event -- either answer commits the rest of the year.\n	{\n		id = \"teen_sick_that_week\",\n		minAge = 13,\n		maxAge = 17,\n		delivery = \"Direct\",\n		forbids = { \"sick\" },\n		weight = 0.5,\n		prompt = \"You've gone and come down with something, and you're meant to be out this weekend. You can feel it in your bones already.\",\n		writesBack = { \"stat:happiness\", \"stat:health\", \"flag:sick\" },\n		choices = {\n			{\n				id = \"call_it_off\",\n				label = \"Call it off and rest\",\n				outcome = \"You cancelled and spent the weekend on the sofa with the heating on. You got better. You're still slightly annoyed about it.\",\n				effects = { health = 4, happiness = -2 },\n				sets = { \"sick\" },\n			},\n			{\n				id = \"go_anyway_teen\",\n				label = \"Go anyway\",\n				outcome = \"You went, and you were a ghost at your own night. You paid for it for a week afterwards, and you'd make the same call again.\",\n				effects = { happiness = 3, health = -3 },\n				sets = { \"sick\" },\n			},\n		},\n	},\n}\n\nreturn Teen\n"
table.insert(AGES_MANIFEST, "src/server/content/LifeEvents/Teen.luau")
AGES_SOURCES["src/server/content/LifeEvents/Ties.luau"] = "--!strict\n-- Events that exist only because a tie exists. A rival, a mentor, a sibling --\n-- each is a relationship that the game does not model with a flag because the\n-- relationship is always with one specific person, and a flag cannot carry that\n-- weight. Instead these events carry tags that the context builder fills in\n-- when the player stands near somebody they share that tie with, so the picker\n-- can prefer them without the event needing to name a specific cast member.\n--\n-- None of these sets `cast`, and that is the fix rather than an omission. `cast`\n-- takes a *cast id* -- one specific authored person -- and \"mentor\" is a tie id, not\n-- a person: the mentor is whichever townsperson this particular life promoted, which\n-- is known only at context time and is already carried by the tag above.\n--\n-- These four events used to read `cast = \"mentor\"`, `\"rival\"`, `\"sibling\"`, `\"enemy\"`\n-- on the belief that the field took a *kind* of person. It does not, Cast holds no\n-- such members, and the content validator threw on require -- which took EventService,\n-- then init.server, then every service in the game place down with it. The symptom was\n-- a place that loaded with nothing running at all, which reads as a broken build rather\n-- than as a content error, and it is why this is written down instead of just deleted.\n-- Types.LifeEvent documents nil as allowed and falling back to the first cast member.\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal Types = require(ReplicatedStorage:WaitForChild(\"Types\"))\n\ntype LifeEvent = Types.LifeEvent\n\nlocal Ties: { LifeEvent } = {\n	-- A mentor who has been waiting for you to be ready for something bigger.\n	-- The mentor does not push -- they leave the door open and let you walk\n	-- through it, which is the difference between guidance and pressure.\n	{\n		id = \"tie_mentor_guidance\",\n		minAge = 16,\n		maxAge = 70,\n		delivery = \"NPCApproach\",\n		repeatable = true,\n		weight = 0.6,\n		tags = { \"tie:mentor:*\" },\n		prompt = \"Your mentor is at the door with a folder under their arm. They do not sit down. 'I have something for you,' they say, and the way they say it tells you this is not a favour, it is an opportunity.\",\n		writesBack = { \"stat:happiness\", \"stat:smarts\", \"stat:looks\" },\n		choices = {\n			{\n				id = \"take_it\",\n				label = \"Take it\",\n				outcome = \"You took the folder and opened it on the table. It was more than you expected and less than you deserved, which is exactly what a real opportunity looks like.\",\n				effects = { happiness = 5, smarts = 4, looks = 1 },\n			},\n			{\n				id = \"ask_why\",\n				label = \"Ask why them\",\n				outcome = \"You asked why they were the one doing this, and they smiled the way people smile when the answer is simple and you have not thought of it yet. 'Because you listened,' they said.\",\n				effects = { happiness = 3, smarts = 5 },\n			},\n			{\n				id = \"decline\",\n				label = \"Say you need to think about it\",\n				outcome = \"They nodded and did not push. You watched them walk away and wondered whether you had just been polite about something you should have said yes to immediately.\",\n				effects = { happiness = -2, smarts = 2 },\n			},\n		},\n	},\n\n	-- A rival who has been watching and decides to make a move. Not hostile in\n	-- the sharp sense -- a rival in this game is someone who respects you enough\n	-- to chase you, not someone who wants to hurt you. The challenge is real,\n	-- the stakes are real, and the outcome shifts who you are.\n	{\n		id = \"tie_rival_challenge\",\n		minAge = 16,\n		maxAge = 60,\n		delivery = \"NPCApproach\",\n		repeatable = true,\n		weight = 0.5,\n		tags = { \"tie:rival:*\" },\n		prompt = \"Your rival is leaning against the wall where you pass every day. They do not move when you approach. 'I heard what you did,' they say. 'I want to see if you can do it again.'\",\n		writesBack = { \"stat:happiness\", \"stat:health\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"accept\",\n				label = \"Accept the challenge\",\n				outcome = \"You said yes and meant it. They nodded once -- that was the agreement -- and walked away. You did not know what the challenge was yet, but you knew you were going to meet it.\",\n				effects = { happiness = 4, health = 2, smarts = 1 },\n			},\n			{\n				id = \"ask_details\",\n				label = \"Ask what the challenge is\",\n				outcome = \"They told you, and it was harder than you expected. Not because it was difficult but because it was personal, and that is the kind of challenge a rival gives.\",\n				effects = { happiness = 2, smarts = 4, health = -1 },\n			},\n			{\n				id = \"refuse\",\n				label = \"Tell them you are not interested\",\n				outcome = \"They did not look surprised. 'Figures,' they said, and walked away. The word sat with you for a week, and you did not know whether it was their word or yours.\",\n				effects = { happiness = -4, smarts = 2 },\n			},\n		},\n	},\n\n	-- A sibling who needs you. Not a crisis -- a sibling relationship in this\n	-- game is about choice and permanence, and this is the moment the choice\n	-- shows up as something you have to do rather than something you have to\n	-- decide. The loyalty is the point.\n	{\n		id = \"tie_sibling_loyalty\",\n		minAge = 16,\n		maxAge = 60,\n		delivery = \"NPCApproach\",\n		repeatable = true,\n		weight = 0.7,\n		tags = { \"tie:sibling:*\" },\n		prompt = \"Your sibling is at the door and they do not look like themselves. 'I need you to do something,' they say, and the way they say it means this is not the first time and it will not be the last.\",\n		writesBack = { \"stat:happiness\", \"stat:health\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"help\",\n				label = \"Help without asking questions\",\n				outcome = \"You asked nothing and did everything. That is what siblings are for, and you knew it the moment they walked in. It was the easiest and the hardest thing you have ever done.\",\n				effects = { happiness = 6, health = -2, smarts = 1 },\n			},\n			{\n				id = \"ask_first\",\n				label = \"Ask what they need\",\n				outcome = \"They told you, and it was worse than you imagined. You said yes before they finished, which is the only right answer and also the only one that does not feel easy.\",\n				effects = { happiness = 4, smarts = 3, health = -1 },\n			},\n			{\n				id = \"delay\",\n				label = \"Say you need to sort things out first\",\n				outcome = \"They understood. Not because you explained -- you did not need to -- but because siblings understand that kind of pause. You will fix it, and they will wait.\",\n				effects = { happiness = -3, smarts = 3, health = 1 },\n			},\n		},\n	},\n	-- An enemy is the relationship that remains when the ladder is burned. Not\n	-- a rival -- a rival still respects you enough to chase you. An enemy does\n	-- not. They remember what you did, and every future encounter is a reminder\n	-- that some bridges cannot be crossed back. The event exists because a life\n	-- with one person who means this much in this direction needs a moment\n	-- where that weight shows up as something the player has to face.\n	{\n		id = \"tie_enemy_confrontation\",\n		minAge = 16,\n		maxAge = 999,\n		delivery = \"NPCApproach\",\n		repeatable = true,\n		weight = 0.4,\n		tags = { \"tie:enemy:*\" },\n		prompt = \"Your enemy is at the end of the street and they see you. They do not look away. 'I have been waiting for this,' they say, and the way they say it makes it clear that whatever happens next will not be the last time either of you forgets.\",\n		writesBack = { \"stat:happiness\", \"stat:health\" },\n		choices = {\n			{\n				id = \"stand_your_ground\",\n				label = \"Stand your ground\",\n				outcome = \"You did not move. They did not either. The silence between you was heavier than words, and neither of you broke it. It was not a victory. It was not a defeat. It was just the truth of what you had made of each other.\",\n				effects = { happiness = -2, health = 1 },\n			},\n			{\n				id = \"walk_away\",\n				label = \"Walk away\",\n				outcome = \"You turned your back and walked. You did not look over your shoulder. Behind you, they did not call after you. Ahead of you, the street was empty and the weight did not go with them.\",\n				effects = { happiness = -5, smarts = 2 },\n			},\n			{\n				id = \"speak_first\",\n				label = \"Say something first\",\n				outcome = \"You spoke before they could. The words came out wrong -- too sharp, or too soft, or just not the right shape for what you meant. They listened without reacting, and when you finished, they nodded once and moved on. You were left with the echo.\",\n				effects = { happiness = -3, smarts = 3 },\n			},\n		},\n	},\n}\n\nreturn Ties\n"
table.insert(AGES_MANIFEST, "src/server/content/LifeEvents/Ties.luau")
AGES_SOURCES["src/server/content/LifeEvents/Work.luau"] = "--!strict\n-- Things that happen while you are working. Delivered by the \"Shift\" route,\n-- which means they are fired by WorkService partway through a shift and can\n-- never be handed out by a birthday or left on the doormat -- a customer cannot\n-- be shouting at you in your own kitchen.\n--\n-- Written to be true of any job wherever possible, because there are two and\n-- neither is special enough to need its own pool. The office events are gated by\n-- age rather than by job for the same reason: at eighteen the office is the job\n-- you have, so age is doing the work already and a second mechanism would be\n-- machinery with nothing to hold.\n--\n-- These are answered by walking where the room allows it. A shift is the least\n-- interesting four minutes in the game if nothing happens in it, and every one of\n-- these is a small thing that costs something -- an hour, twenty dollars, the\n-- rest of your evening, being the person who said it out loud.\n--\n-- Two fields carry the weight here.\n--\n-- `performance` is what the answer does to your record at the job you are working,\n-- and it is required on every choice in this file. The interesting ones are where\n-- it disagrees with the stats: telling a rude customer exactly what you think is\n-- worth real happiness and real damage to your standing, and both of those are\n-- true. An answer that is good for you and bad for your record is the most\n-- honest thing this system can offer, and there should always be some.\n--\n-- `repeatable` marks the events that are texture rather than milestones. A quiet\n-- hour with nobody in the shop happens a hundred times in a working life; being\n-- handed the keys happens once. Selection always prefers something unlived, so\n-- marking an event repeatable never costs a fresh one its turn -- it only means\n-- that a career longer than the content does not fall silent.\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal Types = require(ReplicatedStorage:WaitForChild(\"Types\"))\n\ntype LifeEvent = Types.LifeEvent\n\nlocal Work: { LifeEvent } = {\n	{\n		id = \"work_wrong_change\",\n		minAge = 16,\n		maxAge = 999,\n		delivery = \"Shift\",\n		resolution = \"Enacted\",\n		subject = \"customer\",\n		repeatable = true,\n		prompt = \"You've handed someone twenty dollars too much change. They're already at the door.\",\n		writesBack = { \"stat:happiness\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"call_after\",\n				label = \"Call after them\",\n				outcome = \"They came back, gave it over, and told your manager you were honest. It went further than you expected.\",\n				effects = { happiness = 3, smarts = 2 },\n				performance = 3,\n				reaction = \"approach\",\n			},\n			{\n				id = \"cover_it\",\n				label = \"Cover it out of your own pocket\",\n				cost = 20,\n				outcome = \"The till balanced perfectly. Nobody ever knew, and you were quietly furious with yourself for a week.\",\n				effects = { happiness = -2, smarts = 3 },\n				-- The till balanced, which is the only thing the job can see. It cost you\n				-- twenty dollars and a week of temper to buy a result nobody thanked you\n				-- for, and that gap is the whole point of the choice.\n				performance = 1,\n				reaction = \"settle\",\n			},\n			{\n				id = \"say_nothing\",\n				label = \"Say nothing and hope it balances\",\n				outcome = \"It did not balance. You spent the last hour of the shift watching someone else count it twice.\",\n				effects = { happiness = -4, smarts = 1 },\n				performance = -2,\n				reaction = \"withdraw\",\n			},\n		},\n	},\n	{\n		id = \"work_quiet_hour\",\n		minAge = 16,\n		maxAge = 999,\n		delivery = \"Shift\",\n		resolution = \"Enacted\",\n		repeatable = true,\n		prompt = \"Nobody has come in for forty minutes. There is nothing left to tidy and an hour still to go.\",\n		writesBack = { \"stat:happiness\", \"stat:health\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"find_work\",\n				label = \"Find something that actually needs doing\",\n				outcome = \"You reorganized a shelf nobody had touched in a year. Someone noticed, which was not why you did it.\",\n				effects = { smarts = 3, health = 1, happiness = -1 },\n				performance = 3,\n			},\n			{\n				id = \"read_boxes\",\n				label = \"Read the back of every box on the shelf\",\n				outcome = \"You now know an unreasonable amount about where things are made. It has come up more than once since.\",\n				effects = { smarts = 4, happiness = 1 },\n				performance = 1,\n			},\n			{\n				id = \"stand_still\",\n				label = \"Stand still and think about nothing\",\n				outcome = \"Forty minutes went somewhere. You couldn't have said where, and you felt better for it.\",\n				effects = { happiness = 3, smarts = -2 },\n				-- Nothing. Not a black mark -- there was genuinely nothing to do, and an\n				-- employer who could see this would have no opinion about it either.\n				performance = 0,\n			},\n		},\n	},\n	{\n		id = \"work_extra_hour\",\n		minAge = 16,\n		maxAge = 999,\n		delivery = \"Shift\",\n		resolution = \"Enacted\",\n		subject = \"manager\",\n		repeatable = true,\n		prompt = \"The evening person hasn't turned up. The manager asks, without much hope, whether you can stay on.\",\n		writesBack = { \"stat:happiness\", \"stat:health\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"stay_late\",\n				label = \"Stay until they find someone\",\n				payout = 120,\n				outcome = \"You got home at eleven and were paid for every minute. You were asked first for everything after that.\",\n				effects = { health = -3, happiness = -1, smarts = 1 },\n				performance = 3,\n				reaction = \"approach\",\n			},\n			{\n				id = \"stay_one\",\n				label = \"Stay one hour, then go\",\n				payout = 60,\n				outcome = \"An hour, exactly, and then your coat. It turned out that was allowed, which nobody had mentioned.\",\n				effects = { health = -1, smarts = 2 },\n				performance = 2,\n				reaction = \"settle\",\n			},\n			{\n				id = \"go_home\",\n				label = \"Say you can't tonight\",\n				outcome = \"You said no for the first time and nothing happened. The word got easier every time after.\",\n				effects = { happiness = 2, smarts = 2 },\n				-- Zero on purpose, and the outcome line is the argument: nothing happened.\n				-- Saying no to unpaid extra hours is allowed, and a game that quietly\n				-- marked you down for it would be teaching something it should not.\n				performance = 0,\n				reaction = \"settle\",\n			},\n		},\n	},\n	{\n		id = \"work_the_regular\",\n		minAge = 16,\n		maxAge = 999,\n		delivery = \"Shift\",\n		resolution = \"Enacted\",\n		subject = \"customer\",\n		repeatable = true,\n		prompt = \"The same man has been in every day this week, and today he would like to tell you about his week.\",\n		writesBack = { \"stat:happiness\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"listen\",\n				label = \"Listen properly\",\n				outcome = \"Twenty minutes about a greenhouse. You were the only person he spoke to that day, and you worked that out halfway through.\",\n				effects = { happiness = 4, smarts = 2 },\n				performance = 2,\n				reaction = \"approach\",\n			},\n			{\n				id = \"nod_along\",\n				label = \"Nod along and keep stocking\",\n				outcome = \"You got the shelf done and couldn't have repeated a word of it. He came in the next day anyway.\",\n				effects = { smarts = 1, happiness = -1 },\n				performance = 1,\n				reaction = \"settle\",\n			},\n			{\n				id = \"cut_it_short\",\n				label = \"Tell him you're behind on work\",\n				outcome = \"He apologized, which was worse. You watched the door for a week before he came back in.\",\n				effects = { happiness = -3, smarts = 2 },\n				performance = -1,\n				reaction = \"withdraw\",\n			},\n		},\n	},\n	{\n		id = \"work_rude_customer\",\n		minAge = 16,\n		maxAge = 999,\n		delivery = \"Shift\",\n		resolution = \"Enacted\",\n		subject = \"customer\",\n		repeatable = true,\n		prompt = \"Someone is being unpleasant to you about a thing that is not your fault and cannot be fixed.\",\n		writesBack = { \"stat:happiness\", \"stat:health\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"stay_polite\",\n				label = \"Stay polite and keep serving\",\n				outcome = \"You were pleasant right up until they left, and then you stood very still for a moment behind the counter.\",\n				effects = { happiness = -3, smarts = 2 },\n				performance = 2,\n				reaction = \"settle\",\n			},\n			{\n				id = \"get_manager\",\n				label = \"Get the manager\",\n				outcome = \"The manager said the same thing you had said, and was believed. You have thought about that a number of times since.\",\n				effects = { happiness = -1, smarts = 3 },\n				performance = 1,\n				reaction = \"withdraw\",\n			},\n			{\n				id = \"say_it\",\n				label = \"Tell them exactly what you think\",\n				outcome = \"It was the best four seconds of your week and it cost you the rest of it. You would probably do it again.\",\n				effects = { happiness = 5, health = -1 },\n				-- The point of this whole file in one number. It is genuinely the best\n				-- answer for the person and genuinely the worst for the record, and the\n				-- player gets to decide which of those they are playing for today.\n				performance = -3,\n				reaction = \"withdraw\",\n			},\n		},\n	},\n	{\n		id = \"work_short_till\",\n		minAge = 16,\n		maxAge = 999,\n		delivery = \"Shift\",\n		resolution = \"Enacted\",\n		repeatable = true,\n		prompt = \"The till is eleven dollars short. Three people have used it today and one of them was you.\",\n		writesBack = { \"stat:happiness\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"count_again\",\n				label = \"Count it again from the start\",\n				outcome = \"It was a note stuck behind another note. You found it in four minutes and nobody else ever knew there was a problem.\",\n				effects = { smarts = 4, happiness = 1 },\n				performance = 3,\n			},\n			{\n				id = \"own_it\",\n				label = \"Say it was probably you\",\n				outcome = \"It probably wasn't. You were thanked for saying so anyway, in a tone that suggested that was rarer than it should be.\",\n				effects = { happiness = -1, smarts = 1 },\n				performance = 2,\n			},\n			{\n				id = \"wait\",\n				label = \"Wait to be asked\",\n				outcome = \"Nobody asked. It was written off, and the counting got slower for everyone for a month afterward.\",\n				effects = { happiness = -2, smarts = 1 },\n				performance = -1,\n			},\n		},\n	},\n	{\n		id = \"work_new_starter\",\n		minAge = 16,\n		maxAge = 999,\n		delivery = \"Shift\",\n		resolution = \"Enacted\",\n		subject = \"coworker\",\n		repeatable = true,\n		prompt = \"Somebody started this morning and has been standing near the door for twenty minutes with nothing to do.\",\n		writesBack = { \"stat:happiness\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"show_them\",\n				label = \"Show them yourself\",\n				outcome = \"You taught someone a job for the first time and found out how much of it you actually knew.\",\n				effects = { smarts = 3, happiness = 3 },\n				performance = 3,\n				reaction = \"approach\",\n			},\n			{\n				id = \"point_them\",\n				label = \"Point them at the manager\",\n				outcome = \"The manager was busy, so they stood somewhere else for a while instead. They got there in the end.\",\n				effects = { smarts = 1, happiness = -1 },\n				performance = 0,\n				reaction = \"settle\",\n			},\n			{\n				id = \"leave_them\",\n				label = \"Let them work it out\",\n				outcome = \"You worked it out on your own once and it did you no harm, you told yourself, for most of the afternoon.\",\n				effects = { happiness = -3, smarts = 1 },\n				performance = -2,\n				reaction = \"withdraw\",\n			},\n		},\n	},\n	{\n		id = \"work_running_late\",\n		minAge = 16,\n		maxAge = 999,\n		delivery = \"Shift\",\n		resolution = \"Enacted\",\n		repeatable = true,\n		prompt = \"You are twenty-five minutes late and the bus was genuinely not your fault. Nobody has said anything yet.\",\n		writesBack = { \"stat:happiness\", \"stat:health\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"make_it_up\",\n				label = \"Stay late and make the time up\",\n				outcome = \"You left twenty-five minutes after everyone else, and it was never mentioned again by anybody, which was the idea.\",\n				effects = { health = -2, smarts = 2 },\n				performance = 3,\n			},\n			{\n				id = \"say_so\",\n				label = \"Say so before anyone asks\",\n				outcome = \"It turned out three other people had the same bus. Saying it first was still the part that was remembered.\",\n				effects = { smarts = 2, happiness = 1 },\n				performance = 2,\n			},\n			{\n				id = \"hope\",\n				label = \"Say nothing and hope\",\n				outcome = \"It had been noticed. Not enough to be raised with you, only enough to be remembered the next time.\",\n				effects = { happiness = -2, smarts = 1 },\n				performance = -2,\n			},\n		},\n	},\n	{\n		id = \"work_stocktake\",\n		minAge = 16,\n		maxAge = 999,\n		delivery = \"Shift\",\n		resolution = \"Enacted\",\n		repeatable = true,\n		prompt = \"The stockroom needs counting. It is four hours of the dullest work in the building and nobody has volunteered.\",\n		writesBack = { \"stat:happiness\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"volunteer\",\n				label = \"Put your hand up for it\",\n				outcome = \"Four hours alone with a clipboard. You came out knowing where everything in the building was, which turned out to matter.\",\n				effects = { happiness = -3, smarts = 4 },\n				performance = 3,\n			},\n			{\n				id = \"wait_assigned\",\n				label = \"Wait to be assigned\",\n				outcome = \"You were assigned it. It was exactly the same four hours and nobody thought anything of it either way.\",\n				effects = { happiness = -2, smarts = 2 },\n				performance = 0,\n			},\n			{\n				id = \"vanish\",\n				label = \"Find somewhere else to be\",\n				outcome = \"Somebody else did it. You were not asked to do the next one either, and that stopped feeling like winning fairly quickly.\",\n				effects = { happiness = 1, smarts = -1 },\n				performance = -2,\n			},\n		},\n	},\n	{\n		id = \"work_first_keys\",\n		minAge = 16,\n		maxAge = 999,\n		delivery = \"Shift\",\n		resolution = \"Enacted\",\n		subject = \"manager\",\n		-- Not repeatable. You are handed the keys for the first time once, and an\n		-- event that came round again would be saying it never meant anything.\n		prompt = \"The manager is holding out a set of keys and asking whether you want to be the one who locks up.\",\n		writesBack = { \"stat:happiness\", \"stat:health\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"take_them\",\n				label = \"Take them\",\n				outcome = \"You were the last person in the building every Sunday for two years, and the first person anyone asked about anything.\",\n				effects = { happiness = 2, health = -2, smarts = 3 },\n				performance = 4,\n				reaction = \"approach\",\n			},\n			{\n				id = \"ask_pay\",\n				label = \"Ask what it pays first\",\n				outcome = \"It paid nothing extra. You took them anyway, but you had asked, and asking turned out to be a thing you could do.\",\n				effects = { smarts = 4, happiness = 1 },\n				performance = 2,\n				reaction = \"settle\",\n			},\n			{\n				id = \"decline\",\n				label = \"Say you'd rather not\",\n				outcome = \"Somebody else locked up. Your evenings stayed yours, which you did not regret as often as you expected to.\",\n				effects = { happiness = 3, health = 1 },\n				performance = -1,\n				reaction = \"settle\",\n			},\n		},\n	},\n	{\n		id = \"work_office_credit\",\n		minAge = 18,\n		maxAge = 999,\n		delivery = \"Shift\",\n		resolution = \"Enacted\",\n		subject = \"coworker\",\n		repeatable = true,\n		prompt = \"Someone has just presented your work in a meeting, saying 'we' throughout, and is now taking questions on it.\",\n		writesBack = { \"stat:happiness\", \"stat:health\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"in_the_room\",\n				label = \"Say something, in the room\",\n				outcome = \"You answered the third question yourself, because you were the only one who could. Nobody said a word about it afterward, and everybody had noticed.\",\n				effects = { smarts = 3, happiness = 2, health = -1 },\n				performance = 3,\n				reaction = \"settle\",\n			},\n			{\n				id = \"afterward\",\n				label = \"Say something afterward, privately\",\n				outcome = \"They were mortified and it never happened again. It also never got corrected in front of the people who mattered.\",\n				effects = { smarts = 4, happiness = 1 },\n				performance = 1,\n				reaction = \"withdraw\",\n			},\n			{\n				id = \"let_it_go\",\n				label = \"Let it go\",\n				outcome = \"You let it go, and then let the next one go, and by the third you had stopped expecting anything else.\",\n				effects = { smarts = 2, happiness = -3 },\n				performance = -1,\n				reaction = \"settle\",\n			},\n		},\n	},\n	{\n		id = \"work_office_deadline\",\n		minAge = 18,\n		maxAge = 999,\n		delivery = \"Shift\",\n		resolution = \"Enacted\",\n		subject = \"manager\",\n		repeatable = true,\n		prompt = \"You have been asked whether something can be finished by Friday. It cannot be finished by Friday.\",\n		writesBack = { \"stat:happiness\", \"stat:health\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"say_no\",\n				label = \"Say it can't be done by Friday\",\n				outcome = \"You were asked what could. It was a shorter conversation than you had braced for, and the date moved.\",\n				effects = { smarts = 4, happiness = 1 },\n				performance = 3,\n				reaction = \"settle\",\n			},\n			{\n				id = \"weekend\",\n				label = \"Say yes and work the weekend\",\n				payout = 200,\n				outcome = \"It was finished by Friday. The next thing was also due on a Friday, and so was the one after that.\",\n				effects = { health = -5, happiness = -3, smarts = 2 },\n				-- Rewarded, and that is deliberately uncomfortable. It is worth less than\n				-- saying no was, because saying no was the answer that fixed the date --\n				-- but it is not worth nothing, because in an office it never is.\n				performance = 2,\n				reaction = \"approach\",\n			},\n			{\n				id = \"quietly_miss\",\n				label = \"Say yes and quietly miss it\",\n				outcome = \"Friday came. Everyone found out at the same moment, which was the worst possible moment for everyone to find out.\",\n				effects = { happiness = -4, smarts = 1 },\n				performance = -3,\n				reaction = \"withdraw\",\n			},\n		},\n	},\n	{\n		id = \"work_office_mentor\",\n		minAge = 18,\n		maxAge = 999,\n		delivery = \"Shift\",\n		resolution = \"Enacted\",\n		subject = \"coworker\",\n		-- Not repeatable, for the same reason as the keys: the first time someone\n		-- else's work becomes partly your responsibility only happens once.\n		prompt = \"You have been asked to bring someone up to speed. They are perfectly capable and know none of it.\",\n		writesBack = { \"stat:happiness\", \"stat:health\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"properly\",\n				label = \"Show them properly, over weeks\",\n				outcome = \"It cost you most of a month. Two years later they were better at it than you, and said where they had learned it.\",\n				effects = { smarts = 3, happiness = 4, health = -2 },\n				performance = 4,\n				reaction = \"approach\",\n			},\n			{\n				id = \"basics\",\n				label = \"Show them the basics and move on\",\n				outcome = \"They got there eventually, by asking other people the things you had not covered.\",\n				effects = { smarts = 1 },\n				performance = 1,\n				reaction = \"settle\",\n			},\n			{\n				id = \"no_time\",\n				label = \"Tell them you haven't the time\",\n				outcome = \"You did have the time, and both of you knew it. They learned the job anyway and never asked you anything again.\",\n				effects = { happiness = -3, smarts = 1 },\n				performance = -2,\n				reaction = \"withdraw\",\n			},\n		},\n	},\n\n	-- B2 additions. The first events that name their own unlock: `jobs` gates a\n	-- moment to the workplace it only makes sense at, and `minStanding` makes the\n	-- ladder a door rather than a label -- a review, a complaint from corporate, a\n	-- responsibility handed over because you are the one who can be trusted with\n	-- it. Ungated events stay ungated so a record that never climbs still has\n	-- texture; these are what the climbing is for.\n	{\n		id = \"work_office_swap\",\n		minAge = 18,\n		maxAge = 999,\n		delivery = \"Shift\",\n		resolution = \"Enacted\",\n		subject = \"coworker\",\n		jobs = { \"office_clerk\" },\n		repeatable = true,\n		prompt = \"A coworker is trying to work out their week and asks whether you could swap one of your shifts for theirs.\",\n		writesBack = { \"stat:happiness\", \"stat:health\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"swap_yes\",\n				label = \"Swap, and take the later one\",\n				outcome = \"You swapped. The later shift was the quiet one, and you got a week of their gratitude for two hours nobody else wanted.\",\n				effects = { happiness = 3, smarts = 1 },\n				performance = 2,\n				reaction = \"approach\",\n			},\n			{\n				id = \"swap_terms\",\n				label = \"Swap, but on your terms\",\n				outcome = \"You swapped for the day you actually needed, which was not the day they offered. They took it, and you found out it was a negotiable sentence.\",\n				effects = { smarts = 4, happiness = 1 },\n				performance = 2,\n				reaction = \"settle\",\n			},\n			{\n				id = \"swap_cover\",\n				label = \"Offer to take theirs instead\",\n				payout = 100,\n				outcome = \"You took their shift outright. It made your week worse and their month better, and you were paid for every hour, which softened all of it.\",\n				effects = { health = -2, happiness = 2 },\n				performance = 3,\n				reaction = \"approach\",\n			},\n		},\n	},\n	{\n		id = \"work_office_rumour\",\n		minAge = 18,\n		maxAge = 999,\n		delivery = \"Shift\",\n		resolution = \"Enacted\",\n		subject = \"coworker\",\n		jobs = { \"office_clerk\" },\n		repeatable = true,\n		prompt = \"You catch the end of a conversation about you. A rumour about last week has been through the whole floor before you heard it.\",\n		writesBack = { \"stat:happiness\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"rumour_straight\",\n				label = \"Go and set it straight\",\n				outcome = \"You told one person, firmly, and watched it reverse direction at half speed. Some of it was already past saving.\",\n				effects = { smarts = 3, happiness = -1 },\n				performance = 1,\n				reaction = \"approach\",\n			},\n			{\n				id = \"rumour_laugh\",\n				label = \"Laugh about it with them\",\n				outcome = \"You laughed, which changed the rumour into a better one. You heard it back three days later with the lie swapped out.\",\n				effects = { happiness = 4, smarts = 1 },\n				performance = 2,\n				reaction = \"settle\",\n			},\n			{\n				id = \"rumour_ignore\",\n				label = \"Say nothing and let it die\",\n				outcome = \"It did not die. It lasted a fortnight, came back shaped differently, and you spent it answering for a version of you that never existed.\",\n				effects = { happiness = -3, smarts = 2 },\n				performance = -1,\n				reaction = \"withdraw\",\n			},\n		},\n	},\n	{\n		id = \"work_office_review\",\n		minAge = 18,\n		maxAge = 999,\n		delivery = \"Shift\",\n		resolution = \"Enacted\",\n		subject = \"manager\",\n		jobs = { \"office_clerk\" },\n		minStanding = 6,\n		repeatable = true,\n		prompt = \"The manager has your year on a single page and asks what you think your best thing was.\",\n		writesBack = { \"stat:happiness\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"review_honest\",\n				label = \"Name the thing you actually improved\",\n				outcome = \"You named a quiet thing, and they had noticed it too. The review became a conversation instead of a verdict.\",\n				effects = { smarts = 3, happiness = 3 },\n				performance = 3,\n				reaction = \"approach\",\n			},\n			{\n				id = \"review_flatter\",\n				label = \"Say the thing they want to hear\",\n				outcome = \"It worked. The review ended faster, and you sat through the next year knowing the page had been about the wrong thing.\",\n				effects = { smarts = 1, happiness = -2 },\n				performance = 2,\n				reaction = \"settle\",\n			},\n			{\n				id = \"review_quiet\",\n				label = \"Say nothing and take the marks\",\n				outcome = \"You let the page speak for you. It had your attendance on it and nothing else, which was your own doing.\",\n				effects = { happiness = -2, smarts = 2 },\n				performance = 0,\n				reaction = \"withdraw\",\n			},\n		},\n	},\n	{\n		id = \"work_office_corporate\",\n		minAge = 18,\n		maxAge = 999,\n		delivery = \"Shift\",\n		resolution = \"Enacted\",\n		subject = \"manager\",\n		jobs = { \"office_clerk\" },\n		minStanding = 14,\n		repeatable = true,\n		prompt = \"A complaint has come down from above and the manager has handed it to you, because you are the one who has been here longest.\",\n		writesBack = { \"stat:happiness\", \"stat:health\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"corporate_answer\",\n				label = \"Take it on and answer it properly\",\n				outcome = \"You drafted the reply, checked the numbers, and turned a complaint into a conversation. Your name was on the bottom, which had never happened before.\",\n				effects = { smarts = 4, happiness = 2, health = -1 },\n				performance = 4,\n				reaction = \"approach\",\n			},\n			{\n				id = \"corporate_deflect\",\n				label = \"Say it belongs to the person who caused it\",\n				outcome = \"You were right, and saying so meant the right person answered it. You also saw that being right cost a little something here, which was the lesson.\",\n				effects = { smarts = 3, happiness = -1 },\n				performance = 1,\n				reaction = \"settle\",\n			},\n			{\n				id = \"corporate_stall\",\n				label = \"Let it sit until they ask twice\",\n				outcome = \"They did not ask twice; they asked someone else, who got the credit for fixing it. The complaint died, and your mention in it stayed.\",\n				effects = { happiness = -2, smarts = 1 },\n				performance = -2,\n				reaction = \"withdraw\",\n			},\n		},\n	},\n	{\n		id = \"work_office_cover\",\n		minAge = 18,\n		maxAge = 999,\n		delivery = \"Shift\",\n		resolution = \"Enacted\",\n		subject = \"coworker\",\n		jobs = { \"office_clerk\" },\n		repeatable = true,\n		prompt = \"A coworker has called in sick for the meeting that matters most this week, and their share of it is yours now.\",\n		writesBack = { \"stat:happiness\", \"stat:health\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"cover_ready\",\n				label = \"Take it, and be ready for it\",\n				outcome = \"You read their notes in the hour before and carried their share. Nobody said thank you, which meant it went well.\",\n				effects = { smarts = 4, happiness = 1, health = -2 },\n				performance = 4,\n				reaction = \"approach\",\n			},\n			{\n				id = \"cover_warn\",\n				label = \"Take it, but flag the gaps\",\n				outcome = \"You covered it and named what you did not know. The room filled the gaps, and you learned that saying so was a strength, not a confession.\",\n				effects = { smarts = 3, happiness = 2 },\n				performance = 3,\n				reaction = \"settle\",\n			},\n			{\n				id = \"cover_pass\",\n				label = \"Pass it back to the manager\",\n				outcome = \"The manager took it, which was their job. You felt lighter and then smaller, in that order, and the second one took longer.\",\n				effects = { happiness = -2, smarts = 1 },\n				performance = -1,\n				reaction = \"withdraw\",\n			},\n		},\n	},\n	{\n		id = \"work_office_budget\",\n		minAge = 18,\n		maxAge = 999,\n		delivery = \"Shift\",\n		resolution = \"Enacted\",\n		subject = \"manager\",\n		jobs = { \"office_clerk\" },\n		minStanding = 14,\n		repeatable = true,\n		prompt = \"The manager drops the year's equipment budget on your desk. Enough for the thing the whole floor wants, or the thing that would save everyone an hour a day.\",\n		writesBack = { \"stat:happiness\", \"stat:looks\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"budget_floor\",\n				label = \"Buy the thing the floor wants\",\n				outcome = \"The coffee machine arrived on Thursday. You were popular for a month, and the hour it saved nobody was the price of the one it saved everyone.\",\n				effects = { happiness = 5, looks = 2 },\n				performance = 2,\n				reaction = \"approach\",\n			},\n			{\n				id = \"budget_hour\",\n				label = \"Buy the thing that saves the hour\",\n				outcome = \"You bought the boring one. Nobody thanked you, and the hour a day it saved was yours to keep, which you noticed every single afternoon.\",\n				effects = { smarts = 4, happiness = 1 },\n				performance = 4,\n				reaction = \"settle\",\n			},\n			{\n				id = \"budget_split\",\n				label = \"Split it so neither side gets enough\",\n				outcome = \"You tried to please everyone and bought two half-things. One is unplugged now and the other broke, which is what half a budget buys.\",\n				effects = { smarts = 2, happiness = -3 },\n				performance = -1,\n				reaction = \"withdraw\",\n			},\n		},\n	},\n	{\n		id = \"work_shop_thief\",\n		minAge = 16,\n		maxAge = 999,\n		delivery = \"Shift\",\n		resolution = \"Enacted\",\n		subject = \"customer\",\n		jobs = { \"shop_assistant\" },\n		repeatable = true,\n		prompt = \"A customer has two of the same thing in their coat, and you watched the second one go in.\",\n		writesBack = { \"stat:happiness\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"thief_watch\",\n				label = \"Watch them, loudly, until they put it back\",\n				outcome = \"They put it back and left. Nobody saw anything, you saw everything, and the store did not lose a single thing.\",\n				effects = { smarts = 2, happiness = 2 },\n				performance = 3,\n				reaction = \"approach\",\n			},\n			{\n				id = \"thief_say\",\n				label = \"Say something to them\",\n				outcome = \"You said it quietly, and they denied it with their hands full. It was the most uncomfortable minute of your week and it worked.\",\n				effects = { happiness = -2, smarts = 3 },\n				performance = 2,\n				reaction = \"settle\",\n			},\n			{\n				id = \"thief_stew\",\n				label = \"Watch them leave and say nothing\",\n				outcome = \"They left, and the till was eleven dollars down at the end of the night. You have replayed the coat twice since.\",\n				effects = { happiness = -3, smarts = 1 },\n				performance = -2,\n				reaction = \"withdraw\",\n			},\n		},\n	},\n	{\n		id = \"work_shop_sale\",\n		minAge = 16,\n		maxAge = 999,\n		delivery = \"Shift\",\n		resolution = \"Enacted\",\n		subject = \"customer\",\n		jobs = { \"shop_assistant\" },\n		repeatable = true,\n		prompt = \"The sale started this morning and the queue is out past the door. Someone is waving a receipt the till does not recognise.\",\n		writesBack = { \"stat:happiness\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"sale_honour\",\n				label = \"Honour it and sort it out after\",\n				outcome = \"You honoured it, which the till did not forgive and the customer did. You balanced it in the quiet hour after, and nobody ever knew.\",\n				effects = { smarts = 3, happiness = 2 },\n				performance = 3,\n				reaction = \"approach\",\n			},\n			{\n				id = \"sale_policy\",\n				label = \"Stick to the policy and refuse\",\n				outcome = \"You said the line the policy gave you, and the queue watched. You were right, and right has never felt less like a win.\",\n				effects = { smarts = 2, happiness = -2 },\n				performance = 1,\n				reaction = \"settle\",\n			},\n			{\n				id = \"sale_escalate\",\n				label = \"Wave over a manager and step away\",\n				outcome = \"The manager fixed it in ten seconds with a smile, because the manager has a pen and you have a till. You filed the smile for later.\",\n				effects = { smarts = 2, happiness = -1 },\n				performance = 0,\n				reaction = \"withdraw\",\n			},\n		},\n	},\n	{\n		id = \"work_shop_rain\",\n		minAge = 16,\n		maxAge = 999,\n		delivery = \"Shift\",\n		resolution = \"Enacted\",\n		subject = \"customer\",\n		jobs = { \"shop_assistant\" },\n		repeatable = true,\n		prompt = \"It is pouring outside and the shop is full of people who are not shopping. The last of them has been standing by the door for an hour.\",\n		writesBack = { \"stat:happiness\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"rain_talk\",\n				label = \"Talk to them and mean it\",\n				outcome = \"You talked to the one at the door, who turned out to be waiting for a bus that had not come. It came, and they waved from the window.\",\n				effects = { happiness = 4, smarts = 1 },\n				performance = 2,\n				reaction = \"approach\",\n			},\n			{\n				id = \"rain_tidy\",\n				label = \"Tidy the shelf beside them\",\n				outcome = \"You tidied the same shelf twice and did not say a word, and by the end you were both pretending not to notice each other.\",\n				effects = { smarts = 1, happiness = -1 },\n				performance = 1,\n				reaction = \"settle\",\n			},\n			{\n				id = \"rain_ask\",\n				label = \"Ask them to buy something or leave\",\n				outcome = \"You said it because someone had to. They left, wet, and the shop felt bigger and colder for the rest of the afternoon.\",\n				effects = { happiness = -3, smarts = 1 },\n				performance = -1,\n				reaction = \"withdraw\",\n			},\n		},\n	},\n	{\n		id = \"work_shop_lost_toy\",\n		minAge = 16,\n		maxAge = 999,\n		delivery = \"Shift\",\n		resolution = \"Enacted\",\n		subject = \"customer\",\n		jobs = { \"shop_assistant\" },\n		repeatable = true,\n		prompt = \"A child has lost their toy somewhere in the shop and is working their way along the aisles asking strangers.\",\n		writesBack = { \"stat:happiness\", \"stat:looks\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"lost_join\",\n				label = \"Help them look\",\n				outcome = \"You found it under the fixtures in ten minutes, and the child hugged you, a thing that has not happened to you since you were about their age.\",\n				effects = { happiness = 5, looks = 2 },\n				performance = 2,\n				reaction = \"approach\",\n			},\n			{\n				id = \"lost_watch\",\n				label = \"Keep an eye out as you work\",\n				outcome = \"You kept an eye out and did not find it. They found it themselves on the way out, which was the second-best ending.\",\n				effects = { smarts = 1, happiness = 1 },\n				performance = 1,\n				reaction = \"settle\",\n			},\n			{\n				id = \"lost_ignore\",\n				label = \"Let someone else deal with it\",\n				outcome = \"You stayed at your post and watched the child's face fall and rise again. It fell and rose without you, and you noticed how much that bothered you.\",\n				effects = { happiness = -2, smarts = 1 },\n				performance = -1,\n				reaction = \"withdraw\",\n			},\n		},\n	},\n	{\n		id = \"work_break_room\",\n		minAge = 16,\n		maxAge = 999,\n		delivery = \"Shift\",\n		resolution = \"Enacted\",\n		subject = \"coworker\",\n		repeatable = true,\n		prompt = \"Someone's lunch has gone from the fridge and the whole break room is weighing the evidence, most of it about a person who is not here.\",\n		writesBack = { \"stat:happiness\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"fridge_owner\",\n				label = \"Ask the person directly\",\n				outcome = \"You asked the person, quietly, and it was a misunderstanding from the day before. The break room moved on an hour later, empty-handed.\",\n				effects = { smarts = 3, happiness = 1 },\n				performance = 1,\n				reaction = \"approach\",\n			},\n			{\n				id = \"fridge_leave\",\n				label = \"Stay out of it\",\n				outcome = \"You stayed out of it, which was easy, and the rumour survived until Friday, which was less easy to listen to.\",\n				effects = { happiness = -2, smarts = 1 },\n				performance = 0,\n				reaction = \"settle\",\n			},\n			{\n				id = \"fridge_add\",\n				label = \"Add to the suspicion\",\n				outcome = \"You said 'could have been anyone', which somehow named the person everyone was already thinking of. It did not die by Friday either.\",\n				effects = { smarts = 1, happiness = -3 },\n				performance = -2,\n				reaction = \"withdraw\",\n			},\n		},\n	},\n	{\n		id = \"work_two_bosses\",\n		minAge = 16,\n		maxAge = 999,\n		delivery = \"Shift\",\n		resolution = \"Enacted\",\n		subject = \"manager\",\n		repeatable = true,\n		prompt = \"One manager asked you to close the back room. Another asked you to watch the floor. Both asked in the same minute.\",\n		writesBack = { \"stat:happiness\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"bosses_ask\",\n				label = \"Go and ask which one first\",\n				outcome = \"You asked, and the second one shrugged and said the back room could wait. Nobody minds being asked; they mind being surprised.\",\n				effects = { smarts = 4, happiness = 1 },\n				performance = 3,\n				reaction = \"approach\",\n			},\n			{\n				id = \"bosses_judge\",\n				label = \"Pick the one that matters more\",\n				outcome = \"You picked the floor, which was the right call, and the back room waited exactly as long as you thought it would. You learned whose word actually weighed more.\",\n				effects = { smarts = 3, happiness = 1 },\n				performance = 2,\n				reaction = \"settle\",\n			},\n			{\n				id = \"bosses_split\",\n				label = \"Do a bit of both and neither properly\",\n				outcome = \"You tried to do both and did the floor badly and the back room badly. Both managers found out about the other one, and about you, in the same afternoon.\",\n				effects = { happiness = -3, smarts = 1 },\n				performance = -2,\n				reaction = \"withdraw\",\n			},\n		},\n	},\n	{\n		id = \"work_extra_responsibility\",\n		minAge = 16,\n		maxAge = 999,\n		delivery = \"Shift\",\n		resolution = \"Enacted\",\n		subject = \"manager\",\n		minStanding = 6,\n		repeatable = true,\n		prompt = \"The manager has picked you, specifically, because you are the one who can be trusted with it: the awkward job that officially belongs to no one.\",\n		writesBack = { \"stat:happiness\", \"stat:health\", \"stat:smarts\" },\n		choices = {\n			{\n				id = \"extra_take\",\n				label = \"Take it on properly\",\n				outcome = \"You took it on and did it better than anyone expected, which is how the awkward job became yours permanently, which is what you had signed up for.\",\n				effects = { smarts = 3, happiness = 2, health = -1 },\n				performance = 4,\n				reaction = \"approach\",\n			},\n			{\n				id = \"extra_terms\",\n				label = \"Take it with terms\",\n				outcome = \"You took it and named what you needed to do it well. They met you halfway, and you found that asking for the thing changed how the thing went.\",\n				effects = { smarts = 4, happiness = 1 },\n				performance = 3,\n				reaction = \"settle\",\n			},\n			{\n				id = \"extra_decline\",\n				label = \"Say it's not in your job description\",\n				outcome = \"It was not, and you were right. Someone else took it and did it worse, and the manager remembered which of you said no when it mattered.\",\n				effects = { happiness = 2, smarts = 2 },\n				performance = -1,\n				reaction = \"withdraw\",\n			},\n		},\n	},\n}\n\nreturn Work\n"
