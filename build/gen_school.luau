AGES_SOURCES["src/server/content/Public.luau"] = "--!strict\n-- Everybody else. The people who are in a room because rooms have people in them.\n--\n-- Separate from Cast for a reason Cast itself states in its first paragraph: those\n-- four recur, and the neighbor who knocks when you are nine has to be the neighbor\n-- who knocks when you are forty or none of it means anything. Serving Mom at a till\n-- eleven times in a four-minute shift would spend that on nothing.\n--\n-- So these are strangers, and being strangers is their entire job. Nothing may ever\n-- reference one of them by id, no event may cast one, and no relationship should ever\n-- be recorded against one -- the moment any of that is wanted, the person wanted is a\n-- cast member and belongs in the other file. The ids exist only so a debug line can\n-- say which body it built.\n--\n-- Same CastMember shape, so they cost nothing extra: NPCService builds one exactly\n-- the way it builds a parent, head tracking and all.\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal Types = require(ReplicatedStorage:WaitForChild(\"Types\"))\n\ntype CastMember = Types.CastMember\n\n-- Eight, which is enough that a whole shift rarely repeats a face and few enough to\n-- read them as regulars rather than as a crowd. Spread across height, build and skin\n-- tone on purpose: a queue of people who are all the same size is the thing that\n-- makes a generated crowd look generated.\nlocal Public: { CastMember } = {\n	{\n		id = \"public_1\",\n		gender = \"male\",\n		name = \"Customer\",\n		skinColor = Color3.fromRGB(238, 200, 172),\n		heightScale = 1.04,\n		widthScale = 1,\n		headScale = 1,\n		proportionScale = 1,\n		bodyTypeScale = 0.7,\n		shirtAssetId = 0,\n		pantsAssetId = 0,\n		hairAssetId = 0,\n	},\n	{\n		id = \"public_2\",\n		gender = \"female\",\n		name = \"Customer\",\n		skinColor = Color3.fromRGB(150, 108, 78),\n		heightScale = 0.94,\n		widthScale = 0.9,\n		headScale = 1.02,\n		proportionScale = 1,\n		bodyTypeScale = 0.85,\n		shirtAssetId = 0,\n		pantsAssetId = 0,\n		hairAssetId = 0,\n	},\n	{\n		id = \"public_3\",\n		gender = \"male\",\n		name = \"Customer\",\n		skinColor = Color3.fromRGB(206, 160, 126),\n		heightScale = 1.1,\n		widthScale = 1.12,\n		headScale = 0.98,\n		proportionScale = 1,\n		bodyTypeScale = 0.6,\n		shirtAssetId = 0,\n		pantsAssetId = 0,\n		hairAssetId = 0,\n	},\n	{\n		id = \"public_4\",\n		gender = \"female\",\n		name = \"Customer\",\n		skinColor = Color3.fromRGB(120, 84, 60),\n		heightScale = 0.99,\n		widthScale = 0.96,\n		headScale = 1,\n		proportionScale = 1,\n		bodyTypeScale = 0.9,\n		shirtAssetId = 0,\n		pantsAssetId = 0,\n		hairAssetId = 0,\n	},\n	{\n		id = \"public_5\",\n		gender = \"male\",\n		name = \"Customer\",\n		skinColor = Color3.fromRGB(246, 214, 190),\n		heightScale = 0.9,\n		widthScale = 0.88,\n		headScale = 1.04,\n		proportionScale = 1,\n		bodyTypeScale = 0.75,\n		shirtAssetId = 0,\n		pantsAssetId = 0,\n		hairAssetId = 0,\n	},\n	{\n		id = \"public_6\",\n		gender = \"female\",\n		name = \"Customer\",\n		skinColor = Color3.fromRGB(178, 132, 100),\n		heightScale = 1.07,\n		widthScale = 1.04,\n		headScale = 1,\n		proportionScale = 1,\n		bodyTypeScale = 0.65,\n		shirtAssetId = 0,\n		pantsAssetId = 0,\n		hairAssetId = 0,\n	},\n	{\n		id = \"public_7\",\n		gender = \"male\",\n		name = \"Customer\",\n		skinColor = Color3.fromRGB(96, 66, 48),\n		heightScale = 1.01,\n		widthScale = 1.08,\n		headScale = 0.99,\n		proportionScale = 1,\n		bodyTypeScale = 0.8,\n		shirtAssetId = 0,\n		pantsAssetId = 0,\n		hairAssetId = 0,\n	},\n	{\n		id = \"public_8\",\n		gender = \"female\",\n		name = \"Customer\",\n		skinColor = Color3.fromRGB(222, 178, 142),\n		heightScale = 0.96,\n		widthScale = 0.94,\n		headScale = 1.01,\n		proportionScale = 1,\n		bodyTypeScale = 0.72,\n		shirtAssetId = 0,\n		pantsAssetId = 0,\n		hairAssetId = 0,\n	},\n	{\n		id = \"dealer_1\",\n		gender = \"male\",\n		name = \"Salesperson\",\n		skinColor = Color3.fromRGB(210, 170, 130),\n		heightScale = 1.05,\n		widthScale = 1.0,\n		headScale = 0.98,\n		proportionScale = 1,\n		bodyTypeScale = 0.7,\n		shirtAssetId = 0,\n		pantsAssetId = 0,\n		hairAssetId = 0,\n	},\n	{\n		id = \"dealer_2\",\n		gender = \"female\",\n		name = \"Salesperson\",\n		skinColor = Color3.fromRGB(160, 110, 80),\n		heightScale = 0.97,\n		widthScale = 0.95,\n		headScale = 1.0,\n		proportionScale = 1,\n		bodyTypeScale = 0.8,\n		shirtAssetId = 0,\n		pantsAssetId = 0,\n		hairAssetId = 0,\n	},\n	{\n		id = \"dealer_3\",\n		gender = \"male\",\n		name = \"Salesperson\",\n		skinColor = Color3.fromRGB(90, 60, 40),\n		heightScale = 1.12,\n		widthScale = 1.1,\n		headScale = 0.96,\n		proportionScale = 1,\n		bodyTypeScale = 0.6,\n		shirtAssetId = 0,\n		pantsAssetId = 0,\n		hairAssetId = 0,\n	},\n	{\n		id = \"dealer_4\",\n		gender = \"female\",\n		name = \"Salesperson\",\n		skinColor = Color3.fromRGB(240, 200, 160),\n		heightScale = 0.92,\n		widthScale = 0.9,\n		headScale = 1.03,\n		proportionScale = 1,\n		bodyTypeScale = 0.85,\n		shirtAssetId = 0,\n		pantsAssetId = 0,\n		hairAssetId = 0,\n	},\n}\n\nlocal seen: { [string]: true } = {}\nfor _, member in Public do\n	if seen[member.id] then\n		error(`[AGES content] duplicate public id \"{member.id}\"`)\n	end\n	seen[member.id] = true\nend\n\nif #Public == 0 then\n	error(\"[AGES content] the public is empty, so no task could ever have anybody waiting on it\")\nend\n\nreturn {\n	All = Public,\n	-- Whoever turns up next. Random rather than in rotation: a shop where the same\n	-- eight people arrive in the same order is a shop with eight people in it.\n	Someone = function(): CastMember\n		return Public[math.random(#Public)]\n	end,\n}\n"
