AGES_SOURCES["src/server/content/Students.luau"] = "--!strict\n-- Who the other students are.\n--\n-- The crowd worked and was anonymous: fourteen rigs walking a building, every one of them\n-- nobody. That is a subtly worse failure than an empty school, because an empty room reads as\n-- unfinished while a room full of blanks reads as *finished and hollow* -- the reference\n-- photographs are wall-to-wall named students with a clique under the name, and that labelling\n-- is most of why those corridors feel inhabited.\n--\n-- **A clique is a place, not a costume.** This is the whole reason the file is worth having.\n-- A label floating over a rig is decoration and would deserve about six lines; what makes it\n-- a system is that a clique says *where its people stand*. Athletes are by the gym, the art\n-- club is in the art room, the band is outside music, bookworms are in the library. So the\n-- building sorts itself the way a real school does, and a player who learns the map learns\n-- where to find somebody -- which is knowledge, and knowledge is the thing a crowd of\n-- interchangeable rigs can never have.\n--\n-- That also means the school's own rooms are doing double duty. The art room was built for\n-- the art lesson; it now also explains why those four students are standing over there.\n--\n-- Names are deliberately plain and short. These are read at a glance off a billboard from\n-- across a corridor, and a cast of unusual names reads as a fantasy game rather than as a\n-- school.\n\nlocal Students = {}\n\nexport type Clique = {\n	id: string,\n	-- Shown under the name, in the reference's own register: a one-word social position.\n	label: string,\n	-- The rooms this clique is found in, most likely first. Room ids as School.Plan names\n	-- them; a clique naming a room the build does not have simply never places there, which\n	-- is why every list has \"corridor\" in it as a fallback everybody shares.\n	rooms: { string },\n	-- One line under the label. Written as the student would put it, not as a stat block --\n	-- the reference's bios are self-descriptions and that is what makes them read as people.\n	bios: { string },\n}\n\n-- The name pool. One list rather than one per clique: a school is not sorted by name, and\n-- tying names to cliques would make the clique guessable from the name, which is exactly the\n-- kind of tidy-but-false pattern that makes a generated cast feel generated.\nStudents.Names = {\n	\"Alex\", \"Sam\", \"Riley\", \"Jordan\", \"Casey\", \"Morgan\", \"Taylor\", \"Jamie\",\n	\"Avery\", \"Quinn\", \"Reese\", \"Rowan\", \"Skyler\", \"Emerson\", \"Finley\", \"Harper\",\n	\"Kai\", \"Noor\", \"Zara\", \"Omar\", \"Mila\", \"Theo\", \"Ines\", \"Rafi\",\n	\"Nina\", \"Dev\", \"Lena\", \"Cruz\", \"Iris\", \"Milo\", \"Sana\", \"Beau\",\n}\n\n-- The cliques, and where each one lives.\n--\n-- Weighted by how many entries a clique has in the spawn table rather than by a number field:\n-- a plain list is easier to read and to change, and the weighting is visible in the shape of\n-- the file rather than hidden in an integer.\nStudents.Cliques = {\n	{\n		id = \"student\",\n		label = \"Student\",\n		rooms = { \"corridor\", \"cafeteria\", \"lounge\" },\n		bios = {\n			\"just trying to get through the week\",\n			\"here for the food, honestly\",\n			\"knows every shortcut in this building\",\n			\"has a locker that will not shut\",\n		},\n	},\n	{\n		id = \"athlete\",\n		label = \"Athlete\",\n		rooms = { \"corridor\", \"cafeteria\", \"lounge\" },\n		bios = {\n			\"training before school and after it\",\n			\"captain, and will mention it\",\n			\"eats four lunches a day\",\n			\"knees are held together by tape\",\n		},\n	},\n	{\n		id = \"art\",\n		label = \"Art Club\",\n		rooms = { \"art\", \"art\", \"corridor\", \"lounge\" },\n		bios = {\n			\"quiet, kind, likes to draw\",\n			\"paint on both sleeves, permanently\",\n			\"sketching whoever is standing still\",\n			\"has opinions about the good pencils\",\n		},\n	},\n	{\n		id = \"band\",\n		label = \"Band\",\n		rooms = { \"music\", \"music\", \"corridor\" },\n		bios = {\n			\"third chair and climbing\",\n			\"humming something you almost know\",\n			\"carries the case everywhere\",\n			\"practises in the stairwell\",\n		},\n	},\n	{\n		id = \"bookworm\",\n		label = \"Bookworm\",\n		rooms = { \"library\", \"library\", \"reading\", \"corridor\" },\n		bios = {\n			\"two chapters from the end\",\n			\"knows where everything is shelved\",\n			\"reads while walking, badly\",\n			\"has never returned a book late\",\n		},\n	},\n	{\n		id = \"science\",\n		label = \"Science Club\",\n		rooms = { \"science\", \"computers\", \"corridor\" },\n		bios = {\n			\"the experiment is going fine, probably\",\n			\"safety goggles, always\",\n			\"asks the question everyone was thinking\",\n			\"lab coat is a lifestyle\",\n		},\n	},\n	{\n		id = \"cook\",\n		label = \"Home Ec\",\n		rooms = { \"cooking\", \"cafeteria\", \"corridor\" },\n		bios = {\n			\"brought enough to share\",\n			\"the cake was structurally ambitious\",\n			\"tastes everything twice\",\n			\"flour on the blazer\",\n		},\n	},\n	{\n		id = \"freshman\",\n		label = \"Freshman\",\n		rooms = { \"corridor\", \"corridor\", \"cafeteria\", \"lounge\" },\n		bios = {\n			\"still holding the map\",\n			\"new here, and it shows\",\n			\"asked where room 12 was, twice\",\n			\"early to everything\",\n		},\n	},\n}\n\n-- One student's identity: a name, a clique, and a line.\n--\n-- Rolled rather than drawn from a pool without replacement. Two students sharing a name in a\n-- school of eight hundred is true to life, and the alternative -- tracking which of thirty-two\n-- names are in use across a crowd that is constantly being torn down and rebuilt as the player\n-- walks in and out of range -- is bookkeeping that would buy nothing a player could notice.\nfunction Students.Roll(): { name: string, clique: Clique, bio: string }\n	local clique = Students.Cliques[math.random(1, #Students.Cliques)]\n	return {\n		name = Students.Names[math.random(1, #Students.Names)],\n		clique = clique,\n		bio = clique.bios[math.random(1, #clique.bios)],\n	}\nend\n\nreturn Students\n"
table.insert(AGES_MANIFEST, "src/server/content/Students.luau")
AGES_SOURCES["src/server/content/Studies.luau"] = "--!strict\n-- The things an Art lesson asks you to copy.\n--\n-- A study is a small picture pinned to the wall, written here as rows of letters so that\n-- it can be *seen* in the source. Each letter is a pigment -- see shared/world/Pigments\n-- for the shelf -- and each row is a row of the canvas, top to bottom.\n--\n-- Alongside every picture is a second grid the same size saying which parts of it are\n-- allowed to move. That is the mechanic and not a decoration: a study that sat still\n-- would be a colouring book, and the reason there is anything to think about here is\n-- that the light shifts and somebody moves the fruit while you are painting. `.` is\n-- nailed down and `*` may change. Every study needs at least one `*`, checked below,\n-- because a study with none has no second queue in it -- and the whole difference\n-- between this and a form to fill in is having two things to spend the next ten seconds\n-- on.\n--\n-- Deliberately not banded by age, unlike Procedures. The difficulty in this subject does\n-- not live in the picture, it lives in how many tubes of paint you have been handed --\n-- see School.Art.PaletteByLevel -- so a six-year-old and a fourteen-year-old copying the\n-- same harbour are having genuinely different afternoons, and splitting the pictures by\n-- age on top of that would be pricing the same thing twice.\n--\n-- Nothing here scores anything or knows what a lesson is. This is the wall.\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Config = require(ReplicatedStorage:WaitForChild(\"Config\"))\nlocal Pigments = require(ReplicatedStorage:WaitForChild(\"world\"):WaitForChild(\"Pigments\"))\n\nlocal Studies = {}\n\nlocal ART = Config.School.Art\n\n-- One picture on the wall, as authored.\nexport type StudySource = {\n	id: string,\n	-- Said out loud when the lesson starts, and written under the wall. A title rather\n	-- than a description, because being told \"harbour, morning\" and then having to work\n	-- out which blue is the water is the closest this subject gets to a question.\n	name: string,\n	-- Top row first. One letter per cell, and every row must be Columns long.\n	grid: { string },\n	-- The same shape again: `.` fixed, `*` free to change while you paint.\n	moves: { string },\n}\n\n-- One picture, parsed and ready to hand to a lesson.\nexport type Study = {\n	id: string,\n	name: string,\n	-- Cell index 1..Columns*Rows, reading left to right then top to bottom -- the order\n	-- the canvas draws in, so a cell index means the same thing on the wall, in the\n	-- session and on screen without anything mapping between them.\n	cells: { Pigments.Pigment },\n	-- The indices that may shift, precomputed because the shift timer asks for one at\n	-- random several times a lesson and walking the mask each time would be re-reading a\n	-- constant.\n	movable: { number },\n	-- Every pigment this picture is made of, most-used first. This is what a palette is\n	-- cut from: rung one hands over the first two, and the rungs above it hand over the\n	-- rest -- so what levelling up buys is literally the colours the picture barely needs,\n	-- which are the ones that make it look like the thing it is of.\n	byUse: { Pigments.Pigment },\n}\n\nlocal COLUMNS = ART.Columns\nlocal ROWS = ART.Rows\nlocal CELLS = COLUMNS * ROWS\n\nlocal SOURCE: { StudySource } = {\n	-- Two thirds water and sky, and then four cells that are the entire picture: a sail,\n	-- a hull and a buoy. The most pigments of any study here on purpose -- it is the one\n	-- that still has something left to give at the top of the ladder.\n	{\n		id = \"harbour\",\n		name = \"Harbour, morning\",\n		grid = {\n			\"sssl\",\n			\"swdl\",\n			\"dkkr\",\n			\"dddm\",\n		},\n		moves = {\n			\"....\",\n			\".*..\",\n			\"..**\",\n			\"....\",\n		},\n	},\n\n	-- The classroom still life, and the one where the shifting is somebody's hand rather\n	-- than the weather: the fruit gets nudged around the board while you are looking down.\n	{\n		id = \"fruit\",\n		name = \"Three fruit on a board\",\n		grid = {\n			\"wwlw\",\n			\"orwm\",\n			\"kork\",\n			\"kkkk\",\n		},\n		moves = {\n			\"....\",\n			\"**.*\",\n			\".**.\",\n			\"....\",\n		},\n	},\n\n	-- A window with the room dark around it. Only the light moves, which makes this the\n	-- study where the volatile cells are all in one place -- so the right technique is to\n	-- paint the frame first and leave the glass until last, and finding that out is the\n	-- point.\n	{\n		id = \"window\",\n		name = \"The window, afternoon\",\n		grid = {\n			\"kssk\",\n			\"kook\",\n			\"lwwl\",\n			\"kklk\",\n		},\n		moves = {\n			\".**.\",\n			\".**.\",\n			\"....\",\n			\"....\",\n		},\n	},\n\n	-- The opposite arrangement: the whole top row is sky and the whole top row moves, so\n	-- there is no safe corner to hide in and the only question is whether you repaint a\n	-- cloud or go and finish the road.\n	{\n		id = \"hill\",\n		name = \"Hill road\",\n		grid = {\n			\"ssss\",\n			\"mmls\",\n			\"mllm\",\n			\"oomk\",\n		},\n		moves = {\n			\"****\",\n			\"....\",\n			\"....\",\n			\"....\",\n		},\n	},\n\n	-- Nearly monochrome, which makes it the hardest one to paint badly and the easiest\n	-- one to paint dully: at two tubes it is genuinely almost right, and every rung after\n	-- that is spent on four cells of highlight.\n	{\n		id = \"kettle\",\n		name = \"Kettle on the sill\",\n		grid = {\n			\"lllo\",\n			\"lwwl\",\n			\"lwkr\",\n			\"kkkk\",\n		},\n		moves = {\n			\"....\",\n			\".**.\",\n			\".**.\",\n			\"....\",\n		},\n	},\n}\n\n-- Parsed once at require time, and every failure names the study, the row and what to do\n-- about it. A study is sixteen characters of hand-typed picture; the odds of one of them\n-- being a typo over the life of this file are close to one, and the symptom of an\n-- unchecked typo is a wall with a colour on it nobody chose.\nlocal ALL: { Study } = {}\nlocal byId: { [string]: Study } = {}\n\n-- Reads one letter grid into a flat list, or errors saying exactly where it went wrong.\n-- Shared by the picture and the movement mask because both are the same shape, and the\n-- day they stopped being the same shape is the day a mask would start marking the wrong\n-- cell as volatile without anything noticing.\nlocal function eachCell(study: StudySource, rows: { string }, label: string, visit: (number, string) -> ())\n	if #rows ~= ROWS then\n		error(\n			`[AGES content] study \"{study.id}\" has {#rows} {label} rows but School.Art.Rows is {ROWS}.`\n				.. ` A canvas and the wall it is copied from have to be the same shape.`\n		)\n	end\n	for row, text in rows do\n		if #text ~= COLUMNS then\n			error(\n				`[AGES content] study \"{study.id}\" {label} row {row} is \"{text}\", which is {#text} characters`\n					.. ` against School.Art.Columns of {COLUMNS}. Every row must be exactly that long.`\n			)\n		end\n		for column = 1, COLUMNS do\n			visit((row - 1) * COLUMNS + column, string.sub(text, column, column))\n		end\n	end\nend\n\nfor _, source in SOURCE do\n	if byId[source.id] ~= nil then\n		error(`[AGES content] duplicate study id \"{source.id}\"`)\n	end\n\n	local cells: { Pigments.Pigment } = {}\n	local counts: { [string]: number } = {}\n	eachCell(source, source.grid, \"grid\", function(index, letter)\n		local pigment = Pigments.FromLetter(letter)\n		if pigment == nil then\n			error(\n				`[AGES content] study \"{source.id}\" uses the letter \"{letter}\", which no pigment claims.`\n					.. ` Either fix the typo or add the paint in shared/world/Pigments -- a wall cannot be`\n					.. ` built out of a colour the game does not stock.`\n			)\n		end\n		cells[index] = pigment\n		counts[pigment.id] = (counts[pigment.id] or 0) + 1\n	end)\n\n	local movable: { number } = {}\n	eachCell(source, source.moves, \"moves\", function(index, mark)\n		if mark == \"*\" then\n			table.insert(movable, index)\n		elseif mark ~= \".\" then\n			error(\n				`[AGES content] study \"{source.id}\" has \"{mark}\" in its movement mask, which means nothing.`\n					.. ` Use \".\" for a cell that stays put and \"*\" for one that may change.`\n			)\n		end\n	end)\n\n	if #movable == 0 then\n		error(\n			`[AGES content] study \"{source.id}\" has no \"*\" in its movement mask, so nothing in it ever`\n				.. ` changes. That is a colouring book rather than a study -- mark at least one cell.`\n		)\n	end\n\n	-- Most-used first, and ties broken by the shelf order rather than by whatever order\n	-- the hash table happened to be walked in. Without that tiebreak a study would hand\n	-- out a different two-tube palette between server restarts, and a player who learned\n	-- that the harbour gives you blue and sky would be right two runs in three.\n	local byUse: { Pigments.Pigment } = {}\n	for _, pigment in Pigments.All do\n		if counts[pigment.id] ~= nil then\n			table.insert(byUse, pigment)\n		end\n	end\n	table.sort(byUse, function(a: Pigments.Pigment, b: Pigments.Pigment): boolean\n		local left = counts[a.id] or 0\n		local right = counts[b.id] or 0\n		if left ~= right then\n			return left > right\n		end\n		return a.id < b.id\n	end)\n\n	if #byUse < 2 then\n		error(\n			`[AGES content] study \"{source.id}\" is painted in only one colour, so a cell that is allowed to`\n				.. ` move has nothing to move to. Every study needs at least two pigments in it.`\n		)\n	end\n\n	local study: Study = {\n		id = source.id,\n		name = source.name,\n		cells = cells,\n		movable = movable,\n		byUse = byUse,\n	}\n	ALL[#ALL + 1] = study\n	byId[source.id] = study\nend\n\nif #ALL == 0 then\n	-- Reachable only by emptying SOURCE, and worth saying out loud rather than letting\n	-- Art refuse at the door with \"nothing is up today\" every lesson forever.\n	error(\"[AGES content] there are no studies, so Art has nothing to copy. Add one in content/Studies.\")\nend\n\n-- How many cells a canvas has. Read off the same two Config numbers everything else here\n-- is built from, and exported so the service and the room do not each recompute it and\n-- then disagree about it by one.\nStudies.CellCount = CELLS\n\nStudies.All = ALL\n\n-- Nil for an id nothing authors any more, the same contract Curriculum.Get offers and for\n-- the same reason: an id can outlive its content, and the caller that held it is the one\n-- that knows what to say about it.\nfunction Studies.Get(id: string): Study?\n	return byId[id]\nend\n\nreturn Studies\n"
table.insert(AGES_MANIFEST, "src/server/content/Studies.luau")
AGES_SOURCES["src/server/content/Subjects.luau"] = "--!strict\n-- The things events are about, when the thing is something you can look at.\n-- Content data, not system code: the numbers here are authored descriptions of\n-- animals, the way Cast.luau holds authored descriptions of people, and adding\n-- one needs no code.\n--\n-- Sizes are chosen against the childhood body ladder rather than against an\n-- adult, because that is who meets them. At Config.Childhood.Bands a two-year-old\n-- stands roughly 2.3 studs and a five-year-old roughly 3.4, so a dog with a 2.6\n-- stud back really is \"at least as tall as you are\" for most of the ages\n-- childhood_big_dog can fire at -- which is the sentence the prompt already makes\n-- and, until now, could not keep.\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal Types = require(ReplicatedStorage:WaitForChild(\"Types\"))\n\ntype SceneSubject = Types.SceneSubject\n\nlocal list: { SceneSubject } = {\n	{\n		id = \"dog\",\n		name = \"big dog\",\n		-- Deliberately at the top of the range the prompt claims. A dog that has\n		-- to be looked *up* at is a different event from one you look down at, and\n		-- the choices -- put your hand out, stand still, get behind an adult --\n		-- only make sense at the first size.\n		shoulderHeight = 2.6,\n		bodyLength = 3.2,\n		bodyWidth = 1.3,\n		-- Faster than a visitor's 9. Someone at your door is being polite; a dog\n		-- that has noticed you is not.\n		walkSpeed = 11,\n		color = Color3.fromRGB(122, 92, 62),\n		accentColor = Color3.fromRGB(64, 48, 34),\n	},\n	{\n		id = \"cat\",\n		-- Nothing casts this yet. It is here because one entry is not a content\n		-- module, it is a special case wearing one: a second subject at a\n		-- genuinely different size is what proves the builder reads these numbers\n		-- rather than having a dog baked into it.\n		name = \"cat\",\n		shoulderHeight = 1.0,\n		bodyLength = 1.6,\n		bodyWidth = 0.6,\n		walkSpeed = 7,\n		color = Color3.fromRGB(70, 70, 74),\n		accentColor = Color3.fromRGB(236, 232, 224),\n	},\n	{\n		id = \"teacher\",\n		name = \"teacher\",\n		-- Adult proportions against the childhood body ladder: at school age the\n		-- player stands 3.6-4.8 studs tall, so a shoulderHeight of 4.5 plus a\n		-- head puts the teacher clearly above them. Sized for the placeholder's\n		-- biped path; a real R15 model dropped in overrides the dimensions.\n		shoulderHeight = 4.5,\n		bodyLength = 1.1,\n		bodyWidth = 1.05,\n		walkSpeed = 9,\n		color = Color3.fromRGB(110, 98, 150),\n		accentColor = Color3.fromRGB(60, 58, 68),\n		biped = true,\n	},\n	-- The three people who can be in the room during a shift. Work moments are\n	-- Enacted events, and until these existed the shift was the one place a subject\n	-- could never stand: a rude customer has to be somebody you walk to. Same\n	-- proportions as the teacher because the player is grown by then; the colors are\n	-- the whole way the player tells who is who at a glance, so they are chosen to\n	-- read as three different people rather than three shades of the same one.\n	{\n		id = \"customer\",\n		name = \"customer\",\n		shoulderHeight = 4.5,\n		bodyLength = 1.1,\n		bodyWidth = 1.05,\n		walkSpeed = 9,\n		color = Color3.fromRGB(92, 128, 134),\n		accentColor = Color3.fromRGB(224, 216, 196),\n		biped = true,\n	},\n	{\n		id = \"coworker\",\n		name = \"coworker\",\n		shoulderHeight = 4.5,\n		bodyLength = 1.1,\n		bodyWidth = 1.05,\n		walkSpeed = 9,\n		color = Color3.fromRGB(112, 126, 92),\n		accentColor = Color3.fromRGB(222, 210, 186),\n		biped = true,\n	},\n	{\n		id = \"manager\",\n		name = \"manager\",\n		-- A touch taller than the other two, which is the one proportional liberty\n		-- the placeholder allows itself: a manager asked to carry an event about\n		-- whether you can say no reads as the person with the power of review, and\n		-- a bare half-stud of height is the cheapest version of that on offer.\n		shoulderHeight = 4.7,\n		bodyLength = 1.1,\n		bodyWidth = 1.05,\n		walkSpeed = 9,\n		color = Color3.fromRGB(74, 84, 122),\n		accentColor = Color3.fromRGB(170, 82, 78),\n		biped = true,\n	},\n}\n\nlocal byId: { [string]: SceneSubject } = {}\nfor _, subject in list do\n	if byId[subject.id] ~= nil then\n		error(`[AGES content] duplicate subject id \"{subject.id}\"`)\n	end\n	byId[subject.id] = subject\nend\n\nreturn {\n	All = list,\n	ById = byId,\n}\n"
table.insert(AGES_MANIFEST, "src/server/content/Subjects.luau")
AGES_SOURCES["src/server/content/Ties.luau"] = "--!strict\n-- What somebody can be to you.\n--\n-- A bond is a number that says how a person feels about you. A tie is a word that says\n-- what the two of you are. They are not the same thing and the difference is the reason\n-- this file exists: a bond rises because you turned up and falls because you did not,\n-- with nobody deciding anything, whereas a tie is only ever conferred by an offer the\n-- player picked off a panel while standing in front of the person it is about.\n--\n-- Put the other way round: if friendship were a bond threshold, then everybody you were\n-- reliably nice to would become your friend on some birthday you were not paying\n-- attention on, and the game would be telling you about your own life after the fact.\n-- Making it an offer means there is a moment. The bond is what unlocks the moment; the\n-- moment is what makes it true.\n--\n-- **Why this is not a flag.** Flags in content/Flags.luau are facts about the *life* and\n-- every one of them is declared by hand. A tie is a fact about a *pair*, and one side of\n-- that pair is usually generated -- the town is Config.Town.Count ids that nobody typed\n-- and that change the day that number changes. So this file declares the handful of\n-- words, and the person they attach to is a key at runtime.\n--\n-- **Why the list is short.** Three rungs across a whole life, and all of them are\n-- friendship. A game with eleven grades of closeness has quietly replaced a relationship\n-- with a progress bar, which is the exact thing bonds are hidden from the player to\n-- avoid. If a fourth is ever wanted, the question to answer first is what sentence a\n-- player would say about it that they could not already say about one of these -- and,\n-- for AGES specifically, whether a 13+ life can hold it, which is why there is no partner.\n--\n-- Phase 5 adds three structural slots that replace romance: mentor, rival, sibling.\n-- Each is capped at one and sits above the friendship ladder. They are parallel tracks --\n-- you can have one of each -- because a life holds multiple kinds of significance.\n--\n-- Phase 6 adds the enemy tie. It sits below the ladder entirely (rank 0) because it is\n-- not a rung you climb to -- it is the relationship that exists when the ladder has been\n-- burned. Capped at one because a life only has room for one person who means this much\n-- in this direction. Nothing anywhere names it: `Ties.IsRung` splits the ladder from what\n-- is not on it, and every gate in the game asks that question rather than the id.\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal Types = require(ReplicatedStorage:WaitForChild(\"Types\"))\n\ntype TieDef = Types.TieDef\n\n-- Same shape as flag ids and checked the same way, because they are written by hand in\n-- the same content files and compared as strings in the same places.\nlocal ID_PATTERN = \"^[a-z][a-z0-9_]*$\"\n\nlocal SOURCE: { TieDef } = {\n	-- Somebody you know by name and who knows you. The cheapest rung, and it is here\n	-- because without it there is no difference between the shopkeeper you have spoken\n	-- to forty times and the one you walked past -- and there should be, because the\n	-- player did something to make it so.\n	{\n		id = \"known\",\n		label = \"knows you\",\n		rank = 1,\n	},\n	-- An actual friend. No limit: a life with six friends in it is a good life, and\n	-- capping this would make the game an argument about who to drop.\n	{\n		id = \"friend\",\n		label = \"friend\",\n		rank = 2,\n	},\n	-- The one. Capped at one on purpose, and this cap is the whole point of the ladder:\n	-- it is the first and only thing in AGES that a player can have with just one person,\n	-- so it is the first relationship decision that costs something to make. It is the top\n	-- rung deliberately -- a life is built around a closest friend, and there is nothing\n	-- closer for the ladder to reach toward.\n	--\n	-- Note what the cap does *not* do: it never takes a tie away. The rung is simply not\n	-- offered by anybody else while it is spoken for, which is refusing to write a\n	-- friendship the player did not end rather than quietly demoting one they earned.\n	-- Ending one properly would need a surface to end it on, which does not exist yet; until\n	-- it does, the cap holds by silence rather than by taking anything back.\n	{\n		id = \"closest\",\n		label = \"closest friend\",\n		rank = 3,\n		limit = 1,\n	},\n	-- A mentor. Capped at one. Offered by an older person when the bond is deep and the\n	-- player has something to learn. The mentor tie unlocks guidance offers and marks the\n	-- person as a teacher in your life. Not a parent -- a chosen guide.\n	{\n		id = \"mentor\",\n		label = \"mentor\",\n		rank = 4,\n		limit = 1,\n	},\n	-- A rival. Capped at one. Offered by someone whose bond with you has gone negative --\n	-- a person you wronged, outshone, or crossed. The rival tie unlocks competitive offers\n	-- and marks the person as an adversary who respects you enough to chase you. Negative\n	-- ties are content: a rival is a relationship, not the absence of one.\n	{\n		id = \"rival\",\n		label = \"rival\",\n		rank = 5,\n		limit = 1,\n	},\n	-- A chosen sibling. Capped at one. Offered by a peer when the bond is at its peak and\n	-- the offer is to make it permanent -- not by blood, but by choice. The sibling tie\n	-- unlocks lifelong loyalty offers and marks the person as family you chose.\n	{\n		id = \"sibling\",\n		label = \"sibling\",\n		rank = 6,\n		limit = 1,\n	},\n	-- An enemy. Rank 0 sits below the ladder entirely. It is not a rung you climb to --\n	-- it is the relationship that exists when the ladder has been burned. Capped at one\n	-- because a life only has room for one person who means this much in this direction.\n	--\n	-- Rank 0 is what \"no tie at all\" already scores, which is the point: for every ladder\n	-- comparison in the game an enemy and a stranger are the same thing, so this tie can\n	-- neither satisfy a `needsTie` nor block a climb. What it is *not* is a rank that can\n	-- be compared -- see `Ties.IsRung`, and note that `Ties.Meets` switches to equality\n	-- rather than ordering here, which is what lets an enemy replace a closest friend\n	-- while a closest friend still cannot be re-offered friendship.\n	{\n		id = \"enemy\",\n		label = \"enemy\",\n		rank = 0,\n		limit = 1,\n	},\n}\n\nlocal byId: { [string]: TieDef } = {}\nlocal seenRank: { [number]: string } = {}\n\nfor _, def in SOURCE do\n	if not string.match(def.id, ID_PATTERN) then\n		error(`[AGES content] tie id \"{def.id}\" must be lowercase words joined by underscores`)\n	end\n	if byId[def.id] ~= nil then\n		error(`[AGES content] duplicate tie id \"{def.id}\"`)\n	end\n	if def.label == \"\" then\n		error(`[AGES content] tie \"{def.id}\" has no label, so it would show as a blank line on a nameplate`)\n	end\n	-- Rank 0 is the off-ladder rank -- see `Ties.IsRung`. Everything else is a rung and\n	-- carries a whole number from 1 up. Written as a range rather than as an exception for\n	-- the id \"enemy\", because the id was already in this file three times and a second\n	-- off-ladder tie would have had to find and edit every one of them.\n	--\n	-- Nothing here stops a rung being typo'd to 0 and quietly becoming off-ladder, but the\n	-- rank-uniqueness check immediately below does: rank 0 is spoken for, so the second one\n	-- errors by name.\n	if def.rank ~= math.floor(def.rank) or def.rank < 0 then\n		error(\n			`[AGES content] tie \"{def.id}\" has rank {def.rank}; ranks are whole numbers from 1 up, `\n				.. `or 0 for a tie that sits off the ladder entirely`\n		)\n	end\n	-- Two ties at one rank would make \"closer than\" ambiguous, and every comparison in\n	-- this file and in People.OffersFor is a rank comparison. It would not error at\n	-- runtime; it would just make one of the two impossible to require.\n	local taken = seenRank[def.rank]\n	if taken ~= nil then\n		error(`[AGES content] ties \"{taken}\" and \"{def.id}\" are both rank {def.rank}; ranks order the ladder`)\n	end\n	seenRank[def.rank] = def.id\n\n	local limit = def.limit\n	if limit ~= nil and (limit ~= math.floor(limit) or limit < 1) then\n		error(`[AGES content] tie \"{def.id}\" is limited to {limit} people; a limit is a whole number from 1 up`)\n	end\n\n	byId[def.id] = def\nend\n\nlocal Ties = {}\n\nTies.All = SOURCE\nTies.ById = byId\n\n-- How close a tie is, and zero for nobody in particular. The one comparison the rest of\n-- the game does with these, wrapped so that \"no tie\" is a number rather than a case\n-- every caller has to remember to write.\nfunction Ties.RankOf(tieId: string?): number\n	if tieId == nil then\n		return 0\n	end\n	local def = byId[tieId]\n	return if def ~= nil then def.rank else 0\nend\n\n-- Whether a tie is a rung on the ladder at all, which is the one question that decides\n-- whether \"closer than\" is a meaningful thing to ask about it.\n--\n-- **Rungs** are ordered and climbed: known -> friend -> closest, plus the three structural\n-- slots above them. Every comparison the game makes about a rung is \"is this one at least\n-- that one\".\n--\n-- **Off-ladder ties** are a different axis. \"enemy\" is the only one today. It is not a\n-- worse friend and it is not a closer one, and asking whether it sits above or below\n-- \"friend\" is a question with no answer. It carries rank 0 so that it never satisfies and\n-- never blocks a rung comparison -- the same number \"no tie at all\" carries, because for\n-- ladder purposes those two mean the same thing.\n--\n-- Anything reasoning about climbing must ask this rather than testing the id. That is not\n-- style: the content gates in Townsfolk.luau are written as rank comparisons, and every one\n-- of them silently means the wrong thing when handed a tie that is not on the ladder.\nfunction Ties.IsRung(tieId: string?): boolean\n	if tieId == nil then\n		return false\n	end\n	local def = byId[tieId]\n	return def ~= nil and def.rank >= 1\nend\n\n-- Whether `held` is that tie or a closer one. What needsTie means, and what stops an\n-- offer written for a friend from disappearing the moment somebody becomes more than one.\nfunction Ties.Meets(held: string?, needed: string?): boolean\n	if needed == nil then\n		return true\n	end\n	-- Off the ladder, you meet a tie only by being it -- there is nothing closer to enemy\n	-- than enemy. Without this, a repair row gated on needsTie = \"enemy\" would appear for a\n	-- friend, because RankOf(friend) >= RankOf(enemy) is trivially true at rank 0.\n	if not Ties.IsRung(needed) then\n		return held == needed\n	end\n	return Ties.RankOf(held) >= Ties.RankOf(needed)\nend\n\n-- Refuses a tie id nothing declares. The same defence Flags.AssertKnown is: a mistyped\n-- tie on an offer is an offer that can never be reached or a rung that never lands, and\n-- neither has a runtime symptom anybody would notice.\nfunction Ties.AssertKnown(tieId: string?, where: string)\n	if tieId == nil then\n		return\n	end\n	if byId[tieId] == nil then\n		error(`[AGES content] {where} refers to tie \"{tieId}\", which is not declared in Ties.luau`)\n	end\nend\n\n-- What to show under somebody's name, or nil for the people who are nobody in particular\n-- -- which is most of a town, and a nameplate that said so on every head would be noise.\nfunction Ties.LabelOf(tieId: string?): string?\n	if tieId == nil then\n		return nil\n	end\n	local def = byId[tieId]\n	return if def ~= nil then def.label else nil\nend\n\nreturn Ties\n"
table.insert(AGES_MANIFEST, "src/server/content/Ties.luau")
AGES_SOURCES["src/server/content/Tills.luau"] = "--!strict\n-- Which places in town have a drawer worth opening.\n--\n-- Content, and deliberately a short list rather than \"every shop\". Three reasons, and\n-- the third is the one that matters:\n--\n--   A shop you can rob is a shop the game has to have furnished with a clerk and a\n--   camera, and furnishing forty of them is forty times the cost for no extra idea.\n--\n--   A spree should be a *route*. If every storefront on the street were a till, the\n--   optimal play would be to walk in a straight line with the heat climbing behind\n--   you, which is one decision made once. Spacing them out means the walk between two\n--   scores is a real choice about which way to go while a search ring drifts.\n--\n--   And a town where some doors are worth something and others are not is a town with\n--   knowledge in it. Learning which is which is the only progression this activity\n--   has, and it is the honest kind: it lives in the player rather than in a number.\n--\n-- Every id here has to be a place point in the built world -- the same ids PlaceService\n-- indexes -- because the till is stood up relative to one. An id that does not resolve\n-- is a shop that quietly cannot be robbed and nothing in the game would say so, which\n-- is why TheftService checks the whole list once at startup and names the offender.\n--\n-- The bank is not here. It has a vault rather than a till, its own layout and its own\n-- answer to \"what happens when you are seen\", and folding it into this list would mean\n-- the first thing built for it was a compromise with a corner store.\n\nlocal Tills = {}\n\n-- One robbable place.\nexport type Shop = {\n	-- The place id, which is also what the panel names.\n	place: string,\n	-- What the player calls it. Read off the place point's own label would be more\n	-- honest, but the label is a sentence about where to stand -- \"the pages & press, by\n	-- the counter\" -- and a heat notice needs a name.\n	name: string,\n	-- What the till is worth, as a share of Config.Crime.Theft.TillFloat.\n	--\n	-- The one difficulty dial in this file, and it is set against how exposed the shop\n	-- is rather than against what it sells. A market off the main street with two ways\n	-- out is worth less than a pharmacy with one door onto a street the police walk\n	-- down, because the thing being priced is the walk away from it.\n	-- Safe range: 0.5-1.5.\n	richness: number,\n}\n\nlocal Shops: { Shop } = {\n	-- The teaching one. Middle of the row, two exits either side, and the smallest float\n	-- in town: somewhere to learn what a clerk's shoulders look like when they turn,\n	-- without an afternoon riding on it.\n	{ place = \"pharmacy\", name = \"First Pharmacy\", richness = 0.7 },\n\n	-- A long way up the street from the pharmacy on purpose. The second robbery of a\n	-- spree should cost a walk, and this is the walk.\n	{ place = \"electronics\", name = \"Volt Electronics\", richness = 1.15 },\n\n	{ place = \"clothing_store\", name = \"Thread & Co\", richness = 0.9 },\n\n	-- The far end, and the richest of the four. It is also the closest to the civic row,\n	-- which is to say the closest to the police station -- so the best drawer in town is\n	-- the one where being seen costs the most. That is the trade this list exists to\n	-- make, and it is made with geography rather than with a number.\n	{ place = \"gas_station\", name = \"Tank & Go\", richness = 1.4 },\n}\n\n-- Loud at require time rather than at the moment somebody walks into a shop, which is\n-- the standing rule for content in this tree.\nlocal seen: { [string]: boolean } = {}\nfor index, shop in Shops do\n	if shop.place == \"\" then\n		error(`[AGES content] Tills[{index}] has no place id. Every shop must name a place point.`)\n	end\n	if seen[shop.place] then\n		error(\n			`[AGES content] two tills claim the place \"{shop.place}\". `\n				.. `A place point can only hold one drawer -- remove one of them from Tills.luau.`\n		)\n	end\n	seen[shop.place] = true\n	if shop.richness <= 0 then\n		error(\n			`[AGES content] shop \"{shop.place}\" has richness {shop.richness}. `\n				.. `A till worth nothing is a shop the player robs once and never returns to; `\n				.. `remove it from Tills.luau instead.`\n		)\n	end\nend\n\nTills.Shops = Shops\n\n-- Nil for a place with no drawer in it, which is almost every place in town. Every\n-- caller handles that rather than being handed a default: \"this shop cannot be robbed\"\n-- is the answer for most of the map and it is not an error anywhere.\nfunction Tills.Get(place: string): Shop?\n	for _, shop in Shops do\n		if shop.place == place then\n			return shop\n		end\n	end\n	return nil\nend\n\nreturn Tills\n"
table.insert(AGES_MANIFEST, "src/server/content/Tills.luau")
AGES_SOURCES["src/server/content/Townsfolk.luau"] = "--!strict\n-- The town: everybody in the world who is not one of the four people a life is made of.\n--\n-- Cast.luau says, correctly, that a small fixed cast beats generated strangers -- the\n-- neighbor who knocks when you are nine has to be the neighbor who knocks when you are\n-- forty. This file is not an argument with that. It is the other half of it. Those four\n-- are the people a life is *made of*, and they are hand-written because being your mother\n-- is a thing only writing can do. The town is the street those four stand on, and a\n-- street cannot be hand-written thirty times over without becoming four rooms with a\n-- crowd painted on the walls.\n--\n-- So the split is by what the person is for:\n--\n--   The cast     Four. Authored down to the sentence. In your life from birth or from\n--                the year you meet them, and gone only when the writing says so.\n--   The town     Thirty. Generated. Nobody's relative, nobody's plot. What they have\n--                instead is that they are there every time you go, and that turning up\n--                is the only thing that has ever changed them.\n--\n-- Generated ONCE, from a fixed seed, identically for every player and every server. That\n-- is the load-bearing decision and everything else here bends around it. A bond is saved\n-- against a person id; a population re-rolled per session would hand the friend you spent\n-- fifteen years earning to a stranger wearing a different face, and it would do it\n-- silently, because the id would still resolve. So the town is a fact about the world.\n-- The bond is the only part of it that is yours.\n--\n-- The seed is used per person rather than as one stream, which is why `Config.Town.Count`\n-- can be raised without disturbing anybody: townsperson 7 is a function of the seed and\n-- the number 7 alone, so it does not matter how many draws townsperson 6 made, or whether\n-- townsperson 31 exists. Their archetype comes off a fixed repeating pattern for the same\n-- reason.\n--\n-- What is deliberately not here: any of them knowing your name, having a history with\n-- you, or saying anything that only makes sense once. Those are the four's job. A\n-- generated line that tried to be personal would be the exact moment the player noticed\n-- these were generated.\n--\n-- What *is* here, and is the one thing a generated person can have that is genuinely\n-- personal: a rung. Every archetype below carries a ladder -- knows you, friend, closest\n-- friend -- and which of its six or eight copies you climbed it with is a fact about one\n-- particular person that nothing generated it. See content/Ties.luau.\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal Config = require(ReplicatedStorage:WaitForChild(\"Config\"))\nlocal Types = require(ReplicatedStorage:WaitForChild(\"Types\"))\n\nlocal Ties = require(script.Parent.Ties)\n\ntype CastMember = Types.CastMember\ntype Gender = Types.Gender\ntype Person = Types.Person\ntype PersonOffer = Types.PersonOffer\ntype StatDelta = Types.StatDelta\n\nlocal TOWN = Config.Town\nlocal PEOPLE = Config.People\n-- The bond an offer must ask for to be one nobody can ever be too estranged to take.\n-- Same meaning it has in People.luau, and the floor check there counts on it.\nlocal ALWAYS = PEOPLE.MinBond\n\n-- Spread between one townsperson's seed and the next. A large odd number rather than 1,\n-- because Random.new with adjacent seeds produces visibly related first draws -- which\n-- would show up as neighbours on the ring being the same height and colour.\nlocal SEED_STRIDE = 7919\n\n-- Names are drawn from their own stream rather than from the body's, so that widening a\n-- name pool later renames people without also resizing and recolouring them. Far enough\n-- from any multiple of the stride that it cannot land on another townsperson's seed.\nlocal NAME_STREAM = 104729\n\n-- Tried before this file gives up on finding somebody an unused name. Only reachable if\n-- the pools below shrink to near the population size, and reported rather than silently\n-- producing two people called the same thing standing in one room.\nlocal NAME_ATTEMPTS = 64\n\n-- One thing an archetype can do with you. A PersonOffer with the per-person parts left\n-- out: the id is built from whose offer it is, and the line is picked from several so\n-- that eight people of the same kind do not answer in one voice.\ntype Template = {\n	id: string,\n	label: string,\n	-- The player's ages, clamped into the archetype's own window at generation. Written\n	-- as the years the *sentence* makes sense, so a template can be shared by two\n	-- archetypes with different windows without being rewritten.\n	minAge: number,\n	maxAge: number,\n	minBond: number,\n	-- The upper gate, on the same terms as PersonOffer: while the bond sits above this\n	-- the row is not offered. Hostile rows are written at maxBond = -5 so a cold\n	-- relationship is the only one that can sour further, and the apology at maxBond = -1\n	-- so it is on the floor for the whole of the negative range and gone once the damage\n	-- is past. Checked against minBond here so the error names the template, not the\n	-- fourteenth generated copy of it.\n	maxBond: number?,\n	bond: number,\n	stats: StatDelta?,\n	money: number?,\n	ask: boolean?,\n	lines: { string },\n	-- Required when `ask` is set, refused otherwise. Same rule PersonOffer has, checked\n	-- here so the error names the template rather than the fourteenth generated copy of\n	-- it.\n	refusedLines: { string }?,\n	-- The answer is a walk rather than a talk, passed straight through to PersonOffer --\n	-- see the note on PersonOffer.walksTo for what accepting one does. `arrivalLines` is\n	-- plural, like `lines`, so eight people generated from one template do not all greet\n	-- you at the destination in one voice.\n	walksTo: string?,\n	arrivalLines: { string }?,\n	-- The rung, and what it takes to be standing on the one below. Passed straight\n	-- through to PersonOffer -- see Types.luau and content/Ties.luau for what they mean.\n	--\n	-- These are what make thirty strangers into a town somebody actually lives in. A\n	-- bond on its own only ever changed what was *offered*; a rung changes what a person\n	-- *is*, and the reason it belongs on an archetype rather than only on the authored\n	-- four is that friendship is the thing most likely to happen to you with somebody\n	-- nobody wrote a name for.\n	--\n	-- Deliberately no `sets`/`clears` here. A flag is a fact about the life, and a flag\n	-- set by a generated offer would be set identically by all six people generated from\n	-- the same archetype -- which makes it a fact about having met *a* classmate, not\n	-- about the one you met. That is what a tie is for.\n	gives: string?,\n	needsTie: string?,\n}\n\n-- A kind of person, and the only thing in this file that is really authored. Thirty\n-- people is too many to write; five kinds of person is not, and it is where all of the\n-- character in the town actually lives.\ntype Archetype = {\n	id: string,\n	placeId: string,\n	-- The player's ages this kind of person is around for.\n	minAge: number,\n	maxAge: number,\n	-- Years older than the player, drawn from this span. What separates the kid on your\n	-- street from the man who is always in the shop, more than anything either of them\n	-- says.\n	minAgeOffset: number,\n	maxAgeOffset: number,\n	-- Build, drawn per person: how far off average for their age this one is, where 1 is\n	-- average. **Not height.** Height comes from Config.Growth and the age offset above,\n	-- which is what makes a school read as a school from across the yard and, more to the\n	-- point, what makes the kid you played out front with at four taller at seventeen.\n	--\n	-- These used to be absolutes -- street kids were written at 0.8 to 0.95 -- and that was\n	-- wrong twice over: a rig shrunk without its head shrunk less is a short adult rather\n	-- than a child, and a number drawn once never grows. Every archetype now sits within a\n	-- few percent of 1, because being unusually tall is a fact about a person and being\n	-- four feet tall is a fact about being nine.\n	minHeight: number,\n	maxHeight: number,\n	startingBond: number,\n	busyLines: { string },\n	offers: { Template },\n	-- Contextual dialogue keyed by situation. Picked when the person is near the player\n	-- and the offer panel is not open. Nil means no extra lines.\n	contextualLines: { [string]: { string } }?,\n}\n\n-- Two lists rather than one, because a name has to agree with the person wearing it.\n--\n-- This was a single list of forty-two back when nothing read a townsperson's gender, so\n-- nothing could disagree with their name. The moment anything surfaces it -- and the town\n-- listing now shows the initial next to every row -- a \"Marcus\" the game privately\n-- considers a woman is not a rounding error, it is the game contradicting a fact about a\n-- stranger it has chosen to show. Splitting the list is what keeps name and person agreed.\n--\n-- Split rather than tagged per entry, so a name cannot be added without answering the\n-- question, and drawn from *after* the gender is rolled, so the two are one decision.\n-- The four that were genuinely unisex in the old list -- Hollis, Quill, Sunni, Wren --\n-- were assigned rather than dropped; they are good names and the alternative is a shorter\n-- world for a tidiness nobody would ever see.\n--\n-- Kept deliberately wide in origin. A town where everybody is named from one tradition is\n-- a town that has quietly decided who lives there.\nlocal MALE_FIRST_NAMES: { string } = {\n	\"Amos\",\n	\"Callum\",\n	\"Darius\",\n	\"Eamon\",\n	\"Farid\",\n	\"Gus\",\n	\"Hollis\",\n	\"Isak\",\n	\"Jonah\",\n	\"Kaveh\",\n	\"Linus\",\n	\"Marcus\",\n	\"Nico\",\n	\"Odell\",\n	\"Quill\",\n	\"Rafi\",\n	\"Tobias\",\n	\"Vance\",\n	\"Yusuf\",\n	\"Zaid\",\n}\n\nlocal FEMALE_FIRST_NAMES: { string } = {\n	\"Adaeze\",\n	\"Anouk\",\n	\"Bea\",\n	\"Cleo\",\n	\"Delia\",\n	\"Esme\",\n	\"Frida\",\n	\"Halima\",\n	\"Ines\",\n	\"Junie\",\n	\"Keziah\",\n	\"Lena\",\n	\"Mabel\",\n	\"Nadia\",\n	\"Oona\",\n	\"Pilar\",\n	\"Rosalind\",\n	\"Sunni\",\n	\"Trudy\",\n	\"Ulla\",\n	\"Wren\",\n	\"Zora\",\n}\n\nlocal LAST_NAMES: { string } = {\n	\"Ableman\",\n	\"Barrow\",\n	\"Cassar\",\n	\"Dunmore\",\n	\"Enright\",\n	\"Fenwick\",\n	\"Gale\",\n	\"Hargreave\",\n	\"Ijeoma\",\n	\"Jarvis\",\n	\"Kandel\",\n	\"Lomax\",\n	\"Mbeki\",\n	\"Nightingale\",\n	\"Okonkwo\",\n	\"Pell\",\n	\"Quinlan\",\n	\"Rutledge\",\n	\"Sandoval\",\n	\"Tourville\",\n	\"Ustinov\",\n	\"Vasquez\",\n	\"Whitlock\",\n	\"Yardley\",\n	\"Zeman\",\n	\"Ashgrove\",\n	\"Bellweather\",\n	\"Coriander\",\n}\n\n-- Skin tones, as HumanoidDescription takes them. A palette rather than a random channel\n-- walk: three random bytes produce green people about as often as they produce anybody,\n-- and a town is not a place to find that out in.\nlocal SKIN_TONES: { Color3 } = {\n	Color3.fromRGB(247, 214, 189),\n	Color3.fromRGB(238, 199, 170),\n	Color3.fromRGB(226, 181, 150),\n	Color3.fromRGB(210, 163, 130),\n	Color3.fromRGB(191, 143, 110),\n	Color3.fromRGB(168, 124, 96),\n	Color3.fromRGB(145, 104, 78),\n	Color3.fromRGB(122, 86, 64),\n	Color3.fromRGB(98, 68, 50),\n	Color3.fromRGB(76, 52, 38),\n}\n\nlocal ARCHETYPES: { Archetype } = {\n	{\n		-- The kids on your street. The only townsfolk who are around before school is,\n		-- and the reason the first six years of a life have anybody in them but family.\n		--\n		-- From nought rather than from four, and that is not a bonding decision -- it is\n		-- what stops the opening of the game being a world with two people in it. An age\n		-- window here was doing two jobs at once: deciding who you can get to know, and\n		-- deciding who *exists*. Nobody expects a two-year-old to make a friend. They do\n		-- expect there to be somebody outside.\n		--\n		-- The offset floor is nought for the same reason it is not minus one: a kid a year\n		-- younger than a toddler is a baby, and a baby standing on the pavement offering to\n		-- be followed is worse than an empty pavement.\n		id = \"street\",\n		placeId = \"home\",\n		minAge = 0,\n		maxAge = 17,\n		minAgeOffset = 0,\n		maxAgeOffset = 3,\n		minHeight = 0.94,\n		maxHeight = 1.04,\n		-- A little warmth to start with, for the same reason Rae has some: you are small\n		-- and so are they and that is the entire basis of it.\n		startingBond = 5,\n		busyLines = {\n			\"Can't, I've got to go in. Tomorrow?\",\n			\"Not now! We're in the middle of something.\",\n			\"My mum's calling me. See you out here after.\",\n		},\n		contextualLines = {\n			morning = {\n				\"Wake up early, huh?\",\n				\"The sun's nice today.\",\n				\"Let's play until mum calls us in.\",\n			},\n			onShift = {\n				\"You're working? Cool!\",\n				\"Make lots of money!\",\n				\"Can I come visit you?\",\n			},\n			unemployed = {\n				\"What do you do all day?\",\n				\"I wish I could play all day too.\",\n			},\n		},\n		offers = {\n			-- The relationship block, shared by every archetype so whoever you are talking\n			-- to -- a written name or one of thirty rolled strangers -- can be talked to at\n			-- any depth, driven apart, and mended. Written first because the panel sorts by\n			-- what a row asks of the bond and throws the tail away: at the bottom of the\n			-- range, where the archetype's own rows have all asked for more warmth than is\n			-- on offer, this is what somebody still has. The hostile rows and the apology\n			-- carry no stats -- the relationship is the point, and the cold shoulder is not\n			-- meant to be a treat.\n			{\n				id = \"small_talk\",\n				label = \"Talk about nothing in particular\",\n				minAge = 5,\n				maxAge = 999,\n				minBond = ALWAYS,\n				bond = 1,\n				stats = { happiness = 2 },\n				lines = {\n					\"Nothing much to do. I'm staying out here.\",\n					\"What do you want to talk about? I'm bored, but I can talk.\",\n					\"It's boring when there's nobody around. Good, then. You're here.\",\n				},\n			},\n			{\n				id = \"snub\",\n				label = \"Snub them\",\n				minAge = 10,\n				maxAge = 999,\n				minBond = ALWAYS,\n				maxBond = -5,\n				bond = -5,\n				lines = {\n					\"Whatever. I'm not bothered.\",\n					\"Come back when I feel like it. That could be a while.\",\n				},\n			},\n			{\n				id = \"cold_shoulder\",\n				label = \"Give them the cold shoulder\",\n				minAge = 10,\n				maxAge = 999,\n				minBond = ALWAYS,\n				maxBond = -5,\n				bond = -7,\n				lines = {\n					\"Don't talk to me. I mean it.\",\n					\"Yeah. Whatever. I said whatever.\",\n				},\n			},\n			{\n				id = \"make_right\",\n				label = \"Try to make it right\",\n				minAge = 10,\n				maxAge = 999,\n				minBond = ALWAYS,\n				maxBond = -1,\n				bond = 8,\n				ask = true,\n				lines = {\n					\"Alright. Fine. I'm still cross, but fine.\",\n				},\n				refusedLines = {\n					\"Not yet. Give it time. A lot of time.\",\n					\"You keep saying that. I don't believe you yet.\",\n				},\n			},\n			-- The toddler band, and the whole of what a street is to somebody who cannot\n			-- yet say a sentence. Two rows, both cheap, both over by five -- deliberately\n			-- thin, because the point of them is that the dots above somebody's head are\n			-- lit rather than dark, not that a two-year-old has a social life. What they\n			-- really teach is the grammar: three dots means a person you can answer, and a\n			-- player who learns that at two knows it at forty.\n			--\n			-- They are also load-bearing. The floor check at the bottom of this file\n			-- refuses an archetype with a year in it that nobody at the bottom of the bond\n			-- range could take, so the window above cannot be widened without these --\n			-- which is the right way round.\n			{\n				id = \"toddle_after\",\n				label = \"Toddle after them\",\n				minAge = 0,\n				maxAge = 4,\n				minBond = ALWAYS,\n				bond = 3,\n				stats = { happiness = 2 },\n				lines = {\n					\"It's following me again. Muuum, it's following me.\",\n					\"Come on then. Slowly. You're really slow.\",\n					\"You can come. Hold my hand at the road bit.\",\n				},\n			},\n			{\n				id = \"copy_them\",\n				label = \"Copy what they're doing\",\n				minAge = 0,\n				maxAge = 4,\n				minBond = 0,\n				bond = 3,\n				stats = { happiness = 2 },\n				lines = {\n					\"No, like this. Like THIS. You're not doing it.\",\n					\"Ha! Do it again. Do it again!\",\n					\"Stop copying me. ...Okay, keep copying me.\",\n				},\n			},\n			{\n				id = \"out_front\",\n				label = \"Go out front with them\",\n				minAge = 4,\n				maxAge = 17,\n				minBond = ALWAYS,\n				bond = 3,\n				stats = { happiness = 2 },\n				lines = {\n					\"Come on then. Before it gets dark.\",\n					\"Yes! I've been out here on my own for ages.\",\n					\"Right. You're on my team, obviously.\",\n				},\n			},\n			{\n				id = \"swap\",\n				label = \"Swap something with them\",\n				minAge = 6,\n				maxAge = 14,\n				minBond = ALWAYS,\n				bond = 4,\n				stats = { happiness = 1 },\n				lines = {\n					\"Deal. No takebacks, that's the rule.\",\n					\"Mine's better but fine. Fine!\",\n					\"Don't tell anyone what I gave you for it.\",\n				},\n			},\n			{\n				-- Costs health and pays happiness, which is the honest arithmetic of being\n				-- nine. It is also the only thing on this list you have to have warmed to\n				-- somebody to be offered, because nobody dares a stranger.\n				id = \"dare\",\n				label = \"Take the dare\",\n				minAge = 7,\n				maxAge = 15,\n				minBond = 0,\n				bond = 5,\n				stats = { happiness = 3, health = -1 },\n				lines = {\n					\"You actually did it. You actually did it!\",\n					\"Okay, that was further than I'd have gone.\",\n					\"I'm telling everyone about this. Everyone.\",\n				},\n			},\n			{\n				id = \"race\",\n				label = \"Race them to the corner\",\n				minAge = 5,\n				maxAge = 12,\n				minBond = ALWAYS,\n				bond = 3,\n				stats = { happiness = 2, health = 1 },\n				lines = {\n					\"Best of three. I wasn't ready that time.\",\n					\"You went early! That doesn't count.\",\n					\"Again. Come on, again.\",\n				},\n			},\n			{\n				-- Costs bond and pays happiness, and it is here because a street with no\n				-- way to fall out with anybody on it is not a street, it is a lobby.\n				id = \"fall_out\",\n				label = \"Fall out over nothing\",\n				minAge = 8,\n				maxAge = 16,\n				minBond = ALWAYS,\n				bond = -5,\n				stats = { happiness = 1 },\n				lines = {\n					\"Fine. Go home then.\",\n					\"Whatever. I didn't even want to play.\",\n					\"Don't bother knocking tomorrow.\",\n				},\n			},\n			{\n				id = \"walk_school\",\n				label = \"Walk to school together\",\n				minAge = 6,\n				maxAge = 17,\n				minBond = 15,\n				bond = 4,\n				ask = true,\n				walksTo = \"school\",\n				lines = {\n					\"I'll wait on the wall for you. Don't be slow.\",\n					\"Long way or short way? Long way.\",\n					\"You're carrying my bag for the hill bit.\",\n				},\n				refusedLines = {\n					\"Suit yourself. The long way's the best bit anyway.\",\n					\"Rain's coming in. Maybe better not.\",\n					\"Another time then. Don't be late.\",\n				},\n				arrivalLines = {\n					\"Here we are. Reckon you could beat me to the gate?\",\n					\"Right, you're handed over. Mind the teacher with the whistle.\",\n					\"Made it. See you after last bell.\",\n				},\n			},\n			{\n				id = \"walk_park\",\n				label = \"Walk to the park together\",\n				minAge = 5,\n				maxAge = 17,\n				minBond = 25,\n				bond = 4,\n				ask = true,\n				walksTo = \"park\",\n				lines = {\n					\"Race you to the far gate. No, that's cheating, the far gate.\",\n					\"I found a new thing at the park. You have to see it.\",\n					\"Bring a coat. We're staying till the lights come on.\",\n				},\n				refusedLines = {\n					\"Fine. I'll find somebody who's not boring.\",\n					\"Another day. I'm waiting for someone.\",\n				},\n				arrivalLines = {\n					\"See? The swings do that thing. Watch.\",\n					\"We're here. Don't tell your mum about the hill bit.\",\n					\"Park's ours now. Nobody else is about.\",\n				},\n			},\n			{\n				id = \"cover\",\n				label = \"Ask them to cover for you\",\n				minAge = 12,\n				maxAge = 17,\n				minBond = 40,\n				bond = -1,\n				stats = { happiness = 2 },\n				ask = true,\n				lines = {\n					\"You were here all afternoon. Obviously.\",\n					\"I'll say it, but you owe me a big one.\",\n				},\n				refusedLines = {\n					\"No. I'm not lying to your mum, she's terrifying.\",\n					\"Ask me something else. Not that.\",\n				},\n			},\n			-- The ladder. Three rows across fourteen years, and they are the only rows on\n			-- this list that change what somebody *is* rather than what they will do.\n			--\n			-- On the street it is made of the two things that actually decide a childhood\n			-- friendship: which house you knock at, and who you are still out with when\n			-- everyone else has gone in.\n			{\n				id = \"know_names\",\n				label = \"Learn each other's names\",\n				minAge = 4,\n				maxAge = 17,\n				minBond = 10,\n				bond = 3,\n				stats = { happiness = 1 },\n				gives = \"known\",\n				lines = {\n					\"I've seen you loads. I never knew that was your name.\",\n					\"Right. I'll shout that up at your window then.\",\n					\"Good name. Better than mine.\",\n				},\n			},\n			{\n				id = \"call_for_them\",\n				label = \"Call for them every single day\",\n				minAge = 5,\n				maxAge = 17,\n				minBond = 35,\n				bond = 6,\n				stats = { happiness = 3 },\n				needsTie = \"known\",\n				gives = \"friend\",\n				lines = {\n					\"You're always at that door. My mum says you live here now.\",\n					\"Same time tomorrow. And the day after. Obviously.\",\n					\"I wait by the window for you. Don't tell anyone I said that.\",\n				},\n			},\n			{\n				id = \"streetlights\",\n				label = \"Stay out until the streetlights come on\",\n				minAge = 7,\n				maxAge = 17,\n				minBond = 70,\n				bond = 8,\n				stats = { happiness = 4, health = -1 },\n				needsTie = \"friend\",\n				gives = \"closest\",\n				lines = {\n					\"We're both getting shouted at for this. Worth it.\",\n					\"That's the light on. One more minute. One.\",\n					\"Whoever you are when we're old -- this. Remember this bit.\",\n				},\n			},\n			-- The payoff, and the reason the rungs are worth climbing rather than just\n			-- worth having. Only ever on the panel of somebody who is already a friend.\n			{\n				id = \"back_you_up\",\n				label = \"Have them back you up\",\n				minAge = 8,\n				maxAge = 17,\n				minBond = 45,\n				bond = 4,\n				stats = { happiness = 3, health = 1 },\n				needsTie = \"friend\",\n				lines = {\n					\"I was standing right there the whole time. Obviously.\",\n					\"They're not going to say anything to you with me here.\",\n					\"You don't even have to ask me that. Ever.\",\n				},\n			},\n		},\n	},\n	{\n		-- School. The one archetype that ends -- they age out at seventeen with the\n		-- school itself, exactly as Rae does, because a classmate you never saw again\n		-- after the last day is what a classmate mostly is.\n		id = \"classmate\",\n		placeId = \"school\",\n		minAge = 6,\n		maxAge = 17,\n		minAgeOffset = -1,\n		maxAgeOffset = 1,\n		minHeight = 0.94,\n		maxHeight = 1.04,\n		startingBond = 0,\n		busyLines = {\n			\"Can't, I've got a thing. Later!\",\n			\"Sorry -- late already. Catch me tomorrow.\",\n			\"Not today. Ask me again, though.\",\n		},\n		contextualLines = {\n			morning = {\n				\"Hey! Did you finish the homework?\",\n				\"Rough morning. Didn't sleep well.\",\n				\"See you at lunch?\",\n			},\n			onShift = {\n				\"You're working? That's awesome!\",\n				\"What do you do there? Tell me about it!\",\n				\"Good luck with the long hours!\",\n			},\n			unemployed = {\n				\"What are you doing now that you're not in school?\",\n				\"Must be nice to sleep in.\",\n				\"School's better than nothing, right?\",\n			},\n		},\n		offers = {\n			-- The relationship block, shared by every archetype so whoever you are talking\n			-- to can be talked to at any depth, driven apart, and mended. Written first\n			-- because the panel sorts by what a row asks of the bond and throws the tail\n			-- away: at the bottom of the range this is what somebody still has.\n			{\n				id = \"small_talk\",\n				label = \"Talk about nothing in particular\",\n				minAge = 5,\n				maxAge = 999,\n				minBond = ALWAYS,\n				bond = 1,\n				stats = { happiness = 2 },\n				lines = {\n					\"Nothing doing this lesson. You want to just... not?\",\n					\"It's quieter back here. I like it back here.\",\n					\"I'll talk to you. The register can wait.\",\n				},\n			},\n			{\n				id = \"snub\",\n				label = \"Snub them\",\n				minAge = 10,\n				maxAge = 999,\n				minBond = ALWAYS,\n				maxBond = -5,\n				bond = -5,\n				lines = {\n					\"Not talking to you today. Ask me tomorrow.\",\n					\"Whatever. I don't even know you.\",\n				},\n			},\n			{\n				id = \"cold_shoulder\",\n				label = \"Give them the cold shoulder\",\n				minAge = 10,\n				maxAge = 999,\n				minBond = ALWAYS,\n				maxBond = -5,\n				bond = -7,\n				lines = {\n					\"Go sit somewhere else.\",\n					\"I saw you. I decided not to say anything.\",\n				},\n			},\n			{\n				id = \"make_right\",\n				label = \"Try to make it right\",\n				minAge = 10,\n				maxAge = 999,\n				minBond = ALWAYS,\n				maxBond = -1,\n				bond = 8,\n				ask = true,\n				lines = {\n					\"Fine. I'll sit with you again. Don't make it weird.\",\n				},\n				refusedLines = {\n					\"I'm still mad. Ask me again later.\",\n					\"No. I'm having lunch with other people.\",\n				},\n			},\n			{\n				id = \"sit_with\",\n				label = \"Sit with them at lunch\",\n				minAge = 6,\n				maxAge = 17,\n				minBond = ALWAYS,\n				bond = 3,\n				stats = { happiness = 2 },\n				lines = {\n					\"Shove up, then. There's room.\",\n					\"You can have my crusts. I'm being generous.\",\n					\"Good, I was going to have to sit on my own.\",\n				},\n			},\n			{\n				-- Buys you the afternoon and costs you the thing school is for. The\n				-- clearest small version of what this whole game is about.\n				id = \"copy\",\n				label = \"Copy their homework\",\n				minAge = 9,\n				maxAge = 17,\n				minBond = ALWAYS,\n				bond = -2,\n				stats = { happiness = 2, smarts = -1 },\n				lines = {\n					\"Change some of the words. Don't be obvious.\",\n					\"Last time. I mean it this time.\",\n					\"If we both get it wrong they'll know, you know.\",\n				},\n			},\n			{\n				id = \"explain\",\n				label = \"Explain it to them\",\n				minAge = 8,\n				maxAge = 17,\n				minBond = 0,\n				bond = 4,\n				stats = { smarts = 2 },\n				lines = {\n					\"Oh. OH. Why didn't they just say that?\",\n					\"Say it again slower and I've got it.\",\n					\"You're better at this than the teacher is.\",\n				},\n			},\n			{\n				id = \"team\",\n				label = \"Pick them for your team\",\n				minAge = 6,\n				maxAge = 14,\n				minBond = ALWAYS,\n				bond = 5,\n				stats = { happiness = 1 },\n				lines = {\n					\"Really? Yes. Yes!\",\n					\"Nobody ever picks me first. Nobody.\",\n					\"You won't regret it. Probably.\",\n				},\n			},\n			{\n				id = \"notes\",\n				label = \"Ask to borrow their notes\",\n				minAge = 11,\n				maxAge = 17,\n				minBond = 25,\n				bond = -1,\n				stats = { smarts = 2 },\n				ask = true,\n				lines = {\n					\"Back to me before the test. Before.\",\n					\"They're a mess, but they're all there.\",\n				},\n				refusedLines = {\n					\"I need them. Sorry -- I actually need them.\",\n					\"Ask literally anyone else. I'm behind too.\",\n				},\n			},\n			{\n				id = \"after_school\",\n				label = \"Go into town after school\",\n				minAge = 13,\n				maxAge = 17,\n				minBond = 35,\n				bond = 5,\n				stats = { happiness = 3, smarts = -1 },\n				lines = {\n					\"We're going to be so late back. Come on.\",\n					\"Best afternoon in ages, that.\",\n					\"Same again Friday. Say yes.\",\n				},\n			},\n			-- The ladder, in the one place where a friendship has a shape everybody\n			-- recognises: a seat, a seat kept for you, and the thing you only tell one\n			-- person. School is also the one archetype the ladder can *run out* on --\n			-- classmates age out at seventeen with the school, so a closest friend made\n			-- here is one you will lose touch with, and the slot they were holding\n			-- quietly reopens. That is not a bug in the cap; that is what leaving\n			-- school is.\n			{\n				id = \"sit_next\",\n				label = \"Sit next to them, not just near them\",\n				minAge = 6,\n				maxAge = 17,\n				minBond = 10,\n				bond = 3,\n				stats = { happiness = 1 },\n				gives = \"known\",\n				lines = {\n					\"You can, yeah. Nobody sits there anyway.\",\n					\"Move up then. Go on.\",\n					\"I was hoping you would, actually.\",\n				},\n			},\n			{\n				id = \"save_seat\",\n				label = \"Save each other a seat every day\",\n				minAge = 7,\n				maxAge = 17,\n				minBond = 35,\n				bond = 6,\n				stats = { happiness = 3 },\n				needsTie = \"known\",\n				gives = \"friend\",\n				lines = {\n					\"Bag's on it. It's always going to be on it.\",\n					\"I got told off holding that for you. Still held it.\",\n					\"Don't be weird about it, but -- every day, yeah.\",\n				},\n			},\n			{\n				id = \"tell_them\",\n				label = \"Tell them the thing you've told nobody\",\n				minAge = 11,\n				maxAge = 17,\n				minBond = 70,\n				bond = 8,\n				stats = { happiness = 4 },\n				needsTie = \"friend\",\n				gives = \"closest\",\n				lines = {\n					\"I'm not telling anyone. Not ever. You know that.\",\n					\"Thanks for -- yeah. For picking me to say it to.\",\n					\"Right. My turn then. Sit down for this one.\",\n				},\n			},\n			{\n				id = \"study_properly\",\n				label = \"Actually study with them\",\n				minAge = 11,\n				maxAge = 17,\n				minBond = 45,\n				bond = 4,\n				stats = { smarts = 4, happiness = -1 },\n				needsTie = \"friend\",\n				lines = {\n					\"Four hours. We did four hours. I feel ill.\",\n					\"You explain that bit, I'll do the rest. Deal.\",\n					\"I'd never have got through that on my own.\",\n				},\n			},\n			{\n				id = \"walk_crossing\",\n				label = \"Walk to the crossing with them\",\n				minAge = 7,\n				maxAge = 16,\n				minBond = 20,\n				bond = 4,\n				ask = true,\n				walksTo = \"crossing\",\n				lines = {\n					\"Your way's my way for a bit. Come on.\",\n					\"I'll walk you as far as the lights.\",\n					\"Race you to the crossing -- no, that's cheating.\",\n				},\n				refusedLines = {\n					\"Fair enough. See you tomorrow.\",\n					\"My mum's picking me up, so --\",\n					\"Another day. I've got football.\",\n				},\n				arrivalLines = {\n					\"Lights are changing. I'll leave you here.\",\n					\"There's the crossing. Same tomorrow?\",\n					\"Right, this is where I go back. Walk you home properly sometime.\",\n				},\n			},\n			{\n				id = \"walk_library\",\n				label = \"Walk to the library together\",\n				minAge = 8,\n				maxAge = 17,\n				minBond = 30,\n				bond = 4,\n				ask = true,\n				walksTo = \"library\",\n				lines = {\n					\"I've got to return something. Come keep me company.\",\n					\"We could actually get the work done, if we go now.\",\n					\"They got new books in. I saw the crate.\",\n				},\n				refusedLines = {\n					\"Alright. Don't copy all my notes.\",\n					\"Another time. I've got football practice.\",\n				},\n				arrivalLines = {\n					\"Quiet corner's ours. Right, questions?\",\n					\"Here we are. Ten minutes of work, then we look at the good ones.\",\n					\"See the new ones? Told you about the crate.\",\n				},\n			},\n		},\n	},\n	{\n		-- The people who are always in the shop. Older than you by a generation or two,\n		-- around from before you can remember to the end, and the only townsfolk a whole\n		-- life can be spent getting to know.\n		--\n		-- \"From before you can remember\" is now literally true rather than nearly true.\n		-- They are the reason there is anybody on the road at all in the first years: the\n		-- street kids are at your own front door, and a regular walking the length of the\n		-- route graph from the shop is the only thing in the game that makes the ground\n		-- between two buildings read as a place people pass through rather than as the gap\n		-- between two crowds. That only works because the leash is longer than the town.\n		id = \"regular\",\n		placeId = \"store\",\n		minAge = 0,\n		maxAge = 999,\n		minAgeOffset = 14,\n		maxAgeOffset = 48,\n		minHeight = 0.95,\n		maxHeight = 1.06,\n		startingBond = 0,\n		busyLines = {\n			\"Another time. I'm halfway through my list.\",\n			\"Not today, thank you. Good to see you though.\",\n			\"I'm in a rush, of all things. At my age.\",\n		},\n		contextualLines = {\n			morning = {\n				\"Morning. Beautiful day, isn't it?\",\n				\"Out for a walk? Take your time.\",\n				\"The weather's turned. Nice change.\",\n			},\n			onShift = {\n				\"Working hard? Don't forget to take a break.\",\n				\"How's the job treating you?\",\n				\"All that work, and you're still standing. Respect.\",\n			},\n			unemployed = {\n				\"Looking for work? I heard the factory is hiring.\",\n				\"Not working today? Enjoy the freedom while it lasts.\",\n				\"The job market's tough, but you'll find something.\",\n			},\n			atHome = {\n				\"Nice place you got there.\",\n				\"Home sweet home, eh?\",\n				\"First time in your own place?\",\n			},\n		},\n		offers = {\n			-- The relationship block, shared by every archetype so whoever you are talking\n			-- to can be talked to at any depth, driven apart, and mended. Written first\n			-- because the panel sorts by what a row asks of the bond and throws the tail\n			-- away: at the bottom of the range this is what somebody still has.\n			{\n				id = \"small_talk\",\n				label = \"Talk about nothing in particular\",\n				minAge = 5,\n				maxAge = 999,\n				minBond = ALWAYS,\n				bond = 1,\n				stats = { happiness = 2 },\n				lines = {\n					\"No rush. Talk to me, I'm in no hurry.\",\n					\"I've got all day, and a good deal of it's already gone. What's new?\",\n					\"Go on then, sit yourself down. I'm not going anywhere.\",\n				},\n			},\n			{\n				id = \"snub\",\n				label = \"Snub them\",\n				minAge = 10,\n				maxAge = 999,\n				minBond = ALWAYS,\n				maxBond = -5,\n				bond = -5,\n				lines = {\n					\"Right. I see how it is.\",\n					\"Fine. I won't be the one to break the silence.\",\n				},\n			},\n			{\n				id = \"cold_shoulder\",\n				label = \"Give them the cold shoulder\",\n				minAge = 10,\n				maxAge = 999,\n				minBond = ALWAYS,\n				maxBond = -5,\n				bond = -7,\n				lines = {\n					\"Hmph. Some people.\",\n					\"I'll just stand here, then. We both know the rules.\",\n				},\n			},\n			{\n				id = \"make_right\",\n				label = \"Try to make it right\",\n				minAge = 10,\n				maxAge = 999,\n				minBond = ALWAYS,\n				maxBond = -1,\n				bond = 8,\n				ask = true,\n				lines = {\n					\"Well. That took some doing. I accept.\",\n				},\n				refusedLines = {\n					\"I've had a lifetime of making things right. Not this time.\",\n					\"Give it more than a day. That's all I'll say.\",\n				},\n			},\n			-- The toddler band. An adult stranger and a child who cannot talk have exactly\n			-- one thing between them and it is being made a fuss of in the street, so that\n			-- is what these two are -- warm, brief, and gone by five, when \"Say hello\"\n			-- takes over and the rest of a lifetime's worth of rows starts opening up.\n			--\n			-- The second one is the same verb the player already has with their mother\n			-- (\"Show her what you found\"), pointed at somebody who is not family. That is\n			-- the smallest statement this game can make that the world is bigger than the\n			-- house, and it costs two rows to make it.\n			{\n				id = \"made_a_fuss\",\n				label = \"Let them make a fuss of you\",\n				minAge = 0,\n				maxAge = 4,\n				minBond = ALWAYS,\n				bond = 2,\n				stats = { happiness = 2 },\n				lines = {\n					\"Haven't you grown. They grow while you're not looking.\",\n					\"Oh, look at you. Look at YOU.\",\n					\"Hello, trouble. Yes, I mean you.\",\n				},\n			},\n			{\n				id = \"show_them\",\n				label = \"Show them what you're holding\",\n				minAge = 0,\n				maxAge = 4,\n				minBond = ALWAYS,\n				bond = 3,\n				stats = { happiness = 2 },\n				lines = {\n					\"Is that right. That's the best one I've seen all week.\",\n					\"Very good. Mind you don't drop it in the road.\",\n					\"For me? No -- you keep hold of it. You keep hold.\",\n				},\n			},\n			{\n				id = \"hello\",\n				label = \"Say hello\",\n				minAge = 5,\n				maxAge = 999,\n				minBond = ALWAYS,\n				bond = 2,\n				stats = { happiness = 1 },\n				lines = {\n					\"Hello there. You're getting tall.\",\n					\"Well, hello. Haven't seen you in a while.\",\n					\"Afternoon. Miserable weather, isn't it.\",\n				},\n			},\n			{\n				id = \"hand\",\n				label = \"Give them a hand\",\n				minAge = 8,\n				maxAge = 999,\n				minBond = ALWAYS,\n				bond = 4,\n				stats = { happiness = -1 },\n				lines = {\n					\"That's kind. Most wouldn't have stopped.\",\n					\"Thank you. My back's not what it was.\",\n					\"There. Two minutes of your life well spent.\",\n				},\n			},\n			{\n				id = \"weather\",\n				label = \"Let them talk\",\n				minAge = 5,\n				maxAge = 999,\n				minBond = 0,\n				bond = 3,\n				stats = { happiness = 1 },\n				lines = {\n					\"-- and that's the third time this month. Third!\",\n					\"Anyway. You didn't come here for all that.\",\n					\"You're a good listener, you know that?\",\n				},\n			},\n			{\n				id = \"advice\",\n				label = \"Ask what they would have done\",\n				minAge = 16,\n				maxAge = 999,\n				minBond = 30,\n				bond = 2,\n				stats = { smarts = 2 },\n				lines = {\n					\"At your age? Nothing sensible, that's for certain.\",\n					\"Wait a week. It'll look different in a week.\",\n					\"Do the boring thing. It's boring because it works.\",\n				},\n			},\n			{\n				id = \"spot_me\",\n				label = \"Ask them to spot you\",\n				minAge = 18,\n				maxAge = 999,\n				minBond = 50,\n				bond = -2,\n				money = 120,\n				ask = true,\n				lines = {\n					\"Go on then. Don't make a habit of it.\",\n					\"Here. I've been where you are.\",\n				},\n				refusedLines = {\n					\"I would if I had it. I haven't got it.\",\n					\"No. And I'd think less of myself for saying yes.\",\n				},\n			},\n			-- The ladder. This is the only one that can run the whole length of a life --\n			-- a regular is in the shop from the year you can walk to it to the year you\n			-- stop -- so the rungs are spread wide on purpose. Becoming the closest friend\n			-- of somebody thirty years older than you takes decades of turning up, and it\n			-- ought to.\n			{\n				id = \"know_regular\",\n				label = \"Get properly introduced\",\n				minAge = 6,\n				maxAge = 999,\n				minBond = 10,\n				bond = 3,\n				stats = { happiness = 1 },\n				gives = \"known\",\n				lines = {\n					\"Well. Now I've got to remember it, haven't I.\",\n					\"I've nodded at you for a year. About time.\",\n					\"Pleasure. I'm here most days, as you've noticed.\",\n				},\n			},\n			{\n				id = \"outside_shop\",\n				label = \"See them somewhere that isn't the shop\",\n				minAge = 14,\n				maxAge = 999,\n				minBond = 35,\n				bond = 6,\n				stats = { happiness = 3 },\n				needsTie = \"known\",\n				gives = \"friend\",\n				lines = {\n					\"Funny, isn't it. Took us years to leave that aisle.\",\n					\"Same again next week. I'll be the one already sat down.\",\n					\"I've got people I've known forty years I've never done this with.\",\n				},\n			},\n			{\n				id = \"keep_up\",\n				label = \"Keep up with them when you don't have to\",\n				minAge = 20,\n				maxAge = 999,\n				minBond = 70,\n				bond = 8,\n				stats = { happiness = 4 },\n				needsTie = \"friend\",\n				gives = \"closest\",\n				lines = {\n					\"You'd have stopped coming years ago if you were going to.\",\n					\"There's not many left who'd bother. You bother.\",\n					\"I'll say the thing I don't say: I'm glad it's you.\",\n				},\n			},\n			{\n				-- A mentor is a chosen guide, not a parent. Offered by somebody older and\n				-- further along when the bond is deep enough that they will actually invest\n				-- in you. It sits above the friendship ladder because a life can hold both\n				-- a closest friend and a mentor — they are different kinds of significance.\n				id = \"learn_from\",\n				label = \"Ask them to teach you something\",\n				minAge = 16,\n				maxAge = 999,\n				minBond = 75,\n				bond = 5,\n				stats = { smarts = 2, happiness = 2 },\n				needsTie = \"friend\",\n				gives = \"mentor\",\n				lines = {\n					\"I've been where you are. I can show you the shortcuts.\",\n					\"Alright. But I won't go easy on you — that's not teaching.\",\n					\"First lesson: nobody owes you anything. Now let's get to work.\",\n				},\n			},\n			{\n				id = \"put_aside\",\n				label = \"Collect what they put aside for you\",\n				minAge = 12,\n				maxAge = 999,\n				minBond = 45,\n				bond = 3,\n				money = 40,\n				needsTie = \"friend\",\n				lines = {\n					\"Been under the counter with your name on a week.\",\n					\"Don't argue. It was going in the bin otherwise.\",\n					\"Take it. You'd do the same and we both know it.\",\n				},\n			},\n			{\n				id = \"walk_gate\",\n				label = \"Walk you to the gate\",\n				minAge = 12,\n				maxAge = 999,\n				minBond = 25,\n				bond = 4,\n				ask = true,\n				walksTo = \"gate\",\n				lines = {\n					\"Just locking up. Walk you to your gate?\",\n					\"I'm heading your way anyway. Come on.\",\n					\"You look done in. I'll see you home.\",\n				},\n				refusedLines = {\n					\"Alright. Goodnight then.\",\n					\"Suit yourself. Stay out of trouble.\",\n					\"Another time. I've got the float to count.\",\n				},\n				arrivalLines = {\n					\"Here's your gate. That's me sorted too.\",\n					\"Right, home you go. Goodnight.\",\n					\"There we are. Say hello to whoever's in for me.\",\n				},\n			},\n			{\n				id = \"walk_bakery\",\n				label = \"Walk to the bakery with them\",\n				minAge = 18,\n				maxAge = 999,\n				minBond = 35,\n				bond = 4,\n				ask = true,\n				walksTo = \"bakery\",\n				lines = {\n					\"I'm getting the good bread while it's there. Come on.\",\n					\"They save me the end of the sourdough. Walking by anyway.\",\n					\"Treat yourself. That's what bakeries are for.\",\n				},\n				refusedLines = {\n					\"Another time. I'm watching the figure, these days.\",\n					\"Alright. I'll say you were there in spirit.\",\n				},\n				arrivalLines = {\n					\"Right. Today's the day for a sticky bun, I can tell.\",\n					\"Here we are. Half for you, half for me, no arguments.\",\n					\"That's the smell. Worth the walk, every time.\",\n				},\n			},\n		},\n	},\n	{\n		-- Work. The one archetype you cannot meet before you have a life of your own,\n		-- which is what makes it the first evidence that adulthood has people in it.\n		id = \"coworker\",\n		placeId = \"office\",\n		minAge = 16,\n		maxAge = 999,\n		minAgeOffset = -3,\n		maxAgeOffset = 24,\n		minHeight = 0.94,\n		maxHeight = 1.07,\n		startingBond = 0,\n		busyLines = {\n			\"Snowed under. Grab me tomorrow?\",\n			\"On a deadline. Sorry -- honestly, sorry.\",\n			\"Not now. Ask me when this is off my desk.\",\n		},\n		offers = {\n			-- The relationship block, shared by every archetype so whoever you are talking\n			-- to can be talked to at any depth, driven apart, and mended. Written first\n			-- because the panel sorts by what a row asks of the bond and throws the tail\n			-- away: at the bottom of the range this is what somebody still has.\n			{\n				id = \"small_talk\",\n				label = \"Talk about nothing in particular\",\n				minAge = 5,\n				maxAge = 999,\n				minBond = ALWAYS,\n				bond = 1,\n				stats = { happiness = 2 },\n				lines = {\n					\"Water-cooler chat. That's the height of my ambition for the hour.\",\n					\"I could do with five minutes of not looking at my screen. Talk to me.\",\n					\"This is the best part of my day, and I know how sad that sounds.\",\n				},\n			},\n			{\n				id = \"snub\",\n				label = \"Snub them\",\n				minAge = 10,\n				maxAge = 999,\n				minBond = ALWAYS,\n				maxBond = -5,\n				bond = -5,\n				lines = {\n					\"Right. Keeping it professional, then. Fine.\",\n					\"Fine. I can take a hint.\",\n				},\n			},\n			{\n				id = \"cold_shoulder\",\n				label = \"Give them the cold shoulder\",\n				minAge = 10,\n				maxAge = 999,\n				minBond = ALWAYS,\n				maxBond = -5,\n				bond = -7,\n				lines = {\n					\"I'll just get on with my work, then.\",\n					\"Interesting. That's your answer, is it. Interesting.\",\n				},\n			},\n			{\n				id = \"make_right\",\n				label = \"Try to make it right\",\n				minAge = 10,\n				maxAge = 999,\n				minBond = ALWAYS,\n				maxBond = -1,\n				bond = 8,\n				ask = true,\n				lines = {\n					\"Alright. Water under the bridge. Just don't make a habit of it.\",\n				},\n				refusedLines = {\n					\"I'd rather we kept it at 'hello' for a bit.\",\n					\"Not yet. I'm still getting over it. Weirdly.\",\n				},\n			},\n			{\n				id = \"morning\",\n				label = \"Say morning\",\n				minAge = 16,\n				maxAge = 999,\n				minBond = ALWAYS,\n				bond = 2,\n				stats = { happiness = 1 },\n				lines = {\n					\"Morning. Is it Friday? It's not, is it.\",\n					\"Morning! You look how I feel.\",\n					\"Hello. Kettle's just gone on, if you're quick.\",\n				},\n			},\n			{\n				id = \"lunch\",\n				label = \"Take lunch with them\",\n				minAge = 16,\n				maxAge = 999,\n				minBond = ALWAYS,\n				bond = 4,\n				stats = { happiness = 2 },\n				lines = {\n					\"Out, not at the desk. I insist.\",\n					\"Same time tomorrow? Good.\",\n					\"That's the most I've laughed all week.\",\n				},\n			},\n			{\n				id = \"cover_work\",\n				label = \"Take some of their work\",\n				minAge = 18,\n				maxAge = 999,\n				minBond = 0,\n				bond = 6,\n				stats = { happiness = -2 },\n				lines = {\n					\"You didn't have to do that. I won't forget it.\",\n					\"Right -- I owe you. Properly owe you.\",\n					\"You've just given me my evening back.\",\n				},\n			},\n			{\n				id = \"vent\",\n				label = \"Complain about the place\",\n				minAge = 18,\n				maxAge = 999,\n				minBond = 20,\n				bond = 3,\n				stats = { happiness = 2 },\n				lines = {\n					\"Thank you. I thought it was just me.\",\n					\"Say that a bit louder, go on.\",\n					\"One day. One day we're both walking out.\",\n				},\n			},\n			{\n				id = \"swap_shift\",\n				label = \"Ask them to swap a shift\",\n				minAge = 18,\n				maxAge = 999,\n				minBond = 40,\n				bond = -1,\n				stats = { happiness = 2 },\n				ask = true,\n				lines = {\n					\"Go on. You'd do the same for me.\",\n					\"Fine, but I'm having your Friday.\",\n				},\n				refusedLines = {\n					\"I can't this week. Any other week.\",\n					\"Sorry. I've got something on I can't move.\",\n				},\n			},\n			{\n				id = \"tide_over\",\n				label = \"Ask them to tide you over\",\n				minAge = 20,\n				maxAge = 999,\n				minBond = 55,\n				bond = -2,\n				money = 250,\n				ask = true,\n				lines = {\n					\"Payday. Not before, not after.\",\n					\"Take it. And don't look like that about it.\",\n				},\n				refusedLines = {\n					\"I'd rather not mix that with this. Sorry.\",\n					\"I'm as skint as you are. Genuinely.\",\n				},\n			},\n			-- The ladder, and at work it is made of exactly one thing: whether any of it\n			-- survives outside the building. A colleague you have never seen in daylight\n			-- is a colleague, however many years of it there have been.\n			{\n				id = \"know_coworker\",\n				label = \"Learn who they actually are\",\n				minAge = 16,\n				maxAge = 999,\n				minBond = 10,\n				bond = 3,\n				stats = { happiness = 1 },\n				gives = \"known\",\n				lines = {\n					\"Two years sat there and you're the first to ask. Cheers.\",\n					\"That's me. Not very exciting, but that's me.\",\n					\"Right -- and now I've got to ask you back, haven't I.\",\n				},\n			},\n			{\n				id = \"out_of_building\",\n				label = \"Get out of the building with them\",\n				minAge = 17,\n				maxAge = 999,\n				minBond = 35,\n				bond = 6,\n				stats = { happiness = 3 },\n				needsTie = \"known\",\n				gives = \"friend\",\n				lines = {\n					\"See, this is better. Nobody's listening out here.\",\n					\"We should have been doing this the whole time.\",\n					\"Same tomorrow. I'm not eating at that desk again.\",\n				},\n			},\n			{\n				id = \"say_it_out_loud\",\n				label = \"Say what you actually think of this place\",\n				minAge = 19,\n				maxAge = 999,\n				minBond = 70,\n				bond = 8,\n				stats = { happiness = 4 },\n				needsTie = \"friend\",\n				gives = \"closest\",\n				lines = {\n					\"You could get us both sacked saying that. Say more.\",\n					\"I've thought it for years. I've never said it.\",\n					\"Whatever happens to this job -- we keep this, right?\",\n				},\n			},\n			{\n				-- A mentor is a chosen guide, not a parent. Offered by somebody older and\n				-- further along when the bond is deep enough that they will actually invest\n				-- in you. It sits above the friendship ladder because a life can hold both\n				-- a closest friend and a mentor — they are different kinds of significance.\n				id = \"learn_from\",\n				label = \"Ask them to teach you something\",\n				minAge = 16,\n				maxAge = 999,\n				minBond = 75,\n				bond = 5,\n				stats = { smarts = 2, happiness = 2 },\n				needsTie = \"friend\",\n				gives = \"mentor\",\n				lines = {\n					\"I've been where you are. I can show you the shortcuts.\",\n					\"Alright. But I won't go easy on you — that's not teaching.\",\n					\"First lesson: nobody owes you anything. Now let's get to work.\",\n				},\n			},\n			{\n				id = \"word_for_you\",\n				label = \"Have them put in a word for you\",\n				minAge = 19,\n				maxAge = 999,\n				minBond = 45,\n				bond = 2,\n				stats = { smarts = 2 },\n				money = 60,\n				needsTie = \"friend\",\n				lines = {\n					\"Already did it. Last week, before you asked.\",\n					\"I told them the truth about you. That's the good version.\",\n					\"They listen to me about one thing a year. I spent it.\",\n				},\n			},\n			{\n				id = \"walk_shop\",\n				label = \"Walk to the shop after work\",\n				minAge = 16,\n				maxAge = 999,\n				minBond = 30,\n				bond = 4,\n				ask = true,\n				walksTo = \"store\",\n				lines = {\n					\"Downstairs when you're done? I could do with the air.\",\n					\"Fancy a walk to the shop before the bus?\",\n					\"I'm going that way. Come and keep me company.\",\n				},\n				refusedLines = {\n					\"No worries. I'll see you tomorrow.\",\n					\"Alright. I'd better not keep you.\",\n					\"Another day then. The deadline's catching up with all of us.\",\n				},\n				arrivalLines = {\n					\"Here we are. Right, what are you after?\",\n					\"Shop's here. That walk fixed my head.\",\n					\"Made it. Get yourself something cold.\",\n				},\n			},\n			{\n				id = \"walk_gym\",\n				label = \"Walk to the gym after work\",\n				minAge = 18,\n				maxAge = 999,\n				minBond = 40,\n				bond = 4,\n				ask = true,\n				walksTo = \"gym\",\n				lines = {\n					\"I'm going down the gym. You look like you need the walk.\",\n					\"Same time as usual? You were good last week.\",\n					\"Come on. A few circuits and we've earned the evening.\",\n				},\n				refusedLines = {\n					\"No worries. I'll tell you what I did tomorrow.\",\n					\"Another time. I can barely lift my phone today.\",\n				},\n				arrivalLines = {\n					\"Here we are. Let's get it over with, together.\",\n					\"Made it. You've got the next set, go on.\",\n					\"That walk's half the workout. The other half's in there.\",\n				},\n			},\n		},\n	},\n	{\n		-- People roughly your own age, around town. Deliberately the vaguest of the five,\n		-- because that is what most of the people in a life are: not from school, not from\n		-- work, not related to you, and known anyway because you kept running into them.\n		id = \"local\",\n		placeId = \"store\",\n		minAge = 12,\n		maxAge = 999,\n		minAgeOffset = -2,\n		maxAgeOffset = 8,\n		minHeight = 0.94,\n		maxHeight = 1.06,\n		startingBond = 0,\n		busyLines = {\n			\"Can't stop -- I'm late for something.\",\n			\"Another time, yeah? Properly, though.\",\n			\"Not today. I'm no use to anyone today.\",\n		},\n		offers = {\n			-- The relationship block, shared by every archetype so whoever you are talking\n			-- to can be talked to at any depth, driven apart, and mended. Written first\n			-- because the panel sorts by what a row asks of the bond and throws the tail\n			-- away: at the bottom of the range this is what somebody still has.\n			{\n				id = \"small_talk\",\n				label = \"Talk about nothing in particular\",\n				minAge = 5,\n				maxAge = 999,\n				minBond = ALWAYS,\n				bond = 1,\n				stats = { happiness = 2 },\n				lines = {\n					\"Here we are again. Good to see you out.\",\n					\"No plans, nowhere to be. Perfect time to talk.\",\n					\"I was hoping I'd catch you. I mean that.\",\n				},\n			},\n			{\n				id = \"snub\",\n				label = \"Snub them\",\n				minAge = 10,\n				maxAge = 999,\n				minBond = ALWAYS,\n				maxBond = -5,\n				bond = -5,\n				lines = {\n					\"Oh. I thought we were past that. Clearly not.\",\n					\"Right. I'll take that as a sign, then.\",\n				},\n			},\n			{\n				id = \"cold_shoulder\",\n				label = \"Give them the cold shoulder\",\n				minAge = 10,\n				maxAge = 999,\n				minBond = ALWAYS,\n				maxBond = -5,\n				bond = -7,\n				lines = {\n					\"We'll make this brief, then.\",\n					\"I see. Well. I'll be going.\",\n				},\n			},\n			{\n				id = \"make_right\",\n				label = \"Try to make it right\",\n				minAge = 10,\n				maxAge = 999,\n				minBond = ALWAYS,\n				maxBond = -1,\n				bond = 8,\n				ask = true,\n				lines = {\n					\"Thank you for saying that. I'd rather not lose you over it.\",\n				},\n				refusedLines = {\n					\"Give me a bit. I need to think about it.\",\n					\"I'm not ready yet. Ask me another time.\",\n				},\n			},\n			{\n				id = \"chat\",\n				label = \"Stop and talk\",\n				minAge = 12,\n				maxAge = 999,\n				minBond = ALWAYS,\n				bond = 3,\n				stats = { happiness = 1 },\n				lines = {\n					\"I was hoping I'd run into someone.\",\n					\"Look at you. How long has it been?\",\n					\"Five minutes. Then I really do have to go.\",\n				},\n			},\n			{\n				id = \"walk_with\",\n				label = \"Walk part of the way with them\",\n				minAge = 12,\n				maxAge = 999,\n				minBond = ALWAYS,\n				bond = 4,\n				ask = true,\n				walksTo = \"home\",\n				lines = {\n					\"Go on then, I'll go the long way with you.\",\n					\"This is nicer than the bus, I'll give you that.\",\n					\"Right -- this is me. That was good, that.\",\n				},\n				refusedLines = {\n					\"Fair enough. Take care of yourself.\",\n					\"Alright, I'll see you around.\",\n					\"Another time. I've got to run an errand.\",\n				},\n				arrivalLines = {\n					\"Here we are, then. Your doorstep.\",\n					\"That's the front path. Look after yourself.\",\n					\"Home sweet home. I'll be in the shop if you need me.\",\n				},\n			},\n			{\n				id = \"walk_garage\",\n				label = \"Walk to the garage with them\",\n				minAge = 16,\n				maxAge = 999,\n				minBond = 30,\n				bond = 4,\n				ask = true,\n				walksTo = \"garage\",\n				lines = {\n					\"I've got to pick something up from the garage. Walk with me?\",\n					\"They said it'd be ready today. Come see it before I do.\",\n					\"Help me carry? There's a box involved. There's always a box.\",\n				},\n				refusedLines = {\n					\"Alright. It's just a box anyway.\",\n					\"Another time. I'm waiting on a phone call.\",\n				},\n				arrivalLines = {\n					\"Here we are. Right -- the box. You're not getting out of it.\",\n					\"That's him. Morning. -- See? Exactly as exciting as I said.\",\n					\"We're here. Thanks for the company. Better than doing it alone.\",\n				},\n			},\n			{\n				id = \"favour\",\n				label = \"Do them a favour\",\n				minAge = 14,\n				maxAge = 999,\n				minBond = 0,\n				bond = 6,\n				stats = { happiness = -1 },\n				lines = {\n					\"You are a lifesaver. An actual lifesaver.\",\n					\"I'll pay you back in kind. Watch me.\",\n					\"Nobody else said yes, you know.\",\n				},\n			},\n			{\n				id = \"confide\",\n				label = \"Tell them how it is going\",\n				minAge = 18,\n				maxAge = 999,\n				minBond = 35,\n				bond = 5,\n				stats = { happiness = 3 },\n				lines = {\n					\"That sounds hard. I mean it, that sounds hard.\",\n					\"You don't have to be fine about it with me.\",\n					\"Well I'm glad you told someone. Even me.\",\n				},\n			},\n			{\n				id = \"borrow\",\n				label = \"Ask to borrow something\",\n				minAge = 16,\n				maxAge = 999,\n				minBond = 45,\n				bond = -1,\n				money = 90,\n				ask = true,\n				lines = {\n					\"Keep it as long as you need.\",\n					\"Sure. Bring it back in one piece.\",\n				},\n				refusedLines = {\n					\"Ah -- I'd rather not. It's a bit of a thing.\",\n					\"Not that one. Sorry. Ask me another time.\",\n				},\n			},\n			-- The ladder, and here it is made of nothing in particular, which is the\n			-- honest version for this archetype: there is no shared desk and no shared\n			-- classroom, so the only thing holding it together is that both of you kept\n			-- turning up. That makes it the hardest of the five to climb by accident and\n			-- the most deliberate when it happens.\n			{\n				id = \"know_local\",\n				label = \"Swap names properly\",\n				minAge = 12,\n				maxAge = 999,\n				minBond = 10,\n				bond = 3,\n				stats = { happiness = 1 },\n				gives = \"known\",\n				lines = {\n					\"Ha -- we've been nodding at each other for months.\",\n					\"Good. I was going to have to guess eventually.\",\n					\"Now I have to actually say hello. Thanks for that.\",\n				},\n			},\n			{\n				id = \"make_a_plan\",\n				label = \"Make an actual plan with them\",\n				minAge = 14,\n				maxAge = 999,\n				minBond = 35,\n				bond = 6,\n				stats = { happiness = 3 },\n				needsTie = \"known\",\n				gives = \"friend\",\n				lines = {\n					\"A time and a place. Look at us, like proper people.\",\n					\"I'll be there. I'm never there, but I'll be there.\",\n					\"Bumping into each other was fine. This is better.\",\n				},\n			},\n			{\n				id = \"kept_turning_up\",\n				label = \"Still be there years later\",\n				minAge = 22,\n				maxAge = 999,\n				minBond = 70,\n				bond = 8,\n				stats = { happiness = 4 },\n				needsTie = \"friend\",\n				gives = \"closest\",\n				lines = {\n					\"Everyone else drifted. You didn't. I noticed.\",\n					\"We had no reason to keep this going. We kept it going.\",\n					\"You're the one I'd call. That's all I'm saying.\",\n				},\n			},\n			{\n				id = \"turn_up_for_you\",\n				label = \"Have them turn up for you\",\n				minAge = 16,\n				maxAge = 999,\n				minBond = 45,\n				bond = 4,\n				stats = { happiness = 4, health = 1 },\n				needsTie = \"friend\",\n				lines = {\n					\"You didn't even have to ask. I heard, so I came.\",\n					\"I'm not going anywhere today. Put the kettle on.\",\n					\"Whatever it is. I'm here for whatever it is.\",\n				},\n			},\n		},\n	},\n	-- People your own age, in adult life.\n	--\n	-- This archetype exists because the world had a hole in it that only shows up when you\n	-- go looking for somebody to build a life with. Count the age offsets on the five\n	-- above: the two that are genuinely your own age -- `street` and `classmate` -- both\n	-- **end at seventeen**. After that the town is people fourteen to forty-eight years\n	-- older, plus whichever coworker or local happened to roll a small number.\n	--\n	-- So adult life had no guaranteed peers at all. Not \"few\" -- none guaranteed, and how\n	-- many you got was a property of one fixed seed rather than of anything the player did.\n	-- A life meant to be built around a closest friend could hand one player six candidates\n	-- and another none, and neither would ever be told why. That is not difficulty, it is a\n	-- world that quietly differs from the one the rules describe.\n	--\n	-- Sixteen rather than eighteen because that is when the rest of adult life opens here --\n	-- `coworker` starts at sixteen and so do jobs -- and a peer who arrives two years after\n	-- your first job is a peer who missed the part where you needed one.\n	--\n	-- At the store rather than the office, deliberately. `coworker` already owns \"people you\n	-- know because you are both paid to be there\", and that comes with a reason to talk\n	-- built in. These are people you know for no reason except that you keep being in the\n	-- same places, which is where most adult friendships actually come from.\n	{\n		id = \"peer\",\n		placeId = \"store\",\n		minAge = 16,\n		maxAge = 999,\n		-- The tightest span of any archetype, because \"my own age\" is the entire point and\n		-- a spread of eight would put a thirty-year-old in the pool at twenty-two.\n		minAgeOffset = -2,\n		maxAgeOffset = 2,\n		minHeight = 0.94,\n		maxHeight = 1.07,\n		startingBond = 0,\n		busyLines = {\n			\"Can't stop -- I'm late for the thing I'm always late for.\",\n			\"Not now, sorry. Ask me when I look less like this.\",\n			\"Rain check. I've got about four minutes and no brain.\",\n		},\n		offers = {\n			-- The relationship block, shared by every archetype so whoever you are talking\n			-- to can be talked to at any depth, driven apart, and mended. Written first\n			-- because the panel sorts by what a row asks of the bond and throws the tail\n			-- away: at the bottom of the range this is what somebody still has.\n			{\n				id = \"small_talk\",\n				label = \"Talk about nothing in particular\",\n				minAge = 5,\n				maxAge = 999,\n				minBond = ALWAYS,\n				bond = 1,\n				stats = { happiness = 2 },\n				lines = {\n					\"No agenda. Just catching up. That's allowed, right?\",\n					\"Say something interesting so I can tell people I have plans.\",\n					\"Good to run into you. I mean it, that's not a reflex.\",\n				},\n			},\n			{\n				id = \"snub\",\n				label = \"Snub them\",\n				minAge = 10,\n				maxAge = 999,\n				minBond = ALWAYS,\n				maxBond = -5,\n				bond = -5,\n				lines = {\n					\"Okay. I'll take that as the whole conversation.\",\n					\"Right, well. I know when I'm not wanted.\",\n				},\n			},\n			{\n				id = \"cold_shoulder\",\n				label = \"Give them the cold shoulder\",\n				minAge = 10,\n				maxAge = 999,\n				minBond = ALWAYS,\n				maxBond = -5,\n				bond = -7,\n				lines = {\n					\"I'm not doing this with you today.\",\n					\"Yeah. I saw you. I saw you see me.\",\n				},\n			},\n			{\n				id = \"make_right\",\n				label = \"Try to make it right\",\n				minAge = 10,\n				maxAge = 999,\n				minBond = ALWAYS,\n				maxBond = -1,\n				bond = 8,\n				ask = true,\n				lines = {\n					\"That means something. I'm glad you said it.\",\n				},\n				refusedLines = {\n					\"I'm not there yet. Don't rush it.\",\n					\"You can't just say one thing and have it be fine.\",\n				},\n			},\n			{\n				id = \"peer_hello\",\n				label = \"Say hello\",\n				minAge = 16,\n				maxAge = 999,\n				minBond = ALWAYS,\n				bond = 3,\n				stats = { happiness = 1 },\n				lines = {\n					\"Oh -- hello. I know you from somewhere, don't I?\",\n					\"Hey. You're always in here, same as me.\",\n					\"Hello, stranger. Sort of stranger.\",\n				},\n			},\n			{\n				id = \"peer_moan\",\n				label = \"Complain about the same things\",\n				minAge = 16,\n				maxAge = 999,\n				minBond = ALWAYS,\n				bond = 4,\n				stats = { happiness = 2 },\n				lines = {\n					\"Right? RIGHT? Nobody else our age thinks it's mad.\",\n					\"Oh, thank God. I thought it was just me.\",\n					\"We should be allowed to complain professionally.\",\n				},\n			},\n			{\n				id = \"peer_go_along\",\n				label = \"Go along to something with them\",\n				minAge = 17,\n				maxAge = 999,\n				minBond = 15,\n				bond = 6,\n				stats = { happiness = 3 },\n				lines = {\n					\"Come. Say yes now, before you think about it.\",\n					\"You'll like it. And if you don't, we'll leave.\",\n					\"See, this is better than whatever you had on.\",\n				},\n			},\n			{\n				id = \"peer_late\",\n				label = \"Stay out later than you meant to\",\n				minAge = 18,\n				maxAge = 999,\n				minBond = 30,\n				bond = 6,\n				stats = { happiness = 4, health = -2 },\n				lines = {\n					\"One more. One. I have said that before, I know.\",\n					\"It's not even late. It's early. That's different.\",\n					\"We're going to regret this and I don't care.\",\n				},\n			},\n			{\n				id = \"peer_advice\",\n				label = \"Ask what they would do\",\n				minAge = 18,\n				maxAge = 999,\n				minBond = 35,\n				bond = 5,\n				stats = { happiness = 2, smarts = 1 },\n				lines = {\n					\"Honestly? I'd do the thing that scares you more.\",\n					\"No idea. But I'd start by telling someone.\",\n					\"Ask me again in ten years and I'll still guess.\",\n				},\n			},\n			-- The ladder. Made of the same stuff as `local`'s -- nothing holding it together but\n			-- both of you turning up -- but it climbs earlier, because these are the people a\n			-- life actually gets built with, and a rung you cannot reach until twenty-two puts\n			-- the whole of early adulthood out of reach of it.\n			{\n				id = \"know_peer\",\n				label = \"Finally ask their name\",\n				minAge = 16,\n				maxAge = 999,\n				minBond = 10,\n				bond = 3,\n				stats = { happiness = 1 },\n				gives = \"known\",\n				lines = {\n					\"I'm glad you said. I'd got too far in to ask.\",\n					\"Right, now we're obliged to acknowledge each other.\",\n					\"Names. Very grown up of us.\",\n				},\n			},\n			{\n				id = \"peer_friends\",\n				label = \"Ask them to be friends properly\",\n				minAge = 17,\n				maxAge = 999,\n				minBond = 30,\n				bond = 6,\n				stats = { happiness = 3 },\n				needsTie = \"known\",\n				gives = \"friend\",\n				lines = {\n					\"Yes. Obviously yes. Was that hard to say?\",\n					\"I already told people you were. Bit awkward otherwise.\",\n					\"Good. I've got a shortage and you'll do nicely.\",\n				},\n			},\n			{\n				id = \"peer_closest\",\n				label = \"Tell them they're the one you'd call\",\n				minAge = 19,\n				maxAge = 999,\n				minBond = 65,\n				bond = 8,\n				stats = { happiness = 4 },\n				needsTie = \"friend\",\n				gives = \"closest\",\n				lines = {\n					\"Then call me. Any hour. I mean the bad hours too.\",\n					\"You're mine as well. I thought that was established.\",\n					\"Don't make it weird. But -- yeah. Same.\",\n				},\n			},\n			{\n				-- A rival is not the absence of a relationship. It is a relationship that\n				-- turned sharp: somebody you pushed past, outdid, or crossed, and who\n				-- respects you enough to chase you for it. Capped at one because a life\n				-- only has room for one person who means this much in this direction.\n				id = \"become_rivals\",\n				label = \"Make them your rival\",\n				minAge = 12,\n				maxAge = 999,\n				minBond = ALWAYS,\n				maxBond = -1,\n				bond = 5,\n				stats = { happiness = -2 },\n				gives = \"rival\",\n				lines = {\n					\"Fine. You want it this way? I'm not letting you forget it.\",\n					\"You think you're better than me? Prove it. Every time.\",\n					\"Done. Next time we meet, I'm not going easy on you.\",\n				},\n			},\n			{\n				-- An enemy is not the absence of a relationship. It is the relationship\n				-- that remains when the ladder has been burned: somebody you betrayed,\n				-- destroyed, or crossed so deeply that respect is gone and only the\n				-- memory of what was lost remains. Capped at one because a life only has\n				-- room for one person who means this much in this direction. Gated on\n				-- the deepest negative bond (MinBond = -20) so it only appears when the\n				-- relationship has been actively destroyed, not merely cooled. It gives\n				-- no bond gain -- making an enemy is a choice that costs you the\n				-- relationship entirely, and the bond stays at the floor.\n				id = \"become_enemies\",\n				label = \"Make them your enemy\",\n				minAge = 14,\n				maxAge = 999,\n				minBond = ALWAYS,\n				maxBond = -20,\n				bond = 0,\n				stats = { happiness = -10 },\n				gives = \"enemy\",\n				ask = true,\n				lines = {\n					\"You think this is over? It isn't. I will remember this forever.\",\n					\"We are done. Not rivals -- enemies. There is no coming back.\",\n					\"Go. But know that every time our paths cross, I will be there.\",\n				},\n				refusedLines = {\n					\"You're not worth it. Get out of my sight.\",\n					\"Fine. Stay. It changes nothing.\",\n					\"I don't need your permission to hate you.\",\n				},\n			},\n			{\n				-- A rival is not the absence of a relationship. It is a relationship that\n				-- turned sharp, and the only way back is through it. This row is gated on\n				-- the rival tie specifically so it does not appear for somebody you have\n				-- merely slighted -- only when the rivalry is already set in stone.\n				id = \"repair_rival\",\n				label = \"Tell them you owe them an apology\",\n				minAge = 12,\n				maxAge = 999,\n				minBond = ALWAYS,\n				maxBond = -1,\n				bond = 10,\n				ask = true,\n				needsTie = \"rival\",\n				lines = {\n					\"You were right. I was wrong. I shouldn't have done that.\",\n					\"I've been thinking about it. I crossed a line and I'm sorry.\",\n					\"This doesn't have to be how it is. I want to fix it.\",\n				},\n				refusedLines = {\n					\"Sorry doesn't undo it. Show me you mean it.\",\n					\"You think words fix this? They don't.\",\n					\"Save it. I'm not ready to hear it.\",\n				},\n			},\n			{\n				-- A sibling is chosen, not given. Offered at the very top of the ladder\n				-- when the bond is past closest and the player is old enough to mean it.\n				-- The tie is the last rung in this archetype: after this there is nothing\n				-- higher to offer and the relationship stands on what it is rather than\n				-- what it could become.\n				id = \"chosen_sibling\",\n				label = \"Make them your sibling\",\n				minAge = 16,\n				maxAge = 999,\n				minBond = 85,\n				bond = 6,\n				stats = { happiness = 5 },\n				needsTie = \"closest\",\n				gives = \"sibling\",\n				lines = {\n					\"We don't have to be related to be family. I choose you.\",\n					\"Blood doesn't make this. Showing up does. I'm showing up.\",\n					\"Then it's settled. You're stuck with me now.\",\n				},\n			},\n			{\n				id = \"peer_carry\",\n				label = \"Let them carry you through a bad stretch\",\n				minAge = 18,\n				maxAge = 999,\n				minBond = 45,\n				bond = 4,\n				stats = { happiness = 4, health = 1 },\n				needsTie = \"friend\",\n				lines = {\n					\"You'd do it for me. You have done it for me.\",\n					\"I'm not keeping score. I'm just not going anywhere.\",\n					\"Sit down. I'll deal with the rest of it.\",\n				},\n			},\n			{\n				id = \"walk_work\",\n				label = \"Walk to work together\",\n				minAge = 16,\n				maxAge = 999,\n				minBond = 25,\n				bond = 4,\n				ask = true,\n				walksTo = \"work\",\n				lines = {\n					\"Same shift? Walk over together, save the air.\",\n					\"I'll come by yours and we can go in together.\",\n					\"You heading in? I'll walk with you.\",\n				},\n				refusedLines = {\n					\"Alright, I'll see you inside.\",\n					\"No worries. Don't want to be late.\",\n					\"Another day. I've got to drop something off first.\",\n				},\n				arrivalLines = {\n					\"Here we are. Work. The least good part of the day.\",\n					\"Made it. Ready to earn our keep?\",\n					\"Right, we're here. One of us has to make the tea.\",\n				},\n			},\n			{\n				id = \"walk_clinic\",\n				label = \"Walk to the clinic with them\",\n				minAge = 16,\n				maxAge = 999,\n				minBond = 35,\n				bond = 4,\n				ask = true,\n				walksTo = \"clinic\",\n				lines = {\n					\"I'm going to see someone at the clinic. I don't want to go in alone.\",\n					\"They've asked me in for the results. Walk with me? I'll be fine, but --\",\n					\"I've got an appointment. Company would help. It's just the walk there.\",\n				},\n				refusedLines = {\n					\"Alright. I'll be fine. Thanks anyway.\",\n					\"Another time. I've got to run an errand first.\",\n				},\n				arrivalLines = {\n					\"Here we are. Thanks for coming with me. I'll see you after.\",\n					\"That's the door. I'll be out before you know it.\",\n					\"Right. I'm going in. -- It was good of you to come.\",\n				},\n			},\n		},\n	},\n	{\n		-- People who hang out in the financial district. Bank tellers, office runners,\n		-- the sort of person you pass every day on the walk to town and learn to\n		-- recognise by their coat rather than their face.\n		id = \"city_worker\",\n		placeId = \"bank\",\n		minAge = 16,\n		maxAge = 999,\n		minAgeOffset = -2,\n		maxAgeOffset = 20,\n		minHeight = 0.94,\n		maxHeight = 1.07,\n		startingBond = 0,\n		busyLines = {\n			\"Lunch break's over. Catch me later?\",\n			\"Running late already. I'll find you tomorrow.\",\n			\"Not now -- the manager's watching. Sorry.\",\n		},\n		offers = {\n			{\n				id = \"small_talk\",\n				label = \"Talk about nothing in particular\",\n				minAge = 5,\n				maxAge = 999,\n				minBond = ALWAYS,\n				bond = 1,\n				stats = { happiness = 2 },\n				lines = {\n					\"Staring out the window. The best part of the shift.\",\n					\"Same as always. You?\",\n					\"Tell me something good. I've had a morning of forms.\",\n				},\n			},\n			{\n				id = \"snub\",\n				label = \"Snub them\",\n				minAge = 10,\n				maxAge = 999,\n				minBond = ALWAYS,\n				maxBond = -5,\n				bond = -5,\n				lines = {\n					\"Okay. I'll just go back to the desk.\",\n					\"Right. Suit yourself.\",\n				},\n			},\n			{\n				id = \"cold_shoulder\",\n				label = \"Give them the cold shoulder\",\n				minAge = 10,\n				maxAge = 999,\n				minBond = ALWAYS,\n				maxBond = -5,\n				bond = -7,\n				lines = {\n					\"I'll pretend I didn't see that.\",\n					\"Fine. I was going to ask you anyway.\",\n				},\n			},\n			{\n				id = \"make_right\",\n				label = \"Try to make it right\",\n				minAge = 10,\n				maxAge = 999,\n				minBond = ALWAYS,\n				maxBond = -1,\n				bond = 8,\n				ask = true,\n				lines = {\n					\"Thanks. I was going to pretend it didn't happen, but -- thank you.\",\n				},\n				refusedLines = {\n					\"I need a bit. Just -- tomorrow?\",\n					\"Not today. I'm still working through it.\",\n				},\n			},\n			{\n				id = \"coffee_break\",\n				label = \"Take a coffee break with them\",\n				minAge = 14,\n				maxAge = 999,\n				minBond = ALWAYS,\n				bond = 3,\n				stats = { happiness = 2 },\n				lines = {\n					\"Ten minutes. If the manager sees us I'm blaming you.\",\n					\"I know a place around the corner. Cheap coffee, good pie.\",\n					\"You look like you need a break. I do too.\",\n				},\n			},\n			{\n				id = \"walk_restaurant\",\n				label = \"Walk to the restaurant with them\",\n				minAge = 16,\n				maxAge = 999,\n				minBond = 25,\n				bond = 4,\n				ask = true,\n				walksTo = \"restaurant\",\n				lines = {\n					\"I'm dying for a proper meal. Walk with me?\",\n					\"There's a place near the office I like. Come on.\",\n					\"My treat. You've earned it this week.\",\n				},\n				refusedLines = {\n					\"Alright. Another time then.\",\n					\"Suit yourself. I'll save you a seat.\",\n				},\n				arrivalLines = {\n					\"Here we are. Right -- what are you having?\",\n					\"Made it. Table for two? Or should I go sit at the bar?\",\n					\"This place never lets me down. Same for you?\",\n				},\n			},\n			{\n				id = \"walk_cafe\",\n				label = \"Walk to the cafe with them\",\n				minAge = 14,\n				maxAge = 999,\n				minBond = 20,\n				bond = 3,\n				ask = true,\n				walksTo = \"cafe\",\n				lines = {\n					\"I need caffeine. Walk with me to the cafe?\",\n					\"Let's get out of the building for ten