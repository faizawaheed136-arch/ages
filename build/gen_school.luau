AGES_SOURCES["src/server/services/SceneService.luau"] = "--!strict\n-- The thing the event is about, actually there. When an event names a subject,\n-- this finds it somewhere to stand, walks it in as the prompt opens, keeps it\n-- facing the player while the question is open, plays out its answer to whatever\n-- the player chose, and takes it away afterwards.\n--\n-- It exists because of a specific hole. \"There is a dog. It is at least as tall\n-- as you are, and it has noticed you\" was a sentence about an animal that did not\n-- exist, and enactment made that worse rather than better: a card at least keeps\n-- the fiction in one place, whereas a marker on the floor reading \"Put your hand\n-- out\" points at nothing at all. The subject is what the marker is for.\n--\n-- The same argument runs one step further and is why reactions are here too. \"It\n-- shoved its whole head under your palm\" and \"you held still until it lost\n-- interest\" are two different things happening in a room, and an animal that\n-- stands there identically under both of them is telling the player that their\n-- answer did not matter -- in the one medium, the room itself, where the game had\n-- just finished insisting that it did.\n--\n-- Deliberately independent of both other axes. Delivery decides how the event\n-- reached you and resolution decides how you answer it; a subject is what it is\n-- *about*, and the dog turns up whether the event arrived on a birthday or off a\n-- doormat, and whether you answer it on a panel or by walking. Nothing here reads\n-- either field.\n--\n-- Best-effort in exactly the sense EnactService is. A room with nowhere to put\n-- the animal is an ordinary outcome, not an error: the event plays as it did\n-- before subjects existed. And unlike a choice marker, a subject is never\n-- interactive -- it cannot be walked onto, cannot be collided with and answers no\n-- probes -- so it can never be the reason a prompt cannot be answered.\n--\n-- Travel is a route rather than a Humanoid walk, which is the one place this is\n-- knowingly simpler than NPCService. A visitor is a real R15 avatar and MoveTo is\n-- the right tool for one; a subject may be any shape at all, and a hand-built\n-- Humanoid rig would be fragile in exactly the ways that do not matter here --\n-- nothing ever pushes the dog, and nothing ever needs it to fall over. The route\n-- is checked against the same probes a walk would have had to satisfy.\n--\n-- What the animal *does* along that route is SubjectMotion's, and the split is\n-- the point: this file decides where the feet are each frame and how far they\n-- have come, and knows nothing about legs. That is also what makes a bought model\n-- a drop-in -- its own walk clip plays along the same route through the same\n-- interface, and nothing here can tell the difference.\n\nlocal Players = game:GetService(\"Players\")\nlocal RunService = game:GetService(\"RunService\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Config = require(ReplicatedStorage:WaitForChild(\"Config\"))\nlocal Types = require(ReplicatedStorage:WaitForChild(\"Types\"))\nlocal Lives = require(ReplicatedStorage:WaitForChild(\"Lives\"))\n\nlocal DataService = require(script.Parent.DataService)\nlocal EventService = require(script.Parent.EventService)\nlocal Ground = require(script.Parent.Parent.world.Ground)\nlocal SubjectModels = require(script.Parent.Parent.world.SubjectModels)\nlocal SubjectMotion = require(script.Parent.Parent.world.SubjectMotion)\nlocal Subjects = require(script.Parent.Parent.content.Subjects)\n\ntype LifeEvent = Types.LifeEvent\ntype EventChoice = Types.EventChoice\ntype ChoiceReaction = Types.ChoiceReaction\ntype SceneSubject = Types.SceneSubject\ntype SubjectRig = SubjectModels.SubjectRig\ntype Motion = SubjectMotion.Motion\n\nlocal SceneService = {}\n\n-- One folder for every subject in play, so a leak shows up as a fat folder in the\n-- explorer rather than as animals scattered through the house.\nlocal SCENE_FOLDER = \"AgesScene\"\n\n-- Below this a direction is noise rather than a heading -- a player looking\n-- straight down, or a travel vector between two points on top of each other.\nlocal MIN_DIRECTION = 1e-3\n\n-- How close a turn on the spot has to get before it counts as finished, and the\n-- longest it is allowed to spend getting there. Cosmetic, and therefore local\n-- rather than Config on the rule the rest of this feature follows: nobody balances\n-- this game by adjusting how sharply a dog comes round.\n--\n-- Both are needed and neither is arbitrary. The easing is exponential and so never\n-- actually arrives, and the walk that follows a turn has to start exactly aligned\n-- or the animal crabs sideways forever; the cap bounds the loop whatever\n-- TurnResponsiveness has been tuned to, including zero.\nlocal TURN_DONE_DEGREES = 3\nlocal MAX_TURN_SECONDS = 2\n\ntype Active = {\n	eventId: string,\n	subject: SceneSubject,\n	rig: SubjectRig,\n	motion: Motion,\n	-- What the answer turned out to be, filled in by onAnswered at the moment the\n	-- player chooses. Nil until then, and nil forever for an event whose choices\n	-- carry no reactions -- which is most of them, and which is the behaviour this\n	-- had before reactions existed: hold while the outcome is read, then leave.\n	reaction: ChoiceReaction?,\n	-- Whether an answer has landed at all, which nil above cannot say by itself.\n	-- Nothing in play reads this; it is for the Studio harness, where \"the event has\n	-- not been answered yet\" and \"it was answered by a choice the content gives no\n	-- reaction to\" are the same animal standing in the same room and completely\n	-- different things to go and fix.\n	answered: boolean,\n	-- Where it came in from, which is also where it leaves by, so an exit is the\n	-- entrance run backwards rather than a second piece of routing.\n	spawnAt: Vector3,\n	stopAt: Vector3,\n	-- Ground covered since the scene began, which is what the gait is keyed to.\n	-- Accumulated rather than recomputed from the endpoints, because it has to\n	-- carry across the walk in, the wait and the walk out as one continuous number\n	-- -- a stride that restarted at each leg of the journey would plant the feet\n	-- differently every time.\n	traveled: number,\n	-- os.clock() when the scene began. Everything that happens while the animal is\n	-- standing still is keyed to this, since there is no distance to key off.\n	startedAt: number,\n	-- Set by stop(); every loop below checks it. A scene owns a running coroutine\n	-- and a model, and this is the one thing that ends both.\n	cancelled: boolean,\n}\n\nlocal active: { [Player]: Active } = {}\n\n-- Why the last event that opened did or didn't put something in the room, for the\n-- Studio harness alone. Nothing here is an error and nothing is logged, but \"no\n-- subject\" has half a dozen causes that look identical from inside the game --\n-- the event named none, the room was too tight, scenes are switched off -- and a\n-- harness that cannot tell them apart is a harness that gets ignored.\nlocal lastReason: { [Player]: string } = {}\n\n-- Debug switch for the Studio harness, never touched in a live server. Off means\n-- events play as text again, which is also the state to put the game in while\n-- testing something that has nothing to do with subjects.\nlocal enabled = true\n\nlocal function sceneFolder(): Folder\n	local existing = workspace:FindFirstChild(SCENE_FOLDER)\n	if existing ~= nil then\n		return existing :: Folder\n	end\n	local folder = Instance.new(\"Folder\")\n	folder.Name = SCENE_FOLDER\n	folder.Parent = workspace\n	return folder\nend\n\n-- Ends a scene immediately and without ceremony. Everything that has a graceful\n-- ending goes through the tail of run() instead; this is what the abrupt endings\n-- share -- a death, a new event, a player leaving.\nlocal function stop(player: Player)\n	local current = active[player]\n	if current == nil then\n		return\n	end\n	active[player] = nil\n	current.cancelled = true\n	-- Before the model goes, because an adopted model's motion holds animation\n	-- tracks loaded off it and stopping them afterwards would be stopping tracks on\n	-- an Animator that no longer has a parent.\n	current.motion.stop()\n	current.rig.model:Destroy()\nend\n\n-- Ends a scene from inside its own coroutine, and only if it is still the one in\n-- play. run() reaches its tail across yields, and by then a second event may have\n-- superseded it and started a scene of its own -- clearing by player alone would\n-- take that newer one down instead of this finished one.\nlocal function finish(player: Player, current: Active)\n	if active[player] ~= current then\n		return\n	end\n	stop(player)\nend\n\n-- Collected first rather than cleared during the traversal: stop() removes the\n-- key it would be standing on, and adding or removing keys mid-pairs is undefined.\nlocal function stopAll()\n	local players: { Player } = {}\n	for player in active do\n		table.insert(players, player)\n	end\n	for _, player in players do\n		stop(player)\n	end\nend\n\n-- Flattened onto the floor plane. Everything here is arranged on the ground, and\n-- a player looking at their feet or up the stairs must not tip the arrangement\n-- over -- the same reasoning, and the same guard, as EnactService's fan.\nlocal function flatten(direction: Vector3): Vector3?\n	local flat = Vector3.new(direction.X, 0, direction.Z)\n	if flat.Magnitude < MIN_DIRECTION then\n		return nil\n	end\n	return flat.Unit\nend\n\ntype Placement = { spawnAt: Vector3, stopAt: Vector3 }\n\n-- Where the subject comes to rest and where it comes in from, or nil if this\n-- walk-in length cannot be fitted anywhere in the arc.\n--\n-- Four questions per bearing, and each one is a failure that has been seen: the\n-- resting place needs a floor under it and room for the animal on it, the player\n-- has to be able to see it -- an animal behind a wall is not in the room -- and\n-- the way in has to be clear, or the dog arrives through the couch.\nlocal function place(character: Model, subject: SceneSubject, walkIn: number): Placement?\n	local pivot = character:GetPivot()\n	local origin = pivot.Position\n	local forward = flatten(pivot.LookVector)\n	if forward == nil then\n		return nil\n	end\n\n	local playerHeight = Ground.BodyHeight(character)\n	-- The animal's footprint is its own, not the player's: a dog is longer than it\n	-- is tall and a cat fits places a dog does not.\n	local subjectRadius = math.max(subject.bodyLength, subject.bodyWidth) / 2\n	local subjectHeight = subject.shoulderHeight\n	local ignore = Ground.IgnoreList()\n\n	-- ApproachStuds is clearance past arm's reach, and clearance is measured to the\n	-- animal's near edge rather than to its middle -- otherwise half a dog is already\n	-- inside clicking range while a cat leaves a gap, which is backwards. Adding its\n	-- own half-length here is what makes one Config number correct for both.\n	local restAt = Config.Scene.ApproachStuds + subject.bodyLength / 2\n\n	for _, angle in Ground.Bearings(Config.Scene.ArcDegrees, Config.Scene.Bearings) do\n		local direction = CFrame.Angles(0, math.rad(angle), 0) * forward\n\n		-- Two spots per bearing rather than one, which is why this stays a loop of its\n		-- own: the animal has to be able to walk from where it appears to where it\n		-- stops, so the pair either works together or neither of them counts.\n		--\n		-- The stop first and with no reachability of its own, because the line that\n		-- matters to it is the player's, and that is measured separately below at the\n		-- player's height rather than the animal's.\n		local stopGround = Ground.SpotAt(origin + direction * restAt, subjectRadius, subjectHeight, ignore)\n		if stopGround == nil then\n			continue\n		end\n		-- The walk-in, checked against the stop it has to reach.\n		local spawnGround =\n			Ground.SpotAt(origin + direction * (restAt + walkIn), subjectRadius, subjectHeight, ignore, stopGround)\n		if spawnGround == nil then\n			continue\n		end\n		-- Measured at the player's height rather than the animal's, because the\n		-- question this one asks is whether the *player* has a clear line to it.\n		if not Ground.Reachable(origin, stopGround, playerHeight, ignore) then\n			continue\n		end\n\n		return { spawnAt = spawnGround, stopAt = stopGround }\n	end\n\n	return nil\nend\n\n-- Turns CFrame.Angles' Y rotation into \"facing this way\", so every placement\n-- below is written in headings rather than in axes. For a Y rotation of theta the\n-- look direction is (-sin, 0, -cos), so the heading that points along `direction`\n-- is atan2 of its negation.\nlocal function headingTo(direction: Vector3): number\n	return math.atan2(-direction.X, -direction.Z)\nend\n\n-- A floor point and a facing, which is the only kind of frame anything here deals\n-- in. Ground level rather than hip level: whatever the rig needs adding to reach\n-- its own root is the rig's business and is added inside the motion.\nlocal function poseAt(at: Vector3, heading: number): CFrame\n	return CFrame.new(at) * CFrame.Angles(0, heading, 0)\nend\n\n-- Hands one frame to the motion. Every caller goes through this rather than\n-- building a Pose inline, so \"which fields does a frame need\" is answered once and\n-- a new one can be added without hunting down every call site.\nlocal function present(current: Active, root: CFrame, moving: boolean, turning: number, settled: boolean)\n	current.motion.apply({\n		root = root,\n		traveled = current.traveled,\n		elapsed = os.clock() - current.startedAt,\n		moving = moving,\n		turning = turning,\n		settled = settled,\n	})\nend\n\n-- Moves the subject between two floor points at its own pace, facing the way it is\n-- going. Returns false if the scene was cancelled part-way, which every caller must\n-- treat as \"stop, the model is already gone\".\n--\n-- Distance covered is banked into the scene rather than kept locally, because the\n-- gait is keyed to it and the walk in, the wait and the walk out have to read as\n-- one continuous journey: a stride that restarted at each leg would replant the\n-- feet at every stop.\nlocal function travel(current: Active, from: Vector3, to: Vector3): boolean\n	local direction = flatten(to - from)\n	local distance = (to - from).Magnitude\n	if direction == nil or distance < MIN_DIRECTION then\n		return true\n	end\n\n	local heading = headingTo(direction)\n	local covered = 0\n	while covered < distance do\n		local delta = RunService.Heartbeat:Wait()\n		if current.cancelled then\n			return false\n		end\n		local step = math.min(distance - covered, current.subject.walkSpeed * delta)\n		covered += step\n		current.traveled += step\n		present(current, poseAt(from:Lerp(to, covered / distance), heading), true, 0, false)\n	end\n\n	return true\nend\n\n-- Whether the scene is still wanted, which is a question about the prompt and not\n-- about this table. An event answered, a player who died, a life that ended, a\n-- profile that went away, a second event offered on top -- all of them show up\n-- here as \"the pending id is no longer mine\", so there is one condition to get\n-- right instead of a subscription to every service that could have ended it. The\n-- same trick EnactService uses, for the same reason.\nlocal function stillWanted(player: Player, current: Active): boolean\n	local profile = DataService.GetProfile(player)\n	if profile == nil or not Lives.Active(profile.Data).alive then\n		return false\n	end\n	return Lives.Active(profile.Data).pendingEventId == current.eventId\nend\n\n-- Whether the prompt ended by being *answered*, as opposed to by a death or by\n-- being superseded. Read off the seen list rather than passed in, because nothing\n-- calls this service when a choice resolves -- and adding a call would mean\n-- EventService had to know a subject existed.\nlocal function wasAnswered(player: Player, current: Active): boolean\n	local profile = DataService.GetProfile(player)\n	if profile == nil or not Lives.Active(profile.Data).alive then\n		return false\n	end\n	return Lives.Active(profile.Data).seenEventIds[current.eventId] == true\nend\n\n-- Which way the player is from a point on the floor, or nil if there is nobody to\n-- look at -- a character still loading, or one that has just been removed. Nil is\n-- an ordinary answer and every caller keeps whichever heading it already had,\n-- because an animal that snaps to a default when a character reloads is worse\n-- than one that goes on looking where it was looking.\nlocal function towardPlayer(player: Player, from: Vector3): Vector3?\n	local character = player.Character\n	if character == nil then\n		return nil\n	end\n	return flatten(character:GetPivot().Position - from)\nend\n\n-- One frame of standing still: eases the facing round toward the player, hands the\n-- frame over, and reports where the facing ended up. The turn still to make goes\n-- with it so the head can lead the body through it.\n--\n-- A function rather than a block inside the waiting loop because the waiting is no\n-- longer the only time the animal stands there. An animal that breathes while the\n-- question is open and then freezes solid the instant it is answered is worse than\n-- one that never breathed -- the freeze is the moment the player is looking\n-- straight at it.\nlocal function stand(player: Player, current: Active, at: Vector3, heading: number, settled: boolean): number\n	local remaining = 0\n	local target = towardPlayer(player, at)\n	if target ~= nil then\n		local desired = headingTo(target)\n		remaining = (desired - heading + math.pi) % (2 * math.pi) - math.pi\n		-- Eased rather than snapped: an animal that tracks you perfectly is a turret.\n		heading += remaining * Config.Scene.TurnResponsiveness\n	end\n	present(current, poseAt(at, heading), false, remaining, settled)\n	return heading\nend\n\n-- Stands facing the player for a while. Returns false if the scene was cancelled\n-- part-way, which every caller must treat as \"stop, the model is already gone\" --\n-- the same contract travel() has, because the two are interchangeable steps in the\n-- sequence at the end of run().\nlocal function hold(\n	player: Player,\n	current: Active,\n	at: Vector3,\n	heading: number,\n	seconds: number,\n	settled: boolean\n): (boolean, number)\n	local waited = 0\n	while waited < seconds do\n		local delta = RunService.Heartbeat:Wait()\n		if current.cancelled then\n			return false, heading\n		end\n		waited += delta\n		heading = stand(player, current, at, heading, settled)\n	end\n	return true, heading\nend\n\n-- Turns on the spot to face a fixed heading. Distinct from stand()'s easing in two\n-- ways that matter: the target is a direction of travel rather than the player, and\n-- this one has to actually finish.\n--\n-- It exists because every walk used to begin with the animal snapping instantly to\n-- face wherever it was going. On the way in that was invisible -- it spawns already\n-- pointing the right way -- but every leg after the first is a turn the player is\n-- watching, and a dog that leaves by rotating 180 degrees in one frame and then\n-- walking has not turned away from you, it has been rewound.\nlocal function turn(current: Active, at: Vector3, heading: number, desired: number): (boolean, number)\n	local waited = 0\n	while true do\n		local remaining = (desired - heading + math.pi) % (2 * math.pi) - math.pi\n		-- The last fraction of a degree is taken in one step. Invisible, and it is\n		-- what lets the walk that follows start exactly aligned rather than crabbing\n		-- by however much the easing had left to do.\n		if math.abs(remaining) <= math.rad(TURN_DONE_DEGREES) or waited >= MAX_TURN_SECONDS then\n			return true, desired\n		end\n\n		local delta = RunService.Heartbeat:Wait()\n		if current.cancelled then\n			return false, heading\n		end\n		waited += delta\n		heading += remaining * Config.Scene.TurnResponsiveness\n		present(current, poseAt(at, heading), false, remaining, false)\n	end\nend\n\n-- Where the subject stops when it comes to the player, or nil if there is nowhere\n-- worth coming to. Nil covers \"already close enough\" as well as \"cannot get\n-- there\", and both mean the same thing to the caller: stay put. An approach that\n-- cannot be made is an ordinary outcome on the same terms as everything else here\n-- -- the animal holds where it is, the outcome still reads, and nothing is broken.\n--\n-- Measured against where the player is *now*, not where they were when the prompt\n-- opened. An enacted answer is given by walking, so by the time this is called they\n-- are standing on a marker somewhere else in the room -- and for \"Put your hand\n-- out\" that marker is between them and the dog, which is exactly the case this has\n-- to get right.\nlocal function approachSpot(player: Player, current: Active): Vector3?\n	local character = player.Character\n	if character == nil then\n		return nil\n	end\n\n	local from = current.stopAt\n	local to = character:GetPivot().Position\n	local direction = flatten(to - from)\n	if direction == nil then\n		return nil\n	end\n\n	local subject = current.subject\n	-- Edge to edge: the player's own width, the gap, and the animal's half-length.\n	-- One Config number is then right for a toddler meeting a dog and an adult\n	-- meeting a cat, which is the same trick ApproachStuds uses.\n	local gap = Ground.BodyRadius(character) + Config.Scene.ReactionCloseStuds + subject.bodyLength / 2\n	local away = Vector2.new(to.X - from.X, to.Z - from.Z).Magnitude\n	if away - gap < MIN_DIRECTION then\n		return nil\n	end\n\n	local ignore = Ground.IgnoreList()\n	local subjectRadius = math.max(subject.bodyLength, subject.bodyWidth) / 2\n	return Ground.SpotAt(from + direction * (away - gap), subjectRadius, subject.shoulderHeight, ignore, from)\nend\n\n-- The whole life of a scene: walk in, hold while the question is open, do whatever\n-- the answer says it did, and then either leave the way it came or vanish,\n-- depending on how the question ended.\nlocal function run(player: Player, current: Active)\n	if not travel(current, current.spawnAt, current.stopAt) then\n		return\n	end\n\n	-- Seeded facing the player if there is one, and otherwise along the way it came\n	-- in -- which is the direction it is already pointing, so a missing character at\n	-- this instant costs a turn rather than a snap.\n	local toPlayer = towardPlayer(player, current.stopAt)\n	local heading = if toPlayer ~= nil then headingTo(toPlayer) else headingTo(current.stopAt - current.spawnAt)\n	local sinceCheck = math.huge\n\n	while true do\n		local delta = RunService.Heartbeat:Wait()\n		if current.cancelled then\n			return\n		end\n\n		-- Coarse on purpose: this only bounds how quickly a subject clears after\n		-- the prompt it belongs to has gone, and the profile lookup is the one\n		-- thing in the loop that is not arithmetic.\n		sinceCheck += delta\n		if sinceCheck >= Config.Scene.TickSeconds then\n			sinceCheck = 0\n			if not stillWanted(player, current) then\n				break\n			end\n		end\n\n		-- Standing and watching. The turn still to make is handed to the motion as\n		-- well as applied here, because the head leads the body through a turn -- a\n		-- body that rotates with its head bolted straight ahead reads as a gun\n		-- turret, which is the same failure NPCService's head tracking exists to\n		-- avoid, one joint further out.\n		heading = stand(player, current, current.stopAt, heading, false)\n	end\n\n	-- Past here the prompt is over. An abrupt ending gets an abrupt exit: nobody\n	-- is watching a dog walk out of a room they have just died in.\n	if not wasAnswered(player, current) then\n		finish(player, current)\n		return\n	end\n\n	-- Everything below is the ending, and it is the one stretch of this file that\n	-- can be interrupted at half a dozen points -- the player may die, leave, or be\n	-- handed a new event at any of them. Every step returns false when the scene was\n	-- cancelled under it, and every one of those means the model is already gone and\n	-- there is nothing left to tidy.\n	local reaction = current.reaction\n	local at = current.stopAt\n	local ok = true\n\n	if reaction == \"approach\" then\n		local closeAt = approachSpot(player, current)\n		if closeAt ~= nil then\n			local direction = flatten(closeAt - at)\n			if direction ~= nil then\n				ok, heading = turn(current, at, heading, headingTo(direction))\n				if not ok then\n					return\n				end\n				if not travel(current, at, closeAt) then\n					return\n				end\n				at = closeAt\n			end\n		end\n	end\n\n	-- The outcome is on screen now, and the animal it is about is still there while\n	-- it is read -- vanishing on the click would undo the entire reason it walked\n	-- in. Withdrawing is the one answer that skips this, and has to: turning away\n	-- *is* what \"it lost interest\" looks like, and an animal that turns away and\n	-- then waits four seconds has not lost interest in you at all.\n	if reaction ~= \"withdraw\" then\n		ok, heading = hold(player, current, at, heading, Config.Scene.LingerSeconds, reaction == \"settle\")\n		if not ok then\n			return\n		end\n		if reaction == \"settle\" then\n			-- On its feet before anything moves. An animal asked to walk while it is\n			-- still on the floor slides across the room on its side, which is exactly\n			-- the failure the whole gait exists to prevent, one pose further out. The\n			-- motion owns how long getting up takes, so the motion is asked.\n			ok, heading = hold(player, current, at, heading, SubjectMotion.SettleSeconds, false)\n			if not ok then\n				return\n			end\n		end\n	end\n\n	-- Out the way it came, retracing an approach first if it made one. Every leg of\n	-- the exit is then a route that was already checked in the other direction,\n	-- which is why leaving needs no probing of its own.\n	if at ~= current.stopAt then\n		local back = flatten(current.stopAt - at)\n		if back ~= nil then\n			ok, heading = turn(current, at, heading, headingTo(back))\n			if not ok then\n				return\n			end\n		end\n		if not travel(current, at, current.stopAt) then\n			return\n		end\n	end\n\n	local out = flatten(current.spawnAt - current.stopAt)\n	if out ~= nil then\n		-- The heading it ends on is the one travel() is about to use anyway, so only\n		-- the \"was this cancelled\" half of the answer is wanted here.\n		local turned = turn(current, current.stopAt, heading, headingTo(out))\n		if not turned then\n			return\n		end\n	end\n	travel(current, current.stopAt, current.spawnAt)\n	finish(player, current)\nend\n\n-- Called by EventService at the moment a prompt opens. Returns the model that is\n-- doing the walking, which is everything anything else in the room needs to know\n-- about it.\n--\n-- The model rather than a position, and that is the whole of why the choice hangs\n-- where it does. A point would be true once, at this instant, and the animal is\n-- still walking in -- anything pinned to it would be pinned to where the dog used\n-- to be going. The dots ride the model instead and ask it where it is, so the dog\n-- can walk in, turn to face you, and come over when you answer without the choice\n-- ever losing track of it.\n--\n-- Handing out the model is a real widening of what this service exposes, and the\n-- bound is worth stating: it is read, never driven. run() owns every pose the\n-- animal takes, and a second writer moving it would be two things driving one\n-- model -- the same rule onAnswered below already keeps.\n--\n-- Nil is the answer to every reason there is no animal, and every one of them is\n-- ordinary: an event about nothing, a room that cannot hold one, a harness switch\n-- turned off. Callers treat nil as \"there is nothing to be toward\" and fall back\n-- to what they did before subjects existed.\nlocal function begin(player: Player, event: LifeEvent): Types.StagedSubject?\n	stop(player)\n\n	if not enabled then\n		lastReason[player] = \"scenes are switched off\"\n		return nil\n	end\n\n	local subjectId = event.subject\n	if subjectId == nil then\n		lastReason[player] = `\"{event.id}\" is not about anything`\n		return nil\n	end\n\n	-- Validated at content load, so reaching here with an unknown id would mean the\n	-- validator was bypassed. Warn rather than throw: a missing prop must not take\n	-- the event down with it.\n	local subject = Subjects.ById[subjectId]\n	if subject == nil then\n		warn(`[AGES] event \"{event.id}\" is about \"{subjectId}\", which is not a subject; nothing will appear`)\n		lastReason[player] = `\"{subjectId}\" is not a subject`\n		return nil\n	end\n\n	local character = player.Character\n	if character == nil then\n		lastReason[player] = `no character to put a {subject.name} in front of`\n		return nil\n	end\n\n	-- Full walk-in first, then drawn in once. Two attempts rather than a search,\n	-- for the reason EnactService gives: the difference between them is the\n	-- difference between a room and a corner.\n	local retryWalkIn = Config.Scene.WalkInStuds * Config.Scene.RetryWalkInScale\n	local placed = place(character, subject, Config.Scene.WalkInStuds)\n	if placed == nil then\n		placed = place(character, subject, retryWalkIn)\n	end\n	if placed == nil then\n		lastReason[player] = string.format(\n			\"nowhere here for a %s: %d bearings across %d degrees, walking in %.0f then %.0f studs\",\n			subject.name,\n			Config.Scene.Bearings,\n			Config.Scene.ArcDegrees,\n			Config.Scene.WalkInStuds,\n			retryWalkIn\n		)\n		return nil\n	end\n	lastReason[player] = \"\"\n\n	local rig = SubjectModels.Build(subject)\n	local current: Active = {\n		eventId = event.id,\n		subject = subject,\n		rig = rig,\n		motion = SubjectMotion.Attach(rig),\n		-- Nothing has been answered yet, and for most events nothing ever will be:\n		-- written here rather than left out so that the one field whose value is a\n		-- moment in the future is visible in the shape of a scene at the moment it\n		-- starts.\n		reaction = nil,\n		answered = false,\n		spawnAt = placed.spawnAt,\n		stopAt = placed.stopAt,\n		traveled = 0,\n		startedAt = os.clock(),\n		cancelled = false,\n	}\n\n	-- Posed before parenting, so the subject is never seen for a frame standing at\n	-- the world origin in whatever shape it was built in, and is already facing the\n	-- way it is about to walk.\n	local direction = flatten(placed.stopAt - placed.spawnAt)\n	present(current, poseAt(placed.spawnAt, if direction ~= nil then headingTo(direction) else 0), false, 0, false)\n	rig.model.Parent = sceneFolder()\n\n	active[player] = current\n	task.spawn(run, player, current)\n\n	return rig.model\nend\n\n-- Told by EventService which way the question went, which is the one thing about\n-- an event this service cannot work out for itself: the choice is never written to\n-- the profile, and should not be -- it matters for the few seconds an animal is\n-- still in the room and never again.\n--\n-- Guarded on the id rather than on the player alone. By the time an answer lands,\n-- a newer event may already have superseded this one and started a scene of its\n-- own, and the reaction to the old question must not be played by the new animal.\nlocal function onAnswered(player: Player, event: LifeEvent, choice: EventChoice)\n	local current = active[player]\n	if current == nil or current.eventId ~= event.id then\n		return\n	end\n	-- Stored rather than acted on. run() is mid-frame somewhere in its waiting loop\n	-- and owns every pose the animal takes; a second writer moving it from in here\n	-- would be two things driving one model.\n	current.reaction = choice.reaction\n	current.answered = true\nend\n\n-- Studio harness: what is standing in the room right now.\nfunction SceneService.Describe(player: Player): string\n	local current = active[player]\n	if current == nil then\n		local reason = lastReason[player]\n		if reason == nil or reason == \"\" then\n			return `no subject | scenes {if enabled then \"on\" else \"off\"}`\n		end\n		return `no subject: {reason}`\n	end\n\n	local at = current.rig.model:GetPivot().Position\n	local fromRest = (at - current.stopAt).Magnitude\n	return string.format(\n		'\"%s\" | %s (%s) at (%.1f, %.1f) | %s | %s | %s, %.1f studs walked',\n		current.eventId,\n		current.subject.name,\n		current.subject.id,\n		at.X,\n		at.Z,\n		-- Half a stud is well under one frame of travel at any authored walkSpeed,\n		-- so \"in place\" means arrived rather than nearly arrived.\n		if fromRest < 0.5 then \"in place\" else \"on the move\",\n		-- Three states, not two, and the third is the one worth printing: an event\n		-- that was answered and has no reaction to play looks exactly like one that\n		-- has not been answered yet, and the fix for the two is completely different.\n		if not current.answered then \"unanswered\" else current.reaction or \"no reaction\",\n		-- Which of the two motions it got, which is the first thing worth knowing\n		-- when a dropped-in model stands frozen: \"posed\" means the placeholder is\n		-- being animated here, \"clips\" means the model brought its own and this is\n		-- only choosing between them.\n		if current.rig.limbs ~= nil then \"posed\" else \"clips\",\n		current.traveled\n	)\nend\n\nfunction SceneService.SetEnabled(value: boolean)\n	enabled = value\n	if value then\n		return\n	end\n	-- Switching off mid-scene leaves an animal standing in a room nothing is\n	-- watching any more.\n	stopAll()\nend\n\n-- Removes every subject currently standing around. Used at server start, where a\n-- Rojo sync mid-session can otherwise leave models behind with nothing left\n-- holding a reference to them.\nfunction SceneService.DespawnAll()\n	stopAll()\n\n	local folder = workspace:FindFirstChild(SCENE_FOLDER)\n	if folder ~= nil then\n		folder:ClearAllChildren()\n	end\nend\n\nfunction SceneService:Init()\n	-- Injected rather than required the other way around, matching EnactService:\n	-- a subject is something an event *has*, so the event engine must not have to\n	-- know that this file exists.\n	EventService.SetSceneHandler(begin)\n	-- Added to the answered listeners rather than owning the slot: WorkService\n	-- listens for the same news to score the shift, and the two have nothing to say\n	-- to each other.\n	EventService.OnAnswered(onAnswered)\nend\n\nfunction SceneService:Start()\n	SceneService.DespawnAll()\n	Players.PlayerRemoving:Connect(function(player: Player)\n		stop(player)\n		-- Keyed by Player, so leaving this behind would hold a reference to someone\n		-- who has gone. Small, and exactly the kind of small that accumulates over a\n		-- server's lifetime.\n		lastReason[player] = nil\n	end)\nend\n\nreturn SceneService\n"
table.insert(AGES_MANIFEST, "src/server/services/SceneService.luau")
AGES_SOURCES["src/server/services/SchoolCrowdService.luau"] = "--!strict\n-- The other students.\n--\n-- The school had nobody in it. Teachers appear for a lesson and bullies stand in the\n-- corridor, and that was the whole population of a fourteen-room building -- so every\n-- reference photograph of this genre is crowded and ours was an empty set with the lights\n-- on. A school is *other children*; that is what the word means, and it is the single\n-- largest gap between this building and the games it is measured against.\n--\n-- **This file spawns nobody the school has not already built a room for.** It never calls\n-- School.Build. If the building is not up, there is no crowd, and that is correct: a\n-- cohort of rigs standing on an empty lot is worse than an empty lot.\n--\n-- Modelled on StadiumCrowdService, which solved the hard half already. Its two lessons are\n-- the two that matter here:\n--\n-- 1. **A rig is a web call.** NPCService.Spawn goes through\n--    Players:CreateHumanoidModelFromDescription. The cap and the per-tick budget are not\n--    tuning; they are what stops the first player through the gate from stalling the server.\n-- 2. **Top the pool up on a tick, never spawn it once.** Streaming and failed builds lose\n--    rigs silently, and a missing student is not something a player reports -- it is\n--    something they never learn was supposed to be there.\n--\n-- Everyone is spawned **at the player's own age**, the way BullyService does it. That single\n-- argument is the difference between schoolmates and adults loitering in a corridor.\n\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Config = require(ReplicatedStorage:WaitForChild(\"Config\"))\nlocal Lives = require(ReplicatedStorage:WaitForChild(\"Lives\"))\n\nlocal DataService = require(script.Parent.DataService)\nlocal NPCService = require(script.Parent.NPCService)\nlocal Townsfolk = require(script.Parent.Parent.content.Townsfolk)\nlocal School = require(script.Parent.Parent.world.School)\nlocal Students = require(script.Parent.Parent.content.Students)\n\ntype Visitor = NPCService.Visitor\n\nlocal SchoolCrowdService = {}\n\nlocal CROWD = Config.School.Crowd\n\n-- Where students stand and walk, as room ids in School's own plan.\n--\n-- Read from the plan rather than written as coordinates, which is the rule the whole world\n-- tree follows: the school is laid around a place point and the place point moves. A list of\n-- room ids survives that; a list of positions does not.\n--\n-- The corridor is weighted by appearing twice. That is not a trick -- between periods a\n-- school corridor holds more people than any room in the building, and a crowd spread evenly\n-- across fourteen rooms reads as a museum.\nlocal STANDING_ROOMS = {\n	\"corridor\",\n	\"corridor\",\n	\"lounge\",\n	\"lounge\",\n	\"cafeteria\",\n	\"cafeteria\",\n	\"library\",\n	\"gym\",\n}\n\n-- What a roamer walks between. Deliberately the big shared spaces rather than the\n-- classrooms: a student pacing in and out of the chemistry lab all afternoon is a student\n-- with nowhere to be.\nlocal ROAMING_ROOMS = {\n	\"corridor\",\n	\"cafeteria\",\n	\"lounge\",\n	\"library\",\n}\n\ntype Slot = {\n	kind: string,\n	visitor: Visitor?,\n	spawning: boolean,\n	walking: boolean,\n	-- Where a stander was told to stand, so the tick can tell a student who wandered from a\n	-- student whose rig has gone.\n	post: Vector3?,\n}\n\nlocal slots: { Slot } = {}\nlocal enabled = true\n\nlocal function randomBody()\n	local bodies = Townsfolk.Bodies\n	if #bodies == 0 then\n		return nil\n	end\n	return bodies[math.random(1, #bodies)]\nend\n\n-- A point inside a named room, scattered a little so a row of students does not read as a\n-- shelf of dolls. Nil when the school has no such room, which is the normal answer before\n-- the building is up.\nlocal function spotIn(rooms: { string }): Vector3?\n	local plan = School.Plan()\n	if plan == nil then\n		return nil\n	end\n	-- Tried a few times rather than once: a room id in the list above may simply not exist in\n	-- a given build, and giving up on the first miss would empty the whole crowd because of\n	-- one name.\n	for _ = 1, 4 do\n		local id = rooms[math.random(1, #rooms)]\n		local at = plan.rooms[id]\n		if at ~= nil then\n			local spread = CROWD.ScatterStuds\n			return at + Vector3.new(math.random(-spread, spread), 0, math.random(-spread, spread))\n		end\n	end\n	return nil\nend\n\n-- The player the crowd is being built for, and only if they are near the school.\n--\n-- One player rather than all of them: NPCService.Spawn takes a player because a rig is built\n-- against somebody's age, and a school full of students who are all seventeen because one\n-- seventeen-year-old is on the server is a smaller wrong than a school full of adults.\nlocal function nearestStudent(): (Player?, number)\n	local plan = School.Plan()\n	if plan == nil then\n		return nil, 0\n	end\n	for _, player in Players:GetPlayers() do\n		local character = player.Character\n		if character ~= nil then\n			local root = character:FindFirstChild(\"HumanoidRootPart\") :: BasePart?\n			if root ~= nil and (root.Position - plan.center).Magnitude <= CROWD.NearStuds then\n				local profile = DataService.GetProfile(player)\n				if profile ~= nil then\n					local data = Lives.Active(profile.Data)\n					return player, math.floor(data.ageMonths / 12)\n				end\n			end\n		end\n	end\n	return nil, 0\nend\n\nlocal function despawn(slot: Slot)\n	if slot.visitor ~= nil then\n		slot.visitor.destroy()\n		slot.visitor = nil\n	end\n	slot.walking = false\n	slot.post = nil\nend\n\n-- Walks a roamer between the shared rooms forever, pausing at each. The same walk/rest shape\n-- the stadium's concourse loop uses, and `visitor.gone()` is the only exit -- a walk can be\n-- yielding for seconds while the rig underneath it is torn down by a life ending or the last\n-- player leaving.\nlocal function walkRoamer(slot: Slot, visitor: Visitor)\n	slot.walking = true\n	task.spawn(function()\n		while not visitor.gone() and slot.visitor == visitor do\n			local target = spotIn(ROAMING_ROOMS)\n			if target == nil then\n				break\n			end\n			local shouldStop = function()\n				return visitor.gone() or slot.visitor ~= visitor\n			end\n			visitor.pathTo(target, shouldStop)\n			if visitor.gone() or slot.visitor ~= visitor then\n				break\n			end\n			task.wait(math.random(CROWD.PauseMinSeconds, CROWD.PauseMaxSeconds))\n		end\n		slot.walking = false\n	end)\nend\n\n-- The name, clique and line over a student's head.\n--\n-- One billboard with three lines rather than three billboards: a BillboardGui is a draw call\n-- and there can be fourteen of these in one corridor.\n--\n-- Distances are deliberately short. A label readable across the whole atrium would turn the\n-- building into a wall of floating text, and the point of these is that you learn who somebody\n-- is by *going over to them* -- which is also what makes the clique rooms worth walking to.\nlocal function labelStudent(visitor: Visitor, identity: { name: string, clique: Students.Clique, bio: string })\n	local model = visitor.model\n	if model == nil then\n		return\n	end\n	-- Head if it is there, root if it is not. A rig arrives from a web call and its parts\n	-- assemble over a frame or two, so a label that insisted on the Head would silently fail\n	-- on whichever students happened to be slowest -- the kind of bug that shows up as \"some\n	-- of them have names\" and is never reported as anything.\n	local anchor = (model:FindFirstChild(\"Head\") :: BasePart?) or visitor.root\n	local lift = if anchor == visitor.root then 4.2 else 2.6\n\n	local gui = Instance.new(\"BillboardGui\")\n	gui.Name = \"StudentTag\"\n	gui.Adornee = anchor\n	gui.Size = UDim2.new(0, 190, 0, 52)\n	gui.StudsOffsetWorldSpace = Vector3.new(0, lift, 0)\n	gui.MaxDistance = CROWD.LabelDistanceStuds\n	gui.AlwaysOnTop = false\n	gui.Parent = anchor\n\n	local clique = Instance.new(\"TextLabel\")\n	clique.Size = UDim2.new(1, 0, 0, 15)\n	clique.BackgroundTransparency = 1\n	clique.Font = Enum.Font.GothamBold\n	clique.TextSize = 13\n	clique.TextColor3 = Color3.fromRGB(126, 190, 246)\n	clique.TextStrokeTransparency = 0.5\n	clique.Text = identity.clique.label\n	clique.Parent = gui\n\n	local name = Instance.new(\"TextLabel\")\n	name.Position = UDim2.new(0, 0, 0, 15)\n	name.Size = UDim2.new(1, 0, 0, 18)\n	name.BackgroundTransparency = 1\n	name.Font = Enum.Font.GothamBold\n	name.TextSize = 15\n	name.TextColor3 = Color3.fromRGB(245, 246, 250)\n	name.TextStrokeTransparency = 0.4\n	name.Text = identity.name\n	name.Parent = gui\n\n	-- The bio is the half that does the work. A name and a clique is a database row; a line in\n	-- the student's own words is a person. It fades out closer than the name, so a corridor at\n	-- a distance is names and only the person in front of you is a person.\n	local bio = Instance.new(\"TextLabel\")\n	bio.Position = UDim2.new(0, 0, 0, 33)\n	bio.Size = UDim2.new(1, 0, 0, 15)\n	bio.BackgroundTransparency = 1\n	bio.Font = Enum.Font.Gotham\n	bio.TextSize = 11\n	bio.TextColor3 = Color3.fromRGB(206, 212, 226)\n	bio.TextStrokeTransparency = 0.6\n	bio.TextTruncate = Enum.TextTruncate.AtEnd\n	bio.Text = identity.bio\n	bio.Parent = gui\nend\n\nlocal function spawnInto(slot: Slot, player: Player, age: number)\n	if slot.visitor ~= nil or slot.spawning then\n		return\n	end\n	local member = randomBody()\n	if member == nil then\n		return\n	end\n	-- Who this is, decided before where they stand -- because the clique is what chooses the\n	-- room. This is the whole point of the identity: athletes by the gym, the art club in the\n	-- art room, bookworms in the library, so the building sorts itself the way a school does\n	-- and finding somebody is knowledge rather than luck.\n	--\n	-- Roamers keep the shared route list. Somebody walking between lessons is not standing\n	-- anywhere, so a clique's rooms say nothing useful about where they should be headed.\n	local identity = Students.Roll()\n	local rooms = if slot.kind == \"roam\" then ROAMING_ROOMS else identity.clique.rooms\n	local at = spotIn(rooms)\n	if at == nil then\n		-- The clique's rooms are not in this build. Fall back to the rooms every student shares\n		-- rather than losing the slot: a missing art room should cost the art room, not the\n		-- student.\n		at = spotIn(STANDING_ROOMS)\n	end\n	if at == nil then\n		return\n	end\n\n	slot.spawning = true\n	task.spawn(function()\n		-- The age is the whole point -- see the header. A schoolmate is somebody your own\n		-- size, and passing this is what makes the corridor read as a school.\n		local visitor = NPCService.Spawn(player, member, CFrame.new(at), age)\n		slot.spawning = false\n		if visitor == nil then\n			return\n		end\n		-- The pool may have been torn down while the web call was in flight.\n		if slot.visitor ~= nil or not enabled then\n			visitor.destroy()\n			return\n		end\n		slot.visitor = visitor\n		labelStudent(visitor, identity)\n		if slot.kind == \"roam\" then\n			visitor.setSpeed(CROWD.WalkSpeed)\n			walkRoamer(slot, visitor)\n		else\n			slot.post = at\n		end\n	end)\nend\n\nlocal function tickCrowd()\n	if not enabled then\n		for _, slot in slots do\n			despawn(slot)\n		end\n		return\n	end\n\n	local player, age = nearestStudent()\n	if player == nil then\n		-- Nobody near the school, or no school. Tear the cohort down rather than leaving it\n		-- standing in an empty building on the far side of the map.\n		for _, slot in slots do\n			despawn(slot)\n		end\n		return\n	end\n\n	local budget = CROWD.SpawnPerTick\n	for _, slot in slots do\n		if budget <= 0 then\n			break\n		end\n		if slot.visitor ~= nil and slot.visitor.gone() then\n			-- Lost to streaming or a sweep. Cleared here so the slot can be refilled, which is\n			-- the whole reason this runs on a tick instead of once.\n			slot.visitor = nil\n			slot.walking = false\n		end\n		if slot.visitor == nil and not slot.spawning then\n			spawnInto(slot, player, age)\n			budget -= 1\n		end\n	end\nend\n\nfunction SchoolCrowdService.SetEnabled(value: boolean)\n	enabled = value\n	if not enabled then\n		for _, slot in slots do\n			despawn(slot)\n		end\n	end\nend\n\nfunction SchoolCrowdService.IsEnabled(): boolean\n	return enabled\nend\n\n-- Clears the cohort. The new-life path: the school is rebuilt around whichever place point\n-- the next life walks into, and a crowd standing at the old one would be a class of ghosts.\nfunction SchoolCrowdService.Clear()\n	for _, slot in slots do\n		despawn(slot)\n	end\nend\n\nfunction SchoolCrowdService.Describe(): string\n	local standing, roaming, pending = 0, 0, 0\n	for _, slot in slots do\n		if slot.spawning then\n			pending += 1\n		elseif slot.visitor ~= nil then\n			if slot.kind == \"roam\" then\n				roaming += 1\n			else\n				standing += 1\n			end\n		end\n	end\n	local plan = School.Plan()\n	local player = nearestStudent()\n	return table.concat({\n		`students: {if enabled then \"on\" else \"off\"}`,\n		`school: {if plan ~= nil then \"built\" else \"not built yet\"}`,\n		`someone near: {if player ~= nil then player.Name else \"nobody\"}`,\n		`standing {standing}, roaming {roaming}, arriving {pending}, of {CROWD.Max}`,\n	}, \"\\n\")\nend\n\nfunction SchoolCrowdService:Init()\n	-- The slots are made once and refilled forever, which is what makes the cap a cap: a\n	-- pool that grew on demand would have no ceiling on the web calls it could ask for.\n	for index = 1, CROWD.Max do\n		table.insert(slots, {\n			kind = if index <= CROWD.Roaming then \"roam\" else \"stand\",\n			visitor = nil,\n			spawning = false,\n			walking = false,\n			post = nil,\n		})\n	end\nend\n\nfunction SchoolCrowdService:Start()\n	Players.PlayerRemoving:Connect(function()\n		-- The last player out takes the school with them on the next tick; this only makes\n		-- that immediate rather than waiting on the timer.\n		if #Players:GetPlayers() <= 1 then\n			SchoolCrowdService.Clear()\n		end\n	end)\n\n	task.spawn(function()\n		while true do\n			task.wait(CROWD.TickSeconds)\n			local ok, err = pcall(tickCrowd)\n			if not ok then\n				warn(`[AGES] school crowd tick failed: {err}`)\n			end\n		end\n	end)\nend\n\nreturn SchoolCrowdService\n"
table.insert(AGES_MANIFEST, "src/server/services/SchoolCrowdService.luau")
AGES_SOURCES["src/server/services/SchoolService.luau"] = "--!strict\n-- School: the twelve years of a life that had nothing in them to do.\n--\n-- Everything between being born and being hired was a stat readout and a text prompt\n-- on a birthday. A player could not spend an afternoon being nine, because there was\n-- no afternoon -- childhood was a progress bar in front of the job. This is the thing\n-- that fills it.\n--\n-- The loop:\n--\n--   You walk to the school and step on the pad outside it. A question comes up with\n--   three or four answers under it and a clock. You have twenty seconds to pick one.\n--   Whatever you pick, the teacher's line explains the answer for a beat, and then the\n--   next question comes up. Five of those is a lesson.\n--\n-- The question opens itself, and that is the one place in this game where nothing has\n-- three dots over its head. Dots are for things you walk up to -- a person, an animal\n-- -- and they mean \"there is something here\". A lesson is not something in the room;\n-- it is something you are already inside, like a shift. You did the walking when you\n-- came to the school. Making a nine-year-old click a building between every question\n-- would be charging them for the same journey five times.\n--\n-- The walk is still what a lesson costs. It is spent at the door rather than at every\n-- question, and the clock is what stops the twenty seconds after that being idle.\n--\n-- What it is for, past being something to do. `smarts` was a number nothing in the\n-- game read -- no job asked for it, no event moved it, and it decayed at zero a year.\n-- School moves it and the office job now wants it, so the afternoons a nine-year-old\n-- spends here are the reason a sixteen-year-old can be something other than a shop\n-- assistant. That is the point of the whole system: it makes the first half of a life\n-- pay into the second, which is the one thing a life simulator has to do.\n--\n-- Two things are deliberately *not* here.\n--\n-- There is no guide line to the school. Config.Guide exists to point at \"something\n-- that just opened up\", and school does not open up -- it is there for the whole of\n-- your childhood, in a building on a street, with a sign over the door. The sign and\n-- the pad are shared and server-built, on the rule Remotes.luau states: a thing meant\n-- for whoever walks past is built in the world, and a thing addressed to one person is\n-- pushed to them. A school is a building. A job offer is addressed to you.\n--\n-- And there is no way to fail into a hole. Missing every question in a lesson costs\n-- you the lesson, never smarts; only never turning up at all costs anything, once a\n-- year, on the birthday that ends it. A childhood spent elsewhere ends around thirty\n-- smarts rather than at zero -- behind, not ruined -- because \"failure worth playing\"\n-- means a bad run you can still play out of.\n\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal RunService = game:GetService(\"RunService\")\n\nlocal Config = require(ReplicatedStorage:WaitForChild(\"Config\"))\nlocal Remotes = require(ReplicatedStorage:WaitForChild(\"Remotes\"))\nlocal Types = require(ReplicatedStorage:WaitForChild(\"Types\"))\nlocal ChoiceMarkers = require(ReplicatedStorage:WaitForChild(\"world\"):WaitForChild(\"ChoiceMarkers\"))\nlocal Lives = require(ReplicatedStorage:WaitForChild(\"Lives\"))\nlocal Mastery = require(ReplicatedStorage:WaitForChild(\"school\"):WaitForChild(\"Mastery\"))\nlocal Report = require(ReplicatedStorage:WaitForChild(\"school\"):WaitForChild(\"Report\"))\n\nlocal DataService = require(script.Parent.DataService)\nlocal EventService = require(script.Parent.EventService)\nlocal PlaceService = require(script.Parent.PlaceService)\nlocal StatService = require(script.Parent.StatService)\nlocal SkillService = require(script.Parent.SkillService)\nlocal ScienceService = require(script.Parent.ScienceService)\nlocal GeographyService = require(script.Parent.GeographyService)\nlocal ArtService = require(script.Parent.ArtService)\nlocal ReadingService = require(script.Parent.ReadingService)\nlocal MusicService = require(script.Parent.MusicService)\nlocal PEService = require(script.Parent.PEService)\nlocal SchoolCrowdService = require(script.Parent.SchoolCrowdService)\nlocal Ground = require(script.Parent.Parent.world.Ground)\nlocal Lab = require(script.Parent.Parent.world.Lab)\nlocal School = require(script.Parent.Parent.world.School)\nlocal Studio = require(script.Parent.Parent.world.Studio)\nlocal SubjectModels = require(script.Parent.Parent.world.SubjectModels)\nlocal SubjectMotion = require(script.Parent.Parent.world.SubjectMotion)\nlocal Curriculum = require(script.Parent.Parent.content.Curriculum)\nlocal Lessons = require(script.Parent.Parent.content.Lessons)\nlocal Subjects = require(script.Parent.Parent.content.Subjects)\n\ntype LifeData = Types.LifeData\ntype LessonQuestion = Types.LessonQuestion\ntype LessonState = Types.LessonState\ntype OfferedChoice = Types.OfferedChoice\ntype ReportCard = Types.ReportCard\ntype SchoolYearRecord = Types.SchoolYearRecord\ntype SchoolSubject = Types.SchoolSubject\ntype SubjectRig = SubjectModels.SubjectRig\ntype Motion = SubjectMotion.Motion\n\n-- One answer disc on the classroom floor. The marker is the drawn pad and the at is\n-- the point the player has to reach, kept together because the two belong to the\n-- same answer and a disc that moved would otherwise leave its proximity test behind.\ntype Disc = {\n	at: Vector3,\n	marker: ChoiceMarkers.ChoiceMarker,\n}\n\nlocal SchoolService = {}\n\nlocal LessonUpdatedRemote = Remotes.Get(\"LessonUpdated\")\nlocal RequestLessonAnswerRemote = Remotes.Get(\"RequestLessonAnswer\")\nlocal ReportCardUpdatedRemote = Remotes.Get(\"ReportCardUpdated\")\nlocal TimetableUpdatedRemote = Remotes.Get(\"TimetableUpdated\")\nlocal RequestReportCardReadRemote = Remotes.Get(\"RequestReportCardRead\")\n\n-- The place id the classroom answers to. A part in Studio carries this on its place\n-- attribute, exactly like the shop and the office. Nothing here builds a school: the\n-- world is built by hand and this finds it, so moving the building is a drag in Studio\n-- and not an edit here.\nlocal PLACE_ID = \"school\"\n\n-- How hard the eager builder tries before it gives up and says so. Thirty tries two seconds\n-- apart is a minute, which is far longer than a map takes to stream and short enough that a\n-- genuinely missing place point is reported while somebody is still looking at the console.\nlocal SCHOOL_BUILD_ATTEMPTS = 30\nlocal SCHOOL_BUILD_RETRY_SECONDS = 2\n\nlocal SCHOOL = Config.School\n\n-- One lesson in progress. Only ever one per player -- you cannot be in two classrooms.\ntype Lesson = {\n	-- Where the classroom is, taken once at the start rather than looked up per tick.\n	-- The lesson is anchored to the room it began in, so a place point that streams out\n	-- mid-lesson does not silently move the walls in around the player.\n	room: Vector3,\n\n	-- Which subject is being taught. Held on the lesson rather than recomputed at the end\n	-- from `subjectFor(data)`, because that function reads `lessonsThisYear` -- which the\n	-- lesson itself increments -- so asking it twice can honestly return two different\n	-- subjects, and the pass would be banked against whatever is on next.\n	subjectId: string,\n\n	questions: { LessonQuestion },\n	-- Which question is in front of the player, from 1. Runs one past #questions for\n	-- the instant between the last answer and the lesson closing.\n	index: number,\n	right: number,\n\n	-- Which authored answer each row on the panel is: `order[n]` is the index into\n	-- `questions[index].answers` that row number n is showing. The rows are shuffled\n	-- and the question is not, which is why this is a second list rather than a\n	-- rearrangement of the first -- `correct` keeps meaning what the content file said\n	-- it meant.\n	--\n	-- Shuffled per question and not per lesson, so the right answer is never learnable\n	-- as a position. A child who works out that the correct answer is always the top\n	-- row has stopped answering questions and started reading the game.\n	--\n	-- It is also the whole of what the client is told. The rows go out numbered by\n	-- their position on the panel, so an answer coming back names a row and this is the\n	-- only thing that knows which answer that row was.\n	order: { number },\n\n	-- The answer discs on the classroom floor, in row order so disc n answers the same\n	-- row the panel row n would have. Nil means this question's answers are rows to\n	-- click: either the lesson is not physical, or the floor refused a disc and the\n	-- question fell back. Cleared with the question and never kept past the lesson.\n	discs: { Disc }?,\n\n	secondsLeft: number,\n	-- Counts down while the teacher's line is being held, and is the flag for \"an\n	-- answer has been given and the next question has not started\". Zero means the\n	-- question is live.\n	verdictLeft: number,\n	verdictText: string?,\n	verdictRight: boolean,\n}\n\nlocal lessons: { [Player]: Lesson } = {}\n\n-- The last thing pushed to each player, so an unchanged state is not re-sent four\n-- times a second. Same reason WorkService keeps one: the HUD row is redrawn on\n-- receipt, and a row that redraws every tick cannot be read.\nlocal pushed: { [Player]: string } = {}\n\n-- A notice with no lesson behind it -- a refusal at the door, or the summary of a\n-- lesson that has just ended -- and how long is left of it. Held separately from\n-- `lessons` precisely because it outlives the lesson: the closing line has to stay up\n-- for a beat after everything else about the lesson is gone.\ntype Notice = { text: string, good: boolean, secondsLeft: number }\nlocal notices: { [Player]: Notice } = {}\n\n-- A player standing at the school with a subject they have already finished with, being\n-- asked whether they want to sit it anyway.\n--\n-- This is the whole of what mastery buys, and it is deliberately a *question* rather\n-- than an automatic pass. A subject that silently stopped happening once you were good\n-- at it would read as the game running out of content; being asked, every time, is what\n-- makes it a thing you achieved. It also leaves the door open to sitting it anyway,\n-- which a player chasing the last few points of smarts has a real reason to do.\n--\n-- Held per player rather than on the lesson because there is no lesson yet -- that is\n-- the point of it. Cleared the moment the player answers or walks away, so the panel is\n-- never up for a building they are not standing in.\ntype Door = { subjectId: string }\nlocal doors: { [Player]: Door } = {}\n\n-- Whether this player is currently being shown their report card.\n--\n-- The card itself is on the profile -- see LifeData.pendingReport -- and this is only\n-- whether it is in their hands right now. Two separate things on purpose: the card\n-- survives a birthday, a logout and a rejoin, and being at the school does not.\n--\n-- Held per player for the reason the door is, and read the same way: set when they arrive\n-- at the pad, cleared when they walk off or press the button. Keeping the geometry out\n-- here rather than in the composer means the card can be built from a profile alone,\n-- which is what makes the harness command able to print one.\nlocal cards: { [Player]: boolean } = {}\n\n\nlocal function characterPosition(player: Player): Vector3?\n	local character = player.Character\n	if character == nil then\n		return nil\n	end\n	local root = character:FindFirstChild(\"HumanoidRootPart\")\n	if root == nil or not root:IsA(\"BasePart\") then\n		return nil\n	end\n	return root.Position\nend\n\nlocal function ageYearsOf(data: LifeData): number\n	return data.ageMonths // Config.Time.MonthsPerYear\nend\n\n-- A subject's name for a sentence, falling back to its id. The fallback is the case\n-- that matters: a saved life can hold mastery in a subject that has since been taken off\n-- the timetable, and a report card reading \"you finished with woodwork\" is better than\n-- one that errors or silently drops the row.\nlocal function subjectNameOf(subjectId: string): string\n	local subject = Curriculum.Get(subjectId)\n	return if subject ~= nil then subject.name else subjectId\nend\n\n-- What is on in a given slot of a given year, from 1. The timetable itself, and the one\n-- place the rotation is worked out.\n--\n-- Rotated rather than rolled, and the difference matters over a childhood: three random\n-- draws a year from six subjects will hand a player the same one twice in a term and skip\n-- another for four years, and a timetable that behaves like that is not a timetable. Keyed\n-- on the age and the slot, so it walks the list evenly and every subject comes round -- and\n-- so the same year lived twice in a test gives the same subjects, which is worth a great\n-- deal when the thing being tested is one of them.\n--\n-- Asked about a slot rather than about \"now\" because the report card has to name the\n-- subject in a slot the player never turned up for. A year with an empty second period is\n-- reported as \"Music, absent\" rather than as a blank, and that is only possible because\n-- the timetable is a function of the year rather than a record of what happened.\n--\n-- Nil only if a whole school year has no subject in it, which content/Curriculum.luau\n-- refuses to load with. Handled anyway rather than assumed, because the check that makes\n-- it impossible lives in another file and could be relaxed there.\nlocal function subjectForSlot(ageYears: number, slot: number): SchoolSubject?\n	local list = Curriculum.ForAge(ageYears)\n	if #list == 0 then\n		return nil\n	end\n	local turn = ageYears * SCHOOL.LessonsPerYear + (slot - 1)\n	return list[turn % #list + 1]\nend\n\n-- The teacher in the classroom. One per player with a lesson, built from the\n-- `teacher` subject so it reuses the same rig path as every animal in the game.\n-- It is a smaller SceneService: walk in, stand facing the player, do whatever the\n-- last answer said it did, and hold that pose -- but it belongs to the lesson\n-- rather than to an event, so it lives here next to the loop that grades answers.\n-- The gesture the teacher performs is set by answer() and read by the run loop,\n-- which is the one channel of communication the two halves of this file need.\ntype Teacher = {\n	rig: SubjectRig,\n	motion: Motion,\n	-- The point it is standing on this frame, which moves when a wrong answer\n	-- makes it step back and comes home when it re-centres.\n	at: Vector3,\n	-- The front-of-room spot it belongs on between answers, which is also where a\n	-- re-centre is heading.\n	front: Vector3,\n	-- Where it walks in from, so the walk-out can retrace it if there were one.\n	-- (There is not: the teacher is despawned rather than walked away, because\n	-- nobody watches a classroom empty out.)\n	spawn: Vector3,\n	heading: number,\n	-- Ground covered and time since spawn, keyed the same way the animal gait is\n	-- keyed -- traveled for the walk, elapsed for everything done standing still.\n	travelled: number,\n	startedAt: number,\n	-- What the last answer called for, read once and cleared by the run loop.\n	-- \"right\" is a bow, \"wrong\" is a step back, \"settle\" is a calm nod, and\n	-- \"approach\" is a step toward the player before bowing. Nil when the loop\n	-- is idling.\n	gesture: \"right\" | \"wrong\" | \"settle\" | \"approach\"?,\n	-- Set by despawnTeacher(); every wait below checks it before touching the rig,\n	-- because the model may be gone by the time the loop next wakes.\n	cancelled: boolean,\n}\nlocal teachers: { [Player]: Teacher } = {}\n\n-- Everything school puts in the world lives in one folder, so a Studio session can see\n-- at a glance what is standing and clear the lot if a test left something behind.\n--\n-- Declared up here rather than down beside `buildRoom`, which is the only place it reads\n-- like it belongs, because `spawnTeacher` calls it and `spawnTeacher` is defined above\n-- that point. Lua resolves names at compile time: a call written above the `local function`\n-- that defines it does not see the local at all, it compiles to a *global* lookup and\n-- returns nil. Nothing catches that -- it is legal Luau, so `luau-compile` passes, and\n-- `rojo build` never parses the file -- and the symptom is not a load error but every\n-- lesson in the game dying on \"attempt to call a nil value\" the first time a teacher spawns.\nlocal function schoolFolder(): Folder\n	local existing = workspace:FindFirstChild(\"SchoolPads\")\n	if existing ~= nil and existing:IsA(\"Folder\") then\n		return existing\n	end\n	local folder = Instance.new(\"Folder\")\n	folder.Name = \"SchoolPads\"\n	folder.Parent = workspace\n	return folder\nend\n\n-- Facing and floor helpers, kept local to this file because the teacher only ever\n-- walks straight lines and turns toward a player. Three are the same three\n-- SceneService uses, copied small because the teacher never needs the scene's\n-- arc-search -- its spot is computed once, opposite the player from the room.\nlocal MIN_DIRECTION = 1e-3\n\nlocal function flatten(direction: Vector3): Vector3?\n	local flat = Vector3.new(direction.X, 0, direction.Z)\n	if flat.Magnitude < MIN_DIRECTION then\n		return nil\n	end\n	return flat.Unit\nend\n\nlocal function headingTo(direction: Vector3): number\n	return math.atan2(-direction.X, -direction.Z)\nend\n\nlocal function poseAt(at: Vector3, heading: number): CFrame\n	return CFrame.new(at) * CFrame.Angles(0, heading, 0)\nend\n\n-- Hands one frame to the teacher's motion. Present so every call site passes the\n-- same four things, and so a new field on the pose is added in one place.\nlocal function presentTeacher(teacher: Teacher, root: CFrame, moving: boolean, turning: number, settled: boolean)\n	teacher.motion.apply({\n		root = root,\n		traveled = teacher.travelled,\n		elapsed = os.clock() - teacher.startedAt,\n		moving = moving,\n		turning = turning,\n		settled = settled,\n	})\nend\n\n-- Walks the teacher between two floor points at its own pace, facing the way it is\n-- going. Returns false if the loop was cancelled part-way, which means the model is\n-- already gone and the caller must not touch it again.\nlocal function travelTeacher(teacher: Teacher, from: Vector3, to: Vector3): boolean\n	local direction = flatten(to - from)\n	local distance = (to - from).Magnitude\n	if direction == nil or distance < MIN_DIRECTION then\n		return true\n	end\n\n	local heading = headingTo(direction)\n	local covered = 0\n	while covered < distance do\n		local delta = RunService.Heartbeat:Wait()\n		if teacher.cancelled then\n			return false\n		end\n		local step = math.min(distance - covered, teacher.rig.subject.walkSpeed * delta)\n		covered += step\n		teacher.travelled += step\n		presentTeacher(teacher, poseAt(from:Lerp(to, covered / distance), heading), true, 0, false)\n	end\n	teacher.at = to\n	return true\nend\n\n-- One frame of standing still: eases the facing round toward the player and hands\n-- the frame over, the same tracking SceneService does for a subject -- a teacher\n-- that follows you perfectly is a turret, and one that never turns is a statue.\nlocal function standTeacher(player: Player, teacher: Teacher, settled: boolean): number\n	local heading = teacher.heading\n	local remaining = 0\n	local character = player.Character\n	if character ~= nil then\n		local target = flatten(character:GetPivot().Position - teacher.at)\n		if target ~= nil then\n			local desired = headingTo(target)\n			remaining = (desired - heading + math.pi) % (2 * math.pi) - math.pi\n			heading += remaining * Config.Scene.TurnResponsiveness\n		end\n	end\n	presentTeacher(teacher, poseAt(teacher.at, heading), false, remaining, settled)\n	return heading\nend\n\n-- Stands facing the player for a while, easing the turn on every frame.\nlocal function holdTeacher(player: Player, teacher: Teacher, seconds: number, settled: boolean)\n	local waited = 0\n	while waited < seconds do\n		local delta = RunService.Heartbeat:Wait()\n		if teacher.cancelled then\n			return\n		end\n		waited += delta\n		teacher.heading = standTeacher(player, teacher, settled)\n	end\nend\n\n-- The teacher's whole classroom life: walk in, then idle facing the player, doing\n-- whatever each answer asks of it. Deliberately a much smaller loop than a\n-- SceneService scene -- the teacher has no arc to place in and no walk-out to\n-- retrace, because it is despawned rather than sent away.\nlocal function runTeacher(player: Player, teacher: Teacher)\n	if not travelTeacher(teacher, teacher.spawn, teacher.front) then\n		return\n	end\n\n	while true do\n		local delta = RunService.Heartbeat:Wait()\n		if teacher.cancelled then\n			return\n		end\n\n		local gesture = teacher.gesture\n		if gesture ~= nil then\n			teacher.gesture = nil\n			if gesture == \"right\" then\n				-- A bow, held a beat, then eased back up. The motion owns how long\n				-- getting up takes, so the motion is asked -- the same rule as an\n				-- animal getting back to its feet after lying down.\n				holdTeacher(player, teacher, SCHOOL.TeacherNodSeconds, true)\n				if teacher.cancelled then\n					return\n				end\n				holdTeacher(player, teacher, SubjectMotion.SettleSeconds, false)\n			elseif gesture == \"settle\" then\n				-- A calm nod: shorter than a full bow, for questions that were\n				-- merely correct rather than genuinely earned.\n				holdTeacher(player, teacher, SCHOOL.TeacherNodSeconds * 0.5, true)\n				if teacher.cancelled then\n					return\n				end\n				holdTeacher(player, teacher, SubjectMotion.SettleSeconds, false)\n			elseif gesture == \"approach\" then\n				-- A step toward the player, a bow, then back to the front. The\n				-- mirror of \"wrong\" but in the other direction: the teacher\n				-- closes distance for the ones that were genuinely earned.\n				local playerPos = characterPosition(player)\n				local toward = if playerPos ~= nil then flatten(playerPos - teacher.at) else nil\n				if toward ~= nil then\n					local closer = teacher.at + toward * SCHOOL.TeacherBackStuds\n					if not travelTeacher(teacher, teacher.at, closer) then\n						return\n					end\n					holdTeacher(player, teacher, SCHOOL.TeacherNodSeconds, true)\n					if teacher.cancelled then\n						return\n					end\n					if not travelTeacher(teacher, teacher.at, teacher.front) then\n						return\n					end\n					holdTeacher(player, teacher, SubjectMotion.SettleSeconds, false)\n				end\n			elseif gesture == \"wrong\" then\n				-- A step back: away from the player, a beat standing there, then\n				-- back to the front. The step is what makes a wrong answer land in\n				-- the room rather than as a sentence on a panel.\n				local playerPos = characterPosition(player)\n				local toward = if playerPos ~= nil then flatten(playerPos - teacher.at) else nil\n				if toward ~= nil then\n					local back = teacher.at - toward * SCHOOL.TeacherBackStuds\n					if not travelTeacher(teacher, teacher.at, back) then\n						return\n					end\n					holdTeacher(player, teacher, SCHOOL.TeacherBackHoldSeconds, false)\n					if teacher.cancelled then\n						return\n					end\n					travelTeacher(teacher, teacher.at, teacher.front)\n				end\n			end\n			if teacher.cancelled then\n				return\n			end\n		end\n\n		teacher.heading = standTeacher(player, teacher, false)\n	end\nend\n\n-- Finds the teacher a spot ahead of the player where they are facing, walks the rig\n-- up to the front, and starts its loop. Best-effort in exactly the sense the scene\n-- placement is: a room with nowhere for the teacher is an ordinary outcome, and the\n-- lesson plays exactly as it did before teachers existed.\n--\n-- Anchored to the player's facing rather than to the room centre, because the player\n-- steps onto the room centre to start the lesson -- the direction from room to player\n-- is the one direction that tells you nothing about where a teacher should stand.\nlocal function spawnTeacher(player: Player): boolean\n	if not SCHOOL.TeacherEnabled then\n		return false\n	end\n	local subject = Subjects.ById[\"teacher\"]\n	local character = player.Character\n	local position = characterPosition(player)\n	if subject == nil or character == nil or position == nil then\n		return false\n	end\n\n	local direction = flatten(character:GetPivot().LookVector)\n	if direction == nil then\n		return false\n	end\n\n	local ignore = Ground.IgnoreList()\n	local teacherRadius = math.max(subject.bodyLength, subject.bodyWidth) / 2\n	local teacherHeight = subject.shoulderHeight\n	local playerHeight = Ground.BodyHeight(character)\n\n	local front = position + direction * SCHOOL.TeacherFrontStuds\n	local spawn = front + direction * SCHOOL.TeacherWalkInStuds\n\n	-- Where the teacher ends up and where they walk in from, both probed at the\n	-- teacher's own size rather than the player's -- an adult standing in a classroom is\n	-- a different footprint from a child sitting in one.\n	--\n	-- Neither is checked for a line to the other, and that is the behavior this has\n	-- always had rather than an oversight in passing: the walk in is pathfound, so a\n	-- teacher who has to come round a doorway is a teacher coming round a doorway, and a\n	-- straight-line test would refuse the room for a corner the walk handles fine.\n	local frontFloor = Ground.SpotAt(front, teacherRadius, teacherHeight, ignore)\n	local spawnFloor = Ground.SpotAt(spawn, teacherRadius, teacherHeight, ignore)\n	if frontFloor == nil or spawnFloor == nil then\n		return false\n	end\n	-- The *player* has to be able to see it, measured at the player's height. Separate\n	-- from the two above because it is a different question about a different body, and\n	-- it is the one that decides whether the lesson happens in the room or on a panel.\n	if not Ground.Reachable(position, frontFloor, playerHeight, ignore) then\n		return false\n	end\n\n	local rig = SubjectModels.Build(subject)\n	rig.model.Parent = schoolFolder()\n	local motion = SubjectMotion.Attach(rig)\n\n	local heading = headingTo(front - spawn)\n	rig.model:PivotTo(poseAt(spawnFloor, heading))\n\n	local teacher: Teacher = {\n		rig = rig,\n		motion = motion,\n		at = spawnFloor,\n		front = frontFloor,\n		spawn = spawnFloor,\n		heading = heading,\n		travelled = 0,\n		startedAt = os.clock(),\n		gesture = nil,\n		cancelled = false,\n	}\n	teachers[player] = teacher\n	task.spawn(runTeacher, player, teacher)\n	return true\nend\n\n-- Ends the teacher's presence immediately. Everything that despawns it goes through\n-- here, because the model must never be destroyed from inside its own loop -- the\n-- cancelled flag is set first and the loop checks it at every wait, which is the one\n-- thing that keeps a destroyed model from being posed again.\nlocal function despawnTeacher(player: Player)\n	local teacher = teachers[player]\n	if teacher == nil then\n		return\n	end\n	teachers[player] = nil\n	teacher.cancelled = true\n	teacher.motion.stop()\n	teacher.rig.model:Destroy()\nend\n\n-- Whether the room has been furnished yet. Built lazily rather than at Start, because\n-- the place point may stream in after the server does -- and a school that only exists\n-- if the building happened to be loaded at boot is a school that is missing on exactly\n-- the runs where it matters.\nlocal roomBuilt = false\nlocal attendAt: Vector3? = nil\n\n-- Studio harness switch. Off means no lesson can start and any in progress is ended,\n-- which is what makes it possible to test the shift loop in a world that also has a\n-- school in it without walking past the door and being pulled into a lesson.\nlocal enabled = true\n\n-- The sign over the door and the pad under it. Shared, built once, and never taken\n-- down -- the two things in this system that belong to the building rather than to a\n-- player.\n--\n-- The pad is deliberately still gold and still there for somebody who has used up\n-- their lessons for the year. A hiring post has to disappear once you take the job,\n-- because an offer that has been accepted is no longer an offer; a school door is not\n-- an offer, and a door that vanishes when you are done for the year would read as the\n-- building having gone. Stepping on it out of hours gets you a reason instead.\nlocal function buildRoom(): boolean\n	if roomBuilt then\n		return attendAt ~= nil\n	end\n\n	local place = PlaceService.Find(PLACE_ID)\n	if place == nil then\n		-- Already warned once by PlaceService, and warning again per tick would bury\n		-- the rest of the log. Retried on the next tick rather than given up on, in\n		-- case the building is still streaming in.\n		return false\n	end\n\n	roomBuilt = true\n	local folder = schoolFolder()\n	local at = place.part.Position\n\n	local sign = Instance.new(\"BillboardGui\")\n	sign.Name = \"SchoolSign\"\n	sign.Adornee = place.part\n	sign.Size = UDim2.new(12, 0, 2.4, 0)\n	sign.StudsOffsetWorldSpace = Vector3.new(0, Config.Work.Hiring.SignLiftStuds, 0)\n	-- Read from down the street to decide whether to walk over, not once you have\n	-- arrived -- the same job the hiring signs do, so it borrows their distance rather\n	-- than inventing a second number that would drift away from it.\n	sign.MaxDistance = Config.Work.Hiring.SignMaxDistanceStuds\n	sign.AlwaysOnTop = true\n	sign.Parent = place.part\n\n	local title = Instance.new(\"TextLabel\")\n	title.Name = \"Title\"\n	title.Size = UDim2.new(1, 0, 0.62, 0)\n	title.BackgroundTransparency = 1\n	title.Font = Enum.Font.GothamBold\n	title.TextScaled = true\n	title.TextColor3 = Color3.fromRGB(255, 250, 240)\n	title.Text = \"SCHOOL\"\n	title.Parent = sign\n\n	local terms = Instance.new(\"TextLabel\")\n	terms.Name = \"Terms\"\n	terms.Size = UDim2.new(1, 0, 0.38, 0)\n	terms.Position = UDim2.new(0, 0, 0.62, 0)\n	terms.BackgroundTransparency = 1\n	terms.Font = Enum.Font.GothamMedium\n	terms.TextScaled = true\n	terms.TextColor3 = Color3.fromRGB(245, 205, 120)\n	-- States its terms and lets you work out whether you meet them, exactly as the\n	-- hiring signs do. A sign that told a five-year-old they were too young would be\n	-- the building talking about the reader rather than about itself.\n	terms.Text = `Lessons for ages {SCHOOL.StartAge} to {SCHOOL.EndAge}`\n	terms.Parent = sign\n\n	-- The handle is deliberately dropped. Everything a ChoiceMarker hands back is for a\n	-- marker that comes down again -- somewhere to read its position from, a pulse to\n	-- cancel, a pad to destroy -- and this one never does. Holding a reference would\n	-- only imply there is a case where the school closes.\n	ChoiceMarkers.Build(folder, at, Config.Work.Hiring.PadRadiusStuds, {\n		label = \"Go to class\",\n		locked = false,\n	})\n	attendAt = at\n\n	-- The building itself, before any of the rooms that go inside it. Idempotent, and\n	-- deliberately called from three places -- here, ReadingService and BullyService -- so\n	-- that whichever system reaches the school first is the one that raises it and none of\n	-- them has to be ordered against the others.\n	--\n	-- Best effort. A school that fails to lay costs a nice-looking building and not the\n	-- afternoon: the pad, the sign and every verb below still work without it, because each\n	-- falls back to the bare place point when there is no room to sit in.\n	School.Build(at)\n\n	-- The lab, in the room the building named \"science\" -- or around the bare place point if\n	-- there is no building, which is what it always did. Built here rather than lazily on\n	-- the first Science lesson so that a Studio session can see the benches standing the\n	-- moment the world loads: a room that only appears once somebody is nine is a room\n	-- nobody can check.\n	--\n	-- Best effort, and a failure is not a failure of school: Lab.Build refusing means\n	-- Science refuses at the door with a reason, and every other subject carries on.\n	Lab.Build(School.RoomAt(\"science\") or at)\n\n	-- And the art room, for the same reasons in the same order -- a room in the same\n	-- building, standing before anybody is old enough to be sent to it, and free to fail\n	-- on its own without taking the rest of the timetable down with it. Laid around the\n	-- same point as the lab and much wider than it, which is deliberate: see\n	-- Config.School.Art.RoomRadiusStuds for why the walk from the easel to the paint\n	-- cupboard has to cost real seconds.\n	Studio.Build(School.RoomAt(\"art\") or at)\n\n	return true\nend\n\nlocal function destroyDiscs(lesson: Lesson)\n	local discs = lesson.discs\n	if discs == nil then\n		return\n	end\n	for _, disc in discs do\n		disc.marker.destroy()\n	end\n	lesson.discs = nil\nend\n\n-- One floor disc per answer, fanned around the player so the question is answered\n-- by walking. Reuses the same Ground probes EnactService and the workplace run\n-- before they put anything on a floor: the disc has to have floor under it, a\n-- body-sized gap to stand in, and a straight walk from where the player is.\n-- Err on rejecting -- the cost of rejecting is a panel question, and the cost\n-- of accepting is a disc half in a wall.\nlocal function placeDiscs(lesson: Lesson, player: Player): boolean\n	local character = player.Character\n	local root = if character ~= nil then character:FindFirstChild(\"HumanoidRootPart\") else nil\n	if root == nil or not root:IsA(\"BasePart\") then\n		return false\n	end\n	local center = root.Position\n\n	local ignore = Ground.IgnoreList()\n	local radius = Ground.BodyRadius(character)\n	local height = Ground.BodyHeight(character)\n\n	local count = #lesson.order\n	if count < 2 then\n		return false\n	end\n\n	-- Scattered like WorkSpots so the same question at the same spot does not fan\n	-- its discs into the same corners every time.\n	local bearings = Ground.ScatteredBearings(SCHOOL.DiscArcDegrees, count)\n\n	local placed: { Disc } = {}\n	-- The points of `placed`, kept alongside it because `Apart` takes positions and a\n	-- disc is more than one. Appended to at the same moment as `placed` below, and the\n	-- pair only stays honest because there is exactly one place either is added to.\n	local takenSpots: { Vector3 } = {}\n	for row, bearing in bearings do\n		local direction = CFrame.Angles(0, math.rad(bearing), 0) * Vector3.new(0, 0, -1)\n		local spot: Vector3? = nil\n		for _, step in { 1, 1.5, 2 } do\n			local candidate = center + direction * (SCHOOL.DiscDistanceStuds * step)\n\n			local floor = Ground.SpotAt(candidate, radius, height, ignore, center)\n			if floor == nil then\n				continue\n			end\n			if not Ground.Apart(floor, takenSpots, SCHOOL.DiscReachStuds * 2 + 1) then\n				continue\n			end\n\n			spot = floor\n			break\n		end\n		if spot == nil then\n			-- The floor refused a disc, so the whole question falls back to the\n			-- panel. Any discs already placed come down with it: a question is asked\n			-- one way or the other, never half over a fan and half over a row.\n			for _, disc in placed do\n				disc.marker.destroy()\n			end\n			lesson.discs = nil\n			return false\n		end\n\n		table.insert(takenSpots, spot)\n		table.insert(placed, {\n			at = spot,\n			marker = ChoiceMarkers.Build(schoolFolder(), spot, SCHOOL.DiscReachStuds, {\n				label = lesson.questions[lesson.index].answers[lesson.order[row]],\n				locked = false,\n			}),\n		})\n	end\n\n	lesson.discs = placed\n	return true\nend\n\n-- The rows to put in front of the player, in the shuffled order, or empty while there\n-- is nothing to answer -- the beat the teacher's line is up, and the moment a lesson\n-- has ended. Empty is what closes the panel, so this being right is what stops a\n-- question standing open over the explanation of the last one.\nlocal function rowsFor(lesson: Lesson): { OfferedChoice }\n	local rows: { OfferedChoice } = {}\n	if lesson.verdictLeft > 0 or lesson.index > #lesson.questions then\n		return rows\n	end\n	local question = lesson.questions[lesson.index]\n	for row, answerIndex in lesson.order do\n		-- Numbered by position on the panel rather than by which answer it is. The\n		-- client is never told which of the authored answers it is looking at, so a\n		-- client reading its own traffic learns the order it was already shown and\n		-- nothing else.\n		table.insert(rows, { id = tostring(row), label = question.answers[answerIndex], cost = nil, locked = lesson.discs ~= nil })\n	end\n	return rows\nend\n\nlocal function stateFor(player: Player): LessonState?\n	local lesson = lessons[player]\n	if lesson ~= nil and lesson.index <= #lesson.questions then\n		local question = lesson.questions[lesson.index]\n		return {\n			ask = question.ask,\n			answers = rowsFor(lesson),\n			index = lesson.index,\n			count = #lesson.questions,\n			right = lesson.right,\n			secondsLeft = math.max(0, lesson.secondsLeft),\n			secondsTotal = SCHOOL.SecondsPerQuestion,\n			verdict = lesson.verdictText,\n			wasRight = lesson.verdictRight,\n			physical = lesson.discs ~= nil,\n		}\n	end\n\n	-- The skip offer. Rendered as a lesson state with two answers and no clock, because\n	-- it is the same panel asking the same shape of question and inventing a second\n	-- remote for it would be a second surface to keep in step. Index zero is what marks\n	-- it out from a real question: a lesson counts from one, so an answer coming back\n	-- against zero can only be this.\n	local door = doors[player]\n	if door ~= nil then\n		local name = subjectNameOf(door.subjectId)\n		return {\n			ask = `{name} today, and you have finished with it.`,\n			answers = {\n				-- The costs are in the notes rather than the labels, so the two payouts sit\n				-- in one column and can be read against each other at a glance. That\n				-- comparison is the entire decision.\n				{\n					id = \"sit\",\n					label = \"Sit the lesson anyway\",\n					cost = nil,\n					note = `up to +{SCHOOL.SmartsPerGoodLesson} smarts`,\n					locked = false,\n				},\n				{\n					id = \"skip\",\n					label = \"Skip it\",\n					cost = nil,\n					note = `+{Report.SmartsFor(Report.Skipped)} smarts, no lesson`,\n					locked = false,\n				},\n			},\n			index = 0,\n			count = 0,\n			right = 0,\n			secondsLeft = 0,\n			secondsTotal = 0,\n			verdict = nil,\n			wasRight = false,\n			physical = false,\n		}\n	end\n\n	local notice = notices[player]\n	if notice ~= nil then\n		return {\n			ask = \"School\",\n			-- Nothing to answer, which is also what tells the client to close whatever\n			-- panel it has open: this is a message, not a question.\n			answers = {},\n			-- Zeroes throughout: this is a message, not a position in a lesson, and the\n			-- client reads a zero total as \"draw no clock\". See the type.\n			index = 0,\n			count = 0,\n			right = 0,\n			secondsLeft = 0,\n			secondsTotal = 0,\n			verdict = notice.text,\n			wasRight = notice.good,\n		}\n	end\n\n	return nil\nend\n\nlocal function push(player: Player)\n	local state = stateFor(player)\n	-- A digest rather than a deep compare, and it has to name every field that is\n	-- drawn: a state whose only change is the second on the clock must still be sent,\n	-- and one whose only change is nothing at all must not.\n	local digest = if state == nil\n		then \"none\"\n		else `{state.ask}|{state.index}/{state.count}|{state.right}|{math.floor(state.secondsLeft * 4)}|`\n			.. `{tostring(state.verdict)}|{tostring(state.wasRight)}|{#state.answers}|{tostring(state.physical)}`\n	if pushed[player] == digest then\n		return\n	end\n	pushed[player] = digest\n	LessonUpdatedRemote:FireClient(player, state)\nend\n\n-- A line with no lesson behind it. Replaces whatever was showing, because the newest\n-- thing the school has to say is always the one worth reading.\nlocal function notice(player: Player, text: string, good: boolean)\n	notices[player] = { text = text, good = good, secondsLeft = SCHOOL.VerdictSeconds }\n	push(player)\nend\n\n-- The line that says what this life is closest to finishing, or nil when nothing is\n-- close. Only ever about the subjects on the current timetable: a rung in a subject that\n-- will not be taught for another three years is not a near miss, it is trivia.\n--\n-- One line and only when it is true, which is the whole discipline of it. A card that\n-- printed \"keep going!\" every year would be a card nobody read the bottom of by twelve.\nlocal function nearMissFor(data: LifeData): string?\n	-- A ladder that promotes on a single pass has no \"one away\" to be -- everybody not\n	-- topped out is always one away -- and the line would be on every card forever.\n	if Mastery.PassesPerLevel <= 1 then\n		return nil\n	end\n\n	for _, subject in Curriculum.ForAge(ageYearsOf(data)) do\n		if not Mastery.IsTopped(data, subject.id) and Mastery.PassesOf(data, subject.id) == Mastery.PassesPerLevel - 1 then\n			-- Not named `next`: that is a Lua global, and shadowing it here is legal,\n			-- silent, and exactly the sort of thing that surprises somebody later.\n			local rung = Mastery.LevelOf(data, subject.id) + 1\n			if rung >= Mastery.Levels then\n				-- The only near miss that changes what the player can *do*, so it says so\n				-- rather than naming the rung. A number is a smaller thing to be told than\n				-- an afternoon back.\n				return `One more good {subject.name} lesson finishes it for good.`\n			end\n			return `One more good {subject.name} lesson makes it level {rung}.`\n		end\n	end\n	return nil\nend\n\n-- Everything this life's school years came to, counted. Counted rather than listed\n-- year by year: by seventeen a list is twelve entries of muted text nobody reads to the\n-- end, and what a record actually says is \"three good years and two thrown away\".\nlocal function recordLineFor(data: LifeData): string?\n	local parts: { string } = {}\n	for _, entry in Report.Tally(data) do\n		local years = if entry.years == 1 then \"1 year\" else `{entry.years} years`\n		table.insert(parts, `{years} {entry.grade}`)\n	end\n	if #parts == 0 then\n		return nil\n	end\n	return `School so far: {table.concat(parts, \", \")}.`\nend\n\n-- Composes a staged card into the thing the player reads.\n--\n-- Takes the report rather than reading it off the profile, so the harness can print a\n-- card for a year without one having to be staged -- and so this function has no way to\n-- accidentally hand over a card that is not the one being asked about.\nlocal function buildCard(data: LifeData, report: SchoolYearRecord): ReportCard\n	local rows: { OfferedChoice } = {}\n\n	-- Every slot of the year, not every lesson sat. The empty ones are most of what a bad\n	-- year's card has to say, and naming the subject that was on -- which the timetable can\n	-- still answer for a year that is over -- is the difference between \"you missed a\n	-- lesson\" and \"you missed Music\".\n	local slots = math.max(SCHOOL.LessonsPerYear, #report.lessons)\n	for slot = 1, slots do\n		local lesson = report.lessons[slot]\n		if lesson == nil then\n			local subject = subjectForSlot(report.ageYears, slot)\n			local name = if subject ~= nil then subject.name else \"Nothing\"\n			table.insert(rows, {\n				id = `slot{slot}`,\n				label = `{name} — {Report.AbsentWord}`,\n				cost = nil,\n				-- An em dash rather than \"0 smarts\". Nothing happened, and a zero in the\n				-- column where every other row has a payout reads as a lesson that paid\n				-- badly rather than as one that never took place.\n				note = \"—\",\n				locked = true,\n			})\n		else\n			-- The stored subject wins over the timetable's for a slot that was actually\n			-- sat. They agree today; they would not for a life saved before a subject was\n			-- moved, and what happened beats what was scheduled.\n			local label = `{subjectNameOf(lesson.subjectId)} — {Report.WordFor(lesson.band)}`\n			if lesson.level ~= nil then\n				label ..= `, level {lesson.level} of {Mastery.Levels}`\n			end\n			table.insert(rows, {\n				id = `slot{slot}`,\n				label = label,\n				cost = nil,\n				note = if lesson.smarts > 0 then `+{lesson.smarts} smarts` else \"no smarts\",\n				locked = true,\n			})\n		end\n	end\n\n	-- The one row that is not locked, and the only thing on the card that can be pressed.\n	-- The client does not read this id -- there is nothing else to press, so it fires the\n	-- acknowledgement whatever comes back -- but it is named rather than blank because a\n	-- row with no id is a row nothing can be said about in a log.\n	table.insert(rows, { id = \"read\", label = \"Continue\", cost = nil, note = nil, locked = false })\n\n	local footnotes: { string } = {}\n	local near = nearMissFor(data)\n	if near ~= nil then\n		table.insert(footnotes, near)\n	end\n	local record = recordLineFor(data)\n	if record ~= nil then\n		table.insert(footnotes, record)\n	end\n\n	return {\n		ageYears = report.ageYears,\n		title = `Age {report.ageYears} report card: {report.grade}`,\n		rows = rows,\n		footnote = table.concat(footnotes, \"\\n\"),\n	}\nend\n\n-- The card in this player's hands right now, or nil. Both halves have to be true: one\n-- staged on the profile, and the player standing where it is handed over.\nlocal function cardFor(player: Player): ReportCard?\n	if not cards[player] then\n		return nil\n	end\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return nil\n	end\n	local data = Lives.Active(profile.Data)\n	local report = data.pendingReport\n	if report == nil then\n		return nil\n	end\n	return buildCard(data, report)\nend\n\n-- The last card pushed to each player, so the panel is not rebuilt four times a second\n-- under somebody standing still reading it. Only the age is digested because a card is\n-- immutable once staged: the year it reports is over, and nothing that could change a row\n-- can happen without a birthday replacing the whole card anyway.\nlocal pushedCards: { [Player]: string } = {}\n\n-- The year's timetable, as the player sees it.\n--\n-- Built from the same subjectForSlot the lesson loop calls, so the panel cannot drift from\n-- what actually gets taught -- if the rotation changes, both change together. `lessonsThisYear`\n-- is what separates done from still to come: it counts the afternoons already sat, so slot\n-- N is behind you exactly when N <= that count.\nlocal function timetableFor(player: Player): Types.Timetable?\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return nil\n	end\n	local data = Lives.Active(profile.Data)\n	local ageYears = ageYearsOf(data)\n	local entries: { Types.TimetableEntry } = {}\n	for slot = 1, SCHOOL.LessonsPerYear do\n		local subject = subjectForSlot(ageYears, slot)\n		if subject ~= nil then\n			local state: \"done\" | \"now\" | \"later\"\n			if slot <= data.lessonsThisYear then\n				state = \"done\"\n			elseif slot == data.lessonsThisYear + 1 then\n				state = \"now\"\n			else\n				state = \"later\"\n			end\n			table.insert(entries, {\n				slot = slot,\n				subjectId = subject.id,\n				name = subject.name,\n				blurb = subject.blurb,\n				state = state,\n			})\n		end\n	end\n	if #entries == 0 then\n		return nil\n	end\n	return { ageYears = ageYears, entries = entries }\nend\n\nlocal pushedTimetables: { [Player]: string } = {}\n\nlocal function pushTimetable(player: Player)\n	local table_ = timetableFor(player)\n	-- Digested on the year and the progress through it, which is everything that can change\n	-- what is drawn. Without this the panel would be resent every tick of the school clock.\n	local digest = if table_ == nil\n		then \"none\"\n		else `{table_.ageYears}|{#table_.entries}|`\n			.. table.concat((function()\n				local marks = {}\n				for _, entry in table_.entries do\n					table.insert(marks, entry.state)\n				end\n				return marks\n			end)(), \",\")\n	if pushedTimetables[player] == digest then\n		return\n	end\n	pushedTimetables[player] = digest\n	TimetableUpdatedRemote:FireClient(player, table_)\nend\n\nlocal function pushCard(player: Player)\n	local card = cardFor(player)\n	local digest = if card == nil then \"none\" else `card:{card.ageYears}`\n	if pushedCards[player] == digest then\n		return\n	end\n	pushedCards[player] = digest\n	ReportCardUpdatedRemote:FireClient(player, card)\nend\n\n-- Why this player cannot sit a lesson right now, or nil if they can. Written as the\n-- sentence the player reads, because there is exactly one caller and a reason code\n-- would only ever be turned back into this string.\nlocal function refusalFor(data: LifeData): string?\n	if not enabled then\n		return \"School is closed.\"\n	end\n	if not data.alive then\n		return \"School is closed.\"\n	end\n\n	local age = ageYearsOf(data)\n	if age < SCHOOL.StartAge then\n		return `You start school at {SCHOOL.StartAge}.`\n	end\n	if age > SCHOOL.EndAge then\n		return \"You are done with school.\"\n	end\n	if data.lessonsThisYear >= SCHOOL.LessonsPerYear then\n		return `You have had your {SCHOOL.LessonsPerYear} lessons this year. Come back next year.`\n	end\n\n	return nil\nend\n\n-- Puts whichever question is now current in front of the player. When physical\n-- lessons are enabled the answers go down as discs on the classroom floor and the\n-- panel rows arrive locked; when the floor refuses discs or the switch is off the\n-- panel rows are the answer, as before.\nlocal function askCurrent(lesson: Lesson, player: Player)\n	destroyDiscs(lesson)\n\n	local question = lesson.questions[lesson.index]\n\n	-- Shuffled per question, and the shuffle is on the *order* rather than on the\n	-- answers themselves, so `correct` keeps meaning what the content file said it\n	-- meant. Shuffling a copy of the answers and re-finding the right one by string\n	-- match would break the moment two questions shared an answer.\n	local order: { number } = {}\n	for index = 1, #question.answers do\n		table.insert(order, index)\n	end\n	for index = #order, 2, -1 do\n		local swap = math.random(index)\n		order[index], order[swap] = order[swap], order[index]\n	end\n\n	lesson.order = order\n	lesson.secondsLeft = SCHOOL.SecondsPerQuestion\n	lesson.verdictLeft = 0\n	lesson.verdictText = nil\n	lesson.verdictRight = false\n\n	if SCHOOL.PhysicalLessons then\n		placeDiscs(lesson, player)\n	end\nend\n\n-- Ends the lesson and grades it. `reason` is why it stopped, and it changes the\n-- sentence but never the arithmetic: a lesson walked out of halfway through is graded\n-- on all of its questions, not on the ones that were reached. Leaving early is a way\n-- of getting them wrong.\nlocal function finish(player: Player, data: LifeData, lesson: Lesson, reason: string)\n	destroyDiscs(lesson)\n	despawnTeacher(player)\n	lessons[player] = nil\n\n	local count = #lesson.questions\n	local share = if count > 0 then lesson.right / count else 0\n\n	-- Which band and what it pays both come from school/Report rather than from an\n	-- if-chain here. ScienceService had a byte-identical copy of that chain, and two\n	-- copies of \"what counts as a good afternoon\" is how a report card ends up disagreeing\n	-- with the closing line the player just read.\n	local band = Report.BandFor(share)\n	local gained = Report.SmartsFor(band)\n\n	if gained ~= 0 then\n		StatService.AddStat(player, \"smarts\", gained)\n	end\n\n	-- Counted however it ended, including walked out of. Turning up is what the year's\n	-- cap is counting, and a player who could start a lesson, leave, and start another\n	-- would be able to re-roll the questions until they got an easy five.\n	data.lessonsThisYear += 1\n	-- Showing up for school earns the right to be interrupted by the world. The\n	-- counter is per-year, but the autonomy gate is per-chapter, so the points\n	-- bank across the whole band and do not reset at the year line.\n	EventService.AwardAutonomy(player, 1)\n\n	-- Banks toward this subject's mastery on the same ladder Science climbs. Quiz\n	-- subjects had no ladder at all until now, which meant five of the six could never be\n	-- finished with -- you sat Music at seventeen exactly as you sat it at six.\n	--\n	-- What a rung buys inside a quiz is, honestly, nothing yet. That is a debt and not a\n	-- design: giving a level \"one fewer question\" or \"five more seconds\" would be a bigger\n	-- number for the same decision, which is the numbers-only progression this rebuild\n	-- exists to remove. The in-lesson reward arrives with each subject's real verb. What\n	-- the rung buys *today* is the right to stop sitting the lesson, and that is worth\n	-- having on its own -- see the skip at the door below.\n	local before = Mastery.LevelOf(data, lesson.subjectId)\n	local level, rose = Mastery.Record(data, lesson.subjectId, share)\n\n	-- And onto the year's record, which is what the card handed over next birthday is\n	-- drawn from. Written here rather than derived later because none of it survives the\n	-- year otherwise: `smarts` is a running total that says nothing about which afternoon\n	-- moved it, and mastery says where the player ended up rather than how they got there.\n	--\n	-- The promotion is passed only when there was one. A row reading \"level 3\" against a\n	-- lesson that did not earn it would credit the wrong afternoon.\n	Report.RecordLesson(data, lesson.subjectId, band, gained, if rose then level else nil)\n\n	local scored = `{lesson.right} of {count} right`\n	local reward = if gained > 0 then `. +{gained} smarts.` else \".\"\n	local line = if reason == \"left\"\n		then `You walked out. {scored}{reward}`\n		else `Lesson over. {scored}{reward}`\n\n	-- The promotion is said out loud and it replaces the score line rather than following\n	-- it, because it is the more important of the two and two notices in a row means the\n	-- first is never read. Topping out gets its own sentence: it is the only one that\n	-- changes what the player can do tomorrow, and a player who is not told they may now\n	-- skip will never find out -- the panel at the door only appears if they walk back.\n	if rose then\n		local name = subjectNameOf(lesson.subjectId)\n		line = if level >= Mastery.Levels\n			then `{scored}{reward} You have finished with {name} -- you can skip it from now on.`\n			else `{scored}{reward} {name} level {level} of {Mastery.Levels}.`\n	elseif before >= Mastery.Levels and reason ~= \"left\" then\n		-- Sat a subject they had already beaten. Worth a word: they chose to, the smarts\n		-- were real, and silence here reads as the skip having failed to work.\n		line = `{scored}{reward} You did not have to sit that one.`\n	end\n\n	notice(player, line, gained > 0 or rose)\nend\n\n-- One question answered, by picking row `row` off the panel -- or not answered at all,\n-- when `row` is nil and the clock ran out. Both go through here, because running out of\n-- time is a wrong answer with the same consequences and should read as one.\nlocal function answer(player: Player, lesson: Lesson, row: number?)\n	local question = lesson.questions[lesson.index]\n\n	local chose = if row ~= nil then lesson.order[row] else nil\n	local correct = chose == question.correct\n	if correct then\n		lesson.right += 1\n		-- Academics, per right answer. Time running out arrives here as `row == nil` and\n		-- is a wrong answer to this branch exactly as it is to the lesson's own grade,\n		-- which is the whole reason both paths were routed through this one function.\n		SkillService.Award(player, \"academics\", Config.Skills.Awards.LessonCorrect, \"right answer\")\n	end\n\n	-- The teacher reads the verdict in the room while it is read on the panel. The\n	-- gesture is a request the run loop picks up on its next frame; if the teacher\n	-- is mid-walk-in it performs it once it arrives, which is late but never lost.\n	-- A correct answer with a per-question reaction uses that instead of the\n	-- default bow, so the teacher's body language varies across the lesson.\n	local teacher = teachers[player]\n	if teacher ~= nil then\n		if correct and question.reaction ~= nil then\n			teacher.gesture = question.reaction\n		else\n			teacher.gesture = if correct then \"right\" else \"wrong\"\n		end\n	end\n\n	-- The teacher's line either way, which is the one thing that makes this school\n	-- rather than a quiz: getting it wrong should still leave you knowing the answer.\n	-- Prefixed with the verdict so the row reads as a reply to what you just did rather\n	-- than as a fact appearing on screen.\n	local opening = if correct then \"Right.\" elseif chose ~= nil then \"Not quite.\" else \"Time.\"\n	lesson.verdictText = `{opening} {question.because}`\n	lesson.verdictRight = correct\n	lesson.verdictLeft = SCHOOL.VerdictSeconds\n	lesson.secondsLeft = 0\n\n	-- The index deliberately does not move here. It advances when the explanation\n	-- expires, so for the whole beat the line is up the row still says \"3 of 5\" about\n	-- the question the line is explaining -- rather than about the one that has not\n	-- been asked yet.\n	push(player)\nend\n\n-- What is on today: the next slot of this year's timetable, which is the one after the\n-- lessons already sat.\nlocal function subjectFor(data: LifeData): SchoolSubject?\n	return subjectForSlot(ageYearsOf(data), data.lessonsThisYear + 1)\nend\n\n-- Starts a lesson. Only fails for a reason worth saying out loud -- the caller has\n-- already checked everything about the player, and there is no longer a room to fail\n-- against.\n--\n-- Seven shapes come out of here, and which one depends entirely on the subject's verb. A\n-- \"quiz\" subject runs the loop in the rest of this file. A \"procedure\" subject hands the\n-- whole afternoon to ScienceService, a \"hunt\" subject to GeographyService, a \"copy\" subject\n-- to ArtService, a \"build\" subject to ReadingService, a \"keep\" subject to MusicService and a\n-- \"drill\" subject to PEService --\n-- and this file does nothing further with any of them, including the smarts and the yearly\n-- count, which each verb pays and spends itself. That split is deliberate: the alternative\n-- is a School that knows how every verb is scored, which is the file that would have to be\n-- edited six times over.\n--\n-- Math is the only subject still on the quiz path, and that is a decision rather than a\n-- debt -- see content/Curriculum.luau.\nlocal function beginLesson(player: Player, data: LifeData, room: Vector3): boolean\n	local subject = subjectFor(data)\n	if subject == nil then\n		notice(player, \"There is nothing on today.\", false)\n		return false\n	end\n\n	if subject.verb == \"procedure\" then\n		local ok, refusal = ScienceService.Begin(player, data)\n		if not ok then\n			notice(player, refusal or \"The lab is closed today.\", false)\n			return false\n		end\n		-- Cleared so the science HUD is not opening underneath a school line about a\n		-- lesson that is not the one running.\n		notices[player] = nil\n		push(player)\n		return true\n	end\n\n	if subject.verb == \"hunt\" then\n		local ok, refusal = GeographyService.Begin(player, data)\n		if not ok then\n			notice(player, refusal or \"There is no geography today.\", false)\n			return false\n		end\n		-- Cleared for the same reason as above: the hunt takes the screen from here, and\n		-- a school line left underneath it is a line about a lesson that is not running.\n		--\n		-- No teacher is spawned and no scene is drawn, unlike a quiz. That is the verb:\n		-- the errand happens in the town, and a classroom built around a player who is\n		-- about to walk out of it is furniture nobody will be in the room to see.\n		notices[player] = nil\n		push(player)\n		return true\n	end\n\n	if subject.verb == \"copy\" then\n		local ok, refusal = ArtService.Begin(player, data)\n		if not ok then\n			notice(player, refusal or \"The art room is closed today.\", false)\n			return false\n		end\n		-- Cleared for the same reason as the two above.\n		--\n		-- No teacher and no scene here either, but for the opposite reason to Geography's:\n		-- the art room is already built and already standing a few studs away, so a\n		-- classroom drawn on top of it would be two rooms occupying one lesson. The player\n		-- walks to the easel; that walk is the opening of the verb.\n		notices[player] = nil\n		push(player)\n		return true\n	end\n\n	if subject.verb == \"build\" then\n		local ok, refusal = ReadingService.Begin(player, data)\n		if not ok then\n			notice(player, refusal or \"The reading room is closed today.\", false)\n			return false\n		end\n		-- Cleared for the same reason as the three above: the board takes the screen from\n		-- here, and a school line left underneath it is a line about a lesson that is not\n		-- running.\n		--\n		-- No teacher and no scene, for the art room\\'s reason rather than geography\\'s: the\n		-- reading room is already built and already standing a few studs away, so a classroom\n		-- drawn on top of it would be two rooms occupying one lesson. The walk to the desk is\n		-- the opening of the verb.\n		notices[player] = nil\n		push(player)\n		return true\n	end\n\n	if subject.verb == \"keep\" then\n		local ok, refusal = MusicService.Begin(player, data)\n		if not ok then\n			notice(player, refusal or \"The music room is closed today.\", false)\n			return false\n		end\n		-- Cleared for the same reason as the three above, and no teacher or scene for the same\n		-- reason the art room gets none: the music room is already standing a few studs away,\n		-- and a classroom drawn on top of it would be two rooms in one lesson.\n		notices[player] = nil\n		push(player)\n		return true\n	end\n\n	if subject.verb == \"drill\" then\n		local ok, refusal = PEService.Begin(player, data)\n		if not ok then\n			notice(player, refusal or \"There is no PE today.\", false)\n			return false\n		end\n		-- Cleared for the same reason as the others, and no teacher or scene for geography's\n		-- reason rather than the art room's: the drill happens out on the track, and a\n		-- classroom built around a player who is about to walk out of it is furniture nobody\n		-- will be in the room to see.\n		notices[player] = nil\n		push(player)\n		return true\n	end\n\n	local questions = Lessons.For(ageYearsOf(data), SCHOOL.QuestionsPerLesson)\n	if #questions == 0 then\n		-- Impossible if the content file loaded, which checks every age has enough\n		-- written for it. Reachable only if the bank is emptied without the check being\n		-- updated, and the honest thing to do is say so rather than start a lesson with\n		-- nothing in it.\n		notice(player, \"There is nothing on today.\", false)\n		return false\n	end\n\n	local lesson: Lesson = {\n		room = room,\n		subjectId = subject.id,\n		questions = questions,\n		index = 1,\n		right = 0,\n		order = {},\n		secondsLeft = SCHOOL.SecondsPerQuestion,\n		verdictLeft = 0,\n		verdictText = nil,\n		verdictRight = false,\n	}\n\n	askCurrent(lesson, player)\n\n	-- The teacher walks in as the first question opens. Best-effort, and a lesson\n	-- with nowhere to put the teacher is still a lesson -- the same rule the scene\n	-- placement lives by.\n	spawnTeacher(player)\n\n	-- Cleared only once the first question is actually up, so the refusal above is the\n	-- last thing on the row rather than being wiped by the push from a lesson that\n	-- failed to start.\n	notices[player] = nil\n	lessons[player] = lesson\n	push(player)\n	return true\nend\n\n-- Taking the skip. Spends the lesson off the year and pays what an ordinary pass pays.\n--\n-- The payout is deliberately the middle band rather than the top one. A player who has\n-- topped a subject out can reliably score above GoodShare in it -- that is what topping\n-- it out means -- so paying SmartsPerGoodLesson here would make skipping strictly better\n-- than attending, and the lesson would be dead content rather than a choice. Paying the\n-- pass rate makes the trade honest: the skip costs you a point and buys you the\n-- afternoon, and which of those is worth more is a real question that changes with how\n-- much of the map you have left to see.\n--\n-- It counts as attendance, which is the other half of the deal. Turning up and proving\n-- you know it already is turning up, so the missed-year penalty must not fire on a\n-- player who skipped -- being punished for the thing you earned would be the single\n-- worst sentence this system could say.\nlocal function takeSkip(player: Player, data: LifeData, subjectId: string)\n	data.lessonsThisYear += 1\n	EventService.AwardAutonomy(player, 1)\n\n	local gained = Report.SmartsFor(Report.Skipped)\n	if gained ~= 0 then\n		StatService.AddStat(player, \"smarts\", gained)\n	end\n\n	-- Recorded as its own band rather than as an ordinary pass. They are worth the same\n	-- smarts and they are not the same afternoon, and a card that could not tell them\n	-- apart would report a year spent elsewhere as a year of lessons.\n	Report.RecordLesson(data, subjectId, Report.Skipped, gained, nil)\n\n	local reward = if gained > 0 then ` +{gained} smarts.` else \"\"\n	notice(player, `You skipped {subjectNameOf(subjectId)}.{reward} That is one lesson off the year.`, gained > 0)\nend\n\n-- A row picked off the panel. Checked against the question that is actually live\n-- rather than against whatever the client thinks it is answering: the twenty seconds\n-- are real, and an answer clicked as the clock ran out has to lose to the clock.\nlocal function onAnswerRequested(player: Player, index: unknown, answerId: unknown)\n	if type(index) ~= \"number\" or type(answerId) ~= \"string\" then\n		return\n	end\n\n	-- The skip offer, which is not a question in a lesson and is answered before one is\n	-- looked for. Index zero is the marker -- see stateFor -- and a lesson's questions\n	-- count from one, so the two can never be confused for each other.\n	local door = doors[player]\n	if door ~= nil and index == 0 then\n		doors[player] = nil\n\n		local profile = DataService.GetProfile(player)\n		if profile == nil then\n			push(player)\n			return\n		end\n		local data = Lives.Active(profile.Data)\n\n		-- Re-checked here rather than trusted from when the panel was drawn. The offer may\n		-- have been on screen for a while, and a birthday or a `/school year` in between\n		-- can have closed the door behind it. Everything the client sends is a request.\n		local refusal = refusalFor(data)\n		if refusal ~= nil then\n			notice(player, refusal, false)\n			return\n		end\n\n		if answerId == \"skip\" then\n			if not Mastery.IsTopped(data, door.subjectId) then\n				-- Only reachable from a client that made the row up, since the offer is only\n				-- ever drawn for a topped subject. Refused by name anyway: a silent drop here\n				-- would look exactly like the button not working.\n				notice(player, `You have not finished with {subjectNameOf(door.subjectId)} yet.`, false)\n				return\n			end\n			takeSkip(player, data, door.subjectId)\n			return\n		end\n\n		if answerId ~= \"sit\" then\n			-- A row id the panel never drew. Nothing to say to a real player, and nothing\n			-- to do but put the offer back up, which the next tick does.\n			push(player)\n			return\n		end\n\n		-- Sitting it. Falls through to the ordinary start, so a lesson chosen from the door\n		-- is in every respect the lesson that would have started on its own -- the offer\n		-- decides whether there is a lesson, never what one is. That is also why this needs\n		-- no branch for Science: a topped-out procedure subject goes through here and comes\n		-- out in the lab, exactly as it would have without the offer in front of it.\n		local at = attendAt\n		if at == nil then\n			notice(player, \"The school is not in the world right now.\", false)\n			return\n		end\n		-- Standing at the school is the one condition the offer itself does not carry. The\n		-- panel comes down within a tick of walking away, but a click already in flight\n		-- when it does would otherwise start a lesson from wherever the player had got to.\n		local position = characterPosition(player)\n		if position == nil or Ground.FlatDistance(position, at) > SCHOOL.AttendRadiusStuds then\n			notice(player, \"You walked off before you answered.\", false)\n			return\n		end\n\n		beginLesson(player, data, at)\n		return\n	end\n\n	local lesson = lessons[player]\n	if lesson == nil then\n		return\n	end\n	-- Both halves of \"this question, still open\". The index catches an answer to the\n	-- question before this one; the verdict catches one clicked during the beat the\n	-- teacher's line is up, which is the same click arriving a fraction later.\n	if lesson.index ~= index or lesson.verdictLeft > 0 or lesson.index > #lesson.questions then\n		return\n	end\n\n	local row = tonumber(answerId)\n	if row == nil or lesson.order[row] == nil then\n		return\n	end\n	answer(player, lesson, row)\nend\n\nlocal function tickPlayer(player: Player, elapsed: number)\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return\n	end\n	local data = Lives.Active(profile.Data)\n	local position = characterPosition(player)\n\n	local lesson = lessons[player]\n\n	if lesson == nil then\n		-- Whether the player has left the pad, for the two things that may already be up in\n		-- front of them. Read once because both ask the identical question and a second\n		-- probe a few lines apart could honestly answer it differently.\n		--\n		-- Only sound for a panel that is *already* open, which is the only thing it is used\n		-- for. `attendAt` is filled in by buildRoom further down, so on the first tick of a\n		-- session this reads nil -- harmless, because nothing can be open yet, and the\n		-- lower half of this branch re-reads it after the room has been built.\n		local standingAt = attendAt\n		local walkedOff = position == nil\n			or standingAt == nil\n			or Ground.FlatDistance(position, standingAt) > SCHOOL.AttendRadiusStuds\n\n		-- The card in the player's hands, and it outranks everything else the school could\n		-- be doing. It is last year's business being finished before this year's is\n		-- started, which is the order it happens in a real school and, more to the point,\n		-- the order that stops a lesson beginning underneath something being read.\n		--\n		-- Comes down the moment they walk off, and goes back up when they come back: the\n		-- card is still staged on the profile, and the only thing that puts it away is the\n		-- player pressing the button on it.\n		if cards[player] then\n			if walkedOff then\n				cards[player] = nil\n				pushCard(player)\n		pushTimetable(player)\n			end\n			return\n		end\n\n		-- The skip offer comes down the moment the player walks off the pad, and before\n		-- anything else is considered. A panel asking whether to sit today's lesson,\n		-- still up while its owner is halfway across town, is the game talking about a\n		-- building that is no longer in front of them.\n		local door = doors[player]\n		if door ~= nil then\n			if walkedOff then\n				doors[player] = nil\n				push(player)\n			end\n			-- Returns either way. An open offer is a question the player has been asked and\n			-- has not answered, and starting the lesson out from under it -- which is what\n			-- falling through to the pad check below would do -- would answer it for them.\n			return\n		end\n\n		local held = notices[player]\n		if held ~= nil then\n			held.secondsLeft -= elapsed\n			if held.secondsLeft <= 0 then\n				notices[player] = nil\n			end\n			push(player)\n			-- Deliberately returns: the attend pad is not read while a line is being\n			-- held, so somebody standing on it after a refusal reads the refusal instead\n			-- of being refused again on every tick for as long as they stand there.\n			return\n		end\n\n		if position == nil or not buildRoom() then\n			return\n		end\n\n		-- A Science lesson is a lesson, and it is not one of these. Without this the pad\n		-- is read on every tick of a lab session -- and the lab centre is the pad, so the\n		-- player is standing on it the whole time -- and school would try to start a\n		-- second lesson four times a second for the length of the procedure.\n		if ScienceService.IsRunning(player) then\n			return\n		end\n\n		-- And so is a Geography errand. The failure here is the same one but arrives\n		-- later: a hunt begins on the school pad and ends wherever the last destination\n		-- was, so the first tick after the player walks back into school would start a\n		-- second lesson on top of the one they are still on.\n		if GeographyService.IsRunning(player) then\n			return\n		end\n\n		-- And so is a painting. Same failure as Science's, arriving in the same place: the\n		-- art room is laid around the school pad, so an Art lesson begins with the player\n		-- standing on the pad and stays that way for the seconds it takes them to walk out\n		-- to the easel -- during which, without this, school would start a fresh lesson on\n		-- top of it four times a second.\n		if ArtService.IsRunning(player) then\n			return\n		end\n\n		local at = attendAt\n		if at == nil or Ground.FlatDistance(position, at) > SCHOOL.AttendRadiusStuds then\n			return\n		end\n\n		-- Handing the card over, and deliberately *above* the refusal below rather than\n		-- after it. The two most likely refusals at this moment are \"you have had your\n		-- lessons this year\" and \"you are done with school\" -- which are exactly the states\n		-- the owner of an uncollected card is most likely to be in. A card collectable only\n		-- on a day you may also sit a lesson is a card the last year of school never\n		-- delivers, and the final year is the one whose card matters most.\n		if data.pendingReport ~= nil then\n			cards[player] = true\n			pushCard(player)\n		pushTimetable(player)\n			return\n		end\n\n		local refusal = refusalFor(data)\n		if refusal ~= nil then\n			notice(player, refusal, false)\n			return\n		end\n\n		-- A subject already finished with is asked about rather than started. This is the\n		-- only thing mastery buys today and it is the whole of part two: the lesson still\n		-- exists, it is just no longer compulsory.\n		--\n		-- Asked at the door rather than offered from the HUD because arriving is what\n		-- raises the question. A player who has topped out three subjects should not be\n		-- carrying three standing offers around town -- the decision belongs to the moment\n		-- they are standing outside the school with an afternoon in front of them.\n		local subject = subjectFor(data)\n		if subject ~= nil and Mastery.IsTopped(data, subject.id) then\n			doors[player] = { subjectId = subject.id }\n			push(player)\n			return\n		end\n\n		beginLesson(player, data, at)\n		return\n	end\n\n	-- From here on there is a lesson, and every way it can end is asked before\n	-- anything is asked of the player.\n	if not data.alive or not enabled then\n		finish(player, data, lesson, \"left\")\n		return\n	end\n	if position == nil or Ground.FlatDistance(position, lesson.room) > SCHOOL.RoomRadiusStuds then\n		finish(player, data, lesson, \"left\")\n		return\n	end\n\n	if lesson.verdictLeft > 0 then\n		lesson.verdictLeft -= elapsed\n		if lesson.verdictLeft > 0 then\n			push(player)\n			return\n		end\n\n		lesson.verdictLeft = 0\n		lesson.verdictText = nil\n		lesson.index += 1\n		if lesson.index > #lesson.questions then\n			finish(player, data, lesson, \"over\")\n			return\n		end\n		askCurrent(lesson, player)\n		push(player)\n		return\n	end\n\n	lesson.secondsLeft -= elapsed\n\n	-- When the answers are discs on the floor, the tick is what reads the player's\n	-- feet: standing on a disc is picking it, and the first disc under the player\n	-- answers the question. When the answers are rows on the panel, a click arrives\n	-- on its own remote and the tick only counts down.\n	if lesson.discs ~= nil then\n		for row, disc in lesson.discs do\n			if Ground.FlatDistance(position, disc.at) <= SCHOOL.DiscReachStuds then\n				answer(player, lesson, row)\n				return\n			end\n		end\n	end\n\n	if lesson.secondsLeft <= 0 then\n		answer(player, lesson, nil)\n		return\n	end\n\n	push(player)\nend\n\n-- Ends whatever is running and forgets this player entirely. The one place a lesson\n-- ends without being graded, because in every case that calls it there is nobody left\n-- to grade -- a player who left, or a life that is being started over.\nlocal function forget(player: Player)\n	local lesson = lessons[player]\n	if lesson ~= nil then\n		destroyDiscs(lesson)\n	end\n	despawnTeacher(player)\n	lessons[player] = nil\n	notices[player] = nil\n	doors[player] = nil\n	pushed[player] = nil\n	-- Only the *held* card, never the staged one. `data.pendingReport` is the player's\n	-- record and survives a logout on purpose -- what is dropped here is the fact that they\n	-- happened to be standing at the school reading it. The new-life path clears the record\n	-- itself, separately, through Report.Clear.\n	cards[player] = nil\n	pushedCards[player] = nil\nend\n\n-- The player pressed Continue. The one thing that puts a card away for good.\n--\n-- Carries the year it was pressed on, which is the only thing a client has to say about a\n-- card -- there is exactly one pressable row, so *which row* is not a question. The year\n-- is here for the race a lesson answer's question index is here for: a birthday landing\n-- while a card is on screen stages a new one and swaps the panel underneath the player, and\n-- a press already in flight from the old card would otherwise clear the new one unread.\n-- One year of school, silently thrown away, in the one window where the game was talking\n-- over itself.\nlocal function onCardRead(player: Player, ageYears: unknown)\n	if not cards[player] then\n		-- No card in front of them. A stale press from a panel that came down while the\n		-- click was in flight, and there is nothing to say about it: the thing the player\n		-- wanted -- the card gone -- has already happened.\n		return\n	end\n\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return\n	end\n	local data = Lives.Active(profile.Data)\n	local report = data.pendingReport\n	if report == nil then\n		cards[player] = nil\n		pushCard(player)\n		pushTimetable(player)\n		return\n	end\n	if ageYears ~= report.ageYears then\n		-- Answering a card that is no longer the one staged. Left standing rather than\n		-- refused out loud: the new card is already on screen in front of them, and a\n		-- notice explaining a race would be the game apologizing for something the player\n		-- never saw.\n		return\n	end\n\n	cards[player] = nil\n	data.pendingReport = nil\n	pushCard(player)\n		pushTimetable(player)\nend\n\n-- A birthday. The year's lessons refill, and a year nobody turned up to is charged\n-- for. Charged here rather than at the school, because not going is not a thing that\n-- happens at a place -- it is a thing that turns out to have happened when the year\n-- ends, which is exactly what a birthday is.\n--\n-- LifeService calls this after the age has already moved, so the year being judged is\n-- the one just left: the age the player has now reached, less one. Getting that off by\n-- one would charge a five-year-old for missing a year of school that had not started\n-- and let a seventeen-year-old off the last one.\nfunction SchoolService.OnAgeUp(player: Player)\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return\n	end\n	local data = Lives.Active(profile.Data)\n\n	local yearJustEnded = ageYearsOf(data) - 1\n	-- A lesson in progress counts as having turned up, even though nothing has been\n	-- graded yet. `lessonsThisYear` only moves when a lesson ends, so a birthday landing\n	-- mid-question would otherwise charge a child for missing a year of school while\n	-- they were sitting in it -- which is the one accusation this penalty must never\n	-- make. The lesson goes on and counts against the new year when it finishes, which\n	-- is the generous reading and the right one: they are still in the room.\n	local missed = data.lessonsThisYear == 0\n		and lessons[player] == nil\n		and not ScienceService.IsRunning(player)\n		and not GeographyService.IsRunning(player)\n		and not ArtService.IsRunning(player)\n		and yearJustEnded >= SCHOOL.StartAge\n		and yearJustEnded <= SCHOOL.EndAge\n\n	data.lessonsThisYear = 0\n\n	-- Closes the year and stages its card, before the penalty below is charged and told.\n	-- Order matters in one direction only: `missed` has to be read before `lessonsThisYear`\n	-- is reset, which it is. The card itself is not handed over here -- it waits on the\n	-- profile until the player next stands at the school, which is the whole delivery\n	-- decision for this feature. See the block in tickPlayer.\n	--\n	-- Fires on every birthday, including the ones outside school age, because CloseYear is\n	-- what decides that: it wipes the year's lessons either way and only writes a grade for\n	-- a year that was a school year. Skipping the call for a five-year-old would leave a\n	-- half-year of nursery lessons on the record to be folded into the first real card.\n	Report.CloseYear(data, yearJustEnded, missed)\n\n	-- Any skip offer standing at the door is now about last year's timetable. The subject\n	-- on today is keyed on the age and the lessons already sat, and a birthday moves both\n	-- -- so an offer left up would name one subject and start another.\n	doors[player] = nil\n\n	if missed and SCHOOL.SmartsPerYearMissed ~= 0 then\n		StatService.AddStat(player, \"smarts\", SCHOOL.SmartsPerYearMissed)\n		-- Told rather than left to be noticed on the stats bar. A number quietly going\n		-- down is the game punishing you without saying so, and this is the one penalty\n		-- in the system -- it has to be legible or it is just an unexplained drift.\n		notice(player, `You missed a year of school. {SCHOOL.SmartsPerYearMissed} smarts.`, false)\n	end\nend\n\n-- A new life. Nobody inherits an education, and a lesson in progress belonged to\n-- somebody who no longer exists.\nfunction SchoolService.ResetForNewLife(player: Player)\n	forget(player)\n	-- Every verb goes with it. Called from here rather than added to the caller's list\n	-- because these are subjects of this school rather than systems beside it: a caller\n	-- that had to remember all of them would eventually forget one, and the failure -- a\n	-- new child arriving at the lab, or in a town they have already learned, already good\n	-- at it -- is invisible. This list grows by one line per verb, which is the price of\n	-- that, and it is cheaper than the bug.\n	ScienceService.ResetForNewLife(player)\n	GeographyService.ResetForNewLife(player)\n	ArtService.ResetForNewLife(player)\n	ReadingService.ResetForNewLife(player)\n	MusicService.ResetForNewLife(player)\n	PEService.ResetForNewLife(player)\n	-- And the other students, who would otherwise be standing at the *previous* life's\n	-- school: the building is rebuilt around whichever place point the next life walks\n	-- into, and a cohort left at the old one is a class of ghosts.\n	SchoolCrowdService.Clear()\n	local profile = DataService.GetProfile(player)\n	if profile ~= nil then\n		local data = Lives.Active(profile.Data)\n		data.lessonsThisYear = 0\n\n		-- The whole record, not just the year in progress. A new child holding somebody\n		-- else's report card, or a record line claiming three years they never lived, is the\n		-- kind of bug that reads as the save system being broken rather than as school\n		-- being wrong.\n		Report.Clear(data)\n\n		-- Every subject, not just the ones on today's timetable. Cleared by walking the\n		-- stored tables rather than the curriculum, because a life may hold mastery in a\n		-- subject that has since been taken off it -- and a subject that is not cleared is\n		-- one a new child arrives already finished with, which reads as the school\n		-- refusing to teach them and is close to impossible to trace back to here.\n		-- Collected before anything is removed. Clearing a subject writes to both tables,\n		-- so deleting straight out of the one being walked is the kind of thing that works\n		-- until the day it does not.\n		local held: { string } = {}\n		for subjectId in data.subjectMastery do\n			table.insert(held, subjectId)\n		end\n		for subjectId in data.subjectPasses do\n			if data.subjectMastery[subjectId] == nil then\n				table.insert(held, subjectId)\n			end\n		end\n		for _, subjectId in held do\n			Mastery.Clear(data, subjectId)\n		end\n	end\n	push(player)\n	-- Takes down a card that was on screen when the life ended. `forget` has already\n	-- dropped the digest, so this pushes nil rather than being deduplicated away.\n	pushCard(player)\n		pushTimetable(player)\nend\n\n-- Studio harness: sits a lesson wherever the player is standing, skipping the walk to\n-- the school but nothing else.\n--\n-- Deliberately does not skip the refusal check, for the reason WorkService.ForceStart\n-- gives: a test tool that could open a door the game keeps shut is a tool that cannot\n-- test the door. Age and the yearly cap are the two things most worth being able to\n-- stand in front of and read the reason off.\nfunction SchoolService.ForceStart(player: Player): (boolean, string?)\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return false, \"no profile loaded\"\n	end\n	if lessons[player] ~= nil then\n		return false, \"already in a lesson\"\n	end\n\n	local refusal = refusalFor(Lives.Active(profile.Data))\n	if refusal ~= nil then\n		return false, refusal\n	end\n\n	local position = characterPosition(player)\n	if position == nil then\n		return false, \"no character in the world\"\n	end\n\n	-- The room becomes wherever they are standing, so walking away still ends the\n	-- lesson and the radius is still the radius. The same trick, and the same honesty\n	-- about it, as clocking on where you stand.\n	if not beginLesson(player, Lives.Active(profile.Data), position) then\n		return false, \"could not place the answers here\"\n	end\n	return true, nil\nend\n\n-- Ends a lesson in progress and grades it, exactly as walking out would.\nfunction SchoolService.ForceEnd(player: Player): boolean\n	local lesson = lessons[player]\n	local profile = DataService.GetProfile(player)\n	if lesson == nil or profile == nil then\n		return false\n	end\n	finish(player, Lives.Active(profile.Data), lesson, \"over\")\n	return true\nend\n\n-- Studio harness: sets how many lessons this year is already down as having had.\n--\n-- The yearly cap and the missed-year charge are the two rules school actually turns on,\n-- and both are otherwise only reachable by sitting three lessons or letting a whole year\n-- go by. Clamped rather than refused above the cap, because the interesting test is the\n-- refusal at the door and asking for four when three is the limit is asking for that.\nfunction SchoolService.SetLessonsThisYear(player: Player, count: number): boolean\n	local profile = DataService.GetProfile(player)\n	if profile == nil or count < 0 then\n		return false\n	end\n	Lives.Active(profile.Data).lessonsThisYear = math.min(math.floor(count), SCHOOL.LessonsPerYear)\n	push(player)\n	return true\nend\n\n-- Studio harness: closes the school year on the spot and stages its card.\n--\n-- The card is otherwise only reachable by sitting lessons and then waiting out a birthday,\n-- which at the real year length is minutes per card and a whole childhood to see a full\n-- record line. This runs the same CloseYear the birthday runs, on the year the player is\n-- actually in, so what it stages is a real card and not a mock one -- a harness that built\n-- its own card would be testing itself.\n--\n-- Not delivered here. It goes onto the profile exactly as a birthday's would, and the\n-- player still has to walk to the school for it, because *that walk is the feature* and a\n-- command that skipped it could not test it.\nfunction SchoolService.StageReportCard(player: Player): (boolean, string?)\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return false, \"no profile loaded\"\n	end\n	local data = Lives.Active(profile.Data)\n	local ageYears = ageYearsOf(data)\n\n	if ageYears < SCHOOL.StartAge or ageYears > SCHOOL.EndAge then\n		-- Refused by name rather than staging nothing and reporting success. CloseYear\n		-- would drop it silently, and a command that prints \"ok\" and produces no card is\n		-- the harness lying about the system it exists to explain.\n		return false, `age {ageYears} is outside school (ages {SCHOOL.StartAge} to {SCHOOL.EndAge})`\n	end\n\n	-- Same reading of \"missed\" the birthday uses, minus the in-progress-lesson clause: this\n	-- is being run deliberately, and refusing it because a lesson happens to be open would\n	-- make the command depend on where the player is standing.\n	local missed = data.lessonsThisYear == 0\n	if not Report.CloseYear(data, ageYears, missed) then\n		return false, \"no year to close -- no lessons sat and the year is not counted as missed\"\n	end\n\n	data.lessonsThisYear = 0\n	-- The offer at the door is keyed on lessons already sat, which has just moved.\n	doors[player] = nil\n	push(player)\n	return true, nil\nend\n\n-- Studio harness: sets mastery in any subject directly.\n--\n-- The command that makes the skip testable at all. Reaching the top rung honestly is\n-- eight good lessons in one subject, which at three lessons a year and six subjects on\n-- the timetable is most of a childhood -- so without this the only way to see the door\n-- panel is to play to about fifteen.\n--\n-- Refuses an unknown subject rather than creating one. A typo that silently wrote\n-- mastery in \"sceince\" would look exactly like the command not working, and the player\n-- would go on typing it.\nfunction SchoolService.SetMastery(player: Player, subjectId: string, level: number): (boolean, string?)\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return false, \"no profile loaded\"\n	end\n	if Curriculum.Get(subjectId) == nil then\n		local names: { string } = {}\n		for _, subject in Curriculum.All do\n			table.insert(names, subject.id)\n		end\n		return false, `no subject \"{subjectId}\" -- try one of: {table.concat(names, \", \")}`\n	end\n\n	Mastery.Set(Lives.Active(profile.Data), subjectId, level)\n\n	-- Any offer standing at the door is now about a stale level, so it comes down and is\n	-- re-asked on the next tick. Without this, setting mastery while standing on the pad\n	-- leaves the old panel up and the command looks like it did nothing.\n	doors[player] = nil\n	push(player)\n	return true, nil\nend\n\nfunction SchoolService.SetEnabled(value: boolean)\n	enabled = value\nend\n\nfunction SchoolService.IsEnabled(): boolean\n	return enabled\nend\n\n-- What the harness prints. Every number a `/school` command could be asked about, in\n-- the order somebody debugging would want them: whether the building was found, then\n-- who this player is to it, then what is actually running.\nfunction SchoolService.Describe(player: Player): string\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return \"school: no profile loaded\"\n	end\n	local data = Lives.Active(profile.Data)\n\n	local place = PlaceService.Find(PLACE_ID)\n	local where = if place == nil\n		then `no part tagged \"{PLACE_ID}\" -- the school is not in the world`\n		else `at {math.floor(place.part.Position.X)}, {math.floor(place.part.Position.Z)}`\n\n	local refusal = refusalFor(data) or \"can sit a lesson now\"\n\n	local running = \"no lesson\"\n	local lesson = lessons[player]\n	if lesson ~= nil then\n		local question = if lesson.index <= #lesson.questions\n			then lesson.questions[lesson.index].id\n			else \"(finished)\"\n		local held = if lesson.verdictLeft > 0\n			then `holding the teacher's line for {string.format(\"%.1f\", lesson.verdictLeft)}s`\n			else `{#lesson.order} answers on the panel, {string.format(\"%.1f\", lesson.secondsLeft)}s left`\n		running = `question {lesson.index}/{#lesson.questions} \"{question}\", {lesson.right} right, {held}`\n	end\n\n	-- Teacher presence: where the teacher stands, and what the last answer called for.\n	-- The two \"why is there nobody in the room\" answers -- switched off, and no floor\n	-- for it -- look identical from inside the game, so the harness says which.\n	local teacherLine = \"no teacher\"\n	local teacher = teachers[player]\n	if teacher ~= nil then\n		local gesture = if teacher.gesture == nil then \"idle\" else `about to {teacher.gesture}`\n		local spot = math.floor((teacher.at - teacher.front).Magnitude * 10) / 10\n		teacherLine = `teacher at the front, {gesture}, {string.format(\"%.1f\", spot)} studs off-spot`\n	elseif SCHOOL.TeacherEnabled then\n		teacherLine = \"teacher skipped (no floor for it)\"\n	end\n\n	local pool = #Lessons.For(ageYearsOf(data), math.huge)\n\n	-- The ladder, subject by subject, and only for the ones actually on this age's\n	-- timetable -- a row for a subject that will not be taught for another three years is\n	-- noise in a line that is already long. Today's subject is marked, because \"which one\n	-- is next\" is the question every other part of this line is in service of.\n	local today = subjectFor(data)\n	local ladder: { string } = {}\n	for _, subject in Curriculum.ForAge(ageYearsOf(data)) do\n		local level = Mastery.LevelOf(data, subject.id)\n		local mark = if today ~= nil and today.id == subject.id then \"*\" else \"\"\n		local topped = if Mastery.IsTopped(data, subject.id) then \" SKIPPABLE\" else \"\"\n		table.insert(\n			ladder,\n			`{mark}{subject.id} {level}/{Mastery.Levels}`\n				.. `+{Mastery.PassesOf(data, subject.id)}/{Mastery.PassesPerLevel}{topped}`\n		)\n	end\n\n	local door = doors[player]\n	local offer = if door ~= nil then `offering the skip on {door.subjectId}` else \"no offer up\"\n\n	-- The staged card and the held one said separately, because the two states they tell\n	-- apart are the ones worth being able to tell apart: a card waiting on the profile that\n	-- the player has not walked to the school for, versus one on screen in front of them.\n	-- \"Nothing is happening\" looks the same from inside the game in both cases.\n	local report = data.pendingReport\n	local cardLine = if report == nil\n		then `no card staged, {#data.schoolGrades} year(s) on the record`\n		else `card staged for age {report.ageYears} \"{report.grade}\" ({#report.lessons} lesson(s)), `\n			.. `{if cards[player] then \"in hand\" else \"not collected\"}, `\n			.. `{#data.schoolGrades} year(s) on the record`\n\n	return string.format(\n		\"school: %s | %s | age %d, %d/%d lessons this year, %d questions written for this age | %s | %s | %s | %s | %s | %s\",\n		if enabled then \"enabled\" else \"DISABLED\",\n		where,\n		ageYearsOf(data),\n		data.lessonsThisYear,\n		SCHOOL.LessonsPerYear,\n		pool,\n		refusal,\n		running,\n		teacherLine,\n		table.concat(ladder, \", \"),\n		offer,\n		cardLine\n	)\nend\n\nfunction SchoolService:Start()\n	-- **The building goes up on its own.**\n	--\n	-- buildRoom used to be reached only from the lesson path, so the school existed the moment\n	-- somebody sat their first class and not before. That was invisible while this codebase was\n	-- the only thing laying a school -- an empty lot looks like an empty lot either way -- but\n	-- it stopped being acceptable the moment School.Build started *standing the map's own\n	-- school down*. Lazily meant the player walked up to Agent A's building, and only saw this\n	-- one after triggering a lesson. The swap has to have already happened by the time anyone\n	-- can look at the plot.\n	--\n	-- Retried rather than attempted once: the place point arrives with the map, which streams,\n	-- and a builder that gave up on the first tick would leave the old school standing forever\n	-- on a slow load. Stops the moment it succeeds, so the cost is a handful of table lookups\n	-- at startup and nothing at all afterwards.\n	task.spawn(function()\n		for _ = 1, SCHOOL_BUILD_ATTEMPTS do\n			local ok, err = pcall(buildRoom)\n			if not ok then\n				warn(`[AGES] school build failed: {err}`)\n			elseif School.Plan() ~= nil then\n				return\n			end\n			task.wait(SCHOOL_BUILD_RETRY_SECONDS)\n		end\n		-- Out of attempts. Said out loud rather than left silent, because the symptom -- the\n		-- map's school still standing where this one should be -- looks like a code bug and is\n		-- actually a missing place point.\n		if School.Plan() == nil then\n			warn(`[AGES] the school never laid: no \"{PLACE_ID}\" place point after {SCHOOL_BUILD_ATTEMPTS} tries`)\n		end\n	end)\n\n	Players.PlayerAdded:Connect(function(player: Player)\n		-- Pushed once the profile exists, so a rejoining player's row starts blank\n		-- rather than holding whatever the last occupant of the slot was looking at.\n		task.spawn(function()\n			if DataService.WaitForProfile(player) ~= nil then\n				push(player)\n				pushTimetable(player)\n			end\n		end)\n	end)\n\n	Players.PlayerRemoving:Connect(function(player: Player)\n		forget(player)\n		pushedTimetables[player] = nil\n	end)\n\n	RequestLessonAnswerRemote.OnServerEvent:Connect(function(player: Player, index: unknown, answerId: unknown)\n		local ok, err = pcall(onAnswerRequested, player, index, answerId)\n		if not ok then\n			warn(`[AGES] lesson answer failed for {player.Name}: {err}`)\n		end\n	end)\n\n	RequestReportCardReadRemote.OnServerEvent:Connect(function(player: Player, ageYears: unknown)\n		local ok, err = pcall(onCardRead, player, ageYears)\n		if not ok then\n			warn(`[AGES] report card read failed for {player.Name}: {err}`)\n		end\n	end)\n\n	task.spawn(function()\n		while true do\n			local elapsed = task.wait(SCHOOL.TickSeconds)\n			for _, player in Players:GetPlayers() do\n				local ok, err = pcall(tickPlayer, player, elapsed)\n				if not ok then\n					warn(`[AGES] school tick failed for {player.Name}: {err}`)\n				end\n			end\n		end\n	end)\nend\n\nreturn SchoolService\n"
table.insert(AGES_MANIFEST, "src/server/services/SchoolService.luau")
AGES_SOURCES["src/server/services/ScienceService.luau"] = "--!strict\n-- Science: the first school subject that is a thing you do rather than a thing you are\n-- asked.\n--\n-- The loop:\n--\n--   You walk to the board and read the next few steps of a procedure -- go to the\n--   balance, then the beaker, then the notebook. You walk to a bench and pick it up.\n--   Then you cross the room clicking those stations in that order, each click stacking\n--   a step. Nothing is scored until you walk back and commit, so the whole stack can be\n--   taken apart and rebuilt until then. A second bench opens partway through with a\n--   second procedure on it, and the two of them compete for the same stations and the\n--   same reagents.\n--\n-- What makes it a mechanic rather than a fetch quest, in the order it matters:\n--\n--   The board goes blank when you walk away from it. That is the single most important\n--   line in this file. The steps live in the player's head between the board and the\n--   station, and how many they can hold is what a mastery level *is* -- see BenchState\n--   .revealed. A version of this that kept the list on screen would be a checklist with\n--   a walk attached, and the whole progression would evaporate.\n--\n--   Committing is the only irreversible act. Everything before it is a draft, which is\n--   what makes an eight-step procedure something you can attempt at all rather than\n--   something you have to get right blind.\n--\n--   Failure is a share, never a flag. A stack is scored on how much of the procedure it\n--   contains in the right order, so a step in the wrong place costs that step -- not the\n--   run. Getting one thing wrong out of eight should feel like getting seven right.\n--\n--   You run out of reagents about once a procedure and the cupboard is on the far side\n--   of the room from the board. The two errands are deliberately opposite, so they\n--   cannot be batched into one trip.\n--\n-- What this file is deliberately not:\n--\n--   It is not a second school. The door, the yearly cap, the smarts payout and the\n--   verdict shares are all School's, read from Config.School, and a lesson that happens\n--   to be Science still spends one of the three lessons in the year. Two sets of numbers\n--   describing how good an afternoon of school was is exactly the drift this codebase\n--   keeps getting bitten by.\n--\n--   It does not build the room. Lab.luau does, for the reason WorkSpots is not inside\n--   WorkService: where a thing can stand and what happens when you reach it are separate\n--   questions, and re-laying the lab must never be able to touch the scoring.\n\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Config = require(ReplicatedStorage:WaitForChild(\"Config\"))\nlocal Remotes = require(ReplicatedStorage:WaitForChild(\"Remotes\"))\nlocal Types = require(ReplicatedStorage:WaitForChild(\"Types\"))\nlocal Lives = require(ReplicatedStorage:WaitForChild(\"Lives\"))\nlocal Stations = require(ReplicatedStorage:WaitForChild(\"world\"):WaitForChild(\"Stations\"))\nlocal Mastery = require(ReplicatedStorage:WaitForChild(\"school\"):WaitForChild(\"Mastery\"))\nlocal Report = require(ReplicatedStorage:WaitForChild(\"school\"):WaitForChild(\"Report\"))\n\nlocal DataService = require(script.Parent.DataService)\nlocal EventService = require(script.Parent.EventService)\nlocal StatService = require(script.Parent.StatService)\nlocal SkillService = require(script.Parent.SkillService)\nlocal Ground = require(script.Parent.Parent.world.Ground)\nlocal Lab = require(script.Parent.Parent.world.Lab)\nlocal Procedures = require(script.Parent.Parent.content.Procedures)\n\ntype LifeData = Types.LifeData\ntype LabState = Types.LabState\ntype BenchState = Types.BenchState\ntype Procedure = Types.Procedure\ntype ProcedureStep = Types.ProcedureStep\n\nlocal ScienceService = {}\n\nlocal LabUpdatedRemote = Remotes.Get(\"LabUpdated\")\nlocal RequestLabStepRemote = Remotes.Get(\"RequestLabStep\")\nlocal RequestLabUndoRemote = Remotes.Get(\"RequestLabUndo\")\nlocal RequestLabCommitRemote = Remotes.Get(\"RequestLabCommit\")\n\nlocal SCHOOL = Config.School\nlocal SCIENCE = SCHOOL.Science\nlocal SKILL_AWARDS = Config.Skills.Awards\n\n-- The subject id this service answers to. A constant rather than a parameter because\n-- there is exactly one procedure subject; the day there is a second, this becomes an\n-- argument and nothing else here changes.\nlocal SUBJECT_ID = \"science\"\n\n-- The two ladders have to be the same length, and this is the only place that can\n-- notice. School.Mastery.Levels says how many rungs there are; RevealedStepsByLevel says\n-- what each rung shows you. A sixth rung added to one and not the other is a promotion\n-- the verb has no answer for -- the player is told they levelled up and the board does\n-- not change -- which is exactly the numbers-only progression this whole rebuild exists\n-- to get rid of, arriving by accident.\n--\n-- Loud at require time rather than clamped quietly, because clamping is what hides it:\n-- the level would work, the board would not, and nothing would ever say so.\nif #SCIENCE.RevealedStepsByLevel ~= Mastery.Levels then\n	error(\n		`[AGES config] School.Science.RevealedStepsByLevel has {#SCIENCE.RevealedStepsByLevel} entries but`\n			.. ` School.Mastery.Levels is {Mastery.Levels}. Every mastery rung has to say how much of the board`\n			.. ` it shows, so the list must have exactly one number per level. Add or remove one.`\n	)\nend\n\n-- One bench, mid-draft.\ntype Bench = {\n	index: number,\n	procedure: Procedure,\n	-- Station ids in click order. The draft.\n	taken: { string },\n	secondsLeft: number,\n	committed: boolean,\n	score: number?,\n	verdict: string?,\n}\n\n-- One player's session in the lab. Only ever one -- you cannot be in two labs.\ntype Session = {\n	-- Where the room was when the session started. Walking beyond RoomRadiusStuds of it\n	-- ends the session, the same way walking out of a classroom ends a lesson.\n	center: Vector3,\n	benches: { Bench },\n	-- Which bench has been picked up, or nil before the player has been to one. Steps\n	-- land here and nowhere else.\n	active: number?,\n	charges: number,\n	level: number,\n	passes: number,\n	-- The rung this life was on when the session opened, kept so the closing line can say\n	-- whether the lab moved it. Snapshotted at Begin and never rewritten, unlike `level`,\n	-- which tracks the live figure for the board -- commitBench writes mastery as each\n	-- bench is committed, so a \"before\" read taken inside `finish` would already include\n	-- the promotion it is trying to detect.\n	levelAtStart: number,\n	-- Seconds of standing at the cupboard banked toward a refill. Reset the moment the\n	-- player steps away, on purpose: a refill you can start and come back to is two half\n	-- trips, and the trip is the mechanic.\n	refillHeld: number,\n	-- The procedures still to be handed out, so the second bench opens with something\n	-- different on it rather than a copy of the first.\n	pool: { Procedure },\n	-- How many benches this session will ever have. Starts at Config's figure and is\n	-- lowered to the benches actually open if the pool runs out of runnable procedures.\n	--\n	-- A field rather than the constant, because otherwise a lab that cannot fill its\n	-- second bench never satisfies the \"every bench committed\" test and the session hangs\n	-- until the room's clock runs it out -- a silent stall, which is the worst way for\n	-- this to fail. Lowering it turns that into a one-bench lab, which is a smaller lab\n	-- and not a broken one.\n	benchesMax: number,\n	-- Seconds until the session's closing line comes down. Non-zero only after every\n	-- bench is committed.\n	verdictLeft: number,\n	summary: string?,\n	-- The last refusal, held for a beat. See LabState.notice.\n	notice: string?,\n	noticeLeft: number,\n	-- Where the player was standing on the last tick, cached so the click handlers can\n	-- answer without re-probing. Written only by the tick.\n	atBoard: boolean,\n	atBench: number?,\n	atCupboard: boolean,\n}\n\nlocal sessions: { [Player]: Session } = {}\n\n-- The last thing pushed to each player, so an unchanged state is not re-sent four times\n-- a second. Same reason SchoolService keeps one.\nlocal pushed: { [Player]: string } = {}\n\n-- Switched off by the harness. Same shape as School's, and checked in the same two\n-- places: at the door, and on every tick of a session already running.\nlocal enabled = true\n\nlocal function characterPosition(player: Player): Vector3?\n	local character = player.Character\n	if character == nil then\n		return nil\n	end\n	local root = character:FindFirstChild(\"HumanoidRootPart\")\n	if root == nil or not root:IsA(\"BasePart\") then\n		return nil\n	end\n	return root.Position\nend\n\nlocal function ageYearsOf(data: LifeData): number\n	return math.floor(data.ageMonths / 12)\nend\n\n-- How many steps of the board this level shows at once. Clamped rather than indexed\n-- blind: a stored level from a build with a longer ladder must not index off the end of\n-- a shorter one, and the honest reading of \"level 9 on a five-rung ladder\" is the top\n-- rung. The check above makes that unreachable from Config; this covers the profile.\nlocal function revealCountFor(level: number): number\n	local ladder = SCIENCE.RevealedStepsByLevel\n	local rung = math.clamp(math.floor(level), 1, #ladder)\n	return ladder[rung]\nend\n\n-- Both of these used to read and clamp the profile tables here. They are Mastery's now,\n-- kept as one-line wrappers because the rest of this file reads better saying \"the\n-- level\" than \"the level of this subject on this life\" fourteen times over.\nlocal function levelOf(data: LifeData): number\n	return Mastery.LevelOf(data, SUBJECT_ID)\nend\n\nlocal function passesOf(data: LifeData): number\n	return Mastery.PassesOf(data, SUBJECT_ID)\nend\n\n-- How much of the procedure this stack actually contains, in order, as a 0-1 share.\n--\n-- The longest common subsequence rather than a position-by-position match, and the\n-- difference is the whole of \"soft failure\". Position matching means one forgotten step\n-- shifts everything after it and scores zero from there on -- a single slip reading as a\n-- total failure, which is the binary outcome this activity is built to avoid. A\n-- subsequence charges a missed step for exactly itself and lets the rest of a good run\n-- stand, so eight steps with one wrong is seven eighths and reads like it.\n--\n-- An extra step the procedure never asked for costs nothing directly, which is\n-- deliberate: it costs a reagent and it costs the walk, and those are real enough. The\n-- clock is what stops padding the stack from being free.\nlocal function orderedMatch(taken: { string }, procedure: Procedure): number\n	local steps = procedure.steps\n	local wanted = #steps\n	if wanted == 0 then\n		return 0\n	end\n\n	-- Two rolling rows of the LCS table rather than the whole thing. Both lists are a\n	-- handful of entries, so this is a few dozen cells either way -- but it runs on every\n	-- commit and there is no reason to allocate a rectangle for it.\n	--\n	-- Offset by one throughout: `row[j + 1]` is the score against the first j steps, so\n	-- `row[1]` is the empty prefix and stays zero. Every cell of `current` is written\n	-- before it is read on the next pass, so neither row ever needs clearing.\n	local previous: { number } = table.create(wanted + 1, 0)\n	local current: { number } = table.create(wanted + 1, 0)\n\n	for _, station in taken do\n		current[1] = 0\n		for index = 1, wanted do\n			if station == steps[index].station then\n				current[index + 1] = previous[index] + 1\n			else\n				current[index + 1] = math.max(current[index], previous[index + 1])\n			end\n		end\n		previous, current = current, previous\n	end\n\n	return previous[wanted + 1] / wanted\nend\n\n-- How much of the clock is worth. Never zero: a correct procedure handed in on the\n-- buzzer is still most of a correct procedure, because the player who took the long way\n-- round is usually the one still learning the room and punishing them for it is\n-- punishing them for playing.\nlocal function speedFactorFor(secondsLeft: number): number\n	local share = math.clamp(secondsLeft / SCIENCE.SecondsPerProcedure, 0, 1)\n	local reached = math.clamp(share / SCIENCE.SpeedFullShare, 0, 1)\n	return SCIENCE.SpeedFloorFactor + (1 - SCIENCE.SpeedFloorFactor) * reached\nend\n\n-- The sentence said about a committed bench. Names the first place the stack and the\n-- procedure part company, because \"0.6\" tells a player nothing they can do differently\n-- and \"you went to the sink before you had weighed it\" tells them everything.\nlocal function verdictFor(bench: Bench, score: number): string\n	local steps = bench.procedure.steps\n	local taken = bench.taken\n\n	if score >= 0.999 then\n		return \"Perfect. Every step in order.\"\n	end\n\n	-- The first disagreement, which is where the run went wrong even if it recovered.\n	for index = 1, math.max(#steps, #taken) do\n		local want = steps[index]\n		local got = taken[index]\n		if want == nil then\n			return `You kept going past the last step. It ended at {#steps}.`\n		end\n		if got == nil then\n			return `You left it at step {index} of {#steps} -- the {Stations.NameOf(want.station)} was next.`\n		end\n		if got ~= want.station then\n			return `Step {index} was the {Stations.NameOf(want.station)}, not the {Stations.NameOf(got)}.`\n		end\n	end\n\n	-- Reached only when the stack matches step for step and the score is still short,\n	-- which means the clock took it. Worth its own sentence rather than falling through\n	-- to a generic one: \"you were right but slow\" is a completely different lesson.\n	return \"Right the whole way, but slowly.\"\nend\n\n-- Whether this stack actually reached a volatile step ahead of the step in front of it.\n-- Not the same test as `orderedMatch` -- that asks how much of the procedure survived in\n-- order as a share, and a volatile step reached early can still leave the rest of the\n-- LCS intact. This asks one narrower question: did the station a volatile step names get\n-- clicked before the station immediately before it in the procedure was ever clicked at\n-- all. That is \"mixed the second thing in before the first was ready\" in station terms,\n-- and it is the one mistake this verb treats as dangerous rather than merely wrong.\n--\n-- First station position wins on both sides, which matches how a player reads their own\n-- stack: the *first* time you reached for the volatile station is the moment that either\n-- was or was not preceded by the step it needed.\nlocal function volatileTriggered(bench: Bench): boolean\n	local steps = bench.procedure.steps\n	for index, step in steps do\n		if not step.volatile or index == 1 then\n			continue\n		end\n		local wantsBefore = steps[index - 1].station\n\n		local volatilePos: number? = nil\n		for takenIndex, station in bench.taken do\n			if station == step.station then\n				volatilePos = takenIndex\n				break\n			end\n		end\n		if volatilePos == nil then\n			-- Never reached this station at all -- nothing to have gone off.\n			continue\n		end\n\n		local reachedPredecessor = false\n		for takenIndex = 1, volatilePos - 1 do\n			if bench.taken[takenIndex] == wantsBefore then\n				reachedPredecessor = true\n				break\n			end\n		end\n		if not reachedPredecessor then\n			return true\n		end\n	end\n	return false\nend\n\n-- The bang itself. Cosmetic only -- see Config.School.Science's comment on\n-- ExplosionBlastRadiusStuds for why BlastPressure is zero -- so this never costs a player\n-- health or knocks them anywhere, no matter who is standing at the next bench over.\n-- Silently does nothing if the room has not built yet, which cannot happen in the path\n-- that calls it (a bench only exists inside a built room) but matches Lab.Room's own\n-- contract of \"nil means ask again\" rather than assuming.\nlocal function triggerExplosion(bench: Bench)\n	local built = Lab.Room()\n	if built == nil then\n		return\n	end\n	local at = built.benches[bench.index]\n	if at == nil then\n		return\n	end\n	local explosion = Instance.new(\"Explosion\")\n	explosion.Position = at + Vector3.new(0, SCIENCE.ExplosionHeightStuds, 0)\n	explosion.BlastRadius = SCIENCE.ExplosionBlastRadiusStuds\n	explosion.BlastPressure = 0\n	explosion.DestroyJointRadiusPercent = 0\n	explosion.Parent = workspace\nend\n\n-- The window of the board this bench is currently showing. Starts where the stack\n-- stands, so the board answers \"what now\" rather than repeating what the bench already\n-- records.\n--\n-- `from` is deliberately allowed past the end of the procedure, and the window is then\n-- empty. Clamping it to the last step instead -- which is what this did first -- makes\n-- the board hand back a step the player has already taken the moment their stack is\n-- complete, and a board that says \"now the notebook\" to somebody who has just done the\n-- notebook is a board actively telling them to score themselves down. Empty is the\n-- truth: there is nothing left to read, go and commit it.\nlocal function revealFor(bench: Bench, level: number): ({ ProcedureStep }, number)\n	local steps = bench.procedure.steps\n	local from = #bench.taken + 1\n	local out: { ProcedureStep } = {}\n	for index = from, math.min(from + revealCountFor(level) - 1, #steps) do\n		table.insert(out, steps[index])\n	end\n	return out, from\nend\n\nlocal function benchStateFor(session: Session, bench: Bench): BenchState\n	-- Empty away from the board. This is the mechanic -- see the type -- and it is done\n	-- here rather than on the client so that a modified client cannot simply keep the\n	-- list: the tail is never sent, so there is nothing to hold on to.\n	local revealed: { ProcedureStep } = {}\n	local from = #bench.taken + 1\n	if session.atBoard and not bench.committed then\n		revealed, from = revealFor(bench, session.level)\n	end\n\n	return {\n		index = bench.index,\n		name = bench.procedure.name,\n		-- Copied rather than handed over, because this table crosses a remote and the\n		-- session keeps writing to its own.\n		taken = table.clone(bench.taken),\n		revealed = revealed,\n		revealedFrom = from,\n		total = #bench.procedure.steps,\n		secondsLeft = math.max(0, bench.secondsLeft),\n		secondsTotal = SCIENCE.SecondsPerProcedure,\n		active = session.active == bench.index,\n		score = bench.score,\n		verdict = bench.verdict,\n		committed = bench.committed,\n	}\nend\n\nlocal function stateFor(player: Player): LabState?\n	local session = sessions[player]\n	if session == nil then\n		return nil\n	end\n\n	local benches: { BenchState } = {}\n	for _, bench in session.benches do\n		table.insert(benches, benchStateFor(session, bench))\n	end\n\n	return {\n		benches = benches,\n		charges = session.charges,\n		chargesMax = SCIENCE.SupplyCharges,\n		level = session.level,\n		levelMax = Mastery.Levels,\n		passes = session.passes,\n		passesPerLevel = Mastery.PassesPerLevel,\n		atBoard = session.atBoard,\n		atBench = session.atBench,\n		atCupboard = session.atCupboard,\n		refillProgress = math.clamp(session.refillHeld / SCIENCE.CupboardRefillSeconds, 0, 1),\n		summary = session.summary,\n		notice = session.notice,\n	}\nend\n\nlocal function push(player: Player)\n	local state = stateFor(player)\n	-- A digest rather than a deep compare, and it has to name every field that is drawn.\n	-- The stacks are folded in by length and last entry: a stack only ever changes at its\n	-- end, so those two move whenever it does.\n	local digest: string\n	if state == nil then\n		digest = \"none\"\n	else\n		local parts: { string } = {}\n		for _, bench in state.benches do\n			table.insert(\n				parts,\n				`{bench.index}:{#bench.taken}:{bench.taken[#bench.taken] or \"-\"}:{#bench.revealed}:`\n					.. `{bench.revealedFrom}:{math.floor(bench.secondsLeft * 4)}:{tostring(bench.active)}:`\n					.. `{tostring(bench.committed)}:{tostring(bench.verdict)}`\n			)\n		end\n		digest = `{table.concat(parts, \"|\")}#{state.charges}/{state.level}/{state.passes}/`\n			.. `{tostring(state.atBoard)}/{tostring(state.atBench)}/{tostring(state.atCupboard)}/`\n			.. `{math.floor(state.refillProgress * 20)}/{tostring(state.summary)}/{tostring(state.notice)}`\n	end\n\n	if pushed[player] == digest then\n		return\n	end\n	pushed[player] = digest\n	LabUpdatedRemote:FireClient(player, state)\nend\n\n-- A refusal, held for a beat so it can be read. Replaces whatever was showing, because\n-- the newest thing the lab has to say is always the one worth reading.\nlocal function refuse(player: Player, session: Session, text: string)\n	session.notice = text\n	session.noticeLeft = SCIENCE.VerdictSeconds\n	push(player)\nend\n\n-- Hands a bench a procedure off the session's pool, without repeating one already\n-- running. Nil when the pool is empty, which means the second bench simply does not\n-- open -- a lab with one procedure in it is still a lab, and inventing a duplicate\n-- would make the second bench a copy of the first, which is the undifferentiated-\n-- outcome trap wearing a lab coat.\nlocal function drawProcedure(session: Session): Procedure?\n	while #session.pool > 0 do\n		local index = math.random(#session.pool)\n		local procedure = table.remove(session.pool, index)\n		if procedure == nil then\n			continue\n		end\n		local ok = Lab.CanRun(procedure)\n		if ok then\n			return procedure\n		end\n		-- A procedure whose station the floor refused is skipped rather than handed out\n		-- and failed. Not silent: Lab.Missing names the stations, and the harness prints\n		-- them -- but a player must never be given a run they physically cannot finish.\n	end\n	return nil\nend\n\n-- Scores a bench and closes it. The one irreversible act in the whole verb.\n--\n-- Takes the life data because a committed bench banks toward mastery, and mastery is one\n-- ladder shared with every other subject rather than a private pair of numbers on the\n-- session. The session still carries `level` and `passes`, but only as a mirror for the\n-- panel to draw -- they are re-read off the profile immediately below, so the profile is\n-- the single writer and the two can never drift.\n-- Returns how many steps of the procedure were performed in the right order, which is\n-- the only measure of the run that is not adjusted for how fast the player walked. Zero\n-- for a bench that was already committed, which is the same answer the caller wants: a\n-- second commit of the same bench earned nothing, because the first one earned it all.\nlocal function commitBench(data: LifeData, session: Session, bench: Bench, spoiled: boolean): number\n	if bench.committed then\n		return 0\n	end\n\n	-- Decided before anything is written, which is the idempotency rule this codebase\n	-- runs on: work out the outcome, then record it, rather than recording as you go and\n	-- unpicking if something goes wrong halfway.\n	local matched = orderedMatch(bench.taken, bench.procedure)\n	local score = matched * speedFactorFor(if spoiled then 0 else bench.secondsLeft)\n	-- Checked against the stack before anything below rewrites it, for the same\n	-- idempotency reason: whether this run went off is a fact about the stack as it stood\n	-- the moment commit was pressed, not something to recompute from a mutated bench.\n	local exploded = volatileTriggered(bench)\n\n	bench.committed = true\n	bench.score = score\n	bench.secondsLeft = 0\n	bench.verdict = if spoiled and #bench.taken == 0\n		then \"You never started this one.\"\n		elseif exploded then `It went off. {verdictFor(bench, matched)}`\n		elseif spoiled then `Time. {verdictFor(bench, matched)}`\n		else verdictFor(bench, matched)\n\n	if exploded then\n		triggerExplosion(bench)\n	end\n\n	-- Banks toward the next mastery level. Measured on the ordered match rather than the\n	-- speed-adjusted score, because mastery is about knowing the procedure and charging\n	-- for the walk twice would make the ladder a test of running.\n	--\n	-- Written to the profile here rather than held on the session until the lab ends. A\n	-- committed bench is already the irreversible act -- there is nothing left to unpick\n	-- -- so deferring the write would only create a window where the player has provably\n	-- earned a rung and the save does not know it.\n	Mastery.Record(data, SUBJECT_ID, matched)\n	session.level = levelOf(data)\n	session.passes = passesOf(data)\n\n	if session.active == bench.index then\n		session.active = nil\n	end\n\n	return matched\nend\n\n-- Ends the session and pays for it. `reason` changes the sentence but never the\n-- arithmetic: a lab walked out of halfway through is graded on both benches, because\n-- leaving early is a way of getting them wrong -- the same rule a lesson runs on.\nlocal function finish(player: Player, data: LifeData, session: Session, reason: string)\n	for _, bench in session.benches do\n		if not bench.committed then\n			commitBench(data, session, bench, true)\n		end\n	end\n\n	local total = 0\n	for _, bench in session.benches do\n		total += bench.score or 0\n	end\n	local share = if #session.benches > 0 then total / #session.benches else 0\n\n	-- Graded through Report rather than against SCHOOL's thresholds directly, which is the\n	-- whole reason Report is shared. A lab and a quiz are two ways of spending the same\n	-- afternoon, and the day these two files disagreed about what a good one was would be\n	-- the day the report card and the lesson's own closing line said different things about\n	-- it.\n	local band = Report.BandFor(share)\n	local gained = Report.SmartsFor(band)\n\n	if gained ~= 0 then\n		StatService.AddStat(player, \"smarts\", gained)\n	end\n\n	-- Mastery is deliberately not written here. Every bench that could bank one has been\n	-- committed by the loop above, and commitBench writes as it goes -- so a lab that ends\n	-- has already recorded everything it earned, and a second write from a session mirror\n	-- would only be a chance for the two to disagree.\n\n	-- Counted however it ended, including walked out of, for the reason a lesson is:\n	-- otherwise a player could start, leave, and start again until they drew a procedure\n	-- they liked.\n	data.lessonsThisYear += 1\n	EventService.AwardAutonomy(player, 1)\n\n	-- Onto the year's record, so an afternoon in the lab appears on the report card as the\n	-- lesson it was. Written after the count moves and after mastery has settled, so the\n	-- rung passed in is the one the session actually finished on.\n	--\n	-- The promotion is reported only when the lab moved it, which is what `levelAtStart` is\n	-- for: a card line reading \"Science, level 3\" against a session that ended on the rung\n	-- it began on would read as though this afternoon had earned it.\n	local level = levelOf(data)\n	Report.RecordLesson(data, SUBJECT_ID, band, gained, if level > session.levelAtStart then level else nil)\n\n	local percent = math.floor(share * 100 + 0.5)\n	local reward = if gained > 0 then `. +{gained} smarts.` else \".\"\n	local opening = if reason == \"left\" then \"You walked out of the lab.\" else \"Lab over.\"\n	session.summary = `{opening} {percent}% of the procedures right{reward}`\n	session.verdictLeft = SCHOOL.VerdictSeconds\n	session.notice = nil\n	session.noticeLeft = 0\n	push(player)\nend\n\n-- Why this player cannot run a procedure right now, or nil if they can. Only the things\n-- Science itself refuses -- the age, the yearly cap and the door are School's, checked\n-- before this is ever called.\nlocal function refusalFor(): string?\n	if not enabled then\n		return \"The lab is closed.\"\n	end\n	local room = Lab.Room()\n	if room == nil then\n		return \"The lab has not been built.\"\n	end\n	local missing = Lab.Missing()\n	if #missing > 0 then\n		-- Named rather than a shrug. A station the floor refused is a build problem, and a\n		-- player who is told which one can at least report it.\n		return `The lab is missing its {table.concat(missing, \", \")}.`\n	end\n	return nil\nend\n\n-- Starts a lab session. Returns false with a reason worth saying out loud.\n--\n-- Deliberately takes no position. A lesson can be sat wherever the player is standing --\n-- the classroom is drawn around them -- but a lab cannot, because the benches and the\n-- stations are real furniture in one place and a session centred anywhere else would\n-- start with every station already outside the room. So the lab is always the lab, and a\n-- harness that skips the walk to school still runs it in the room that exists.\nfunction ScienceService.Begin(player: Player, data: LifeData): (boolean, string?)\n	if sessions[player] ~= nil then\n		return false, \"You are already in the lab.\"\n	end\n	local refusal = refusalFor()\n	if refusal ~= nil then\n		return false, refusal\n	end\n	-- Non-nil by refusalFor, which returns a reason when the room is missing. Re-read\n	-- rather than carried out of it so the type is not an optional the rest of this\n	-- function has to keep unwrapping.\n	local room = Lab.Room()\n	if room == nil then\n		return false, \"The lab has not been built.\"\n	end\n\n	local pool = Procedures.ForAge(ageYearsOf(data))\n	if #pool == 0 then\n		-- Impossible if the content file loaded, which checks every procedure lands inside\n		-- the school years. Reachable only by emptying the list without updating the check,\n		-- and the honest thing is to say so rather than open a lab with nothing in it.\n		return false, \"There is nothing running in the lab today.\"\n	end\n\n	local session: Session = {\n		center = room.center,\n		benches = {},\n		active = nil,\n		charges = SCIENCE.SupplyCharges,\n		level = levelOf(data),\n		passes = passesOf(data),\n		levelAtStart = levelOf(data),\n		refillHeld = 0,\n		pool = pool,\n		benchesMax = SCIENCE.Benches,\n		verdictLeft = 0,\n		summary = nil,\n		notice = nil,\n		noticeLeft = 0,\n		atBoard = false,\n		atBench = nil,\n		atCupboard = false,\n	}\n\n	local first = drawProcedure(session)\n	if first == nil then\n		return false, \"Nothing in the lab can be run with the stations that are standing.\"\n	end\n	table.insert(session.benches, {\n		index = 1,\n		procedure = first,\n		taken = {},\n		secondsLeft = SCIENCE.SecondsPerProcedure,\n		committed = false,\n		score = nil,\n		verdict = nil,\n	})\n\n	sessions[player] = session\n	push(player)\n	return true, nil\nend\n\n-- A station clicked. Checked against the bench that is actually in hand rather than\n-- against whatever the client believes: the reagent pool and the clock are real, and a\n-- click that arrives after the bench committed has to lose to the commit.\nlocal function onStepRequested(player: Player, stationId: unknown)\n	if type(stationId) ~= \"string\" then\n		return\n	end\n	local session = sessions[player]\n	if session == nil then\n		return\n	end\n	if session.summary ~= nil then\n		return\n	end\n\n	local room = Lab.Room()\n	if room == nil or room.stations[stationId] == nil then\n		-- A station id the lab never built. Silently dropped rather than refused out\n		-- loud: the only way to produce one is a modified client, and a real player has\n		-- no sentence this could usefully say to them.\n		return\n	end\n\n	local index = session.active\n	if index == nil then\n		refuse(player, session, \"Pick up a bench first -- walk to one.\")\n		return\n	end\n	local bench = session.benches[index]\n	if bench == nil or bench.committed then\n		session.active = nil\n		refuse(player, session, \"That bench is finished. Walk to the other one.\")\n		return\n	end\n\n	if #bench.taken >= SCIENCE.MaxSteps then\n		refuse(player, session, \"There is no room left on that bench. Commit it or take a step back.\")\n		return\n	end\n\n	-- Checked against where the player actually is, not where the prompt was when it\n	-- fired. A prompt is a click on a thing across the room the instant you walk out of\n	-- range, and the walk is the entire cost of a step.\n	local position = characterPosition(player)\n	if position == nil then\n		return\n	end\n	local at = room.stations[stationId]\n	if Ground.FlatDistance(position, at) > SCIENCE.StationRadiusStuds then\n		return\n	end\n\n	if session.charges < SCIENCE.ChargesPerStep then\n		refuse(player, session, \"Out of reagents. The cupboard is across the room.\")\n		return\n	end\n\n	session.charges -= SCIENCE.ChargesPerStep\n	table.insert(bench.taken, stationId)\n	session.notice = nil\n	session.noticeLeft = 0\n	push(player)\nend\n\n-- The last step off a bench. Free, uncapped and instant, which is the half of\n-- commit-and-undo that makes the other half mean something: a draft you are charged to\n-- edit is not a draft.\n--\n-- The reagent is deliberately *not* refunded. Undo costs nothing in time or in score\n-- and it should not -- but a free undo that also refunded the pool would make an\n-- exhausted cupboard trip reversible, and the traversal is the point.\nlocal function onUndoRequested(player: Player, benchIndex: unknown)\n	if type(benchIndex) ~= \"number\" then\n		return\n	end\n	local session = sessions[player]\n	if session == nil or session.summary ~= nil then\n		return\n	end\n	local bench = session.benches[benchIndex]\n	if bench == nil or bench.committed then\n		return\n	end\n	if #bench.taken == 0 then\n		return\n	end\n	-- Only the bench in hand, so undo cannot be used to reach across the room and edit\n	-- the other procedure without walking to it.\n	if session.active ~= benchIndex then\n		refuse(player, session, \"That is not the bench you are holding.\")\n		return\n	end\n\n	table.remove(bench.taken)\n	session.notice = nil\n	session.noticeLeft = 0\n	push(player)\nend\n\nlocal function onCommitRequested(player: Player, benchIndex: unknown)\n	if type(benchIndex) ~= \"number\" then\n		return\n	end\n	local session = sessions[player]\n	if session == nil or session.summary ~= nil then\n		return\n	end\n	local bench = session.benches[benchIndex]\n	if bench == nil or bench.committed then\n		return\n	end\n\n	-- Committing happens at the bench, not from across the room. Enforced rather than\n	-- assumed, because the client only draws the button in range and a client is not\n	-- something to take the word of.\n	if session.atBench ~= benchIndex then\n		refuse(player, session, \"Walk to the bench to commit it.\")\n		return\n	end\n	if #bench.taken == 0 then\n		refuse(player, session, \"There is nothing on that bench yet.\")\n		return\n	end\n\n	-- Fetched here rather than carried on the session, because committing banks toward\n	-- mastery and mastery lives on the profile. A player whose profile has gone -- left\n	-- between the click arriving and this line -- simply does not commit; there is nobody\n	-- left to record it against.\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return\n	end\n\n	local matched = commitBench(Lives.Active(profile.Data), session, bench, false)\n	-- Science, per step of the procedure done in the right order. Only on the deliberate\n	-- commit: the two spoiled paths above bank mastery for a bench the clock closed, and a\n	-- bench the player never walked back to is not a run they finished.\n	--\n	-- The one multiplied award in the tree, which is why Config.Skills.MaxPerAward stops\n	-- being a formality here -- a procedure long enough to out-earn a whole canvas would\n	-- be capped rather than paid.\n	if matched > 0 then\n		SkillService.Award(player, \"science\", SKILL_AWARDS.LabStepMatched * matched, \"committed a bench\")\n	end\n	push(player)\nend\n\n-- Reads where the player is standing and writes it onto the session. Everything the\n-- click handlers allow or refuse is decided from these three, so they are worked out\n-- once a tick in one place rather than re-probed per click.\nlocal function readPosition(session: Session, position: Vector3)\n	local room = Lab.Room()\n	if room == nil then\n		session.atBoard = false\n		session.atBench = nil\n		session.atCupboard = false\n		return\n	end\n\n	session.atBoard = Ground.FlatDistance(position, room.board) <= SCIENCE.BoardRadiusStuds\n	session.atCupboard = Ground.FlatDistance(position, room.cupboard) <= SCIENCE.CupboardRadiusStuds\n\n	session.atBench = nil\n	for index, at in room.benches do\n		if Ground.FlatDistance(position, at) <= SCIENCE.BenchRadiusStuds then\n			session.atBench = index\n			break\n		end\n	end\n\n	-- Standing at a bench picks it up. There is no separate \"take\" click, because\n	-- arriving somewhere and then pressing a button to confirm you arrived is the kind of\n	-- ceremony that makes a room feel like a form. A committed bench is not picked up --\n	-- walking past a finished one must not put down the one you are carrying.\n	local at = session.atBench\n	if at ~= nil then\n		local bench = session.benches[at]\n		if bench ~= nil and not bench.committed then\n			session.active = at\n		end\n	end\nend\n\nlocal function tickPlayer(player: Player, elapsed: number)\n	local session = sessions[player]\n	if session == nil then\n		return\n	end\n\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return\n	end\n	local data = Lives.Active(profile.Data)\n\n	-- The closing line, held for a beat and then the session is gone. Checked first so\n	-- nothing below runs against a lab that has already been scored.\n	if session.summary ~= nil then\n		session.verdictLeft -= elapsed\n		if session.verdictLeft <= 0 then\n			sessions[player] = nil\n			pushed[player] = nil\n			LabUpdatedRemote:FireClient(player, nil)\n			return\n		end\n		push(player)\n		return\n	end\n\n	local position = characterPosition(player)\n\n	if not data.alive or not enabled then\n		finish(player, data, session, \"left\")\n		return\n	end\n	if position == nil or Ground.FlatDistance(position, session.center) > SCIENCE.RoomRadiusStuds then\n		finish(player, data, session, \"left\")\n		return\n	end\n\n	readPosition(session, position)\n\n	if session.noticeLeft > 0 then\n		session.noticeLeft -= elapsed\n		if session.noticeLeft <= 0 then\n			session.noticeLeft = 0\n			session.notice = nil\n		end\n	end\n\n	-- The cupboard. Held rather than instant so that a refill is a place you stand for a\n	-- moment, which is what makes running dry during a two-bench stretch cost something\n	-- beyond the walk.\n	if session.atCupboard and session.charges < SCIENCE.SupplyCharges then\n		session.refillHeld += elapsed\n		if session.refillHeld >= SCIENCE.CupboardRefillSeconds then\n			session.refillHeld = 0\n			session.charges = SCIENCE.SupplyCharges\n		end\n	else\n		session.refillHeld = 0\n	end\n\n	-- Clocks. Only benches that are open and uncommitted run down, so the second bench\n	-- is not quietly spending its time before the player has ever seen it.\n	local running = 0\n	for _, bench in session.benches do\n		if bench.committed then\n			continue\n		end\n		running += 1\n		bench.secondsLeft -= elapsed\n		if bench.secondsLeft <= 0 then\n			-- Spoiled: scored where it stands, with no speed credit. Not a failure state\n			-- -- a stack that was five steps of six right is still five steps right.\n			commitBench(data, session, bench, true)\n			running -= 1\n		end\n	end\n\n	-- The second bench opens part way through the first, so the opening stretch teaches\n	-- the verb before it tests it. Opened once and never re-opened: a bench that closed\n	-- and came back would give a player a second attempt at a procedure they had already\n	-- been scored on.\n	local first = session.benches[1]\n	if first ~= nil and #session.benches < session.benchesMax then\n		local elapsedShare = 1 - math.max(0, first.secondsLeft) / SCIENCE.SecondsPerProcedure\n		if elapsedShare >= SCIENCE.SecondBenchAtShare then\n			local drawn = drawProcedure(session)\n			if drawn ~= nil then\n				table.insert(session.benches, {\n					index = #session.benches + 1,\n					procedure = drawn,\n					taken = {},\n					secondsLeft = SCIENCE.SecondsPerProcedure,\n					committed = false,\n					score = nil,\n					verdict = nil,\n				})\n				running += 1\n			else\n				-- Nothing left in the pool that can be run. The lab carries on as a\n				-- one-bench lab rather than waiting forever for a bench that will never\n				-- open -- see the note on `benchesMax`. Not retried, because the pool only\n				-- ever shrinks.\n				session.benchesMax = #session.benches\n			end\n		end\n	end\n\n	-- Every bench committed, and no more to open. The session is over on its own terms\n	-- rather than on the clock, which is the whole reward for working quickly.\n	if running == 0 and #session.benches >= session.benchesMax then\n		finish(player, data, session, \"over\")\n		return\n	end\n\n	push(player)\nend\n\n-- Ends whatever is running and forgets this player entirely, without grading. The one\n-- place a session ends ungraded, because in every case that calls it there is nobody\n-- left to grade -- a player who left, or a life being started over.\nlocal function forget(player: Player)\n	sessions[player] = nil\n	pushed[player] = nil\nend\n\n-- Whether this player is mid-procedure. Read by SchoolService, which has to know that a\n-- birthday landing in the middle of a lab is a year the player turned up for.\nfunction ScienceService.IsRunning(player: Player): boolean\n	return sessions[player] ~= nil\nend\n\n-- A new life. Nobody inherits an education, and the mastery ladder is per life for\n-- exactly the reason bonds and money are.\nfunction ScienceService.ResetForNewLife(player: Player)\n	forget(player)\n	local profile = DataService.GetProfile(player)\n	if profile ~= nil then\n		Mastery.Clear(Lives.Active(profile.Data), SUBJECT_ID)\n	end\n	LabUpdatedRemote:FireClient(player, nil)\nend\n\n-- Studio harness: opens the lab wherever the player is standing, skipping the walk to\n-- the school but nothing else. The room itself is still the built one, so the stations\n-- are wherever they actually are -- a harness that also moved the furniture would be\n-- testing a lab that does not exist.\nfunction ScienceService.ForceStart(player: Player): (boolean, string?)\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return false, \"no profile loaded\"\n	end\n	return ScienceService.Begin(player, Lives.Active(profile.Data))\nend\n\n-- Ends a session and grades it, exactly as running out of room would.\n--\n-- Refuses a session that has already been graded rather than grading it twice. Only\n-- reachable from the harness -- `/lab end` twice inside the verdict beat, which is three\n-- seconds long and easy to hit -- but grading is the one act in this verb that pays\n-- smarts and spends a lesson off the year's allowance, and a command that can be held\n-- down for free smarts is not a harness, it is a cheat.\nfunction ScienceService.ForceEnd(player: Player): boolean\n	local session = sessions[player]\n	local profile = DataService.GetProfile(player)\n	if session == nil or profile == nil or session.summary ~= nil then\n		return false\n	end\n	finish(player, Lives.Active(profile.Data), session, \"over\")\n	return true\nend\n\n-- Studio harness: sets the mastery level directly.\n--\n-- The single most useful command in this system, because the thing mastery buys is how\n-- much of the board you can see -- and the only other way to reach level five is to run\n-- eight good procedures. Clamped rather than refused, so asking for level nine gets the\n-- top of the ladder and a player can see what the ceiling looks like.\nfunction ScienceService.SetLevel(player: Player, level: number): boolean\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return false\n	end\n	local data = Lives.Active(profile.Data)\n	Mastery.Set(data, SUBJECT_ID, level)\n	local clamped = levelOf(data)\n\n	-- Applied to a session in progress too, so the command can be run while standing at\n	-- the board and the effect read off it immediately. That is the whole point of being\n	-- able to set it.\n	local session = sessions[player]\n	if session ~= nil then\n		session.level = clamped\n		session.passes = passesOf(data)\n		push(player)\n	end\n	return true\nend\n\n-- Studio harness: refills the reagent pool without the walk. The cupboard trip is the\n-- thing most likely to be in the way of testing something else.\nfunction ScienceService.Refill(player: Player): boolean\n	local session = sessions[player]\n	if session == nil then\n		return false\n	end\n	session.charges = SCIENCE.SupplyCharges\n	session.refillHeld = 0\n	push(player)\n	return true\nend\n\nfunction ScienceService.SetEnabled(value: boolean)\n	enabled = value\nend\n\nfunction ScienceService.IsEnabled(): boolean\n	return enabled\nend\n\n-- What the harness prints: whether the room exists, then who this player is to it, then\n-- what is actually running -- the same order SchoolService.Describe uses, because\n-- somebody debugging one is usually about to debug the other.\nfunction ScienceService.Describe(player: Player): string\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return \"science: no profile loaded\"\n	end\n	local data = Lives.Active(profile.Data)\n\n	local room = Lab.Room()\n	local where = if room == nil\n		then \"lab not built\"\n		else `lab at {math.floor(room.center.X)}, {math.floor(room.center.Z)}`\n	local missing = Lab.Missing()\n	if #missing > 0 then\n		where ..= ` (missing: {table.concat(missing, \", \")})`\n	end\n\n	local level = levelOf(data)\n	local mastery = `level {level}/{Mastery.Levels}, {revealCountFor(level)} steps shown,`\n		.. ` {passesOf(data)}/{Mastery.PassesPerLevel} passes`\n		.. if Mastery.IsTopped(data, SUBJECT_ID) then \" (topped out -- can skip)\" else \"\"\n\n	local running = \"no session\"\n	local session = sessions[player]\n	if session ~= nil then\n		local parts: { string } = {}\n		for _, bench in session.benches do\n			local state = if bench.committed\n				then `committed {math.floor((bench.score or 0) * 100)}%`\n				else `{#bench.taken}/{#bench.procedure.steps} steps, {string.format(\"%.1f\", bench.secondsLeft)}s`\n			local hand = if session.active == bench.index then \" [in hand]\" else \"\"\n			table.insert(parts, `bench {bench.index} \"{bench.procedure.id}\" {state}{hand}`)\n		end\n		local standing = if session.atBoard\n			then \"at the board\"\n			elseif session.atCupboard then \"at the cupboard\"\n			elseif session.atBench ~= nil then `at bench {session.atBench}`\n			else \"crossing the room\"\n		running = `{table.concat(parts, \"; \")} | {session.charges}/{SCIENCE.SupplyCharges} charges | {standing}`\n	end\n\n	return string.format(\n		\"science: %s | %s | age %d | %s | %d procedures written for this age | %s\",\n		if enabled then \"enabled\" else \"DISABLED\",\n		where,\n		ageYearsOf(data),\n		mastery,\n		#Procedures.ForAge(ageYearsOf(data)),\n		running\n	)\nend\n\nfunction ScienceService:Start()\n	Players.PlayerRemoving:Connect(function(player: Player)\n		forget(player)\n	end)\n\n	RequestLabStepRemote.OnServerEvent:Connect(function(player: Player, stationId: unknown)\n		local ok, err = pcall(onStepRequested, player, stationId)\n		if not ok then\n			warn(`[AGES] lab step failed for {player.Name}: {err}`)\n		end\n	end)\n\n	RequestLabUndoRemote.OnServerEvent:Connect(function(player: Player, benchIndex: unknown)\n		local ok, err = pcall(onUndoRequested, player, benchIndex)\n		if not ok then\n			warn(`[AGES] lab undo failed for {player.Name}: {err}`)\n		end\n	end)\n\n	RequestLabCommitRemote.OnServerEvent:Connect(function(player: Player, benchIndex: unknown)\n		local ok, err = pcall(onCommitRequested, player, benchIndex)\n		if not ok then\n			warn(`[AGES] lab commit failed for {player.Name}: {err}`)\n		end\n	end)\n\n	task.spawn(function()\n		while true do\n			local elapsed = task.wait(SCIENCE.TickSeconds)\n			for _, player in Players:GetPlayers() do\n				local ok, err = pcall(tickPlayer, player, elapsed)\n				if not ok then\n					warn(`[AGES] science tick failed for {player.Name}: {err}`)\n				end\n			end\n		end\n	end)\nend\n\nreturn ScienceService\n"
table.insert(AGES_MANIFEST, "src/server/services/ScienceService.luau")
AGES_SOURCES["src/server/services/SettingsService.luau"] = "--!strict\n-- Preferences: what the player has turned on and off, and nothing about what those\n-- switches do.\n--\n-- **Why the server owns a screen full of client-side switches.** Every option in\n-- `Config.Settings.Options` is acted on by the client -- hiding a dial, suppressing a\n-- popup, putting a confirm in front of a button. None of it needs a server. What needs a\n-- server is that it survives a rejoin, and the only thing in this game that survives a\n-- rejoin is the profile. Once the profile is the store, the client holding its own copy\n-- buys nothing and costs a whole class of bug: a switch that looks flipped, quietly fails\n-- to save, and comes back the other way an hour later with nothing in between to blame it\n-- on. So the client draws only what it was pushed, never what it clicked, and this file is\n-- the only writer.\n--\n-- **What is deliberately not here.** No effects. This service does not know that\n-- `minimap` hides a dial, and it must not learn: the day it does, half of every option's\n-- behaviour lives here and half lives in the client, and a switch that half-works becomes\n-- something you debug in two files. It validates ids, stores booleans and pushes.\n--\n-- The save is sparse: only options the player has actually moved are written, and an\n-- absent key means \"still whatever Config says\". That is what keeps a default changeable\n-- later -- see the comment on `ProfileData.settings`.\n\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Config = require(ReplicatedStorage:WaitForChild(\"Config\"))\nlocal Remotes = require(ReplicatedStorage:WaitForChild(\"Remotes\"))\nlocal Types = require(ReplicatedStorage:WaitForChild(\"Types\"))\n\nlocal DataService = require(script.Parent.DataService)\n\ntype Player = Players.Player\ntype SettingState = Types.SettingState\n\nlocal SettingsService = {}\n\nlocal OPTIONS = Config.Settings.Options\nlocal SETTINGS_UPDATED = Remotes.Get(\"SettingsUpdated\")\nlocal REQUEST_SET_SETTING = Remotes.Get(\"RequestSetSetting\")\n\n-- Built once from Config, for the same reason `SkillService` builds its own: a write\n-- against a name nobody defined has to be caught by a lookup, not by silently growing a\n-- key in a save file that nothing will ever draw or clean up.\nlocal DEFINED: { [string]: typeof(OPTIONS[1]) } = {}\nfor _, option in OPTIONS do\n	if DEFINED[option.id] ~= nil then\n		error(`Config.Settings.Options: two options share the id \"{option.id}\". Ids key the save and must be unique.`)\n	end\n	DEFINED[option.id] = option\nend\n\nlocal function settingsTable(player: Player): { [string]: boolean }?\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return nil\n	end\n	return profile.Data.settings\nend\n\n-- Read one option for this player, falling through to the Config default.\n--\n-- Public because the server side of an option is allowed to exist -- nothing today needs\n-- it, but the first option that gates something server-side should ask here rather than\n-- reaching into the profile, so that \"what does absent mean\" has exactly one answer.\nfunction SettingsService.IsOn(player: Player, id: string): boolean\n	local option = DEFINED[id]\n	if option == nil then\n		error(`SettingsService.IsOn: no setting \"{id}\". Add it to Config.Settings.Options or fix the id at the call site.`)\n	end\n	local settings = settingsTable(player)\n	if settings == nil then\n		return option.default\n	end\n	local stored = settings[id]\n	if stored == nil then\n		return option.default\n	end\n	return stored\nend\n\n-- Every option in Config order, with the caption that matches the state it is in.\n--\n-- Iterated over Config rather than over the save, which is the same rule the skills pane\n-- follows and for a sharper reason here: the save is sparse, so a pane built from it would\n-- list only the options the player had already found.\nlocal function stateFor(player: Player): { SettingState }\n	local settings = settingsTable(player)\n	local states: { SettingState } = {}\n	for _, option in OPTIONS do\n		local on = option.default\n		if settings ~= nil and settings[option.id] ~= nil then\n			on = settings[option.id]\n		end\n		table.insert(states, {\n			id = option.id,\n			label = option.label,\n			caption = if on then option.captionOn else option.captionOff,\n			on = on,\n		})\n	end\n	return states\nend\n\n-- Send the whole pane. Whole rather than one row, because the alternative is a client that\n-- has to merge pushes, and four booleans are not worth a merge.\nfunction SettingsService.Push(player: Player)\n	if DataService.GetProfile(player) == nil then\n		return\n	end\n	SETTINGS_UPDATED:FireClient(player, { settings = stateFor(player) } :: Types.SettingsState)\nend\n\nlocal function set(player: Player, id: string, on: boolean)\n	local option = DEFINED[id]\n	if option == nil then\n		-- Refused rather than raised. This arrives from a client, and an unknown id here is\n		-- either a stale build or somebody poking the remote -- neither of which is a reason\n		-- to error out of a remote handler, and both of which are worth seeing in the log.\n		warn(`SettingsService: refused an unknown setting id \"{id}\" from {player.Name}.`)\n		return\n	end\n\n	local settings = settingsTable(player)\n	if settings == nil then\n		return\n	end\n\n	-- Stored even when it matches the default, and this is on purpose. Writing only\n	-- non-default values would keep the save smaller and would silently move a player back\n	-- onto a default that changed under them after they had explicitly chosen it. Once a\n	-- player has touched a switch, that choice is theirs and outlives our opinion of it.\n	settings[id] = on\n	SettingsService.Push(player)\nend\n\nfunction SettingsService:Init()\n	REQUEST_SET_SETTING.OnServerEvent:Connect(function(player: Player, id: unknown, on: unknown)\n		if type(id) ~= \"string\" or type(on) ~= \"boolean\" then\n			return\n		end\n		set(player, id, on)\n	end)\n\n	Players.PlayerAdded:Connect(function(player: Player)\n		SettingsService.Push(player)\n	end)\nend\n\nfunction SettingsService:Start()\n	-- Nothing to run. Settings change when a player changes one, and never otherwise.\nend\n\n-- Every option on one line, for `/setting`. Reads the same `stateFor` the client is pushed,\n-- so a row that draws wrong and a line that prints wrong are guaranteed to be one bug.\nfunction SettingsService.Describe(player: Player): string\n	local lines: { string } = {}\n	for _, state in stateFor(player) do\n		table.insert(lines, `{state.id}={if state.on then \"on\" else \"off\"}`)\n	end\n	return table.concat(lines, \", \")\nend\n\n-- Flip one from a debug command. Separate from the remote handler so that `/setting` tests\n-- the same write path a click does, without inventing a second one that could drift.\nfunction SettingsService.Force(player: Player, id: string, on: boolean): boolean\n	if DEFINED[id] == nil then\n		return false\n	end\n	set(player, id, on)\n	return true\nend\n\nreturn SettingsService\n"
table.insert(AGES_MANIFEST, "src/server/services/SettingsService.luau")
AGES_SOURCES["src/server/services/SetupService.luau"] = "--!strict\n-- What this place does about a life having been chosen somewhere else.\n--\n-- **This file used to be the character menu, and part 3 moved it out.** It built the options\n-- payload, validated an answer, filtered a typed name and wrote the life -- drawn as a card\n-- over a town that was standing still, because `LifeData.setup` being absent is what every\n-- clock in this game checks before it moves. The menu was not a screen over the world; it\n-- was the world refusing to start.\n--\n-- All of that now lives in the lobby, where there is no world behind it to hold still. See\n-- `lobby/server/services/LobbySetupService.luau` for the half that needs a player, and\n-- `content/LifeSetup.luau` for the rules themselves, which are one file required by both\n-- places so that a card in the lobby and a name in the game cannot disagree.\n--\n-- What is left here is the three things that only make sense on this side:\n--\n--   * `SetBeginHandler` / the begin path -- what runs the instant a life starts.\n--   * `Skip` -- the debug harness answering the card that is not here, so a test of school\n--     or a job does not have to be started by teleporting through a menu.\n--   * `NameOf` / `CountryOf` -- reading a life that has already been chosen, which half the\n--     services in this place do when they put somebody's name in a sentence.\n--\n-- Note what is *not* here any more: `Ask`. There is nothing to ask. A player who arrives\n-- with no life in their slot is not shown a menu, they are sent back to the one that exists\n-- -- see ReturnService, which is the other half of this change.\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Types = require(ReplicatedStorage:WaitForChild(\"Types\"))\nlocal Lives = require(ReplicatedStorage:WaitForChild(\"Lives\"))\n\nlocal DataService = require(script.Parent.DataService)\nlocal StatService = require(script.Parent.StatService)\nlocal LifeSetup = require(script.Parent.Parent.content.LifeSetup)\n\ntype LifeData = Types.LifeData\ntype Gender = Types.Gender\ntype Country = Types.Country\ntype LifeSetupData = Types.LifeSetup\n\nlocal SetupService = {}\n\n-- Handed over rather than required, because LifeService requires this module and requiring\n-- it back would close a cycle. The same device LifeService already uses for EventService's\n-- age-up handler.\ntype BeginHandler = (player: Player) -> ()\nlocal beginHandler: BeginHandler? = nil\n\n-- What to run once a life is under way: push the opening state and offer the first event of\n-- age zero. Owned by LifeService because it is the same work a rebirth used to do inline.\nfunction SetupService.SetBeginHandler(handler: BeginHandler)\n	beginHandler = handler\nend\n\n-- Write the life down and start it.\n--\n-- Reduced to one caller -- `Skip` -- and kept as its own function anyway, because the two\n-- things it does are in an order that matters and the order is not obvious: the setup is\n-- written before the stats are applied, because StatService pushes to the client and the\n-- client is about to raise a HUD.\nlocal function commit(player: Player, data: LifeData, gender: Gender, setup: LifeSetupData, deltas: { [string]: number }?)\n	data.gender = gender\n	data.setup = setup\n\n	if deltas ~= nil then\n		for _, statName in LifeSetup.StatOrder do\n			local delta = deltas[statName] or 0\n			if delta ~= 0 then\n				StatService.AddStat(player, statName, delta)\n			end\n		end\n	end\n\n	local handler = beginHandler\n	if handler == nil then\n		-- Unreachable once LifeService has run its Init, and a warn rather than a silent\n		-- return because the symptom -- a life that exists on the profile but in which nothing\n		-- ever happens -- is one nobody would think to trace back to a missing handler.\n		warn(`[AGES] {player.Name} began a life with no begin handler registered; the life will not start`)\n		return\n	end\n	handler(player)\nend\n\n-- What the game calls this life, for anywhere a life needs naming. Falls back to the\n-- player's Roblox name rather than to an empty string, because every caller of this is\n-- putting it in a sentence.\n--\n-- A pass-through to `LifeSetup` rather than a second implementation. It stays on this module\n-- because a dozen services in this place already call `SetupService.NameOf` and none of them\n-- has any business knowing which of two places defined the rule.\nfunction SetupService.NameOf(data: LifeData, fallback: string): string\n	return LifeSetup.NameOf(data, fallback)\nend\n\n-- The country this life began in, or nil if it has not begun.\nfunction SetupService.CountryOf(data: LifeData): Country?\n	return LifeSetup.CountryOf(data)\nend\n\n-- Start a rolled life in the slot the player arrived on, without the lobby.\n--\n-- The debug path for everything that lives *after* setup: a test of school or a job should\n-- not have to be reached by teleporting out to the menu and filling in a card, and in Studio\n-- -- where teleports do not work at all -- there is no menu to reach. This is the command\n-- that makes the game place testable on its own.\n--\n-- Goes through `commit` rather than writing the profile itself, so the one thing a harness\n-- must never do -- start a life by a route a player could not take -- stays structurally\n-- impossible. Returns what it rolled, or nil if there was nothing to answer, which is what\n-- the command prints.\n--\n-- `force` discards whatever is in the active slot first, begun or not, alive or dead. It\n-- exists because a life left in the active slot is otherwise a dead end in *this* place:\n-- plain skip refuses an occupied slot, `/slots delete` refuses the active one, and rebirth\n-- in place is gone -- so a test session that ran a life to death, or that carried one over\n-- from an earlier Studio run (API-backed saves persist across runs), had no way back to a\n-- fresh body without teleporting out to the lobby. This is that way back, and it is debug\n-- only. A brand new life goes through `Lives.New`, so it starts at age zero -- which is what\n-- puts a body back to a crawler and the HUD back to a childhood.\nfunction SetupService.Skip(player: Player, force: boolean?): LifeSetupData?\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return nil\n	end\n	local data = Lives.Active(profile.Data)\n	if Lives.HasBegun(data) then\n		if not force then\n			return nil\n		end\n		-- Overwrite the slot rather than mutate the life in place: a fresh `Lives.New` is the\n		-- one definition of a clean slot, and reaching into the old life to reset field by\n		-- field would be a second, drifting copy of it.\n		local fresh = Lives.New()\n		profile.Data.slots[profile.Data.activeSlot] = fresh\n		data = fresh\n	end\n	-- Already filled in by DataService on load; read rather than rolled, so a skipped setup\n	-- keeps whoever the profile already said this life was. A forced restart rolls a new one,\n	-- because `fresh.gender` is nil and EnsureGender fills it -- a restarted life is not\n	-- obliged to be the same person the discarded one was.\n	local gender = DataService.EnsureGender(data)\n	local setup = LifeSetup.Roll(gender)\n	commit(player, data, gender, setup)\n	return setup\nend\n\nfunction SetupService:Init()\n	-- Checked once at boot rather than discovered when `/setup skip` rolls a life into an era\n	-- that is not playable. The lobby runs the same assertion for the same reason; both places\n	-- read the same list, and a list with nothing pickable in it is a build nobody can play.\n	LifeSetup.AssertPlayable()\nend\n\nreturn SetupService\n"
