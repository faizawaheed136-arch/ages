AGES_SOURCES["src/server/world/ProperSchool/SchoolBuilderEngine.luau"] = "--!strict\n-- The primitives every part of the new school is built from.\n--\n-- Three rules hold across the whole module, and they are the reason it exists rather than\n-- callers writing `Instance.new(\"Part\")` themselves:\n--\n--   * **Everything is anchored.** An unanchored building falls over on the first frame.\n--   * **Every surface is Smooth.** Roblox still defaults `TopSurface` to `Studs` and\n--     `BottomSurface` to `Inlet` on a fresh Part. Leave them and every slab in the building\n--     gets a ring of bumps along its top edge, which is the single most recognisable \"this was\n--     made in 2010\" tell there is. Nothing else in this file matters if that is wrong.\n--   * **Every position is snapped to a grid.** Two walls meant to be flush, placed at\n--     coordinates a ten-thousandth apart, produce a seam that flickers as the camera moves --\n--     z-fighting. Snapping makes flush actually flush, and it makes hand-written coordinates\n--     land where you meant rather than where the arithmetic drifted to.\n\nlocal Engine = {}\n\n-- ---------------------------------------------------------------------------------------\n-- Standard layout parameters\n-- ---------------------------------------------------------------------------------------\n\n-- A quarter stud. Fine enough for trim and glazing bars, coarse enough that accumulated\n-- floating-point error from repeated addition can never open a visible seam.\nlocal GRID = 0.25\n\n-- Glass that reads as glass. Fully transparent glass is a hole; opaque glass is a wall. The\n-- pane also takes a little reflectance, which is what separates a window from a blue rectangle\n-- under Future lighting.\nlocal GLASS_TRANSPARENCY = 0.5\nlocal GLASS_REFLECTANCE = 0.1\n\n-- How much of a wall's thickness the pane occupies. Less than the wall, so the opening reads as\n-- having a reveal -- a pane flush with both faces looks like film stretched over a hole.\nlocal GLASS_DEPTH_SHARE = 0.4\n\n-- ---------------------------------------------------------------------------------------\n-- Internals\n-- ---------------------------------------------------------------------------------------\n\nlocal function snap(value: Vector3): Vector3\n	return Vector3.new(\n		math.round(value.X / GRID) * GRID,\n		math.round(value.Y / GRID) * GRID,\n		math.round(value.Z / GRID) * GRID\n	)\nend\n\n-- A rotation from degrees, in the same Y-X-Z order the `Orientation` property uses.\n--\n-- Built from `CFrame.Angles` rather than `CFrame.fromOrientation` because the headless harness\n-- that bakes this school to an asset reimplements only enough of CFrame to carry a translation\n-- times a rotation. Staying inside that subset is what makes the module bakeable at all.\nlocal function rotationOf(orientation: Vector3): CFrame\n	return CFrame.Angles(0, math.rad(orientation.Y), 0)\n		* CFrame.Angles(math.rad(orientation.X), 0, 0)\n		* CFrame.Angles(0, 0, math.rad(orientation.Z))\nend\n\n-- Every part in the school comes through here, so the three rules above are enforced in exactly\n-- one place and cannot drift between call sites.\n--\n-- **Placement is a CFrame, never `.Position` plus `.Orientation`.** Those two are equivalent in\n-- Studio but not everywhere else: the asset bake records what a part was *assigned*, and a part\n-- given a Position and an Orientation separately bakes with its rotation thrown away. One CFrame\n-- carries both, so what Studio shows and what the bake writes cannot disagree.\nlocal function spawn(\n	name: string,\n	position: Vector3,\n	size: Vector3,\n	material: Enum.Material,\n	color: Color3,\n	parent: Instance,\n	orientation: Vector3?\n): Part\n	local part = Instance.new(\"Part\")\n	part.Name = name\n	part.Size = size\n	-- The identity case is skipped rather than multiplied through: an unrotated part is the\n	-- common one, and `CFrame.new()` with no arguments is not something every environment this\n	-- module runs under implements.\n	local frame = CFrame.new(snap(position))\n	if orientation ~= nil then\n		frame = frame * rotationOf(orientation)\n	end\n	part.CFrame = frame\n	part.Anchored = true\n	part.CastShadow = true\n	part.Material = material\n	part.Color = color\n	part.TopSurface = Enum.SurfaceType.Smooth\n	part.BottomSurface = Enum.SurfaceType.Smooth\n	part.Parent = parent\n	return part\nend\n\nlocal function assertPositive(size: Vector3, what: string)\n	if size.X <= 0 or size.Y <= 0 or size.Z <= 0 then\n		error(`[SchoolBuilderEngine] {what} must be positive on every axis, got {size}`, 3)\n	end\nend\n\n-- ---------------------------------------------------------------------------------------\n-- Public\n-- ---------------------------------------------------------------------------------------\n\n-- A single wall panel.\n--\n-- `orientation` is in degrees and is set through the `Orientation` property rather than a\n-- CFrame, so the numbers here are the same numbers Studio's property panel shows -- which is\n-- what you want when you are checking a build by eye against the code that made it.\nfunction Engine.CreateWall(\n	position: Vector3,\n	size: Vector3,\n	orientation: Vector3,\n	material: Enum.Material,\n	color: Color3,\n	parent: Instance\n): Part\n	assertPositive(size, \"wall size\")\n	return spawn(\"Wall\", position, size, material, color, parent, orientation)\nend\n\n-- A floor plate.\n--\n-- Deliberately not a thin wall with different arguments: a floor is the one surface players\n-- stand on, so it is worth having a call that cannot be given an orientation by accident and\n-- tilted half a degree.\nfunction Engine.CreateFloor(\n	position: Vector3,\n	size: Vector3,\n	material: Enum.Material,\n	color: Color3,\n	parent: Instance\n): Part\n	assertPositive(size, \"floor size\")\n	return spawn(\"Floor\", position, size, material, color, parent)\nend\n\n-- A wall with a window in it.\n--\n-- **Roblox cannot punch a hole in a Part, so this frames around one.** There is no runtime\n-- boolean subtraction worth using here -- CSG at build time is slow, produces unions that cost\n-- more to render than the parts they replace, and breaks streaming. What a careful builder does\n-- instead is exactly what a real one does: two piers either side of the opening, a header over\n-- it, a sill under it, and the pane in the gap. Five parts, all primitives, all cheap.\n--\n-- The wall runs along its local X. `wallSize.X` is its length, `.Y` its height, `.Z` its\n-- thickness; `windowSize.X` and `.Y` are the opening, and `windowSize.Z` is ignored -- the pane\n-- takes its depth from the wall so it can never end up thicker than what it sits in.\n--\n-- `orientation` is optional and trails the given signature, so a wall that does not run along\n-- world X is still one call.\nfunction Engine.CreateWindowCutout(\n	wallPosition: Vector3,\n	wallSize: Vector3,\n	windowSize: Vector3,\n	parent: Instance,\n	orientation: Vector3?,\n	material: Enum.Material?,\n	color: Color3?\n): Model\n	assertPositive(wallSize, \"wall size\")\n	assertPositive(windowSize, \"window size\")\n	if windowSize.X >= wallSize.X or windowSize.Y >= wallSize.Y then\n		error(\n			`[SchoolBuilderEngine] window {windowSize.X}x{windowSize.Y} does not fit inside wall`\n				.. ` {wallSize.X}x{wallSize.Y} -- it would leave a pier or a header of zero width,`\n				.. ` and a zero-size Part is clamped to 0.05 rather than omitted.`,\n			2\n		)\n	end\n\n	local wallMaterial = material or Enum.Material.SmoothPlastic\n	local wallColor = color or Color3.fromRGB(226, 228, 232)\n\n	local model = Instance.new(\"Model\")\n	model.Name = \"WindowWall\"\n\n	local pierWidth = (wallSize.X - windowSize.X) / 2\n	local bandHeight = (wallSize.Y - windowSize.Y) / 2\n	local glassDepth = wallSize.Z * GLASS_DEPTH_SHARE\n\n	-- Laid out in the wall's own frame first, then moved as one. Building in local space and\n	-- transforming once is what lets the same code serve any orientation without every piece\n	-- needing its own trigonometry.\n	local pieces: { { name: string, offset: Vector3, size: Vector3 } } = {\n		{\n			name = \"PierLeft\",\n			offset = Vector3.new(-(windowSize.X + pierWidth) / 2, 0, 0),\n			size = Vector3.new(pierWidth, wallSize.Y, wallSize.Z),\n		},\n		{\n			name = \"PierRight\",\n			offset = Vector3.new((windowSize.X + pierWidth) / 2, 0, 0),\n			size = Vector3.new(pierWidth, wallSize.Y, wallSize.Z),\n		},\n		{\n			name = \"Header\",\n			offset = Vector3.new(0, (windowSize.Y + bandHeight) / 2, 0),\n			size = Vector3.new(windowSize.X, bandHeight, wallSize.Z),\n		},\n		{\n			name = \"Sill\",\n			offset = Vector3.new(0, -(windowSize.Y + bandHeight) / 2, 0),\n			size = Vector3.new(windowSize.X, bandHeight, wallSize.Z),\n		},\n	}\n\n	local base = CFrame.new(snap(wallPosition))\n	if orientation ~= nil then\n		base = base * rotationOf(orientation)\n	end\n\n	for _, piece in pieces do\n		local part = spawn(piece.name, wallPosition, piece.size, wallMaterial, wallColor, model)\n		part.CFrame = base * CFrame.new(piece.offset)\n	end\n\n	local glass = spawn(\n		\"Glass\",\n		wallPosition,\n		Vector3.new(windowSize.X, windowSize.Y, glassDepth),\n		Enum.Material.Glass,\n		Color3.fromRGB(198, 220, 236),\n		model\n	)\n	glass.CFrame = base\n	glass.Transparency = GLASS_TRANSPARENCY\n	glass.Reflectance = GLASS_REFLECTANCE\n\n	model.PrimaryPart = glass\n	model.Parent = parent\n	return model\nend\n\nreturn Engine\n"
table.insert(AGES_MANIFEST, "src/server/world/ProperSchool/SchoolBuilderEngine.luau")
AGES_SOURCES["src/server/world/ProperSchool/Tree.luau"] = "--!strict\n-- The folder tree everything in the new school is parented into.\n--\n-- **Idempotent, and that is the entire point of the file.** This runs against a live Workspace\n-- that may already be holding a half-built school -- from a previous run, a Rojo sync, or a\n-- plugin insert -- and a second run has to *adopt* what is already there rather than lay a\n-- second copy beside it. Duplicated roots are the single most expensive mistake in a build\n-- pipeline like this one: every later lookup finds one of the two at random, half the building\n-- ends up in the orphan, and nothing errors.\n--\n-- `FindFirstChild` before `Instance.new` is the whole of that guarantee.\n\nlocal PLAN: { [string]: { string } } = {\n	-- Split by storey rather than by trade, because the thing you most often want to hide,\n	-- reload or measure in isolation is one floor.\n	Architecture = { \"Exterior\", \"Floor1\", \"Floor2\", \"Floor3\" },\n	Furniture = {},\n	Lighting = {},\n	Props = {},\n}\n\nlocal ROOT_NAME = \"ProperSchool\"\n\nexport type Tree = {\n	Root: Folder,\n	Architecture: Folder,\n	Exterior: Folder,\n	Floor1: Folder,\n	Floor2: Folder,\n	Floor3: Folder,\n	Furniture: Folder,\n	Lighting: Folder,\n	Props: Folder,\n}\n\nlocal Tree = {}\n\n-- One folder, created or adopted.\n--\n-- Errors rather than guesses when the name is taken by something that is not a Folder. The\n-- alternatives are both worse: renaming somebody else's instance is destructive, and quietly\n-- parenting the school into a Part produces a build that looks fine until it does not.\nlocal function ensure(name: string, parent: Instance): Folder\n	local existing = parent:FindFirstChild(name)\n	if existing ~= nil then\n		if existing:IsA(\"Folder\") then\n			return existing\n		end\n		error(\n			`[AGES ProperSchool] {parent:GetFullName()}.{name} exists and is a {existing.ClassName}, not a Folder.`\n				.. ` Rename or remove it -- this script will not overwrite an instance it did not create.`\n		)\n	end\n\n	local made = Instance.new(\"Folder\")\n	made.Name = name\n	made.Parent = parent\n	return made\nend\n\n-- Builds the tree under `parent` (Workspace by default) and hands back every folder by name.\n--\n-- Returned flat rather than nested: the storey names are unique across the whole plan, so a\n-- flat table is both shorter to write against (`tree.Floor2`) and impossible to get wrong by\n-- reaching into the wrong branch.\nfunction Tree.Build(parent: Instance?): Tree\n	local into = parent or workspace\n	local root = ensure(ROOT_NAME, into)\n\n	local built: { [string]: Folder } = { Root = root }\n	for branch, leaves in PLAN do\n		local folder = ensure(branch, root)\n		built[branch] = folder\n		for _, leaf in leaves do\n			built[leaf] = ensure(leaf, folder)\n		end\n	end\n\n	return built :: any\nend\n\n-- Removes the tree. Separate from Build so a rebuild is an explicit choice rather than a side\n-- effect of running the builder again -- see the note at the top about adopting.\nfunction Tree.Clear(parent: Instance?): ()\n	local existing = (parent or workspace):FindFirstChild(ROOT_NAME)\n	if existing ~= nil then\n		existing:Destroy()\n	end\nend\n\nreturn Tree\n"
table.insert(AGES_MANIFEST, "src/server/world/ProperSchool/Tree.luau")
AGES_SOURCES["src/server/world/ReadingRoom.luau"] = "--!strict\n-- The reading room, as a room that exists.\n--\n-- Two things in it: the desk you build words at, and the shelf you draw a fresh tray of\n-- tiles from when the one you have is spent.\n--\n-- The distance between them is deliberately *short*, and that is the one decision in this\n-- file worth defending, because the art room next door makes the opposite one. There the\n-- walk is the mechanic -- fetching paint costs you sight of the picture, so the cupboard is\n-- put behind the player on purpose. Here the mechanic is the allocation at the desk, and a\n-- long walk would not deepen it, it would only interrupt it. The shelf exists so a tray has\n-- a refill cost, not so the room is big.\n--\n-- Split from ReadingService for the reason Lab is split from ScienceService and Studio from\n-- ArtService: where a thing stands and what happens when you reach it are different\n-- questions, and re-laying the room must never be able to touch the scoring.\n--\n-- Laid in Luau at runtime around the school place point, like the lab, the studio and the\n-- corridor. Every position is derived from the centre it is handed -- there is not an\n-- absolute world coordinate in this file, and there must never be one, because the map\n-- still moves and place-point ids are the only thing that is stable.\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Config = require(ReplicatedStorage:WaitForChild(\"Config\"))\n\nlocal ReadingRoom = {}\n\nlocal READING = Config.School.Reading\nlocal BUILD = READING.Build\n\n-- What a built room hands back. Two points, and nothing else: unlike the art room there is\n-- no piece of furniture here whose *appearance* is state. The board is per player and\n-- pushed, because two children at the same desk are finishing different words.\nexport type Room = {\n	center: Vector3,\n	desk: Vector3,\n	shelf: Vector3,\n}\n\nlocal room: Room? = nil\nlocal folder: Folder? = nil\n\n-- Everything the reading room puts in the world lives in one folder, the same arrangement\n-- the other three make and separate from them because the four get cleared for different\n-- reasons.\nlocal function roomFolder(): Folder\n	local existing = folder\n	if existing ~= nil and existing.Parent ~= nil then\n		return existing\n	end\n	local made = Instance.new(\"Folder\")\n	made.Name = \"ReadingRoom\"\n	made.Parent = workspace\n	folder = made\n	return made\nend\n\n-- A point on the room\\'s circle, in the same terms Lab.onCircle and Studio.onCircle use, so\n-- a layout number here and a layout number there mean the same thing.\nlocal function onCircle(center: Vector3, bearing: number, share: number): Vector3\n	local direction = CFrame.Angles(0, math.rad(bearing), 0) * Vector3.new(0, 0, -1)\n	return center + direction * (BUILD.RoomRadiusStuds * share)\nend\n\n-- One piece of placeholder furniture, sat on the floor rather than centred in it.\n-- Non-collidable for the reason the lab\\'s and the studio\\'s are: what costs the player\n-- something here is deciding where a letter goes, not walking around a desk.\nlocal function buildBlock(name: string, at: Vector3, size: Vector3, color: Color3): BasePart\n	local part = Instance.new(\"Part\")\n	part.Name = name\n	part.Size = size\n	part.CFrame = CFrame.new(at + Vector3.new(0, size.Y / 2, 0))\n	part.Anchored = true\n	part.CanCollide = false\n	part.Color = color\n	part.Material = Enum.Material.SmoothPlastic\n	part.TopSurface = Enum.SurfaceType.Smooth\n	part.BottomSurface = Enum.SurfaceType.Smooth\n	part.Parent = roomFolder()\n	return part\nend\n\n-- The name over a piece of furniture, built in the world rather than pushed, because what a\n-- thing *is* is true for everybody standing in the room.\nlocal function buildLabel(part: BasePart, text: string, width: number)\n	local sign = Instance.new(\"BillboardGui\")\n	sign.Name = \"Label\"\n	sign.Adornee = part\n	sign.Size = UDim2.new(width, 0, 1.1, 0)\n	sign.StudsOffsetWorldSpace = Vector3.new(0, part.Size.Y / 2 + 1.2, 0)\n	sign.MaxDistance = BUILD.LabelMaxDistanceStuds\n	sign.AlwaysOnTop = true\n	sign.Parent = part\n\n	local label = Instance.new(\"TextLabel\")\n	label.Name = \"Text\"\n	label.Size = UDim2.new(1, 0, 1, 0)\n	label.BackgroundTransparency = 1\n	label.Font = Enum.Font.GothamMedium\n	label.TextScaled = true\n	label.TextColor3 = Color3.fromRGB(248, 246, 240)\n	label.TextStrokeTransparency = 0.4\n	label.Text = text\n	label.Parent = sign\nend\n\n-- Builds the room around a centre point, once. Nil means it could not be laid, which the\n-- caller turns into Reading refusing at the door with a reason rather than into a lesson\n-- that opens onto nothing.\nfunction ReadingRoom.Build(center: Vector3): Room?\n	local existing = room\n	if existing ~= nil then\n		return existing\n	end\n\n	local deskAt = onCircle(center, BUILD.DeskBearing, BUILD.DeskDistanceShare)\n	local shelfAt = onCircle(center, BUILD.ShelfBearing, BUILD.ShelfDistanceShare)\n\n	local desk = buildBlock(\"ReadingDesk\", deskAt, BUILD.DeskSize, Color3.fromRGB(138, 106, 72))\n	buildLabel(desk, \"Desk\", 6)\n\n	local shelf = buildBlock(\"LetterShelf\", shelfAt, BUILD.ShelfSize, Color3.fromRGB(112, 124, 132))\n	-- Says what it hands out rather than what it is called, because a shelf is only\n	-- interesting to somebody whose tray has run dry and that is the moment they will be\n	-- reading it from across the room.\n	buildLabel(shelf, \"Letters\", 6)\n\n	local built: Room = {\n		center = center,\n		desk = deskAt,\n		shelf = shelfAt,\n	}\n	room = built\n	return built\nend\n\n-- The room as it stands, or nil if it has not been laid yet. Read rather than built by\n-- callers that must not cause one to appear.\nfunction ReadingRoom.Room(): Room?\n	return room\nend\n\n-- Takes the room down, for the new-life path -- the same reason Corridor.Clear exists: the\n-- folder is rebuilt around whichever school point the next life walks into.\nfunction ReadingRoom.Clear()\n	local existing = folder\n	if existing ~= nil then\n		existing:Destroy()\n	end\n	folder = nil\n	room = nil\nend\n\nreturn ReadingRoom\n"
table.insert(AGES_MANIFEST, "src/server/world/ReadingRoom.luau")
AGES_SOURCES["src/server/world/Roam.luau"] = "--!strict\n-- Somebody going about their day.\n--\n-- A townsperson who stands on a ring around the shop forever is a shop fitting. The\n-- difference between a world with people in it and a world with statues in it is\n-- almost entirely this file, and it is a small file: walk somewhere, stand there for a\n-- bit, walk somewhere else. What makes it read as a person rather than as a patrol is\n-- the standing still. A town that never stops moving is a town of couriers.\n--\n-- Knows nothing about who is walking. It takes a body, the wander that body is partway\n-- through, and control of neither -- pause and resume are the caller's, because the\n-- reason to stop is always something this file cannot see, and so far that reason is\n-- always \"you are talking to them\".\n--\n-- **Two things live here, and the split is the important part.** `NextLeg` decides where\n-- a townsperson goes next and is the only thing that does; `Start` drives a rig along\n-- whatever `NextLeg` says. They are separate because *most townsfolk have no rig*. A\n-- person out of the player's range is a position advancing along the same route, stepped\n-- by PeopleService rather than walked by Roblox, and when the player comes near enough\n-- for a body to be built it picks up the same wander mid-stride. One brain, two ways of\n-- moving the legs -- which is what stops a person teleporting when they come into view.\n--\n-- **Where they can go.** Two tiers, and the first one is optional:\n--\n--   Town points    A graph of the parts tagged Config.World.TownPointTag; see Routes.\n--                  When there is one in reach it wins outright, because a spot somebody\n--                  put on a path is a better place to walk to than a spot the arithmetic\n--                  found on a lawn. This is what turns wandering into people using the\n--                  streets that were actually built.\n--   Probed spots   A bearing and a distance off the place they belong to, floor-probed\n--                  and clearance-checked before it is walked to. Needs nothing tagged in\n--                  Studio and works in a bare world, which is why it is the floor rather\n--                  than the fallback -- but it is a much smaller world, bounded by\n--                  RoamStuds instead of RangeStuds, because open ground is not a path\n--                  and walking a hundred studs of it goes through the flowerbeds.\n--\n-- **Why the randomness is not seeded.** The town itself is fixed forever -- who exists,\n-- what they look like, how old they are -- because bonds are saved against them. Where\n-- one of them happens to be standing this second is not that, and must not be: a seeded\n-- roam would have thirty people walking the same loop on every server, in step, which\n-- is a parade.\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Config = require(ReplicatedStorage:WaitForChild(\"Config\"))\n\nlocal NPCService = require(script.Parent.Parent.services.NPCService)\nlocal Ground = require(script.Parent.Ground)\nlocal Routes = require(script.Parent.Routes)\n\ntype Visitor = NPCService.Visitor\n\nlocal Roam = {}\n\nlocal TOWN = Config.Town\n\n-- How finely a rest is sliced. Only bounds how quickly a stop or a teardown is\n-- noticed while somebody is standing still, so it can be coarse -- but not so coarse\n-- that a rig outlives the roster by a visible beat.\nlocal REST_SLICE_SECONDS = 0.25\n\n-- Studio harness switch, and the one thing that tells a walking bug apart from a\n-- bonding one. Module-level rather than per walker because \"nobody in the town moves\"\n-- is the question being asked, and asking it of each of them separately would leave\n-- whoever was mid-stride still striding.\nlocal enabled = true\n\n\n-- One townsperson's journey, held by whoever owns them rather than by this file, because\n-- it has to outlive their body. A rig is built and destroyed every time the player walks\n-- past; the wander is the same wander either side of that, which is the whole reason\n-- somebody followed down a street stays where they were going.\nexport type Wander = {\n	-- Which node of the route graph they are heading for, and the one before it. Nil\n	-- while they are off the graph entirely, which is where everybody starts and where\n	-- everybody stays in a world with nothing tagged.\n	node: number?,\n	previous: number?,\n	-- The place they belong to. The anchor for the leash and for probed spots alike, so\n	-- a person can be far from it without ever being unmoored from it.\n	home: Vector3,\n	rng: Random,\n}\n\n-- A probed spot near home. The floor of the whole system: needs nothing tagged and works\n-- in a bare world, at the cost of a much smaller world, because a bearing and a distance\n-- off a point is only a path by accident.\n--\n-- The distance floor is doing real work. Without it somebody standing near home picks a\n-- spot about where they already are and spends the afternoon deciding to stay put, which\n-- looks far more broken than standing still does.\nlocal function probedSpot(home: Vector3, at: Vector3, rng: Random): Vector3?\n	local radius = Config.NPC.BodyRadius\n	local height = Config.NPC.BodyHeight\n	for _ = 1, TOWN.RoamAttempts do\n		local bearing = rng:NextNumber(0, math.pi * 2)\n		local distance = rng:NextNumber(TOWN.MinLegStuds, TOWN.RoamStuds)\n		local candidate = home + Vector3.new(math.cos(bearing) * distance, 0, math.sin(bearing) * distance)\n		if Ground.FlatDistance(candidate, at) < TOWN.MinLegStuds then\n			continue\n		end\n\n		-- The same probes every system here runs before putting a body somewhere. Cheap,\n		-- and the alternative is asking PathfindingService for a route to the inside of a\n		-- wall and taking the refusal as an answer about the walker.\n		--\n		-- No reachability, deliberately: a roamer walking to the next leg of its wander\n		-- is going to be pathfound there anyway, and the pathfinder is the better judge\n		-- of a route than one straight line ever is. The two probes here are only asking\n		-- whether the destination is a real place, not how to get to it.\n		local ignore = Ground.IgnoreList()\n		local floor = Ground.SpotAt(candidate, radius, height, ignore)\n		if floor == nil then\n			continue\n		end\n		return floor\n	end\n\n	return nil\nend\n\n-- Somewhere worth walking to from where they are now, or nil if nothing was found and\n-- the rest should simply run again. Advances the wander as a side effect, which is why\n-- both the bodied and the bodiless call this rather than each keeping their own idea of\n-- where somebody had got to.\nfunction Roam.NextLeg(wander: Wander, at: Vector3): Vector3?\n	local node, target = Routes.Step(wander.node, wander.previous, at, wander.home, wander.rng)\n	if target ~= nil then\n		wander.previous = wander.node\n		wander.node = node\n		return target\n	end\n\n	-- No graph in reach. Off the graph they go, so that the next leg re-joins it at\n	-- whatever is nearest rather than resuming from a node they have since walked away\n	-- from -- which is what makes tagging a point mid-session take effect.\n	wander.previous = nil\n	wander.node = nil\n	return probedSpot(wander.home, at, wander.rng)\nend\n\n-- One walker's wandering, and every way it can be interrupted.\nexport type Roam = {\n	-- Stop where you stand and start nothing new. What being spoken to does. Does not\n	-- turn them -- that is the caller's, because only the caller knows who to turn to.\n	pause: () -> (),\n	resume: () -> (),\n	-- For good. The body is the caller's to destroy; this only stops the loop asking it\n	-- to walk, which has to happen first or the next leg is issued against a rig that\n	-- is halfway through being taken down.\n	stop: () -> (),\n	-- What they are doing right now, for the harness. A word rather than a set of\n	-- booleans, because the question `/town` is asking is \"why is this one not moving\"\n	-- and every answer to it is one of these.\n	state: () -> string,\n}\n\n-- `resume` is the leg they were already on when the body was built, and passing it is what\n-- makes coming into view seamless rather than merely non-teleporting. Without it the loop\n-- below opens with a rest, so somebody who has been walking across town for a minute stops\n-- dead for up to eleven seconds at the exact moment the player can first see them -- which\n-- is a worse artefact than the one this whole system was built to remove. Nil for anybody\n-- who was standing still anyway, and for the very first body of a session.\nfunction Roam.Start(visitor: Visitor, wander: Wander, resume: Vector3?): Roam\n	local rng = wander.rng\n	local stopped = false\n	local paused = false\n	local walking = false\n\n	visitor.setSpeed(TOWN.WalkSpeed)\n\n	local function shouldStop(): boolean\n		return stopped or paused or not enabled or visitor.gone()\n	end\n\n	local function state(): string\n		if stopped then\n			return \"stopped\"\n		end\n		if visitor.gone() then\n			return \"gone\"\n		end\n		if not enabled then\n			return \"off\"\n		end\n		if paused then\n			return \"held\"\n		end\n		return if walking then \"walking\" else \"resting\"\n	end\n\n	task.spawn(function()\n		-- Set only for the first pass, so a resumed walker skips the rest and carries on.\n		-- Every pass after that finds it nil and rests first, which is the ordinary rhythm.\n		local pending = resume\n		while not stopped and not visitor.gone() do\n			if pending == nil then\n				-- Standing about. Sliced rather than waited out in one go so a teardown\n				-- lands within a quarter second instead of within eleven.\n				local rest = rng:NextNumber(TOWN.PauseMinSeconds, TOWN.PauseMaxSeconds)\n				local waited = 0\n				while waited < rest and not stopped and not visitor.gone() do\n					waited += task.wait(REST_SLICE_SECONDS)\n				end\n				if stopped or visitor.gone() then\n					break\n				end\n\n				-- Held, or switched off. The rest simply runs again: somebody who is being\n				-- spoken to should not be counting down to walking away from you, and the\n				-- loop coming back around is what makes resuming cost nothing.\n				if paused or not enabled then\n					continue\n				end\n\n				pending = Roam.NextLeg(wander, visitor.at())\n			end\n\n			-- Taken out of `pending` before the walk rather than after, so a leg that gets\n			-- called off partway is not retried forever: the answer to a failed walk is a\n			-- rest and somewhere else, not the same doorway again.\n			local leg = pending\n			pending = nil\n			if leg == nil then\n				continue\n			end\n\n			walking = true\n			-- The result is deliberately ignored. A walk that was called off, or that\n			-- ran into something, is not a failure worth doing anything about -- the\n			-- answer to both is to stand still for a bit and then try somewhere else,\n			-- which is what the top of this loop already does.\n			visitor.pathTo(leg, shouldStop)\n			walking = false\n		end\n		walking = false\n	end)\n\n	return {\n		pause = function()\n			paused = true\n			visitor.halt()\n		end,\n		resume = function()\n			paused = false\n		end,\n		stop = function()\n			stopped = true\n		end,\n		state = state,\n	}\nend\n\nfunction Roam.SetEnabled(value: boolean)\n	enabled = value\nend\n\nfunction Roam.IsEnabled(): boolean\n	return enabled\nend\n\nreturn Roam\n"
table.insert(AGES_MANIFEST, "src/server/world/Roam.luau")
AGES_SOURCES["src/server/world/Routes.luau"] = "--!strict\n-- The town's roads, as a graph the people can be walked along.\n--\n-- Every node is a tagged part; any two within `RouteLinkStuds` of each other are joined.\n-- That is the whole model, and it is deliberately the cheapest one that could work: the\n-- builder tags corners, benches and the ends of paths in Studio, and the joining is done by\n-- proximity rather than by anybody drawing edges by hand. A graph you have to author is a\n-- graph that is wrong the first time somebody moves a wall.\n--\n-- **Which parts, though — and there are two answers, in order.** `AgesTownPoint` if any\n-- part carries it, and nothing else is even looked at. Otherwise the `AgesPlacePoint` parts\n-- the game already needs for its own reasons: your front gate, the crossing, the school\n-- forecourt, outside the store.\n--\n-- That second tier is not a shortcut, it is the difference between a feature and a feature\n-- with a manual. A world where nobody has done the tagging is the world the game is\n-- actually in, and in that world the place points are already the only surveyed spots on\n-- the map -- somebody put each of them at a specific doorway for a specific reason. Linking\n-- them turns \"wander to probed ground near your own building\" into \"walk between the places\n-- this street is made of\", which is the thing that was asked for, without a Studio step\n-- nobody was told to take. Tag real path corners and this tier vanishes, silently and\n-- completely, which is why it does not need a switch.\n--\n-- **Why a graph at all, when Roam already picked spots.** Roam probes the ground for a\n-- standable point and walks there, which is fine for milling about outside a shop and is\n-- useless for crossing a town: probed points are wherever the floor happens to be, so a\n-- person crossing a street walks through the middle of the road, the flowerbed and the\n-- neighbour's garden with equal enthusiasm. Nodes are on paths because a person put them\n-- there. This is the difference between people wandering near buildings and people using\n-- the streets.\n--\n-- **What happens with nothing tagged: nothing.** Every function here answers \"no route\"\n-- and the caller falls back to the probe it used before, which is exactly the behaviour\n-- the game had. That is the property that makes this worth building rather than raising\n-- a radius -- the feature is turned on by tagging the world, not by a flag, and a world\n-- that has not been tagged yet is not a broken world.\n--\n-- Nothing here knows what a person is. It answers \"given that you are here and belong\n-- over there, where is the next place worth walking to\", and PeopleService decides who is\n-- asking and whether they have a body at the time.\n\nlocal CollectionService = game:GetService(\"CollectionService\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Config = require(ReplicatedStorage:WaitForChild(\"Config\"))\n\nlocal Ground = require(script.Parent.Ground)\n\nlocal TOWN = Config.Town\n\nlocal Routes = {}\n\n-- Positions and the parts they came from, index-aligned. The parts are kept only so a\n-- warning can name the thing the builder has to go and look at -- an island reported as\n-- \"node 14\" is a warning nobody can act on.\nlocal nodes: { Vector3 } = {}\nlocal parts: { BasePart } = {}\nlocal neighbors: { { number } } = {}\n\n-- Which connected component each node is in, and how many there are. Worth computing\n-- because two components is the single most confusing way a tagged world can be wrong:\n-- everybody whose home is in one of them will look like they are refusing to go anywhere\n-- near the other, which reads as a bug in the people rather than a gap in the paths.\nlocal component: { number } = {}\nlocal componentCount = 0\nlocal edgeCount = 0\n\n-- Which tag the current graph came from. Kept because the two tiers fail in different ways\n-- and a harness reading \"12 points, 3 pieces\" cannot tell which it is looking at: three\n-- islands of hand-tagged corners is a builder mistake, and three islands of place points is\n-- just a town whose buildings are further apart than one road.\nlocal sourceTag = \"\"\n\n-- Built on first use and after any tag changes, rather than on a timer. Tagging happens\n-- in Studio, in bursts, and a graph rebuilt per access would be a full O(n^2) pass every\n-- time somebody took a step.\nlocal stale = true\n\nlocal warnedShapes: { [Instance]: boolean } = {}\n\n-- Connected components, by flood fill. Iterative rather than recursive because the town\n-- is one long path more often than it is a blob, and a recursive fill down a hundred-node\n-- corridor is a hundred stack frames for no reason.\nlocal function findComponents()\n	table.clear(component)\n	componentCount = 0\n\n	for index = 1, #nodes do\n		if component[index] ~= nil then\n			continue\n		end\n		componentCount += 1\n		local queue = { index }\n		component[index] = componentCount\n		while #queue > 0 do\n			local at = table.remove(queue) :: number\n			for _, other in neighbors[at] do\n				if component[other] == nil then\n					component[other] = componentCount\n					table.insert(queue, other)\n				end\n			end\n		end\n	end\nend\n\nlocal function build()\n	stale = false\n	table.clear(nodes)\n	table.clear(parts)\n	table.clear(neighbors)\n	edgeCount = 0\n\n	-- The two tiers, and the test is \"is there anything at all\", not \"is there enough\".\n	-- A builder who has tagged three corners so far means those three corners and not a\n	-- mixture of their work and the fallback -- a graph that is half one thing and half\n	-- another is the one outcome nobody could reason about from Studio.\n	sourceTag = Config.World.TownPointTag\n	local tagged = CollectionService:GetTagged(sourceTag)\n	if #tagged == 0 then\n		sourceTag = Config.World.PlacePointTag\n		tagged = CollectionService:GetTagged(sourceTag)\n	end\n\n	for _, instance in tagged do\n		if not instance:IsA(\"BasePart\") then\n			if not warnedShapes[instance] then\n				warnedShapes[instance] = true\n				warn(`[AGES] town point \"{instance:GetFullName()}\" is a {instance.ClassName}, which has no position`)\n			end\n			continue\n		end\n		local part = instance :: BasePart\n		if part.Parent == nil then\n			continue\n		end\n		table.insert(nodes, part.Position)\n		table.insert(parts, part)\n		table.insert(neighbors, {})\n	end\n\n	-- The full pairwise pass. Quadratic, and that is fine at the scale this operates on --\n	-- a hand-tagged town is tens of points, not thousands -- and it runs only when the\n	-- tagging changes. A spatial index here would be a lot of code guarding a loop that\n	-- costs nothing.\n	for a = 1, #nodes do\n		for b = a + 1, #nodes do\n			if Ground.FlatDistance(nodes[a], nodes[b]) <= TOWN.RouteLinkStuds then\n				table.insert(neighbors[a], b)\n				table.insert(neighbors[b], a)\n				edgeCount += 1\n			end\n		end\n	end\n\n	findComponents()\n\n	-- Both of these are build mistakes that produce no error and no visible symptom except\n	-- people not going where the builder expected, so they are said out loud once per build\n	-- rather than left to be discovered by watching the street.\n	--\n	-- Only for hand-tagged points, though. On the place-point tier neither is a mistake: a\n	-- school on the far side of town is further than one road from the crossing because\n	-- that is where the school is, and warning about it would be the game complaining about\n	-- its own map every time the graph was rebuilt. `/town routes` still reports both, which\n	-- is where somebody asking the question would look.\n	if sourceTag ~= Config.World.TownPointTag then\n		return\n	end\n\n	for index, list in neighbors do\n		if #list == 0 then\n			warn(\n				`[AGES] town point \"{parts[index]:GetFullName()}\" has no other point within `\n					.. `{TOWN.RouteLinkStuds} studs, so nobody can walk to or from it`\n			)\n		end\n	end\n	if componentCount > 1 then\n		local sizes: { number } = {}\n		for _, id in component do\n			sizes[id] = (sizes[id] or 0) + 1\n		end\n		local text: { string } = {}\n		for id = 1, componentCount do\n			table.insert(text, tostring(sizes[id] or 0))\n		end\n		warn(\n			`[AGES] the town's paths are in {componentCount} disconnected pieces `\n				.. `({table.concat(text, \" + \")} points). Nobody can walk between them, which looks `\n				.. `like people avoiding half the map. Tag a point in the gap to join them.`\n		)\n	end\nend\n\nlocal function ensure()\n	if stale then\n		build()\n	end\nend\n\n-- Forces a rebuild. For the harness, and for the case the tag signals cannot see: a\n-- builder who dragged a tagged part to a new spot changed the graph without adding or\n-- removing anything, and no signal fires for that.\nfunction Routes.Refresh()\n	stale = true\n	ensure()\nend\n\nfunction Routes.NodeCount(): number\n	ensure()\n	return #nodes\nend\n\n-- The nearest node to `at` that is also close enough to `home` to be allowed. Both halves\n-- matter: the first is what makes a person join the paths near where they already are,\n-- and the second is the leash that stops the whole town converging on one high street.\nlocal function nearestWithin(at: Vector3, home: Vector3): number?\n	local best: number? = nil\n	local bestDistance = math.huge\n	for index, position in nodes do\n		if Ground.FlatDistance(position, home) > TOWN.RangeStuds then\n			continue\n		end\n		local distance = Ground.FlatDistance(position, at)\n		if distance < bestDistance then\n			best = index\n			bestDistance = distance\n		end\n	end\n	return best\nend\n\n-- Where to walk next, as a node index and the position to head for. Nil for both when\n-- there is no graph in reach, which is the caller's signal to fall back to probing the\n-- ground -- not an error, and the normal answer in a world nobody has tagged.\n--\n-- `previous` is where they came from, and it is avoided rather than forbidden. Forbidding\n-- it would strand anybody standing on a dead end, and a person who walks to the end of a\n-- cul-de-sac and then refuses to leave it is a worse artefact than one who occasionally\n-- retraces a step.\nfunction Routes.Step(\n	fromNode: number?,\n	previous: number?,\n	at: Vector3,\n	home: Vector3,\n	rng: Random\n): (number?, Vector3?)\n	ensure()\n	if #nodes == 0 then\n		return nil, nil\n	end\n\n	-- Not on the graph: join it. Walking to the node they joined at is itself a real leg,\n	-- so it is handed back as the goal rather than assumed to have already happened --\n	-- otherwise somebody standing in a garden would teleport onto the pavement.\n	if fromNode == nil or nodes[fromNode] == nil then\n		local entry = nearestWithin(at, home)\n		if entry == nil then\n			return nil, nil\n		end\n		return entry, nodes[entry]\n	end\n\n	local preferred: { number } = {}\n	local backtrack: { number } = {}\n	for _, index in neighbors[fromNode] do\n		if Ground.FlatDistance(nodes[index], home) > TOWN.RangeStuds then\n			continue\n		end\n		if index == previous then\n			table.insert(backtrack, index)\n		else\n			table.insert(preferred, index)\n		end\n	end\n\n	local pool = if #preferred > 0 then preferred else backtrack\n	if #pool == 0 then\n		-- Every neighbour is past the leash, which happens to whoever is standing at the\n		-- far edge of their range. Heading for the node nearest home is the one move that\n		-- is always both legal and progress; picking nothing would leave them stood there\n		-- for the rest of the life.\n		local back = nearestWithin(home, home)\n		if back == nil or back == fromNode then\n			return nil, nil\n		end\n		return back, nodes[back]\n	end\n\n	local pick = pool[rng:NextInteger(1, #pool)]\n	return pick, nodes[pick]\nend\n\n-- The harness line for `/town routes`. Refreshes first, because the question being asked\n-- is almost always \"I have just changed the tagging, did it take\".\nfunction Routes.Describe(): string\n	Routes.Refresh()\n\n	if #nodes == 0 then\n		return `nothing tagged \"{Config.World.TownPointTag}\" or \"{Config.World.PlacePointTag}\" — `\n			.. `townsfolk are wandering to probed ground within {TOWN.RoamStuds} studs of their `\n			.. `own place, which is the fallback, not a fault`\n	end\n\n	local islands: { string } = {}\n	for index, list in neighbors do\n		if #list == 0 then\n			table.insert(islands, parts[index].Name)\n		end\n	end\n\n	-- Which tier first, because it changes what every number after it means. On place\n	-- points, islands and pieces are the shape of the map; on town points they are a\n	-- to-do list.\n	local tier = if sourceTag == Config.World.TownPointTag\n		then `hand-tagged \"{sourceTag}\"`\n		else `falling back to \"{sourceTag}\" (tag \"{Config.World.TownPointTag}\" to override)`\n	local text = `{#nodes} route points, {tier}, {edgeCount} links within `\n		.. `{TOWN.RouteLinkStuds} studs, {componentCount} connected `\n		.. `piece{if componentCount == 1 then \"\" else \"s\"}, leash {TOWN.RangeStuds} studs from home`\n	if #islands > 0 then\n		table.sort(islands)\n		text ..= ` | {#islands} unreachable: {table.concat(islands, \", \")}`\n	end\n	return text\nend\n\n-- Marked stale rather than rebuilt on the spot: tagging a dozen points in Studio would\n-- otherwise rebuild the graph a dozen times, and the next person to ask a question is\n-- going to rebuild it once anyway.\n-- Both tags, because either can change which tier the graph is on: the first town point\n-- ever tagged replaces the whole place-point graph, and a place point added while there are\n-- still no town points is a new node.\nfor _, tag in { Config.World.TownPointTag, Config.World.PlacePointTag } do\n	CollectionService:GetInstanceAddedSignal(tag):Connect(function()\n		stale = true\n	end)\n	CollectionService:GetInstanceRemovedSignal(tag):Connect(function()\n		stale = true\n	end)\nend\n\nreturn Routes\n"
table.insert(AGES_MANIFEST, "src/server/world/Routes.luau")
AGES_SOURCES["src/server/world/School.luau"] = "--!strict\n-- The school, as a building.\n--\n-- What stood here was a sign, a walk-on pad and three rooms hanging in open air around one\n-- point. No walls, no floors, nothing above head height and one storey of nothing. It read\n-- as a menu with a roof on, which is what the owner said about it and which was fair.\n--\n-- This is a school: three storeys, two wings around an atrium cut through all of them, a\n-- glazed front with a canopy and a plaza, an aquatic centre on one side, a gym on the other\n-- and a running track behind. Roughly fifteen hundred parts, laid in about a second.\n--\n-- **Why it is laid in Luau instead of built in Studio or generated into assets/.**\n--\n-- The city and its streets are generated by tools/ into assets/City.rbxmx, which is eleven\n-- megabytes of XML that cannot be hand-merged -- a conflict in it can only be fixed by\n-- regenerating the whole thing -- and it belongs to another agent. Meanwhile Lab, Studio,\n-- Corridor and ReadingRoom were *already* laying school rooms in code around the place\n-- point, and nothing about that touches assets/ or costs anybody a regeneration. So the\n-- building follows them rather than the city: it is code, it is parameterised in\n-- Config.School.Building, and it moves when the map moves because every position in this\n-- file is derived from the centre it is handed.\n--\n-- **There is not one absolute world coordinate in this file, and there must never be one.**\n-- Place-point ids are stable; place-point coordinates are not.\n--\n-- **The building is architecture; the verbs are furniture.** This file lays floors, walls,\n-- glass and lockers and knows nothing about lessons. The lab bench, the easel, the reading\n-- desk and the corridor stations are laid by their own modules, *inside* rooms this one\n-- named -- `School.RoomAt` is the entire join between the two, and it is why adding a\n-- subject does not mean editing the building and moving a wall does not mean editing a\n-- subject.\n--\n-- Local coordinates throughout: x runs across the front, z runs back into the site, y is up\n-- from the place point\\'s own ground level. `at()` is the only place that adds the centre in.\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Config = require(ReplicatedStorage:WaitForChild(\"Config\"))\n\nlocal Kit = require(script.Parent.Kit)\nlocal StandDown = require(script.Parent.StandDown)\n\nlocal School = {}\n\nlocal BUILDING = Config.School.Building\nlocal ENTRANCE = BUILDING.Entrance\nlocal POOL = BUILDING.Pool\nlocal GYM = BUILDING.Gym\nlocal TRACK = BUILDING.Track\nlocal FIT = BUILDING.FitOut\n-- How tall a room door stands.\n--\n-- Twelve. Eight is the textbook number -- an R15 avatar is five studs and builders use seven\n-- to eight for a door -- and it was still wrong here, because those numbers are for a room with\n-- a 10-stud ceiling. In a 27-stud storey an 8-stud door is a hatch: correct against the avatar\n-- and far too small against the wall it is cut into. A door has to be read against the room.\nlocal DOOR_H = 12\nlocal EVENTS = BUILDING.Events\nlocal LOUNGE = BUILDING.Lounge\nlocal VEND = BUILDING.Vending\n\nlocal W = BUILDING.WidthStuds\nlocal D = BUILDING.DepthStuds\n\n-- How far the building sits from its place point. Applied once, in Build's toWorld, so every\n-- room anchor, every prop and the baked asset all move together -- an offset applied in more\n-- than one place is an offset that will disagree with itself.\nlocal OFFSET = Vector3.new(BUILDING.OffsetXStuds, BUILDING.OffsetYStuds, BUILDING.OffsetZStuds)\nlocal FLOOR_H = BUILDING.FloorHeightStuds\nlocal SLAB = BUILDING.SlabThicknessStuds\nlocal WALL_T = BUILDING.WallThicknessStuds\nlocal CORRIDOR_W = BUILDING.CorridorWidthStuds\nlocal BAND_D = BUILDING.BackBandDepthStuds\nlocal LABEL_DIST = BUILDING.LabelMaxDistanceStuds\n\n-- The palette. Inline rather than in Config for the reason Studio gives about its furniture\n-- colours: a colour is not a tunable with a safe range, it is a decision, and a building\n-- whose palette lived in a settings file would be a building nobody could look at and change.\n--\n-- White, cool grey and one blue, which is what the reference is: a modern school reads as\n-- bright and low-contrast, and every accent in it is the same blue doing different jobs.\n-- **Pale lilac-grey, not white.**\n--\n-- The reference's walls are a soft lilac; ours were within thirteen points of pure white on\n-- every channel. Under any exposure at all a near-white wall next to a Neon ceiling has nowhere\n-- left to go and clips to flat white -- which is what \"way too bright\" actually was. It was not\n-- only the lights: it was a surface with no headroom above it.\nlocal WHITE = Color3.fromRGB(224, 222, 234)\nlocal OFF_WHITE = Color3.fromRGB(210, 208, 222)\nlocal TILE = Color3.fromRGB(232, 232, 234)\nlocal CONCRETE = Color3.fromRGB(176, 178, 182)\nlocal BLUE = Color3.fromRGB(58, 122, 206)\nlocal DEEP_BLUE = Color3.fromRGB(36, 84, 158)\nlocal PALE_BLUE = Color3.fromRGB(146, 190, 236)\nlocal GLASS_TINT = Color3.fromRGB(196, 220, 240)\nlocal WOOD = Color3.fromRGB(158, 118, 78)\nlocal DARK = Color3.fromRGB(64, 68, 78)\n\n-- Stair treads, taken off the reference photograph rather than invented: charcoal against a\n-- pale building. The contrast is doing the work, not the shape. The balustrade is posts rather\n-- than glass now -- a curved flight cannot take a flat panel, and a fanned run of posts is what\n-- makes the turn legible from across the lobby.\nlocal STAIR_TREAD = Color3.fromRGB(78, 82, 92)\n\n-- Library timber. The reference shelves are dark walnut, not the mid pine the rest of the\n-- building uses -- a library reads as a library partly because its furniture is heavier than\n-- everything around it.\nlocal WALNUT = Color3.fromRGB(96, 66, 46)\nlocal WATER = Color3.fromRGB(64, 156, 214)\nlocal TRACK_RED = Color3.fromRGB(168, 76, 66)\nlocal GRASS = Color3.fromRGB(102, 148, 84)\n\n-- One named room, in local coordinates. Rectangles rather than polygons because every room\n-- in a school is a rectangle, and the moment one is not, the fit-out loops that walk them\n-- all stop working.\ntype Rect = {\n	id: string,\n	label: string,\n	-- Which storey, 1-based. 1 is the ground floor.\n	floor: number,\n	-- Corners, in local x/z.\n	x1: number,\n	z1: number,\n	x2: number,\n	z2: number,\n	-- What to put in it. \"class\" gets desks, \"common\" gets rugs and planters, \"none\" gets\n	-- lights and a sign and nothing else -- which is right for rooms whose furniture is laid\n	-- by whichever verb owns them.\n	kind: string,\n}\n\nexport type Plan = {\n	center: Vector3,\n	-- The middle of each named room, in world coordinates, at its own floor level. What the\n	-- verb modules position against.\n	rooms: { [string]: Vector3 },\n	-- The front door, the middle of the atrium, and the middle of the track infield -- named\n	-- separately because they are destinations rather than rooms.\n	entrance: Vector3,\n	atrium: Vector3,\n	field: Vector3,\n}\n\nlocal plan: Plan? = nil\nlocal folder: Folder? = nil\n\nlocal function schoolFolder(): Folder\n	local existing = folder\n	if existing ~= nil and existing.Parent ~= nil then\n		return existing\n	end\n	local made = Instance.new(\"Folder\")\n	made.Name = \"SchoolBuilding\"\n	-- Not parented into the world when the building is baked: the parts are only being laid\n	-- to work out where the rooms are, and are destroyed as soon as that is known. A folder\n	-- that reached workspace first would replicate a second school for one frame.\n	if not BUILDING.Baked then\n		made.Parent = workspace\n	end\n	folder = made\n	return made\nend\n\n-- The height of a storey\\'s walking surface. Floor 1 is the ground the place point sits on.\nlocal function floorY(floor: number): number\n	return (floor - 1) * FLOOR_H\nend\n\n-- The plan of the whole school, in local coordinates.\n--\n-- Written out as data rather than laid by hand, because everything downstream -- the walls,\n-- the lights, the signs, the desks and the anchors the verbs hang off -- is a loop over this\n-- list. Moving a room is one line here and the fit-out follows it.\n--\n-- The layout, front to back: the plaza and the doors, then the atrium cut through all three\n-- storeys, then open circulation, then the corridor spine across the building, then a band\n-- of rooms along the back wall. Four rooms per floor, cut out of that band in equal widths.\n--\n-- Two things about it are load bearing rather than arbitrary. The band sits **entirely\n-- behind** the corridor -- an earlier version had the ground floor rooms starting in front\n-- of it, so the cafeteria tables and the corridor lockers occupied the same studs. And the\n-- band is 99 deep because the art room lays its study wall and its paint cupboard 81 apart;\n-- at the 32 it used to be, the cupboard stood outside the building.\n--\n-- The ground floor gives its whole band to the cafeteria and the library, because those are\n-- the two rooms a school actually gathers in. The teaching rooms are upstairs, which is also\n-- what puts a flight of stairs between a player and their lesson.\nlocal function planRooms(): { Rect }\n	local half = W / 2\n	local backZ = D - WALL_T\n	local bandFront = backZ - BAND_D\n	local usable = W - WALL_T * 2\n	local gaps = BUILDING.RoomGapStuds * (BUILDING.RoomsPerFloor - 1)\n	local roomW = (usable - gaps) / BUILDING.RoomsPerFloor\n\n	-- The left edge of the nth slot in the band, 0-based. One expression rather than six\n	-- hand-written pairs of corners, so a change to the room count cannot leave a gap or an\n	-- overlap behind.\n	local function slotX(index: number): (number, number)\n		local x1 = -half + WALL_T + index * (roomW + BUILDING.RoomGapStuds)\n		return x1, x1 + roomW\n	end\n\n	local a1, a2 = slotX(0)\n	local b1, b2 = slotX(1)\n	local c1, c2 = slotX(2)\n	local d1, d2 = slotX(3)\n	local e1, e2 = slotX(4)\n	local f1, f2 = slotX(5)\n\n	-- **Ground floor is where you go; first floor is where you are sent.**\n	--\n	-- That is the whole organising idea, and it is why this is worth writing down rather than\n	-- being an arbitrary list. Everything on the ground is somewhere a player *chooses* to be\n	-- between lessons -- eat, read, sit, cook -- and it is all reachable from the lobby without\n	-- a stair. Everything upstairs is a subject with a timetable slot. A player who has learned\n	-- that never has to think about which floor anything is on again.\n	--\n	-- Only five of these anchors are actually required by code: science, art, reading, music\n	-- and library. The rest exist because a school with five rooms in it is a set.\n	return {\n		-- Ground. The cafeteria and the library take two slots each: one is the room the whole\n		-- school is in at once, the other needs the run for its stacks, and a third of the\n		-- frontage each is what stops them reading as classrooms with odd furniture.\n		{ id = \"cafeteria\", label = \"Cafeteria\", floor = 1, x1 = a1, z1 = bandFront, x2 = b2, z2 = backZ, kind = \"cafeteria\" },\n		{ id = \"library\", label = \"Library\", floor = 1, x1 = c1, z1 = bandFront, x2 = c2, z2 = backZ, kind = \"library\" },\n		{ id = \"computers\", label = \"Computer Lab\", floor = 1, x1 = d1, z1 = bandFront, x2 = d2, z2 = backZ, kind = \"class\" },\n		-- The one room in the building nobody sends you to. Every other space here is somewhere\n		-- you are told to be; this is the one you choose, and it is what makes the school\n		-- somewhere a player hangs around rather than somewhere they visit twice a year.\n		{ id = \"lounge\", label = \"Student Lounge\", floor = 1, x1 = e1, z1 = bandFront, x2 = e2, z2 = backZ, kind = \"lounge\" },\n		{ id = \"cooking\", label = \"Cooking Lab\", floor = 1, x1 = f1, z1 = bandFront, x2 = f2, z2 = backZ, kind = \"cooking\" },\n		-- Computers. This was lost when the third floor went, which was a mistake: the brief was to\n		-- even three floors of rooms into two, not to delete a floor's worth of school. It shares\n		-- the library's two slots rather than taking one of its own -- a computer room and a\n		-- library are the same kind of room to a player, and putting them together is what a real\n		-- school does with its resource centre.\n\n		-- First floor: the subjects. Science, Art and Reading are named here and left empty on\n		-- purpose -- Lab.luau, Studio.luau and ReadingRoom.luau lay their own benches inside\n		-- them, and this file must never learn what a bench is.\n		--\n		-- Art needs depth rather than width: its wall and its paint cupboard sit 81 studs apart,\n		-- which is the number the whole 99-stud band is sized around.\n		{ id = \"science\", label = \"Science Lab\", floor = 2, x1 = a1, z1 = bandFront, x2 = a2, z2 = backZ, kind = \"science\" },\n		{ id = \"art\", label = \"Art Studio\", floor = 2, x1 = b1, z1 = bandFront, x2 = b2, z2 = backZ, kind = \"art\" },\n		{ id = \"reading\", label = \"Reading Room\", floor = 2, x1 = c1, z1 = bandFront, x2 = c2, z2 = backZ, kind = \"reading\" },\n		{ id = \"music\", label = \"Music Room\", floor = 2, x1 = d1, z1 = bandFront, x2 = d2, z2 = backZ, kind = \"class\" },\n		{ id = \"english\", label = \"English\", floor = 2, x1 = e1, z1 = bandFront, x2 = e2, z2 = backZ, kind = \"class\" },\n		{ id = \"staff\", label = \"Staff Room\", floor = 2, x1 = f1, z1 = bandFront, x2 = f2, z2 = backZ, kind = \"common\" },\n	}\nend\n\nlocal ROOMS = planRooms()\n\nlocal function rectCenter(rect: Rect): (number, number)\n	return (rect.x1 + rect.x2) / 2, (rect.z1 + rect.z2) / 2\nend\n\n-- Where the atrium void sits, in local coordinates. Set back from the glass so the front\n-- elevation has two floors of real rooms behind it rather than a hole you can see into from\n-- the road, and centred on x so the entrance walks straight into it.\nlocal ATRIUM_X1 = -BUILDING.AtriumWidthStuds / 2\nlocal ATRIUM_X2 = BUILDING.AtriumWidthStuds / 2\nlocal ATRIUM_Z1 = 8\nlocal ATRIUM_Z2 = 14 + BUILDING.AtriumDepthStuds\n-- Where the *hole* in the upper floor stops, as opposed to where the atrium stops. The strip\n-- between the two is the gallery: real floor on the first floor, across the back of the void,\n-- which is what the stairs arrive on. See Config.School.Building.GalleryDepthStuds.\nlocal VOID_Z2 = ATRIUM_Z2 - BUILDING.GalleryDepthStuds\n\n-- **Where the two stairs stand, and therefore where the holes in the upper floor are.**\n--\n-- These are derived rather than chosen, and it matters that they are, because the openings in\n-- the first floor have to be exactly the flights' footprint -- any smaller and a tread ends up\n-- under the slab with no headroom over it, any larger and the floor is missing for no reason.\n--\n-- A quarter-turn flight sweeps from pointing at its own side wall to pointing at the corridor.\n-- That puts its arc inside a box reaching `radius + width/2` back from the turn centre and the\n-- same distance out to the side, so placing the centre that far in from the atrium wall lands\n-- the flight exactly against it. The two boxes then leave a bridge down the middle of the\n-- atrium, which is the piece of first floor that used to be missing entirely.\nlocal STAIR_R = BUILDING.StairRadiusStuds\nlocal STAIR_W = BUILDING.StairWidthStuds\n-- **How far the flights slide along the corridor, and why it is clamped.**\n--\n-- Asked for as \"shift the stair flight left\". Both flights sit flush to the atrium's outer\n-- edges by construction -- WELL_X_OUT works out to exactly AtriumWidthStuds / 2 -- so there is\n-- no room outboard of either. Sliding the pair left therefore moves the right-hand flight into\n-- open floor and would drive the left-hand one straight through the atrium wall.\n--\n-- So the shift is applied and then clamped per side: a flight moves as far as the atrium\n-- allows and no further. In practice that means the right flight moves the full amount and the\n-- left flight does not move at all, which is the honest result rather than a symmetric fudge.\n-- Raising this past the point where the right flight meets the bridge will start narrowing it.\nlocal STAIR_SHIFT = BUILDING.StairShiftStuds or 0\n\n-- **Out at the atrium walls, now that the flights are straight.**\n--\n-- This reserved a whole stair radius of clearance because the flights used to be arcs that\n-- swept sideways. A straight flight is exactly its own width, so the reservation is dead space\n-- -- and it was dead space in the worst possible place, putting a flight fifteen studs from the\n-- front door in the middle of the view in. Pushed to the walls, the walk in is clear and the\n-- stairs frame it instead of blocking it.\n-- An arc sweeps sideways by its radius, so unlike a straight flight it genuinely does need\n-- that clearance -- this is back to the radius form. What it keeps from the straight version is\n-- the *shift being zero*: the pair is symmetric, and the entrance walk between them is clear.\nlocal STAIR_CX_BASE = BUILDING.AtriumWidthStuds / 2 - STAIR_R - STAIR_W / 2\n\n-- The centre of one flight after the shift, clamped so its outer edge never crosses the atrium.\nlocal function stairCentre(side: number): number\n	local atriumHalf = BUILDING.AtriumWidthStuds / 2\n	local wanted = side * STAIR_CX_BASE + STAIR_SHIFT\n	local halfRun = STAIR_R + STAIR_W / 2\n	return math.clamp(wanted, -atriumHalf + halfRun, atriumHalf - halfRun)\nend\n\nlocal STAIR_CX = STAIR_CX_BASE\n-- **The curved flights are back, and this time the arrival is measured.**\n--\n-- They were replaced with straight runs to match a reference photograph, and the straight ones\n-- are correct about one thing -- open risers and glass read better -- but they cost the thing\n-- that made the curve worth having: a quarter turn shows its whole side from the front door and\n-- points you at the corridor as you step off. Straight, you see the end of a wedge.\n--\n-- The original fault was never the curve. It was that the top tread finished over the void,\n-- because the hole in the upper floor was cut to the full depth of the atrium. The gallery\n-- fixed that -- VOID_Z2 stops the hole short of the back wall -- and the arc's head is pinned\n-- to it, so the last tread now lands on floor rather than air. `stairArrivalGap()` below checks\n-- that every build, because \"it looks like it reaches\" is what let this ship broken twice.\nlocal STAIR_CZ = VOID_Z2 - STAIR_R\nlocal WELL_Z1 = STAIR_CZ - STAIR_W / 2\nlocal WELL_X_OUT = STAIR_CX + STAIR_R + STAIR_W / 2\nlocal WELL_X_IN = STAIR_CX - STAIR_W / 2\n\n-- ---------------------------------------------------------------------------------------\n-- The site: ground, plaza, approach.\n-- ---------------------------------------------------------------------------------------\n\nlocal function buildSite(parent: Instance, at: (number, number, number) -> Vector3)\n	-- **Everything on the approach is placed outboard of the wings.**\n	--\n	-- It used to be placed from PlazaWidthStuds while the wings were placed from the pediment\n	-- and their own width -- two different numbers that were never going to agree. The wings\n	-- reach 74 studs from the centreline and the trees were at 43, the hedges at 53, the\n	-- flagpoles and bins nearer still, so every one of them stood inside a wing. That is the\n	-- clutter at the front of the building: not too much furniture, furniture in the wall.\n	--\n	-- wingOuter is the same expression buildShell lays the wings from, so the two cannot drift\n	-- apart again. Anything that has to stand clear of the building measures from here.\n	local wingOuter = ENTRANCE.PedimentWidthStuds / 2 + ENTRANCE.WingWidthStuds + 4\n\n	local half = W / 2\n	local plazaD = ENTRANCE.PlazaDepthStuds\n\n	-- A hardstanding under the whole campus, a little proud of the terrain so the building\n	-- never sits half-buried when the street it is on is regenerated at a different height.\n	-- Top a hair *below* the anchor rather than a hair above it.\n	--\n	-- Kit.Slab positions by its top surface, so at +0.1 the campus closed over the place point\n	-- standing at the anchor's own height -- the marker was inside the slab, and check_town\n	-- reports that as \"nothing at all under it\". It never showed while the school stood on the\n	-- town's own ground, because that ground was underneath at the right height; moving the\n	-- school onto empty land made this slab the only thing beneath the marker.\n	Kit.Slab(parent, \"Campus\", at(0, -0.05, D / 2 - plazaD / 2), W + POOL.HallWidthStuds * 2 + 40, D + plazaD + 40, 0.6, {\n		color = CONCRETE,\n		material = Enum.Material.Concrete,\n	})\n\n	-- The plaza in front of the doors, in a lighter tone so the approach reads as a route\n	-- rather than as more of the same surface.\n	Kit.Slab(parent, \"Plaza\", at(0, 0.25, -plazaD / 2), ENTRANCE.PlazaWidthStuds, plazaD, 0.4, {\n		color = OFF_WHITE,\n	})\n\n	-- **No terrace, and no steps.** There was a four-stud platform here with a flight up to it\n	-- and cheek walls down the sides, and it was a mistake: it put a step across the single\n	-- route into the building and narrowed what was left of the doorway between two walls. A\n	-- school entrance is somewhere a crowd walks through at once, and anything standing in the\n	-- middle of it is wrong however good it looks from the road.\n	--\n	-- The threshold it was reaching for is a shallow apron instead: one stud, the full width of\n	-- the frontage, nothing to climb and nothing to walk round.\n	Kit.Slab(parent, \"EntranceApron\", at(0, 1.25, -ENTRANCE.ApronDepthStuds / 2), ENTRANCE.PlazaWidthStuds, ENTRANCE.ApronDepthStuds, 1, {\n		color = OFF_WHITE,\n		material = Enum.Material.Concrete,\n	})\n\n\n	-- Bins along the approach, by the benches and the crossing.\n	for index = 1, BUILDING.BinsOutside do\n		local side = if index % 2 == 1 then -1 else 1\n		local row = math.floor((index - 1) / 2)\n		-- Along the edge of the plaza rather than 4 studs inside a wing, and pushed forward so\n		-- the row runs down the approach instead of starting under the building.\n		local x = side * (ENTRANCE.PlazaWidthStuds / 2 + 2)\n		local z = -ENTRANCE.ApronDepthStuds - 8 - row * 18\n		Kit.Block(parent, `OutdoorBin{index}`, at(x, 2.6, z), Vector3.new(4.2, 5, 4.2), {\n			color = Color3.fromRGB(58, 72, 88),\n			material = Enum.Material.Metal,\n			collide = true,\n		})\n		Kit.Block(parent, `OutdoorBinLid{index}`, at(x, 5.3, z), Vector3.new(4.8, 0.6, 4.8), {\n			color = Color3.fromRGB(40, 52, 66),\n			material = Enum.Material.Metal,\n		}).CastShadow = false\n	end\n\n	-- No flagpoles here. The building already raises a pair either side of the doors further\n	-- down this function, and I added a second set without checking first -- two sets on one\n	-- forecourt, the outer pair standing inside a wing.\n\n	-- Black railings along the front boundary, broken either side of the crossing.\n	--\n	-- The reference fences its whole frontage, and that is what makes the forecourt a\n	-- forecourt rather than the building simply stopping where the pavement starts. Broken at\n	-- the middle rather than run straight through, because a fence across your own entrance is\n	-- the one place it must not be.\n	local fenceZ = -plazaD - 4\n	local gap = ENTRANCE.PlazaWidthStuds / 2 + 6\n	for side = -1, 1, 2 do\n		local inner = side * gap\n		local outer = side * (wingOuter + 34)\n		Kit.Block(parent, `FenceRail{side}Top`, at((inner + outer) / 2, ENTRANCE.RailingHeightStuds, fenceZ), Vector3.new(math.abs(outer - inner), 0.5, 0.5), {\n			color = Color3.fromRGB(30, 32, 38),\n			material = Enum.Material.Metal,\n		}).CastShadow = false\n		Kit.Block(parent, `FenceRail{side}Mid`, at((inner + outer) / 2, ENTRANCE.RailingHeightStuds * 0.45, fenceZ), Vector3.new(math.abs(outer - inner), 0.4, 0.4), {\n			color = Color3.fromRGB(30, 32, 38),\n			material = Enum.Material.Metal,\n		}).CastShadow = false\n		local span = math.abs(outer - inner)\n		local posts = math.max(2, math.floor(span / ENTRANCE.RailingSpacingStuds))\n		for index = 0, posts do\n			local x = inner + (outer - inner) * (index / posts)\n			Kit.Block(parent, `FencePost{side}_{index}`, at(x, ENTRANCE.RailingHeightStuds / 2, fenceZ), Vector3.new(0.5, ENTRANCE.RailingHeightStuds, 0.5), {\n				color = Color3.fromRGB(30, 32, 38),\n				material = Enum.Material.Metal,\n			}).CastShadow = false\n		end\n	end\n\n	-- The crossing outside, which is the one piece of the approach that says \"there is a road\n	-- here and children cross it\" without a single sign.\n	for stripe = 1, 7 do\n		local x = -18 + (stripe - 1) * 6\n		Kit.Slab(parent, `Crossing{stripe}`, at(x, 0.3, -plazaD - 10), 3.4, 20, 0.3, { color = WHITE })\n	end\n\n	-- Clipped conical topiary down both sides of the approach, not round park trees. See\n	-- Kit.Topiary: a row of these is what makes the frontage read as landscaping somebody\n	-- maintains, which is the single most recognisable thing about the reference's forecourt.\n	for side = -1, 1, 2 do\n		for index = 1, ENTRANCE.TreesPerSide do\n			local z = -plazaD * (index / (ENTRANCE.TreesPerSide + 1))\n			Kit.Topiary(\n				parent,\n				`ApproachTopiary{side}_{index}`,\n				at(side * (wingOuter + 10), 0.4, z),\n				ENTRANCE.TopiaryHeightStuds,\n				ENTRANCE.TopiaryTiers\n			)\n		end\n		Kit.Block(parent, `ApproachHedge{side}`, at(side * (wingOuter + 22), 3, -plazaD / 2), Vector3.new(10, 6, plazaD), {\n			color = GRASS,\n			material = Enum.Material.Grass,\n		})\n	end\n\n	-- The welcome sign over the doors, and the school\\'s name on the plaza. Two pieces because\n	-- they are read from different distances: the name from the road, the welcome at the door.\n	local nameBoard = Kit.Block(parent, \"NameBoard\", at(0, 0.5, -plazaD + 6), Vector3.new(46, 0.6, 8), { color = OFF_WHITE })\n	Kit.Sign(nameBoard, \"AGES HIGH SCHOOL\", 46, LABEL_DIST * 3, DEEP_BLUE)\n\n	-- Above the door head, not across it. This sat at canopy height minus three, which put a\n	-- 26-stud white board straight over the top third of a 17-stud doorway -- the single thing\n	-- most responsible for the entrance being unreadable from the plaza. A sign belongs on the\n	-- wall above an opening; the moment it overlaps the opening it is not a sign, it is a lintel.\n	local welcome = Kit.Block(parent, \"WelcomeBoard\", at(0, ENTRANCE.DoorHeightStuds + 3.4, -2), Vector3.new(26, 3.2, 0.5), { color = WHITE })\n	Kit.Sign(welcome, \"WELCOME\", 26, LABEL_DIST * 2, BLUE)\nend\n\n-- ---------------------------------------------------------------------------------------\n-- The shell: slabs, walls, glass, columns, roof.\n-- ---------------------------------------------------------------------------------------\n\n-- One storey\\'s floor slab, with the atrium cut out of it as four rectangles around the void.\n--\n-- Four pieces rather than a slab with a hole, because Roblox has no hole: a floor is solid\n-- or it is not there, and the only way to have a void in one is to lay the ring around it.\n-- One storey's floor slab.\n--\n-- **The upper floor is solid except for the two stairwells.** It used to be cut to the whole\n-- footprint of the atrium -- ninety studs by thirty-six of nothing -- on the theory that this\n-- made the lobby a double-height space. What it actually made was a first floor with its\n-- middle missing: you came up a flight and arrived at the edge of a hole, and the fix for that\n-- was a landing slab hanging in mid-air at the head of each stair.\n--\n-- Now the only holes are the flights themselves. The lobby keeps its height as two tall shafts\n-- with a staircase in each, which is a better version of the same idea -- daylight comes down\n-- them, you can see between floors, and the bridge between them is somewhere to stand and look\n-- over. Everything else up there is floor you can walk on.\n--\n-- Five pieces, and the shape is worth reading off the names: a band across the front of the\n-- building, a band across the back, and between them the two outer edges plus the bridge down\n-- the middle. The stairwells are what is left over.\nlocal function buildSlabWithVoid(parent: Instance, at: (number, number, number) -> Vector3, name: string, y: number, cut: boolean)\n	local half = W / 2\n	if not cut then\n		Kit.Slab(parent, name, at(0, y, D / 2), W, D, SLAB, { color = TILE })\n		return\n	end\n\n	-- In front of the stairwells: the whole width of the building, from the front wall to where\n	-- the flights begin. This band did not exist before and is most of what was missing.\n	Kit.Slab(parent, `{name}Front`, at(0, y, WELL_Z1 / 2), W, WELL_Z1, SLAB, { color = TILE })\n	-- Behind them: the gallery and everything back to the rear wall.\n	Kit.Slab(parent, `{name}Back`, at(0, y, (VOID_Z2 + D) / 2), W, D - VOID_Z2, SLAB, { color = TILE })\n\n	-- The band the stairwells are cut out of, in three pieces.\n	local bandZ = (WELL_Z1 + VOID_Z2) / 2\n	local bandD = VOID_Z2 - WELL_Z1\n	-- **Cut from the shifted flight centres, not the nominal ones.**\n	--\n	-- These read WELL_X_OUT and WELL_X_IN directly, which are the *unshifted* constants. The\n	-- railings were moved to follow StairShiftStuds and these were not, so the hole in the floor\n	-- stayed where it was while the stair slid out from under it -- three treads ended up buried\n	-- in the slab they were supposed to come up through. Exactly the bug the shift comment\n	-- warns about, made two functions away from the warning.\n	--\n	-- Both edges and the bridge are derived per side now, so a flight and its hole cannot part\n	-- company again.\n	local leftOuter = stairCentre(-1) - (STAIR_R + STAIR_W / 2)\n	local rightOuter = stairCentre(1) + (STAIR_R + STAIR_W / 2)\n	local leftInner = stairCentre(-1) + STAIR_W / 2\n	local rightInner = stairCentre(1) - STAIR_W / 2\n\n	Kit.Slab(parent, `{name}Left`, at((-half + leftOuter) / 2, y, bandZ), leftOuter + half, bandD, SLAB, { color = TILE })\n	Kit.Slab(parent, `{name}Right`, at((half + rightOuter) / 2, y, bandZ), half - rightOuter, bandD, SLAB, { color = TILE })\n	-- The bridge between the two stairwells, over the middle of the lobby.\n	Kit.Slab(parent, `{name}Bridge`, at((leftInner + rightInner) / 2, y, bandZ), rightInner - leftInner, bandD, SLAB, { color = TILE })\n\n	-- A rail round each stairwell, or the first person to walk the bridge in the dark goes over\n	-- the side. This is the one piece of the building that is safety rather than decoration.\n	for side = -1, 1, 2 do\n		-- The well follows its flight. Cut from the shifted centre rather than the nominal one,\n		-- or the hole in the floor and the stair coming up through it stop agreeing -- which is\n		-- the single most expensive class of bug on this building.\n		local centre = stairCentre(side)\n		local outer = centre + side * (STAIR_R + STAIR_W / 2)\n		local inner = centre - side * (STAIR_W / 2)\n		local tag = if side < 0 then \"L\" else \"R\"\n		-- **No railing on the inner edge.**\n		--\n		-- There used to be one here, running the full depth of the well along the bridge side,\n		-- and it is the thing you meet face-on as you come off the top tread -- a glazed panel\n		-- across the one route off the stair. The other three edges keep theirs.\n		--\n		-- What that costs, stated plainly rather than discovered later: the bridge between the\n		-- two wells is now unguarded on both flanks. A player walking the middle of the first\n		-- floor can step off it. That is a deliberate trade of safety for the stair being usable,\n		-- and if it turns out to matter the fix is a rail set back a few studs from the edge\n		-- rather than on it, not putting this one back.\n		-- The front edge, along the new front band.\n		Kit.Railing(parent, `{name}Well{tag}Front`, at(inner, y, WELL_Z1), at(outer, y, WELL_Z1), 4, PALE_BLUE)\n		-- And the outer edge against the atrium wall. It is a drop like the other two; the only\n		-- side left open is the one the stairs arrive on, which is the point of the whole thing.\n		Kit.Railing(parent, `{name}Well{tag}Outer`, at(outer, y, WELL_Z1), at(outer, y, VOID_Z2), 4, PALE_BLUE)\n	end\nend\n\n\n-- The front of the building: pediment, crest, welcome board, pilasters, hedges and lamps.\n--\n-- Split out of buildShell rather than folded into it, because everything here is *elevation*\n-- rather than structure -- none of it holds a floor up, and all of it exists so the school\n-- reads as a school from the road. buildShell is about where the walls are; this is about\n-- what the walls look like when you arrive.\nlocal function buildFrontage(parent: Instance, at: (number, number, number) -> Vector3)\n	local half = W / 2\n	local roofY = 0.4 + FLOOR_H * BUILDING.Floors\n\n	-- The pediment, stepped rather than a true triangle: Roblox has no wedge in this kit and a\n	-- staircase of five slabs reads as a gable from the ground, which is the only place anyone\n	-- looks at it from.\n	for step = 1, ENTRANCE.PedimentSteps do\n		local share = (step - 1) / ENTRANCE.PedimentSteps\n		local width = ENTRANCE.PedimentWidthStuds * (1 - share)\n		local y = roofY + (ENTRANCE.PedimentRiseStuds / ENTRANCE.PedimentSteps) * (step - 0.5)\n		Kit.Block(parent, `Pediment{step}`, at(0, y, -1.2), Vector3.new(width, ENTRANCE.PedimentRiseStuds / ENTRANCE.PedimentSteps + 0.2, 3), {\n			color = WHITE,\n		})\n	end\n\n	-- The crest. A disc with the school's initials on it, which is the detail the reference\n	-- puts dead centre above the doors and the one that makes the building feel named.\n	local crest = Instance.new(\"Part\")\n	crest.Name = \"Crest\"\n	crest.Shape = Enum.PartType.Cylinder\n	crest.Size = Vector3.new(1.2, ENTRANCE.CrestRadiusStuds * 2, ENTRANCE.CrestRadiusStuds * 2)\n	-- Turned to face the road: a Roblox cylinder runs along X, so it needs a quarter turn about\n	-- Y to present its face forward rather than its edge.\n	crest.CFrame = CFrame.new(at(0, roofY - 6, -2)) * CFrame.Angles(0, math.rad(90), 0)\n	crest.Anchored = true\n	crest.CanCollide = false\n	crest.Color = PALE_BLUE\n	crest.Material = Enum.Material.SmoothPlastic\n	crest.Parent = parent\n\n	local crestFace = Kit.Block(parent, \"CrestFace\", at(0, roofY - 6, -2.7), Vector3.new(ENTRANCE.CrestRadiusStuds * 1.3, ENTRANCE.CrestRadiusStuds * 1.3, 0.3), {\n		color = WHITE,\n	})\n	crestFace.CastShadow = false\n	Kit.Sign(crestFace, \"AGES\\nHIGH\", ENTRANCE.CrestRadiusStuds * 1.2, LABEL_DIST * 2, Color3.fromRGB(46, 96, 168))\n\n	-- The welcome board over the doors.\n	local welcome = Kit.Block(parent, \"WelcomeBoard\", at(0, ENTRANCE.CanopyHeightStuds + 3.5, -1.4), Vector3.new(30, 5, 0.5), {\n		color = PALE_BLUE,\n	})\n	welcome.CastShadow = false\n	Kit.Sign(welcome, \"WELCOME\", 26, LABEL_DIST * 2, Color3.fromRGB(255, 255, 255))\n\n	-- Blue pilasters up the elevation. Full height, so they read as structure rather than as\n	-- paint, and skipped across the entrance bay so they never cross the doors or the crest.\n	for index = 1, ENTRANCE.PilasterCount do\n		local share = (index - 0.5) / ENTRANCE.PilasterCount\n		local x = -half + W * share\n		-- Clear of the pediment, and clear of the wings either side of it. It skipped the first\n		-- and not the second, so four pilasters were striping the front of a wing from inside it.\n		local wingIn = ENTRANCE.PedimentWidthStuds / 2 + 4\n		local wingOut = ENTRANCE.PedimentWidthStuds / 2 + ENTRANCE.WingWidthStuds + 4\n		if math.abs(x) > wingIn and math.abs(x) > wingOut then\n			Kit.Block(parent, `Pilaster{index}`, at(x, roofY / 2, -0.9), Vector3.new(ENTRANCE.PilasterWidthStuds, roofY, 1.6), {\n				color = PALE_BLUE,\n			}).CastShadow = false\n		end\n	end\n\n	-- The wings, brought forward either side of the entrance. Laid before the planting so the\n	-- hedges and cones sit in the courtyard they make rather than in open ground.\n	local wingOffset = ENTRANCE.PedimentWidthStuds / 2 + ENTRANCE.WingWidthStuds / 2 + 4\n	for side = -1, 1, 2 do\n		local wx = side * wingOffset\n		local wz = -ENTRANCE.WingProjectionStuds / 2\n		local wingH = FLOOR_H * 2\n\n		-- The body of the wing, glazed on the front the way the reference's are.\n		Kit.Block(parent, `Wing{side}`, at(wx, wingH / 2, wz), Vector3.new(ENTRANCE.WingWidthStuds, wingH, ENTRANCE.WingDepthStuds), {\n			color = WHITE,\n		})\n		Kit.GlassWall(\n			parent,\n			`WingGlass{side}`,\n			at(wx - ENTRANCE.WingWidthStuds / 2 + 2, 0.4, wz - ENTRANCE.WingDepthStuds / 2 - 0.6),\n			at(wx + ENTRANCE.WingWidthStuds / 2 - 2, 0.4, wz - ENTRANCE.WingDepthStuds / 2 - 0.6),\n			wingH - 2,\n			1,\n			0.7,\n			PALE_BLUE,\n			GLASS_TINT\n		)\n\n		-- The pitched roof, stepped for the reason the pediment is: no wedge in the kit, and a\n		-- staircase of four slabs reads as a pitch from the ground.\n		for step = 1, ENTRANCE.WingRoofSteps do\n			local share = (step - 1) / ENTRANCE.WingRoofSteps\n			local depth = ENTRANCE.WingDepthStuds * (1 - share * 0.82)\n			local y = wingH + (ENTRANCE.WingRoofRiseStuds / ENTRANCE.WingRoofSteps) * (step - 0.5)\n			Kit.Block(parent, `WingRoof{side}_{step}`, at(wx, y, wz), Vector3.new(ENTRANCE.WingWidthStuds + 2 - share * 4, ENTRANCE.WingRoofRiseStuds / ENTRANCE.WingRoofSteps + 0.2, depth), {\n				color = Color3.fromRGB(122, 158, 206),\n			})\n		end\n	end\n\n	-- Tall clipped cones down the forecourt, and the railings along the road. Both are pure\n	-- silhouette and both are what the reference's approach is made of.\n	for side = -1, 1, 2 do\n		for index = 1, ENTRANCE.TopiaryPerSide do\n			local z = -14 - (index / (ENTRANCE.TopiaryPerSide + 1)) * ENTRANCE.PlazaDepthStuds\n			local x = side * (ENTRANCE.PlazaWidthStuds / 2 - 10)\n			for tier = 1, ENTRANCE.TopiaryTiers do\n				local share = (tier - 1) / ENTRANCE.TopiaryTiers\n				local w = 7 * (1 - share * 0.86)\n				local y = 1 + (ENTRANCE.TopiaryHeightStuds / ENTRANCE.TopiaryTiers) * (tier - 0.5)\n				Kit.Block(parent, `Topiary{side}_{index}_{tier}`, at(x, y, z), Vector3.new(w, ENTRANCE.TopiaryHeightStuds / ENTRANCE.TopiaryTiers + 0.2, w), {\n					color = Color3.fromRGB(78, 138, 84),\n					material = Enum.Material.Grass,\n					collide = false,\n				}).CastShadow = false\n			end\n		end\n	end\n\n	-- The railings. A gap is left dead centre for the way in -- a fence with no gate reads as a\n	-- compound, and the entrance is the whole point of this elevation.\n	local railZ = -ENTRANCE.PlazaDepthStuds - 12\n	local railSpan = ENTRANCE.PlazaWidthStuds + ENTRANCE.WingWidthStuds * 2\n	for index = 1, ENTRANCE.RailingPosts do\n		local share = (index - 0.5) / ENTRANCE.RailingPosts\n		local x = -railSpan / 2 + railSpan * share\n		if math.abs(x) > ENTRANCE.GateWidthStuds / 2 then\n			Kit.Column(parent, `Railing{index}`, at(x, 0.4, railZ), 7, 0.5, Color3.fromRGB(38, 40, 48))\n		end\n	end\n	for side = -1, 1, 2 do\n		-- The two gate piers, taller than the run so the opening reads as deliberate.\n		Kit.Column(parent, `GatePier{side}`, at(side * ENTRANCE.GateWidthStuds / 2, 0.4, railZ), 10, 2, WHITE)\n	end\n\n	-- Flagpoles either side of the doors.\n	for side = -1, 1, 2 do\n		for index = 1, ENTRANCE.FlagpolesPerSide do\n			-- Outboard of the wings. At pediment/2 + 8 these stood inside one.\n			local x = side * (ENTRANCE.PedimentWidthStuds / 2 + ENTRANCE.WingWidthStuds + 10 + index * 6)\n			Kit.Column(parent, `Flagpole{side}_{index}`, at(x, 0.4, -10), ENTRANCE.FlagpoleHeightStuds, 0.7, WHITE)\n			Kit.Block(parent, `Flag{side}_{index}`, at(x + side * 3.4, ENTRANCE.FlagpoleHeightStuds - 3, -10), Vector3.new(6.4, 4, 0.2), {\n				color = PALE_BLUE,\n			}).CastShadow = false\n		end\n	end\n\n	-- Clipped hedges and lamp standards down the approach. The reference lines its forecourt\n	-- with both, and a bare slab of concrete in front of a school is the one thing that makes\n	-- an otherwise finished building look unfinished.\n	local plazaD = ENTRANCE.PlazaDepthStuds\n	for side = -1, 1, 2 do\n		for index = 1, ENTRANCE.HedgesPerSide do\n			local z = -6 - (index / (ENTRANCE.HedgesPerSide + 1)) * plazaD\n			Kit.Block(parent, `Hedge{side}_{index}`, at(side * (ENTRANCE.PedimentWidthStuds / 2 + ENTRANCE.WingWidthStuds + 14), 2.4, z), Vector3.new(9, 4.4, 9), {\n				color = Color3.fromRGB(96, 150, 96),\n				material = Enum.Material.Grass,\n			})\n		end\n		for index = 1, ENTRANCE.LampsPerSide do\n			local z = -10 - (index / (ENTRANCE.LampsPerSide + 1)) * plazaD\n			local x = side * (ENTRANCE.PlazaWidthStuds / 2 - 3)\n			Kit.Column(parent, `LampPost{side}_{index}`, at(x, 0.4, z), 16, 1, CONCRETE)\n			Kit.Block(parent, `LampHead{side}_{index}`, at(x, 16.6, z), Vector3.new(3.4, 1.2, 3.4), {\n				color = Color3.fromRGB(255, 246, 214),\n				material = Enum.Material.Neon,\n			}).CastShadow = false\n		end\n	end\nend\n\nlocal function buildShell(parent: Instance, at: (number, number, number) -> Vector3)\n	local half = W / 2\n\n	for floor = 1, BUILDING.Floors do\n		local y = floorY(floor)\n		-- The ground floor is solid; the ones above it are cut, which is what makes the atrium\n		-- a three-storey space rather than a tall ground-floor room.\n		buildSlabWithVoid(parent, at, `Floor{floor}`, y, floor > 1)\n\n		-- The front elevation is glass, because that is what the reference is and because it is\n		-- what lets the building be read from the road at all.\n		--\n		-- **It no longer follows the slabs.** The glazing is laid in ExteriorBands rows over the\n		-- whole wall rather than one row per floor, so the street sees three storeys while the\n		-- inside has two. An elevation is a pattern of windows and floor bands; nothing requires\n		-- it to agree with where the slabs are, and double-height rooms behind a three-band\n		-- facade is a thing real buildings do.\n		--\n		-- Laid on the first pass only, since it spans the whole height rather than one storey.\n		if floor == 1 then\n			local wallTop = FLOOR_H * BUILDING.Floors\n			local bandH = wallTop / BUILDING.ExteriorBands\n			for band = 1, BUILDING.ExteriorBands do\n				local bandY = (band - 1) * bandH\n				-- The glazing stops short of the spandrel rather than running up behind it. A\n				-- glass wall draws its own head band at the top, and that head was landing inside\n				-- the concrete spandrel -- two solid parts in the same 3 studs of wall.\n				Kit.GlassWall(parent, `FrontGlass{band}`, at(-half, bandY, 0), at(half, bandY, 0), bandH - 4.2, WALL_T, BUILDING.GlassShare, WHITE, GLASS_TINT)\n				-- The floor band on the face, and a spandrel behind it. Three of these is what\n				-- makes the building read as three storeys.\n				Kit.Block(parent, `Spandrel{band}`, at(0, bandY + bandH - 2, -0.5), Vector3.new(W, 3, 1.4), {\n					color = OFF_WHITE,\n					material = Enum.Material.Concrete,\n				})\n				Kit.Block(parent, `Band{band}`, at(0, bandY + bandH - 0.6, -0.4), Vector3.new(W, 1.4, 1.2), { color = BLUE })\n			end\n		end\n\n		-- The back and the two ends are solid, with a blue band at each floor line -- one\n		-- accent doing the job of saying where the storeys are from outside.\n		-- The three solid elevations, in render rather than flat plastic.\n		--\n		-- The research is blunt about this: one material everywhere reads as a greybox however\n		-- good the geometry is, and material variety carries more than colour variety does. These\n		-- were SmoothPlastic white -- the default -- which is why the building looked unfinished\n		-- in every screenshot regardless of what was added to it.\n		Kit.Wall(parent, `BackWall{floor}`, at(-half, y, D), at(half, y, D), FLOOR_H - SLAB, WALL_T, {\n			color = WHITE,\n			material = Enum.Material.Concrete,\n		})\n		Kit.Wall(parent, `LeftWall{floor}`, at(-half, y, 0), at(-half, y, D), FLOOR_H - SLAB, WALL_T, {\n			color = WHITE,\n			material = Enum.Material.Concrete,\n		})\n		Kit.Wall(parent, `RightWall{floor}`, at(half, y, 0), at(half, y, D), FLOOR_H - SLAB, WALL_T, {\n			color = WHITE,\n			material = Enum.Material.Concrete,\n		})\n\n\n		-- Columns down the front, on the grid the canopy sits on.\n		for index = 1, ENTRANCE.ColumnCount do\n			local share = (index - 0.5) / ENTRANCE.ColumnCount\n			local x = -half + W * share\n			-- Not where a wing already stands. These ran the full width of the elevation and the\n			-- wings were added later in front of them, so four columns were buried in solid\n			-- masonry -- invisible from outside and standing in the way inside.\n			if math.abs(x) > ENTRANCE.PedimentWidthStuds / 2 + ENTRANCE.WingWidthStuds + 4 or math.abs(x) < ENTRANCE.PedimentWidthStuds / 2 then\n				Kit.Column(parent, `Column{floor}_{index}`, at(x, y, 3), FLOOR_H - SLAB, 3.4, CONCRETE)\n			end\n		end\n	end\n\n	-- The roof, and a glazed lantern over the atrium so the three-storey space is daylit from\n	-- above rather than being a dark shaft.\n	local roofY = floorY(BUILDING.Floors + 1)\n	Kit.Slab(parent, \"RoofFront\", at(0, roofY, ATRIUM_Z1 / 2), W, ATRIUM_Z1, SLAB * 2, { color = OFF_WHITE })\n	Kit.Slab(parent, \"RoofBack\", at(0, roofY, (ATRIUM_Z2 + D) / 2), W, D - ATRIUM_Z2, SLAB * 2, { color = OFF_WHITE })\n	local sideW = half + ATRIUM_X1\n	Kit.Slab(parent, \"RoofLeft\", at((-half + ATRIUM_X1) / 2, roofY, (ATRIUM_Z1 + ATRIUM_Z2) / 2), sideW, ATRIUM_Z2 - ATRIUM_Z1, SLAB * 2, { color = OFF_WHITE })\n	Kit.Slab(parent, \"RoofRight\", at((half + ATRIUM_X2) / 2, roofY, (ATRIUM_Z1 + ATRIUM_Z2) / 2), sideW, ATRIUM_Z2 - ATRIUM_Z1, SLAB * 2, { color = OFF_WHITE })\n\n	-- The crown: a cornice at the roofline and a parapet standing above it.\n	--\n	-- Laid as four runs round the perimeter rather than as one box, because the front of the\n	-- building is glass and a parapet that crossed the glazing head would read as a beam\n	-- floating in front of the windows.\n	local proud = BUILDING.CorniceProudStuds\n	local corniceRuns = {\n		{ name = \"CorniceFront\", a = at(-half - proud, roofY, -proud), b = at(half + proud, roofY, -proud) },\n		{ name = \"CorniceBack\", a = at(-half - proud, roofY, D + proud), b = at(half + proud, roofY, D + proud) },\n		{ name = \"CorniceLeft\", a = at(-half - proud, roofY, -proud), b = at(-half - proud, roofY, D + proud) },\n		{ name = \"CorniceRight\", a = at(half + proud, roofY, -proud), b = at(half + proud, roofY, D + proud) },\n	}\n	for _, run in corniceRuns do\n		-- The cornice oversails, so it throws a shadow line along the top of the wall. That\n		-- shadow is the whole point: it is what separates the building from the sky.\n		local band = Kit.Wall(parent, run.name, run.a, run.b, 2.2, WALL_T + proud * 2, { color = OFF_WHITE })\n		if band ~= nil then\n			band.CastShadow = false\n		end\n		-- And the parapet above it, set back to the wall line.\n		Kit.Wall(\n			parent,\n			run.name:gsub(\"Cornice\", \"Parapet\"),\n			run.a + Vector3.new(0, 2.2, 0),\n			run.b + Vector3.new(0, 2.2, 0),\n			BUILDING.ParapetHeightStuds,\n			WALL_T,\n			{ color = WHITE }\n		)\n	end\n\n	-- A blue coping capping the parapet, which is the school's own accent finishing the\n	-- building rather than an extra colour introduced at the top.\n	for _, run in corniceRuns do\n		local cap = Kit.Wall(\n			parent,\n			run.name:gsub(\"Cornice\", \"Coping\"),\n			run.a + Vector3.new(0, 2.2 + BUILDING.ParapetHeightStuds, 0),\n			run.b + Vector3.new(0, 2.2 + BUILDING.ParapetHeightStuds, 0),\n			0.9,\n			WALL_T + 1.2,\n			{ color = BLUE }\n		)\n		if cap ~= nil then\n			cap.CastShadow = false\n		end\n	end\n\n	-- The base course. A wall that meets the ground with nothing at the bottom looks dropped\n	-- rather than built, and this is four parts.\n	local doorGap = ENTRANCE.DoorWidthStuds / 2 + 4\n	local plinthRuns = {\n		-- **Broken at the doorway.** The base course ran unbroken across the front, which put a\n		-- 4-stud kerb 1.2 studs outside the doors: a step up at the exact spot the building\n		-- wants you to walk through. A plinth is meant to look like the wall is founded on\n		-- something, not to be a threshold you climb, so the opening gets a gap.\n		{ name = \"PlinthFrontL\", a = at(-half, 0.3, -BUILDING.PlinthProudStuds), b = at(-doorGap, 0.3, -BUILDING.PlinthProudStuds) },\n		{ name = \"PlinthFrontR\", a = at(doorGap, 0.3, -BUILDING.PlinthProudStuds), b = at(half, 0.3, -BUILDING.PlinthProudStuds) },\n		{ name = \"PlinthBack\", a = at(-half, 0.3, D + BUILDING.PlinthProudStuds), b = at(half, 0.3, D + BUILDING.PlinthProudStuds) },\n		{ name = \"PlinthLeft\", a = at(-half - BUILDING.PlinthProudStuds, 0.3, 0), b = at(-half - BUILDING.PlinthProudStuds, 0.3, D) },\n		{ name = \"PlinthRight\", a = at(half + BUILDING.PlinthProudStuds, 0.3, 0), b = at(half + BUILDING.PlinthProudStuds, 0.3, D) },\n	}\n	for _, run in plinthRuns do\n		Kit.Wall(parent, run.name, run.a, run.b, BUILDING.PlinthHeightStuds, WALL_T + BUILDING.PlinthProudStuds, {\n			color = CONCRETE,\n			material = Enum.Material.Concrete,\n		})\n	end\n\n	local lantern = Kit.Slab(parent, \"Lantern\", at(0, roofY, (ATRIUM_Z1 + ATRIUM_Z2) / 2), BUILDING.AtriumWidthStuds, BUILDING.AtriumDepthStuds, 0.5, {\n		color = GLASS_TINT,\n		material = Enum.Material.Glass,\n		transparency = 0.6,\n		collide = true,\n	})\n	lantern.CastShadow = false\n\n	-- The entrance canopy, and the doors under it.\n	-- The canopy clears the door head rather than cutting across it. Its soffit was at 15.5\n	-- against a 17-stud door, so from the plaza the roof crossed the top of the opening and the\n	-- way in read as a dark slot under a shelf. A canopy has to be higher than the thing it\n	-- shelters or it hides it.\n	Kit.Slab(parent, \"Canopy\", at(0, ENTRANCE.CanopyHeightStuds, -ENTRANCE.CanopyDepthStuds / 2), ENTRANCE.PlazaWidthStuds, ENTRANCE.CanopyDepthStuds, 1.4, {\n		color = WHITE,\n	})\n	-- **The columns stand clear of the doorway.**\n	--\n	-- They were spaced -21, -7, +7, +21 across a door that runs -10 to +10, so the two inner\n	-- ones stood directly in front of it -- a pair of posts planted across the way in, which is\n	-- what made the entrance unreadable from the plaza however big the doors got.\n	--\n	-- A canopy's columns belong at its ends. Splitting them either side of the opening leaves\n	-- the middle clear, which is the whole job of an entrance: you should be able to see the\n	-- door from the road and walk at it in a straight line.\n	-- The gap they have to live in is narrow and both walls of it are hard: the door runs to\n	-- +/-10 and the entrance wings start at +/-26, so a column belongs between about 12 and 24.\n	-- Spread wider than that and it stands inside the wing.\n	-- One each side, and one is all that fits. The door is DoorWidthStuds wide -- 40, so it runs\n	-- to +/-20 -- and the entrance wings begin at +/-26. That leaves a six-stud slot on each\n	-- flank and nothing anywhere else, which is why four columns could not be arranged without\n	-- either standing in the doorway or standing inside a wing. Two columns, hard against the\n	-- wings, and the whole opening between them is clear.\n	local clear = ENTRANCE.DoorWidthStuds / 2 + 3\n	for index = 1, 2 do\n		local x = (if index == 1 then -1 else 1) * clear\n		Kit.Column(parent, `CanopyColumn{index}`, at(x, 0.4, -ENTRANCE.CanopyDepthStuds + 2), ENTRANCE.CanopyHeightStuds, 2.2, WHITE)\n	end\n	-- One wide opening with two leaves in it, rather than the four separate panels that used\n	-- to be here. Four panels with gaps between them read from the plaza as a row of windows,\n	-- and the way in is the one thing an entrance elevation has to say clearly.\n	--\n	-- The leaves are named EntranceDoorLeaf so FixtureService can find them: they are the only\n	-- moving part of the building, and pressing E on them swings them open.\n	local doorW = ENTRANCE.DoorWidthStuds\n	local doorH = ENTRANCE.DoorHeightStuds\n\n	-- The frame: jambs and a head, in the school's blue so the opening is legible from the road.\n	for side = -1, 1, 2 do\n		Kit.Block(parent, `DoorJamb{side}`, at(side * (doorW / 2 + 1.2), doorH / 2, 0), Vector3.new(2.4, doorH + 2, 2.4), {\n			color = BLUE,\n		})\n	end\n	Kit.Block(parent, \"DoorHead\", at(0, doorH + 1.2, 0), Vector3.new(doorW + 7, 2.4, 2.4), { color = BLUE })\n\n	-- The two leaves. Non-collidable, because a door you have to open before you can walk\n	-- through is a door that will strand somebody the first time the prompt is out of reach --\n	-- the swing is a flourish, not a gate.\n	for side = -1, 1, 2 do\n		-- **Wood, and solid.** These were tinted glass, which at this size read as two more\n		-- panes in a fully glazed elevation -- you could not tell where the way in was. A timber\n		-- door in a glass wall is the oldest trick there is for making an entrance legible, and\n		-- it is the one thing on this facade that should not look like the rest of it.\n		--\n		-- Collidable, because a door that opens has to have been shut.\n		Kit.Block(parent, `EntranceDoorLeaf{side}`, at(side * doorW / 4, doorH / 2, 0), Vector3.new(doorW / 2 - 0.4, doorH, 0.7), {\n			color = WALNUT,\n			material = Enum.Material.WoodPlanks,\n			collide = true,\n		})\n		-- Rails and stiles, so the leaf reads as a made door rather than a plank.\n		for panel = 1, 2 do\n			Kit.Block(parent, `EntranceDoorPanel{side}_{panel}`, at(side * doorW / 4, doorH * (if panel == 1 then 0.28 else 0.68), -0.45), Vector3.new(doorW / 2 - 4.5, doorH * 0.3, 0.25), {\n				color = Color3.fromRGB(78, 54, 38),\n				material = Enum.Material.Wood,\n			}).CastShadow = false\n		end\n		-- A glazed light at head height: a solid door with no window is a door you walk into\n		-- somebody through.\n		Kit.Block(parent, `EntranceDoorLight{side}`, at(side * doorW / 4, doorH * 0.86, 0), Vector3.new(doorW / 2 - 5, doorH * 0.16, 0.3), {\n			color = GLASS_TINT,\n			material = Enum.Material.Glass,\n			transparency = 0.4,\n		}).CastShadow = false\n		-- A push bar, which is what makes a glass panel read as a door rather than as a window.\n		Kit.Block(parent, `DoorBar{side}`, at(side * doorW / 4, doorH * 0.45, -0.5), Vector3.new(doorW / 2 - 4, 0.6, 0.6), {\n			color = Color3.fromRGB(206, 212, 222),\n			material = Enum.Material.Metal,\n		}).CastShadow = false\n	end\nend\n\n-- ---------------------------------------------------------------------------------------\n-- The lobby: what is in the atrium.\n-- ---------------------------------------------------------------------------------------\n\n-- The atrium was circulation and nothing else -- three storeys of air, a stair at each end, a\n-- rail round the hole and not one object in it. It is the first room anybody walks into and it\n-- was the emptiest space in the building.\n--\n-- The banners do the load-bearing work. The atrium's whole reason for existing is that it is\n-- three storeys tall, and *nothing in it used that height* -- so the space read as a tall room\n-- rather than as a volume. A banner hanging the full drop is the cheapest thing that makes the\n-- height legible: you read the building's scale off the banner, because you are not looking at\n-- the ceiling.\nlocal function buildLobby(parent: Instance, at: (number, number, number) -> Vector3)\n	local cz = (ATRIUM_Z1 + ATRIUM_Z2) / 2\n	local roofY = floorY(BUILDING.Floors + 1)\n\n	-- A feature wall behind the reception, full height of the two-storey lobby.\n	--\n	-- The back of the lobby was blank above head height, which in a room now 54 studs tall is a\n	-- lot of nothing directly in front of anyone walking in. The reference puts the school crest\n	-- on exactly that wall.\n	-- The feature wall is now behind the gallery rather than facing a full-height void, so it\n	-- is a one-storey wall. Left at two storeys it would have run straight through the gallery\n	-- slab -- the same mistake as the lockers in the logo, one floor up.\n	-- **The lobby ceiling, lit.**\n	--\n	-- The corridor got a panel grid and the lobby did not, which is why the room you walk into is\n	-- the darkest in the building -- the one place a first impression is actually made. A void\n	-- this size cannot be lit from its edges: the light has to be over the floor you are standing\n	-- on.\n	--\n	-- Hung under the gallery soffit, so they light the ground floor without floating in the void.\n	for col = 1, 5 do\n		for row = 1, 3 do\n			local lx = ATRIUM_X1 + (ATRIUM_X2 - ATRIUM_X1) * ((col - 0.5) / 5)\n			local lz = ATRIUM_Z1 + (VOID_Z2 - ATRIUM_Z1) * ((row - 0.5) / 3)\n			Kit.Block(parent, `LobbyPanel{col}_{row}`, at(lx, FLOOR_H - 3, lz), Vector3.new(11, 0.4, 5), {\n				color = Color3.fromRGB(255, 253, 246),\n				material = Enum.Material.Neon,\n			}).CastShadow = false\n		end\n	end\n\n	local featureZ = ATRIUM_Z2 - 1.2\n	local featureH = FLOOR_H - 2\n	-- **Lockers flanking a signed opening, not a target on a blank wall.**\n	--\n	-- The reference's lobby ends in a wide opening with the room's name over it in letters you\n	-- can read from the door, and banks of lockers either side of it. Ours ended in a concrete\n	-- panel with a three-ring crest on it, which from the entrance reads as a target and tells\n	-- you nothing about where to go.\n	--\n	-- The opening is what does the work: a room you can see into from the front door is a room\n	-- you walk toward. The crest was decoration on a dead end.\n	local atriumW = ATRIUM_X2 - ATRIUM_X1\n	local openingW = atriumW * 0.34\n	local pierW = (atriumW * 0.5 - openingW) / 2\n\n	for side = -1, 1, 2 do\n		local px = side * (openingW / 2 + pierW / 2)\n		-- The pier itself.\n		Kit.Block(parent, `LobbyPier{side}`, at(px, featureH / 2, featureZ), Vector3.new(pierW, featureH, 0.6), {\n			color = Color3.fromRGB(214, 218, 228),\n			material = Enum.Material.Concrete,\n		})\n		-- Lockers against it, in the reference's grey rather than the school's blue: the blue is\n		-- already doing the floor bands and the signage, and a third blue object here would flatten\n		-- the whole wall into one colour.\n		local bankW = pierW - 6\n		local doors = math.max(3, math.floor(bankW / 4.5))\n		local doorW = bankW / doors\n		Kit.Block(parent, `LobbyLockerBank{side}`, at(px, 6.5, featureZ - 1.6), Vector3.new(bankW, 11, 2.4), {\n			color = Color3.fromRGB(176, 182, 192),\n			material = Enum.Material.Metal,\n			collide = true,\n		})\n		Kit.Block(parent, `LobbyLockerCap{side}`, at(px, 12.2, featureZ - 1.6), Vector3.new(bankW, 0.6, 2.8), {\n			color = Color3.fromRGB(140, 146, 158),\n			material = Enum.Material.Metal,\n		}).CastShadow = false\n		for index = 1, doors - 1 do\n			Kit.Block(parent, `LobbyLockerSeam{side}_{index}`, at(px - bankW / 2 + doorW * index, 6.5, featureZ - 2.9), Vector3.new(0.25, 10.4, 0.3), {\n				color = Color3.fromRGB(140, 146, 158),\n			}).CastShadow = false\n		end\n		for index = 1, doors do\n			Kit.Block(parent, `LobbyLockerHandle{side}_{index}`, at(px - bankW / 2 + doorW * (index - 0.5) + doorW * 0.28, 6.5, featureZ - 3), Vector3.new(0.4, 1.6, 0.3), {\n				color = Color3.fromRGB(232, 236, 244),\n				material = Enum.Material.Metal,\n			}).CastShadow = false\n		end\n	end\n\n	-- The head over the opening, and the sign on it. Big, because the reference's is big and\n	-- that is the entire point -- it is legible from the front door, which is where you need it.\n	Kit.Block(parent, \"LobbyOpeningHead\", at(0, featureH - 4, featureZ), Vector3.new(openingW + 4, 8, 0.6), {\n		color = Color3.fromRGB(214, 218, 228),\n		material = Enum.Material.Concrete,\n	})\n	Kit.Block(parent, \"LobbySignBand\", at(0, featureH - 4, featureZ - 0.5), Vector3.new(openingW, 6, 0.4), {\n		color = BLUE,\n	}).CastShadow = false\n	local signBoard = Kit.Block(parent, \"LobbySign\", at(0, featureH - 4, featureZ - 0.8), Vector3.new(openingW - 3, 4.4, 0.3), {\n		color = WHITE,\n	})\n	signBoard.CastShadow = false\n	Kit.Sign(signBoard, \"CAFETERIA\", openingW - 3, LABEL_DIST * 2, Color3.fromRGB(96, 102, 114))\n\n	-- **The gallery fascia, and the fins that carry the height.**\n	--\n	-- Two things a 54-stud atrium needs that a 27-stud one does not.\n	--\n	-- The fascia first: standing in the lobby you look up at the cut edge of the upper floor\n	-- slab, and a raw slab edge reads as a hole in the floor rather than as a balcony. A band\n	-- on that edge, in the school's blue, is what turns the void into a gallery -- and it is\n	-- the line that tells you from the ground floor that there is a floor above you.\n	-- **It traces the two stairwells, and it does not cross the head of a flight.**\n	--\n	-- This used to trace the old full-width void as a single rectangle: Front, Back, Left,\n	-- Right. When the first floor was filled in and the openings became the two stairwells, the\n	-- rectangle stopped describing anything real -- and its Back band, 92 studs wide at\n	-- z = VOID_Z2, ran straight across the point where *both* staircases arrive. A 2.8-stud lip\n	-- at the top of a flight is a thing you walk into at head height on your way out of it.\n	--\n	-- So: three edges per well, not four. Inner (along the bridge), Front, and Outer against the\n	-- atrium wall -- each of those is a genuine cut edge of the slab and wants trimming. The\n	-- fourth side is where you step off the stairs and gets nothing at all, which is the same\n	-- rule the study counter above already follows.\n	local edges = {}\n	for side = -1, 1, 2 do\n		local tag = if side < 0 then \"L\" else \"R\"\n		local inner = side * WELL_X_IN\n		local outer = side * WELL_X_OUT\n		local midZ = (WELL_Z1 + VOID_Z2) / 2\n		local depth = VOID_Z2 - WELL_Z1\n		table.insert(edges, { n = `{tag}Inner`, cx = inner, cz = midZ, sx = 1.4, sz = depth })\n		table.insert(edges, { n = `{tag}Outer`, cx = outer, cz = midZ, sx = 1.4, sz = depth })\n		table.insert(edges, { n = `{tag}Front`, cx = (inner + outer) / 2, cz = WELL_Z1, sx = math.abs(outer - inner) + 1.4, sz = 1.4 })\n	end\n	for _, edge in edges do\n		local slabY = floorY(2)\n		Kit.Block(parent, `GalleryFascia{edge.n}`, at(edge.cx, slabY - 1.4, edge.cz), Vector3.new(edge.sx, 2.8, edge.sz), {\n			color = DEEP_BLUE,\n		}).CastShadow = false\n		Kit.Block(parent, `GallerySoffit{edge.n}`, at(edge.cx, slabY - 3, edge.cz), Vector3.new(edge.sx - 0.6, 0.6, edge.sz - 0.6), {\n			color = OFF_WHITE,\n		}).CastShadow = false\n	end\n\n	-- The fins that used to run down both flanks of the void are gone. They were added to give\n	-- a 54-stud wall a countable rhythm, and in a space this size they read as a row of pillars\n	-- standing in the middle of the room for no reason -- which is what they were. The gallery\n	-- fascia and the glazing already give the atrium its horizontal lines; it did not need\n	-- vertical ones as well.\n\n	-- **A plain landing platform at the head of each flight.**\n	--\n	-- There was a study counter along this gallery -- desk, fascia, stools and lamps -- on the\n	-- reasoning that a balcony over an atrium is the best seat in a school. The reasoning was\n	-- fine and the arithmetic was not. It was set to start 26 studs off the centreline to keep\n	-- clear of the stairs, but a flight's top tread reaches 29 studs out (STAIR_CX plus half the\n	-- stair width), so the counter overlapped **both** stair arrivals by 3.6 studs. A counter\n	-- across the head of a flight is the same mistake as a column across a door, which is exactly\n	-- what the comment here used to claim it was avoiding.\n	--\n	-- What goes there instead is nothing but floor: a plain platform spanning each stairwell's\n	-- width, flush with the gallery, so you come up the stairs and step onto a clear landing.\n	-- Somewhere to arrive is worth more than somewhere to sit, and this is the one spot in the\n	-- building where the two cannot both fit.\n	local galleryY = floorY(2)\n	for side = -1, 1, 2 do\n		local tag = if side < 0 then \"L\" else \"R\"\n		local platformW = STAIR_W + 8\n		local platformD = BUILDING.GalleryDepthStuds - 2\n		Kit.Slab(\n			parent,\n			`StairLanding{tag}`,\n			at(side * STAIR_CX, galleryY, VOID_Z2 + platformD / 2),\n			platformW,\n			platformD,\n			SLAB,\n			{ color = TILE }\n		)\n		-- A nosing strip along the edge the stairs meet, so the join reads as a threshold rather\n		-- than as two slabs that happen to touch.\n		Kit.Block(parent, `StairLanding{tag}Nosing`, at(side * STAIR_CX, galleryY + 0.4, VOID_Z2 + 0.3), Vector3.new(platformW, 0.25, 0.8), {\n			color = Color3.fromRGB(214, 218, 226),\n		}).CastShadow = false\n	end\n\n	-- **The lobby's back corners.**\n	--\n	-- The middle of the lobby is the route from the doors to the stairs and stays clear, but the\n	-- two back corners either side of that route were bare floor. A school entrance hall uses\n	-- those for waiting -- somebody is always waiting outside the office -- so they get a bench,\n	-- a planter and a case of whatever the school is proud of this year.\n	for side = -1, 1, 2 do\n		-- Pulled in against the bridge rather than out at the atrium's edge.\n		--\n		-- These corners sat under what is now a stairwell -- a planter, a shrub and a bench leg\n		-- were standing inside the footprint of each flight, at the bottom where you start\n		-- climbing. Moving them inboard puts them under the bridge instead, which is a\n		-- sheltered spot to wait and is not in anybody's way.\n		-- **Against the side wall, at the back.**\n		--\n		-- These sat under the bridge in the middle of the lobby, which is the one part of the\n		-- floor that has to stay empty: it is the whole view from the front door and the route to\n		-- everything else. A bench in the centre of an entrance hall does not make it welcoming,\n		-- it makes it an obstacle course -- the reference's lobby floor is almost entirely bare\n		-- and that is *why* it reads as big.\n		-- Forward of the flights, not beside them. With the curved stairs back, the arcs sweep\n		-- through the back corners of the atrium again -- which is exactly where these were, and\n		-- a tread came down inside a bench. Sitting them nearer the doors keeps them off the\n		-- stair and out of the central walk at the same time.\n		local wx = side * (ATRIUM_X2 - 7)\n		local wz = ATRIUM_Z1 + 10\n\n		Kit.Block(parent, `WaitBench{side}`, at(wx, 2.3, wz), Vector3.new(6, 0.7, 20), {\n			color = WALNUT,\n			material = Enum.Material.Wood,\n			collide = true,\n		})\n		for leg = -1, 1, 2 do\n			Kit.Block(parent, `WaitBenchLeg{side}_{leg}`, at(wx, 1.15, wz + leg * 7), Vector3.new(5, 2.3, 0.8), {\n				color = Color3.fromRGB(96, 102, 114),\n				material = Enum.Material.Metal,\n			}).CastShadow = false\n		end\n		Kit.Block(parent, `WaitBenchBack{side}`, at(wx - side * 2.6, 4.4, wz), Vector3.new(0.8, 4.4, 20), {\n			color = Color3.fromRGB(104, 118, 176),\n			material = Enum.Material.Fabric,\n		}).CastShadow = false\n\n		Kit.Block(parent, `LobbyPlanter{side}`, at(wx, 1.8, wz + 15), Vector3.new(6, 3.6, 6), {\n			color = Color3.fromRGB(196, 202, 214),\n			material = Enum.Material.Concrete,\n			collide = true,\n		})\n		Kit.Block(parent, `LobbyPlanterSoil{side}`, at(wx, 3.7, wz + 15), Vector3.new(5.2, 0.4, 5.2), {\n			color = Color3.fromRGB(72, 56, 42),\n		}).CastShadow = false\n		for leaf = 1, 3 do\n			Kit.Block(parent, `LobbyShrub{side}_{leaf}`, at(wx + (leaf - 2) * 1.6, 6.2 + leaf * 0.6, wz + 15 + (leaf - 2) * 0.8), Vector3.new(1.4, 5.6, 1.4), {\n				color = Color3.fromRGB(74, 126, 74),\n				material = Enum.Material.Grass,\n			}).CastShadow = false\n		end\n	end\n\n	-- The banners are gone.\n	--\n	-- Four fabric drops 9 studs wide and 39 tall, hung across the atrium on the old full-width\n	-- void. When the first floor was cut back to just the two stairwells they stopped hanging in\n	-- open space and started hanging *through* them: banner 1 at x -570 fell straight down the\n	-- left flight and banner 4 down the right one. From the gallery they read as two enormous\n	-- blue slabs standing in front of the stairs, which is exactly what they were.\n	--\n	-- Nothing replaces them. The atrium's height now comes from the two shafts themselves, and\n	-- hanging anything in a shaft a staircase is already using is how this happened.\n\n\n	-- The desk, facing whoever comes through the doors.\n	-- The desk faces the doors, at the back of the lobby, not just inside them.\n	--\n	-- It sat 8 studs from the front, which put it between the doors and the room -- you walked\n	-- into the back of it. A reception faces the way people arrive from and stands at the far\n	-- side of the space they arrive into, with the stairs to either side of it. The reference\n	-- puts the Director's office in exactly that position: straight ahead as you come in.\n	local deskZ = ATRIUM_Z2 - 8\n	Kit.Block(parent, \"LobbyDesk\", at(0, 2.4, deskZ), Vector3.new(BUILDING.LobbyDeskWidthStuds, 4.8, 6), {\n		color = WOOD,\n		material = Enum.Material.Wood,\n		collide = true,\n	})\n	Kit.Block(parent, \"LobbyDeskTop\", at(0, 5, deskZ), Vector3.new(BUILDING.LobbyDeskWidthStuds + 2, 0.5, 7.4), {\n		color = OFF_WHITE,\n	})\n	local deskFront = Kit.Block(parent, \"LobbyDeskFace\", at(0, 2.6, deskZ - 3.2), Vector3.new(BUILDING.LobbyDeskWidthStuds, 3.4, 0.3), {\n		color = BLUE,\n	})\n	deskFront.CastShadow = false\n	Kit.Sign(deskFront, \"RECEPTION\", 20, LABEL_DIST, Color3.fromRGB(246, 250, 255))\n\n	-- Benches in two facing ranks down the *middle* of the lobby, between the doors and the\n	-- desk. They used to sit out at the sides, which is where the stairs now sweep -- a scan of\n	-- the stair found forty-seven parts within twenty studs of a tread, most of them these and\n	-- the trophy cases. A stair needs air around its foot or arriving at it is an obstacle\n	-- course.\n	for index = 1, BUILDING.LobbyBenches do\n		local side = if index % 2 == 1 then -1 else 1\n		local row = math.floor((index - 1) / 2)\n		-- **Off the entrance axis.**\n		--\n		-- These sat seven studs either side of the centreline, thirteen studs in -- the first\n		-- thing in the room and directly across the view from the doors. The reference's lobby\n		-- floor is almost entirely bare, and that is exactly why it reads as large: what makes a\n		-- room feel big is an uninterrupted floor, not a high ceiling.\n		--\n		-- Out at the flanks and set back, so they are somewhere to sit rather than something to\n		-- walk around.\n		local x = side * (BUILDING.AtriumWidthStuds / 2 - 12)\n		local z = ATRIUM_Z1 + 20 + row * 9\n		Kit.Block(parent, `LobbyBench{index}`, at(x, 2.2, z), Vector3.new(4.5, 0.8, 13), {\n			color = WOOD,\n			material = Enum.Material.Wood,\n			collide = true,\n		})\n		for end_ = -1, 1, 2 do\n			Kit.Block(parent, `LobbyBenchLeg{index}_{end_}`, at(x, 1.1, z + end_ * 5), Vector3.new(3.6, 2.2, 1), {\n				color = Color3.fromRGB(78, 82, 94),\n				material = Enum.Material.Metal,\n			})\n		end\n	end\n\n	-- Planting, because every lobby in the reference has a tree in it and a hard-surfaced room\n	-- three storeys tall needs one thing in it that is not a rectangle.\n	for index = 1, BUILDING.LobbyTrees do\n		local side = if index % 2 == 1 then -1 else 1\n		local row = math.floor((index - 1) / 2)\n		Kit.Planter(\n			parent,\n			`LobbyPlanter{index}`,\n			at(side * (BUILDING.AtriumWidthStuds / 2 - 8), 0.4, ATRIUM_Z1 + 4 + row * 7),\n			5,\n			14\n		)\n	end\n\n	-- The trophy case. One object that says the building has a past, which is a thing no amount\n	-- of clean geometry can say on its own.\n	for index = 1, BUILDING.LobbyCases do\n		local side = if index % 2 == 1 then -1 else 1\n		-- Against the back wall beside the reception, not out at the sides where the stairs are.\n		-- On the side walls at the *front* of the lobby, in the strip the stairs do not reach.\n		-- The sweep occupies z 16-48; this sits at 13, which is the entrance zone.\n		local x = side * (BUILDING.AtriumWidthStuds / 2 - 3)\n		Kit.Block(parent, `TrophyCase{index}`, at(x, 6, ATRIUM_Z1 + 5), Vector3.new(1.5, 12, 16), {\n			color = WOOD,\n			material = Enum.Material.Wood,\n		})\n		local glass = Kit.Block(parent, `TrophyGlass{index}`, at(x - side * 0.9, 6.5, ATRIUM_Z1 + 5), Vector3.new(0.2, 10, 14), {\n			color = GLASS_TINT,\n			material = Enum.Material.Glass,\n			transparency = 0.45,\n		})\n		glass.CastShadow = false\n		for shelf = 1, 3 do\n			for cup = 1, 3 do\n				Kit.Block(\n					parent,\n					`Trophy{index}_{shelf}_{cup}`,\n					at(x, 2.6 + shelf * 3, ATRIUM_Z1 + cup * 3.4),\n					Vector3.new(1, 2.2, 1),\n					{ color = Color3.fromRGB(226, 188, 92), material = Enum.Material.Metal }\n				).CastShadow = false\n			end\n		end\n	end\nend\n\n-- ---------------------------------------------------------------------------------------\n-- Stairs: the reason three storeys are three storeys.\n-- ---------------------------------------------------------------------------------------\n\nlocal function buildStairs(parent: Instance, at: (number, number, number) -> Vector3)\n	-- Two curved flights, one each side of the lobby, sweeping a quarter turn as they climb.\n	--\n	-- Straight flights were the wrong shape for this room twice over. A straight run presents\n	-- its *end* to somebody walking in -- you see a wedge of treads edge-on and it reads as a\n	-- ramp -- and it delivers you facing the way you were already going, which in a lobby is\n	-- back out of the front doors. A flight that sweeps round shows its whole side from the\n	-- entrance, and turns you toward the corridor as you arrive. The building tells you where\n	-- to go next without a sign, which is the thing a good stair does.\n	--\n	-- Each starts near the front of the lobby facing inward and turns 80 degrees toward the\n	-- back, landing on the first floor pointing at the corridor. See Kit.CurvedStairs for why a\n	-- box tread on an arc is close enough to a winder.\n	local rise = floorY(2) - floorY(1)\n	local radius = BUILDING.StairRadiusStuds\n	local width = BUILDING.StairWidthStuds\n	local sweep = math.rad(BUILDING.StairSweepDegrees)\n\n	for side = -1, 1, 2 do\n		-- The turn centre sits inboard of the flight, so the two stairs curve away from each\n		-- other around the middle of the lobby rather than into it.\n		local cx = stairCentre(side)\n		-- Set back by its own radius plus a margin, so the whole arc lands inside the atrium\n		-- rather than overrunning into the corridor behind it -- and clear of the entrance wings\n		-- in front, which reach z 12 and had seven treads of each flight inside them.\n		-- The turn centre sits a radius short of the back wall, so the arc finishes there and\n		-- the landing meets the corridor. Everything in front of it -- 22 studs of lobby -- is\n		-- the entrance zone, and stays clear.\n		-- Both of these now come from the same constants the floor openings are cut from, so a\n		-- flight and its stairwell cannot drift apart -- which is how the stairs ended up\n		-- arriving over a hole in the first place.\n		local cz = STAIR_CZ\n\n		-- **A true quarter turn: from facing the side wall to facing the corridor.**\n		--\n		-- The first attempt swept -140 to -60 degrees, which looks like a curve written down and\n		-- is nearly a straight line on the ground: across that range sine barely changes, so the\n		-- arc moved 74 studs in x and 5 in z. A flight has to turn through a quadrant to read as\n		-- turning at all.\n		--\n		-- Left stair runs 180 -> 90, right runs 0 -> 90. Both start pointing at their own side\n		-- wall and finish pointing at +z, which is the corridor -- so whichever one you take,\n		-- you arrive facing where you are going.\n		local startAngle = if side < 0 then math.rad(180) else 0\n		local turn = if side < 0 then -sweep else sweep\n\n		local laid = Kit.CurvedStairs(\n			parent,\n			`Stair{side}`,\n			at(cx, floorY(1), cz),\n			radius,\n			startAngle,\n			turn,\n			rise,\n			BUILDING.StairSteps,\n			width,\n			STAIR_TREAD\n		)\n		if not laid then\n			error(\n				`[AGES world] the school stair is too steep: {rise} studs over {BUILDING.StairSteps} steps.`\n					.. ` A Roblox humanoid manages 2 studs a step. Raise Config.School.Building.StairSteps`\n					.. ` or lower FloorHeightStuds.`\n			)\n		end\n\n		-- No landing slab any more. There used to be a 20x20 tile at the head of each flight,\n		-- because the void was cut to the full depth of the atrium and the top tread genuinely\n		-- did deliver you over a hole. Two isolated squares hanging in a double-height space is\n		-- what that looked like from the lobby, and it is the wrong fix: the floor was the thing\n		-- that was missing, not a platform. The gallery is the floor -- see VOID_Z2 -- and the\n		-- flight now tops out on it.\n	end\nend\n\n-- A vending machine. Two kinds off one function, because they are the same cabinet with a\n-- different face -- and building them separately would mean two places to fix the plinth.\n--\n-- The numbered slots are the detail that does the work. A glass box with coloured blocks in\n-- it is a fridge; the same box with 001 through 016 under the shelves is unmistakably a\n-- vending machine, and it costs sixteen labels.\nlocal function buildVendingMachine(parent: Instance, name: string, base: Vector3, snacks: boolean, facing: number)\n	local w, h, d = VEND.WidthStuds, VEND.HeightStuds, VEND.DepthStuds\n\n	local body = Kit.Block(parent, `{name}Body`, base + Vector3.new(0, h / 2, 0), Vector3.new(w, h, d), {\n		color = if snacks then Color3.fromRGB(226, 228, 236) else Color3.fromRGB(44, 52, 96),\n		yawDegrees = facing,\n		collide = true,\n	})\n\n	-- The window, and the shelves behind it.\n	local glassW = w * 0.62\n	local glassX = -w * 0.14\n	Kit.Block(parent, `{name}Glass`, base + Vector3.new(glassX, h * 0.58, -d * 0.52), Vector3.new(glassW, h * 0.6, 0.25), {\n		color = Color3.fromRGB(180, 208, 232),\n		material = Enum.Material.Glass,\n		transparency = 0.5,\n		yawDegrees = facing,\n	}).CastShadow = false\n\n	if snacks then\n		local itemColors = {\n			Color3.fromRGB(214, 76, 68),\n			Color3.fromRGB(72, 122, 206),\n			Color3.fromRGB(96, 176, 108),\n			Color3.fromRGB(232, 176, 72),\n			Color3.fromRGB(238, 238, 240),\n			Color3.fromRGB(104, 72, 54),\n		}\n		for row = 1, VEND.Rows do\n			local shelfY = h * 0.84 - (row - 1) * (h * 0.15)\n			Kit.Block(parent, `{name}Shelf{row}`, base + Vector3.new(glassX, shelfY - 1.4, -d * 0.4), Vector3.new(glassW, 0.2, d * 0.5), {\n				color = Color3.fromRGB(198, 202, 210),\n				yawDegrees = facing,\n			}).CastShadow = false\n			for column = 1, VEND.Columns do\n				local index = (row - 1) * VEND.Columns + column\n				local x = glassX - glassW / 2 + glassW * ((column - 0.5) / VEND.Columns)\n				Kit.Block(parent, `{name}Item{index}`, base + Vector3.new(x, shelfY, -d * 0.4), Vector3.new(1.1, 1.7, 0.9), {\n					color = itemColors[((index - 1) % #itemColors) + 1],\n					yawDegrees = facing,\n				}).CastShadow = false\n			end\n			-- The slot numbers, one label per row rather than per item: sixteen billboards on\n			-- one machine is sixteen draw calls for something read once.\n			local strip = Kit.Block(parent, `{name}Strip{row}`, base + Vector3.new(glassX, shelfY - 1.9, -d * 0.55), Vector3.new(glassW, 0.7, 0.15), {\n				color = Color3.fromRGB(246, 246, 248),\n				yawDegrees = facing,\n			})\n			strip.CastShadow = false\n			local first = (row - 1) * VEND.Columns + 1\n			Kit.Sign(strip, string.format(\"%03d\", first) .. \"  -  \" .. string.format(\"%03d\", first + VEND.Columns - 1), 8, LABEL_DIST * 0.5, Color3.fromRGB(52, 58, 70))\n		end\n	else\n		-- The coffee machine: a cup in a recess, and the drinks list.\n		Kit.Block(parent, `{name}Recess`, base + Vector3.new(glassX, h * 0.3, -d * 0.4), Vector3.new(glassW * 0.7, h * 0.22, d * 0.5), {\n			color = Color3.fromRGB(232, 232, 238),\n			yawDegrees = facing,\n		}).CastShadow = false\n		Kit.Block(parent, `{name}Cup`, base + Vector3.new(glassX, h * 0.28, -d * 0.45), Vector3.new(1.5, 2, 1.5), {\n			color = Color3.fromRGB(238, 232, 224),\n			yawDegrees = facing,\n		}).CastShadow = false\n		local menu = Kit.Block(parent, `{name}Menu`, base + Vector3.new(glassX, h * 0.62, -d * 0.55), Vector3.new(glassW, h * 0.24, 0.2), {\n			color = Color3.fromRGB(28, 30, 40),\n			yawDegrees = facing,\n		})\n		menu.CastShadow = false\n		Kit.Sign(menu, \"LATTE  ·  CAPPUCCINO  ·  AMERICANO\", 10, LABEL_DIST * 0.6, Color3.fromRGB(150, 196, 240))\n	end\n\n	-- The keypad and the reader, which every machine in the reference has and which are what\n	-- make the right-hand third of the cabinet read as controls rather than as blank panel.\n	Kit.Block(parent, `{name}Pad`, base + Vector3.new(w * 0.32, h * 0.55, -d * 0.52), Vector3.new(w * 0.24, h * 0.3, 0.2), {\n		color = Color3.fromRGB(24, 26, 36),\n		yawDegrees = facing,\n	}).CastShadow = false\n	Kit.Block(parent, `{name}Reader`, base + Vector3.new(w * 0.32, h * 0.8, -d * 0.52), Vector3.new(w * 0.22, 2, 0.2), {\n		color = Color3.fromRGB(46, 92, 178),\n		material = Enum.Material.Neon,\n		yawDegrees = facing,\n	}).CastShadow = false\n\n	-- The delivery tray at the bottom.\n	Kit.Block(parent, `{name}Tray`, base + Vector3.new(glassX, h * 0.12, -d * 0.5), Vector3.new(glassW * 0.8, 1.8, 0.25), {\n		color = Color3.fromRGB(38, 40, 50),\n		yawDegrees = facing,\n	}).CastShadow = false\n\n	return body\nend\n\n-- A pair of them, side by side, the way the reference always has them.\nlocal function buildVendingPair(parent: Instance, name: string, at: (number, number, number) -> Vector3, x: number, y: number, z: number, facing: number)\n	buildVendingMachine(parent, `{name}Coffee`, at(x - VEND.WidthStuds * 0.6, y, z), false, facing)\n	buildVendingMachine(parent, `{name}Snacks`, at(x + VEND.WidthStuds * 0.6, y, z), true, facing)\nend\n\n-- ---------------------------------------------------------------------------------------\n-- Corridors, and the lockers down them.\n-- ---------------------------------------------------------------------------------------\n\nlocal function buildCorridors(parent: Instance, at: (number, number, number) -> Vector3)\n	local half = W / 2\n	local backZ = D - WALL_T\n	local corridorZ = backZ - BAND_D - CORRIDOR_W / 2\n\n	for floor = 1, BUILDING.Floors do\n		local y = floorY(floor)\n\n		-- The corridor floor, in a different tone so the route through the building is legible\n		-- from the moment you step onto it.\n		-- Tile, not plastic. The largest surface a player looks at in this building should not be\n		-- the one material that says \"nobody finished this\".\n		Kit.Slab(parent, `CorridorFloor{floor}`, at(0, y + 0.05, corridorZ), W - WALL_T * 2, CORRIDOR_W, 0.3, {\n			color = OFF_WHITE,\n			material = Enum.Material.Pebble,\n		})\n\n		-- Lockers down the front wall of the corridor, both sides of the atrium so the run is\n		-- not broken by the void.\n		-- **A continuous bank, not a row of separate slabs.**\n		--\n		-- These used to be individual blocks with air between them, standing at the open edge of\n		-- the corridor with no wall behind -- so instead of lockers you got a row of blue panels\n		-- floating in space, which is what the screenshots show and it is the single most\n		-- confusing thing in the building.\n		--\n		-- A locker bank is one solid run. The doors are *lines in* that run, not gaps between\n		-- objects: a plinth it stands on, a cap along the top, and a thin recessed groove every\n		-- door-width. That reads as lockers from any angle and never floats, because the body\n		-- is its own wall.\n		-- **Two banks, one at each end of the wall. The middle stays empty.**\n		--\n		-- This was one unbroken 206-stud run, and continuity was the whole point of it -- a wall\n		-- that *is* lockers rather than a wall with lockers on it. It reads well and it is a bad\n		-- place to keep your books.\n		--\n		-- A locker is somewhere you stop, open a door and stand with your back to the route. Line\n		-- the entire length of a corridor with them and every one of those stops happens in the\n		-- middle of the traffic, and the two hundred studs of frontage that ought to be the widest\n		-- part of the hall is a queue. Put them at the ends and the stopping happens where nobody\n		-- is trying to get past, which is what a real school does -- banks by the stairs, clear\n		-- floor between them.\n		-- The face of the wall the banks stand against, a stud and a half proud of it.\n		local wallZ = corridorZ - CORRIDOR_W / 2 + 1.4\n		local runEnd = W / 2 - WALL_T - 10\n		local bankW = (runEnd * 2) * 0.28\n		local bankH = 11\n\n		for side = -1, 1, 2 do\n			local bankCx = side * (runEnd - bankW / 2)\n			local doors = math.max(6, math.floor(bankW / 5))\n			local doorW = bankW / doors\n			local x0 = bankCx - bankW / 2\n			local tag = `{floor}_{if side < 0 then \"W\" else \"E\"}`\n\n			Kit.Block(parent, `LockerBank{tag}`, at(bankCx, y + 1 + bankH / 2, wallZ), Vector3.new(bankW, bankH, 2.4), {\n				color = BLUE,\n				material = Enum.Material.Metal,\n				collide = true,\n			})\n			Kit.Block(parent, `LockerPlinth{tag}`, at(bankCx, y + 0.5, wallZ), Vector3.new(bankW, 1, 2.8), {\n				color = DEEP_BLUE,\n				material = Enum.Material.Metal,\n			}).CastShadow = false\n			Kit.Block(parent, `LockerCap{tag}`, at(bankCx, y + 1.3 + bankH, wallZ), Vector3.new(bankW, 0.6, 2.8), {\n				color = DEEP_BLUE,\n				material = Enum.Material.Metal,\n			}).CastShadow = false\n\n			for index = 1, doors do\n				local dx = x0 + doorW * (index - 0.5)\n				Kit.Block(parent, `LockerHandle{tag}_{index}`, at(dx + doorW * 0.3, y + 1 + bankH * 0.5, wallZ + 1.3), Vector3.new(0.5, 1.8, 0.3), {\n					color = Color3.fromRGB(232, 236, 244),\n					material = Enum.Material.Metal,\n				}).CastShadow = false\n				Kit.Block(parent, `LockerVent{tag}_{index}`, at(dx, y + 1 + bankH * 0.86, wallZ + 1.3), Vector3.new(doorW * 0.42, 0.9, 0.25), {\n					color = Color3.fromRGB(58, 92, 158),\n				}).CastShadow = false\n				if index < doors then\n					Kit.Block(parent, `LockerSeam{tag}_{index}`, at(x0 + doorW * index, y + 1 + bankH / 2, wallZ + 1.25), Vector3.new(0.3, bankH - 0.4, 0.3), {\n						color = DEEP_BLUE,\n					}).CastShadow = false\n				end\n			end\n		end\n\n		-- A bench at each end of the run, as in the reference. At the ends rather than the middle,\n		-- because a bench in front of the lockers is a bench in front of somebody's locker.\n		for side = -1, 1, 2 do\n			local bx = side * (runEnd - bankW - 12)\n			Kit.Block(parent, `LockerBench{floor}_{side}`, at(bx, y + 2.3, wallZ + 5), Vector3.new(18, 0.7, 3.4), {\n				color = WALNUT,\n				material = Enum.Material.Wood,\n				collide = true,\n			})\n			for leg = -1, 1, 2 do\n				Kit.Block(parent, `LockerBenchLeg{floor}_{side}_{leg}`, at(bx + leg * 6.5, y + 1.15, wallZ + 5), Vector3.new(0.7, 2.3, 3), {\n					color = Color3.fromRGB(96, 102, 114),\n					material = Enum.Material.Metal,\n				}).CastShadow = false\n			end\n		end\n\n		-- The hexagon panel that used to sit on the corridor's end wall is gone: that wall is\n		-- where the locker alcove now is, and the two were occupying the same square studs. The\n		-- lockers are the better use of an end wall -- a decorative disc there was filling a space\n		-- that had nothing in it, which is a problem the corridor no longer has.\n\n		-- Ceiling strips down the length, instead of a row of square panels. A strip draws a line\n		-- the eye can follow; a row of squares is only lighting.\n		-- **A grid of recessed panels, not a line of strips.**\n		--\n		-- The reference ceiling is the brightest thing in the photograph: rows of flush rectangular\n		-- panels running the whole hall, close enough together that the ceiling reads as lit rather\n		-- than as a dark plane with some lights on it. Ours was one row of long strips down the\n		-- centre, which lights the floor but leaves the ceiling itself dark -- and in a hall this\n		-- wide that is most of what made it feel like a corridor at night.\n		--\n		-- Two rows across the 44-stud hall, because one row down the middle of a wide space throws\n		-- the edges into shadow and the edges are where the doors are.\n		local panels = BUILDING.CeilingStrips * 2\n		for index = 1, panels do\n			for row = -1, 1, 2 do\n				Kit.Block(\n					parent,\n					`CeilPanel{floor}_{index}_{row}`,\n					at(-half + W * ((index - 0.5) / panels), y + FLOOR_H - SLAB - 0.4, corridorZ + row * CORRIDOR_W * 0.22),\n					Vector3.new(W / panels - 3, 0.3, 4.5),\n					{ color = Color3.fromRGB(255, 253, 246), material = Enum.Material.Neon }\n				).CastShadow = false\n			end\n		end\n\n		-- **A planting bed down the centre of the hall, and columns flanking it.**\n		--\n		-- This is what the reference has and what forty-four studs of width is *for*. A wide empty\n		-- hall is not better than a narrow one, it is just emptier -- what makes theirs read as a\n		-- room is that the middle is occupied and you walk around it, which gives the space a near\n		-- edge and a far edge instead of one flat plane.\n		--\n		-- Ground floor only. Upstairs the same strip is the gallery edge and wants to stay clear.\n		if floor == 1 then\n			local bedLen = W * 0.42\n			Kit.Block(parent, \"HallBed\", at(0, y + 0.6, corridorZ), Vector3.new(bedLen, 1.2, 14), {\n				color = Color3.fromRGB(150, 200, 236),\n				material = Enum.Material.SmoothPlastic,\n				collide = true,\n			})\n			Kit.Block(parent, \"HallBedSoil\", at(0, y + 1.3, corridorZ), Vector3.new(bedLen - 3, 0.4, 11), {\n				color = Color3.fromRGB(72, 56, 42),\n			}).CastShadow = false\n\n			local trees = 4\n			for index = 1, trees do\n				local tx = -bedLen / 2 + bedLen * ((index - 0.5) / trees)\n				Kit.Block(parent, `HallTrunk{index}`, at(tx, y + 4, corridorZ), Vector3.new(2, 6, 2), {\n					color = Color3.fromRGB(122, 84, 56),\n					material = Enum.Material.Wood,\n					collide = true,\n				})\n				-- Three stacked blocks rather than one: a tree is read by its silhouette, and a\n				-- single box reads as a box however green it is.\n				for tier = 1, 3 do\n					local spread = 9 - tier * 1.8\n					Kit.Block(parent, `HallCanopy{index}_{tier}`, at(tx, y + 8 + tier * 3.4, corridorZ), Vector3.new(spread, 4.2, spread), {\n						color = Color3.fromRGB(86, 142, 82),\n						material = Enum.Material.Grass,\n					}).CastShadow = false\n				end\n			end\n\n			-- Benches facing the bed, on both sides, so the middle of the hall is somewhere to be.\n			for side = -1, 1, 2 do\n				for index = 1, 2 do\n					local bx = -bedLen / 4 + (bedLen / 2) * (index - 1)\n					Kit.Block(parent, `HallBench{side}_{index}`, at(bx, y + 2.2, corridorZ + side * 10), Vector3.new(16, 0.7, 3.2), {\n						color = WALNUT,\n						material = Enum.Material.Wood,\n						collide = true,\n					})\n					for leg = -1, 1, 2 do\n						Kit.Block(parent, `HallBenchLeg{side}_{index}_{leg}`, at(bx + leg * 6, y + 1.1, corridorZ + side * 10), Vector3.new(0.8, 2.2, 2.8), {\n							color = Color3.fromRGB(96, 102, 114),\n							material = Enum.Material.Metal,\n						}).CastShadow = false\n					end\n				end\n			end\n		end\n\n		-- Columns down both flanks of the hall. The reference is full of them and they are doing\n		-- real work: a row of uprights at a regular pitch is what gives a long space a measurable\n		-- rhythm, so the far end reads as far away rather than as a wall of unknown distance.\n		for index = 1, 8 do\n			for side = -1, 1, 2 do\n				Kit.Block(\n					parent,\n					`HallColumn{floor}_{index}_{side}`,\n					-- Seven studs off the wall, not three and a half. Standing them almost against it\n					-- put them through the bin line, and a column touching a wall is a pilaster --\n					-- the reference's are free-standing, with room to walk behind them.\n					at(-half + W * ((index - 0.5) / 8), y + (FLOOR_H - SLAB) / 2, corridorZ + side * (CORRIDOR_W / 2 - 7)),\n					Vector3.new(3.5, FLOOR_H - SLAB, 3.5),\n					{ color = OFF_WHITE, material = Enum.Material.Concrete, collide = true }\n				)\n				-- The blue stripe up each column. Every column in the reference carries one, and\n				-- it is the detail that ties the columns to the floor bands and the door frames\n				-- -- without it they are just grey posts and the blue reads as unrelated trim.\n				for face = -1, 1, 2 do\n					Kit.Block(\n						parent,\n						`HallColumnStripe{floor}_{index}_{side}_{face}`,\n						at(-half + W * ((index - 0.5) / 8) + face * 1.9, y + (FLOOR_H - SLAB) / 2, corridorZ + side * (CORRIDOR_W / 2 - 7)),\n						Vector3.new(0.4, FLOOR_H - SLAB, 2.2),\n						{ color = BLUE }\n					).CastShadow = false\n				end\n			end\n		end\n\n		-- Bins along the corridor. The most ordinary object a school has, and there were none.\n		for index = 1, BUILDING.BinsPerFloor do\n			local share = (index - 0.5) / BUILDING.BinsPerFloor\n			-- Between the columns, not on them: the columns sit at the midpoint of each eighth of\n			-- the frontage, so the bins take the boundaries instead.\n			-- Offset along the wall so a bin lands neither on a column nor on a vending machine.\n			-- Both of those are placed off their own even divisions of the frontage, so an\n			-- unshifted bin line is guaranteed to collide with one or the other somewhere.\n			local x = -half + W * share + 9\n			local z = corridorZ + CORRIDOR_W / 2 - 2.5\n			Kit.Block(parent, `Bin{floor}_{index}`, at(x, y + 2.2, z), Vector3.new(4, 4.4, 4), {\n				color = Color3.fromRGB(64, 78, 96),\n				material = Enum.Material.Metal,\n				collide = true,\n			})\n			Kit.Block(parent, `BinLid{floor}_{index}`, at(x, y + 4.6, z), Vector3.new(4.6, 0.5, 4.6), {\n				color = Color3.fromRGB(46, 58, 74),\n				material = Enum.Material.Metal,\n			}).CastShadow = false\n		end\n\n		-- Water fountains against the locker wall, which is where a school puts them: on the\n		-- circulation route, not tucked in a corner. Two per floor so there is one near either\n		-- stair rather than a single one everybody walks the length of the building for.\n		for index = 1, BUILDING.FountainsPerFloor do\n			local share = (index - 0.5) / BUILDING.FountainsPerFloor\n			local x = -half + W * share\n			-- The *far* side of the corridor. These used to share the near edge with the lockers,\n			-- and once the lockers became one continuous bank rather than spaced slabs there was no\n			-- longer a gap to stand in -- six fountains ended up inside it.\n			local z = corridorZ + CORRIDOR_W / 2 - 2.4\n\n			-- The back panel, the basin, and the spout. Three parts, and the basin is the one that\n			-- has to read as a basin from standing height -- it is wider than it is deep and sits\n			-- at hip height, which is the whole silhouette of a drinking fountain.\n			Kit.Block(parent, `FountainBack{floor}_{index}`, at(x, y + 5, z), Vector3.new(5, 8, 0.8), {\n				color = Color3.fromRGB(206, 212, 222),\n				material = Enum.Material.Metal,\n			})\n			Kit.Block(parent, `Fountain{floor}_{index}`, at(x, y + 3.6, z + 1.2), Vector3.new(6, 1.2, 3), {\n				color = Color3.fromRGB(226, 230, 238),\n				material = Enum.Material.Metal,\n				collide = true,\n			})\n			Kit.Block(parent, `FountainBasin{floor}_{index}`, at(x, y + 3.9, z + 1.2), Vector3.new(4.4, 0.5, 2), {\n				color = Color3.fromRGB(150, 190, 216),\n				material = Enum.Material.Glass,\n				transparency = 0.3,\n			}).CastShadow = false\n			Kit.Block(parent, `FountainSpout{floor}_{index}`, at(x, y + 4.6, z + 0.5), Vector3.new(0.5, 0.9, 0.5), {\n				color = Color3.fromRGB(186, 192, 202),\n				material = Enum.Material.Metal,\n			}).CastShadow = false\n		end\n\n		-- A pair of machines against the back wall of the corridor on every floor. Against the\n		-- *back* rather than the locker wall on purpose: the lockers are where the corridor\n		-- system stands people, and a cabinet in that run would be somewhere to be cornered\n		-- against rather than somewhere to buy a drink.\n		buildVendingPair(parent, `CorridorVending{floor}`, at, half - 34, y + 0.2, corridorZ + CORRIDOR_W / 2 - 2, 180)\n	end\nend\n\n-- ---------------------------------------------------------------------------------------\n-- The rooms themselves: partitions, glazing onto the corridor, signs, lights, fit-out.\n-- ---------------------------------------------------------------------------------------\n\nlocal function fitClassroom(parent: Instance, at: (number, number, number) -> Vector3, rect: Rect, y: number)\n	local cx, cz = rectCenter(rect)\n	local width = rect.x2 - rect.x1\n	local perRow = math.ceil(FIT.DesksPerClassroom / FIT.DeskRows)\n\n	-- The desk field is inset from the left wall, because that wall now carries the storage run.\n	-- At six rows the field reaches the middle of the room, which is exactly where the cupboards\n	-- are -- three desk legs per classroom were standing inside them.\n	local deskLeft = rect.x1 + 10\n	local deskWidth = width - 14\n\n	-- **The rows divide the space that is free, rather than marching at a fixed pitch until\n	-- they hit something.**\n	--\n	-- They used to step 8 studs back from the front wall however deep the room was. That was\n	-- survivable when a room was 99 studs deep and is not at 46: row five landed on top of the\n	-- teacher's desk and row six stood outside the back wall. A room's furniture has to be a\n	-- function of the room, or every change to the plan breaks it silently.\n	local teacherZ = rect.z2 - 8\n	local fieldZ1 = rect.z1 + 6\n	local rowPitch = (teacherZ - 6 - fieldZ1) / FIT.DeskRows\n\n	for row = 1, FIT.DeskRows do\n		for seat = 1, perRow do\n			local x = deskLeft + deskWidth * ((seat - 0.5) / perRow)\n			local z = fieldZ1 + rowPitch * (row - 0.5)\n			Kit.Block(parent, `Desk{rect.id}{row}_{seat}`, at(x, y + 2.6, z), Vector3.new(5, 0.4, 3), { color = WOOD })\n			Kit.Block(parent, `DeskLeg{rect.id}{row}_{seat}`, at(x, y + 1.3, z), Vector3.new(4.4, 2.6, 2.4), { color = DARK, transparency = 0.15 })\n			Kit.Block(parent, `Chair{rect.id}{row}_{seat}`, at(x, y + 1.6, z + rowPitch * 0.36), Vector3.new(2.6, 0.35, 2.6), { color = BLUE })\n		end\n	end\n\n	-- The board, framed and with a pen tray. A dark rectangle on a wall is a rectangle; a\n	-- frame and a tray are what make it a whiteboard, and they are two parts.\n	Kit.Block(parent, `BoardFrame{rect.id}`, at(cx, y + 8, rect.z2 - 1.4), Vector3.new(width * 0.5 + 1.4, 9.4, 0.3), {\n		color = Color3.fromRGB(198, 202, 210),\n	}).CastShadow = false\n	Kit.Block(parent, `Board{rect.id}`, at(cx, y + 8, rect.z2 - 1.2), Vector3.new(width * 0.5, 8, 0.4), { color = Color3.fromRGB(238, 240, 244) })\n	Kit.Block(parent, `BoardTray{rect.id}`, at(cx, y + 3.7, rect.z2 - 1.7), Vector3.new(width * 0.5, 0.4, 1), {\n		color = Color3.fromRGB(176, 180, 190),\n		material = Enum.Material.Metal,\n	}).CastShadow = false\n\n	-- The teacher desk, with a screen and a chair behind it. Same reasoning as the library\n	-- counter: a bare slab is a plinth, a screen on it is a desk somebody works at.\n	Kit.Block(parent, `TeacherDesk{rect.id}`, at(cx, y + 2.2, teacherZ), Vector3.new(9, 4.4, 3.4), {\n		color = WALNUT,\n		material = Enum.Material.Wood,\n		collide = true,\n	})\n	Kit.Block(parent, `TeacherTop{rect.id}`, at(cx, y + 4.6, teacherZ), Vector3.new(10, 0.4, 4), { color = OFF_WHITE })\n	Kit.Block(parent, `TeacherScreen{rect.id}`, at(cx - 2, y + 6.2, teacherZ + 0.6), Vector3.new(4.2, 2.8, 0.3), {\n		color = Color3.fromRGB(30, 32, 40),\n	}).CastShadow = false\n	Kit.Block(parent, `TeacherChair{rect.id}`, at(cx, y + 1.7, rect.z2 - 10), Vector3.new(2.8, 0.4, 2.8), { color = DARK })\n\n	-- A run of low storage down one side, and something green in the corner. Every reference\n	-- classroom has cupboards under the window and a plant; an empty perimeter is what makes a\n	-- room read as a box with desks in it.\n	Kit.Block(parent, `Storage{rect.id}`, at(rect.x1 + 4, y + 2.4, cz), Vector3.new(4, 4.8, (rect.z2 - rect.z1) * 0.45), {\n		color = OFF_WHITE,\n		collide = true,\n	})\n	Kit.Block(parent, `StorageTop{rect.id}`, at(rect.x1 + 4, y + 5, cz), Vector3.new(4.6, 0.4, (rect.z2 - rect.z1) * 0.45 + 0.6), {\n		color = WALNUT,\n		material = Enum.Material.Wood,\n	}).CastShadow = false\n	Kit.Planter(parent, `ClassPlant{rect.id}`, at(rect.x2 - 5, y + 0.2, rect.z2 - 6), 3, 9)\nend\n\nlocal function fitCafeteria(parent: Instance, at: (number, number, number) -> Vector3, rect: Rect, y: number)\n	local width = rect.x2 - rect.x1\n	local depth = rect.z2 - rect.z1\n\n	-- The servery down the back wall: a long counter with a warm shelf over it.\n	local cx = (rect.x1 + rect.x2) / 2\n	Kit.Block(parent, \"Servery\", at(cx, y + 2.6, rect.z2 - 6), Vector3.new(width * 0.62, 5.2, 5), { color = CONCRETE, material = Enum.Material.Metal })\n	Kit.Block(parent, \"ServeryGuard\", at(cx, y + 7.2, rect.z2 - 6), Vector3.new(width * 0.62, 0.3, 5), {\n		color = GLASS_TINT,\n		material = Enum.Material.Glass,\n		transparency = 0.5,\n	})\n	for tray = 1, 8 do\n		local x = cx - width * 0.28 + (width * 0.56) * ((tray - 0.5) / 8)\n		Kit.Block(parent, `Tray{tray}`, at(x, y + 5.4, rect.z2 - 6), Vector3.new(4, 0.4, 3), { color = Color3.fromRGB(226, 96, 84) })\n	end\n\n	-- Tables, in two ranks so the room has a route through the middle of it.\n	for index = 1, FIT.CafeteriaTables do\n		local column = (index - 1) % 4\n		local row = math.floor((index - 1) / 4)\n		local x = rect.x1 + width * ((column + 0.5) / 4)\n		local z = rect.z1 + 10 + row * 14\n		Kit.Block(parent, `CafeTable{index}`, at(x, y + 3, z), Vector3.new(9, 0.4, 6), { color = WHITE })\n		Kit.Block(parent, `CafeTableLeg{index}`, at(x, y + 1.5, z), Vector3.new(1.2, 3, 1.2), { color = DARK })\n		for seat = -1, 1, 2 do\n			Kit.Block(parent, `CafeStool{index}_{seat}`, at(x + seat * 3, y + 1.8, z + seat * 4.6), Vector3.new(2.4, 0.35, 2.4), { color = BLUE })\n		end\n	end\n\n	-- The bunting the reference is full of, strung across the room.\n	--\n	-- Hung off the ceiling rather than at a fixed 14 studs. Absolute heights in here were all\n	-- chosen when a storey was 27 studs tall and every one of them was left up in the roof when\n	-- it became 15; anything that belongs to the ceiling should be measured from the ceiling.\n	local ceilY = y + FLOOR_H - 1.6\n	Kit.Bunting(parent, \"CafeBunting\", at(rect.x1 + 6, ceilY, rect.z1 + 8), at(rect.x2 - 6, ceilY, rect.z1 + 8), 18, { BLUE, WHITE, PALE_BLUE })\n\n	-- The crest on the back wall, over the servery.\n	--\n	-- Concentric discs rather than a decal, because this codebase draws with parts and a ring\n	-- costs one each. Built back to front so the outer ring is behind the inner one and the\n	-- whole thing reads as layered rather than as three circles fighting for the same plane.\n	local crestZ = rect.z2 - 1.6\n	local crestY = y + FLOOR_H * 0.62\n	for ring = 1, BUILDING.CafeCrestRings do\n		local share = 1 - (ring - 1) / BUILDING.CafeCrestRings\n		local radius = BUILDING.CafeCrestRadiusStuds * share\n		local tone = if ring % 2 == 1 then BLUE else WHITE\n		local disc = Kit.Block(\n			parent,\n			`CafeCrest{ring}`,\n			at(cx, crestY, crestZ - ring * 0.12),\n			Vector3.new(radius * 2, radius * 2, 0.3),\n			{ color = tone }\n		)\n		disc.Shape = Enum.PartType.Cylinder\n		-- A cylinder's length runs along X, so facing it at a wall is a quarter turn about Y --\n		-- the same trick Kit.Rug uses about Z to lay one flat on the floor.\n		disc.CFrame = CFrame.new(at(cx, crestY, crestZ - ring * 0.12)) * CFrame.Angles(0, math.rad(90), 0)\n		disc.Size = Vector3.new(0.3, radius * 2, radius * 2)\n		disc.CastShadow = false\n	end\n	local crestPlate = Kit.Block(parent, \"CafeCrestPlate\", at(cx, crestY, crestZ - 1), Vector3.new(BUILDING.CafeCrestRadiusStuds, 6, 0.2), {\n		color = BLUE,\n	})\n	crestPlate.CastShadow = false\n	Kit.Sign(crestPlate, \"AGES HIGH\", BUILDING.CafeCrestRadiusStuds * 0.9, LABEL_DIST, Color3.fromRGB(248, 251, 255))\n\n	-- The bar along the glazed front, with high stools.\n	--\n	-- A canteen has two kinds of seat: tables for groups, and a counter for one person with\n	-- twenty minutes. Only having tables is what makes a dining room read as a set rather than\n	-- as somewhere people actually eat.\n	local barZ = rect.z1 + 4\n	Kit.Block(parent, \"CafeBar\", at(cx, y + 5.4, barZ), Vector3.new(width * 0.8, 0.6, 4), {\n		color = WOOD,\n		material = Enum.Material.Wood,\n		collide = true,\n	})\n	for index = 1, BUILDING.CafeBarStools do\n		local share = (index - 0.5) / BUILDING.CafeBarStools\n		local x = cx - width * 0.4 + width * 0.8 * share\n		Kit.Block(parent, `CafeBarLeg{index}`, at(x, y + 2.6, barZ), Vector3.new(0.8, 5.6, 0.8), {\n			color = Color3.fromRGB(96, 102, 116),\n			material = Enum.Material.Metal,\n		}).CastShadow = false\n		-- The stools face the glass, which is the whole reason a bar goes on this wall.\n		Kit.Block(parent, `CafeBarStool{index}`, at(x, y + 4.2, barZ + 5), Vector3.new(2.6, 0.4, 2.6), {\n			color = BLUE,\n			collide = true,\n		})\n		Kit.Block(parent, `CafeBarStoolLeg{index}`, at(x, y + 2.1, barZ + 5), Vector3.new(0.7, 4.2, 0.7), {\n			color = Color3.fromRGB(96, 102, 116),\n			material = Enum.Material.Metal,\n		}).CastShadow = false\n	end\nend\n\nlocal function fitLibrary(parent: Instance, at: (number, number, number) -> Vector3, rect: Rect, y: number)\n	local width = rect.x2 - rect.x1\n	local depth = rect.z2 - rect.z1\n\n	-- Stacks, in ranks with aisles between them.\n	for index = 1, FIT.LibraryShelves do\n		local column = (index - 1) % 5\n		local row = math.floor((index - 1) / 5)\n		local x = rect.x1 + width * ((column + 0.5) / 5)\n		local z = rect.z1 + 14 + row * 20\n		-- Taller, darker, and with a shelf line between every band. The reference stacks are\n		-- walnut, nearly ceiling height, and *densely* full -- the colour of the spines is the\n		-- brightest thing in the room and the wood is the darkest, and the room lives on that.\n		Kit.Block(parent, `Stack{index}`, at(x, y + 7.5, z), Vector3.new(4, 15, 16), {\n			color = WALNUT,\n			material = Enum.Material.Wood,\n			collide = true,\n		})\n		-- Five bands rather than three, each a different mix, with a shelf board under it. A\n		-- band of flat colour reads as a painted stripe; a band with a board beneath it reads as\n		-- books standing on a shelf, and the board is one part.\n		local spines = {\n			Color3.fromRGB(198, 92, 84),\n			Color3.fromRGB(86, 132, 194),\n			Color3.fromRGB(216, 184, 104),\n			Color3.fromRGB(122, 158, 108),\n			Color3.fromRGB(158, 108, 172),\n		}\n		for band = 1, 5 do\n			local by = y + 1.6 + band * 2.7\n			Kit.Block(parent, `Books{index}_{band}`, at(x, by, z), Vector3.new(4.3, 2.1, 15), {\n				color = spines[((index + band) % #spines) + 1],\n			}).CastShadow = false\n			Kit.Block(parent, `Shelf{index}_{band}`, at(x, by - 1.2, z), Vector3.new(4.5, 0.3, 15.4), {\n				color = Color3.fromRGB(72, 50, 34),\n			}).CastShadow = false\n		end\n	end\n\n	-- The desk you are sent to. Counter, worktop, and two monitors -- the reference desk has\n	-- screens on it, and a bare slab reads as a plinth rather than as somewhere staffed.\n	local cx = (rect.x1 + rect.x2) / 2\n	Kit.Block(parent, \"LibraryDesk\", at(cx, y + 2.4, rect.z1 + 5), Vector3.new(22, 4.8, 4), { color = WHITE })\n	Kit.Block(parent, \"LibraryDeskTop\", at(cx, y + 5, rect.z1 + 5), Vector3.new(23.5, 0.5, 5.2), {\n		color = WALNUT,\n		material = Enum.Material.Wood,\n	})\n	for index = -1, 1, 2 do\n		Kit.Block(parent, `LibraryMonitor{index}`, at(cx + index * 5, y + 6.8, rect.z1 + 5.6), Vector3.new(4.4, 3, 0.3), {\n			color = Color3.fromRGB(30, 32, 40),\n		}).CastShadow = false\n		Kit.Block(parent, `LibraryMonitorStand{index}`, at(cx + index * 5, y + 5.4, rect.z1 + 5.6), Vector3.new(0.6, 1.4, 0.6), {\n			color = Color3.fromRGB(120, 126, 138),\n		}).CastShadow = false\n	end\n\n	-- Rectangular rugs down the aisles, not discs. The reference lays long blue mats between\n	-- the stacks, which is a different shape doing a different job: a disc decorates a spot, a\n	-- runner tells you which way the room is walked.\n	for index = 1, FIT.RugsPerCommonRoom do\n		Kit.Slab(\n			parent,\n			`LibraryRug{index}`,\n			at(rect.x1 + width * (index / (FIT.RugsPerCommonRoom + 1)), y + 0.35, rect.z1 + depth * 0.45),\n			14,\n			depth * 0.5,\n			0.25,\n			{ color = Color3.fromRGB(74, 128, 200), material = Enum.Material.Fabric, collide = false }\n		)\n	end\n\n	-- Low benches between the stacks to read on, and a planter at each end of the run.\n	for index = 1, 4 do\n		local bx = rect.x1 + width * ((index - 0.5) / 4)\n		Kit.Block(parent, `LibraryBench{index}`, at(bx, y + 2.2, rect.z1 + depth * 0.72), Vector3.new(11, 0.7, 3.4), {\n			color = Color3.fromRGB(206, 210, 218),\n			collide = true,\n		})\n		for leg = -1, 1, 2 do\n			Kit.Block(parent, `LibraryBenchLeg{index}_{leg}`, at(bx + leg * 4.4, y + 1.1, rect.z1 + depth * 0.72), Vector3.new(0.5, 2.2, 3), {\n				color = Color3.fromRGB(96, 102, 114),\n				material = Enum.Material.Metal,\n			}).CastShadow = false\n		end\n	end\n	-- Beside the desk, not in the aisles. The stacks are 16 deep and centred 14 studs in, so\n	-- anything past z1 + 6 is inside a bookshelf -- which is where these first landed.\n	for side = -1, 1, 2 do\n		Kit.Planter(parent, `LibraryPlanter{side}`, at(cx + side * 15, y + 0.2, rect.z1 + 3.5), 3.4, 10)\n	end\nend\n\nlocal function fitCooking(parent: Instance, at: (number, number, number) -> Vector3, rect: Rect, y: number)\n	local width = rect.x2 - rect.x1\n	-- Island benches with a sink and a mixer on each, which is the whole read of the room in\n	-- the reference: a grid of islands rather than rows of desks.\n	for index = 1, FIT.CookingBenches do\n		local column = (index - 1) % 3\n		local row = math.floor((index - 1) / 3)\n		local x = rect.x1 + width * ((column + 0.5) / 3)\n		local z = rect.z1 + 10 + row * 12\n		local tone = if column == 0 then Color3.fromRGB(150, 186, 178) elseif column == 1 then Color3.fromRGB(186, 166, 196) else Color3.fromRGB(146, 170, 200)\n		Kit.Block(parent, `Bench{index}`, at(x, y + 2.6, z), Vector3.new(14, 5.2, 6), { color = tone })\n		Kit.Block(parent, `BenchTop{index}`, at(x, y + 5.4, z), Vector3.new(14.4, 0.5, 6.4), { color = WOOD })\n		Kit.Block(parent, `Sink{index}`, at(x - 3, y + 5.6, z), Vector3.new(4, 0.4, 3), { color = Color3.fromRGB(206, 212, 216), material = Enum.Material.Metal })\n		Kit.Block(parent, `Mixer{index}`, at(x + 4, y + 6.6, z), Vector3.new(2, 2.6, 2), { color = WHITE })\n	end\n	-- Fridges down the wall.\n	for index = 1, 3 do\n		Kit.Block(parent, `Fridge{index}`, at(rect.x1 + 6 + (index - 1) * 8, y + 5, rect.z2 - 4), Vector3.new(6, 10, 4), { color = Color3.fromRGB(158, 198, 214) })\n	end\nend\n\nlocal function fitLounge(parent: Instance, at: (number, number, number) -> Vector3, rect: Rect, y: number)\n	local width = rect.x2 - rect.x1\n	local depth = rect.z2 - rect.z1\n	local cx, cz = rectCenter(rect)\n\n	-- Warm floor, because this is the one room in the school that is not tiled. It is the\n	-- fastest way to say \"you are allowed to relax here\" and it costs one part.\n	Kit.Slab(parent, \"LoungeFloor\", at(cx, y + 0.08, cz), width - 2, depth - 2, 0.3, {\n		color = Color3.fromRGB(216, 186, 162),\n		material = Enum.Material.WoodPlanks,\n	})\n\n	-- The pool table: the thing the reference room is built around. Bed, rails, pockets, cues\n	-- and a rack of balls -- worth the parts, because it is the single object that says this\n	-- is somewhere people spend a free period.\n	for table_ = 1, LOUNGE.PoolTables do\n		local px = cx\n		local pz = rect.z1 + depth * 0.34\n		Kit.Block(parent, `PoolBed{table_}`, at(px, y + 2.6, pz), Vector3.new(20, 0.6, 11), {\n			color = Color3.fromRGB(58, 132, 82),\n			material = Enum.Material.Fabric,\n		})\n		Kit.Block(parent, `PoolFrame{table_}`, at(px, y + 2.1, pz), Vector3.new(22, 1.6, 13), {\n			color = Color3.fromRGB(122, 78, 54),\n			material = Enum.Material.Wood,\n		})\n		for side = -1, 1, 2 do\n			Kit.Block(parent, `PoolLeg{table_}_{side}`, at(px + side * 7, y + 1.1, pz), Vector3.new(3.4, 2.2, 9), {\n				color = Color3.fromRGB(104, 66, 46),\n			})\n		end\n		-- The rack, and the cue ball apart from it.\n		local ballColors = {\n			Color3.fromRGB(226, 196, 74), Color3.fromRGB(62, 96, 186), Color3.fromRGB(206, 70, 62),\n			Color3.fromRGB(126, 82, 176), Color3.fromRGB(232, 138, 62), Color3.fromRGB(86, 160, 96),\n		}\n		for ball = 1, 6 do\n			local row = math.floor((ball - 1) / 3)\n			local column = (ball - 1) % 3\n			Kit.Block(parent, `PoolBall{ball}`, at(px + 5 + row * 1.1, y + 3.2, pz - 1.2 + column * 1.2), Vector3.new(0.9, 0.9, 0.9), {\n				color = ballColors[ball],\n			}).CastShadow = false\n		end\n		Kit.Block(parent, `PoolCue{table_}`, at(px - 3, y + 3.1, pz), Vector3.new(13, 0.24, 0.24), {\n			color = Color3.fromRGB(196, 156, 108),\n		}).CastShadow = false\n	end\n\n	-- The screen on the wall.\n	local screen = Kit.Block(parent, \"LoungeScreen\", at(rect.x2 - 3, y + 11, cz), Vector3.new(0.5, LOUNGE.ScreenHeightStuds, LOUNGE.ScreenWidthStuds), {\n		color = Color3.fromRGB(20, 22, 28),\n	})\n	screen.CastShadow = false\n	Kit.Block(parent, \"LoungeScreenFrame\", at(rect.x2 - 3.3, y + 11, cz), Vector3.new(0.3, LOUNGE.ScreenHeightStuds + 1.2, LOUNGE.ScreenWidthStuds + 1.2), {\n		color = Color3.fromRGB(52, 56, 66),\n	}).CastShadow = false\n\n	-- **The room splits front to back, at a line rather than by luck.**\n	--\n	-- Soft seating at the back facing the screen, dining at the front by the door. These were\n	-- two independent runs -- sofas walking forward from the back wall, tables walking back from\n	-- the front -- which met in the middle the moment the room stopped being 99 studs deep, and\n	-- left a coffee table standing inside a sofa. A split line makes that impossible instead of\n	-- unlikely.\n	local depth = rect.z2 - rect.z1\n	local splitZ = rect.z1 + depth * 0.46\n\n	local sofaRows = math.ceil(LOUNGE.Sofas / 2)\n	local sofaPitch = (rect.z2 - 8 - (splitZ + 4)) / math.max(1, sofaRows)\n	for index = 1, LOUNGE.Sofas do\n		local x = rect.x1 + width * (((index - 1) % 2 + 0.5) / 2)\n		local z = rect.z2 - 8 - sofaPitch * (math.floor((index - 1) / 2) + 0.5)\n		Kit.Block(parent, `LoungeSofa{index}`, at(x, y + 1.9, z), Vector3.new(11, 3.8, 5), {\n			color = Color3.fromRGB(118, 132, 190),\n			material = Enum.Material.Fabric,\n		})\n		Kit.Block(parent, `LoungeSofaBack{index}`, at(x, y + 4.2, z + 2.2), Vector3.new(11, 4.6, 1.2), {\n			color = Color3.fromRGB(104, 118, 176),\n			material = Enum.Material.Fabric,\n		})\n	end\n\n	local diningRows = math.ceil(LOUNGE.DiningTables / 3)\n	local diningPitch = (splitZ - 3 - (rect.z1 + 6)) / math.max(1, diningRows)\n	for index = 1, LOUNGE.DiningTables do\n		local x = rect.x1 + width * (((index - 1) % 3 + 0.5) / 3)\n		local z = rect.z1 + 6 + diningPitch * (math.floor((index - 1) / 3) + 0.5)\n		Kit.Block(parent, `LoungeTable{index}`, at(x, y + 3, z), Vector3.new(8, 0.4, 5), { color = Color3.fromRGB(150, 110, 72) })\n		Kit.Block(parent, `LoungeTableLeg{index}`, at(x, y + 1.5, z), Vector3.new(1, 3, 1), { color = Color3.fromRGB(96, 72, 52) })\n		for seat = -1, 1, 2 do\n			Kit.Block(parent, `LoungeChair{index}_{seat}`, at(x + seat * 5, y + 1.8, z), Vector3.new(2.6, 0.4, 2.6), {\n				color = Color3.fromRGB(96, 124, 186),\n			})\n		end\n	end\n\n	for index = 1, LOUNGE.Rugs do\n		Kit.Rug(parent, `LoungeRug{index}`, at(rect.x1 + width * (index / (LOUNGE.Rugs + 1)), y + 0.4, cz + 6), 7, Color3.fromRGB(150, 178, 220))\n	end\n	-- Planters along the back wall, but skipping the middle third -- that is where the vending\n	-- pair stands, and two of these were landing inside the machines.\n	for index = 1, LOUNGE.Planters do\n		local share = index / (LOUNGE.Planters + 1)\n		if share > 0.34 and share < 0.66 then\n			continue\n		end\n		Kit.Planter(parent, `LoungePlanter{index}`, at(rect.x1 + width * share, y + 0.2, rect.z2 - 3), 3, 9)\n	end\n\n	-- And the machines, against the back wall where the reference has them.\n	buildVendingPair(parent, \"LoungeVending\", at, cx, y + 0.2, rect.z2 - 4, 180)\nend\n\nlocal function fitCommon(parent: Instance, at: (number, number, number) -> Vector3, rect: Rect, y: number)\n	local width = rect.x2 - rect.x1\n	for index = 1, FIT.RugsPerCommonRoom do\n		Kit.Rug(parent, `{rect.id}Rug{index}`, at(rect.x1 + width * (index / (FIT.RugsPerCommonRoom + 1)), y + 0.35, (rect.z1 + rect.z2) / 2), 7, PALE_BLUE)\n	end\n	for index = 1, FIT.PlantersPerCommonRoom do\n		Kit.Planter(parent, `{rect.id}Planter{index}`, at(rect.x1 + width * (index / (FIT.PlantersPerCommonRoom + 1)), y + 0.2, rect.z2 - 4), 3, 9)\n	end\n	for index = 1, 4 do\n		Kit.Block(parent, `{rect.id}Sofa{index}`, at(rect.x1 + width * (index / 5), y + 1.8, rect.z1 + 8), Vector3.new(10, 3.6, 5), { color = Color3.fromRGB(92, 98, 116) })\n	end\nend\n\n-- ============================================================ the three taught rooms\n--\n-- Science, Art and Reading were left bare at bake time because Lab.luau, Studio.luau and\n-- ReadingRoom.luau build their stations into them. What that missed is that those modules run\n-- at *play* time and build non-collidable placeholders into a Folder -- so in Studio, and for\n-- the whole time anyone is looking at the school rather than playing it, the three rooms are\n-- empty boxes with trim on the walls.\n--\n-- The split these fitters keep: **the perimeter is architecture and is baked, the middle is\n-- mechanics and stays clear.** Every room anchor sits at the room centre, so nothing here goes\n-- within about nine studs of it; the benches, cupboards and boards run round the walls where a\n-- real room puts them anyway.\n\nlocal function labBenchRun(parent, at, id: string, x: number, z1: number, z2: number, y: number, sinks: boolean)\n	local len = z2 - z1\n	Kit.Block(parent, `{id}Bench`, at(x, y + 2.6, (z1 + z2) / 2), Vector3.new(5, 0.5, len), {\n		color = Color3.fromRGB(58, 62, 72),\n		collide = true,\n	})\n	Kit.Block(parent, `{id}Cup`, at(x, y + 1.3, (z1 + z2) / 2), Vector3.new(4.6, 2.6, len - 1), {\n		color = OFF_WHITE,\n	})\n	local units = math.max(2, math.floor(len / 9))\n	for i = 1, units - 1 do\n		Kit.Block(parent, `{id}Seam{i}`, at(x - 2.4, y + 1.3, z1 + len * (i / units)), Vector3.new(0.2, 2.4, 0.25), {\n			color = Color3.fromRGB(176, 182, 194),\n		}).CastShadow = false\n	end\n	-- Stools facing the bench. A bench nobody can sit at is a counter, and the difference\n	-- between a lab and a storeroom is entirely whether the room looks like people work in it.\n	-- `face` is which way the room is from the bench, so the stools stand in front of it.\n	local face = if x < 0 then 1 else -1\n	for i = 1, units do\n		local sz = z1 + len * ((i - 0.5) / units)\n		Kit.Block(parent, `{id}Stool{i}`, at(x + face * 4.6, y + 2.1, sz), Vector3.new(2.6, 0.4, 2.6), {\n			color = DEEP_BLUE,\n			collide = true,\n		}).CastShadow = false\n		Kit.Block(parent, `{id}StoolLeg{i}`, at(x + face * 4.6, y + 1, sz), Vector3.new(0.5, 2.2, 0.5), {\n			color = Color3.fromRGB(96, 102, 114),\n			material = Enum.Material.Metal,\n		}).CastShadow = false\n	end\n\n	if sinks then\n		local bowls = math.max(1, math.floor(units / 2))\n		for i = 1, bowls do\n			local sz = z1 + len * ((i - 0.5) / bowls)\n			Kit.Block(parent, `{id}Sink{i}`, at(x, y + 2.75, sz), Vector3.new(3.4, 0.5, 3), {\n				color = Color3.fromRGB(214, 220, 230),\n			}).CastShadow = false\n			Kit.Block(parent, `{id}Tap{i}`, at(x + 1.4, y + 3.6, sz), Vector3.new(0.35, 1.7, 0.35), {\n				color = Color3.fromRGB(198, 204, 214),\n				material = Enum.Material.Metal,\n			}).CastShadow = false\n		end\n	end\nend\n\nlocal function fitScience(parent: Instance, at: (number, number, number) -> Vector3, rect: Rect, y: number)\n	local cx = (rect.x1 + rect.x2) / 2\n	labBenchRun(parent, at, \"SciL\", rect.x1 + 3.2, rect.z1 + 10, rect.z2 - 12, y, true)\n	labBenchRun(parent, at, \"SciR\", rect.x2 - 3.2, rect.z1 + 10, rect.z2 - 12, y, true)\n\n	-- The fume cupboard: the one tall object in the room, which is what stops a lab reading as\n	-- a room full of waist-high slabs.\n	Kit.Block(parent, \"SciFume\", at(rect.x1 + 6, y + 6, rect.z2 - 5), Vector3.new(9, 12, 4), {\n		color = Color3.fromRGB(212, 218, 228),\n		collide = true,\n	})\n	Kit.Block(parent, \"SciFumeGlass\", at(rect.x1 + 6, y + 7.5, rect.z2 - 7.1), Vector3.new(8, 6, 0.3), {\n		color = GLASS_TINT,\n		material = Enum.Material.Glass,\n		transparency = 0.5,\n	}).CastShadow = false\n	Kit.Block(parent, \"SciFumeDuct\", at(rect.x1 + 6, y + 16, rect.z2 - 5), Vector3.new(2.4, 8, 2.4), {\n		color = Color3.fromRGB(176, 182, 194),\n		material = Enum.Material.Metal,\n	}).CastShadow = false\n\n	-- Charts and safety kit on the back wall. A lab with nothing on its walls reads as a room\n	-- that happens to have tables in it.\n	for i = 1, 3 do\n		Kit.Block(parent, `SciChart{i}`, at(rect.x2 - 5 - (i - 1) * 8, y + 13, rect.z2 - 1.5), Vector3.new(7, 9, 0.3), {\n			color = if i == 2 then PALE_BLUE else Color3.fromRGB(236, 240, 248),\n		}).CastShadow = false\n	end\n	Kit.Block(parent, \"SciEyewash\", at(rect.x2 - 3.4, y + 7.5, rect.z1 + 7), Vector3.new(2.6, 3, 2.6), {\n		color = Color3.fromRGB(64, 176, 92),\n	}).CastShadow = false\n	Kit.Block(parent, \"SciSafety\", at(cx, y + 19, rect.z2 - 1.5), Vector3.new(6, 4, 0.3), {\n		color = Color3.fromRGB(214, 64, 58),\n	}).CastShadow = false\nend\n\nlocal function fitArt(parent: Instance, at: (number, number, number) -> Vector3, rect: Rect, y: number)\n	local cx = (rect.x1 + rect.x2) / 2\n	local cz = (rect.z1 + rect.z2) / 2\n	labBenchRun(parent, at, \"ArtL\", rect.x1 + 3.2, rect.z1 + 10, rect.z2 - 10, y, true)\n\n	-- The drying rack down the other side, with work on it. Paint on a rack is the detail that\n	-- says the room gets used, and it costs one part per shelf.\n	Kit.Block(parent, \"ArtRack\", at(rect.x2 - 3.4, y + 7, cz), Vector3.new(5, 14, 34), {\n		color = WALNUT,\n		material = Enum.Material.Wood,\n		collide = true,\n	})\n	local SWATCH = {\n		Color3.fromRGB(212, 96, 84),\n		PALE_BLUE,\n		Color3.fromRGB(238, 198, 92),\n		Color3.fromRGB(120, 176, 118),\n		Color3.fromRGB(196, 140, 200),\n		OFF_WHITE,\n	}\n	for i = 1, 6 do\n		Kit.Block(parent, `ArtRackShelf{i}`, at(rect.x2 - 3.4, y + 1.6 + i * 2, cz), Vector3.new(5.3, 0.3, 32), {\n			color = Color3.fromRGB(206, 212, 222),\n		}).CastShadow = false\n		Kit.Block(parent, `ArtWork{i}`, at(rect.x2 - 3.6, y + 2.3 + i * 2, cz - 13 + i * 4.4), Vector3.new(4, 0.15, 3.4), {\n			color = SWATCH[i],\n		}).CastShadow = false\n	end\n\n	-- A pinboard of finished work along the back.\n	Kit.Block(parent, \"ArtBoard\", at(cx, y + 12, rect.z2 - 1.5), Vector3.new(24, 13, 0.4), {\n		color = Color3.fromRGB(148, 116, 88),\n		material = Enum.Material.Fabric,\n	}).CastShadow = false\n	local PIN = { OFF_WHITE, PALE_BLUE, Color3.fromRGB(238, 214, 168), Color3.fromRGB(206, 216, 232) }\n	for i = 1, 8 do\n		local col = (i - 1) % 4\n		local row = math.floor((i - 1) / 4)\n		Kit.Block(parent, `ArtPinned{i}`, at(cx - 9 + col * 6, y + 15 - row * 5.4, rect.z2 - 1.75), Vector3.new(4.6, 4.2, 0.2), {\n			color = PIN[col + 1],\n		}).CastShadow = false\n	end\nend\n\nlocal function fitReading(parent: Instance, at: (number, number, number) -> Vector3, rect: Rect, y: number)\n	local cx = (rect.x1 + rect.x2) / 2\n	local cz = (rect.z1 + rect.z2) / 2\n	local SPINE = {\n		DEEP_BLUE,\n		Color3.fromRGB(168, 88, 74),\n		Color3.fromRGB(96, 132, 96),\n		Color3.fromRGB(196, 158, 88),\n		Color3.fromRGB(112, 104, 148),\n	}\n\n	-- Low shelves down both sides. Low, because a room lined with tall stacks is a library --\n	-- the point of this one is that you can see across it from the door.\n	-- `face` is which way the shelf opens: the left run faces into the room (+x), the right run\n	-- faces back across it (-x). Without it the boards and the books are laid on the carcass\n	-- centreline, which puts them inside the shelf rather than on it.\n	for _, run in { { n = \"L\", x = rect.x1 + 2.8, face = 1 }, { n = \"R\", x = rect.x2 - 2.8, face = -1 } } do\n		local z1, z2 = rect.z1 + 10, rect.z2 - 10\n		local len = z2 - z1\n		-- A back panel and a top, not a solid box. A shelf modelled as one block has its boards\n		-- and its books buried inside it -- physically what a real carcass does, and useless\n		-- here, because everything that makes it read as a bookshelf ends up hidden in the wood.\n		Kit.Block(parent, `ReadShelfBack{run.n}`, at(run.x - run.face * 1.6, y + 4, (z1 + z2) / 2), Vector3.new(0.9, 8, len), {\n			color = WALNUT,\n			material = Enum.Material.Wood,\n			collide = true,\n		})\n		Kit.Block(parent, `ReadShelfTop{run.n}`, at(run.x, y + 8.2, (z1 + z2) / 2), Vector3.new(4, 0.5, len), {\n			color = WALNUT,\n			material = Enum.Material.Wood,\n		}).CastShadow = false\n		for tier = 1, 3 do\n			Kit.Block(parent, `ReadTier{run.n}{tier}`, at(run.x, y + tier * 2.4, (z1 + z2) / 2), Vector3.new(3.2, 0.3, len - 0.6), {\n				color = Color3.fromRGB(212, 218, 228),\n			}).CastShadow = false\n		end\n		local bays = math.max(3, math.floor(len / 7))\n		for i = 1, bays do\n			for tier = 1, 3 do\n				Kit.Block(parent, `ReadBooks{run.n}{i}_{tier}`, at(run.x + run.face * 0.2, y + tier * 2.4 + 1.1, z1 + len * ((i - 0.5) / bays)), Vector3.new(2.4, 1.9, 5), {\n					color = SPINE[(i + tier) % 5 + 1],\n				}).CastShadow = false\n			end\n		end\n	end\n\n	-- Armchairs at the four corners with a lamp beside each. This room's whole reason to exist\n	-- is that it is somewhere a player would choose to sit, and four corners is what makes it\n	-- read as seating rather than as furniture in storage.\n	for _, corner in { { sx = -1, sz = -1 }, { sx = 1, sz = -1 }, { sx = -1, sz = 1 }, { sx = 1, sz = 1 } } do\n		local ax = cx + corner.sx * 10\n		local az = cz + corner.sz * 28\n		local tag = `{if corner.sx < 0 then \"L\" else \"R\"}{if corner.sz < 0 then \"F\" else \"B\"}`\n		Kit.Block(parent, `ReadChair{tag}`, at(ax, y + 1.8, az), Vector3.new(6, 3.6, 6), {\n			color = Color3.fromRGB(118, 132, 190),\n			material = Enum.Material.Fabric,\n			collide = true,\n		})\n		Kit.Block(parent, `ReadChairBack{tag}`, at(ax, y + 4.4, az + corner.sz * 2.6), Vector3.new(6, 5.2, 1.2), {\n			color = Color3.fromRGB(104, 118, 176),\n			material = Enum.Material.Fabric,\n		}).CastShadow = false\n		Kit.Block(parent, `ReadLamp{tag}`, at(ax + corner.sx * 4.6, y + 4, az), Vector3.new(0.4, 8, 0.4), {\n			color = Color3.fromRGB(72, 76, 86),\n			material = Enum.Material.Metal,\n		}).CastShadow = false\n		Kit.Block(parent, `ReadShade{tag}`, at(ax + corner.sx * 4.6, y + 8.4, az), Vector3.new(3, 2.2, 3), {\n			color = Color3.fromRGB(248, 240, 214),\n			material = Enum.Material.Neon,\n		}).CastShadow = false\n	end\nend\n\n-- Wall trim: skirting, a dado rail with a panelled band under it, a picture rail near the\n-- ceiling, and beams across it.\n--\n-- **This is the highest-value detail in the building per part spent, and the reason is scale\n-- rather than decoration.** A room 27 studs floor-to-ceiling has about 15 studs of wall above\n-- head height, and painted flat white that reads as a wall with nothing on it however much\n-- furniture is standing on the floor. The eye has nothing to measure the height against, so a\n-- tall room looks like a small room that has been stretched.\n--\n-- Three horizontal lines fix that, because each one is a known height: a skirting is ankle\n-- high, a dado is hip high, a picture rail is above a door. Give a wall those and it announces\n-- its own size. The panelled band between skirting and dado is the classic school corridor\n-- treatment and costs one part per wall.\n--\n-- Beams do the same job for the ceiling, which is the other surface a tall room has too much\n-- of, and they give the ceiling lights something to sit against.\nlocal function dressWalls(parent: Instance, at: (number, number, number) -> Vector3, id: string, x1: number, x2: number, z1: number, z2: number, y: number, height: number)\n	local width = x2 - x1\n	local depth = z2 - z1\n	local DADO = 4.6\n	local RAIL_Y = math.min(height - 4, DOOR_H + 12)\n	local TRIM = Color3.fromRGB(232, 236, 244)\n	local PANEL = Color3.fromRGB(206, 214, 228)\n	local BEAM = Color3.fromRGB(222, 226, 234)\n\n	-- The two long walls, and the back wall.\n	local runs = {\n		{ n = \"L\", cx = x1 + 0.5, cz = (z1 + z2) / 2, len = depth, along = true },\n		{ n = \"R\", cx = x2 - 0.5, cz = (z1 + z2) / 2, len = depth, along = true },\n		{ n = \"B\", cx = (x1 + x2) / 2, cz = z2 - 0.5, len = width, along = false },\n	}\n	for _, r in runs do\n		local sz = function(t: number, h: number)\n			return if r.along then Vector3.new(t, h, r.len) else Vector3.new(r.len, h, t)\n		end\n		-- Panelled band from floor to dado, slightly proud of the wall so it casts a line.\n		Kit.Block(parent, `{id}Panel{r.n}`, at(r.cx, y + DADO / 2, r.cz), sz(0.5, DADO), {\n			color = PANEL,\n		}).CastShadow = false\n		-- Skirting at the foot and the dado rail on top of the band. Both stand further out\n		-- than the panel, which is what actually draws the shadow line.\n		Kit.Block(parent, `{id}Skirt{r.n}`, at(r.cx, y + 0.45, r.cz), sz(0.9, 0.9), {\n			color = TRIM,\n		}).CastShadow = false\n		Kit.Block(parent, `{id}Dado{r.n}`, at(r.cx, y + DADO, r.cz), sz(1, 0.7), {\n			color = TRIM,\n		}).CastShadow = false\n		-- Picture rail, up where the blank wall was.\n		Kit.Block(parent, `{id}Rail{r.n}`, at(r.cx, y + RAIL_Y, r.cz), sz(0.8, 0.55), {\n			color = TRIM,\n		}).CastShadow = false\n	end\n\n	-- Ceiling beams across the short dimension, spaced so each reads as its own bay.\n	local bays = math.max(2, math.floor(depth / 18))\n	for bay = 1, bays - 1 do\n		Kit.Block(parent, `{id}Beam{bay}`, at((x1 + x2) / 2, y + height - 1, z1 + depth * (bay / bays)), Vector3.new(width - 1.5, 1.6, 1.6), {\n			color = BEAM,\n		}).CastShadow = false\n	end\nend\n\nlocal function buildRooms(parent: Instance, at: (number, number, number) -> Vector3): { [string]: Vector3 }\n	local anchors: { [string]: Vector3 } = {}\n\n	for _, rect in ROOMS do\n		local y = floorY(rect.floor)\n		local cx, cz = rectCenter(rect)\n		local width = rect.x2 - rect.x1\n		local depth = rect.z2 - rect.z1\n\n		-- The two partitions that make it a room. The wall onto the corridor is glazed, which\n		-- is the single thing that stops an upper floor being a row of closed doors -- you can\n		-- see the lesson you are late for.\n		Kit.Wall(parent, `{rect.id}Left`, at(rect.x1, y, rect.z1), at(rect.x1, y, rect.z2), FLOOR_H - SLAB, WALL_T, { color = WHITE })\n		Kit.Wall(parent, `{rect.id}Right`, at(rect.x2, y, rect.z1), at(rect.x2, y, rect.z2), FLOOR_H - SLAB, WALL_T, { color = WHITE })\n		Kit.GlassWall(parent, `{rect.id}Front`, at(rect.x1 + 14, y, rect.z1), at(rect.x2, y, rect.z1), FLOOR_H - SLAB, WALL_T, 0.7, WHITE, GLASS_TINT)\n\n		-- The doorway, and a door in it.\n		--\n		-- It was an open gap, on the reasoning that a swinging door in a corridor a class\n		-- empties into is a thing to get stuck on. That reasoning is still right about *swinging*\n		-- -- so this does not swing. It is a glazed leaf in a frame, non-collidable, which reads\n		-- as a door from both sides and cannot trap anybody. A room you enter through a hole in\n		-- a wall reads as unfinished however good the room is.\n		Kit.Block(parent, `{rect.id}DoorFrame`, at(rect.x1 + 14, y + (FLOOR_H - SLAB) / 2, rect.z1), Vector3.new(0.8, FLOOR_H - SLAB, 1.4), { color = BLUE })\n		Kit.Block(parent, `{rect.id}DoorJamb`, at(rect.x1, y + (FLOOR_H - SLAB) / 2, rect.z1), Vector3.new(0.8, FLOOR_H - SLAB, 1.4), { color = BLUE })\n		Kit.Block(parent, `{rect.id}DoorHead`, at(rect.x1 + 7, y + DOOR_H, rect.z1), Vector3.new(14, 1.2, 1.4), { color = BLUE })\n		-- **A door that shuts.**\n		--\n		-- This was a non-collidable glazed leaf, on the reasoning that a swinging door in a\n		-- corridor a class empties into is something to get stuck on. That was the right worry\n		-- and the wrong answer: a leaf you walk through is not a door, it is a picture of one,\n		-- and the building was full of rooms you entered through a hole.\n		--\n		-- So it is solid and it swings. The stuck-in-the-doorway problem is handled by the swing\n		-- direction instead -- every room door opens *into its room*, away from the corridor, so\n		-- an opening leaf never sweeps the circulation route. Named `{id}DoorLeaf` because\n		-- FixtureService finds doors by name; see the PATTERNS note there.\n		Kit.Block(parent, `{rect.id}DoorLeaf`, at(rect.x1 + 7, y + DOOR_H / 2, rect.z1), Vector3.new(13.2, DOOR_H, 0.5), {\n			color = WALNUT,\n			material = Enum.Material.WoodPlanks,\n			collide = true,\n		})\n		-- A vision panel. Every school door has one, and it is what stops a corridor of shut\n		-- doors reading as a corridor of walls.\n		Kit.Block(parent, `{rect.id}DoorVision`, at(rect.x1 + 7, y + DOOR_H * 0.68, rect.z1), Vector3.new(4.6, DOOR_H * 0.34, 0.3), {\n			color = GLASS_TINT,\n			material = Enum.Material.Glass,\n			transparency = 0.4,\n		}).CastShadow = false\n		-- The push bar, which is what makes a glass panel read as a door rather than a window.\n		Kit.Block(parent, `{rect.id}DoorBar`, at(rect.x1 + 7, y + DOOR_H * 0.45, rect.z1 - 0.4), Vector3.new(7, 0.5, 0.5), {\n			color = Color3.fromRGB(206, 212, 222),\n			material = Enum.Material.Metal,\n		}).CastShadow = false\n\n		-- The sign over the door, which is how a player finds a subject at all.\n		-- The sign over each door, on a coloured band.\n		--\n		-- The reference names every room over its doorway -- TEACHER'S LOUNGE, PRINCIPAL'S OFFICE --\n		-- and that is most of why the hall reads as a school rather than as a corridor of identical\n		-- glass fronts. Ours had a plain white plate two thirds the width; on a band, wider, and\n		-- with the school's blue behind it, it can be read from the far end.\n		Kit.Block(parent, `{rect.id}SignBand`, at(rect.x1 + 7, y + DOOR_H + 2.4, rect.z1 - 1), Vector3.new(20, 4.4, 0.3), {\n			color = BLUE,\n		}).CastShadow = false\n		local plate = Kit.Block(parent, `{rect.id}Plate`, at(rect.x1 + 7, y + DOOR_H + 2.4, rect.z1 - 1.2), Vector3.new(18, 3, 0.4), { color = WHITE })\n		Kit.Sign(plate, string.upper(rect.label), 12, LABEL_DIST, DEEP_BLUE)\n\n		dressWalls(parent, at, rect.id, rect.x1, rect.x2, rect.z1, rect.z2, y, FLOOR_H - SLAB)\n\n		-- Lights on a grid.\n		for ax = 1, FIT.LightsAcross do\n			for az = 1, FIT.LightsAlong do\n				Kit.LightPanel(\n					parent,\n					`{rect.id}Light{ax}_{az}`,\n					at(rect.x1 + width * ((ax - 0.5) / FIT.LightsAcross), y + FLOOR_H - SLAB - 0.6, rect.z1 + depth * ((az - 0.5) / FIT.LightsAlong)),\n					7,\n					2\n				)\n			end\n		end\n\n		if rect.kind == \"science\" then\n			fitScience(parent, at, rect, y)\n		elseif rect.kind == \"art\" then\n			fitArt(parent, at, rect, y)\n		elseif rect.kind == \"reading\" then\n			fitReading(parent, at, rect, y)\n		elseif rect.kind == \"class\" then\n			fitClassroom(parent, at, rect, y)\n		elseif rect.kind == \"cafeteria\" then\n			fitCafeteria(parent, at, rect, y)\n		elseif rect.kind == \"library\" then\n			fitLibrary(parent, at, rect, y)\n		elseif rect.kind == \"cooking\" then\n			fitCooking(parent, at, rect, y)\n		elseif rect.kind == \"lounge\" then\n			fitLounge(parent, at, rect, y)\n		elseif rect.kind == \"common\" then\n			fitCommon(parent, at, rect, y)\n		end\n\n		-- The anchor the verbs hang off. Set back from the door so a bench laid on it has the\n		-- room around it rather than the doorway.\n		anchors[rect.id] = at(cx, y, cz)\n	end\n\n	return anchors\nend\n\n-- ---------------------------------------------------------------------------------------\n-- The aquatic centre, attached on the left.\n-- ---------------------------------------------------------------------------------------\n\nlocal function buildPool(parent: Instance, at: (number, number, number) -> Vector3): Vector3\n	local half = W / 2\n	-- Butted against the left elevation, so the two buildings share a wall line rather than\n	-- standing as separate sheds with a gap between them.\n	local x0 = -half - POOL.HallWidthStuds\n	local x1 = -half\n	local cx = (x0 + x1) / 2\n	local cz = POOL.HallDepthStuds / 2\n	local hallH = FLOOR_H * 2\n\n	Kit.Slab(parent, \"PoolFloor\", at(cx, 0.4, cz), POOL.HallWidthStuds, POOL.HallDepthStuds, 0.6, { color = TILE })\n	Kit.Wall(parent, \"PoolBack\", at(x0, 0.4, POOL.HallDepthStuds), at(x1, 0.4, POOL.HallDepthStuds), hallH, WALL_T, { color = WHITE })\n	Kit.Wall(parent, \"PoolEnd\", at(x0, 0.4, 0), at(x0, 0.4, POOL.HallDepthStuds), hallH, WALL_T, { color = WHITE })\n	Kit.GlassWall(parent, \"PoolFront\", at(x0, 0.4, 0), at(x1, 0.4, 0), hallH, WALL_T, 0.72, WHITE, GLASS_TINT)\n\n	-- The name across the front, which is what makes it an aquatic centre from the road.\n	local band = Kit.Block(parent, \"PoolBand\", at(cx, 6, -0.8), Vector3.new(POOL.HallWidthStuds, 5, 1), { color = BLUE })\n	Kit.Sign(band, \"AGES AQUATIC CENTER\", POOL.HallWidthStuds * 0.6, LABEL_DIST * 2.5, WHITE)\n\n	-- The barrel roof. Each rib is a flat panel turned a little further than the last, which\n	-- approximates an arch closely enough at this scale and costs one part per rib -- a real\n	-- curved mesh would be an asset dependency, and the kit deliberately has none.\n	local riseY = 0.4 + hallH\n	for rib = 1, POOL.RoofRibs do\n		local share = (rib - 0.5) / POOL.RoofRibs\n		local angle = math.pi * share\n		local ribX = cx + math.cos(angle) * (POOL.HallWidthStuds / 2)\n		local ribY = riseY + math.sin(angle) * POOL.RoofRiseStuds\n		local panel = Kit.Block(parent, `PoolRib{rib}`, at(ribX, ribY, cz), Vector3.new(POOL.HallWidthStuds / POOL.RoofRibs + 1.5, 0.5, POOL.HallDepthStuds), {\n			color = GLASS_TINT,\n			material = Enum.Material.Glass,\n			transparency = 0.45,\n			collide = true,\n		})\n		panel.CastShadow = false\n		-- The steel between the panes.\n		Kit.Block(parent, `PoolRibArch{rib}`, at(ribX, ribY, cz), Vector3.new(0.7, 0.9, POOL.HallDepthStuds), {\n			color = OFF_WHITE,\n			material = Enum.Material.Metal,\n		})\n	end\n\n	-- The tank, sunk into the floor: a hole in the slab is not possible, so the water sits in\n	-- a box whose walls are the coping and whose bottom is the tiled floor of the pool.\n	local wx = cx\n	local wz = cz\n	local wHalfW = POOL.WaterWidthStuds / 2\n	local wHalfD = POOL.WaterDepthStuds / 2\n	local depthBelow = POOL.WaterDepthBelowStuds\n\n	Kit.Slab(parent, \"PoolBottom\", at(wx, 0.4 - depthBelow, wz), POOL.WaterWidthStuds, POOL.WaterDepthStuds, 0.5, { color = PALE_BLUE })\n	for side = -1, 1, 2 do\n		Kit.Wall(parent, `PoolWallX{side}`, at(wx + side * wHalfW, 0.4 - depthBelow, wz - wHalfD), at(wx + side * wHalfW, 0.4 - depthBelow, wz + wHalfD), depthBelow, 0.8, { color = WHITE })\n		Kit.Wall(parent, `PoolWallZ{side}`, at(wx - wHalfW, 0.4 - depthBelow, wz + side * wHalfD), at(wx + wHalfW, 0.4 - depthBelow, wz + side * wHalfD), depthBelow, 0.8, { color = WHITE })\n	end\n\n	-- Lane markings on the bottom, then the water over them.\n	for lane = 1, POOL.Lanes - 1 do\n		local z = wz - wHalfD + POOL.WaterDepthStuds * (lane / POOL.Lanes)\n		Kit.Slab(parent, `PoolLane{lane}`, at(wx, 0.4 - depthBelow + 0.5, z), POOL.WaterWidthStuds - 2, 0.8, 0.2, { color = DEEP_BLUE, collide = false })\n	end\n\n	local water = Kit.Block(parent, \"PoolWater\", at(wx, 0.4 - depthBelow / 2, wz), Vector3.new(POOL.WaterWidthStuds, depthBelow - 0.6, POOL.WaterDepthStuds), {\n		color = WATER,\n		material = Enum.Material.Glass,\n		transparency = 0.35,\n		reflectance = 0.1,\n	})\n	water.CastShadow = false\n\n	-- Coping round the tank, so the edge reads as a lip rather than as water meeting tile.\n	for side = -1, 1, 2 do\n		Kit.Slab(parent, `Coping{side}`, at(wx + side * (wHalfW + 1.5), 0.7, wz), 3, POOL.WaterDepthStuds + 6, 0.5, { color = WHITE })\n		Kit.Slab(parent, `CopingZ{side}`, at(wx, 0.7, wz + side * (wHalfD + 1.5)), POOL.WaterWidthStuds + 6, 3, 0.5, { color = WHITE })\n	end\n\n	-- Spectator benches, a lifeguard chair and a diving board -- the three things that make a\n	-- pool hall read as a pool hall rather than as a flooded room.\n	for row = 1, POOL.BenchRows do\n		Kit.Block(parent, `PoolBench{row}`, at(wx, 0.4 + row * 1.6, wz + wHalfD + 8 + row * 3), Vector3.new(POOL.WaterWidthStuds * 0.7, 1.4, 3), { color = OFF_WHITE })\n	end\n	Kit.Block(parent, \"Lifeguard\", at(wx + wHalfW + 6, 5, wz), Vector3.new(3.4, 10, 3.4), { color = WOOD })\n	Kit.Block(parent, \"LifeguardSeat\", at(wx + wHalfW + 6, 10.4, wz), Vector3.new(4.4, 0.6, 4.4), { color = WHITE })\n	Kit.Block(parent, \"DivingBoard\", at(wx - wHalfW + 6, 8, wz - wHalfD - 3), Vector3.new(12, 0.5, 3), { color = WHITE })\n	Kit.Block(parent, \"DivingTower\", at(wx - wHalfW - 1, 4, wz - wHalfD - 3), Vector3.new(4, 8, 4), { color = CONCRETE })\n\n	for index = 1, 8 do\n		Kit.LightPanel(parent, `PoolLight{index}`, at(x0 + POOL.HallWidthStuds * ((index - 0.5) / 8), 0.4 + hallH - 1, cz), 9, 3)\n	end\n\n	return at(wx, 0.4, wz + wHalfD + 10)\nend\n\n-- ---------------------------------------------------------------------------------------\n-- The gym, attached on the right.\n-- ---------------------------------------------------------------------------------------\n\nlocal function buildGym(parent: Instance, at: (number, number, number) -> Vector3): Vector3\n	local half = W / 2\n	local x0 = half\n	local x1 = half + GYM.WidthStuds\n	local cx = (x0 + x1) / 2\n	local cz = GYM.DepthStuds / 2\n\n	Kit.Slab(parent, \"GymFloor\", at(cx, 0.4, cz), GYM.WidthStuds, GYM.DepthStuds, 0.6, { color = WOOD })\n	Kit.Wall(parent, \"GymBack\", at(x0, 0.4, GYM.DepthStuds), at(x1, 0.4, GYM.DepthStuds), GYM.HeightStuds, WALL_T, { color = WHITE })\n	Kit.Wall(parent, \"GymEnd\", at(x1, 0.4, 0), at(x1, 0.4, GYM.DepthStuds), GYM.HeightStuds, WALL_T, { color = WHITE })\n	Kit.GlassWall(parent, \"GymFront\", at(x0, 0.4, 0), at(x1, 0.4, 0), GYM.HeightStuds, WALL_T, 0.55, WHITE, GLASS_TINT)\n	Kit.Slab(parent, \"GymRoof\", at(cx, 0.4 + GYM.HeightStuds, cz), GYM.WidthStuds, GYM.DepthStuds, 1.4, { color = OFF_WHITE })\n\n	local band = Kit.Block(parent, \"GymBand\", at(cx, 6, -0.8), Vector3.new(GYM.WidthStuds, 5, 1), { color = DEEP_BLUE })\n	Kit.Sign(band, \"GYMNASIUM\", GYM.WidthStuds * 0.55, LABEL_DIST * 2.5, WHITE)\n\n	-- Court markings. A centre circle drawn as a ring of short segments, because a torus is\n	-- not a part and a decal would be an asset id.\n	Kit.Slab(parent, \"GymCourt\", at(cx, 0.75, cz), GYM.WidthStuds - 14, GYM.DepthStuds - 14, 0.2, { color = Color3.fromRGB(206, 168, 116), collide = false })\n	for seg = 1, 24 do\n		local angle = (seg / 24) * math.pi * 2\n		Kit.Block(parent, `GymCircle{seg}`, at(cx + math.cos(angle) * 12, 0.85, cz + math.sin(angle) * 12), Vector3.new(3.4, 0.2, 0.6), {\n			color = WHITE,\n			yawDegrees = -math.deg(angle),\n		})\n	end\n\n	-- Hoops at each end.\n	for index = 1, GYM.HoopCount do\n		local side = if index == 1 then -1 else 1\n		local z = cz + side * (GYM.DepthStuds / 2 - 8)\n		Kit.Column(parent, `HoopPost{index}`, at(cx, 0.4, z), 16, 1.4, DARK)\n		Kit.Block(parent, `Backboard{index}`, at(cx, 15, z - side * 1.6), Vector3.new(11, 6.5, 0.4), { color = WHITE, transparency = 0.25 })\n		Kit.Block(parent, `Rim{index}`, at(cx, 12.6, z - side * 4), Vector3.new(5.4, 0.4, 5.4), { color = Color3.fromRGB(226, 116, 62) })\n	end\n\n	-- Bleachers down one side.\n	for row = 1, 5 do\n		Kit.Block(parent, `Bleacher{row}`, at(x1 - 6 - row * 3, 0.4 + row * 2, cz), Vector3.new(3, 2, GYM.DepthStuds - 20), { color = OFF_WHITE })\n	end\n\n	-- Wall bars down the back and climbing ropes from the roof. Both are here because the\n	-- room got smaller: a compact gym has to be *denser* to still read as a gym, and these are\n	-- the two things that say \"school gymnasium\" rather than \"sports hall\" for almost no\n	-- parts. A bare box at 72 studs would read as emptier than the 88-stud one it replaced.\n	for index = 1, GYM.WallBars do\n		local share = (index - 0.5) / GYM.WallBars\n		local x = x0 + GYM.WidthStuds * share\n		for rung = 1, 9 do\n			Kit.Block(parent, `WallBar{index}_{rung}`, at(x, 2 + rung * 1.6, GYM.DepthStuds - 2), Vector3.new(5, 0.4, 0.4), {\n				color = WOOD,\n				material = Enum.Material.Wood,\n			}).CastShadow = false\n		end\n	end\n\n	for index = 1, GYM.RopeCount do\n		local x = x0 + GYM.WidthStuds * (index / (GYM.RopeCount + 1))\n		Kit.Block(parent, `Rope{index}`, at(x, GYM.HeightStuds / 2 + 2, cz - 12), Vector3.new(0.35, GYM.HeightStuds - 4, 0.35), {\n			color = Color3.fromRGB(184, 156, 108),\n			material = Enum.Material.Fabric,\n		}).CastShadow = false\n	end\n\n	for index = 1, 10 do\n		Kit.LightPanel(parent, `GymLight{index}`, at(x0 + GYM.WidthStuds * (((index - 1) % 5 + 0.5) / 5), 0.4 + GYM.HeightStuds - 1.5, cz + (if index > 5 then 16 else -16)), 10, 3)\n	end\n\n	return at(cx, 0.4, cz)\nend\n\n-- ---------------------------------------------------------------------------------------\n-- The track and field, behind the building.\n-- ---------------------------------------------------------------------------------------\n\nlocal function buildTrack(parent: Instance, at: (number, number, number) -> Vector3): Vector3\n	local centreZ = D + 40 + TRACK.TurnRadiusStuds\n	local halfStraight = TRACK.StraightStuds / 2\n\n	-- The infield first, so the lanes are laid over its edge rather than under it.\n	Kit.Slab(parent, \"Infield\", at(0, 0.5, centreZ), TRACK.StraightStuds + 10, TRACK.TurnRadiusStuds * 2 - 8, 0.5, {\n		color = GRASS,\n		material = Enum.Material.Grass,\n	})\n\n	for lane = 1, TRACK.Lanes do\n		local radius = TRACK.TurnRadiusStuds + (lane - 1) * TRACK.LaneWidthStuds\n		local width = TRACK.LaneWidthStuds\n\n		-- The two straights.\n		for side = -1, 1, 2 do\n			Kit.Slab(parent, `TrackStraight{lane}_{side}`, at(0, 0.55, centreZ + side * radius), TRACK.StraightStuds, width, 0.3, {\n				color = TRACK_RED,\n				collide = false,\n			})\n		end\n\n		-- The two turns, stepped round in segments. Each segment is a short slab turned to the\n		-- tangent, which is how you draw a curve out of rectangles without a mesh.\n		for side = -1, 1, 2 do\n			for seg = 1, TRACK.CurveSegments do\n				local share = (seg - 0.5) / TRACK.CurveSegments\n				local angle = -math.pi / 2 + math.pi * share\n				local px = side * (halfStraight + math.cos(angle) * radius)\n				local pz = centreZ + math.sin(angle) * radius\n				-- Segment length from the arc it has to cover, plus a hair so neighbours overlap\n				-- rather than leaving a hairline of ground showing between them.\n				local segLength = (math.pi * radius / TRACK.CurveSegments) + 0.6\n				Kit.Block(parent, `TrackTurn{lane}_{side}_{seg}`, at(px, 0.55, pz), Vector3.new(width, 0.3, segLength), {\n					color = TRACK_RED,\n					yawDegrees = -math.deg(angle) * side,\n				})\n			end\n		end\n	end\n\n	-- The pitch markings inside, and a goal at each end.\n	Kit.Slab(parent, \"PitchLineHalf\", at(0, 0.75, centreZ), 0.8, TRACK.TurnRadiusStuds * 2 - 16, 0.2, { color = WHITE, collide = false })\n	for side = -1, 1, 2 do\n		local gz = centreZ + side * (TRACK.TurnRadiusStuds - 14)\n		Kit.Block(parent, `GoalBar{side}`, at(0, TRACK.GoalHeightStuds, gz), Vector3.new(TRACK.GoalWidthStuds, 0.7, 0.7), { color = WHITE })\n		for post = -1, 1, 2 do\n			Kit.Column(parent, `GoalPost{side}_{post}`, at(post * TRACK.GoalWidthStuds / 2, 0.6, gz), TRACK.GoalHeightStuds, 0.7, WHITE)\n		end\n	end\n\n	-- Floodlights at the corners, so the track reads at night.\n	for sx = -1, 1, 2 do\n		for sz = -1, 1, 2 do\n			local base = at(sx * (halfStraight + 20), 0.5, centreZ + sz * (TRACK.TurnRadiusStuds + 30))\n			Kit.Column(parent, `Flood{sx}_{sz}`, base, 34, 2, CONCRETE)\n			Kit.LightPanel(parent, `FloodHead{sx}_{sz}`, base + Vector3.new(0, 35, 0), 8, 4)\n		end\n	end\n	return at(0, 0.5, centreZ)\nend\n\n-- ---------------------------------------------------------------------------------------\n-- Standing down the map's own school.\n-- ---------------------------------------------------------------------------------------\n\n-- Everything the map builds for a school, which this one replaces.\n--\n-- Five models across two assets, and the list was measured rather than guessed: every one of\n-- them carries **no attributes at all**, so standing them down removes geometry and nothing\n-- else. The street's place points are a sibling model and are never touched, which is why\n-- `school` still resolves afterwards and every service that looks it up still works.\n--\n-- Deliberately absent, and they must stay absent: `City.RunningTrack` (FacilityKind=track),\n-- `City.SoccerField` and `City.BoxingGym` (SportsDrillKind). Those carry attributes other\n-- systems read, so hiding them would break a capability rather than replace one.\nlocal OLD_SCHOOL: { StandDown.Target } = {\n	{ parent = \"Street\", model = \"School\" },\n	{ parent = \"Street\", model = \"SchoolFittings\" },\n	{ parent = \"City\", model = \"SchoolFields\" },\n	{ parent = \"City\", model = \"SchoolFieldsTrees\" },\n	{ parent = \"City\", model = \"SchoolFieldsFittings\" },\n}\n\nlocal STAND_DOWN_KEY = \"School\"\n\nlocal function standDownOldSchool(): number\n	return StandDown.Hide(STAND_DOWN_KEY, OLD_SCHOOL)\nend\n\n-- ---------------------------------------------------------------------------------------\n-- Build.\n-- ---------------------------------------------------------------------------------------\n\n-- Lays the whole school around a centre point, once.\n--\n-- Nil means it did not lay, which every caller must treat as \"the building is not there\" --\n-- the pad, the sign and the verb rooms all still work without it, which is deliberate: a\n-- building that failed to appear should cost the player a nice-looking school and not their\n-- afternoon.\nfunction School.Build(center: Vector3): Plan?\n	local existing = plan\n	if existing ~= nil then\n		return existing\n	end\n	if not BUILDING.Enabled then\n		return nil\n	end\n\n	local parent = schoolFolder()\n	-- The only place the centre is added in. Everything above this line is local coordinates,\n	-- which is what lets the whole building move with its place point.\n	--\n	-- Named `toWorld` rather than `at` even though every builder receives it as `at`, because\n	-- a file-level local sharing a name with a parameter used two hundred lines above it\n	-- reads to the gate's declaration-order check as a use before declaration. CLAUDE.md\n	-- names that false positive and says the checks that produced them were dropped rather\n	-- than tuned, so the fix belongs here.\n	local function toWorld(x: number, y: number, z: number): Vector3\n		-- OFFSET is applied here and nowhere else: the place point marks the door, and the\n		-- building sits back from it. Both this and SetEvent's copy must agree, or prom would\n		-- be laid where the gym used to be.\n		return center + OFFSET + Vector3.new(x, y, z)\n	end\n\n	-- The map's own school comes down first, or the player walks through two buildings\n	-- standing in one plot. See standDownOldSchool for why this hides rather than destroys.\n	standDownOldSchool()\n\n	buildSite(parent, toWorld)\n	buildShell(parent, toWorld)\n	buildFrontage(parent, toWorld)\n	buildStairs(parent, toWorld)\n	buildLobby(parent, toWorld)\n	buildCorridors(parent, toWorld)\n	local anchors = buildRooms(parent, toWorld)\n\n	-- The corridor line, so the bully system can stand people along the hallway this file\n	-- laid rather than laying a second one beside it. The left-hand end rather than the\n	-- middle, because Corridor measures its run forward from the point it is handed.\n	anchors.corridor = toWorld(-W / 2 + WALL_T, 0, D - WALL_T - BAND_D - CORRIDOR_W / 2)\n\n	anchors.pool = buildPool(parent, toWorld)\n	anchors.gym = buildGym(parent, toWorld)\n	-- The track is off by default: the map already has one, and ours added 176 studs of depth\n	-- to a building that had nowhere to stand. See Config.School.Track.Enabled.\n	--\n	-- The anchor still has to exist, because PE and the sports drills look it up. When the track\n	-- is not built it falls back to the place point, which is what every other room in this file\n	-- does when its geometry is missing -- the verb keeps working, it just happens on open\n	-- ground rather than on a marked lane.\n	local field = if TRACK.Enabled then buildTrack(parent, toWorld) else toWorld(0, 0.4, D + 40)\n	anchors.track = field\n\n	-- With the building already baked into the map, the parts just laid are a duplicate\n	-- standing inside it. The *anchors* are what this run was for -- they are computed by\n	-- laying the rooms, not stored anywhere -- so the geometry is thrown away and the plan is\n	-- kept. Nothing was ever parented into the world; see schoolFolder.\n	if BUILDING.Baked then\n		local existing = folder\n		if existing ~= nil then\n			existing:Destroy()\n		end\n		folder = nil\n	end\n\n	local built: Plan = {\n		center = center,\n		rooms = anchors,\n		entrance = toWorld(0, 0, -4),\n		atrium = toWorld(0, 0, (ATRIUM_Z1 + ATRIUM_Z2) / 2),\n		field = field,\n	}\n	plan = built\n	return built\nend\n\n-- ---------------------------------------------------------------------------------------\n-- Events: the nights the gymnasium is dressed for something.\n-- ---------------------------------------------------------------------------------------\n\n-- Everything an event puts up lives in its own folder, so taking it down is one Destroy and\n-- the gym underneath is never touched. That separation is the whole design: the gym is a gym\n-- three hundred days a year and a ballroom on the other five, and neither version has to\n-- know the other exists.\nlocal eventFolder: Folder? = nil\nlocal currentEvent: string? = nil\n\nlocal function eventParent(): Folder\n	local existing = eventFolder\n	if existing ~= nil and existing.Parent ~= nil then\n		return existing\n	end\n	local made = Instance.new(\"Folder\")\n	made.Name = \"SchoolEvent\"\n	made.Parent = workspace\n	eventFolder = made\n	return made\nend\n\n-- Dresses the gymnasium for prom, or clears it.\n--\n-- The gym is the venue on purpose, and it is worth saying why rather than treating it as\n-- obvious. A school has exactly one room big enough to hold everybody, and every real school\n-- therefore holds its dances in it. Building a separate ballroom would mean adding a space\n-- that is dead for all but one night a year -- which is the opposite of what a map this size\n-- needs, and which the reference photographs confirm: that is a basketball court under the\n-- streamers, and you can see the wall bars behind the stage.\n--\n-- Passing nil takes it all down. Returns whether anything changed, so a caller can tell the\n-- difference between \"prom started\" and \"prom was already on\".\nfunction School.SetEvent(id: string?): boolean\n	if currentEvent == id then\n		return false\n	end\n\n	local existing = eventFolder\n	if existing ~= nil then\n		existing:Destroy()\n	end\n	eventFolder = nil\n	currentEvent = id\n\n	if id == nil then\n		return true\n	end\n\n	local current = plan\n	if current == nil then\n		-- No building, so no gym to dress. Recorded as the current event anyway: the caller\n		-- asked for prom and prom is what is on, it simply has nowhere to be yet.\n		return true\n	end\n\n	local center = current.center\n	local function toWorld(x: number, y: number, z: number): Vector3\n		-- OFFSET is applied here and nowhere else: the place point marks the door, and the\n		-- building sits back from it. Both this and SetEvent's copy must agree, or prom would\n		-- be laid where the gym used to be.\n		return center + OFFSET + Vector3.new(x, y, z)\n	end\n\n	local parent = eventParent()\n	local half = W / 2\n	local x0 = half\n	local cx = x0 + GYM.WidthStuds / 2\n	local cz = GYM.DepthStuds / 2\n\n	local partyColors = {\n		Color3.fromRGB(236, 118, 176),\n		Color3.fromRGB(146, 106, 214),\n		Color3.fromRGB(98, 168, 236),\n		Color3.fromRGB(246, 196, 96),\n		Color3.fromRGB(240, 240, 246),\n	}\n\n	-- The dance floor: a parquet square in the middle, lit from above. Everything else in the\n	-- room arranges itself around this, which is why it is laid first.\n	Kit.Slab(parent, \"DanceFloor\", toWorld(cx, 0.9, cz), EVENTS.FloorStuds, EVENTS.FloorStuds, 0.4, {\n		color = Color3.fromRGB(196, 150, 104),\n		material = Enum.Material.WoodPlanks,\n	})\n\n	-- Coloured washes over it. Neon discs rather than real lights for the reason the ceiling\n	-- panels are: a dozen PointLights in one room costs more than the building.\n	for index = 1, EVENTS.Spotlights do\n		local angle = (index / EVENTS.Spotlights) * math.pi * 2\n		local r = EVENTS.FloorStuds * 0.3\n		Kit.Spotlight(\n			parent,\n			`PromSpot{index}`,\n			toWorld(cx + math.cos(angle) * r, 1.2, cz + math.sin(angle) * r),\n			7,\n			partyColors[((index - 1) % #partyColors) + 1]\n		)\n	end\n\n	-- The stage at the far end, with the throne on it.\n	local stageZ = cz + GYM.DepthStuds / 2 - EVENTS.StageDepthStuds - 4\n	Kit.Slab(parent, \"PromStage\", toWorld(cx, 0.4 + EVENTS.StageRiseStuds, stageZ), EVENTS.StageWidthStuds, EVENTS.StageDepthStuds, EVENTS.StageRiseStuds, {\n		color = Color3.fromRGB(196, 62, 78),\n		material = Enum.Material.Fabric,\n	})\n	Kit.Block(parent, \"PromThrone\", toWorld(cx, 0.4 + EVENTS.StageRiseStuds + 3, stageZ + 1), Vector3.new(6, 6, 4), {\n		color = Color3.fromRGB(226, 186, 84),\n		material = Enum.Material.Metal,\n	})\n	Kit.Block(parent, \"PromThroneBack\", toWorld(cx, 0.4 + EVENTS.StageRiseStuds + 8, stageZ + 2.6), Vector3.new(6, 10, 1), {\n		color = Color3.fromRGB(226, 186, 84),\n		material = Enum.Material.Metal,\n	})\n\n	-- The banner over the stage.\n	local banner = Kit.Block(parent, \"PromBanner\", toWorld(cx, 16, stageZ + 4), Vector3.new(EVENTS.StageWidthStuds + 8, 4, 0.4), {\n		color = Color3.fromRGB(236, 118, 176),\n	})\n	banner.CastShadow = false\n	Kit.Sign(banner, \"AGES PROM\", 24, LABEL_DIST * 2, Color3.fromRGB(255, 250, 252))\n\n	-- The DJ booth, off to one side of the stage.\n	Kit.Block(parent, \"DjBooth\", toWorld(cx - EVENTS.StageWidthStuds * 0.75, 2.4, stageZ - 2), Vector3.new(9, 4.8, 4), {\n		color = Color3.fromRGB(64, 46, 96),\n	})\n	Kit.Block(parent, \"DjDeck\", toWorld(cx - EVENTS.StageWidthStuds * 0.75, 5, stageZ - 2), Vector3.new(9.4, 0.4, 4.4), {\n		color = Color3.fromRGB(28, 30, 40),\n	})\n\n	-- The balloon arch at the way in, and clusters round the room.\n	Kit.BalloonArch(parent, \"PromArch\", toWorld(cx, 0.4, cz - GYM.DepthStuds / 2 + 6), 26, 16, EVENTS.ArchBalloons, partyColors)\n\n	for index = 1, EVENTS.BalloonClusters do\n		local angle = (index / EVENTS.BalloonClusters) * math.pi * 2\n		local r = EVENTS.FloorStuds * 0.78\n		Kit.BalloonCluster(\n			parent,\n			`PromBalloons{index}`,\n			toWorld(cx + math.cos(angle) * r, 0.4, cz + math.sin(angle) * r),\n			EVENTS.BalloonsPerCluster,\n			partyColors\n		)\n	end\n\n	-- Streamers across the ceiling, corner to corner.\n	for index = 1, EVENTS.Streamers do\n		local share = (index - 0.5) / EVENTS.Streamers\n		local z = cz - GYM.DepthStuds / 2 + GYM.DepthStuds * share\n		Kit.Streamer(\n			parent,\n			`PromStreamer{index}`,\n			toWorld(x0 + 3, GYM.HeightStuds - 3, z),\n			toWorld(x0 + GYM.WidthStuds - 3, GYM.HeightStuds - 3, z),\n			8,\n			partyColors[((index - 1) % #partyColors) + 1]\n		)\n	end\n\n	-- Folding chairs round the edge and a few round tables, so the room has somewhere to sit\n	-- out a song. Deliberately at the perimeter: chairs on the floor would be the one thing\n	-- that stops it being a dance floor.\n	for index = 1, EVENTS.Chairs do\n		local angle = (index / EVENTS.Chairs) * math.pi * 2\n		local r = EVENTS.FloorStuds * 0.92\n		Kit.Block(parent, `PromChair{index}`, toWorld(cx + math.cos(angle) * r, 2, cz + math.sin(angle) * r), Vector3.new(2.6, 0.4, 2.6), {\n			color = Color3.fromRGB(48, 52, 68),\n			yawDegrees = -math.deg(angle),\n		})\n	end\n	for index = 1, EVENTS.Tables do\n		local angle = ((index - 0.5) / EVENTS.Tables) * math.pi * 2\n		local r = EVENTS.FloorStuds * 1.12\n		local spot = toWorld(cx + math.cos(angle) * r, 0.4, cz + math.sin(angle) * r)\n		Kit.Block(parent, `PromTable{index}`, spot + Vector3.new(0, 3, 0), Vector3.new(7, 0.4, 7), { color = Color3.fromRGB(246, 240, 244) })\n		Kit.Block(parent, `PromTableLeg{index}`, spot + Vector3.new(0, 1.5, 0), Vector3.new(1.2, 3, 1.2), { color = Color3.fromRGB(120, 96, 108) })\n	end\n\n	return true\nend\n\n-- Which event is dressed, or nil. Read rather than built.\nfunction School.Event(): string?\n	return currentEvent\nend\n\n-- Puts the map's own school back and takes this one down. The undo, for deciding by eye\n-- which building the game should have.\nfunction School.RestoreOldSchool(): number\n	local put = StandDown.Restore(STAND_DOWN_KEY)\n	if put > 0 then\n		School.Clear()\n	end\n	return put\nend\n\n-- Whether the map's school is currently stood down.\nfunction School.OldSchoolStoodDown(): boolean\n	return StandDown.IsHidden(STAND_DOWN_KEY)\nend\n\n-- Which of the map's models are stood down, by name.\nfunction School.StoodDownNames(): { string }\n	return StandDown.Names(STAND_DOWN_KEY)\nend\n\n-- The building as it stands, or nil if it has not been laid. Read rather than built, so a\n-- debug command describing the school cannot be the thing that creates it.\nfunction School.Plan(): Plan?\n	return plan\nend\n\n-- Where a named room is, in world coordinates, or nil if there is no such room or the\n-- building is not up.\n--\n-- **This is the entire join between the building and the lessons.** ScienceService does not\n-- know where the lab is; it asks for \"science\" and lays its benches around whatever comes\n-- back. That is what lets a wall move without a subject breaking, and a subject be added\n-- without a wall moving.\nfunction School.RoomAt(id: string): Vector3?\n	local current = plan\n	if current == nil then\n		return nil\n	end\n	return current.rooms[id]\nend\n\n-- Takes the school down. The new-life path, and the same reason Corridor.Clear exists: the\n-- building is rebuilt around whichever place point the next life walks into.\nfunction School.Clear()\n	local existing = folder\n	if existing ~= nil then\n		existing:Destroy()\n	end\n	folder = nil\n	plan = nil\n	-- And whatever the gym was dressed for. A prom left standing over a school that no longer\n	-- exists is the kind of thing that survives a new life and cannot be explained.\n	School.SetEvent(nil)\nend\n\nreturn School\n"
table.insert(AGES_MANIFEST, "src/server/world/School.luau")
AGES_SOURCES["src/server/world/SchoolCopy.luau"] = "--!strict\n-- **The editable copy of school v1. This file is a fork and it is meant to diverge.**\n--\n-- `world/School.luau` builds the v1 that is already in the map and players walk around; this\n-- builds `Workspace.SchoolV1Copy`, which stands on its own empty ground west of it. They start\n-- identical. Every change asked for on the copy lands here, and v1 is never touched.\n--\n-- The fork is one line deep, which is why it is a fork rather than a rewrite: the whole builder\n-- hangs off `Config.School.Building`, so the copy takes a deep copy of that table, applies its\n-- own overrides, and the other 2900 lines are unchanged. Read `PLAN` below to see exactly how\n-- the copy differs from v1 -- if it is not in there, the two are the same.\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Config = require(ReplicatedStorage:WaitForChild(\"Config\"))\n\nlocal Kit = require(script.Parent.Kit)\nlocal StandDown = require(script.Parent.StandDown)\n\nlocal SchoolCopy = {}\n\n\n-- ---------------------------------------------------------------------------------------\n-- What the copy changes about v1\n-- ---------------------------------------------------------------------------------------\n\n-- A deep copy, because `Config.School.Building` is a live table v1 is reading at the same time.\n-- Mutating it in place would edit v1 from here, which is the one thing this file exists to\n-- avoid, and it would do it silently.\nlocal function deepCopy(value)\n	if type(value) ~= \"table\" then\n		return value\n	end\n	local out = {}\n	for key, inner in pairs(value) do\n		out[key] = deepCopy(inner)\n	end\n	return out\nend\n\nlocal PLAN = deepCopy(Config.School.Building)\n\n-- **Every difference from v1 is in this block and nowhere else.**\n--\n-- Wide enough for two players to pass without either stopping. v1 runs 16, which is walkable\n-- and reads as a service corridor; the brief asks for 20-24 and 24 is the top of that, which is\n-- also what lets a locker bank stand against a wall without narrowing the route to nothing.\nPLAN.CorridorWidthStuds = 24\n\n-- Two floors, hard cap. v1 is already two; this is written down so that a later change adding a\n-- storey has to argue with a line of code rather than slip past. Extra space comes from the\n-- footprint below, never from another floor.\nPLAN.Floors = 2\n\n-- Where the extra room comes from instead. The wider corridor has to be taken out of something,\n-- and taking it out of the rooms would make every classroom shallower -- so the building grows\n-- on Z by the 8 studs the corridor gained, and the rooms keep the depth they had.\nPLAN.DepthStuds = Config.School.Building.DepthStuds + 8\n\n-- **A seventh room slot per floor, for the washrooms -- and the building grows to hold it.**\n--\n-- v1 has six slots a floor and no washrooms at all. The brief wants dedicated male and female\n-- rooms on both floors, and rule 4 says the space for anything new comes out of the footprint\n-- rather than a third storey. So: one more slot, and the frontage grows by exactly one slot's\n-- width plus its gap, which leaves every existing classroom the size it already was.\n--\n-- Taking it out of the current 228 instead would have shaved four studs off all six rooms to\n-- pay for the seventh, which is how a plan quietly gets worse everywhere to add one thing.\nPLAN.RoomsPerFloor = 7\nPLAN.WidthStuds = 266\n\nlocal BUILDING = PLAN\nlocal ENTRANCE = BUILDING.Entrance\nlocal POOL = BUILDING.Pool\nlocal GYM = BUILDING.Gym\nlocal TRACK = BUILDING.Track\nlocal FIT = BUILDING.FitOut\n-- How tall a room door stands.\n--\n-- Twelve. Eight is the textbook number -- an R15 avatar is five studs and builders use seven\n-- to eight for a door -- and it was still wrong here, because those numbers are for a room with\n-- a 10-stud ceiling. In a 27-stud storey an 8-stud door is a hatch: correct against the avatar\n-- and far too small against the wall it is cut into. A door has to be read against the room.\nlocal DOOR_H = 12\nlocal EVENTS = BUILDING.Events\nlocal LOUNGE = BUILDING.Lounge\nlocal VEND = BUILDING.Vending\n\nlocal W = BUILDING.WidthStuds\nlocal D = BUILDING.DepthStuds\n\n-- How far the building sits from its place point. Applied once, in Build's toWorld, so every\n-- room anchor, every prop and the baked asset all move together -- an offset applied in more\n-- than one place is an offset that will disagree with itself.\nlocal OFFSET = Vector3.new(BUILDING.OffsetXStuds, BUILDING.OffsetYStuds, BUILDING.OffsetZStuds)\nlocal FLOOR_H = BUILDING.FloorHeightStuds\nlocal SLAB = BUILDING.SlabThicknessStuds\nlocal WALL_T = BUILDING.WallThicknessStuds\nlocal CORRIDOR_W = BUILDING.CorridorWidthStuds\nlocal BAND_D = BUILDING.BackBandDepthStuds\nlocal LABEL_DIST = BUILDING.LabelMaxDistanceStuds\n\n-- The palette. Inline rather than in Config for the reason Studio gives about its furniture\n-- colours: a colour is not a tunable with a safe range, it is a decision, and a building\n-- whose palette lived in a settings file would be a building nobody could look at and change.\n--\n-- White, cool grey and one blue, which is what the reference is: a modern school reads as\n-- bright and low-contrast, and every accent in it is the same blue doing different jobs.\nlocal WHITE = Color3.fromRGB(242, 243, 246)\nlocal OFF_WHITE = Color3.fromRGB(228, 230, 235)\nlocal TILE = Color3.fromRGB(232, 232, 234)\nlocal CONCRETE = Color3.fromRGB(176, 178, 182)\nlocal BLUE = Color3.fromRGB(58, 122, 206)\nlocal DEEP_BLUE = Color3.fromRGB(36, 84, 158)\nlocal PALE_BLUE = Color3.fromRGB(146, 190, 236)\nlocal GLASS_TINT = Color3.fromRGB(196, 220, 240)\nlocal WOOD = Color3.fromRGB(158, 118, 78)\nlocal DARK = Color3.fromRGB(64, 68, 78)\n\n-- Stair treads, taken off the reference photograph rather than invented: charcoal against a\n-- pale building. The contrast is doing the work, not the shape. The balustrade is posts rather\n-- than glass now -- a curved flight cannot take a flat panel, and a fanned run of posts is what\n-- makes the turn legible from across the lobby.\nlocal STAIR_TREAD = Color3.fromRGB(78, 82, 92)\n\n-- Library timber. The reference shelves are dark walnut, not the mid pine the rest of the\n-- building uses -- a library reads as a library partly because its furniture is heavier than\n-- everything around it.\nlocal WALNUT = Color3.fromRGB(96, 66, 46)\nlocal WATER = Color3.fromRGB(64, 156, 214)\nlocal TRACK_RED = Color3.fromRGB(168, 76, 66)\nlocal GRASS = Color3.fromRGB(102, 148, 84)\n\n-- One named room, in local coordinates. Rectangles rather than polygons because every room\n-- in a school is a rectangle, and the moment one is not, the fit-out loops that walk them\n-- all stop working.\ntype Rect = {\n	id: string,\n	label: string,\n	-- Which storey, 1-based. 1 is the ground floor.\n	floor: number,\n	-- Corners, in local x/z.\n	x1: number,\n	z1: number,\n	x2: number,\n	z2: number,\n	-- What to put in it. \"class\" gets desks, \"common\" gets rugs and planters, \"none\" gets\n	-- lights and a sign and nothing else -- which is right for rooms whose furniture is laid\n	-- by whichever verb owns them.\n	kind: string,\n}\n\nexport type Plan = {\n	center: Vector3,\n	-- The middle of each named room, in world coordinates, at its own floor level. What the\n	-- verb modules position against.\n	rooms: { [string]: Vector3 },\n	-- The front door, the middle of the atrium, and the middle of the track infield -- named\n	-- separately because they are destinations rather than rooms.\n	entrance: Vector3,\n	atrium: Vector3,\n	field: Vector3,\n}\n\nlocal plan: Plan? = nil\nlocal folder: Folder? = nil\n\nlocal function schoolFolder(): Folder\n	local existing = folder\n	if existing ~= nil and existing.Parent ~= nil then\n		return existing\n	end\n	local made = Instance.new(\"Folder\")\n	made.Name = \"SchoolBuilding\"\n	-- Not parented into the world when the building is baked: the parts are only being laid\n	-- to work out where the rooms are, and are destroyed as soon as that is known. A folder\n	-- that reached workspace first would replicate a second school for one frame.\n	if not BUILDING.Baked then\n		made.Parent = workspace\n	end\n	folder = made\n	return made\nend\n\n-- The height of a storey\\'s walking surface. Floor 1 is the ground the place point sits on.\nlocal function floorY(floor: number): number\n	return (floor - 1) * FLOOR_H\nend\n\n-- The plan of the whole school, in local coordinates.\n--\n-- Written out as data rather than laid by hand, because everything downstream -- the walls,\n-- the lights, the signs, the desks and the anchors the verbs hang off -- is a loop over this\n-- list. Moving a room is one line here and the fit-out follows it.\n--\n-- The layout, front to back: the plaza and the doors, then the atrium cut through all three\n-- storeys, then open circulation, then the corridor spine across the building, then a band\n-- of rooms along the back wall. Four rooms per floor, cut out of that band in equal widths.\n--\n-- Two things about it are load bearing rather than arbitrary. The band sits **entirely\n-- behind** the corridor -- an earlier version had the ground floor rooms starting in front\n-- of it, so the cafeteria tables and the corridor lockers occupied the same studs. And the\n-- band is 99 deep because the art room lays its study wall and its paint cupboard 81 apart;\n-- at the 32 it used to be, the cupboard stood outside the building.\n--\n-- The ground floor gives its whole band to the cafeteria and the library, because those are\n-- the two rooms a school actually gathers in. The teaching rooms are upstairs, which is also\n-- what puts a flight of stairs between a player and their lesson.\nlocal function planRooms(): { Rect }\n	local half = W / 2\n	local backZ = D - WALL_T\n	local bandFront = backZ - BAND_D\n	local usable = W - WALL_T * 2\n	local gaps = BUILDING.RoomGapStuds * (BUILDING.RoomsPerFloor - 1)\n	local roomW = (usable - gaps) / BUILDING.RoomsPerFloor\n\n	-- The left edge of the nth slot in the band, 0-based. One expression rather than six\n	-- hand-written pairs of corners, so a change to the room count cannot leave a gap or an\n	-- overlap behind.\n	local function slotX(index: number): (number, number)\n		local x1 = -half + WALL_T + index * (roomW + BUILDING.RoomGapStuds)\n		return x1, x1 + roomW\n	end\n\n	local a1, a2 = slotX(0)\n	local b1, b2 = slotX(1)\n	local c1, c2 = slotX(2)\n	local d1, d2 = slotX(3)\n	local e1, e2 = slotX(4)\n	local f1, f2 = slotX(5)\n	local g1, g2 = slotX(6)\n	-- The seventh slot carries two rooms rather than one: a washroom pair, split down the middle\n	-- with a shared spine wall. Two half-slots is about 18 studs each, which is a real room --\n	-- three stalls and a basin run -- rather than a cupboard with a sink in it.\n	local gMid = (g1 + g2) / 2\n\n	-- **Ground floor is where you go; first floor is where you are sent.**\n	--\n	-- That is the whole organising idea, and it is why this is worth writing down rather than\n	-- being an arbitrary list. Everything on the ground is somewhere a player *chooses* to be\n	-- between lessons -- eat, read, sit, cook -- and it is all reachable from the lobby without\n	-- a stair. Everything upstairs is a subject with a timetable slot. A player who has learned\n	-- that never has to think about which floor anything is on again.\n	--\n	-- Only five of these anchors are actually required by code: science, art, reading, music\n	-- and library. The rest exist because a school with five rooms in it is a set.\n	return {\n		-- Ground. The cafeteria and the library take two slots each: one is the room the whole\n		-- school is in at once, the other needs the run for its stacks, and a third of the\n		-- frontage each is what stops them reading as classrooms with odd furniture.\n		{ id = \"cafeteria\", label = \"Cafeteria\", floor = 1, x1 = a1, z1 = bandFront, x2 = b2, z2 = backZ, kind = \"cafeteria\" },\n		{ id = \"library\", label = \"Library\", floor = 1, x1 = c1, z1 = bandFront, x2 = c2, z2 = backZ, kind = \"library\" },\n		{ id = \"computers\", label = \"Computer Lab\", floor = 1, x1 = d1, z1 = bandFront, x2 = d2, z2 = backZ, kind = \"class\" },\n		-- The one room in the building nobody sends you to. Every other space here is somewhere\n		-- you are told to be; this is the one you choose, and it is what makes the school\n		-- somewhere a player hangs around rather than somewhere they visit twice a year.\n		{ id = \"lounge\", label = \"Student Lounge\", floor = 1, x1 = e1, z1 = bandFront, x2 = e2, z2 = backZ, kind = \"lounge\" },\n		{ id = \"cooking\", label = \"Cooking Lab\", floor = 1, x1 = f1, z1 = bandFront, x2 = f2, z2 = backZ, kind = \"cooking\" },\n		{ id = \"washroomM1\", label = \"Boys' Washroom\", floor = 1, x1 = g1, z1 = bandFront, x2 = gMid, z2 = backZ, kind = \"washroom\" },\n		{ id = \"washroomF1\", label = \"Girls' Washroom\", floor = 1, x1 = gMid, z1 = bandFront, x2 = g2, z2 = backZ, kind = \"washroom\" },\n		-- Computers. This was lost when the third floor went, which was a mistake: the brief was to\n		-- even three floors of rooms into two, not to delete a floor's worth of school. It shares\n		-- the library's two slots rather than taking one of its own -- a computer room and a\n		-- library are the same kind of room to a player, and putting them together is what a real\n		-- school does with its resource centre.\n\n		-- First floor: the subjects. Science, Art and Reading are named here and left empty on\n		-- purpose -- Lab.luau, Studio.luau and ReadingRoom.luau lay their own benches inside\n		-- them, and this file must never learn what a bench is.\n		--\n		-- Art needs depth rather than width: its wall and its paint cupboard sit 81 studs apart,\n		-- which is the number the whole 99-stud band is sized around.\n		{ id = \"science\", label = \"Science Lab\", floor = 2, x1 = a1, z1 = bandFront, x2 = a2, z2 = backZ, kind = \"science\" },\n		{ id = \"art\", label = \"Art Studio\", floor = 2, x1 = b1, z1 = bandFront, x2 = b2, z2 = backZ, kind = \"art\" },\n		{ id = \"reading\", label = \"Reading Room\", floor = 2, x1 = c1, z1 = bandFront, x2 = c2, z2 = backZ, kind = \"reading\" },\n		{ id = \"music\", label = \"Music Room\", floor = 2, x1 = d1, z1 = bandFront, x2 = d2, z2 = backZ, kind = \"class\" },\n		{ id = \"english\", label = \"English\", floor = 2, x1 = e1, z1 = bandFront, x2 = e2, z2 = backZ, kind = \"class\" },\n		{ id = \"staff\", label = \"Staff Room\", floor = 2, x1 = f1, z1 = bandFront, x2 = f2, z2 = backZ, kind = \"common\" },\n		{ id = \"washroomM2\", label = \"Boys' Washroom\", floor = 2, x1 = g1, z1 = bandFront, x2 = gMid, z2 = backZ, kind = \"washroom\" },\n		{ id = \"washroomF2\", label = \"Girls' Washroom\", floor = 2, x1 = gMid, z1 = bandFront, x2 = g2, z2 = backZ, kind = \"washroom\" },\n	}\nend\n\nlocal ROOMS = planRooms()\n\nlocal function rectCenter(rect: Rect): (number, number)\n	return (rect.x1 + rect.x2) / 2, (rect.z1 + rect.z2) / 2\nend\n\n-- Where the atrium void sits, in local coordinates. Set back from the glass so the front\n-- elevation has two floors of real rooms behind it rather than a hole you can see into from\n-- the road, and centred on x so the entrance walks straight into it.\nlocal ATRIUM_X1 = -BUILDING.AtriumWidthStuds / 2\nlocal ATRIUM_X2 = BUILDING.AtriumWidthStuds / 2\nlocal ATRIUM_Z1 = 8\nlocal ATRIUM_Z2 = 14 + BUILDING.AtriumDepthStuds\n-- Where the *hole* in the upper floor stops, as opposed to where the atrium stops. The strip\n-- between the two is the gallery: real floor on the first floor, across the back of the void,\n-- which is what the stairs arrive on. See Config.School.Building.GalleryDepthStuds.\nlocal VOID_Z2 = ATRIUM_Z2 - BUILDING.GalleryDepthStuds\n\n-- **Where the two stairs stand, and therefore where the holes in the upper floor are.**\n--\n-- These are derived rather than chosen, and it matters that they are, because the openings in\n-- the first floor have to be exactly the flights' footprint -- any smaller and a tread ends up\n-- under the slab with no headroom over it, any larger and the floor is missing for no reason.\n--\n-- A quarter-turn flight sweeps from pointing at its own side wall to pointing at the corridor.\n-- That puts its arc inside a box reaching `radius + width/2` back from the turn centre and the\n-- same distance out to the side, so placing the centre that far in from the atrium wall lands\n-- the flight exactly against it. The two boxes then leave a bridge down the middle of the\n-- atrium, which is the piece of first floor that used to be missing entirely.\nlocal STAIR_R = BUILDING.StairRadiusStuds\nlocal STAIR_W = BUILDING.StairWidthStuds\nlocal STAIR_CX = BUILDING.AtriumWidthStuds / 2 - STAIR_R - STAIR_W / 2\n-- The turn centre sits a radius short of the void's back edge, so the head of the arc finishes\n-- exactly where the gallery slab begins and you step straight off it onto solid floor.\nlocal STAIR_CZ = VOID_Z2 - STAIR_R\n-- The stairwell openings: outer edge flush with the atrium wall, inner edge leaving the bridge.\nlocal WELL_Z1 = STAIR_CZ - STAIR_W / 2\nlocal WELL_X_OUT = STAIR_CX + STAIR_R + STAIR_W / 2\nlocal WELL_X_IN = STAIR_CX - STAIR_W / 2\n\n-- ---------------------------------------------------------------------------------------\n-- The site: ground, plaza, approach.\n-- ---------------------------------------------------------------------------------------\n\nlocal function buildSite(parent: Instance, at: (number, number, number) -> Vector3)\n	-- **Everything on the approach is placed outboard of the wings.**\n	--\n	-- It used to be placed from PlazaWidthStuds while the wings were placed from the pediment\n	-- and their own width -- two different numbers that were never going to agree. The wings\n	-- reach 74 studs from the centreline and the trees were at 43, the hedges at 53, the\n	-- flagpoles and bins nearer still, so every one of them stood inside a wing. That is the\n	-- clutter at the front of the building: not too much furniture, furniture in the wall.\n	--\n	-- wingOuter is the same expression buildShell lays the wings from, so the two cannot drift\n	-- apart again. Anything that has to stand clear of the building measures from here.\n	local wingOuter = ENTRANCE.PedimentWidthStuds / 2 + ENTRANCE.WingWidthStuds + 4\n\n	local half = W / 2\n	local plazaD = ENTRANCE.PlazaDepthStuds\n\n	-- A hardstanding under the whole campus, a little proud of the terrain so the building\n	-- never sits half-buried when the street it is on is regenerated at a different height.\n	-- Top a hair *below* the anchor rather than a hair above it.\n	--\n	-- Kit.Slab positions by its top surface, so at +0.1 the campus closed over the place point\n	-- standing at the anchor's own height -- the marker was inside the slab, and check_town\n	-- reports that as \"nothing at all under it\". It never showed while the school stood on the\n	-- town's own ground, because that ground was underneath at the right height; moving the\n	-- school onto empty land made this slab the only thing beneath the marker.\n	Kit.Slab(parent, \"Campus\", at(0, -0.05, D / 2 - plazaD / 2), W + POOL.HallWidthStuds * 2 + 40, D + plazaD + 40, 0.6, {\n		color = CONCRETE,\n		material = Enum.Material.Concrete,\n	})\n\n	-- The plaza in front of the doors, in a lighter tone so the approach reads as a route\n	-- rather than as more of the same surface.\n	Kit.Slab(parent, \"Plaza\", at(0, 0.25, -plazaD / 2), ENTRANCE.PlazaWidthStuds, plazaD, 0.4, {\n		color = OFF_WHITE,\n	})\n\n	-- **No terrace, and no steps.** There was a four-stud platform here with a flight up to it\n	-- and cheek walls down the sides, and it was a mistake: it put a step across the single\n	-- route into the building and narrowed what was left of the doorway between two walls. A\n	-- school entrance is somewhere a crowd walks through at once, and anything standing in the\n	-- middle of it is wrong however good it looks from the road.\n	--\n	-- The threshold it was reaching for is a shallow apron instead: one stud, the full width of\n	-- the frontage, nothing to climb and nothing to walk round.\n	Kit.Slab(parent, \"EntranceApron\", at(0, 1.25, -ENTRANCE.ApronDepthStuds / 2), ENTRANCE.PlazaWidthStuds, ENTRANCE.ApronDepthStuds, 1, {\n		color = OFF_WHITE,\n		material = Enum.Material.Concrete,\n	})\n\n\n	-- Bins along the approach, by the benches and the crossing.\n	for index = 1, BUILDING.BinsOutside do\n		local side = if index % 2 == 1 then -1 else 1\n		local row = math.floor((index - 1) / 2)\n		-- Along the edge of the plaza rather than 4 studs inside a wing, and pushed forward so\n		-- the row runs down the approach instead of starting under the building.\n		local x = side * (ENTRANCE.PlazaWidthStuds / 2 + 2)\n		local z = -ENTRANCE.ApronDepthStuds - 8 - row * 18\n		Kit.Block(parent, `OutdoorBin{index}`, at(x, 2.6, z), Vector3.new(4.2, 5, 4.2), {\n			color = Color3.fromRGB(58, 72, 88),\n			material = Enum.Material.Metal,\n			collide = true,\n		})\n		Kit.Block(parent, `OutdoorBinLid{index}`, at(x, 5.3, z), Vector3.new(4.8, 0.6, 4.8), {\n			color = Color3.fromRGB(40, 52, 66),\n			material = Enum.Material.Metal,\n		}).CastShadow = false\n	end\n\n	-- No flagpoles here. The building already raises a pair either side of the doors further\n	-- down this function, and I added a second set without checking first -- two sets on one\n	-- forecourt, the outer pair standing inside a wing.\n\n	-- Black railings along the front boundary, broken either side of the crossing.\n	--\n	-- The reference fences its whole frontage, and that is what makes the forecourt a\n	-- forecourt rather than the building simply stopping where the pavement starts. Broken at\n	-- the middle rather than run straight through, because a fence across your own entrance is\n	-- the one place it must not be.\n	local fenceZ = -plazaD - 4\n	local gap = ENTRANCE.PlazaWidthStuds / 2 + 6\n	for side = -1, 1, 2 do\n		local inner = side * gap\n		local outer = side * (wingOuter + 34)\n		Kit.Block(parent, `FenceRail{side}Top`, at((inner + outer) / 2, ENTRANCE.RailingHeightStuds, fenceZ), Vector3.new(math.abs(outer - inner), 0.5, 0.5), {\n			color = Color3.fromRGB(30, 32, 38),\n			material = Enum.Material.Metal,\n		}).CastShadow = false\n		Kit.Block(parent, `FenceRail{side}Mid`, at((inner + outer) / 2, ENTRANCE.RailingHeightStuds * 0.45, fenceZ), Vector3.new(math.abs(outer - inner), 0.4, 0.4), {\n			color = Color3.fromRGB(30, 32, 38),\n			material = Enum.Material.Metal,\n		}).CastShadow = false\n		local span = math.abs(outer - inner)\n		local posts = math.max(2, math.floor(span / ENTRANCE.RailingSpacingStuds))\n		for index = 0, posts do\n			local x = inner + (outer - inner) * (index / posts)\n			Kit.Block(parent, `FencePost{side}_{index}`, at(x, ENTRANCE.RailingHeightStuds / 2, fenceZ), Vector3.new(0.5, ENTRANCE.RailingHeightStuds, 0.5), {\n				color = Color3.fromRGB(30, 32, 38),\n				material = Enum.Material.Metal,\n			}).CastShadow = false\n		end\n	end\n\n	-- The crossing outside, which is the one piece of the approach that says \"there is a road\n	-- here and children cross it\" without a single sign.\n	for stripe = 1, 7 do\n		local x = -18 + (stripe - 1) * 6\n		Kit.Slab(parent, `Crossing{stripe}`, at(x, 0.3, -plazaD - 10), 3.4, 20, 0.3, { color = WHITE })\n	end\n\n	-- Clipped conical topiary down both sides of the approach, not round park trees. See\n	-- Kit.Topiary: a row of these is what makes the frontage read as landscaping somebody\n	-- maintains, which is the single most recognisable thing about the reference's forecourt.\n	for side = -1, 1, 2 do\n		for index = 1, ENTRANCE.TreesPerSide do\n			local z = -plazaD * (index / (ENTRANCE.TreesPerSide + 1))\n			Kit.Topiary(\n				parent,\n				`ApproachTopiary{side}_{index}`,\n				at(side * (wingOuter + 10), 0.4, z),\n				ENTRANCE.TopiaryHeightStuds,\n				ENTRANCE.TopiaryTiers\n			)\n		end\n		Kit.Block(parent, `ApproachHedge{side}`, at(side * (wingOuter + 22), 3, -plazaD / 2), Vector3.new(10, 6, plazaD), {\n			color = GRASS,\n			material = Enum.Material.Grass,\n		})\n	end\n\n	-- The welcome sign over the doors, and the school\\'s name on the plaza. Two pieces because\n	-- they are read from different distances: the name from the road, the welcome at the door.\n	local nameBoard = Kit.Block(parent, \"NameBoard\", at(0, 0.5, -plazaD + 6), Vector3.new(46, 0.6, 8), { color = OFF_WHITE })\n	Kit.Sign(nameBoard, \"AGES HIGH SCHOOL\", 46, LABEL_DIST * 3, DEEP_BLUE)\n\n	-- Above the door head, not across it. This sat at canopy height minus three, which put a\n	-- 26-stud white board straight over the top third of a 17-stud doorway -- the single thing\n	-- most responsible for the entrance being unreadable from the plaza. A sign belongs on the\n	-- wall above an opening; the moment it overlaps the opening it is not a sign, it is a lintel.\n	local welcome = Kit.Block(parent, \"WelcomeBoard\", at(0, ENTRANCE.DoorHeightStuds + 3.4, -2), Vector3.new(26, 3.2, 0.5), { color = WHITE })\n	Kit.Sign(welcome, \"WELCOME\", 26, LABEL_DIST * 2, BLUE)\nend\n\n-- ---------------------------------------------------------------------------------------\n-- The shell: slabs, walls, glass, columns, roof.\n-- ---------------------------------------------------------------------------------------\n\n-- One storey\\'s floor slab, with the atrium cut out of it as four rectangles around the void.\n--\n-- Four pieces rather than a slab with a hole, because Roblox has no hole: a floor is solid\n-- or it is not there, and the only way to have a void in one is to lay the ring around it.\n-- One storey's floor slab.\n--\n-- **The upper floor is solid except for the two stairwells.** It used to be cut to the whole\n-- footprint of the atrium -- ninety studs by thirty-six of nothing -- on the theory that this\n-- made the lobby a double-height space. What it actually made was a first floor with its\n-- middle missing: you came up a flight and arrived at the edge of a hole, and the fix for that\n-- was a landing slab hanging in mid-air at the head of each stair.\n--\n-- Now the only holes are the flights themselves. The lobby keeps its height as two tall shafts\n-- with a staircase in each, which is a better version of the same idea -- daylight comes down\n-- them, you can see between floors, and the bridge between them is somewhere to stand and look\n-- over. Everything else up there is floor you can walk on.\n--\n-- Five pieces, and the shape is worth reading off the names: a band across the front of the\n-- building, a band across the back, and between them the two outer edges plus the bridge down\n-- the middle. The stairwells are what is left over.\nlocal function buildSlabWithVoid(parent: Instance, at: (number, number, number) -> Vector3, name: string, y: number, cut: boolean)\n	local half = W / 2\n	if not cut then\n		Kit.Slab(parent, name, at(0, y, D / 2), W, D, SLAB, { color = TILE })\n		return\n	end\n\n	-- In front of the stairwells: the whole width of the building, from the front wall to where\n	-- the flights begin. This band did not exist before and is most of what was missing.\n	Kit.Slab(parent, `{name}Front`, at(0, y, WELL_Z1 / 2), W, WELL_Z1, SLAB, { color = TILE })\n	-- Behind them: the gallery and everything back to the rear wall.\n	Kit.Slab(parent, `{name}Back`, at(0, y, (VOID_Z2 + D) / 2), W, D - VOID_Z2, SLAB, { color = TILE })\n\n	-- The band the stairwells are cut out of, in three pieces.\n	local bandZ = (WELL_Z1 + VOID_Z2) / 2\n	local bandD = VOID_Z2 - WELL_Z1\n	local edgeW = half - WELL_X_OUT\n	Kit.Slab(parent, `{name}Left`, at((-half - WELL_X_OUT) / 2, y, bandZ), edgeW, bandD, SLAB, { color = TILE })\n	Kit.Slab(parent, `{name}Right`, at((half + WELL_X_OUT) / 2, y, bandZ), edgeW, bandD, SLAB, { color = TILE })\n	-- The bridge between the two stairwells, over the middle of the lobby.\n	Kit.Slab(parent, `{name}Bridge`, at(0, y, bandZ), WELL_X_IN * 2, bandD, SLAB, { color = TILE })\n\n	-- A rail round each stairwell, or the first person to walk the bridge in the dark goes over\n	-- the side. This is the one piece of the building that is safety rather than decoration.\n	for side = -1, 1, 2 do\n		local outer = side * WELL_X_OUT\n		local inner = side * WELL_X_IN\n		local tag = if side < 0 then \"L\" else \"R\"\n		-- The inner edge, along the bridge.\n		Kit.Railing(parent, `{name}Well{tag}Inner`, at(inner, y, WELL_Z1), at(inner, y, VOID_Z2), 4, PALE_BLUE)\n		-- The front edge, along the new front band.\n		Kit.Railing(parent, `{name}Well{tag}Front`, at(inner, y, WELL_Z1), at(outer, y, WELL_Z1), 4, PALE_BLUE)\n		-- And the outer edge against the atrium wall. It is a drop like the other two; the only\n		-- side left open is the one the stairs arrive on, which is the point of the whole thing.\n		Kit.Railing(parent, `{name}Well{tag}Outer`, at(outer, y, WELL_Z1), at(outer, y, VOID_Z2), 4, PALE_BLUE)\n	end\nend\n\n\n-- The front of the building: pediment, crest, welcome board, pilasters, hedges and lamps.\n--\n-- Split out of buildShell rather than folded into it, because everything here is *elevation*\n-- rather than structure -- none of it holds a floor up, and all of it exists so the school\n-- reads as a school from the road. buildShell is about where the walls are; this is about\n-- what the walls look like when you arrive.\nlocal function buildFrontage(parent: Instance, at: (number, number, number) -> Vector3)\n	local half = W / 2\n	local roofY = 0.4 + FLOOR_H * BUILDING.Floors\n\n	-- The pediment, stepped rather than a true triangle: Roblox has no wedge in this kit and a\n	-- staircase of five slabs reads as a gable from the ground, which is the only place anyone\n	-- looks at it from.\n	for step = 1, ENTRANCE.PedimentSteps do\n		local share = (step - 1) / ENTRANCE.PedimentSteps\n		local width = ENTRANCE.PedimentWidthStuds * (1 - share)\n		local y = roofY + (ENTRANCE.PedimentRiseStuds / ENTRANCE.PedimentSteps) * (step - 0.5)\n		Kit.Block(parent, `Pediment{step}`, at(0, y, -1.2), Vector3.new(width, ENTRANCE.PedimentRiseStuds / ENTRANCE.PedimentSteps + 0.2, 3), {\n			color = WHITE,\n		})\n	end\n\n	-- The crest. A disc with the school's initials on it, which is the detail the reference\n	-- puts dead centre above the doors and the one that makes the building feel named.\n	local crest = Instance.new(\"Part\")\n	crest.Name = \"Crest\"\n	crest.Shape = Enum.PartType.Cylinder\n	crest.Size = Vector3.new(1.2, ENTRANCE.CrestRadiusStuds * 2, ENTRANCE.CrestRadiusStuds * 2)\n	-- Turned to face the road: a Roblox cylinder runs along X, so it needs a quarter turn about\n	-- Y to present its face forward rather than its edge.\n	crest.CFrame = CFrame.new(at(0, roofY - 6, -2)) * CFrame.Angles(0, math.rad(90), 0)\n	crest.Anchored = true\n	crest.CanCollide = false\n	crest.Color = PALE_BLUE\n	crest.Material = Enum.Material.SmoothPlastic\n	crest.Parent = parent\n\n	local crestFace = Kit.Block(parent, \"CrestFace\", at(0, roofY - 6, -2.7), Vector3.new(ENTRANCE.CrestRadiusStuds * 1.3, ENTRANCE.CrestRadiusStuds * 1.3, 0.3), {\n		color = WHITE,\n	})\n	crestFace.CastShadow = false\n	Kit.Sign(crestFace, \"AGES\\nHIGH\", ENTRANCE.CrestRadiusStuds * 1.2, LABEL_DIST * 2, Color3.fromRGB(46, 96, 168))\n\n	-- The welcome board over the doors.\n	local welcome = Kit.Block(parent, \"WelcomeBoard\", at(0, ENTRANCE.CanopyHeightStuds + 3.5, -1.4), Vector3.new(30, 5, 0.5), {\n		color = PALE_BLUE,\n	})\n	welcome.CastShadow = false\n	Kit.Sign(welcome, \"WELCOME\", 26, LABEL_DIST * 2, Color3.fromRGB(255, 255, 255))\n\n	-- Blue pilasters up the elevation. Full height, so they read as structure rather than as\n	-- paint, and skipped across the entrance bay so they never cross the doors or the crest.\n	for index = 1, ENTRANCE.PilasterCount do\n		local share = (index - 0.5) / ENTRANCE.PilasterCount\n		local x = -half + W * share\n		-- Clear of the pediment, and clear of the wings either side of it. It skipped the first\n		-- and not the second, so four pilasters were striping the front of a wing from inside it.\n		local wingIn = ENTRANCE.PedimentWidthStuds / 2 + 4\n		local wingOut = ENTRANCE.PedimentWidthStuds / 2 + ENTRANCE.WingWidthStuds + 4\n		if math.abs(x) > wingIn and math.abs(x) > wingOut then\n			Kit.Block(parent, `Pilaster{index}`, at(x, roofY / 2, -0.9), Vector3.new(ENTRANCE.PilasterWidthStuds, roofY, 1.6), {\n				color = PALE_BLUE,\n			}).CastShadow = false\n		end\n	end\n\n	-- The wings, brought forward either side of the entrance. Laid before the planting so the\n	-- hedges and cones sit in the courtyard they make rather than in open ground.\n	local wingOffset = ENTRANCE.PedimentWidthStuds / 2 + ENTRANCE.WingWidthStuds / 2 + 4\n	for side = -1, 1, 2 do\n		local wx = side * wingOffset\n		local wz = -ENTRANCE.WingProjectionStuds / 2\n		local wingH = FLOOR_H * 2\n\n		-- The body of the wing, glazed on the front the way the reference's are.\n		Kit.Block(parent, `Wing{side}`, at(wx, wingH / 2, wz), Vector3.new(ENTRANCE.WingWidthStuds, wingH, ENTRANCE.WingDepthStuds), {\n			color = WHITE,\n		})\n		Kit.GlassWall(\n			parent,\n			`WingGlass{side}`,\n			at(wx - ENTRANCE.WingWidthStuds / 2 + 2, 0.4, wz - ENTRANCE.WingDepthStuds / 2 - 0.6),\n			at(wx + ENTRANCE.WingWidthStuds / 2 - 2, 0.4, wz - ENTRANCE.WingDepthStuds / 2 - 0.6),\n			wingH - 2,\n			1,\n			0.7,\n			PALE_BLUE,\n			GLASS_TINT\n		)\n\n		-- The pitched roof, stepped for the reason the pediment is: no wedge in the kit, and a\n		-- staircase of four slabs reads as a pitch from the ground.\n		for step = 1, ENTRANCE.WingRoofSteps do\n			local share = (step - 1) / ENTRANCE.WingRoofSteps\n			local depth = ENTRANCE.WingDepthStuds * (1 - share * 0.82)\n			local y = wingH + (ENTRANCE.WingRoofRiseStuds / ENTRANCE.WingRoofSteps) * (step - 0.5)\n			Kit.Block(parent, `WingRoof{side}_{step}`, at(wx, y, wz), Vector3.new(ENTRANCE.WingWidthStuds + 2 - share * 4, ENTRANCE.WingRoofRiseStuds / ENTRANCE.WingRoofSteps + 0.2, depth), {\n				color = Color3.fromRGB(122, 158, 206),\n			})\n		end\n	end\n\n	-- Tall clipped cones down the forecourt, and the railings along the road. Both are pure\n	-- silhouette and both are what the reference's approach is made of.\n	for side = -1, 1, 2 do\n		for index = 1, ENTRANCE.TopiaryPerSide do\n			local z = -14 - (index / (ENTRANCE.TopiaryPerSide + 1)) * ENTRANCE.PlazaDepthStuds\n			local x = side * (ENTRANCE.PlazaWidthStuds / 2 - 10)\n			for tier = 1, ENTRANCE.TopiaryTiers do\n				local share = (tier - 1) / ENTRANCE.TopiaryTiers\n				local w = 7 * (1 - share * 0.86)\n				local y = 1 + (ENTRANCE.TopiaryHeightStuds / ENTRANCE.TopiaryTiers) * (tier - 0.5)\n				Kit.Block(parent, `Topiary{side}_{index}_{tier}`, at(x, y, z), Vector3.new(w, ENTRANCE.TopiaryHeightStuds / ENTRANCE.TopiaryTiers + 0.2, w), {\n					color = Color3.fromRGB(78, 138, 84),\n					material = Enum.Material.Grass,\n					collide = false,\n				}).CastShadow = false\n			end\n		end\n	end\n\n	-- The railings. A gap is left dead centre for the way in -- a fence with no gate reads as a\n	-- compound, and the entrance is the whole point of this elevation.\n	local railZ = -ENTRANCE.PlazaDepthStuds - 12\n	local railSpan = ENTRANCE.PlazaWidthStuds + ENTRANCE.WingWidthStuds * 2\n	for index = 1, ENTRANCE.RailingPosts do\n		local share = (index - 0.5) / ENTRANCE.RailingPosts\n		local x = -railSpan / 2 + railSpan * share\n		if math.abs(x) > ENTRANCE.GateWidthStuds / 2 then\n			Kit.Column(parent, `Railing{index}`, at(x, 0.4, railZ), 7, 0.5, Color3.fromRGB(38, 40, 48))\n		end\n	end\n	for side = -1, 1, 2 do\n		-- The two gate piers, taller than the run so the opening reads as deliberate.\n		Kit.Column(parent, `GatePier{side}`, at(side * ENTRANCE.GateWidthStuds / 2, 0.4, railZ), 10, 2, WHITE)\n	end\n\n	-- Flagpoles either side of the doors.\n	for side = -1, 1, 2 do\n		for index = 1, ENTRANCE.FlagpolesPerSide do\n			-- Outboard of the wings. At pediment/2 + 8 these stood inside one.\n			local x = side * (ENTRANCE.PedimentWidthStuds / 2 + ENTRANCE.WingWidthStuds + 10 + index * 6)\n			Kit.Column(parent, `Flagpole{side}_{index}`, at(x, 0.4, -10), ENTRANCE.FlagpoleHeightStuds, 0.7, WHITE)\n			Kit.Block(parent, `Flag{side}_{index}`, at(x + side * 3.4, ENTRANCE.FlagpoleHeightStuds - 3, -10), Vector3.new(6.4, 4, 0.2), {\n				color = PALE_BLUE,\n			}).CastShadow = false\n		end\n	end\n\n	-- Clipped hedges and lamp standards down the approach. The reference lines its forecourt\n	-- with both, and a bare slab of concrete in front of a school is the one thing that makes\n	-- an otherwise finished building look unfinished.\n	local plazaD = ENTRANCE.PlazaDepthStuds\n	for side = -1, 1, 2 do\n		for index = 1, ENTRANCE.HedgesPerSide do\n			local z = -6 - (index / (ENTRANCE.HedgesPerSide + 1)) * plazaD\n			Kit.Block(parent, `Hedge{side}_{index}`, at(side * (ENTRANCE.PedimentWidthStuds / 2 + ENTRANCE.WingWidthStuds + 14), 2.4, z), Vector3.new(9, 4.4, 9), {\n				color = Color3.fromRGB(96, 150, 96),\n				material = Enum.Material.Grass,\n			})\n		end\n		for index = 1, ENTRANCE.LampsPerSide do\n			local z = -10 - (index / (ENTRANCE.LampsPerSide + 1)) * plazaD\n			local x = side * (ENTRANCE.PlazaWidthStuds / 2 - 3)\n			Kit.Column(parent, `LampPost{side}_{index}`, at(x, 0.4, z), 16, 1, CONCRETE)\n			Kit.Block(parent, `LampHead{side}_{index}`, at(x, 16.6, z), Vector3.new(3.4, 1.2, 3.4), {\n				color = Color3.fromRGB(255, 246, 214),\n				material = Enum.Material.Neon,\n			}).CastShadow = false\n		end\n	end\nend\n\nlocal function buildShell(parent: Instance, at: (number, number, number) -> Vector3)\n	local half = W / 2\n\n	for floor = 1, BUILDING.Floors do\n		local y = floorY(floor)\n		-- The ground floor is solid; the ones above it are cut, which is what makes the atrium\n		-- a three-storey space rather than a tall ground-floor room.\n		buildSlabWithVoid(parent, at, `Floor{floor}`, y, floor > 1)\n\n		-- The front elevation is glass, because that is what the reference is and because it is\n		-- what lets the building be read from the road at all.\n		--\n		-- **It no longer follows the slabs.** The glazing is laid in ExteriorBands rows over the\n		-- whole wall rather than one row per floor, so the street sees three storeys while the\n		-- inside has two. An elevation is a pattern of windows and floor bands; nothing requires\n		-- it to agree with where the slabs are, and double-height rooms behind a three-band\n		-- facade is a thing real buildings do.\n		--\n		-- Laid on the first pass only, since it spans the whole height rather than one storey.\n		if floor == 1 then\n			local wallTop = FLOOR_H * BUILDING.Floors\n			local bandH = wallTop / BUILDING.ExteriorBands\n			for band = 1, BUILDING.ExteriorBands do\n				local bandY = (band - 1) * bandH\n				-- The glazing stops short of the spandrel rather than running up behind it. A\n				-- glass wall draws its own head band at the top, and that head was landing inside\n				-- the concrete spandrel -- two solid parts in the same 3 studs of wall.\n				Kit.GlassWall(parent, `FrontGlass{band}`, at(-half, bandY, 0), at(half, bandY, 0), bandH - 4.2, WALL_T, BUILDING.GlassShare, WHITE, GLASS_TINT)\n				-- The floor band on the face, and a spandrel behind it. Three of these is what\n				-- makes the building read as three storeys.\n				Kit.Block(parent, `Spandrel{band}`, at(0, bandY + bandH - 2, -0.5), Vector3.new(W, 3, 1.4), {\n					color = OFF_WHITE,\n					material = Enum.Material.Concrete,\n				})\n				Kit.Block(parent, `Band{band}`, at(0, bandY + bandH - 0.6, -0.4), Vector3.new(W, 1.4, 1.2), { color = BLUE })\n			end\n		end\n\n		-- The back and the two ends are solid, with a blue band at each floor line -- one\n		-- accent doing the job of saying where the storeys are from outside.\n		-- The three solid elevations, in render rather than flat plastic.\n		--\n		-- The research is blunt about this: one material everywhere reads as a greybox however\n		-- good the geometry is, and material variety carries more than colour variety does. These\n		-- were SmoothPlastic white -- the default -- which is why the building looked unfinished\n		-- in every screenshot regardless of what was added to it.\n		Kit.Wall(parent, `BackWall{floor}`, at(-half, y, D), at(half, y, D), FLOOR_H - SLAB, WALL_T, {\n			color = WHITE,\n			material = Enum.Material.Concrete,\n		})\n		Kit.Wall(parent, `LeftWall{floor}`, at(-half, y, 0), at(-half, y, D), FLOOR_H - SLAB, WALL_T, {\n			color = WHITE,\n			material = Enum.Material.Concrete,\n		})\n		Kit.Wall(parent, `RightWall{floor}`, at(half, y, 0), at(half, y, D), FLOOR_H - SLAB, WALL_T, {\n			color = WHITE,\n			material = Enum.Material.Concrete,\n		})\n\n\n		-- Columns down the front, on the grid the canopy sits on.\n		for index = 1, ENTRANCE.ColumnCount do\n			local share = (index - 0.5) / ENTRANCE.ColumnCount\n			local x = -half + W * share\n			-- Not where a wing already stands. These ran the full width of the elevation and the\n			-- wings were added later in front of them, so four columns were buried in solid\n			-- masonry -- invisible from outside and standing in the way inside.\n			if math.abs(x) > ENTRANCE.PedimentWidthStuds / 2 + ENTRANCE.WingWidthStuds + 4 or math.abs(x) < ENTRANCE.PedimentWidthStuds / 2 then\n				Kit.Column(parent, `Column{floor}_{index}`, at(x, y, 3), FLOOR_H - SLAB, 3.4, CONCRETE)\n			end\n		end\n	end\n\n	-- The roof, and a glazed lantern over the atrium so the three-storey space is daylit from\n	-- above rather than being a dark shaft.\n	local roofY = floorY(BUILDING.Floors + 1)\n	Kit.Slab(parent, \"RoofFront\", at(0, roofY, ATRIUM_Z1 / 2), W, ATRIUM_Z1, SLAB * 2, { color = OFF_WHITE })\n	Kit.Slab(parent, \"RoofBack\", at(0, roofY, (ATRIUM_Z2 + D) / 2), W, D - ATRIUM_Z2, SLAB * 2, { color = OFF_WHITE })\n	local sideW = half + ATRIUM_X1\n	Kit.Slab(parent, \"RoofLeft\", at((-half + ATRIUM_X1) / 2, roofY, (ATRIUM_Z1 + ATRIUM_Z2) / 2), sideW, ATRIUM_Z2 - ATRIUM_Z1, SLAB * 2, { color = OFF_WHITE })\n	Kit.Slab(parent, \"RoofRight\", at((half + ATRIUM_X2) / 2, roofY, (ATRIUM_Z1 + ATRIUM_Z2) / 2), sideW, ATRIUM_Z2 - ATRIUM_Z1, SLAB * 2, { color = OFF_WHITE })\n\n	-- The crown: a cornice at the roofline and a parapet standing above it.\n	--\n	-- Laid as four runs round the perimeter rather than as one box, because the front of the\n	-- building is glass and a parapet that crossed the glazing head would read as a beam\n	-- floating in front of the windows.\n	local proud = BUILDING.CorniceProudStuds\n	local corniceRuns = {\n		{ name = \"CorniceFront\", a = at(-half - proud, roofY, -proud), b = at(half + proud, roofY, -proud) },\n		{ name = \"CorniceBack\", a = at(-half - proud, roofY, D + proud), b = at(half + proud, roofY, D + proud) },\n		{ name = \"CorniceLeft\", a = at(-half - proud, roofY, -proud), b = at(-half - proud, roofY, D + proud) },\n		{ name = \"CorniceRight\", a = at(half + proud, roofY, -proud), b = at(half + proud, roofY, D + proud) },\n	}\n	for _, run in corniceRuns do\n		-- The cornice oversails, so it throws a shadow line along the top of the wall. That\n		-- shadow is the whole point: it is what separates the building from the sky.\n		local band = Kit.Wall(parent, run.name, run.a, run.b, 2.2, WALL_T + proud * 2, { color = OFF_WHITE })\n		if band ~= nil then\n			band.CastShadow = false\n		end\n		-- And the parapet above it, set back to the wall line.\n		Kit.Wall(\n			parent,\n			run.name:gsub(\"Cornice\", \"Parapet\"),\n			run.a + Vector3.new(0, 2.2, 0),\n			run.b + Vector3.new(0, 2.2, 0),\n			BUILDING.ParapetHeightStuds,\n			WALL_T,\n			{ color = WHITE }\n		)\n	end\n\n	-- A blue coping capping the parapet, which is the school's own accent finishing the\n	-- building rather than an extra colour introduced at the top.\n	for _, run in corniceRuns do\n		local cap = Kit.Wall(\n			parent,\n			run.name:gsub(\"Cornice\", \"Coping\"),\n			run.a + Vector3.new(0, 2.2 + BUILDING.ParapetHeightStuds, 0),\n			run.b + Vector3.new(0, 2.2 + BUILDING.ParapetHeightStuds, 0),\n			0.9,\n			WALL_T + 1.2,\n			{ color = BLUE }\n		)\n		if cap ~= nil then\n			cap.CastShadow = false\n		end\n	end\n\n	-- The base course. A wall that meets the ground with nothing at the bottom looks dropped\n	-- rather than built, and this is four parts.\n	local doorGap = ENTRANCE.DoorWidthStuds / 2 + 4\n	local plinthRuns = {\n		-- **Broken at the doorway.** The base course ran unbroken across the front, which put a\n		-- 4-stud kerb 1.2 studs outside the doors: a step up at the exact spot the building\n		-- wants you to walk through. A plinth is meant to look like the wall is founded on\n		-- something, not to be a threshold you climb, so the opening gets a gap.\n		{ name = \"PlinthFrontL\", a = at(-half, 0.3, -BUILDING.PlinthProudStuds), b = at(-doorGap, 0.3, -BUILDING.PlinthProudStuds) },\n		{ name = \"PlinthFrontR\", a = at(doorGap, 0.3, -BUILDING.PlinthProudStuds), b = at(half, 0.3, -BUILDING.PlinthProudStuds) },\n		{ name = \"PlinthBack\", a = at(-half, 0.3, D + BUILDING.PlinthProudStuds), b = at(half, 0.3, D + BUILDING.PlinthProudStuds) },\n		{ name = \"PlinthLeft\", a = at(-half - BUILDING.PlinthProudStuds, 0.3, 0), b = at(-half - BUILDING.PlinthProudStuds, 0.3, D) },\n		{ name = \"PlinthRight\", a = at(half + BUILDING.PlinthProudStuds, 0.3, 0), b = at(half + BUILDING.PlinthProudStuds, 0.3, D) },\n	}\n	for _, run in plinthRuns do\n		Kit.Wall(parent, run.name, run.a, run.b, BUILDING.PlinthHeightStuds, WALL_T + BUILDING.PlinthProudStuds, {\n			color = CONCRETE,\n			material = Enum.Material.Concrete,\n		})\n	end\n\n	local lantern = Kit.Slab(parent, \"Lantern\", at(0, roofY, (ATRIUM_Z1 + ATRIUM_Z2) / 2), BUILDING.AtriumWidthStuds, BUILDING.AtriumDepthStuds, 0.5, {\n		color = GLASS_TINT,\n		material = Enum.Material.Glass,\n		transparency = 0.6,\n		collide = true,\n	})\n	lantern.CastShadow = false\n\n	-- The entrance canopy, and the doors under it.\n	-- The canopy clears the door head rather than cutting across it. Its soffit was at 15.5\n	-- against a 17-stud door, so from the plaza the roof crossed the top of the opening and the\n	-- way in read as a dark slot under a shelf. A canopy has to be higher than the thing it\n	-- shelters or it hides it.\n	Kit.Slab(parent, \"Canopy\", at(0, ENTRANCE.CanopyHeightStuds, -ENTRANCE.CanopyDepthStuds / 2), ENTRANCE.PlazaWidthStuds, ENTRANCE.CanopyDepthStuds, 1.4, {\n		color = WHITE,\n	})\n	-- **The columns stand clear of the doorway.**\n	--\n	-- They were spaced -21, -7, +7, +21 across a door that runs -10 to +10, so the two inner\n	-- ones stood directly in front of it -- a pair of posts planted across the way in, which is\n	-- what made the entrance unreadable from the plaza however big the doors got.\n	--\n	-- A canopy's columns belong at its ends. Splitting them either side of the opening leaves\n	-- the middle clear, which is the whole job of an entrance: you should be able to see the\n	-- door from the road and walk at it in a straight line.\n	-- The gap they have to live in is narrow and both walls of it are hard: the door runs to\n	-- +/-10 and the entrance wings start at +/-26, so a column belongs between about 12 and 24.\n	-- Spread wider than that and it stands inside the wing.\n	-- One each side, and one is all that fits. The door is DoorWidthStuds wide -- 40, so it runs\n	-- to +/-20 -- and the entrance wings begin at +/-26. That leaves a six-stud slot on each\n	-- flank and nothing anywhere else, which is why four columns could not be arranged without\n	-- either standing in the doorway or standing inside a wing. Two columns, hard against the\n	-- wings, and the whole opening between them is clear.\n	local clear = ENTRANCE.DoorWidthStuds / 2 + 3\n	for index = 1, 2 do\n		local x = (if index == 1 then -1 else 1) * clear\n		Kit.Column(parent, `CanopyColumn{index}`, at(x, 0.4, -ENTRANCE.CanopyDepthStuds + 2), ENTRANCE.CanopyHeightStuds, 2.2, WHITE)\n	end\n	-- One wide opening with two leaves in it, rather than the four separate panels that used\n	-- to be here. Four panels with gaps between them read from the plaza as a row of windows,\n	-- and the way in is the one thing an entrance elevation has to say clearly.\n	--\n	-- The leaves are named EntranceDoorLeaf so FixtureService can find them: they are the only\n	-- moving part of the building, and pressing E on them swings them open.\n	local doorW = ENTRANCE.DoorWidthStuds\n	local doorH = ENTRANCE.DoorHeightStuds\n\n	-- The frame: jambs and a head, in the school's blue so the opening is legible from the road.\n	for side = -1, 1, 2 do\n		Kit.Block(parent, `DoorJamb{side}`, at(side * (doorW / 2 + 1.2), doorH / 2, 0), Vector3.new(2.4, doorH + 2, 2.4), {\n			color = BLUE,\n		})\n	end\n	Kit.Block(parent, \"DoorHead\", at(0, doorH + 1.2, 0), Vector3.new(doorW + 7, 2.4, 2.4), { color = BLUE })\n\n	-- The two leaves. Non-collidable, because a door you have to open before you can walk\n	-- through is a door that will strand somebody the first time the prompt is out of reach --\n	-- the swing is a flourish, not a gate.\n	for side = -1, 1, 2 do\n		-- **Wood, and solid.** These were tinted glass, which at this size read as two more\n		-- panes in a fully glazed elevation -- you could not tell where the way in was. A timber\n		-- door in a glass wall is the oldest trick there is for making an entrance legible, and\n		-- it is the one thing on this facade that should not look like the rest of it.\n		--\n		-- Collidable, because a door that opens has to have been shut.\n		Kit.Block(parent, `EntranceDoorLeaf{side}`, at(side * doorW / 4, doorH / 2, 0), Vector3.new(doorW / 2 - 0.4, doorH, 0.7), {\n			color = WALNUT,\n			material = Enum.Material.WoodPlanks,\n			collide = true,\n		})\n		-- Rails and stiles, so the leaf reads as a made door rather than a plank.\n		for panel = 1, 2 do\n			Kit.Block(parent, `EntranceDoorPanel{side}_{panel}`, at(side * doorW / 4, doorH * (if panel == 1 then 0.28 else 0.68), -0.45), Vector3.new(doorW / 2 - 4.5, doorH * 0.3, 0.25), {\n				color = Color3.fromRGB(78, 54, 38),\n				material = Enum.Material.Wood,\n			}).CastShadow = false\n		end\n		-- A glazed light at head height: a solid door with no window is a door you walk into\n		-- somebody through.\n		Kit.Block(parent, `EntranceDoorLight{side}`, at(side * doorW / 4, doorH * 0.86, 0), Vector3.new(doorW / 2 - 5, doorH * 0.16, 0.3), {\n			color = GLASS_TINT,\n			material = Enum.Material.Glass,\n			transparency = 0.4,\n		}).CastShadow = false\n		-- A push bar, which is what makes a glass panel read as a door rather than as a window.\n		Kit.Block(parent, `DoorBar{side}`, at(side * doorW / 4, doorH * 0.45, -0.5), Vector3.new(doorW / 2 - 4, 0.6, 0.6), {\n			color = Color3.fromRGB(206, 212, 222),\n			material = Enum.Material.Metal,\n		}).CastShadow = false\n	end\nend\n\n-- ---------------------------------------------------------------------------------------\n-- The lobby: what is in the atrium.\n-- ---------------------------------------------------------------------------------------\n\n-- The atrium was circulation and nothing else -- three storeys of air, a stair at each end, a\n-- rail round the hole and not one object in it. It is the first room anybody walks into and it\n-- was the emptiest space in the building.\n--\n-- The banners do the load-bearing work. The atrium's whole reason for existing is that it is\n-- three storeys tall, and *nothing in it used that height* -- so the space read as a tall room\n-- rather than as a volume. A banner hanging the full drop is the cheapest thing that makes the\n-- height legible: you read the building's scale off the banner, because you are not looking at\n-- the ceiling.\nlocal function buildLobby(parent: Instance, at: (number, number, number) -> Vector3)\n	local cz = (ATRIUM_Z1 + ATRIUM_Z2) / 2\n	local roofY = floorY(BUILDING.Floors + 1)\n\n	-- A feature wall behind the reception, full height of the two-storey lobby.\n	--\n	-- The back of the lobby was blank above head height, which in a room now 54 studs tall is a\n	-- lot of nothing directly in front of anyone walking in. The reference puts the school crest\n	-- on exactly that wall.\n	-- The feature wall is now behind the gallery rather than facing a full-height void, so it\n	-- is a one-storey wall. Left at two storeys it would have run straight through the gallery\n	-- slab -- the same mistake as the lockers in the logo, one floor up.\n	local featureZ = ATRIUM_Z2 - 1.2\n	local featureH = FLOOR_H - 2\n	Kit.Block(parent, \"LobbyFeature\", at(0, featureH / 2, featureZ), Vector3.new(BUILDING.AtriumWidthStuds * 0.5, featureH, 0.5), {\n		color = Color3.fromRGB(206, 212, 222),\n		material = Enum.Material.Concrete,\n	})\n	for ring = 1, 3 do\n		local radius = 9 * (1 - (ring - 1) * 0.3)\n		local disc = Kit.Block(parent, `LobbyCrest{ring}`, at(0, featureH * 0.62, featureZ - 0.4 - ring * 0.1), Vector3.new(0.3, radius * 2, radius * 2), {\n			color = if ring % 2 == 1 then BLUE else WHITE,\n		})\n		disc.Shape = Enum.PartType.Cylinder\n		disc.CFrame = CFrame.new(at(0, featureH * 0.62, featureZ - 0.4 - ring * 0.1)) * CFrame.Angles(0, math.rad(90), 0)\n		disc.Size = Vector3.new(0.3, radius * 2, radius * 2)\n		disc.CastShadow = false\n	end\n\n	-- **The gallery fascia, and the fins that carry the height.**\n	--\n	-- Two things a 54-stud atrium needs that a 27-stud one does not.\n	--\n	-- The fascia first: standing in the lobby you look up at the cut edge of the upper floor\n	-- slab, and a raw slab edge reads as a hole in the floor rather than as a balcony. A band\n	-- on that edge, in the school's blue, is what turns the void into a gallery -- and it is\n	-- the line that tells you from the ground floor that there is a floor above you.\n	-- **It traces the two stairwells, and it does not cross the head of a flight.**\n	--\n	-- This used to trace the old full-width void as a single rectangle: Front, Back, Left,\n	-- Right. When the first floor was filled in and the openings became the two stairwells, the\n	-- rectangle stopped describing anything real -- and its Back band, 92 studs wide at\n	-- z = VOID_Z2, ran straight across the point where *both* staircases arrive. A 2.8-stud lip\n	-- at the top of a flight is a thing you walk into at head height on your way out of it.\n	--\n	-- So: three edges per well, not four. Inner (along the bridge), Front, and Outer against the\n	-- atrium wall -- each of those is a genuine cut edge of the slab and wants trimming. The\n	-- fourth side is where you step off the stairs and gets nothing at all, which is the same\n	-- rule the study counter above already follows.\n	local edges = {}\n	for side = -1, 1, 2 do\n		local tag = if side < 0 then \"L\" else \"R\"\n		local inner = side * WELL_X_IN\n		local outer = side * WELL_X_OUT\n		local midZ = (WELL_Z1 + VOID_Z2) / 2\n		local depth = VOID_Z2 - WELL_Z1\n		table.insert(edges, { n = `{tag}Inner`, cx = inner, cz = midZ, sx = 1.4, sz = depth })\n		table.insert(edges, { n = `{tag}Outer`, cx = outer, cz = midZ, sx = 1.4, sz = depth })\n		table.insert(edges, { n = `{tag}Front`, cx = (inner + outer) / 2, cz = WELL_Z1, sx = math.abs(outer - inner) + 1.4, sz = 1.4 })\n	end\n	for _, edge in edges do\n		local slabY = floorY(2)\n		Kit.Block(parent, `GalleryFascia{edge.n}`, at(edge.cx, slabY - 1.4, edge.cz), Vector3.new(edge.sx, 2.8, edge.sz), {\n			color = DEEP_BLUE,\n		}).CastShadow = false\n		Kit.Block(parent, `GallerySoffit{edge.n}`, at(edge.cx, slabY - 3, edge.cz), Vector3.new(edge.sx - 0.6, 0.6, edge.sz - 0.6), {\n			color = OFF_WHITE,\n		}).CastShadow = false\n	end\n\n	-- The fins that used to run down both flanks of the void are gone. They were added to give\n	-- a 54-stud wall a countable rhythm, and in a space this size they read as a row of pillars\n	-- standing in the middle of the room for no reason -- which is what they were. The gallery\n	-- fascia and the glazing already give the atrium its horizontal lines; it did not need\n	-- vertical ones as well.\n\n	-- **A plain landing platform at the head of each flight.**\n	--\n	-- There was a study counter along this gallery -- desk, fascia, stools and lamps -- on the\n	-- reasoning that a balcony over an atrium is the best seat in a school. The reasoning was\n	-- fine and the arithmetic was not. It was set to start 26 studs off the centreline to keep\n	-- clear of the stairs, but a flight's top tread reaches 29 studs out (STAIR_CX plus half the\n	-- stair width), so the counter overlapped **both** stair arrivals by 3.6 studs. A counter\n	-- across the head of a flight is the same mistake as a column across a door, which is exactly\n	-- what the comment here used to claim it was avoiding.\n	--\n	-- What goes there instead is nothing but floor: a plain platform spanning each stairwell's\n	-- width, flush with the gallery, so you come up the stairs and step onto a clear landing.\n	-- Somewhere to arrive is worth more than somewhere to sit, and this is the one spot in the\n	-- building where the two cannot both fit.\n	local galleryY = floorY(2)\n	for side = -1, 1, 2 do\n		local tag = if side < 0 then \"L\" else \"R\"\n		local platformW = STAIR_W + 8\n		local platformD = BUILDING.GalleryDepthStuds - 2\n		Kit.Slab(\n			parent,\n			`StairLanding{tag}`,\n			at(side * STAIR_CX, galleryY, VOID_Z2 + platformD / 2),\n			platformW,\n			platformD,\n			SLAB,\n			{ color = TILE }\n		)\n		-- A nosing strip along the edge the stairs meet, so the join reads as a threshold rather\n		-- than as two slabs that happen to touch.\n		Kit.Block(parent, `StairLanding{tag}Nosing`, at(side * STAIR_CX, galleryY + 0.4, VOID_Z2 + 0.3), Vector3.new(platformW, 0.25, 0.8), {\n			color = Color3.fromRGB(214, 218, 226),\n		}).CastShadow = false\n	end\n\n	-- **The lobby's back corners.**\n	--\n	-- The middle of the lobby is the route from the doors to the stairs and stays clear, but the\n	-- two back corners either side of that route were bare floor. A school entrance hall uses\n	-- those for waiting -- somebody is always waiting outside the office -- so they get a bench,\n	-- a planter and a case of whatever the school is proud of this year.\n	for side = -1, 1, 2 do\n		-- Pulled in against the bridge rather than out at the atrium's edge.\n		--\n		-- These corners sat under what is now a stairwell -- a planter, a shrub and a bench leg\n		-- were standing inside the footprint of each flight, at the bottom where you start\n		-- climbing. Moving them inboard puts them under the bridge instead, which is a\n		-- sheltered spot to wait and is not in anybody's way.\n		local wx = side * (WELL_X_IN - 5)\n		local wz = ATRIUM_Z1 + 12\n\n		Kit.Block(parent, `WaitBench{side}`, at(wx, 2.3, wz), Vector3.new(6, 0.7, 20), {\n			color = WALNUT,\n			material = Enum.Material.Wood,\n			collide = true,\n		})\n		for leg = -1, 1, 2 do\n			Kit.Block(parent, `WaitBenchLeg{side}_{leg}`, at(wx, 1.15, wz + leg * 7), Vector3.new(5, 2.3, 0.8), {\n				color = Color3.fromRGB(96, 102, 114),\n				material = Enum.Material.Metal,\n			}).CastShadow = false\n		end\n		Kit.Block(parent, `WaitBenchBack{side}`, at(wx - side * 2.6, 4.4, wz), Vector3.new(0.8, 4.4, 20), {\n			color = Color3.fromRGB(104, 118, 176),\n			material = Enum.Material.Fabric,\n		}).CastShadow = false\n\n		Kit.Block(parent, `LobbyPlanter{side}`, at(wx, 1.8, wz + 15), Vector3.new(6, 3.6, 6), {\n			color = Color3.fromRGB(196, 202, 214),\n			material = Enum.Material.Concrete,\n			collide = true,\n		})\n		Kit.Block(parent, `LobbyPlanterSoil{side}`, at(wx, 3.7, wz + 15), Vector3.new(5.2, 0.4, 5.2), {\n			color = Color3.fromRGB(72, 56, 42),\n		}).CastShadow = false\n		for leaf = 1, 3 do\n			Kit.Block(parent, `LobbyShrub{side}_{leaf}`, at(wx + (leaf - 2) * 1.6, 6.2 + leaf * 0.6, wz + 15 + (leaf - 2) * 0.8), Vector3.new(1.4, 5.6, 1.4), {\n				color = Color3.fromRGB(74, 126, 74),\n				material = Enum.Material.Grass,\n			}).CastShadow = false\n		end\n	end\n\n	-- The banners are gone.\n	--\n	-- Four fabric drops 9 studs wide and 39 tall, hung across the atrium on the old full-width\n	-- void. When the first floor was cut back to just the two stairwells they stopped hanging in\n	-- open space and started hanging *through* them: banner 1 at x -570 fell straight down the\n	-- left flight and banner 4 down the right one. From the gallery they read as two enormous\n	-- blue slabs standing in front of the stairs, which is exactly what they were.\n	--\n	-- Nothing replaces them. The atrium's height now comes from the two shafts themselves, and\n	-- hanging anything in a shaft a staircase is already using is how this happened.\n\n\n	-- The desk, facing whoever comes through the doors.\n	-- The desk faces the doors, at the back of the lobby, not just inside them.\n	--\n	-- It sat 8 studs from the front, which put it between the doors and the room -- you walked\n	-- into the back of it. A reception faces the way people arrive from and stands at the far\n	-- side of the space they arrive into, with the stairs to either side of it. The reference\n	-- puts the Director's office in exactly that position: straight ahead as you come in.\n	local deskZ = ATRIUM_Z2 - 8\n	Kit.Block(parent, \"LobbyDesk\", at(0, 2.4, deskZ), Vector3.new(BUILDING.LobbyDeskWidthStuds, 4.8, 6), {\n		color = WOOD,\n		material = Enum.Material.Wood,\n		collide = true,\n	})\n	Kit.Block(parent, \"LobbyDeskTop\", at(0, 5, deskZ), Vector3.new(BUILDING.LobbyDeskWidthStuds + 2, 0.5, 7.4), {\n		color = OFF_WHITE,\n	})\n	local deskFront = Kit.Block(parent, \"LobbyDeskFace\", at(0, 2.6, deskZ - 3.2), Vector3.new(BUILDING.LobbyDeskWidthStuds, 3.4, 0.3), {\n		color = BLUE,\n	})\n	deskFront.CastShadow = false\n	Kit.Sign(deskFront, \"RECEPTION\", 20, LABEL_DIST, Color3.fromRGB(246, 250, 255))\n\n	-- Benches in two facing ranks down the *middle* of the lobby, between the doors and the\n	-- desk. They used to sit out at the sides, which is where the stairs now sweep -- a scan of\n	-- the stair found forty-seven parts within twenty studs of a tread, most of them these and\n	-- the trophy cases. A stair needs air around its foot or arriving at it is an obstacle\n	-- course.\n	for index = 1, BUILDING.LobbyBenches do\n		local side = if index % 2 == 1 then -1 else 1\n		local row = math.floor((index - 1) / 2)\n		local x = side * 7\n		local z = ATRIUM_Z1 + 10 + row * 9\n		Kit.Block(parent, `LobbyBench{index}`, at(x, 2.2, z), Vector3.new(4.5, 0.8, 13), {\n			color = WOOD,\n			material = Enum.Material.Wood,\n			collide = true,\n		})\n		for end_ = -1, 1, 2 do\n			Kit.Block(parent, `LobbyBenchLeg{index}_{end_}`, at(x, 1.1, z + end_ * 5), Vector3.new(3.6, 2.2, 1), {\n				color = Color3.fromRGB(78, 82, 94),\n				material = Enum.Material.Metal,\n			})\n		end\n	end\n\n	-- Planting, because every lobby in the reference has a tree in it and a hard-surfaced room\n	-- three storeys tall needs one thing in it that is not a rectangle.\n	for index = 1, BUILDING.LobbyTrees do\n		local side = if index % 2 == 1 then -1 else 1\n		local row = math.floor((index - 1) / 2)\n		Kit.Planter(\n			parent,\n			`LobbyPlanter{index}`,\n			at(side * (BUILDING.AtriumWidthStuds / 2 - 8), 0.4, ATRIUM_Z1 + 4 + row * 7),\n			5,\n			14\n		)\n	end\n\n	-- The trophy case. One object that says the building has a past, which is a thing no amount\n	-- of clean geometry can say on its own.\n	for index = 1, BUILDING.LobbyCases do\n		local side = if index % 2 == 1 then -1 else 1\n		-- Against the back wall beside the reception, not out at the sides where the stairs are.\n		-- On the side walls at the *front* of the lobby, in the strip the stairs do not reach.\n		-- The sweep occupies z 16-48; this sits at 13, which is the entrance zone.\n		local x = side * (BUILDING.AtriumWidthStuds / 2 - 3)\n		Kit.Block(parent, `TrophyCase{index}`, at(x, 6, ATRIUM_Z1 + 5), Vector3.new(1.5, 12, 16), {\n			color = WOOD,\n			material = Enum.Material.Wood,\n		})\n		local glass = Kit.Block(parent, `TrophyGlass{index}`, at(x - side * 0.9, 6.5, ATRIUM_Z1 + 5), Vector3.new(0.2, 10, 14), {\n			color = GLASS_TINT,\n			material = Enum.Material.Glass,\n			transparency = 0.45,\n		})\n		glass.CastShadow = false\n		for shelf = 1, 3 do\n			for cup = 1, 3 do\n				Kit.Block(\n					parent,\n					`Trophy{index}_{shelf}_{cup}`,\n					at(x, 2.6 + shelf * 3, ATRIUM_Z1 + cup * 3.4),\n					Vector3.new(1, 2.2, 1),\n					{ color = Color3.fromRGB(226, 188, 92), material = Enum.Material.Metal }\n				).CastShadow = false\n			end\n		end\n	end\nend\n\n-- ---------------------------------------------------------------------------------------\n-- Stairs: the reason three storeys are three storeys.\n-- ---------------------------------------------------------------------------------------\n\n-- **Where nothing is allowed to stand: within reach of a staircase.**\n--\n-- A flight that arrives into a bin, a locker bank or a light fitting is a flight players stop\n-- on, and a stair is the one place in a building where stopping is dangerous. So the landings\n-- get a keep-out radius and every fitting loop below asks this before it places anything.\n--\n-- Ten studs measured from the arc's arrival, which is two avatars' width of clear floor in\n-- every direction as you step off.\nlocal STAIR_CLEAR_STUDS = 10\n\n-- The two arrival points, in local coordinates. Derived from the same numbers buildStairs uses\n-- so they cannot drift apart -- if a flight moves, its keep-out zone moves with it.\nlocal function stairArrivals(): { { x: number, z: number } }\n	local out = {}\n	local sweep = math.rad(BUILDING.StairSweepDegrees)\n	for side = -1, 1, 2 do\n		local cx = side * STAIR_CX\n		local startAngle = if side < 0 then math.rad(180) else 0\n		local turn = if side < 0 then -sweep else sweep\n		local endAngle = startAngle + turn\n		table.insert(out, {\n			x = cx + math.cos(endAngle) * BUILDING.StairRadiusStuds,\n			z = STAIR_CZ + math.sin(endAngle) * BUILDING.StairRadiusStuds,\n		})\n	end\n	return out\nend\n\n-- True if a point is too close to either landing to build on.\nlocal function nearStairs(x: number, z: number, pad: number?): boolean\n	local limit = STAIR_CLEAR_STUDS + (pad or 0)\n	for _, landing in stairArrivals() do\n		if math.abs(x - landing.x) < limit and math.abs(z - landing.z) < limit then\n			return true\n		end\n	end\n	return false\nend\n\nlocal function buildStairs(parent: Instance, at: (number, number, number) -> Vector3)\n	-- Two curved flights, one each side of the lobby, sweeping a quarter turn as they climb.\n	--\n	-- Straight flights were the wrong shape for this room twice over. A straight run presents\n	-- its *end* to somebody walking in -- you see a wedge of treads edge-on and it reads as a\n	-- ramp -- and it delivers you facing the way you were already going, which in a lobby is\n	-- back out of the front doors. A flight that sweeps round shows its whole side from the\n	-- entrance, and turns you toward the corridor as you arrive. The building tells you where\n	-- to go next without a sign, which is the thing a good stair does.\n	--\n	-- Each starts near the front of the lobby facing inward and turns 80 degrees toward the\n	-- back, landing on the first floor pointing at the corridor. See Kit.CurvedStairs for why a\n	-- box tread on an arc is close enough to a winder.\n	local rise = floorY(2) - floorY(1)\n	local radius = BUILDING.StairRadiusStuds\n	local width = BUILDING.StairWidthStuds\n	local sweep = math.rad(BUILDING.StairSweepDegrees)\n\n	for side = -1, 1, 2 do\n		-- The turn centre sits inboard of the flight, so the two stairs curve away from each\n		-- other around the middle of the lobby rather than into it.\n		local cx = side * STAIR_CX\n		-- Set back by its own radius plus a margin, so the whole arc lands inside the atrium\n		-- rather than overrunning into the corridor behind it -- and clear of the entrance wings\n		-- in front, which reach z 12 and had seven treads of each flight inside them.\n		-- The turn centre sits a radius short of the back wall, so the arc finishes there and\n		-- the landing meets the corridor. Everything in front of it -- 22 studs of lobby -- is\n		-- the entrance zone, and stays clear.\n		-- Both of these now come from the same constants the floor openings are cut from, so a\n		-- flight and its stairwell cannot drift apart -- which is how the stairs ended up\n		-- arriving over a hole in the first place.\n		local cz = STAIR_CZ\n\n		-- **A true quarter turn: from facing the side wall to facing the corridor.**\n		--\n		-- The first attempt swept -140 to -60 degrees, which looks like a curve written down and\n		-- is nearly a straight line on the ground: across that range sine barely changes, so the\n		-- arc moved 74 studs in x and 5 in z. A flight has to turn through a quadrant to read as\n		-- turning at all.\n		--\n		-- Left stair runs 180 -> 90, right runs 0 -> 90. Both start pointing at their own side\n		-- wall and finish pointing at +z, which is the corridor -- so whichever one you take,\n		-- you arrive facing where you are going.\n		local startAngle = if side < 0 then math.rad(180) else 0\n		local turn = if side < 0 then -sweep else sweep\n\n		local laid = Kit.CurvedStairs(\n			parent,\n			`Stair{side}`,\n			at(cx, floorY(1), cz),\n			radius,\n			startAngle,\n			turn,\n			rise,\n			BUILDING.StairSteps,\n			width,\n			STAIR_TREAD\n		)\n		if not laid then\n			error(\n				`[AGES world] the school stair is too steep: {rise} studs over {BUILDING.StairSteps} steps.`\n					.. ` A Roblox humanoid manages 2 studs a step. Raise Config.School.Building.StairSteps`\n					.. ` or lower FloorHeightStuds.`\n			)\n		end\n\n		-- No landing slab any more. There used to be a 20x20 tile at the head of each flight,\n		-- because the void was cut to the full depth of the atrium and the top tread genuinely\n		-- did deliver you over a hole. Two isolated squares hanging in a double-height space is\n		-- what that looked like from the lobby, and it is the wrong fix: the floor was the thing\n		-- that was missing, not a platform. The gallery is the floor -- see VOID_Z2 -- and the\n		-- flight now tops out on it.\n	end\nend\n\n-- A vending machine. Two kinds off one function, because they are the same cabinet with a\n-- different face -- and building them separately would mean two places to fix the plinth.\n--\n-- The numbered slots are the detail that does the work. A glass box with coloured blocks in\n-- it is a fridge; the same box with 001 through 016 under the shelves is unmistakably a\n-- vending machine, and it costs sixteen labels.\nlocal function buildVendingMachine(parent: Instance, name: string, base: Vector3, snacks: boolean, facing: number)\n	local w, h, d = VEND.WidthStuds, VEND.HeightStuds, VEND.DepthStuds\n\n	local body = Kit.Block(parent, `{name}Body`, base + Vector3.new(0, h / 2, 0), Vector3.new(w, h, d), {\n		color = if snacks then Color3.fromRGB(226, 228, 236) else Color3.fromRGB(44, 52, 96),\n		yawDegrees = facing,\n		collide = true,\n	})\n\n	-- The window, and the shelves behind it.\n	local glassW = w * 0.62\n	local glassX = -w * 0.14\n	Kit.Block(parent, `{name}Glass`, base + Vector3.new(glassX, h * 0.58, -d * 0.52), Vector3.new(glassW, h * 0.6, 0.25), {\n		color = Color3.fromRGB(180, 208, 232),\n		material = Enum.Material.Glass,\n		transparency = 0.5,\n		yawDegrees = facing,\n	}).CastShadow = false\n\n	if snacks then\n		local itemColors = {\n			Color3.fromRGB(214, 76, 68),\n			Color3.fromRGB(72, 122, 206),\n			Color3.fromRGB(96, 176, 108),\n			Color3.fromRGB(232, 176, 72),\n			Color3.fromRGB(238, 238, 240),\n			Color3.fromRGB(104, 72, 54),\n		}\n		for row = 1, VEND.Rows do\n			local shelfY = h * 0.84 - (row - 1) * (h * 0.15)\n			Kit.Block(parent, `{name}Shelf{row}`, base + Vector3.new(glassX, shelfY - 1.4, -d * 0.4), Vector3.new(glassW, 0.2, d * 0.5), {\n				color = Color3.fromRGB(198, 202, 210),\n				yawDegrees = facing,\n			}).CastShadow = false\n			for column = 1, VEND.Columns do\n				local index = (row - 1) * VEND.Columns + column\n				local x = glassX - glassW / 2 + glassW * ((column - 0.5) / VEND.Columns)\n				Kit.Block(parent, `{name}Item{index}`, base + Vector3.new(x, shelfY, -d * 0.4), Vector3.new(1.1, 1.7, 0.9), {\n					color = itemColors[((index - 1) % #itemColors) + 1],\n					yawDegrees = facing,\n				}).CastShadow = false\n			end\n			-- The slot numbers, one label per row rather than per item: sixteen billboards on\n			-- one machine is sixteen draw calls for something read once.\n			local strip = Kit.Block(parent, `{name}Strip{row}`, base + Vector3.new(glassX, shelfY - 1.9, -d * 0.55), Vector3.new(glassW, 0.7, 0.15), {\n				color = Color3.fromRGB(246, 246, 248),\n				yawDegrees = facing,\n			})\n			strip.CastShadow = false\n			local first = (row - 1) * VEND.Columns + 1\n			Kit.Sign(strip, string.format(\"%03d\", first) .. \"  -  \" .. string.format(\"%03d\", first + VEND.Columns - 1), 8, LABEL_DIST * 0.5, Color3.fromRGB(52, 58, 70))\n		end\n	else\n		-- The coffee machine: a cup in a recess, and the drinks list.\n		Kit.Block(parent, `{name}Recess`, base + Vector3.new(glassX, h * 0.3, -d * 0.4), Vector3.new(glassW * 0.7, h * 0.22, d * 0.5), {\n			color = Color3.fromRGB(232, 232, 238),\n			yawDegrees = facing,\n		}).CastShadow = false\n		Kit.Block(parent, `{name}Cup`, base + Vector3.new(glassX, h * 0.28, -d * 0.45), Vector3.new(1.5, 2, 1.5), {\n			color = Color3.fromRGB(238, 232, 224),\n			yawDegrees = facing,\n		}).CastShadow = false\n		local menu = Kit.Block(parent, `{name}Menu`, base + Vector3.new(glassX, h * 0.62, -d * 0.55), Vector3.new(glassW, h * 0.24, 0.2), {\n			color = Color3.fromRGB(28, 30, 40),\n			yawDegrees = facing,\n		})\n		menu.CastShadow = false\n		Kit.Sign(menu, \"LATTE  ·  CAPPUCCINO  ·  AMERICANO\", 10, LABEL_DIST * 0.6, Color3.fromRGB(150, 196, 240))\n	end\n\n	-- The keypad and the reader, which every machine in the reference has and which are what\n	-- make the right-hand third of the cabinet read as controls rather than as blank panel.\n	Kit.Block(parent, `{name}Pad`, base + Vector3.new(w * 0.32, h * 0.55, -d * 0.52), Vector3.new(w * 0.24, h * 0.3, 0.2), {\n		color = Color3.fromRGB(24, 26, 36),\n		yawDegrees = facing,\n	}).CastShadow = false\n	Kit.Block(parent, `{name}Reader`, base + Vector3.new(w * 0.32, h * 0.8, -d * 0.52), Vector3.new(w * 0.22, 2, 0.2), {\n		color = Color3.fromRGB(46, 92, 178),\n		material = Enum.Material.Neon,\n		yawDegrees = facing,\n	}).CastShadow = false\n\n	-- The delivery tray at the bottom.\n	Kit.Block(parent, `{name}Tray`, base + Vector3.new(glassX, h * 0.12, -d * 0.5), Vector3.new(glassW * 0.8, 1.8, 0.25), {\n		color = Color3.fromRGB(38, 40, 50),\n		yawDegrees = facing,\n	}).CastShadow = false\n\n	return body\nend\n\n-- A pair of them, side by side, the way the reference always has them.\nlocal function buildVendingPair(parent: Instance, name: string, at: (number, number, number) -> Vector3, x: number, y: number, z: number, facing: number)\n	buildVendingMachine(parent, `{name}Coffee`, at(x - VEND.WidthStuds * 0.6, y, z), false, facing)\n	buildVendingMachine(parent, `{name}Snacks`, at(x + VEND.WidthStuds * 0.6, y, z), true, facing)\nend\n\n-- ---------------------------------------------------------------------------------------\n-- Corridors, and the lockers down them.\n-- ---------------------------------------------------------------------------------------\n\nlocal function buildCorridors(parent: Instance, at: (number, number, number) -> Vector3)\n	local half = W / 2\n	local backZ = D - WALL_T\n	local corridorZ = backZ - BAND_D - CORRIDOR_W / 2\n\n	for floor = 1, BUILDING.Floors do\n		local y = floorY(floor)\n\n		-- The corridor floor, in a different tone so the route through the building is legible\n		-- from the moment you step onto it.\n		-- Tile, not plastic. The largest surface a player looks at in this building should not be\n		-- the one material that says \"nobody finished this\".\n		Kit.Slab(parent, `CorridorFloor{floor}`, at(0, y + 0.05, corridorZ), W - WALL_T * 2, CORRIDOR_W, 0.3, {\n			color = OFF_WHITE,\n			material = Enum.Material.Pebble,\n		})\n\n		-- Lockers down the front wall of the corridor, both sides of the atrium so the run is\n		-- not broken by the void.\n		-- **A continuous bank, not a row of separate slabs.**\n		--\n		-- These used to be individual blocks with air between them, standing at the open edge of\n		-- the corridor with no wall behind -- so instead of lockers you got a row of blue panels\n		-- floating in space, which is what the screenshots show and it is the single most\n		-- confusing thing in the building.\n		--\n		-- A locker bank is one solid run. The doors are *lines in* that run, not gaps between\n		-- objects: a plinth it stands on, a cap along the top, and a thin recessed groove every\n		-- door-width. That reads as lockers from any angle and never floats, because the body\n		-- is its own wall.\n		-- **One continuous run of lockers down the corridor wall. Nothing else, nowhere else.**\n		--\n		-- This has been round three times and the reference photo settled it, so the reasoning is\n		-- worth writing down properly.\n		--\n		-- First attempt: a bank wall-to-wall on every floor. Too much -- from the atrium it was a\n		-- wall of blue on every level. Second: one 46-stud bay in the middle of a 226-stud\n		-- corridor, which fixed that by overcorrecting into a quarter-mile of empty tunnel with one\n		-- object in it. Third: banks on the two end walls, which put an 11-stud blue box across the\n		-- far end of the corridor -- and because you look *down* a corridor, that box sits in the\n		-- middle of your view with a grey wall behind it and reads as something dumped there.\n		--\n		-- What the reference actually shows is none of those: a single unbroken run along one long\n		-- wall, floor-standing, with a bench at the end. The run reads as architecture because it\n		-- is continuous -- a corridor wall that *is* lockers, rather than a corridor with lockers\n		-- placed in it. Continuity is the whole effect, so nothing is allowed to interrupt it:\n		-- the noticeboards and planters that used to break this wall into four are gone with it.\n		local wallZ = corridorZ - CORRIDOR_W / 2 + 1.4\n		local runEnd = W / 2 - WALL_T - 10\n		local runW = runEnd * 2\n		local bankH = 11\n		local doors = math.max(8, math.floor(runW / 5))\n		local doorW = runW / doors\n		local x0 = -runEnd\n\n		-- **Both structural walls of the hallway carry lockers, and nothing stands in the middle.**\n		--\n		-- v1 ran one bank down the atrium-side wall and left the room-side wall bare. The brief\n		-- asks for long rows flush against the left and right walls, so the second run goes on\n		-- the room side -- broken around every classroom door, because a locker across a door is\n		-- the same mistake as a column across an entrance.\n		--\n		-- Nothing free-standing: every bank here is flush to a structural wall. A bank in the\n		-- middle of a 24-stud hallway would halve it, which is the opposite of the point.\n		Kit.Block(parent, `LockerBank{floor}`, at(0, y + 1 + bankH / 2, wallZ), Vector3.new(runW, bankH, 2.4), {\n			color = BLUE,\n			material = Enum.Material.Metal,\n			collide = true,\n		})\n		Kit.Block(parent, `LockerPlinth{floor}`, at(0, y + 0.5, wallZ), Vector3.new(runW, 1, 2.8), {\n			color = DEEP_BLUE,\n			material = Enum.Material.Metal,\n		}).CastShadow = false\n		Kit.Block(parent, `LockerCap{floor}`, at(0, y + 1.3 + bankH, wallZ), Vector3.new(runW, 0.6, 2.8), {\n			color = DEEP_BLUE,\n			material = Enum.Material.Metal,\n		}).CastShadow = false\n\n		for index = 1, doors do\n			local dx = x0 + doorW * (index - 0.5)\n			Kit.Block(parent, `LockerHandle{floor}_{index}`, at(dx + doorW * 0.3, y + 1 + bankH * 0.5, wallZ + 1.3), Vector3.new(0.5, 1.8, 0.3), {\n				color = Color3.fromRGB(232, 236, 244),\n				material = Enum.Material.Metal,\n			}).CastShadow = false\n			Kit.Block(parent, `LockerVent{floor}_{index}`, at(dx, y + 1 + bankH * 0.86, wallZ + 1.3), Vector3.new(doorW * 0.42, 0.9, 0.25), {\n				color = Color3.fromRGB(58, 92, 158),\n			}).CastShadow = false\n			if index < doors then\n				Kit.Block(parent, `LockerSeam{floor}_{index}`, at(x0 + doorW * index, y + 1 + bankH / 2, wallZ + 1.25), Vector3.new(0.3, bankH - 0.4, 0.3), {\n					color = DEEP_BLUE,\n				}).CastShadow = false\n			end\n		end\n\n		-- A bench at each end of the run, as in the reference. At the ends rather than the middle,\n		-- because a bench in front of the lockers is a bench in front of somebody's locker.\n		for side = -1, 1, 2 do\n			local bx = side * (runEnd - 12)\n			Kit.Block(parent, `LockerBench{floor}_{side}`, at(bx, y + 2.3, wallZ + 5), Vector3.new(18, 0.7, 3.4), {\n				color = WALNUT,\n				material = Enum.Material.Wood,\n				collide = true,\n			})\n			for leg = -1, 1, 2 do\n				Kit.Block(parent, `LockerBenchLeg{floor}_{side}_{leg}`, at(bx + leg * 6.5, y + 1.15, wallZ + 5), Vector3.new(0.7, 2.3, 3), {\n					color = Color3.fromRGB(96, 102, 114),\n					material = Enum.Material.Metal,\n				}).CastShadow = false\n			end\n		end\n\n		-- **The second run: the room-side wall, in the stretches between classroom doors.**\n		--\n		-- Every room's door sits at `rect.x1 + 7` and is 13.2 wide, so each one blocks about 16\n		-- studs of this wall. The run is laid as the segments between those blocks rather than as\n		-- one bank with holes punched in it, which is why it reads as continuous rows either side\n		-- of each door instead of a bank that happens to be missing pieces.\n		local roomWallZ = corridorZ + CORRIDOR_W / 2 - 1.4\n		-- The room list comes from planRooms(), the same call the rooms themselves are built\n		-- from. There is no `rooms` in this scope, and inventing a second list here would be the\n		-- exact bug that keeps costing days on this project: two places computing the same\n		-- geometry and disagreeing about it.\n		local blocks: { { number } } = {}\n		for _, rect in planRooms() do\n			if rect.floor == floor then\n				local doorAt = rect.x1 + 7\n				-- Padded well past the leaf: rule 2's minimum clear space either side of a door.\n				table.insert(blocks, { doorAt - 12, doorAt + 12 })\n			end\n		end\n		table.sort(blocks, function(a, b)\n			return a[1] < b[1]\n		end)\n\n		local segStart = -runEnd\n		local segments: { { number } } = {}\n		for _, gap in blocks do\n			if gap[1] - segStart > 12 then\n				table.insert(segments, { segStart, math.min(gap[1], runEnd) })\n			end\n			segStart = math.max(segStart, gap[2])\n		end\n		if runEnd - segStart > 12 then\n			table.insert(segments, { segStart, runEnd })\n		end\n\n		local segIndex = 0\n		for _, seg in segments do\n			local segA, segB = seg[1], seg[2]\n			-- Rule 3: nothing within ten studs of a stair landing. A segment that would run\n			-- through the keep-out is trimmed rather than skipped, so the wall stays furnished\n			-- right up to where the stair needs the floor.\n			if nearStairs((segA + segB) / 2, roomWallZ, (segB - segA) / 2) then\n				continue\n			end\n			segIndex += 1\n			local segW = segB - segA\n			local segCx = (segA + segB) / 2\n			local segDoors = math.max(2, math.floor(segW / 5))\n			local segDoorW = segW / segDoors\n\n			Kit.Block(parent, `RoomSideLocker{floor}_{segIndex}`, at(segCx, y + 1 + bankH / 2, roomWallZ), Vector3.new(segW, bankH, 2.4), {\n				color = BLUE,\n				material = Enum.Material.Metal,\n				collide = true,\n			})\n			Kit.Block(parent, `RoomSideLockerPlinth{floor}_{segIndex}`, at(segCx, y + 0.5, roomWallZ), Vector3.new(segW, 1, 2.8), {\n				color = DEEP_BLUE,\n				material = Enum.Material.Metal,\n			}).CastShadow = false\n			Kit.Block(parent, `RoomSideLockerCap{floor}_{segIndex}`, at(segCx, y + 1.3 + bankH, roomWallZ), Vector3.new(segW, 0.6, 2.8), {\n				color = DEEP_BLUE,\n				material = Enum.Material.Metal,\n			}).CastShadow = false\n\n			for index = 1, segDoors do\n				local dx = segA + segDoorW * (index - 0.5)\n				-- Handles and vents clear the bank's face by more than the build grid. Offsets\n				-- smaller than that get rounded back inside the door they sit on.\n				Kit.Block(parent, `RoomSideLockerHandle{floor}_{segIndex}_{index}`, at(dx + segDoorW * 0.3, y + 1 + bankH * 0.5, roomWallZ - 1.9), Vector3.new(0.5, 1.8, 0.3), {\n					color = Color3.fromRGB(232, 236, 244),\n					material = Enum.Material.Metal,\n				}).CastShadow = false\n				Kit.Block(parent, `RoomSideLockerVent{floor}_{segIndex}_{index}`, at(dx, y + 1 + bankH * 0.86, roomWallZ - 1.9), Vector3.new(segDoorW * 0.42, 0.9, 0.25), {\n					color = Color3.fromRGB(58, 92, 158),\n				}).CastShadow = false\n				if index < segDoors then\n					Kit.Block(parent, `RoomSideLockerSeam{floor}_{segIndex}_{index}`, at(segA + segDoorW * index, y + 1 + bankH / 2, roomWallZ - 1.85), Vector3.new(0.3, bankH - 0.4, 0.3), {\n						color = DEEP_BLUE,\n					}).CastShadow = false\n				end\n			end\n		end\n\n		-- The hexagon panel that used to sit on the corridor's end wall is gone: that wall is\n		-- where the locker alcove now is, and the two were occupying the same square studs. The\n		-- lockers are the better use of an end wall -- a decorative disc there was filling a space\n		-- that had nothing in it, which is a problem the corridor no longer has.\n\n		-- Ceiling strips down the length, instead of a row of square panels. A strip draws a line\n		-- the eye can follow; a row of squares is only lighting.\n		for index = 1, BUILDING.CeilingStrips do\n			local share = (index - 0.5) / BUILDING.CeilingStrips\n			Kit.Block(\n				parent,\n				`CeilStrip{floor}_{index}`,\n				at(-half + W * share, y + FLOOR_H - SLAB - 0.5, corridorZ),\n				Vector3.new(W / BUILDING.CeilingStrips - 6, 0.3, 3.2),\n				{ color = Color3.fromRGB(255, 252, 242), material = Enum.Material.Neon }\n			).CastShadow = false\n		end\n\n		-- Bins along the corridor. The most ordinary object a school has, and there were none.\n		for index = 1, BUILDING.BinsPerFloor do\n			local share = (index - 0.5) / BUILDING.BinsPerFloor\n			local x = -half + W * share + 14\n			local z = corridorZ + CORRIDOR_W / 2 - 3\n			Kit.Block(parent, `Bin{floor}_{index}`, at(x, y + 2.2, z), Vector3.new(4, 4.4, 4), {\n				color = Color3.fromRGB(64, 78, 96),\n				material = Enum.Material.Metal,\n				collide = true,\n			})\n			Kit.Block(parent, `BinLid{floor}_{index}`, at(x, y + 4.6, z), Vector3.new(4.6, 0.5, 4.6), {\n				color = Color3.fromRGB(46, 58, 74),\n				material = Enum.Material.Metal,\n			}).CastShadow = false\n		end\n\n		-- Water fountains against the locker wall, which is where a school puts them: on the\n		-- circulation route, not tucked in a corner. Two per floor so there is one near either\n		-- stair rather than a single one everybody walks the length of the building for.\n		for index = 1, BUILDING.FountainsPerFloor do\n			local share = (index - 0.5) / BUILDING.FountainsPerFloor\n			local x = -half + W * share\n			-- The *far* side of the corridor. These used to share the near edge with the lockers,\n			-- and once the lockers became one continuous bank rather than spaced slabs there was no\n			-- longer a gap to stand in -- six fountains ended up inside it.\n			local z = corridorZ + CORRIDOR_W / 2 - 2.4\n\n			-- The back panel, the basin, and the spout. Three parts, and the basin is the one that\n			-- has to read as a basin from standing height -- it is wider than it is deep and sits\n			-- at hip height, which is the whole silhouette of a drinking fountain.\n			Kit.Block(parent, `FountainBack{floor}_{index}`, at(x, y + 5, z), Vector3.new(5, 8, 0.8), {\n				color = Color3.fromRGB(206, 212, 222),\n				material = Enum.Material.Metal,\n			})\n			Kit.Block(parent, `Fountain{floor}_{index}`, at(x, y + 3.6, z + 1.2), Vector3.new(6, 1.2, 3), {\n				color = Color3.fromRGB(226, 230, 238),\n				material = Enum.Material.Metal,\n				collide = true,\n			})\n			Kit.Block(parent, `FountainBasin{floor}_{index}`, at(x, y + 3.9, z + 1.2), Vector3.new(4.4, 0.5, 2), {\n				color = Color3.fromRGB(150, 190, 216),\n				material = Enum.Material.Glass,\n				transparency = 0.3,\n			}).CastShadow = false\n			Kit.Block(parent, `FountainSpout{floor}_{index}`, at(x, y + 4.6, z + 0.5), Vector3.new(0.5, 0.9, 0.5), {\n				color = Color3.fromRGB(186, 192, 202),\n				material = Enum.Material.Metal,\n			}).CastShadow = false\n		end\n\n		-- A pair of machines against the back wall of the corridor on every floor. Against the\n		-- *back* rather than the locker wall on purpose: the lockers are where the corridor\n		-- system stands people, and a cabinet in that run would be somewhere to be cornered\n		-- against rather than somewhere to buy a drink.\n		buildVendingPair(parent, `CorridorVending{floor}`, at, half - 34, y + 0.2, corridorZ + CORRIDOR_W / 2 - 2, 180)\n	end\nend\n\n-- ---------------------------------------------------------------------------------------\n-- The rooms themselves: partitions, glazing onto the corridor, signs, lights, fit-out.\n-- ---------------------------------------------------------------------------------------\n\n-- A washroom: a run of stalls down one side, basins and mirrors down the other.\n--\n-- **Open entryways, no stall doors.** A door on a 0.5-stud partition needs a hinge, a swing arc\n-- and somewhere for the arc to go, and in a room this size the arc is the room. Real school\n-- stalls in a Roblox build read perfectly well as three-sided bays -- the privacy comes from the\n-- partitions, and the missing fourth side is what stops a player getting wedged in one.\n--\n-- Every horizontal surface here has its own hardcoded height: partitions stand from 1 to 12,\n-- the basin deck is at 4.2, the counter under it at 3, the mirror starts at 7. Nothing is\n-- derived from anything else, so nothing can drift into anything else.\nlocal function fitWashroom(parent: Instance, at: (number, number, number) -> Vector3, rect: Rect, y: number)\n	local cx = (rect.x1 + rect.x2) / 2\n	local width = rect.x2 - rect.x1\n	local id = rect.id\n\n	-- Stalls along the back half, partitions running across the room.\n	local stallDepth = 12\n	local stallZ = rect.z2 - 2 - stallDepth / 2\n	local stalls = math.max(2, math.floor(width / 7))\n	local stallW = (width - 6) / stalls\n\n	for index = 0, stalls do\n		local px = rect.x1 + 3 + stallW * index\n		Kit.Block(parent, `{id}StallWall{index}`, at(px, y + 6.5, stallZ), Vector3.new(0.5, 11, stallDepth), {\n			color = Color3.fromRGB(214, 220, 230),\n			material = Enum.Material.SmoothPlastic,\n			collide = true,\n		})\n	end\n	-- The back of the stall run, and a pan in each bay.\n	Kit.Block(parent, `{id}StallBack`, at(cx, y + 6.5, rect.z2 - 2.2), Vector3.new(width - 6, 11, 0.5), {\n		color = Color3.fromRGB(214, 220, 230),\n		material = Enum.Material.SmoothPlastic,\n	}).CastShadow = false\n	for index = 1, stalls do\n		local px = rect.x1 + 3 + stallW * (index - 0.5)\n		Kit.Block(parent, `{id}Pan{index}`, at(px, y + 1.6, rect.z2 - 5), Vector3.new(2.6, 3.2, 3), {\n			color = Color3.fromRGB(246, 248, 252),\n			collide = true,\n		})\n		Kit.Block(parent, `{id}Cistern{index}`, at(px, y + 4.6, rect.z2 - 3.4), Vector3.new(2.8, 2.8, 1.2), {\n			color = Color3.fromRGB(240, 243, 248),\n		}).CastShadow = false\n	end\n\n	-- Basins along the front wall, with a mirror over each. Four studs of clear floor between the\n	-- basin deck and the nearest stall partition, which is rule 2's minimum and also just enough\n	-- for somebody to stand at a sink while another walks behind them.\n	local basinZ = rect.z1 + 4\n	local basins = math.max(2, math.floor(width / 8))\n	local basinPitch = (width - 8) / basins\n\n	Kit.Block(parent, `{id}Counter`, at(cx, y + 3, basinZ), Vector3.new(width - 6, 2, 4), {\n		color = Color3.fromRGB(226, 230, 238),\n		material = Enum.Material.SmoothPlastic,\n		collide = true,\n	})\n	Kit.Block(parent, `{id}CounterTop`, at(cx, y + 4.2, basinZ), Vector3.new(width - 5.6, 0.4, 4.4), {\n		color = Color3.fromRGB(242, 245, 250),\n		material = Enum.Material.SmoothPlastic,\n	}).CastShadow = false\n\n	for index = 1, basins do\n		local px = rect.x1 + 4 + basinPitch * (index - 0.5)\n		Kit.Block(parent, `{id}Basin{index}`, at(px, y + 4.35, basinZ), Vector3.new(3.6, 0.5, 3), {\n			color = Color3.fromRGB(250, 251, 254),\n		}).CastShadow = false\n		Kit.Block(parent, `{id}Tap{index}`, at(px, y + 5.4, basinZ - 1.4), Vector3.new(0.4, 2, 0.4), {\n			color = Color3.fromRGB(198, 204, 214),\n			material = Enum.Material.Metal,\n		}).CastShadow = false\n\n		-- The mirror. Glass with reflectance rather than a grey panel -- reflectance is the whole\n		-- reason it reads as a mirror instead of a window into the wall.\n		local mirror = Kit.Block(parent, `{id}Mirror{index}`, at(px, y + 9, basinZ - 2), Vector3.new(4.4, 4.5, 0.3), {\n			color = Color3.fromRGB(226, 238, 248),\n			material = Enum.Material.Glass,\n		})\n		mirror.Reflectance = 0.55\n		mirror.Transparency = 0.05\n		mirror.CastShadow = false\n		Kit.Block(parent, `{id}MirrorFrame{index}`, at(px, y + 9, basinZ - 2.25), Vector3.new(5, 5.1, 0.25), {\n			color = Color3.fromRGB(150, 156, 168),\n			material = Enum.Material.Metal,\n		}).CastShadow = false\n	end\nend\n\nlocal function fitClassroom(parent: Instance, at: (number, number, number) -> Vector3, rect: Rect, y: number)\n	local cx, cz = rectCenter(rect)\n	local width = rect.x2 - rect.x1\n	local perRow = math.ceil(FIT.DesksPerClassroom / FIT.DeskRows)\n\n	-- The desk field is inset from the left wall, because that wall now carries the storage run.\n	-- At six rows the field reaches the middle of the room, which is exactly where the cupboards\n	-- are -- three desk legs per classroom were standing inside them.\n	local deskLeft = rect.x1 + 10\n	local deskWidth = width - 14\n\n	-- **The rows divide the space that is free, rather than marching at a fixed pitch until\n	-- they hit something.**\n	--\n	-- They used to step 8 studs back from the front wall however deep the room was. That was\n	-- survivable when a room was 99 studs deep and is not at 46: row five landed on top of the\n	-- teacher's desk and row six stood outside the back wall. A room's furniture has to be a\n	-- function of the room, or every change to the plan breaks it silently.\n	local teacherZ = rect.z2 - 8\n	local fieldZ1 = rect.z1 + 6\n	local rowPitch = (teacherZ - 6 - fieldZ1) / FIT.DeskRows\n\n	for row = 1, FIT.DeskRows do\n		for seat = 1, perRow do\n			local x = deskLeft + deskWidth * ((seat - 0.5) / perRow)\n			local z = fieldZ1 + rowPitch * (row - 0.5)\n			Kit.Block(parent, `Desk{rect.id}{row}_{seat}`, at(x, y + 2.6, z), Vector3.new(5, 0.4, 3), { color = WOOD })\n			Kit.Block(parent, `DeskLeg{rect.id}{row}_{seat}`, at(x, y + 1.3, z), Vector3.new(4.4, 2.6, 2.4), { color = DARK, transparency = 0.15 })\n			Kit.Block(parent, `Chair{rect.id}{row}_{seat}`, at(x, y + 1.6, z + rowPitch * 0.36), Vector3.new(2.6, 0.35, 2.6), { color = BLUE })\n		end\n	end\n\n	-- The board, framed and with a pen tray. A dark rectangle on a wall is a rectangle; a\n	-- frame and a tray are what make it a whiteboard, and they are two parts.\n	Kit.Block(parent, `BoardFrame{rect.id}`, at(cx, y + 8, rect.z2 - 1.4), Vector3.new(width * 0.5 + 1.4, 9.4, 0.3), {\n		color = Color3.fromRGB(198, 202, 210),\n	}).CastShadow = false\n	Kit.Block(parent, `Board{rect.id}`, at(cx, y + 8, rect.z2 - 1.2), Vector3.new(width * 0.5, 8, 0.4), { color = Color3.fromRGB(238, 240, 244) })\n	Kit.Block(parent, `BoardTray{rect.id}`, at(cx, y + 3.7, rect.z2 - 1.7), Vector3.new(width * 0.5, 0.4, 1), {\n		color = Color3.fromRGB(176, 180, 190),\n		material = Enum.Material.Metal,\n	}).CastShadow = false\n\n	-- The teacher desk, with a screen and a chair behind it. Same reasoning as the library\n	-- counter: a bare slab is a plinth, a screen on it is a desk somebody works at.\n	Kit.Block(parent, `TeacherDesk{rect.id}`, at(cx, y + 2.2, teacherZ), Vector3.new(9, 4.4, 3.4), {\n		color = WALNUT,\n		material = Enum.Material.Wood,\n		collide = true,\n	})\n	Kit.Block(parent, `TeacherTop{rect.id}`, at(cx, y + 4.6, teacherZ), Vector3.new(10, 0.4, 4), { color = OFF_WHITE })\n	Kit.Block(parent, `TeacherScreen{rect.id}`, at(cx - 2, y + 6.2, teacherZ + 0.6), Vector3.new(4.2, 2.8, 0.3), {\n		color = Color3.fromRGB(30, 32, 40),\n	}).CastShadow = false\n	Kit.Block(parent, `TeacherChair{rect.id}`, at(cx, y + 1.7, rect.z2 - 10), Vector3.new(2.8, 0.4, 2.8), { color = DARK })\n\n	-- A run of low storage down one side, and something green in the corner. Every reference\n	-- classroom has cupboards under the window and a plant; an empty perimeter is what makes a\n	-- room read as a box with desks in it.\n	Kit.Block(parent, `Storage{rect.id}`, at(rect.x1 + 4, y + 2.4, cz), Vector3.new(4, 4.8, (rect.z2 - rect.z1) * 0.45), {\n		color = OFF_WHITE,\n		collide = true,\n	})\n	Kit.Block(parent, `StorageTop{rect.id}`, at(rect.x1 + 4, y + 5, cz), Vector3.new(4.6, 0.4, (rect.z2 - rect.z1) * 0.45 + 0.6), {\n		color = WALNUT,\n		material = Enum.Material.Wood,\n	}).CastShadow = false\n	Kit.Planter(parent, `ClassPlant{rect.id}`, at(rect.x2 - 5, y + 0.2, rect.z2 - 6), 3, 9)\nend\n\nlocal function fitCafeteria(parent: Instance, at: (number, number, number) -> Vector3, rect: Rect, y: number)\n	local width = rect.x2 - rect.x1\n	local depth = rect.z2 - rect.z1\n\n	-- The servery down the back wall: a long counter with a warm shelf over it.\n	local cx = (rect.x1 + rect.x2) / 2\n	Kit.Block(parent, \"Servery\", at(cx, y + 2.6, rect.z2 - 6), Vector3.new(width * 0.62, 5.2, 5), { color = CONCRETE, material = Enum.Material.Metal })\n	Kit.Block(parent, \"ServeryGuard\", at(cx, y + 7.2, rect.z2 - 6), Vector3.new(width * 0.62, 0.3, 5), {\n		color = GLASS_TINT,\n		material = Enum.Material.Glass,\n		transparency = 0.5,\n	})\n	for tray = 1, 8 do\n		local x = cx - width * 0.28 + (width * 0.56) * ((tray - 0.5) / 8)\n		Kit.Block(parent, `Tray{tray}`, at(x, y + 5.4, rect.z2 - 6), Vector3.new(4, 0.4, 3), { color = Color3.fromRGB(226, 96, 84) })\n	end\n\n	-- Tables, in two ranks so the room has a route through the middle of it.\n	for index = 1, FIT.CafeteriaTables do\n		local column = (index - 1) % 4\n		local row = math.floor((index - 1) / 4)\n		local x = rect.x1 + width * ((column + 0.5) / 4)\n		local z = rect.z1 + 10 + row * 14\n		Kit.Block(parent, `CafeTable{index}`, at(x, y + 3, z), Vector3.new(9, 0.4, 6), { color = WHITE })\n		Kit.Block(parent, `CafeTableLeg{index}`, at(x, y + 1.5, z), Vector3.new(1.2, 3, 1.2), { color = DARK })\n		for seat = -1, 1, 2 do\n			Kit.Block(parent, `CafeStool{index}_{seat}`, at(x + seat * 3, y + 1.8, z + seat * 4.6), Vector3.new(2.4, 0.35, 2.4), { color = BLUE })\n		end\n	end\n\n	-- The bunting the reference is full of, strung across the room.\n	--\n	-- Hung off the ceiling rather than at a fixed 14 studs. Absolute heights in here were all\n	-- chosen when a storey was 27 studs tall and every one of them was left up in the roof when\n	-- it became 15; anything that belongs to the ceiling should be measured from the ceiling.\n	local ceilY = y + FLOOR_H - 1.6\n	Kit.Bunting(parent, \"CafeBunting\", at(rect.x1 + 6, ceilY, rect.z1 + 8), at(rect.x2 - 6, ceilY, rect.z1 + 8), 18, { BLUE, WHITE, PALE_BLUE })\n\n	-- The crest on the back wall, over the servery.\n	--\n	-- Concentric discs rather than a decal, because this codebase draws with parts and a ring\n	-- costs one each. Built back to front so the outer ring is behind the inner one and the\n	-- whole thing reads as layered rather than as three circles fighting for the same plane.\n	local crestZ = rect.z2 - 1.6\n	local crestY = y + FLOOR_H * 0.62\n	for ring = 1, BUILDING.CafeCrestRings do\n		local share = 1 - (ring - 1) / BUILDING.CafeCrestRings\n		local radius = BUILDING.CafeCrestRadiusStuds * share\n		local tone = if ring % 2 == 1 then BLUE else WHITE\n		local disc = Kit.Block(\n			parent,\n			`CafeCrest{ring}`,\n			at(cx, crestY, crestZ - ring * 0.12),\n			Vector3.new(radius * 2, radius * 2, 0.3),\n			{ color = tone }\n		)\n		disc.Shape = Enum.PartType.Cylinder\n		-- A cylinder's length runs along X, so facing it at a wall is a quarter turn about Y --\n		-- the same trick Kit.Rug uses about Z to lay one flat on the floor.\n		disc.CFrame = CFrame.new(at(cx, crestY, crestZ - ring * 0.12)) * CFrame.Angles(0, math.rad(90), 0)\n		disc.Size = Vector3.new(0.3, radius * 2, radius * 2)\n		disc.CastShadow = false\n	end\n	local crestPlate = Kit.Block(parent, \"CafeCrestPlate\", at(cx, crestY, crestZ - 1), Vector3.new(BUILDING.CafeCrestRadiusStuds, 6, 0.2), {\n		color = BLUE,\n	})\n	crestPlate.CastShadow = false\n	Kit.Sign(crestPlate, \"AGES HIGH\", BUILDING.CafeCrestRadiusStuds * 0.9, LABEL_DIST, Color3.fromRGB(248, 251, 255))\n\n	-- The bar along the glazed front, with high stools.\n	--\n	-- A canteen has two kinds of seat: tables for groups, and a counter for one person with\n	-- twenty minutes. Only having tables is what makes a dining room read as a set rather than\n	-- as somewhere people actually eat.\n	local barZ = rect.z1 + 4\n	Kit.Block(parent, \"CafeBar\", at(cx, y + 5.4, barZ), Vector3.new(width * 0.8, 0.6, 4), {\n		color = WOOD,\n		material = Enum.Material.Wood,\n		collide = true,\n	})\n	for index = 1, BUILDING.CafeBarStools do\n		local share = (index - 0.5) / BUILDING.CafeBarStools\n		local x = cx - width * 0.4 + width * 0.8 * share\n		Kit.Block(parent, `CafeBarLeg{index}`, at(x, y + 2.6, barZ), Vector3.new(0.8, 5.6, 0.8), {\n			color = Color3.fromRGB(96, 102, 116),\n			material = Enum.Material.Metal,\n		}).CastShadow = false\n		-- The stools face the glass, which is the whole reason a bar goes on this wall.\n		Kit.Block(parent, `CafeBarStool{index}`, at(x, y + 4.2, barZ + 5), Vector3.new(2.6, 0.4, 2.6), {\n			color = BLUE,\n			collide = true,\n		})\n		Kit.Block(parent, `CafeBarStoolLeg{index}`, at(x, y + 2.1, barZ + 5), Vector3.new(0.7, 4.2, 0.7), {\n			color = Color3.fromRGB(96, 102, 116),\n			material = Enum.Material.Metal,\n		}).CastShadow = false\n	end\nend\n\nlocal function fitLibrary(parent: Instance, at: (number, number, number) -> Vector3, rect: Rect, y: number)\n	local width = rect.x2 - rect.x1\n	local depth = rect.z2 - rect.z1\n\n	-- Stacks, in ranks with aisles between them.\n	for index = 1, FIT.LibraryShelves do\n		local column = (index - 1) % 5\n		local row = math.floor((index - 1) / 5)\n		local x = rect.x1 + width * ((column + 0.5) / 5)\n		local z = rect.z1 + 14 + row * 20\n		-- Taller, darker, and with a shelf line between every band. The reference stacks are\n		-- walnut, nearly ceiling height, and *densely* full -- the colour of the spines is the\n		-- brightest thing in the room and the wood is the darkest, and the room lives on that.\n		Kit.Block(parent, `Stack{index}`, at(x, y + 7.5, z), Vector3.new(4, 15, 16), {\n			color = WALNUT,\n			material = Enum.Material.Wood,\n			collide = true,\n		})\n		-- Five bands rather than three, each a different mix, with a shelf board under it. A\n		-- band of flat colour reads as a painted stripe; a band with a board beneath it reads as\n		-- books standing on a shelf, and the board is one part.\n		local spines = {\n			Color3.fromRGB(198, 92, 84),\n			Color3.fromRGB(86, 132, 194),\n			Color3.fromRGB(216, 184, 104),\n			Color3.fromRGB(122, 158, 108),\n			Color3.fromRGB(158, 108, 172),\n		}\n		for band = 1, 5 do\n			local by = y + 1.6 + band * 2.7\n			Kit.Block(parent, `Books{index}_{band}`, at(x, by, z), Vector3.new(4.3, 2.1, 15), {\n				color = spines[((index + band) % #spines) + 1],\n			}).CastShadow = false\n			Kit.Block(parent, `Shelf{index}_{band}`, at(x, by - 1.2, z), Vector3.new(4.5, 0.3, 15.4), {\n				color = Color3.fromRGB(72, 50, 34),\n			}).CastShadow = false\n		end\n	end\n\n	-- The desk you are sent to. Counter, worktop, and two monitors -- the reference desk has\n	-- screens on it, and a bare slab reads as a plinth rather than as somewhere staffed.\n	local cx = (rect.x1 + rect.x2) / 2\n	Kit.Block(parent, \"LibraryDesk\", at(cx, y + 2.4, rect.z1 + 5), Vector3.new(22, 4.8, 4), { color = WHITE })\n	Kit.Block(parent, \"LibraryDeskTop\", at(cx, y + 5, rect.z1 + 5), Vector3.new(23.5, 0.5, 5.2), {\n		color = WALNUT,\n		material = Enum.Material.Wood,\n	})\n	for index = -1, 1, 2 do\n		Kit.Block(parent, `LibraryMonitor{index}`, at(cx + index * 5, y + 6.8, rect.z1 + 5.6), Vector3.new(4.4, 3, 0.3), {\n			color = Color3.fromRGB(30, 32, 40),\n		}).CastShadow = false\n		Kit.Block(parent, `LibraryMonitorStand{index}`, at(cx + index * 5, y + 5.4, rect.z1 + 5.6), Vector3.new(0.6, 1.4, 0.6), {\n			color = Color3.fromRGB(120, 126, 138),\n		}).CastShadow = false\n	end\n\n	-- Rectangular rugs down the aisles, not discs. The reference lays long blue mats between\n	-- the stacks, which is a different shape doing a different job: a disc decorates a spot, a\n	-- runner tells you which way the room is walked.\n	for index = 1, FIT.RugsPerCommonRoom do\n		Kit.Slab(\n			parent,\n			`LibraryRug{index}`,\n			at(rect.x1 + width * (index / (FIT.RugsPerCommonRoom + 1)), y + 0.35, rect.z1 + depth * 0.45),\n			14,\n			depth * 0.5,\n			0.25,\n			{ color = Color3.fromRGB(74, 128, 200), material = Enum.Material.Fabric, collide = false }\n		)\n	end\n\n	-- Low benches between the stacks to read on, and a planter at each end of the run.\n	for index = 1, 4 do\n		local bx = rect.x1 + width * ((index - 0.5) / 4)\n		Kit.Block(parent, `LibraryBench{index}`, at(bx, y + 2.2, rect.z1 + depth * 0.72), Vector3.new(11, 0.7, 3.4), {\n			color = Color3.fromRGB(206, 210, 218),\n			collide = true,\n		})\n		for leg = -1, 1, 2 do\n			Kit.Block(parent, `LibraryBenchLeg{index}_{leg}`, at(bx + leg * 4.4, y + 1.1, rect.z1 + depth * 0.72), Vector3.new(0.5, 2.2, 3), {\n				color = Color3.fromRGB(96, 102, 114),\n				material = Enum.Material.Metal,\n			}).CastShadow = false\n		end\n	end\n	-- Beside the desk, not in the aisles. The stacks are 16 deep and centred 14 studs in, so\n	-- anything past z1 + 6 is inside a bookshelf -- which is where these first landed.\n	for side = -1, 1, 2 do\n		Kit.Planter(parent, `LibraryPlanter{side}`, at(cx + side * 15, y + 0.2, rect.z1 + 3.5), 3.4, 10)\n	end\nend\n\nlocal function fitCooking(parent: Instance, at: (number, number, number) -> Vector3, rect: Rect, y: number)\n	local width = rect.x2 - rect.x1\n	-- Island benches with a sink and a mixer on each, which is the whole read of the room in\n	-- the reference: a grid of islands rather than rows of desks.\n	for index = 1, FIT.CookingBenches do\n		local column = (index - 1) % 3\n		local row = math.floor((index - 1) / 3)\n		local x = rect.x1 + width * ((column + 0.5) / 3)\n		local z = rect.z1 + 10 + row * 12\n		local tone = if column == 0 then Color3.fromRGB(150, 186, 178) elseif column == 1 then Color3.fromRGB(186, 166, 196) else Color3.fromRGB(146, 170, 200)\n		Kit.Block(parent, `Bench{index}`, at(x, y + 2.6, z), Vector3.new(14, 5.2, 6), { color = tone })\n		Kit.Block(parent, `BenchTop{index}`, at(x, y + 5.4, z), Vector3.new(14.4, 0.5, 6.4), { color = WOOD })\n		Kit.Block(parent, `Sink{index}`, at(x - 3, y + 5.6, z), Vector3.new(4, 0.4, 3), { color = Color3.fromRGB(206, 212, 216), material = Enum.Material.Metal })\n		Kit.Block(parent, `Mixer{index}`, at(x + 4, y + 6.6, z), Vector3.new(2, 2.6, 2), { color = WHITE })\n	end\n	-- Fridges down the wall.\n	for index = 1, 3 do\n		Kit.Block(parent, `Fridge{index}`, at(rect.x1 + 6 + (index - 1) * 8, y + 5, rect.z2 - 4), Vector3.new(6, 10, 4), { color = Color3.fromRGB(158, 198, 214) })\n	end\nend\n\nlocal function fitLounge(parent: Instance, at: (number, number, number) -> Vector3, rect: Rect, y: number)\n	local width = rect.x2 - rect.x1\n	local depth = rect.z2 - rect.z1\n	local cx, cz = rectCenter(rect)\n\n	-- Warm floor, because this is the one room in the school that is not tiled. It is the\n	-- fastest way to say \"you are allowed to relax here\" and it costs one part.\n	Kit.Slab(parent, \"LoungeFloor\", at(cx, y + 0.08, cz), width - 2, depth - 2, 0.3, {\n		color = Color3.fromRGB(216, 186, 162),\n		material = Enum.Material.WoodPlanks,\n	})\n\n	-- The pool table: the thing the reference room is built around. Bed, rails, pockets, cues\n	-- and a rack of balls -- worth the parts, because it is the single object that says this\n	-- is somewhere people spend a free period.\n	for table_ = 1, LOUNGE.PoolTables do\n		local px = cx\n		local pz = rect.z1 + depth * 0.34\n		Kit.Block(parent, `PoolBed{table_}`, at(px, y + 2.6, pz), Vector3.new(20, 0.6, 11), {\n			color = Color3.fromRGB(58, 132, 82),\n			material = Enum.Material.Fabric,\n		})\n		Kit.Block(parent, `PoolFrame{table_}`, at(px, y + 2.1, pz), Vector3.new(22, 1.6, 13), {\n			color = Color3.fromRGB(122, 78, 54),\n			material = Enum.Material.Wood,\n		})\n		for side = -1, 1, 2 do\n			Kit.Block(parent, `PoolLeg{table_}_{side}`, at(px + side * 7, y + 1.1, pz), Vector3.new(3.4, 2.2, 9), {\n				color = Color3.fromRGB(104, 66, 46),\n			})\n		end\n		-- The rack, and the cue ball apart from it.\n		local ballColors = {\n			Color3.fromRGB(226, 196, 74), Color3.fromRGB(62, 96, 186), Color3.fromRGB(206, 70, 62),\n			Color3.fromRGB(126, 82, 176), Color3.fromRGB(232, 138, 62), Color3.fromRGB(86, 160, 96),\n		}\n		for ball = 1, 6 do\n			local row = math.floor((ball - 1) / 3)\n			local column = (ball - 1) % 3\n			Kit.Block(parent, `PoolBall{ball}`, at(px + 5 + row * 1.1, y + 3.2, pz - 1.2 + column * 1.2), Vector3.new(0.9, 0.9, 0.9), {\n				color = ballColors[ball],\n			}).CastShadow = false\n		end\n		Kit.Block(parent, `PoolCue{table_}`, at(px - 3, y + 3.1, pz), Vector3.new(13, 0.24, 0.24), {\n			color = Color3.fromRGB(196, 156, 108),\n		}).CastShadow = false\n	end\n\n	-- The screen on the wall.\n	local screen = Kit.Block(parent, \"LoungeScreen\", at(rect.x2 - 3, y + 11, cz), Vector3.new(0.5, LOUNGE.ScreenHeightStuds, LOUNGE.ScreenWidthStuds), {\n		color = Color3.fromRGB(20, 22, 28),\n	})\n	screen.CastShadow = false\n	Kit.Block(parent, \"LoungeScreenFrame\", at(rect.x2 - 3.3, y + 11, cz), Vector3.new(0.3, LOUNGE.ScreenHeightStuds + 1.2, LOUNGE.ScreenWidthStuds + 1.2), {\n		color = Color3.fromRGB(52, 56, 66),\n	}).CastShadow = false\n\n	-- **The room splits front to back, at a line rather than by luck.**\n	--\n	-- Soft seating at the back facing the screen, dining at the front by the door. These were\n	-- two independent runs -- sofas walking forward from the back wall, tables walking back from\n	-- the front -- which met in the middle the moment the room stopped being 99 studs deep, and\n	-- left a coffee table standing inside a sofa. A split line makes that impossible instead of\n	-- unlikely.\n	local depth = rect.z2 - rect.z1\n	local splitZ = rect.z1 + depth * 0.46\n\n	local sofaRows = math.ceil(LOUNGE.Sofas / 2)\n	local sofaPitch = (rect.z2 - 8 - (splitZ + 4)) / math.max(1, sofaRows)\n	for index = 1, LOUNGE.Sofas do\n		local x = rect.x1 + width * (((index - 1) % 2 + 0.5) / 2)\n		local z = rect.z2 - 8 - sofaPitch * (math.floor((index - 1) / 2) + 0.5)\n		Kit.Block(parent, `LoungeSofa{index}`, at(x, y + 1.9, z), Vector3.new(11, 3.8, 5), {\n			color = Color3.fromRGB(118, 132, 190),\n			material = Enum.Material.Fabric,\n		})\n		Kit.Block(parent, `LoungeSofaBack{index}`, at(x, y + 4.2, z + 2.2), Vector3.new(11, 4.6, 1.2), {\n			color = Color3.fromRGB(104, 118, 176),\n			material = Enum.Material.Fabric,\n		})\n	end\n\n	local diningRows = math.ceil(LOUNGE.DiningTables / 3)\n	local diningPitch = (splitZ - 3 - (rect.z1 + 6)) / math.max(1, diningRows)\n	for index = 1, LOUNGE.DiningTables do\n		local x = rect.x1 + width * (((index - 1) % 3 + 0.5) / 3)\n		local z = rect.z1 + 6 + diningPitch * (math.floor((index - 1) / 3) + 0.5)\n		Kit.Block(parent, `LoungeTable{index}`, at(x, y + 3, z), Vector3.new(8, 0.4, 5), { color = Color3.fromRGB(150, 110, 72) })\n		Kit.Block(parent, `LoungeTableLeg{index}`, at(x, y + 1.5, z), Vector3.new(1, 3, 1), { color = Color3.fromRGB(96, 72, 52) })\n		for seat = -1, 1, 2 do\n			Kit.Block(parent, `LoungeChair{index}_{seat}`, at(x + seat * 5, y + 1.8, z), Vector3.new(2.6, 0.4, 2.6), {\n				color = Color3.fromRGB(96, 124, 186),\n			})\n		end\n	end\n\n	for index = 1, LOUNGE.Rugs do\n		Kit.Rug(parent, `LoungeRug{index}`, at(rect.x1 + width * (index / (LOUNGE.Rugs + 1)), y + 0.4, cz + 6), 7, Color3.fromRGB(150, 178, 220))\n	end\n	-- Planters along the back wall, but skipping the middle third -- that is where the vending\n	-- pair stands, and two of these were landing inside the machines.\n	for index = 1, LOUNGE.Planters do\n		local share = index / (LOUNGE.Planters + 1)\n		if share > 0.34 and share < 0.66 then\n			continue\n		end\n		Kit.Planter(parent, `LoungePlanter{index}`, at(rect.x1 + width * share, y + 0.2, rect.z2 - 3), 3, 9)\n	end\n\n	-- And the machines, against the back wall where the reference has them.\n	buildVendingPair(parent, \"LoungeVending\", at, cx, y + 0.2, rect.z2 - 4, 180)\nend\n\nlocal function fitCommon(parent: Instance, at: (number, number, number) -> Vector3, rect: Rect, y: number)\n	local width = rect.x2 - rect.x1\n	for index = 1, FIT.RugsPerCommonRoom do\n		Kit.Rug(parent, `{rect.id}Rug{index}`, at(rect.x1 + width * (index / (FIT.RugsPerCommonRoom + 1)), y + 0.35, (rect.z1 + rect.z2) / 2), 7, PALE_BLUE)\n	end\n	for index = 1, FIT.PlantersPerCommonRoom do\n		Kit.Planter(parent, `{rect.id}Planter{index}`, at(rect.x1 + width * (index / (FIT.PlantersPerCommonRoom + 1)), y + 0.2, rect.z2 - 4), 3, 9)\n	end\n	for index = 1, 4 do\n		Kit.Block(parent, `{rect.id}Sofa{index}`, at(rect.x1 + width * (index / 5), y + 1.8, rect.z1 + 8), Vector3.new(10, 3.6, 5), { color = Color3.fromRGB(92, 98, 116) })\n	end\nend\n\n-- ============================================================ the three taught rooms\n--\n-- Science, Art and Reading were left bare at bake time because Lab.luau, Studio.luau and\n-- ReadingRoom.luau build their stations into them. What that missed is that those modules run\n-- at *play* time and build non-collidable placeholders into a Folder -- so in Studio, and for\n-- the whole time anyone is looking at the school rather than playing it, the three rooms are\n-- empty boxes with trim on the walls.\n--\n-- The split these fitters keep: **the perimeter is architecture and is baked, the middle is\n-- mechanics and stays clear.** Every room anchor sits at the room centre, so nothing here goes\n-- within about nine studs of it; the benches, cupboards and boards run round the walls where a\n-- real room puts them anyway.\n\nlocal function labBenchRun(parent, at, id: string, x: number, z1: number, z2: number, y: number, sinks: boolean)\n	local len = z2 - z1\n	Kit.Block(parent, `{id}Bench`, at(x, y + 2.6, (z1 + z2) / 2), Vector3.new(5, 0.5, len), {\n		color = Color3.fromRGB(58, 62, 72),\n		collide = true,\n	})\n	Kit.Block(parent, `{id}Cup`, at(x, y + 1.3, (z1 + z2) / 2), Vector3.new(4.6, 2.6, len - 1), {\n		color = OFF_WHITE,\n	})\n	local units = math.max(2, math.floor(len / 9))\n	for i = 1, units - 1 do\n		Kit.Block(parent, `{id}Seam{i}`, at(x - 2.4, y + 1.3, z1 + len * (i / units)), Vector3.new(0.2, 2.4, 0.25), {\n			color = Color3.fromRGB(176, 182, 194),\n		}).CastShadow = false\n	end\n	-- Stools facing the bench. A bench nobody can sit at is a counter, and the difference\n	-- between a lab and a storeroom is entirely whether the room looks like people work in it.\n	-- `face` is which way the room is from the bench, so the stools stand in front of it.\n	local face = if x < 0 then 1 else -1\n	for i = 1, units do\n		local sz = z1 + len * ((i - 0.5) / units)\n		Kit.Block(parent, `{id}Stool{i}`, at(x + face * 4.6, y + 2.1, sz), Vector3.new(2.6, 0.4, 2.6), {\n			color = DEEP_BLUE,\n			collide = true,\n		}).CastShadow = false\n		Kit.Block(parent, `{id}StoolLeg{i}`, at(x + face * 4.6, y + 1, sz), Vector3.new(0.5, 2.2, 0.5), {\n			color = Color3.fromRGB(96, 102, 114),\n			material = Enum.Material.Metal,\n		}).CastShadow = false\n	end\n\n	if sinks then\n		local bowls = math.max(1, math.floor(units / 2))\n		for i = 1, bowls do\n			local sz = z1 + len * ((i - 0.5) / bowls)\n			Kit.Block(parent, `{id}Sink{i}`, at(x, y + 2.75, sz), Vector3.new(3.4, 0.5, 3), {\n				color = Color3.fromRGB(214, 220, 230),\n			}).CastShadow = false\n			Kit.Block(parent, `{id}Tap{i}`, at(x + 1.4, y + 3.6, sz), Vector3.new(0.35, 1.7, 0.35), {\n				color = Color3.fromRGB(198, 204, 214),\n				material = Enum.Material.Metal,\n			}).CastShadow = false\n		end\n	end\nend\n\nlocal function fitScience(parent: Instance, at: (number, number, number) -> Vector3, rect: Rect, y: number)\n	local cx = (rect.x1 + rect.x2) / 2\n	labBenchRun(parent, at, \"SciL\", rect.x1 + 3.2, rect.z1 + 10, rect.z2 - 12, y, true)\n	labBenchRun(parent, at, \"SciR\", rect.x2 - 3.2, rect.z1 + 10, rect.z2 - 12, y, true)\n\n	-- The fume cupboard: the one tall object in the room, which is what stops a lab reading as\n	-- a room full of waist-high slabs.\n	Kit.Block(parent, \"SciFume\", at(rect.x1 + 6, y + 6, rect.z2 - 5), Vector3.new(9, 12, 4), {\n		color = Color3.fromRGB(212, 218, 228),\n		collide = true,\n	})\n	Kit.Block(parent, \"SciFumeGlass\", at(rect.x1 + 6, y + 7.5, rect.z2 - 7.1), Vector3.new(8, 6, 0.3), {\n		color = GLASS_TINT,\n		material = Enum.Material.Glass,\n		transparency = 0.5,\n	}).CastShadow = false\n	Kit.Block(parent, \"SciFumeDuct\", at(rect.x1 + 6, y + 16, rect.z2 - 5), Vector3.new(2.4, 8, 2.4), {\n		color = Color3.fromRGB(176, 182, 194),\n		material = Enum.Material.Metal,\n	}).CastShadow = false\n\n	-- Charts and safety kit on the back wall. A lab with nothing on its walls reads as a room\n	-- that happens to have tables in it.\n	for i = 1, 3 do\n		Kit.Block(parent, `SciChart{i}`, at(rect.x2 - 5 - (i - 1) * 8, y + 13, rect.z2 - 1.5), Vector3.new(7, 9, 0.3), {\n			color = if i == 2 then PALE_BLUE else Color3.fromRGB(236, 240, 248),\n		}).CastShadow = false\n	end\n	Kit.Block(parent, \"SciEyewash\", at(rect.x2 - 3.4, y + 7.5, rect.z1 + 7), Vector3.new(2.6, 3, 2.6), {\n		color = Color3.fromRGB(64, 176, 92),\n	}).CastShadow = false\n	Kit.Block(parent, \"SciSafety\", at(cx, y + 19, rect.z2 - 1.5), Vector3.new(6, 4, 0.3), {\n		color = Color3.fromRGB(214, 64, 58),\n	}).CastShadow = false\nend\n\nlocal function fitArt(parent: Instance, at: (number, number, number) -> Vector3, rect: Rect, y: number)\n	local cx = (rect.x1 + rect.x2) / 2\n	local cz = (rect.z1 + rect.z2) / 2\n	labBenchRun(parent, at, \"ArtL\", rect.x1 + 3.2, rect.z1 + 10, rect.z2 - 10, y, true)\n\n	-- The drying rack down the other side, with work on it. Paint on a rack is the detail that\n	-- says the room gets used, and it costs one part per shelf.\n	Kit.Block(parent, \"ArtRack\", at(rect.x2 - 3.4, y + 7, cz), Vector3.new(5, 14, 34), {\n		color = WALNUT,\n		material = Enum.Material.Wood,\n		collide = true,\n	})\n	local SWATCH = {\n		Color3.fromRGB(212, 96, 84),\n		PALE_BLUE,\n		Color3.fromRGB(238, 198, 92),\n		Color3.fromRGB(120, 176, 118),\n		Color3.fromRGB(196, 140, 200),\n		OFF_WHITE,\n	}\n	for i = 1, 6 do\n		Kit.Block(parent, `ArtRackShelf{i}`, at(rect.x2 - 3.4, y + 1.6 + i * 2, cz), Vector3.new(5.3, 0.3, 32), {\n			color = Color3.fromRGB(206, 212, 222),\n		}).CastShadow = false\n		Kit.Block(parent, `ArtWork{i}`, at(rect.x2 - 3.6, y + 2.3 + i * 2, cz - 13 + i * 4.4), Vector3.new(4, 0.15, 3.4), {\n			color = SWATCH[i],\n		}).CastShadow = false\n	end\n\n	-- A pinboard of finished work along the back.\n	Kit.Block(parent, \"ArtBoard\", at(cx, y + 12, rect.z2 - 1.5), Vector3.new(24, 13, 0.4), {\n		color = Color3.fromRGB(148, 116, 88),\n		material = Enum.Material.Fabric,\n	}).CastShadow = false\n	local PIN = { OFF_WHITE, PALE_BLUE, Color3.fromRGB(238, 214, 168), Color3.fromRGB(206, 216, 232) }\n	for i = 1, 8 do\n		local col = (i - 1) % 4\n		local row = math.floor((i - 1) / 4)\n		Kit.Block(parent, `ArtPinned{i}`, at(cx - 9 + col * 6, y + 15 - row * 5.4, rect.z2 - 1.75), Vector3.new(4.6, 4.2, 0.2), {\n			color = PIN[col + 1],\n		}).CastShadow = false\n	end\nend\n\nlocal function fitReading(parent: Instance, at: (number, number, number) -> Vector3, rect: Rect, y: number)\n	local cx = (rect.x1 + rect.x2) / 2\n	local cz = (rect.z1 + rect.z2) / 2\n	local SPINE = {\n		DEEP_BLUE,\n		Color3.fromRGB(168, 88, 74),\n		Color3.fromRGB(96, 132, 96),\n		Color3.fromRGB(196, 158, 88),\n		Color3.fromRGB(112, 104, 148),\n	}\n\n	-- Low shelves down both sides. Low, because a room lined with tall stacks is a library --\n	-- the point of this one is that you can see across it from the door.\n	-- `face` is which way the shelf opens: the left run faces into the room (+x), the right run\n	-- faces back across it (-x). Without it the boards and the books are laid on the carcass\n	-- centreline, which puts them inside the shelf rather than on it.\n	for _, run in { { n = \"L\", x = rect.x1 + 2.8, face = 1 }, { n = \"R\", x = rect.x2 - 2.8, face = -1 } } do\n		local z1, z2 = rect.z1 + 10, rect.z2 - 10\n		local len = z2 - z1\n		-- A back panel and a top, not a solid box. A shelf modelled as one block has its boards\n		-- and its books buried inside it -- physically what a real carcass does, and useless\n		-- here, because everything that makes it read as a bookshelf ends up hidden in the wood.\n		Kit.Block(parent, `ReadShelfBack{run.n}`, at(run.x - run.face * 1.6, y + 4, (z1 + z2) / 2), Vector3.new(0.9, 8, len), {\n			color = WALNUT,\n			material = Enum.Material.Wood,\n			collide = true,\n		})\n		Kit.Block(parent, `ReadShelfTop{run.n}`, at(run.x, y + 8.2, (z1 + z2) / 2), Vector3.new(4, 0.5, len), {\n			color = WALNUT,\n			material = Enum.Material.Wood,\n		}).CastShadow = false\n		for tier = 1, 3 do\n			Kit.Block(parent, `ReadTier{run.n}{tier}`, at(run.x, y + tier * 2.4, (z1 + z2) / 2), Vector3.new(3.2, 0.3, len - 0.6), {\n				color = Color3.fromRGB(212, 218, 228),\n			}).CastShadow = false\n		end\n		local bays = math.max(3, math.floor(len / 7))\n		for i = 1, bays do\n			for tier = 1, 3 do\n				Kit.Block(parent, `ReadBooks{run.n}{i}_{tier}`, at(run.x + run.face * 0.2, y + tier * 2.4 + 1.1, z1 + len * ((i - 0.5) / bays)), Vector3.new(2.4, 1.9, 5), {\n					color = SPINE[(i + tier) % 5 + 1],\n				}).CastShadow = false\n			end\n		end\n	end\n\n	-- Armchairs at the four corners with a lamp beside each. This room's whole reason to exist\n	-- is that it is somewhere a player would choose to sit, and four corners is what makes it\n	-- read as seating rather than as furniture in storage.\n	for _, corner in { { sx = -1, sz = -1 }, { sx = 1, sz = -1 }, { sx = -1, sz = 1 }, { sx = 1, sz = 1 } } do\n		local ax = cx + corner.sx * 10\n		local az = cz + corner.sz * 28\n		local tag = `{if corner.sx < 0 then \"L\" else \"R\"}{if corner.sz < 0 then \"F\" else \"B\"}`\n		Kit.Block(parent, `ReadChair{tag}`, at(ax, y + 1.8, az), Vector3.new(6, 3.6, 6), {\n			color = Color3.fromRGB(118, 132, 190),\n			material = Enum.Material.Fabric,\n			collide = true,\n		})\n		Kit.Block(parent, `ReadChairBack{tag}`, at(ax, y + 4.4, az + corner.sz * 2.6), Vector3.new(6, 5.2, 1.2), {\n			color = Color3.fromRGB(104, 118, 176),\n			material = Enum.Material.Fabric,\n		}).CastShadow = false\n		Kit.Block(parent, `ReadLamp{tag}`, at(ax + corner.sx * 4.6, y + 4, az), Vector3.new(0.4, 8, 0.4), {\n			color = Color3.fromRGB(72, 76, 86),\n			material = Enum.Material.Metal,\n		}).CastShadow = false\n		Kit.Block(parent, `ReadShade{tag}`, at(ax + corner.sx * 4.6, y + 8.4, az), Vector3.new(3, 2.2, 3), {\n			color = Color3.fromRGB(248, 240, 214),\n			material = Enum.Material.Neon,\n		}).CastShadow = false\n	end\nend\n\n-- Wall trim: skirting, a dado rail with a panelled band under it, a picture rail near the\n-- ceiling, and beams across it.\n--\n-- **This is the highest-value detail in the building per part spent, and the reason is scale\n-- rather than decoration.** A room 27 studs floor-to-ceiling has about 15 studs of wall above\n-- head height, and painted flat white that reads as a wall with nothing on it however much\n-- furniture is standing on the floor. The eye has nothing to measure the height against, so a\n-- tall room looks like a small room that has been stretched.\n--\n-- Three horizontal lines fix that, because each one is a known height: a skirting is ankle\n-- high, a dado is hip high, a picture rail is above a door. Give a wall those and it announces\n-- its own size. The panelled band between skirting and dado is the classic school corridor\n-- treatment and costs one part per wall.\n--\n-- Beams do the same job for the ceiling, which is the other surface a tall room has too much\n-- of, and they give the ceiling lights something to sit against.\nlocal function dressWalls(parent: Instance, at: (number, number, number) -> Vector3, id: string, x1: number, x2: number, z1: number, z2: number, y: number, height: number)\n	local width = x2 - x1\n	local depth = z2 - z1\n	local DADO = 4.6\n	local RAIL_Y = math.min(height - 4, DOOR_H + 12)\n	local TRIM = Color3.fromRGB(232, 236, 244)\n	local PANEL = Color3.fromRGB(206, 214, 228)\n	local BEAM = Color3.fromRGB(222, 226, 234)\n\n	-- The two long walls, and the back wall.\n	local runs = {\n		{ n = \"L\", cx = x1 + 0.5, cz = (z1 + z2) / 2, len = depth, along = true },\n		{ n = \"R\", cx = x2 - 0.5, cz = (z1 + z2) / 2, len = depth, along = true },\n		{ n = \"B\", cx = (x1 + x2) / 2, cz = z2 - 0.5, len = width, along = false },\n	}\n	for _, r in runs do\n		local sz = function(t: number, h: number)\n			return if r.along then Vector3.new(t, h, r.len) else Vector3.new(r.len, h, t)\n		end\n		-- Panelled band from floor to dado, slightly proud of the wall so it casts a line.\n		Kit.Block(parent, `{id}Panel{r.n}`, at(r.cx, y + DADO / 2, r.cz), sz(0.5, DADO), {\n			color = PANEL,\n		}).CastShadow = false\n		-- Skirting at the foot and the dado rail on top of the band. Both stand further out\n		-- than the panel, which is what actually draws the shadow line.\n		Kit.Block(parent, `{id}Skirt{r.n}`, at(r.cx, y + 0.45, r.cz), sz(0.9, 0.9), {\n			color = TRIM,\n		}).CastShadow = false\n		Kit.Block(parent, `{id}Dado{r.n}`, at(r.cx, y + DADO, r.cz), sz(1, 0.7), {\n			color = TRIM,\n		}).CastShadow = false\n		-- Picture rail, up where the blank wall was.\n		Kit.Block(parent, `{id}Rail{r.n}`, at(r.cx, y + RAIL_Y, r.cz), sz(0.8, 0.55), {\n			color = TRIM,\n		}).CastShadow = false\n	end\n\n	-- Ceiling beams across the short dimension, spaced so each reads as its own bay.\n	local bays = math.max(2, math.floor(depth / 18))\n	for bay = 1, bays - 1 do\n		Kit.Block(parent, `{id}Beam{bay}`, at((x1 + x2) / 2, y + height - 1, z1 + depth * (bay / bays)), Vector3.new(width - 1.5, 1.6, 1.6), {\n			color = BEAM,\n		}).CastShadow = false\n	end\nend\n\nlocal function buildRooms(parent: Instance, at: (number, number, number) -> Vector3): { [string]: Vector3 }\n	local anchors: { [string]: Vector3 } = {}\n\n	for _, rect in ROOMS do\n		local y = floorY(rect.floor)\n		local cx, cz = rectCenter(rect)\n		local width = rect.x2 - rect.x1\n		local depth = rect.z2 - rect.z1\n\n		-- The two partitions that make it a room. The wall onto the corridor is glazed, which\n		-- is the single thing that stops an upper floor being a row of closed doors -- you can\n		-- see the lesson you are late for.\n		Kit.Wall(parent, `{rect.id}Left`, at(rect.x1, y, rect.z1), at(rect.x1, y, rect.z2), FLOOR_H - SLAB, WALL_T, { color = WHITE })\n		Kit.Wall(parent, `{rect.id}Right`, at(rect.x2, y, rect.z1), at(rect.x2, y, rect.z2), FLOOR_H - SLAB, WALL_T, { color = WHITE })\n		Kit.GlassWall(parent, `{rect.id}Front`, at(rect.x1 + 14, y, rect.z1), at(rect.x2, y, rect.z1), FLOOR_H - SLAB, WALL_T, 0.7, WHITE, GLASS_TINT)\n\n		-- The doorway, and a door in it.\n		--\n		-- It was an open gap, on the reasoning that a swinging door in a corridor a class\n		-- empties into is a thing to get stuck on. That reasoning is still right about *swinging*\n		-- -- so this does not swing. It is a glazed leaf in a frame, non-collidable, which reads\n		-- as a door from both sides and cannot trap anybody. A room you enter through a hole in\n		-- a wall reads as unfinished however good the room is.\n		Kit.Block(parent, `{rect.id}DoorFrame`, at(rect.x1 + 14, y + (FLOOR_H - SLAB) / 2, rect.z1), Vector3.new(0.8, FLOOR_H - SLAB, 1.4), { color = BLUE })\n		Kit.Block(parent, `{rect.id}DoorJamb`, at(rect.x1, y + (FLOOR_H - SLAB) / 2, rect.z1), Vector3.new(0.8, FLOOR_H - SLAB, 1.4), { color = BLUE })\n		Kit.Block(parent, `{rect.id}DoorHead`, at(rect.x1 + 7, y + DOOR_H, rect.z1), Vector3.new(14, 1.2, 1.4), { color = BLUE })\n		-- **A door that shuts.**\n		--\n		-- This was a non-collidable glazed leaf, on the reasoning that a swinging door in a\n		-- corridor a class empties into is something to get stuck on. That was the right worry\n		-- and the wrong answer: a leaf you walk through is not a door, it is a picture of one,\n		-- and the building was full of rooms you entered through a hole.\n		--\n		-- So it is solid and it swings. The stuck-in-the-doorway problem is handled by the swing\n		-- direction instead -- every room door opens *into its room*, away from the corridor, so\n		-- an opening leaf never sweeps the circulation route. Named `{id}DoorLeaf` because\n		-- FixtureService finds doors by name; see the PATTERNS note there.\n		Kit.Block(parent, `{rect.id}DoorLeaf`, at(rect.x1 + 7, y + DOOR_H / 2, rect.z1), Vector3.new(13.2, DOOR_H, 0.5), {\n			color = WALNUT,\n			material = Enum.Material.WoodPlanks,\n			collide = true,\n		})\n		-- A vision panel. Every school door has one, and it is what stops a corridor of shut\n		-- doors reading as a corridor of walls.\n		Kit.Block(parent, `{rect.id}DoorVision`, at(rect.x1 + 7, y + DOOR_H * 0.68, rect.z1), Vector3.new(4.6, DOOR_H * 0.34, 0.3), {\n			color = GLASS_TINT,\n			material = Enum.Material.Glass,\n			transparency = 0.4,\n		}).CastShadow = false\n		-- The push bar, which is what makes a glass panel read as a door rather than a window.\n		Kit.Block(parent, `{rect.id}DoorBar`, at(rect.x1 + 7, y + DOOR_H * 0.45, rect.z1 - 0.4), Vector3.new(7, 0.5, 0.5), {\n			color = Color3.fromRGB(206, 212, 222),\n			material = Enum.Material.Metal,\n		}).CastShadow = false\n\n		-- The sign over the door, which is how a player finds a subject at all.\n		local plate = Kit.Block(parent, `{rect.id}Plate`, at(rect.x1 + 7, y + DOOR_H + 2.4, rect.z1 - 1.2), Vector3.new(12, 2.8, 0.4), { color = WHITE })\n		Kit.Sign(plate, string.upper(rect.label), 12, LABEL_DIST, DEEP_BLUE)\n\n		dressWalls(parent, at, rect.id, rect.x1, rect.x2, rect.z1, rect.z2, y, FLOOR_H - SLAB)\n\n		-- Lights on a grid.\n		for ax = 1, FIT.LightsAcross do\n			for az = 1, FIT.LightsAlong do\n				Kit.LightPanel(\n					parent,\n					`{rect.id}Light{ax}_{az}`,\n					at(rect.x1 + width * ((ax - 0.5) / FIT.LightsAcross), y + FLOOR_H - SLAB - 0.6, rect.z1 + depth * ((az - 0.5) / FIT.LightsAlong)),\n					7,\n					2\n				)\n			end\n		end\n\n		if rect.kind == \"washroom\" then\n			fitWashroom(parent, at, rect, y)\n		elseif rect.kind == \"science\" then\n			fitScience(parent, at, rect, y)\n		elseif rect.kind == \"art\" then\n			fitArt(parent, at, rect, y)\n		elseif rect.kind == \"reading\" then\n			fitReading(parent, at, rect, y)\n		elseif rect.kind == \"class\" then\n			fitClassroom(parent, at, rect, y)\n		elseif rect.kind == \"cafeteria\" then\n			fitCafeteria(parent, at, rect, y)\n		elseif rect.kind == \"library\" then\n			fitLibrary(parent, at, rect, y)\n		elseif rect.kind == \"cooking\" then\n			fitCooking(parent, at, rect, y)\n		elseif rect.kind == \"lounge\" then\n			fitLounge(parent, at, rect, y)\n		elseif rect.kind == \"common\" then\n			fitCommon(parent, at, rect, y)\n		end\n\n		-- The anchor the verbs hang off. Set back from the door so a bench laid on it has the\n		-- room around it rather than the doorway.\n		anchors[rect.id] = at(cx, y, cz)\n	end\n\n	return anchors\nend\n\n-- ---------------------------------------------------------------------------------------\n-- The aquatic centre, attached on the left.\n-- ---------------------------------------------------------------------------------------\n\nlocal function buildPool(parent: Instance, at: (number, number, number) -> Vector3): Vector3\n	local half = W / 2\n	-- Butted against the left elevation, so the two buildings share a wall line rather than\n	-- standing as separate sheds with a gap between them.\n	local x0 = -half - POOL.HallWidthStuds\n	local x1 = -half\n	local cx = (x0 + x1) / 2\n	local cz = POOL.HallDepthStuds / 2\n	local hallH = FLOOR_H * 2\n\n	Kit.Slab(parent, \"PoolFloor\", at(cx, 0.4, cz), POOL.HallWidthStuds, POOL.HallDepthStuds, 0.6, { color = TILE })\n	Kit.Wall(parent, \"PoolBack\", at(x0, 0.4, POOL.HallDepthStuds), at(x1, 0.4, POOL.HallDepthStuds), hallH, WALL_T, { color = WHITE })\n	Kit.Wall(parent, \"PoolEnd\", at(x0, 0.4, 0), at(x0, 0.4, POOL.HallDepthStuds), hallH, WALL_T, { color = WHITE })\n	Kit.GlassWall(parent, \"PoolFront\", at(x0, 0.4, 0), at(x1, 0.4, 0), hallH, WALL_T, 0.72, WHITE, GLASS_TINT)\n\n	-- The name across the front, which is what makes it an aquatic centre from the road.\n	local band = Kit.Block(parent, \"PoolBand\", at(cx, 6, -0.8), Vector3.new(POOL.HallWidthStuds, 5, 1), { color = BLUE })\n	Kit.Sign(band, \"AGES AQUATIC CENTER\", POOL.HallWidthStuds * 0.6, LABEL_DIST * 2.5, WHITE)\n\n	-- The barrel roof. Each rib is a flat panel turned a little further than the last, which\n	-- approximates an arch closely enough at this scale and costs one part per rib -- a real\n	-- curved mesh would be an asset dependency, and the kit deliberately has none.\n	local riseY = 0.4 + hallH\n	for rib = 1, POOL.RoofRibs do\n		local share = (rib - 0.5) / POOL.RoofRibs\n		local angle = math.pi * share\n		local ribX = cx + math.cos(angle) * (POOL.HallWidthStuds / 2)\n		local ribY = riseY + math.sin(angle) * POOL.RoofRiseStuds\n		local panel = Kit.Block(parent, `PoolRib{rib}`, at(ribX, ribY, cz), Vector3.new(POOL.HallWidthStuds / POOL.RoofRibs + 1.5, 0.5, POOL.HallDepthStuds), {\n			color = GLASS_TINT,\n			material = Enum.Material.Glass,\n			transparency = 0.45,\n			collide = true,\n		})\n		panel.CastShadow = false\n		-- The steel between the panes.\n		Kit.Block(parent, `PoolRibArch{rib}`, at(ribX, ribY, cz), Vector3.new(0.7, 0.9, POOL.HallDepthStuds), {\n			color = OFF_WHITE,\n			material = Enum.Material.Metal,\n		})\n	end\n\n	-- The tank, sunk into the floor: a hole in the slab is not possible, so the water sits in\n	-- a box whose walls are the coping and whose bottom is the tiled floor of the pool.\n	local wx = cx\n	local wz = cz\n	local wHalfW = POOL.WaterWidthStuds / 2\n	local wHalfD = POOL.WaterDepthStuds / 2\n	local depthBelow = POOL.WaterDepthBelowStuds\n\n	Kit.Slab(parent, \"PoolBottom\", at(wx, 0.4 - depthBelow, wz), POOL.WaterWidthStuds, POOL.WaterDepthStuds, 0.5, { color = PALE_BLUE })\n	for side = -1, 1, 2 do\n		Kit.Wall(parent, `PoolWallX{side}`, at(wx + side * wHalfW, 0.4 - depthBelow, wz - wHalfD), at(wx + side * wHalfW, 0.4 - depthBelow, wz + wHalfD), depthBelow, 0.8, { color = WHITE })\n		Kit.Wall(parent, `PoolWallZ{side}`, at(wx - wHalfW, 0.4 - depthBelow, wz + side * wHalfD), at(wx + wHalfW, 0.4 - depthBelow, wz + side * wHalfD), depthBelow, 0.8, { color = WHITE })\n	end\n\n	-- Lane markings on the bottom, then the water over them.\n	for lane = 1, POOL.Lanes - 1 do\n		local z = wz - wHalfD + POOL.WaterDepthStuds * (lane / POOL.Lanes)\n		Kit.Slab(parent, `PoolLane{lane}`, at(wx, 0.4 - depthBelow + 0.5, z), POOL.WaterWidthStuds - 2, 0.8, 0.2, { color = DEEP_BLUE, collide = false })\n	end\n\n	local water = Kit.Block(parent, \"PoolWater\", at(wx, 0.4 - depthBelow / 2, wz), Vector3.new(POOL.WaterWidthStuds, depthBelow - 0.6, POOL.WaterDepthStuds), {\n		color = WATER,\n		material = Enum.Material.Glass,\n		transparency = 0.35,\n		reflectance = 0.1,\n	})\n	water.CastShadow = false\n\n	-- Coping round the tank, so the edge reads as a lip rather than as water meeting tile.\n	for side = -1, 1, 2 do\n		Kit.Slab(parent, `Coping{side}`, at(wx + side * (wHalfW + 1.5), 0.7, wz), 3, POOL.WaterDepthStuds + 6, 0.5, { color = WHITE })\n		Kit.Slab(parent, `CopingZ{side}`, at(wx, 0.7, wz + side * (wHalfD + 1.5)), POOL.WaterWidthStuds + 6, 3, 0.5, { color = WHITE })\n	end\n\n	-- Spectator benches, a lifeguard chair and a diving board -- the three things that make a\n	-- pool hall read as a pool hall rather than as a flooded room.\n	for row = 1, POOL.BenchRows do\n		Kit.Block(parent, `PoolBench{row}`, at(wx, 0.4 + row * 1.6, wz + wHalfD + 8 + row * 3), Vector3.new(POOL.WaterWidthStuds * 0.7, 1.4, 3), { color = OFF_WHITE })\n	end\n	Kit.Block(parent, \"Lifeguard\", at(wx + wHalfW + 6, 5, wz), Vector3.new(3.4, 10, 3.4), { color = WOOD })\n	Kit.Block(parent, \"LifeguardSeat\", at(wx + wHalfW + 6, 10.4, wz), Vector3.new(4.4, 0.6, 4.4), { color = WHITE })\n	Kit.Block(parent, \"DivingBoard\", at(wx - wHalfW + 6, 8, wz - wHalfD - 3), Vector3.new(12, 0.5, 3), { color = WHITE })\n	Kit.Block(parent, \"DivingTower\", at(wx - wHalfW - 1, 4, wz - wHalfD - 3), Vector3.new(4, 8, 4), { color = CONCRETE })\n\n	for index = 1, 8 do\n		Kit.LightPanel(parent, `PoolLight{index}`, at(x0 + POOL.HallWidthStuds * ((index - 0.5) / 8), 0.4 + hallH - 1, cz), 9, 3)\n	end\n\n	return at(wx, 0.4, wz + wHalfD + 10)\nend\n\n-- ---------------------------------------------------------------------------------------\n-- The gym, attached on the right.\n-- ---------------------------------------------------------------------------------------\n\nlocal function buildGym(parent: Instance, at: (number, number, number) -> Vector3): Vector3\n	local half = W / 2\n	local x0 = half\n	local x1 = half + GYM.WidthStuds\n	local cx = (x0 + x1) / 2\n	local cz = GYM.DepthStuds / 2\n\n	Kit.Slab(parent, \"GymFloor\", at(cx, 0.4, cz), GYM.WidthStuds, GYM.DepthStuds, 0.6, { color = WOOD })\n	Kit.Wall(parent, \"GymBack\", at(x0, 0.4, GYM.DepthStuds), at(x1, 0.4, GYM.DepthStuds), GYM.HeightStuds, WALL_T, { color = WHITE })\n	Kit.Wall(parent, \"GymEnd\", at(x1, 0.4, 0), at(x1, 0.4, GYM.DepthStuds), GYM.HeightStuds, WALL_T, { color = WHITE })\n	Kit.GlassWall(parent, \"GymFront\", at(x0, 0.4, 0), at(x1, 0.4, 0), GYM.HeightStuds, WALL_T, 0.55, WHITE, GLASS_TINT)\n	Kit.Slab(parent, \"GymRoof\", at(cx, 0.4 + GYM.HeightStuds, cz), GYM.WidthStuds, GYM.DepthStuds, 1.4, { color = OFF_WHITE })\n\n	local band = Kit.Block(parent, \"GymBand\", at(cx, 6, -0.8), Vector3.new(GYM.WidthStuds, 5, 1), { color = DEEP_BLUE })\n	Kit.Sign(band, \"GYMNASIUM\", GYM.WidthStuds * 0.55, LABEL_DIST * 2.5, WHITE)\n\n	-- Court markings. A centre circle drawn as a ring of short segments, because a torus is\n	-- not a part and a decal would be an asset id.\n	Kit.Slab(parent, \"GymCourt\", at(cx, 0.75, cz), GYM.WidthStuds - 14, GYM.DepthStuds - 14, 0.2, { color = Color3.fromRGB(206, 168, 116), collide = false })\n	for seg = 1, 24 do\n		local angle = (seg / 24) * math.pi * 2\n		Kit.Block(parent, `GymCircle{seg}`, at(cx + math.cos(angle) * 12, 0.85, cz + math.sin(angle) * 12), Vector3.new(3.4, 0.2, 0.6), {\n			color = WHITE,\n			yawDegrees = -math.deg(angle),\n		})\n	end\n\n	-- Hoops at each end.\n	for index = 1, GYM.HoopCount do\n		local side = if index == 1 then -1 else 1\n		local z = cz + side * (GYM.DepthStuds / 2 - 8)\n		Kit.Column(parent, `HoopPost{index}`, at(cx, 0.4, z), 16, 1.4, DARK)\n		Kit.Block(parent, `Backboard{index}`, at(cx, 15, z - side * 1.6), Vector3.new(11, 6.5, 0.4), { color = WHITE, transparency = 0.25 })\n		Kit.Block(parent, `Rim{index}`, at(cx, 12.6, z - side * 4), Vector3.new(5.4, 0.4, 5.4), { color = Color3.fromRGB(226, 116, 62) })\n	end\n\n	-- Bleachers down one side.\n	for row = 1, 5 do\n		Kit.Block(parent, `Bleacher{row}`, at(x1 - 6 - row * 3, 0.4 + row * 2, cz), Vector3.new(3, 2, GYM.DepthStuds - 20), { color = OFF_WHITE })\n	end\n\n	-- Wall bars down the back and climbing ropes from the roof. Both are here because the\n	-- room got smaller: a compact gym has to be *denser* to still read as a gym, and these are\n	-- the two things that say \"school gymnasium\" rather than \"sports hall\" for almost no\n	-- parts. A bare box at 72 studs would read as emptier than the 88-stud one it replaced.\n	for index = 1, GYM.WallBars do\n		local share = (index - 0.5) / GYM.WallBars\n		local x = x0 + GYM.WidthStuds * share\n		for rung = 1, 9 do\n			Kit.Block(parent, `WallBar{index}_{rung}`, at(x, 2 + rung * 1.6, GYM.DepthStuds - 2), Vector3.new(5, 0.4, 0.4), {\n				color = WOOD,\n				material = Enum.Material.Wood,\n			}).CastShadow = false\n		end\n	end\n\n	for index = 1, GYM.RopeCount do\n		local x = x0 + GYM.WidthStuds * (index / (GYM.RopeCount + 1))\n		Kit.Block(parent, `Rope{index}`, at(x, GYM.HeightStuds / 2 + 2, cz - 12), Vector3.new(0.35, GYM.HeightStuds - 4, 0.35), {\n			color = Color3.fromRGB(184, 156, 108),\n			material = Enum.Material.Fabric,\n		}).CastShadow = false\n	end\n\n	for index = 1, 10 do\n		Kit.LightPanel(parent, `GymLight{index}`, at(x0 + GYM.WidthStuds * (((index - 1) % 5 + 0.5) / 5), 0.4 + GYM.HeightStuds - 1.5, cz + (if index > 5 then 16 else -16)), 10, 3)\n	end\n\n	return at(cx, 0.4, cz)\nend\n\n-- ---------------------------------------------------------------------------------------\n-- The track and field, behind the building.\n-- ---------------------------------------------------------------------------------------\n\nlocal function buildTrack(parent: Instance, at: (number, number, number) -> Vector3): Vector3\n	local centreZ = D + 40 + TRACK.TurnRadiusStuds\n	local halfStraight = TRACK.StraightStuds / 2\n\n	-- The infield first, so the lanes are laid over its edge rather than under it.\n	Kit.Slab(parent, \"Infield\", at(0, 0.5, centreZ), TRACK.StraightStuds + 10, TRACK.TurnRadiusStuds * 2 - 8, 0.5, {\n		color = GRASS,\n		material = Enum.Material.Grass,\n	})\n\n	for lane = 1, TRACK.Lanes do\n		local radius = TRACK.TurnRadiusStuds + (lane - 1) * TRACK.LaneWidthStuds\n		local width = TRACK.LaneWidthStuds\n\n		-- The two straights.\n		for side = -1, 1, 2 do\n			Kit.Slab(parent, `TrackStraight{lane}_{side}`, at(0, 0.55, centreZ + side * radius), TRACK.StraightStuds, width, 0.3, {\n				color = TRACK_RED,\n				collide = false,\n			})\n		end\n\n		-- The two turns, stepped round in segments. Each segment is a short slab turned to the\n		-- tangent, which is how you draw a curve out of rectangles without a mesh.\n		for side = -1, 1, 2 do\n			for seg = 1, TRACK.CurveSegments do\n				local share = (seg - 0.5) / TRACK.CurveSegments\n				local angle = -math.pi / 2 + math.pi * share\n				local px = side * (halfStraight + math.cos(angle) * radius)\n				local pz = centreZ + math.sin(angle) * radius\n				-- Segment length from the arc it has to cover, plus a hair so neighbours overlap\n				-- rather than leaving a hairline of ground showing between them.\n				local segLength = (math.pi * radius / TRACK.CurveSegments) + 0.6\n				Kit.Block(parent, `TrackTurn{lane}_{side}_{seg}`, at(px, 0.55, pz), Vector3.new(width, 0.3, segLength), {\n					color = TRACK_RED,\n					yawDegrees = -math.deg(angle) * side,\n				})\n			end\n		end\n	end\n\n	-- The pitch markings inside, and a goal at each end.\n	Kit.Slab(parent, \"PitchLineHalf\", at(0, 0.75, centreZ), 0.8, TRACK.TurnRadiusStuds * 2 - 16, 0.2, { color = WHITE, collide = false })\n	for side = -1, 1, 2 do\n		local gz = centreZ + side * (TRACK.TurnRadiusStuds - 14)\n		Kit.Block(parent, `GoalBar{side}`, at(0, TRACK.GoalHeightStuds, gz), Vector3.new(TRACK.GoalWidthStuds, 0.7, 0.7), { color = WHITE })\n		for post = -1, 1, 2 do\n			Kit.Column(parent, `GoalPost{side}_{post}`, at(post * TRACK.GoalWidthStuds / 2, 0.6, gz), TRACK.GoalHeightStuds, 0.7, WHITE)\n		end\n	end\n\n	-- Floodlights at the corners, so the track reads at night.\n	for sx = -1, 1, 2 do\n		for sz = -1, 1, 2 do\n			local base = at(sx * (halfStraight + 20), 0.5, centreZ + sz * (TRACK.TurnRadiusStuds + 30))\n			Kit.Column(parent, `Flood{sx}_{sz}`, base, 34, 2, CONCRETE)\n			Kit.LightPanel(parent, `FloodHead{sx}_{sz}`, base + Vector3.new(0, 35, 0), 8, 4)\n		end\n	end\n	return at(0, 0.5, centreZ)\nend\n\n-- ---------------------------------------------------------------------------------------\n-- Standing down the map's own school.\n-- ---------------------------------------------------------------------------------------\n\n-- Everything the map builds for a school, which this one replaces.\n--\n-- Five models across two assets, and the list was measured rather than guessed: every one of\n-- them carries **no attributes at all**, so standing them down removes geometry and nothing\n-- else. The street's place points are a sibling model and are never touched, which is why\n-- `school` still resolves afterwards and every service that looks it up still works.\n--\n-- Deliberately absent, and they must stay absent: `City.RunningTrack` (FacilityKind=track),\n-- `City.SoccerField` and `City.BoxingGym` (SportsDrillKind). Those carry attributes other\n-- systems read, so hiding them would break a capability rather than replace one.\nlocal OLD_SCHOOL: { StandDown.Target } = {\n	{ parent = \"Street\", model = \"School\" },\n	{ parent = \"Street\", model = \"SchoolFittings\" },\n	{ parent = \"City\", model = \"SchoolFields\" },\n	{ parent = \"City\", model = \"SchoolFieldsTrees\" },\n	{ parent = \"City\", model = \"SchoolFieldsFittings\" },\n}\n\nlocal STAND_DOWN_KEY = \"School\"\n\nlocal function standDownOldSchool(): number\n	return StandDown.Hide(STAND_DOWN_KEY, OLD_SCHOOL)\nend\n\n-- ---------------------------------------------------------------------------------------\n-- Build.\n-- ---------------------------------------------------------------------------------------\n\n-- Lays the whole school around a centre point, once.\n--\n-- Nil means it did not lay, which every caller must treat as \"the building is not there\" --\n-- the pad, the sign and the verb rooms all still work without it, which is deliberate: a\n-- building that failed to appear should cost the player a nice-looking school and not their\n-- afternoon.\nfunction SchoolCopy.Build(center: Vector3): Plan?\n	local existing = plan\n	if existing ~= nil then\n		return existing\n	end\n	if not BUILDING.Enabled then\n		return nil\n	end\n\n	local parent = schoolFolder()\n	-- The only place the centre is added in. Everything above this line is local coordinates,\n	-- which is what lets the whole building move with its place point.\n	--\n	-- Named `toWorld` rather than `at` even though every builder receives it as `at`, because\n	-- a file-level local sharing a name with a parameter used two hundred lines above it\n	-- reads to the gate's declaration-order check as a use before declaration. CLAUDE.md\n	-- names that false positive and says the checks that produced them were dropped rather\n	-- than tuned, so the fix belongs here.\n	local function toWorld(x: number, y: number, z: number): Vector3\n		-- OFFSET is applied here and nowhere else: the place point marks the door, and the\n		-- building sits back from it. Both this and SetEvent's copy must agree, or prom would\n		-- be laid where the gym used to be.\n		return center + OFFSET + Vector3.new(x, y, z)\n	end\n\n	-- The map's own school comes down first, or the player walks through two buildings\n	-- standing in one plot. See standDownOldSchool for why this hides rather than destroys.\n	standDownOldSchool()\n\n	buildSite(parent, toWorld)\n	buildShell(parent, toWorld)\n	buildFrontage(parent, toWorld)\n	buildStairs(parent, toWorld)\n	buildLobby(parent, toWorld)\n	buildCorridors(parent, toWorld)\n	local anchors = buildRooms(parent, toWorld)\n\n	-- The corridor line, so the bully system can stand people along the hallway this file\n	-- laid rather than laying a second one beside it. The left-hand end rather than the\n	-- middle, because Corridor measures its run forward from the point it is handed.\n	anchors.corridor = toWorld(-W / 2 + WALL_T, 0, D - WALL_T - BAND_D - CORRIDOR_W / 2)\n\n	anchors.pool = buildPool(parent, toWorld)\n	anchors.gym = buildGym(parent, toWorld)\n	-- The track is off by default: the map already has one, and ours added 176 studs of depth\n	-- to a building that had nowhere to stand. See Config.School.Track.Enabled.\n	--\n	-- The anchor still has to exist, because PE and the sports drills look it up. When the track\n	-- is not built it falls back to the place point, which is what every other room in this file\n	-- does when its geometry is missing -- the verb keeps working, it just happens on open\n	-- ground rather than on a marked lane.\n	local field = if TRACK.Enabled then buildTrack(parent, toWorld) else toWorld(0, 0.4, D + 40)\n	anchors.track = field\n\n	-- With the building already baked into the map, the parts just laid are a duplicate\n	-- standing inside it. The *anchors* are what this run was for -- they are computed by\n	-- laying the rooms, not stored anywhere -- so the geometry is thrown away and the plan is\n	-- kept. Nothing was ever parented into the world; see schoolFolder.\n	if BUILDING.Baked then\n		local existing = folder\n		if existing ~= nil then\n			existing:Destroy()\n		end\n		folder = nil\n	end\n\n	local built: Plan = {\n		center = center,\n		rooms = anchors,\n		entrance = toWorld(0, 0, -4),\n		atrium = toWorld(0, 0, (ATRIUM_Z1 + ATRIUM_Z2) / 2),\n		field = field,\n	}\n	plan = built\n	return built\nend\n\n-- ---------------------------------------------------------------------------------------\n-- Events: the nights the gymnasium is dressed for something.\n-- ---------------------------------------------------------------------------------------\n\n-- Everything an event puts up lives in its own folder, so taking it down is one Destroy and\n-- the gym underneath is never touched. That separation is the whole design: the gym is a gym\n-- three hundred days a year and a ballroom on the other five, and neither version has to\n-- know the other exists.\nlocal eventFolder: Folder? = nil\nlocal currentEvent: string? = nil\n\nlocal function eventParent(): Folder\n	local existing = eventFolder\n	if existing ~= nil and existing.Parent ~= nil then\n		return existing\n	end\n	local made = Instance.new(\"Folder\")\n	made.Name = \"SchoolEvent\"\n	made.Parent = workspace\n	eventFolder = made\n	return made\nend\n\n-- Dresses the gymnasium for prom, or clears it.\n--\n-- The gym is the venue on purpose, and it is worth saying why rather than treating it as\n-- obvious. A school has exactly one room big enough to hold everybody, and every real school\n-- therefore holds its dances in it. Building a separate ballroom would mean adding a space\n-- that is dead for all but one night a year -- which is the opposite of what a map this size\n-- needs, and which the reference photographs confirm: that is a basketball court under the\n-- streamers, and you can see the wall bars behind the stage.\n--\n-- Passing nil takes it all down. Returns whether anything changed, so a caller can tell the\n-- difference between \"prom started\" and \"prom was already on\".\nfunction SchoolCopy.SetEvent(id: string?): boolean\n	if currentEvent == id then\n		return false\n	end\n\n	local existing = eventFolder\n	if existing ~= nil then\n		existing:Destroy()\n	end\n	eventFolder = nil\n	currentEvent = id\n\n	if id == nil then\n		return true\n	end\n\n	local current = plan\n	if current == nil then\n		-- No building, so no gym to dress. Recorded as the current event anyway: the caller\n		-- asked for prom and prom is what is on, it simply has nowhere to be yet.\n		return true\n	end\n\n	local center = current.center\n	local function toWorld(x: number, y: number, z: number): Vector3\n		-- OFFSET is applied here and nowhere else: the place point marks the door, and the\n		-- building sits back from it. Both this and SetEvent's copy must agree, or prom would\n		-- be laid where the gym used to be.\n		return center + OFFSET + Vector3.new(x, y, z)\n	end\n\n	local parent = eventParent()\n	local half = W / 2\n	local x0 = half\n	local cx = x0 + GYM.WidthStuds / 2\n	local cz = GYM.DepthStuds / 2\n\n	local partyColors = {\n		Color3.fromRGB(236, 118, 176),\n		Color3.fromRGB(146, 106, 214),\n		Color3.fromRGB(98, 168, 236),\n		Color3.fromRGB(246, 196, 96),\n		Color3.fromRGB(240, 240, 246),\n	}\n\n	-- The dance floor: a parquet square in the middle, lit from above. Everything else in the\n	-- room arranges itself around this, which is why it is laid first.\n	Kit.Slab(parent, \"DanceFloor\", toWorld(cx, 0.9, cz), EVENTS.FloorStuds, EVENTS.FloorStuds, 0.4, {\n		color = Color3.fromRGB(196, 150, 104),\n		material = Enum.Material.WoodPlanks,\n	})\n\n	-- Coloured washes over it. Neon discs rather than real lights for the reason the ceiling\n	-- panels are: a dozen PointLights in one room costs more than the building.\n	for index = 1, EVENTS.Spotlights do\n		local angle = (index / EVENTS.Spotlights) * math.pi * 2\n		local r = EVENTS.FloorStuds * 0.3\n		Kit.Spotlight(\n			parent,\n			`PromSpot{index}`,\n			toWorld(cx + math.cos(angle) * r, 1.2, cz + math.sin(angle) * r),\n			7,\n			partyColors[((index - 1) % #partyColors) + 1]\n		)\n	end\n\n	-- The stage at the far end, with the throne on it.\n	local stageZ = cz + GYM.DepthStuds / 2 - EVENTS.StageDepthStuds - 4\n	Kit.Slab(parent, \"PromStage\", toWorld(cx, 0.4 + EVENTS.StageRiseStuds, stageZ), EVENTS.StageWidthStuds, EVENTS.StageDepthStuds, EVENTS.StageRiseStuds, {\n		color = Color3.fromRGB(196, 62, 78),\n		material = Enum.Material.Fabric,\n	})\n	Kit.Block(parent, \"PromThrone\", toWorld(cx, 0.4 + EVENTS.StageRiseStuds + 3, stageZ + 1), Vector3.new(6, 6, 4), {\n		color = Color3.fromRGB(226, 186, 84),\n		material = Enum.Material.Metal,\n	})\n	Kit.Block(parent, \"PromThroneBack\", toWorld(cx, 0.4 + EVENTS.StageRiseStuds + 8, stageZ + 2.6), Vector3.new(6, 10, 1), {\n		color = Color3.fromRGB(226, 186, 84),\n		material = Enum.Material.Metal,\n	})\n\n	-- The banner over the stage.\n	local banner = Kit.Block(parent, \"PromBanner\", toWorld(cx, 16, stageZ + 4), Vector3.new(EVENTS.StageWidthStuds + 8, 4, 0.4), {\n		color = Color3.fromRGB(236, 118, 176),\n	})\n	banner.CastShadow = false\n	Kit.Sign(banner, \"AGES PROM\", 24, LABEL_DIST * 2, Color3.fromRGB(255, 250, 252))\n\n	-- The DJ booth, off to one side of the stage.\n	Kit.Block(parent, \"DjBooth\", toWorld(cx - EVENTS.StageWidthStuds * 0.75, 2.4, stageZ - 2), Vector3.new(9, 4.8, 4), {\n		color = Color3.fromRGB(64, 46, 96),\n	})\n	Kit.Block(parent, \"DjDeck\", toWorld(cx - EVENTS.StageWidthStuds * 0.75, 5, stageZ - 2), Vector3.new(9.4, 0.4, 4.4), {\n		color = Color3.fromRGB(28, 30, 40),\n	})\n\n	-- The balloon arch at the way in, and clusters round the room.\n	Kit.BalloonArch(parent, \"PromArch\", toWorld(cx, 0.4, cz - GYM.DepthStuds / 2 + 6), 26, 16, EVENTS.ArchBalloons, partyColors)\n\n	for index = 1, EVENTS.BalloonClusters do\n		local angle = (index / EVENTS.BalloonClusters) * math.pi * 2\n		local r = EVENTS.FloorStuds * 0.78\n		Kit.BalloonCluster(\n			parent,\n			`PromBalloons{index}`,\n			toWorld(cx + math.cos(angle) * r, 0.4, cz + math.sin(angle) * r),\n			EVENTS.BalloonsPerCluster,\n			partyColors\n		)\n	end\n\n	-- Streamers across the ceiling, corner to corner.\n	for index = 1, EVENTS.Streamers do\n		local share = (index - 0.5) / EVENTS.Streamers\n		local z = cz - GYM.DepthStuds / 2 + GYM.DepthStuds * share\n		Kit.Streamer(\n			parent,\n			`PromStreamer{index}`,\n			toWorld(x0 + 3, GYM.HeightStuds - 3, z),\n			toWorld(x0 + GYM.WidthStuds - 3, GYM.HeightStuds - 3, z),\n			8,\n			partyColors[((index - 1) % #partyColors) + 1]\n		)\n	end\n\n	-- Folding chairs round the edge and a few round tables, so the room has somewhere to sit\n	-- out a song. Deliberately at the perimeter: chairs on the floor would be the one thing\n	-- that stops it being a dance floor.\n	for index = 1, EVENTS.Chairs do\n		local angle = (index / EVENTS.Chairs) * math.pi * 2\n		local r = EVENTS.FloorStuds * 0.92\n		Kit.Block(parent, `PromChair{index}`, toWorld(cx + math.cos(angle) * r, 2, cz + math.sin(angle) * r), Vector3.new(2.6, 0.4, 2.6), {\n			color = Color3.fromRGB(48, 52, 68),\n			yawDegrees = -math.deg(angle),\n		})\n	end\n	for index = 1, EVENTS.Tables do\n		local angle = ((index - 0.5) / EVENTS.Tables) * math.pi * 2\n		local r = EVENTS.FloorStuds * 1.12\n		local spot = toWorld(cx + math.cos(angle) * r, 0.4, cz + math.sin(angle) * r)\n		Kit.Block(parent, `PromTable{index}`, spot + Vector3.new(0, 3, 0), Vector3.new(7, 0.4, 7), { color = Color3.fromRGB(246, 240, 244) })\n		Kit.Block(parent, `PromTableLeg{index}`, spot + Vector3.new(0, 1.5, 0), Vector3.new(1.2, 3, 1.2), { color = Color3.fromRGB(120, 96, 108) })\n	end\n\n	return true\nend\n\n-- Which event is dressed, or nil. Read rather than built.\nfunction SchoolCopy.Event(): string?\n	return currentEvent\nend\n\n-- Puts the map's own school back and takes this one down. The undo, for deciding by eye\n-- which building the game should have.\nfunction SchoolCopy.RestoreOldSchool(): number\n	local put = StandDown.Restore(STAND_DOWN_KEY)\n	if put > 0 then\n		SchoolCopy.Clear()\n	end\n	return put\nend\n\n-- Whether the map's school is currently stood down.\nfunction SchoolCopy.OldSchoolStoodDown(): boolean\n	return StandDown.IsHidden(STAND_DOWN_KEY)\nend\n\n-- Which of the map's models are stood down, by name.\nfunction SchoolCopy.StoodDownNames(): { string }\n	return StandDown.Names(STAND_DOWN_KEY)\nend\n\n-- The building as it stands, or nil if it has not been laid. Read rather than built, so a\n-- debug command describing the school cannot be the thing that creates it.\nfunction SchoolCopy.Plan(): Plan?\n	return plan\nend\n\n-- Where a named room is, in world coordinates, or nil if there is no such room or the\n-- building is not up.\n--\n-- **This is the entire join between the building and the lessons.** ScienceService does not\n-- know where the lab is; it asks for \"science\" and lays its benches around whatever comes\n-- back. That is what lets a wall move without a subject breaking, and a subject be added\n-- without a wall moving.\nfunction SchoolCopy.RoomAt(id: string): Vector3?\n	local current = plan\n	if current == nil then\n		return nil\n	end\n	return current.rooms[id]\nend\n\n-- Takes the school down. The new-life path, and the same reason Corridor.Clear exists: the\n-- building is rebuilt around whichever place point the next life walks into.\nfunction SchoolCopy.Clear()\n	local existing = folder\n	if existing ~= nil then\n		existing:Destroy()\n	end\n	folder = nil\n	plan = nil\n	-- And whatever the gym was dressed for. A prom left standing over a school that no longer\n	-- exists is the kind of thing that survives a new life and cannot be explained.\n	SchoolCopy.SetEvent(nil)\nend\n\nreturn SchoolCopy\n"
table.insert(AGES_MANIFEST, "src/server/world/SchoolCopy.luau")
AGES_SOURCES["src/server/world/SchoolCopyInteractive.luau"] = "--!strict\n-- The interactive layer for the editable copy of v1: doors, lockers, light switches, seats.\n--\n-- **Scoped to `Workspace.SchoolV1Copy` and nothing else.** v1 has its own interactivity through\n-- FixtureService, which scans `Workspace.School`; the two never touch the same model, which is\n-- the whole point of the copy existing. If this file ever starts scanning `School`, it has\n-- become an edit to v1.\n--\n-- **Everything is derived from the parts already in the model.** No coordinates are written\n-- down here and no plan is imported: a door tells you where its room is, a locker bank tells\n-- you how wide it is and which way it faces. That matters because the copy is a fork whose\n-- dimensions are meant to change -- anything hardcoded here would be wrong the first time\n-- somebody widens a corridor in SchoolCopy.luau.\n--\n-- Runs at play time, because every instance it makes -- ProximityPrompt, Seat, PointLight --\n-- is one the asset bake cannot carry.\n\nlocal TweenService = game:GetService(\"TweenService\")\n\nlocal Interactive = {}\n\nlocal MODEL_NAME = \"SchoolV1Copy\"\n\nlocal BLUE = Color3.fromRGB(58, 122, 206)\nlocal METAL = Color3.fromRGB(126, 132, 142)\nlocal WHITE = Color3.fromRGB(242, 243, 246)\nlocal SMOOTH = Enum.Material.SmoothPlastic\n\nlocal DOOR_SWING = TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)\nlocal LOCKER_SWING = TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)\nlocal AUTO_CLOSE_SECONDS = 4\nlocal DOOR_DEGREES = 90\nlocal LOCKER_DEGREES = 45\n\n-- ---------------------------------------------------------------------------------------\n-- Helpers\n-- ---------------------------------------------------------------------------------------\n\nlocal function part(parent: Instance, name: string, cf: CFrame, size: Vector3, material: Enum.Material, colour: Color3): Part\n	local p = Instance.new(\"Part\")\n	p.Name = name\n	p.Size = size\n	p.CFrame = cf\n	p.Anchored = true\n	p.CastShadow = true\n	p.Material = material\n	p.Color = colour\n	p.TopSurface = Enum.SurfaceType.Smooth\n	p.BottomSurface = Enum.SurfaceType.Smooth\n	p.Parent = parent\n	return p\nend\n\n-- One place makes every prompt, so the key, the hold and the wording cannot drift apart across\n-- four different kinds of interaction.\nlocal function promptOn(adornee: BasePart, action: string, object: string, key: Enum.KeyCode): ProximityPrompt\n	local prompt = Instance.new(\"ProximityPrompt\")\n	prompt.ActionText = action\n	prompt.ObjectText = object\n	prompt.KeyboardKeyCode = key\n	prompt.HoldDuration = 0\n	prompt.MaxActivationDistance = 12\n	prompt.RequiresLineOfSight = false\n	prompt.Parent = adornee\n	return prompt\nend\n\n-- A panel that swings about one vertical edge.\n--\n-- **The hinge is an edge, not the centre.** Rotating about the middle spins the panel like a\n-- turnstile and sweeps half of it backwards through the wall it is set in.\nlocal function hinged(panel: BasePart, degrees: number, info: TweenInfo, autoCloseSeconds: number?)\n	local shut = panel.CFrame\n	local half = panel.Size.X / 2\n	local pivot = shut * CFrame.new(-half, 0, 0)\n	local open = pivot * CFrame.Angles(0, math.rad(degrees), 0) * CFrame.new(half, 0, 0)\n\n	local isOpen = false\n	local token = 0\n\n	local function set(target: boolean)\n		isOpen = target\n		TweenService:Create(panel, info, { CFrame = if target then open else shut }):Play()\n	end\n\n	return function()\n		set(not isOpen)\n		if isOpen and autoCloseSeconds ~= nil then\n			-- The token is what stops a door that was opened, shut by hand and opened again from\n			-- being slammed by the first timer four seconds after the first press.\n			token += 1\n			local mine = token\n			task.delay(autoCloseSeconds, function()\n				if mine == token and isOpen then\n					set(false)\n				end\n			end)\n		end\n	end\nend\n\n-- ---------------------------------------------------------------------------------------\n-- Doors\n-- ---------------------------------------------------------------------------------------\n\nlocal function wireDoors(root: Instance): number\n	local made = 0\n	for _, leaf in root:GetDescendants() do\n		if leaf:IsA(\"BasePart\") and leaf.Name:match(\"DoorLeaf\") then\n			-- The leaves are already built and in the right place; they were simply never\n			-- movable. Making them collidable is what turns a decorative panel into a door --\n			-- a leaf you can walk through is a picture of a door.\n			leaf.CanCollide = true\n			promptOn(leaf, \"Interact\", \"Door\", Enum.KeyCode.E).Triggered:Connect(\n				hinged(leaf, DOOR_DEGREES, DOOR_SWING, AUTO_CLOSE_SECONDS)\n			)\n			made += 1\n		end\n	end\n	return made\nend\n\n-- ---------------------------------------------------------------------------------------\n-- Lockers\n-- ---------------------------------------------------------------------------------------\n\n-- The copy's lockers are baked as long solid banks with seams painted on. The brief wants a\n-- panel per locker, so each bank is divided at its own seam pitch and a real door hung in front\n-- of every division.\n--\n-- Width and facing are read off the bank rather than assumed: the corridor-side run and the\n-- room-side segments face opposite ways, and the room-side ones vary in length because they sit\n-- between classroom doors.\nlocal function wireLockers(root: Instance, into: Instance, corridorZ: number): number\n	local made = 0\n	for _, bank in root:GetDescendants() do\n		if not bank:IsA(\"BasePart\") then\n			continue\n		end\n		if not (bank.Name:match(\"^LockerBank%d+$\") or bank.Name:match(\"^RoomSideLocker%d+_%d+$\")) then\n			continue\n		end\n\n		-- Which face is the open one: whichever side of the bank points at the middle of the\n		-- corridor. Both runs are flush to a wall, so the corridor is always the way out.\n		local facing = if bank.Position.Z < corridorZ then 1 else -1\n		local doors = math.max(2, math.floor(bank.Size.X / 5))\n		local doorW = bank.Size.X / doors\n		local faceZ = bank.Position.Z + facing * (bank.Size.Z / 2)\n\n		for index = 1, doors do\n			local dx = bank.Position.X - bank.Size.X / 2 + doorW * (index - 0.5)\n			local leaf = part(\n				into,\n				`{bank.Name}Door{index}`,\n				CFrame.new(dx, bank.Position.Y, faceZ + facing * 0.3),\n				Vector3.new(doorW - 0.3, bank.Size.Y - 0.4, 0.4),\n				Enum.Material.Metal,\n				bank.Color\n			)\n			leaf.CanCollide = false\n			-- A dark slot behind it, so an open locker shows a hollow rather than the painted\n			-- back of the bank.\n			part(\n				into,\n				`{bank.Name}Slot{index}`,\n				CFrame.new(dx, bank.Position.Y, faceZ - facing * 0.9),\n				Vector3.new(doorW - 0.8, bank.Size.Y - 1.4, 1.4),\n				SMOOTH,\n				Color3.fromRGB(28, 32, 40)\n			).CanCollide = false\n\n			-- A handle, offset well clear of the panel face. Anything sitting on a surface has\n			-- to stand off it by more than the build grid, or it gets rounded back inside the\n			-- thing it is meant to sit on -- a bug this project has now found four separate times.\n			part(\n				into,\n				`{bank.Name}Handle{index}`,\n				CFrame.new(dx + doorW * 0.28, bank.Position.Y, faceZ + facing * 0.9),\n				Vector3.new(0.4, 1.6, 0.3),\n				Enum.Material.Metal,\n				METAL\n			).CanCollide = false\n\n			promptOn(leaf, \"Interact\", \"Locker\", Enum.KeyCode.E).Triggered:Connect(\n				hinged(leaf, LOCKER_DEGREES, LOCKER_SWING, nil)\n			)\n			made += 1\n		end\n	end\n	return made\nend\n\n-- ---------------------------------------------------------------------------------------\n-- Lights and switches\n-- ---------------------------------------------------------------------------------------\n\n-- A switch beside every door, owning the fittings in the room behind it.\n--\n-- The room's extent is not looked up anywhere: the fittings are stepped back from the door\n-- along the direction the room lies in, which the door itself gives. That keeps this correct\n-- when the copy's room sizes change, which they are expected to.\nlocal function wireLights(root: Instance, lighting: Instance, architecture: Instance, corridorZ: number): (number, number)\n	local fixtures, switches = 0, 0\n\n	for _, leaf in root:GetDescendants() do\n		if not (leaf:IsA(\"BasePart\") and leaf.Name:match(\"DoorLeaf\")) then\n			continue\n		end\n		-- Into the room, away from the corridor.\n		local inward = if leaf.Position.Z < corridorZ then -1 else 1\n		local ceilingY = leaf.Position.Y + leaf.Size.Y / 2 + 8\n\n		local group = Instance.new(\"Folder\")\n		group.Name = `Lights_{leaf.Name}`\n		group.Parent = lighting\n\n		local owned: { PointLight } = {}\n		for step = 1, 3 do\n			local panel = part(\n				group,\n				`Fixture{step}`,\n				CFrame.new(leaf.Position.X, ceilingY, leaf.Position.Z + inward * (10 + step * 16)),\n				Vector3.new(10, 0.4, 3),\n				Enum.Material.Neon,\n				Color3.fromRGB(250, 250, 244)\n			)\n			panel.CanCollide = false\n			local bulb = Instance.new(\"PointLight\")\n			bulb.Brightness = 1.6\n			bulb.Range = 44\n			bulb.Color = Color3.fromRGB(255, 250, 238)\n			bulb.Parent = panel\n			table.insert(owned, bulb)\n			fixtures += 1\n		end\n\n		local plate = part(\n			architecture,\n			`LightSwitch_{leaf.Name}`,\n			CFrame.new(leaf.Position.X + leaf.Size.X / 2 + 3, leaf.Position.Y, leaf.Position.Z),\n			Vector3.new(1.6, 2.4, 0.4),\n			SMOOTH,\n			WHITE\n		)\n		plate.CanCollide = false\n		local toggle = part(architecture, `LightSwitchToggle_{leaf.Name}`, plate.CFrame * CFrame.new(0, 0.3, -0.3), Vector3.new(0.7, 1, 0.3), SMOOTH, BLUE)\n		toggle.CanCollide = false\n\n		local on = true\n		promptOn(plate, \"Interact\", \"Lights\", Enum.KeyCode.E).Triggered:Connect(function()\n			on = not on\n			for _, bulb in owned do\n				bulb.Enabled = on\n			end\n			-- The panel drops off Neon too. A dark room whose ceiling still glows reads as\n			-- broken rather than as off.\n			for _, fixture in group:GetChildren() do\n				if fixture:IsA(\"BasePart\") then\n					fixture.Material = if on then Enum.Material.Neon else SMOOTH\n				end\n			end\n			toggle.CFrame = plate.CFrame * CFrame.new(0, if on then 0.3 else -0.3, -0.3)\n		end)\n		switches += 1\n	end\n\n	return fixtures, switches\nend\n\n-- ---------------------------------------------------------------------------------------\n-- Seating\n-- ---------------------------------------------------------------------------------------\n\n-- **An invisible Seat with CanTouch off, driven by the prompt.**\n--\n-- A Roblox Seat grabs anyone who brushes it and there is no property that disables that.\n-- `CanTouch = false` is the one that does: the seat stops firing its own touch handler, so\n-- `Seat:Sit` becomes the only way onto it -- which is exactly the manual seating the brief\n-- asks for. The visible chair the builder made is left untouched.\nlocal SEATABLE = { \"^Chair\", \"Stool%d*$\", \"^LoungeSofa%d+$\", \"^CafeBench\", \"Bench%d*$\" }\n\nlocal function wireSeats(root: Instance, into: Instance): number\n	local made = 0\n	for _, surface in root:GetDescendants() do\n		if not surface:IsA(\"BasePart\") then\n			continue\n		end\n		local match = false\n		for _, pattern in SEATABLE do\n			if surface.Name:match(pattern) then\n				match = true\n				break\n			end\n		end\n		-- Legs and backs are not seats. Without this every chair gets three prompts stacked on\n		-- top of each other and the player picks one at random.\n		if not match or surface.Name:match(\"Leg\") or surface.Name:match(\"Back\") then\n			continue\n		end\n\n		local seat = Instance.new(\"Seat\")\n		seat.Name = `{surface.Name}Seat`\n		seat.Size = Vector3.new(math.min(surface.Size.X, 3), 0.4, math.min(surface.Size.Z, 3))\n		seat.CFrame = surface.CFrame * CFrame.new(0, surface.Size.Y / 2 + 0.2, 0)\n		seat.Anchored = true\n		seat.CanCollide = false\n		seat.CanTouch = false\n		seat.Transparency = 1\n		seat.Parent = into\n\n		promptOn(seat, \"Sit Down\", \"Seat\", Enum.KeyCode.L).Triggered:Connect(function(player: Player)\n			local character = player.Character\n			local humanoid = character and character:FindFirstChildOfClass(\"Humanoid\")\n			if humanoid then\n				seat:Sit(humanoid)\n			end\n		end)\n		made += 1\n	end\n	return made\nend\n\n-- ---------------------------------------------------------------------------------------\n-- Build\n-- ---------------------------------------------------------------------------------------\n\nfunction Interactive.Build(): ()\n	local root = workspace:FindFirstChild(MODEL_NAME)\n	if root == nil then\n		warn(`[{MODEL_NAME}] not in Workspace -- nothing to make interactive`)\n		return\n	end\n\n	-- Where the corridor runs, measured rather than assumed: the locker banks are flush to its\n	-- two walls, so the midpoint between them is the corridor's centreline. That is what tells\n	-- every other loop which way is \"out of the wall\" and which way is \"into the room\".\n	local wallZ: { number } = {}\n	for _, p in root:GetDescendants() do\n		if p:IsA(\"BasePart\") and p.Name:match(\"^LockerBank%d+$\") then\n			table.insert(wallZ, p.Position.Z)\n		end\n		if p:IsA(\"BasePart\") and p.Name:match(\"^RoomSideLocker%d+_%d+$\") then\n			table.insert(wallZ, p.Position.Z)\n		end\n	end\n	if #wallZ == 0 then\n		warn(`[{MODEL_NAME}] no locker banks found -- cannot locate the corridor`)\n		return\n	end\n	local lo, hi = wallZ[1], wallZ[1]\n	for _, z in wallZ do\n		lo = math.min(lo, z)\n		hi = math.max(hi, z)\n	end\n	local corridorZ = (lo + hi) / 2\n\n	local folders = {}\n	for _, name in { \"Furniture\", \"Architecture\", \"Lighting\", \"Seating\" } do\n		local existing = root:FindFirstChild(name)\n		if existing == nil then\n			local made = Instance.new(\"Folder\")\n			made.Name = name\n			made.Parent = root\n			existing = made\n		end\n		folders[name] = existing\n	end\n\n	local doors = wireDoors(root)\n	local lockers = wireLockers(root, folders.Furniture, corridorZ)\n	local fixtures, switches = wireLights(root, folders.Lighting, folders.Architecture, corridorZ)\n	local seats = wireSeats(root, folders.Seating)\n\n	print(\n		`[{MODEL_NAME}] interactive: {doors} doors (E, 90 deg, {AUTO_CLOSE_SECONDS}s auto-close), `\n			.. `{lockers} locker panels (E, {LOCKER_DEGREES} deg), {fixtures} fittings on {switches} switches (E), `\n			.. `{seats} seats (L). Corridor centreline z={string.format(\"%.1f\", corridorZ)}.`\n	)\nend\n\nreturn Interactive\n"
table.insert(AGES_MANIFEST, "src/server/world/SchoolCopyInteractive.luau")
AGES_SOURCES["src/server/world/Spotting.luau"] = "--!strict\n-- Being noticed. One definition, for everybody in town who might look up.\n--\n-- Before this there were two, and they did not agree about anything. An officer saw you the\n-- instant you crossed a distance line -- a boolean, no build-up, no warning. A passer-by\n-- needed a flat 2.2 seconds and did not care who you were or what you were doing. Neither\n-- asked the question the whole chase is built on, which is *how much do you stand out right\n-- now*, and the consequence was that the single most important number in the crime system --\n-- the bounty on your head -- had no effect whatsoever on how easily you were found. It\n-- bought more officers and longer sight lines, and that was all.\n--\n-- So there was nothing to *do* about being wanted except be somewhere else. Every other\n-- system in this game gives the player a dial; this one gave them a wall.\n--\n-- What this module is: two halves that were always going to be needed together.\n--\n--   **Can they see you at all** -- distance, then a ray. Unchanged in behaviour from the\n--   check PoliceService already had, and lifted here so that the crowd, the police and\n--   (next) the gangs cannot drift apart on what \"in view\" means. The day somebody tunes\n--   one of those must not be the day the other two quietly change.\n--\n--   **How fast that turns into being spotted** -- which is new, and is the system. An\n--   observer fills a `notice` from 0 to 1 while they have you, at a rate set by how\n--   conspicuous you are. At 1 they have made you. Below 1 nothing has happened yet, and\n--   that gap is the entire point: it is room to walk out of.\n--\n-- Notice is not held here. It belongs to the observer -- one officer's opinion, one\n-- pedestrian's -- and every caller already has a per-observer table to keep it in. A module\n-- that owned it would need to know who all the observers are, which is the one thing it has\n-- no business knowing.\n--\n-- **Notice resets when line of sight breaks. It does not decay.** That is deliberate and it\n-- is load-bearing: it is what makes ducking behind a van a *move* rather than a pause, and\n-- it is the rule WitnessService was already written around. A decay would turn every piece\n-- of cover in the town into a slightly slower version of standing in the open.\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Config = require(ReplicatedStorage:WaitForChild(\"Config\"))\n\nlocal Ground = require(script.Parent.Ground)\n\nlocal Spotting = {}\n\nlocal SPOT = Config.Crime.Spotting\n\n-- What makes a person worth noticing. Every field is something the player can change,\n-- which is the test a term has to pass to be in here at all: a conspicuousness made of\n-- things outside the player's control would be a difficulty number wearing a system's\n-- clothes.\nexport type Factors = {\n	-- How wanted you are, as a share of the cap. The headline term.\n	heatShare: number,\n	-- How fast you are actually moving, in studs per second. Not what your WalkSpeed is\n	-- set to -- what your body is doing -- because standing still inside a shop with a\n	-- run speed configured is standing still.\n	speedStuds: number,\n	-- Whether you are wearing gang colors, which exist to be read across a street.\n	wearingColors: boolean,\n}\n\n-- How loud this person is, roughly 0.35 (still, clean, plain) to about 1.7 (sprinting,\n-- citywide, banded up).\n--\n-- Additive rather than multiplied. Multiplying would mean a clean player is unnoticeable\n-- no matter what else is true -- heat times zero is zero -- and \"invisible while clean\"\n-- is not the same claim as \"harder to notice while clean\". Every term stacks onto a floor,\n-- so there is no combination that switches the town's eyes off.\nfunction Spotting.Conspicuousness(factors: Factors): number\n	local loud = SPOT.Base\n	loud += SPOT.HeatShare * math.clamp(factors.heatShare, 0, 1)\n	-- Clamped rather than allowed to run, so that a body launched by physics -- knocked\n	-- down the stairs, thrown by a moving part -- does not briefly read as forty times\n	-- more conspicuous than a person can be.\n	loud += SPOT.MovementShare * math.clamp(factors.speedStuds / SPOT.RunSpeedStuds, 0, 1)\n	if factors.wearingColors then\n		loud += SPOT.ColorsBonus\n	end\n	return loud\nend\n\n-- How much of an observer's attention this distance is worth: 1 in their face, EdgeShare\n-- at the very limit of their range, 0 beyond it.\n--\n-- Linear on purpose. A curve here would be a nicer number and a worse instruction: the\n-- player cannot see this value, only feel it, and \"further away is proportionally safer\"\n-- is a thing a person can learn by playing. Anything fancier is indistinguishable from\n-- randomness from the far side of the screen.\nfunction Spotting.Closeness(distanceStuds: number, sightStuds: number): number\n	if sightStuds <= 0 or distanceStuds > sightStuds then\n		return 0\n	end\n	local share = 1 - math.clamp(distanceStuds / sightStuds, 0, 1)\n	return SPOT.EdgeShare + (1 - SPOT.EdgeShare) * share\nend\n\n-- Whether this observer can see that point at all.\n--\n-- Distance first because it is arithmetic and the raycast is not. At the top tier the\n-- police half of this runs six times per player per tick and the crowd half runs once per\n-- person on the street, and the overwhelming majority of both are answered by the cheap\n-- half before a ray is ever cast.\n--\n-- `height` is how far off the floor the look happens: an officer looks from head height\n-- because they are a body, and the crowd check passes 0 because it was written that way\n-- and a pedestrian's eyeline is not worth a second raycast profile. `ignore` is the\n-- caller's, because who is allowed to block a view genuinely differs -- an officer must\n-- not be blinded by the officer standing in front of them.\nfunction Spotting.CanSee(\n	from: Vector3,\n	to: Vector3,\n	sightStuds: number,\n	height: number,\n	ignore: { Instance }\n): boolean\n	if sightStuds <= 0 then\n		return false\n	end\n	if Ground.FlatDistance(from, to) > sightStuds then\n		return false\n	end\n	return Ground.Reachable(from, to, height, ignore)\nend\n\n-- How much notice this observer gains per second, given that they can already see you.\n--\n-- `secondsAtFull` is how long this kind of observer takes to make somebody of exactly\n-- conspicuousness 1 at point-blank range, and it is the one number that differs between a\n-- trained officer and somebody on their way to work. Passing it in rather than branching\n-- on an observer type keeps this arithmetic and keeps the difference between the two in\n-- Config where it can be read.\nfunction Spotting.NoticeRate(\n	distanceStuds: number,\n	sightStuds: number,\n	conspicuousness: number,\n	secondsAtFull: number\n): number\n	if secondsAtFull <= 0 then\n		-- Not a tunable value, a broken one. Treated as instant rather than as a divide\n		-- by zero, because the alternative is an observer who can never notice anybody\n		-- and a system that fails by doing nothing at all.\n		return math.huge\n	end\n	local closeness = Spotting.Closeness(distanceStuds, sightStuds)\n	if closeness <= 0 then\n		return 0\n	end\n	return conspicuousness * closeness / secondsAtFull\nend\n\n-- How fast a character is actually travelling, flat, in studs per second.\n--\n-- Read off the body rather than off Humanoid.WalkSpeed, which is a setting and not a fact:\n-- a player standing still in a shop has whatever run speed the game gave them and is not\n-- moving at all. Flattened because falling is not conspicuous in the way running is, and\n-- without it a player who steps off a kerb reads as briefly sprinting.\nfunction Spotting.SpeedOf(character: Model?): number\n	if character == nil then\n		return 0\n	end\n	local root = character:FindFirstChild(\"HumanoidRootPart\")\n	if root == nil or not root:IsA(\"BasePart\") then\n		return 0\n	end\n	local velocity = root.AssemblyLinearVelocity\n	return Vector3.new(velocity.X, 0, velocity.Z).Magnitude\nend\n\nreturn Spotting\n"
table.insert(AGES_MANIFEST, "src/server/world/Spotting.luau")
AGES_SOURCES["src/server/world/StandDown.luau"] = "--!strict\n-- Taking the map's own buildings out of the world, reversibly.\n--\n-- Several things in this tree lay a building in code on ground the map has already built on:\n-- School replaces the street's school, GymRoom replaces the town's gym. Without this both\n-- exist at once, and the result is not merely ugly -- **it is wrong**. The town gym is the\n-- clear case: `Workspace.Town.Gym` carries real `GymKind` attributes on four machines, so a\n-- second gym laid on top of it means GymService indexes two sets and half the equipment a\n-- player walks up to is inside a wall.\n--\n-- **Hidden, never destroyed.** Everything named here belongs to the map, which is generated\n-- by `tools/` and owned by another agent. Destroy is not reversible inside a session and a\n-- mistake would cost a re-sync; parenting into ServerStorage means a wrong call costs a drag\n-- in Studio instead, and means the decision can be reversed from a debug command while\n-- standing in the room.\n--\n-- **What must never be stood down.** A model that carries attributes is load-bearing for some\n-- other system, and taking it away silently breaks that system rather than tidying the world:\n--\n--   City.RunningTrack   FacilityKind=track\n--   City.SoccerField    FacilityKind=soccer, SportsDrillKind=soccer\n--   City.BoxingGym      FacilityKind=boxing, SportsDrillKind=boxing\n--\n-- Those stay. The one deliberate exception is `Town.Gym`, whose attributes are the very\n-- thing being replaced -- GymRoom lays the same four kinds itself, so standing it down swaps\n-- one complete set of machines for another rather than removing a capability.\n\nlocal ServerStorage = game:GetService(\"ServerStorage\")\n\nlocal StandDown = {}\n\n-- Where stood-down models are kept, one folder per caller so two callers cannot clear each\n-- other's work.\nlocal holds: { [string]: Folder } = {}\n\nlocal function holdFor(key: string): Folder\n	local existing = holds[key]\n	if existing ~= nil and existing.Parent ~= nil then\n		return existing\n	end\n	local made = Instance.new(\"Folder\")\n	made.Name = `StoodDown_{key}`\n	made.Parent = ServerStorage\n	holds[key] = made\n	return made\nend\n\nexport type Target = {\n	-- The Workspace child the model lives under: \"Street\", \"City\", \"Town\".\n	parent: string,\n	-- The model's own name.\n	model: string,\n}\n\n-- Stands a list of models down. Returns how many actually moved, so a caller can tell \"there\n-- was nothing there\" from \"it worked\" -- the two look identical from the outside and only one\n-- of them is worth reporting.\n--\n-- Safe to call repeatedly: a model already stood down is simply not found in Workspace again.\nfunction StandDown.Hide(key: string, targets: { Target }): number\n	local moved = 0\n	for _, target in targets do\n		local parent = workspace:FindFirstChild(target.parent)\n		if parent ~= nil then\n			local model = parent:FindFirstChild(target.model)\n			if model ~= nil then\n				-- The original parent is recorded on the model itself rather than in a table\n				-- here, so Restore still works if this module is reloaded underneath it.\n				model:SetAttribute(\"StoodDownFrom\", target.parent)\n				model.Parent = holdFor(key)\n				moved += 1\n			end\n		end\n	end\n	return moved\nend\n\n-- Puts everything a key stood down back where it came from.\nfunction StandDown.Restore(key: string): number\n	local hold = holds[key]\n	if hold == nil or hold.Parent == nil then\n		return 0\n	end\n	local put = 0\n	for _, model in hold:GetChildren() do\n		local from = model:GetAttribute(\"StoodDownFrom\")\n		local parent = if typeof(from) == \"string\" then workspace:FindFirstChild(from) else nil\n		if parent ~= nil then\n			model:SetAttribute(\"StoodDownFrom\", nil)\n			model.Parent = parent\n			put += 1\n		end\n	end\n	hold:Destroy()\n	holds[key] = nil\n	return put\nend\n\n-- Whether anything is currently stood down under a key.\nfunction StandDown.IsHidden(key: string): boolean\n	local hold = holds[key]\n	return hold ~= nil and hold.Parent ~= nil and #hold:GetChildren() > 0\nend\n\n-- What a key has stood down, by name, for a debug line that can say which models moved rather\n-- than only how many.\nfunction StandDown.Names(key: string): { string }\n	local names = {}\n	local hold = holds[key]\n	if hold ~= nil and hold.Parent ~= nil then\n		for _, model in hold:GetChildren() do\n			table.insert(names, model.Name)\n		end\n	end\n	table.sort(names)\n	return names\nend\n\nreturn StandDown\n"
table.insert(AGES_MANIFEST, "src/server/world/StandDown.luau")
AGES_SOURCES["src/server/world/Studio.luau"] = "--!strict\n-- The art room, as a room that exists.\n--\n-- Three things in it, and the whole subject is the distance between them: a wall with\n-- the study on it, an easel a little way in front of the wall, and the paint cupboard\n-- directly behind you when you are standing at the easel.\n--\n-- That last word is the layout. In the lab the board and the cupboard face each other so\n-- the two errands cannot be batched into one trip; here there is only one errand, and it\n-- is put behind the player so that fetching paint costs them *sight of the picture*\n-- rather than costing them seconds. A cupboard beside the wall would be a free refill\n-- with a walk animation on it. See Config.School.Art.RoomRadiusStuds for why the room is\n-- half again the size of the lab: the mechanic is distance from the picture, and there is\n-- nothing else to buy it with.\n--\n-- Split from ArtService for the reason Lab is split from ScienceService: where a thing\n-- stands and what happens when you reach it are different questions, and re-laying the\n-- room must never be able to touch the scoring.\n--\n-- Built once, shared, and never taken down -- and unlike the lab, what is *written* on\n-- the furniture is shared too. The study on the wall is one picture that everybody in the\n-- room is copying, because a wall can only hold one thing and pretending otherwise would\n-- mean two players standing side by side seeing different paintings on the same parts.\n-- The canvases are per player and pushed; the wall is the room's.\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Config = require(ReplicatedStorage:WaitForChild(\"Config\"))\nlocal Pigments = require(ReplicatedStorage:WaitForChild(\"world\"):WaitForChild(\"Pigments\"))\n\nlocal Studio = {}\n\nlocal ART = Config.School.Art\nlocal BUILD = ART.Build\n\nlocal COLUMNS = ART.Columns\nlocal ROWS = ART.Rows\n\n-- What a built room hands back. Positions for the things the loop measures against, and\n-- the wall's own parts, because the wall is the one piece of furniture whose *appearance*\n-- is state -- a study shifting is a part changing colour, and something has to hold them.\nexport type ArtRoom = {\n	center: Vector3,\n	easel: Vector3,\n	cupboard: Vector3,\n	-- One part per cell, indexed the way a study's cells are: left to right, then top to\n	-- bottom. The same index means the same square on the wall, in the session and on the\n	-- player's canvas, with nothing mapping between them.\n	wall: { BasePart },\n}\n\nlocal room: ArtRoom? = nil\nlocal folder: Folder? = nil\nlocal titleLabel: TextLabel? = nil\n\n-- Everything the art room puts in the world lives in one folder, the same arrangement the\n-- lab makes and separate from it because the two get cleared for different reasons.\nlocal function studioFolder(): Folder\n	local existing = folder\n	if existing ~= nil and existing.Parent ~= nil then\n		return existing\n	end\n	local made = Instance.new(\"Folder\")\n	made.Name = \"ArtRoom\"\n	made.Parent = workspace\n	folder = made\n	return made\nend\n\n-- A point on the room's circle, in the same terms Lab.onCircle uses, so a layout number\n-- here and a layout number there mean the same thing.\nlocal function onCircle(center: Vector3, bearing: number, share: number): Vector3\n	local direction = CFrame.Angles(0, math.rad(bearing), 0) * Vector3.new(0, 0, -1)\n	return center + direction * (ART.RoomRadiusStuds * share)\nend\n\n-- One piece of placeholder furniture, sat on the floor rather than centred in it.\n-- Non-collidable for the reason the lab's is: a player who has to walk around the easel\n-- to reach the cupboard is being charged for the room twice, and it is the distances that\n-- are supposed to cost something rather than the geometry.\nlocal function buildBlock(name: string, at: Vector3, size: Vector3, color: Color3): BasePart\n	local part = Instance.new(\"Part\")\n	part.Name = name\n	part.Size = size\n	part.CFrame = CFrame.new(at + Vector3.new(0, size.Y / 2, 0))\n	part.Anchored = true\n	part.CanCollide = false\n	part.Color = color\n	part.Material = Enum.Material.SmoothPlastic\n	part.TopSurface = Enum.SurfaceType.Smooth\n	part.BottomSurface = Enum.SurfaceType.Smooth\n	part.Parent = studioFolder()\n	return part\nend\n\n-- The name over a piece of furniture, built in the world rather than pushed, because what\n-- a thing *is* is true for everybody standing in the room. Handed back so the wall's own\n-- label can be rewritten when the study changes -- the only one of these that ever moves.\nlocal function buildLabel(part: BasePart, text: string, width: number): TextLabel\n	local sign = Instance.new(\"BillboardGui\")\n	sign.Name = \"Label\"\n	sign.Adornee = part\n	sign.Size = UDim2.new(width, 0, 1.1, 0)\n	sign.StudsOffsetWorldSpace = Vector3.new(0, part.Size.Y / 2 + 1.2, 0)\n	sign.MaxDistance = BUILD.LabelMaxDistanceStuds\n	sign.AlwaysOnTop = true\n	sign.Parent = part\n\n	local label = Instance.new(\"TextLabel\")\n	label.Name = \"Text\"\n	label.Size = UDim2.new(1, 0, 1, 0)\n	label.BackgroundTransparency = 1\n	label.Font = Enum.Font.GothamMedium\n	label.TextScaled = true\n	label.TextColor3 = Color3.fromRGB(248, 246, 240)\n	label.TextStrokeTransparency = 0.4\n	label.Text = text\n	label.Parent = sign\n	return label\nend\n\n-- Builds the room around a centre point, once. Nil means it could not be laid at all,\n-- which the caller turns into Art refusing at the door with a reason rather than into a\n-- lesson that opens onto nothing.\nfunction Studio.Build(center: Vector3): ArtRoom?\n	local existing = room\n	if existing ~= nil then\n		return existing\n	end\n\n	local wallAt = onCircle(center, BUILD.WallBearing, BUILD.WallDistanceShare)\n	local easelAt = onCircle(center, BUILD.EaselBearing, BUILD.EaselDistanceShare)\n	local cupboardAt = onCircle(center, BUILD.CupboardBearing, BUILD.CupboardDistanceShare)\n\n	-- Which way the wall faces, and which way is right along it from the player's side.\n	-- Flattened first: a room laid on a slope would otherwise tilt the whole picture, and\n	-- a study read at an angle is a study read wrong.\n	local flat = Vector3.new(center.X - wallAt.X, 0, center.Z - wallAt.Z)\n	if flat.Magnitude < 1 then\n		-- Only reachable by putting the wall on top of the room's own centre, which means\n		-- the layout shares in Config have been edited into nonsense. Said out loud rather\n		-- than divided by zero.\n		return nil\n	end\n	local faceCenter = flat.Unit\n	-- The direction a player at the easel is looking, and their right hand from there.\n	local look = -faceCenter\n	local right = look:Cross(Vector3.yAxis)\n\n	local step = BUILD.WallCellStuds + BUILD.WallCellGapStuds\n	local width = COLUMNS * step\n	local height = ROWS * step\n\n	-- A dark panel behind the grid, sized a little past it. Not decoration: without it the\n	-- study is a set of squares floating in whatever happens to be behind the room, and\n	-- the first thing the player has to do is work out where the picture ends.\n	local backing = Instance.new(\"Part\")\n	backing.Name = \"StudyBacking\"\n	backing.Size = Vector3.new(width + step * 0.5, height + step * 0.5, BUILD.WallDepthStuds)\n	backing.CFrame = CFrame.lookAt(\n		wallAt + Vector3.new(0, BUILD.WallLiftStuds + height / 2, 0) - faceCenter * BUILD.WallDepthStuds,\n		wallAt + Vector3.new(0, BUILD.WallLiftStuds + height / 2, 0) + faceCenter\n	)\n	backing.Anchored = true\n	backing.CanCollide = false\n	backing.Color = Color3.fromRGB(28, 28, 32)\n	backing.Material = Enum.Material.SmoothPlastic\n	backing.Parent = studioFolder()\n\n	titleLabel = buildLabel(backing, \"Study\", 8)\n\n	local wall: { BasePart } = {}\n	for rowIndex = 1, ROWS do\n		for columnIndex = 1, COLUMNS do\n			-- Centred on the wall point: the middle of the grid sits on the bearing, so a\n			-- study of any width is laid symmetrically about the same spot and widening the\n			-- picture does not slide it off to one side.\n			local across = (columnIndex - (COLUMNS + 1) / 2) * step\n			local up = ((ROWS + 1) / 2 - rowIndex) * step\n			local at = wallAt + right * across + Vector3.new(0, BUILD.WallLiftStuds + height / 2 + up, 0)\n\n			local cell = Instance.new(\"Part\")\n			cell.Name = `Cell_{(rowIndex - 1) * COLUMNS + columnIndex}`\n			cell.Size = Vector3.new(BUILD.WallCellStuds, BUILD.WallCellStuds, BUILD.WallDepthStuds)\n			cell.CFrame = CFrame.lookAt(at, at + faceCenter)\n			cell.Anchored = true\n			cell.CanCollide = false\n			-- Flat and unlit rather than plastic, because the one thing the player is doing\n			-- all lesson is judging a colour, and a study that shades differently on its\n			-- left than its right would be asking them to judge the room's lighting instead.\n			cell.Material = Enum.Material.Neon\n			cell.Color = Color3.fromRGB(28, 28, 32)\n			cell.Parent = studioFolder()\n\n			wall[(rowIndex - 1) * COLUMNS + columnIndex] = cell\n		end\n	end\n\n	local easelPart = buildBlock(\"Easel\", easelAt, BUILD.EaselSize, Color3.fromRGB(140, 112, 78))\n	buildLabel(easelPart, \"Easel\", 5)\n\n	local cupboardPart = buildBlock(\"PaintCupboard\", cupboardAt, BUILD.CupboardSize, Color3.fromRGB(150, 128, 96))\n	buildLabel(cupboardPart, \"Paint\", 5)\n\n	local built: ArtRoom = {\n		center = center,\n		easel = easelAt,\n		cupboard = cupboardAt,\n		wall = wall,\n	}\n	room = built\n	return built\nend\n\n-- The room, or nil if nothing has built it yet. Never builds as a side effect: the caller\n-- that owns the place point is the one that decides the art room exists.\nfunction Studio.Room(): ArtRoom?\n	return room\nend\n\n-- Puts a whole study up. Called when the wall is free and somebody starts a lesson.\nfunction Studio.Show(title: string, cells: { Pigments.Pigment })\n	local built = room\n	if built == nil then\n		return\n	end\n	local label = titleLabel\n	if label ~= nil then\n		label.Text = title\n	end\n	for index, part in built.wall do\n		local pigment = cells[index]\n		if pigment ~= nil then\n			part.Color = pigment.color\n		end\n	end\nend\n\n-- Changes one square. This is a study shifting, and it is deliberately the whole of what\n-- that looks like from the world's side: a part changes colour and nothing announces it.\n-- A sound or a flash here would tell every player in the room exactly which cell to go and\n-- look at, which is the one thing this subject is about finding out for yourself.\nfunction Studio.SetCell(index: number, pigment: Pigments.Pigment)\n	local built = room\n	if built == nil then\n		return\n	end\n	local part = built.wall[index]\n	if part == nil then\n		return\n	end\n	part.Color = pigment.color\nend\n\n-- Blanks the wall back to its unlit state, for when the last painter leaves. A study left\n-- hanging would be the next lesson's picture already half-solved for anybody who walked\n-- past the room -- and, more simply, an empty art room should look like one.\nfunction Studio.Clear()\n	local built = room\n	if built == nil then\n		return\n	end\n	local label = titleLabel\n	if label ~= nil then\n		label.Text = \"Study\"\n	end\n	for _, part in built.wall do\n		part.Color = Color3.fromRGB(28, 28, 32)\n	end\nend\n\nreturn Studio\n"
table.insert(AGES_MANIFEST, "src/server/world/Studio.luau")
AGES_SOURCES["src/server/world/SubjectModels.luau"] = "--!strict\n-- What a subject looks like when it is standing in the room, and which of its\n-- parts can be moved. SceneService decides where the subject goes and when it\n-- leaves, SubjectMotion decides how it carries itself while it is there, and this\n-- decides what turns up and what there is to animate.\n--\n-- Same split, and for the same reason, as EnactService/Interact and\n-- DeliveryService/DeliveryPresenters: retuning how close the animal comes never\n-- touches its geometry, retuning its gait never touches its proportions, and\n-- replacing all of it with a bought model never touches the placement math.\n--\n-- Two sources, in the order they are tried:\n--\n--   A real Model, named after the subject id, inside the ServerStorage folder\n--   Config.World.SubjectFolder names. This is the seam for a Toolbox dog: drop\n--   it in, name it \"dog\", and nothing in code moves.\n--\n--   Otherwise a placeholder built from parts out of the subject's own\n--   dimensions. Not a cube with a label on it -- a legible four-legged animal of\n--   the right size, for the reason NPCService builds visitors from body scales\n--   rather than waiting on asset ids. A subject that is the correct height and\n--   arrives at the correct moment is already most of the event; the fur is the\n--   part that can wait.\n--\n-- What comes back is a rig rather than a Model, which is the whole difference\n-- between this version and the one before it. A Model can only be slid around; a\n-- rig names the pieces -- four legs by corner, a head, a tail -- so the thing can\n-- walk. The two sources answer that question differently and deliberately: the\n-- placeholder hands over its own parts to be posed, and an adopted model hands\n-- over its Animator and whatever clips it shipped with, because somebody else's\n-- geometry is not ours to take apart and guess at.\n--\n-- Anchoring is load-bearing and is the one rule that differs between the two.\n-- Nothing here may be knocked over, shoved through a wall or dropped through a\n-- floor, and nothing here is ever pushed, so a static model is anchored outright.\n-- A model that brought animations cannot be: an animation drives limbs through\n-- Motor6Ds, and an anchored limb ignores its motor. Those get their root anchored\n-- and their limbs left to the motors, which pins the animal in place just as hard\n-- while leaving it able to move.\n--\n-- Non-collidable throughout, and invisible to raycasts and region queries. Both\n-- matter: an enacted event fans its choices across the floor and the subject must\n-- never be the thing standing between the player and one of them, and a subject\n-- that answered probes would be reported as furniture by Ground -- including by\n-- the probes that run for the *next* event while this one is still standing there.\n\nlocal ServerStorage = game:GetService(\"ServerStorage\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Config = require(ReplicatedStorage:WaitForChild(\"Config\"))\nlocal Types = require(ReplicatedStorage:WaitForChild(\"Types\"))\n\ntype SceneSubject = Types.SceneSubject\n\nlocal SubjectModels = {}\n\n-- One group of parts that moves as a piece about a single point: a leg about its\n-- hip, the head about the neck, the tail about its base.\n--\n-- Rest poses are stored relative to that pivot, captured once at build time.\n-- Nothing ever reads a part's live CFrame afterwards, which is what stops a pose\n-- from accumulating error -- every frame is computed from the rest pose rather\n-- than from the frame before it, so a hundred thousand frames of tail wag leave\n-- the tail exactly where it started.\nexport type Segment = {\n	parts: { BasePart },\n	-- Parallel to `parts`: rest[i] is where parts[i] sits relative to `pivot`.\n	rest: { CFrame },\n	-- In the model's own frame, which has the feet at y = 0 and faces -Z.\n	pivot: CFrame,\n}\n\n-- Named rather than indexed, because a gait is written in terms of which leg --\n-- a trot moves the diagonal pairs together -- and `legs[2]` in that sentence\n-- would be a comment waiting to go stale. Left and right are the animal's own:\n-- it faces -Z, so its left is +X.\nexport type Legs = {\n	frontLeft: Segment,\n	frontRight: Segment,\n	rearLeft: Segment,\n	rearRight: Segment,\n}\n\nexport type Limbs = {\n	-- The torso. Carries the head and the tail, so a bob applied here moves all\n	-- three and only the legs stay on the ground.\n	body: Segment,\n	-- Head, snout, nose, ears and eyes together: they are one rigid thing and\n	-- there is nothing to be gained from being able to waggle an ear on its own.\n	head: Segment,\n	tail: Segment,\n	legs: Legs,\n	-- A biped's arms, hanging from the shoulders. Nil for a quadruped, which\n	-- has no equivalent part to pose. The gait reads this to decide whether\n	-- to swing arms opposite the legs.\n	arms: { left: Segment, right: Segment }?,\n}\n\nexport type SubjectRig = {\n	model: Model,\n	subject: SceneSubject,\n	-- How far the model's pivot sits above the floor it is standing on. Zero for\n	-- anything with a root put in deliberately; nonzero only for an animated model\n	-- whose own root part we had to keep, which is usually somewhere around the\n	-- hips. Callers add it when placing, so a rigged dog's feet land on the floor\n	-- in the same call that lands the placeholder's.\n	groundOffset: number,\n	-- Length of a leg, which is the one geometric fact a gait needs and cannot\n	-- work out for itself. Reported rather than recomputed so the stride matches\n	-- the animal that was actually built.\n	legHeight: number,\n	-- The placeholder's own parts, posable frame by frame. Nil for a model\n	-- somebody else built: we know where its feet are and nothing else.\n	limbs: Limbs?,\n	-- An adopted model's animation driver and whatever clips it shipped with,\n	-- keyed by Animation name. Nil and empty for the placeholder.\n	animator: Animator?,\n	clips: { [string]: Animation },\n}\n\n-- Cosmetic proportions, kept out of Config for the reason ChoiceMarkers gives:\n-- the fraction of a dog that is leg is not a number anyone balances the game\n-- with, and putting it in Config makes it compete for attention with the numbers\n-- that are. The numbers that *are* authored -- how tall, how long, how fast --\n-- live on the subject in content and arrive as arguments.\n--\n-- All of these are fractions of the subject's own dimensions, so a cat is a cat\n-- and not a shrunken dog.\nlocal LEG_FRACTION = 0.5 -- of shoulder height; the rest is torso, so the back lands exactly on it\nlocal TORSO_LENGTH_FRACTION = 0.62 -- of body length; the remainder is head at one end and tail at the other\nlocal LEG_THICKNESS_FRACTION = 0.28 -- of body width\nlocal LEG_INSET_FRACTION = 0.18 -- of body width, in from each side and end\nlocal PAW_LENGTH_FRACTION = 1.4 -- of leg thickness; a foot is longer than the leg above it\nlocal PAW_HEIGHT_FRACTION = 0.45 -- of leg thickness\nlocal HEAD_FRACTION = 0.95 -- of body width, cubed\nlocal HEAD_DROP_FRACTION = 0.08 -- of shoulder height, below the line of the back\nlocal SNOUT_FRACTION = 0.5 -- of head size\nlocal NOSE_FRACTION = 0.34 -- of snout size\nlocal EAR_FRACTION = 0.32 -- of head size\nlocal EYE_FRACTION = 0.17 -- of head size\nlocal TAIL_FRACTION = 0.3 -- of body length\nlocal TAIL_THICKNESS_FRACTION = 0.2 -- of body width\nlocal TAIL_TIP_FRACTION = 0.28 -- of tail length\n\n-- Biped proportions. A human is not a dog stood on end: two legs, two arms and a\n-- head that sits upright on top of a torso rather than poking out of its front.\nlocal BIPED_LEG_SPREAD_FRACTION = 0.25 -- of body width, half the shoulder span\nlocal ARM_FRACTION = 0.42 -- of shoulder height; wrist to shoulder\nlocal ARM_THICKNESS_FRACTION = 0.16 -- of body width\n-- The nod angle is deliberately *not* here. It sat here as a second `BIPED_NOD_DEGREES = 22`,\n-- identical to the live one in `SubjectMotion` and read by nobody -- this module builds the\n-- rig, that one moves it, and an angle is motion. Two copies of one number in two modules is\n-- the shape a silent drift starts in: nobody edits both, and the copy nobody edits is the one\n-- that looks authoritative to whoever reads this file next.\n\n-- How far the tail is carried above the line of the back at rest. A tail held\n-- level reads as a plank and one held down reads as a cowed animal; a little up\n-- is the neutral, interested carriage the prompt describes.\nlocal TAIL_LIFT_DEGREES = 18\n-- Ears tipped out and back rather than standing straight up, which reads alert\n-- without reading startled.\nlocal EAR_OUT_DEGREES = 16\nlocal EAR_BACK_DEGREES = 10\n\n-- The root is a marker, not a body part: it exists so that the model's pivot sits\n-- between the animal's feet, which is what lets a caller place it with a single\n-- PivotTo onto a point the floor probe returned.\nlocal ROOT_SIZE = Vector3.new(0.2, 0.2, 0.2)\n\nlocal function newPart(model: Model, name: string, size: Vector3, at: CFrame, color: Color3): Part\n	local part = Instance.new(\"Part\")\n	part.Name = name\n	part.Size = size\n	part.CFrame = at\n	part.Color = color\n	part.Material = Enum.Material.SmoothPlastic\n	part.Anchored = true\n	part.CanCollide = false\n	-- Invisible to raycasts and region queries, which is what keeps a subject from\n	-- being reported as furniture by the floor and clearance probes in Ground --\n	-- including the ones that would run for the *next* event while this one is\n	-- still standing there.\n	part.CanQuery = false\n	part.CanTouch = false\n	part.Parent = model\n	return part\nend\n\n-- Everything is built at the origin in the model's own frame, so a part's CFrame\n-- at this moment *is* its rest pose and there is nothing to measure.\nlocal function segmentOf(pivot: CFrame, parts: { BasePart }): Segment\n	local inverse = pivot:Inverse()\n	local rest: { CFrame } = {}\n	for index, part in parts do\n		rest[index] = inverse * part.CFrame\n	end\n	return { parts = parts, rest = rest, pivot = pivot }\nend\n\n-- A leg and the foot on the end of it, pivoting about the hip. Not about the\n-- middle, which scissors the foot through the floor, and not about the foot,\n-- which lifts the whole animal off it.\nlocal function buildLeg(\n	model: Model,\n	name: string,\n	hipX: number,\n	hipZ: number,\n	legHeight: number,\n	thickness: number,\n	subject: SceneSubject\n): Segment\n	local leg = newPart(\n		model,\n		name,\n		Vector3.new(thickness, legHeight, thickness),\n		CFrame.new(hipX, legHeight / 2, hipZ),\n		subject.color\n	)\n\n	local pawHeight = thickness * PAW_HEIGHT_FRACTION\n	local pawLength = thickness * PAW_LENGTH_FRACTION\n	local paw = newPart(\n		model,\n		`{name}Paw`,\n		Vector3.new(thickness * 1.1, pawHeight, pawLength),\n		-- Set forward of the leg it hangs off, because a foot sticks out in front\n		-- of the ankle and one centered under the leg reads as a stilt.\n		CFrame.new(hipX, pawHeight / 2, hipZ - (pawLength - thickness) / 2),\n		subject.accentColor\n	)\n\n	return segmentOf(CFrame.new(hipX, legHeight, hipZ), { leg, paw })\nend\n\n-- A single invisible part satisfying the Segment type, used for the parts a\n-- biped does not need but the gait still references.\nlocal function invisibleSegment(model: Model, name: string, at: CFrame): Segment\n	local part = newPart(model, name, Vector3.new(0.01, 0.01, 0.01), at, Color3.new(1, 1, 1))\n	part.Transparency = 1\n	part.CastShadow = false\n	return segmentOf(at, { part })\nend\n\n-- A four-legged animal, facing -Z, with its feet at y = 0 and the top of its back\n-- at exactly shoulderHeight. Built at the origin and moved afterwards, so the\n-- arithmetic below is all in the subject's own frame.\nlocal function buildPlaceholder(subject: SceneSubject): (Model, Limbs, number)\n	local model = Instance.new(\"Model\")\n\n	local height = subject.shoulderHeight\n	local length = subject.bodyLength\n	local width = subject.bodyWidth\n\n	local legHeight = height * LEG_FRACTION\n	local torsoHeight = height - legHeight\n	local torsoLength = length * TORSO_LENGTH_FRACTION\n	local torsoCenterY = legHeight + torsoHeight / 2\n\n	local torso = newPart(\n		model,\n		\"Torso\",\n		Vector3.new(width, torsoHeight, torsoLength),\n		CFrame.new(0, torsoCenterY, 0),\n		subject.color\n	)\n	local body = segmentOf(CFrame.new(0, torsoCenterY, 0), { torso })\n\n	local legThickness = width * LEG_THICKNESS_FRACTION\n	local legInset = width * LEG_INSET_FRACTION\n	local legX = width / 2 - legInset\n	local legZ = torsoLength / 2 - legInset\n	-- Facing -Z with +Y up makes the animal's own left +X, so front-left is\n	-- (+X, -Z). Getting this backwards would put the trot on the wrong diagonal,\n	-- which looks subtly wrong in a way that is very hard to find later.\n	local legs: Legs = {\n		frontLeft = buildLeg(model, \"LegFrontLeft\", legX, -legZ, legHeight, legThickness, subject),\n		frontRight = buildLeg(model, \"LegFrontRight\", -legX, -legZ, legHeight, legThickness, subject),\n		rearLeft = buildLeg(model, \"LegRearLeft\", legX, legZ, legHeight, legThickness, subject),\n		rearRight = buildLeg(model, \"LegRearRight\", -legX, legZ, legHeight, legThickness, subject),\n	}\n\n	-- Held at the front and a little below the line of the back, which is where a\n	-- dog carries its head when it has noticed you and has not decided about you\n	-- yet. Level would read as a statue and raised would read as a howl.\n	--\n	-- The head's back face lands exactly on the torso's front face, so there is no\n	-- neck to build and no gap to hide.\n	local headSize = width * HEAD_FRACTION\n	local headY = height - height * HEAD_DROP_FRACTION\n	local headZ = -(torsoLength / 2 + headSize / 2)\n	local neck = CFrame.new(0, headY, -torsoLength / 2)\n\n	local headParts: { BasePart } = {}\n	table.insert(\n		headParts,\n		newPart(model, \"Head\", Vector3.new(headSize, headSize, headSize), CFrame.new(0, headY, headZ), subject.color)\n	)\n\n	local snoutSize = headSize * SNOUT_FRACTION\n	local snoutY = headY - headSize * 0.2\n	local snoutZ = headZ - headSize / 2 - snoutSize / 2\n	table.insert(\n		headParts,\n		newPart(\n			model,\n			\"Snout\",\n			Vector3.new(snoutSize, snoutSize, snoutSize),\n			CFrame.new(0, snoutY, snoutZ),\n			subject.accentColor\n		)\n	)\n\n	-- A ball rather than a box, and worth the one extra part: the nose is the only\n	-- round thing on the animal and it is what stops the face reading as a crate.\n	local noseSize = snoutSize * NOSE_FRACTION\n	local nose = newPart(\n		model,\n		\"Nose\",\n		Vector3.new(noseSize, noseSize, noseSize),\n		CFrame.new(0, snoutY + snoutSize * 0.1, snoutZ - snoutSize / 2),\n		subject.accentColor\n	)\n	nose.Shape = Enum.PartType.Ball\n	table.insert(headParts, nose)\n\n	local earSize = headSize * EAR_FRACTION\n	for _, side in { -1, 1 } do\n		table.insert(\n			headParts,\n			newPart(\n				model,\n				\"Ear\",\n				Vector3.new(earSize * 0.35, earSize, earSize * 0.7),\n				-- Both signs are easy to get backwards and both are checkable. About X,\n				-- the top of an upright part moves to z = +sin(theta), so a positive\n				-- angle tips it back. About Z it moves to x = -sin(theta), so the angle\n				-- that tips it *out* is the negation of the side it is on.\n				CFrame.new(side * headSize * 0.32, headY + headSize / 2 + earSize * 0.4, headZ + headSize * 0.1)\n					* CFrame.Angles(math.rad(EAR_BACK_DEGREES), 0, math.rad(-side * EAR_OUT_DEGREES)),\n				subject.accentColor\n			)\n		)\n	end\n\n	-- Two dark spheres. Out of all proportion to their cost: they are the\n	-- difference between a shape facing you and something looking at you, which is\n	-- the entire claim the prompt makes.\n	local eyeSize = headSize * EYE_FRACTION\n	for _, side in { -1, 1 } do\n		local eye = newPart(\n			model,\n			\"Eye\",\n			Vector3.new(eyeSize, eyeSize, eyeSize),\n			-- Set into the face rather than onto it, so the sphere reads as an eye\n			-- in a socket instead of a bead glued to a box.\n			CFrame.new(side * headSize * 0.3, headY + headSize * 0.14, headZ - headSize / 2 + eyeSize * 0.25),\n			subject.accentColor\n		)\n		eye.Shape = Enum.PartType.Ball\n		table.insert(headParts, eye)\n	end\n\n	local head = segmentOf(neck, headParts)\n\n	local tailLength = length * TAIL_FRACTION\n	local tailThickness = width * TAIL_THICKNESS_FRACTION\n	local tailBase = CFrame.new(0, height - tailThickness, torsoLength / 2)\n	-- Negative pitch about X lifts the far end: rotating (0, 0, +L) about X by\n	-- theta gives y = -sin(theta) * L, so the tail rises only when theta is below\n	-- zero. Easy to get backwards and immediately obvious when it is.\n	local tailPose = tailBase * CFrame.Angles(math.rad(-TAIL_LIFT_DEGREES), 0, 0)\n	local tailParts: { BasePart } = {\n		newPart(\n			model,\n			\"Tail\",\n			Vector3.new(tailThickness, tailThickness, tailLength),\n			tailPose * CFrame.new(0, 0, tailLength / 2),\n			subject.color\n		),\n	}\n	local tipLength = tailLength * TAIL_TIP_FRACTION\n	table.insert(\n		tailParts,\n		newPart(\n			model,\n			\"TailTip\",\n			Vector3.new(tailThickness * 1.05, tailThickness * 1.05, tipLength),\n			tailPose * CFrame.new(0, 0, tailLength - tipLength / 2),\n			subject.accentColor\n		)\n	)\n	local tail = segmentOf(tailBase, tailParts)\n\n	local root = newPart(model, \"SubjectRoot\", ROOT_SIZE, CFrame.new(0, 0, 0), subject.color)\n	root.Transparency = 1\n	root.CastShadow = false\n	model.PrimaryPart = root\n\n	local limbs: Limbs = { body = body, head = head, tail = tail, legs = legs }\n	return model, limbs, legHeight\nend\n\n-- A two-legged human figure, facing -Z, feet at y = 0 and the top of the\n-- shoulders at shoulderHeight. Built for the teacher: two legs, a torso, a head\n-- with eyes and two arms. The rear legs and tail are built invisible so the\n-- four-corner rig shape holds and the gait can skip them cleanly.\nlocal function buildBipedPlaceholder(subject: SceneSubject): (Model, Limbs, number)\n	local model = Instance.new(\"Model\")\n\n	local height = subject.shoulderHeight\n	local length = subject.bodyLength\n	local width = subject.bodyWidth\n\n	local legHeight = height * LEG_FRACTION\n	local torsoHeight = height - legHeight\n	local torsoCenterY = legHeight + torsoHeight / 2\n\n	local torso = newPart(\n		model,\n		\"Torso\",\n		Vector3.new(width, torsoHeight, length),\n		CFrame.new(0, torsoCenterY, 0),\n		subject.color\n	)\n	local body = segmentOf(CFrame.new(0, torsoCenterY, 0), { torso })\n\n	local legThickness = width * LEG_THICKNESS_FRACTION\n	local legX = width / 2 - width * BIPED_LEG_SPREAD_FRACTION\n	local legZ = 0\n	local legs: Legs = {\n		frontLeft = buildLeg(model, \"LegFrontLeft\", legX, legZ, legHeight, legThickness, subject),\n		frontRight = buildLeg(model, \"LegFrontRight\", -legX, legZ, legHeight, legThickness, subject),\n		rearLeft = invisibleSegment(model, \"LegRearLeft\", CFrame.new(legX, legHeight / 2, legZ)),\n		rearRight = invisibleSegment(model, \"LegRearRight\", CFrame.new(-legX, legHeight / 2, legZ)),\n	}\n\n	-- Head sits on top of the shoulders, facing -Z. Box and eyes only: a\n	-- teacher's face is the last place to be wrong, so the shape is kept to\n	-- the parts that read unambiguously as human.\n	local headSize = width * HEAD_FRACTION\n	local headY = height + headSize / 2 - headSize * 0.18\n	local headZ = -length / 2 + headSize * 0.1\n	local neck = CFrame.new(0, height - headSize * 0.05, headZ)\n	local headParts: { BasePart } = {\n		newPart(model, \"Head\", Vector3.new(headSize, headSize, headSize), CFrame.new(0, headY, headZ), subject.color),\n	}\n	local eyeSize = headSize * EYE_FRACTION\n	for _, side in { -1, 1 } do\n		local eye = newPart(\n			model,\n			\"Eye\",\n			Vector3.new(eyeSize, eyeSize, eyeSize),\n			CFrame.new(side * headSize * 0.28, headY + headSize * 0.05, headZ - headSize / 2 + eyeSize * 0.3),\n			subject.accentColor\n		)\n		eye.Shape = Enum.PartType.Ball\n		table.insert(headParts, eye)\n	end\n	local head = segmentOf(neck, headParts)\n\n	-- Arms hang from the shoulders, pivoting at the shoulder joint. They swing\n	-- opposite the legs during a walk, which is what sells the gait as a person\n	-- rather than a puppet whose limbs forgot they were attached.\n	local armThickness = width * ARM_THICKNESS_FRACTION\n	local armLength = height * ARM_FRACTION\n	local armX = width / 2 + armThickness * 0.4\n	local armY = height - armLength / 2\n	local function buildArm(name: string, side: number): Segment\n		local at = CFrame.new(side * armX, armY, 0)\n		return segmentOf(at, {\n			newPart(model, name, Vector3.new(armThickness, armLength, armThickness), at, subject.accentColor),\n		})\n	end\n	local arms: { left: Segment, right: Segment } = {\n		left = buildArm(\"ArmLeft\", 1),\n		right = buildArm(\"ArmRight\", -1),\n	}\n\n	-- Tail: absent for a person. Built invisible so the rig shape holds.\n	local tail = invisibleSegment(model, \"Tail\", CFrame.new(0, height - 0.2, length / 2))\n\n	local root = newPart(model, \"SubjectRoot\", ROOT_SIZE, CFrame.new(0, 0, 0), subject.color)\n	root.Transparency = 1\n	root.CastShadow = false\n	model.PrimaryPart = root\n\n	local limbs: Limbs = { body = body, head = head, tail = tail, legs = legs, arms = arms }\n	return model, limbs, legHeight\nend\n\n-- Whatever will actually play an AnimationTrack on this model, creating the\n-- Animator if the model brought a Humanoid or an AnimationController without one\n-- -- which is common, because an Animator is normally added at runtime by the\n-- engine and a model sitting in ServerStorage has never run.\nlocal function findAnimator(model: Model): Animator?\n	local host: Instance? = model:FindFirstChildWhichIsA(\"Humanoid\", true)\n	if host == nil then\n		host = model:FindFirstChildWhichIsA(\"AnimationController\", true)\n	end\n	if host == nil then\n		return nil\n	end\n\n	local existing = host:FindFirstChildWhichIsA(\"Animator\")\n	if existing ~= nil then\n		return existing :: Animator\n	end\n	local animator = Instance.new(\"Animator\")\n	animator.Parent = host\n	return animator\nend\n\n-- Every Animation anywhere in the model, keyed by its name. Deliberately not\n-- looked for in a folder with a fixed name: the contract is \"call an Animation\n-- Walk and it plays while walking\", which is one thing to remember rather than\n-- two, and it survives whatever folder structure the model arrived with.\nlocal function collectClips(model: Model): { [string]: Animation }\n	local clips: { [string]: Animation } = {}\n	for _, descendant in model:GetDescendants() do\n		if descendant:IsA(\"Animation\") then\n			clips[descendant.Name] = descendant\n		end\n	end\n	return clips\nend\n\n-- The part an animated model is driven from. Its own PrimaryPart if it set one,\n-- otherwise the conventional name, otherwise the largest part -- which is a guess\n-- but a good one, since the piece a rig hangs off is rarely the smallest.\nlocal function driverPart(model: Model): BasePart?\n	if model.PrimaryPart ~= nil then\n		return model.PrimaryPart\n	end\n	local named = model:FindFirstChild(\"HumanoidRootPart\")\n	if named ~= nil and named:IsA(\"BasePart\") then\n		return named\n	end\n\n	local best: BasePart? = nil\n	local bestVolume = 0\n	for _, descendant in model:GetDescendants() do\n		if descendant:IsA(\"BasePart\") then\n			local size = descendant.Size\n			local volume = size.X * size.Y * size.Z\n			if volume > bestVolume then\n				best = descendant\n				bestVolume = volume\n			end\n		end\n	end\n	return best\nend\n\n-- A hand-made model has its own idea of where its origin is, and it is usually\n-- not between the animal's feet. Rather than asking whoever drops one in to get\n-- that right, the bottom of its bounding box is measured and the difference is\n-- reported as groundOffset -- so a Toolbox dog places identically to the\n-- placeholder and the caller never learns which one it got.\nlocal function adoptModel(source: Model, subject: SceneSubject): SubjectRig?\n	local model = source:Clone()\n\n	local ok, boxCFrame, boxSize = pcall(function()\n		return model:GetBoundingBox()\n	end)\n	if not ok or boxCFrame == nil or boxSize == nil then\n		warn(`[AGES] subject model \"{source.Name}\" has no parts to measure; using the placeholder instead`)\n		model:Destroy()\n		return nil\n	end\n\n	local animator = findAnimator(model)\n	local clips = collectClips(model)\n	-- Animated only if it can *both* drive a clip and has one to drive. Either one\n	-- alone is a model that will stand still, and standing still is exactly what\n	-- the anchored path does better.\n	local animated = animator ~= nil and next(clips) ~= nil\n	local driver = if animated then driverPart(model) else nil\n	if animated and driver == nil then\n		warn(`[AGES] subject model \"{source.Name}\" has animations but no part to drive them from; anchoring it instead`)\n		animated = false\n	end\n\n	for _, descendant in model:GetDescendants() do\n		if descendant:IsA(\"BasePart\") then\n			-- An animated limb must stay unanchored or its motor cannot move it. It\n			-- does not fall: a Motor6D chain hanging off an anchored root is one rigid\n			-- assembly as far as the physics engine is concerned.\n			descendant.Anchored = not animated or descendant == driver\n			descendant.CanCollide = false\n			descendant.CanQuery = false\n			descendant.CanTouch = false\n		end\n	end\n\n	local bottom = boxCFrame.Position.Y - boxSize.Y / 2\n\n	if animated and driver ~= nil then\n		model.PrimaryPart = driver\n		return {\n			model = model,\n			subject = subject,\n			groundOffset = driver.Position.Y - bottom,\n			-- Only used to size a stride, which an animated model does not need\n			-- because its clip already has one. Reported honestly all the same.\n			legHeight = subject.shoulderHeight * LEG_FRACTION,\n			limbs = nil,\n			animator = animator,\n			clips = clips,\n		}\n	end\n\n	local root = Instance.new(\"Part\")\n	root.Name = \"SubjectRoot\"\n	root.Size = ROOT_SIZE\n	root.CFrame = CFrame.new(Vector3.new(boxCFrame.Position.X, bottom, boxCFrame.Position.Z))\n	root.Transparency = 1\n	root.Anchored = true\n	root.CanCollide = false\n	root.CanQuery = false\n	root.CanTouch = false\n	root.CastShadow = false\n	root.Parent = model\n	model.PrimaryPart = root\n\n	return {\n		model = model,\n		subject = subject,\n		groundOffset = 0,\n		legHeight = subject.shoulderHeight * LEG_FRACTION,\n		limbs = nil,\n		animator = nil,\n		clips = {},\n	}\nend\n\nlocal function authoredModel(subjectId: string): Model?\n	local folder = ServerStorage:FindFirstChild(Config.World.SubjectFolder)\n	if folder == nil then\n		return nil\n	end\n	local found = folder:FindFirstChild(subjectId)\n	if found == nil then\n		return nil\n	end\n	if not found:IsA(\"Model\") then\n		warn(`[AGES] \"{subjectId}\" in {Config.World.SubjectFolder} is a {found.ClassName}, not a Model; using the placeholder`)\n		return nil\n	end\n	return found\nend\n\n-- Builds the subject, unparented and unplaced. Its pivot sits between its feet\n-- once groundOffset is added and it faces -Z, so the caller places it with one\n-- PivotTo onto a point the floor probe returned.\nfunction SubjectModels.Build(subject: SceneSubject): SubjectRig\n	local authored = authoredModel(subject.id)\n	if authored ~= nil then\n		local adopted = adoptModel(authored, subject)\n		if adopted ~= nil then\n			adopted.model.Name = `Subject_{subject.id}`\n			return adopted\n		end\n	end\n\n	local model, limbs, legHeight = if subject.biped then buildBipedPlaceholder(subject) else buildPlaceholder(subject)\n	model.Name = `Subject_{subject.id}`\n	return {\n		model = model,\n		subject = subject,\n		groundOffset = 0,\n		legHeight = legHeight,\n		limbs = limbs,\n		animator = nil,\n		clips = {},\n	}\nend\n\nreturn SubjectModels\n"
table.insert(AGES_MANIFEST, "src/server/world/SubjectModels.luau")
AGES_SOURCES["src/server/world/SubjectMotion.luau"] = "--!strict\n-- How a subject carries itself. SubjectModels decides what turns up and names its\n-- pieces; this moves them.\n--\n-- It exists because a dog that slides is worse than no dog. An animal translating\n-- across a floor with its legs locked does not read as an animal at all -- it\n-- reads as furniture being pushed, and every other thing the scene gets right\n-- (the size, the timing, the fact that it looks at you) is spent arguing with\n-- that one wrong signal. The gait below is not decoration; it is the difference\n-- between something arriving and something being moved.\n--\n-- Two implementations behind one interface, chosen by what the rig turned out to\n-- be:\n--\n--   A placeholder hands over its own parts, so the gait is computed here. Keyed\n--   to *distance travelled* rather than to time, which is the one decision that\n--   makes or breaks it: legs driven by a clock skate whenever the speed changes,\n--   and legs driven by distance plant wherever the animal actually is.\n--\n--   An adopted model hands over an Animator and whatever clips it shipped with,\n--   so the gait is whatever its author made and this only decides which clip is\n--   playing. Somebody else's rig is not ours to take apart and guess at.\n--\n-- Nothing here reads a part's live CFrame. Every frame is computed from the rest\n-- pose the rig captured at build time, so a pose can never accumulate error --\n-- an hour of tail wag leaves the tail exactly where it started.\n\nlocal SubjectModels = require(script.Parent.SubjectModels)\n\ntype SubjectRig = SubjectModels.SubjectRig\ntype Segment = SubjectModels.Segment\ntype Limbs = SubjectModels.Limbs\n\nlocal SubjectMotion = {}\n\nlocal TAU = math.pi * 2\n\n-- What the scene knows about this instant. Everything below is derived from it,\n-- so a scene never has to think about legs and this never has to think about\n-- rooms.\nexport type Pose = {\n	-- Where the feet are and which way the animal faces. Ground level, not hip\n	-- level: the rig's own groundOffset is added here, not by the caller.\n	root: CFrame,\n	-- Total ground distance covered since the scene began. Drives the gait, which\n	-- is why the feet cannot skate: they are a function of distance, not of time.\n	traveled: number,\n	-- Seconds since the scene began. Drives everything that happens while the\n	-- animal is standing still, where there is no distance to key off.\n	elapsed: number,\n	moving: boolean,\n	-- How much turn is still to make, signed radians, and only meaningful while\n	-- standing. The head leads the body through a turn, which is what an animal\n	-- does and what makes a turn read as a decision rather than as a rotation.\n	turning: number,\n	-- Whether the animal is lying down. A flag rather than a duration because the\n	-- easing belongs here: the scene knows it wants a settled animal and this knows\n	-- how long an animal takes to get down, which is the same division of labour the\n	-- gait already uses.\n	settled: boolean,\n}\n\nexport type Motion = {\n	apply: (Pose) -> (),\n	-- Called before the model is destroyed. The model itself is the caller's.\n	stop: () -> (),\n}\n\n-- Which clip plays when. The whole contract with a dropped-in model: name an\n-- Animation \"Walk\" and it plays while walking. Two required names, no folder, no\n-- Config entry -- because the thing most likely to go wrong with a bought model is\n-- that whoever dropped it in did not read far enough.\nlocal WALK_CLIP = \"Walk\"\nlocal IDLE_CLIP = \"Idle\"\n-- Optional third. A model without one settles by playing its idle, which looks\n-- like an animal that decided not to lie down rather than like a broken scene --\n-- so this stays a bonus rather than joining the two names above in the contract.\nlocal REST_CLIP = \"Rest\"\nlocal CLIP_FADE = 0.2\n\n-- Gait shape. Cosmetic, and therefore local rather than Config, on exactly the\n-- rule SubjectModels and ChoiceMarkers follow: nobody balances this game by\n-- adjusting how far a tail swings, and putting it in Config would make it compete\n-- for attention with the numbers people genuinely tune.\n--\n-- Everything that scales is a fraction of the animal's own dimensions, so a cat\n-- trots like a cat rather than like a dog played at speed.\n\n-- Steps per second for an animal whose legs are one stud long. Everything else\n-- scales off it by the square root of leg length, because a leg is a pendulum and\n-- a pendulum's frequency goes as one over the root of its length -- which is why\n-- a terrier's legs blur and a wolfhound's do not, and why this is a law rather\n-- than a taste.\n--\n-- Cadence rather than stride length is the number chosen here, and that ordering\n-- matters. Sizing a stride off the geometry and letting the cadence fall out gives\n-- the dog five steps a second at its authored walkSpeed and the cat eight, which\n-- is not a trot, it is a blur. Sizing the cadence and letting the stride fall out\n-- gives 2.8 and 4.5, which is a dog and a cat.\n--\n-- The cost is honest and is paid in the other direction: legs this short cannot\n-- sweep as much ground as the animal covers, so a planted foot drifts forward by\n-- roughly a fifth of the distance the body travels over it. Reducible only by\n-- swinging the legs further, which is why LEG_SWING_DEGREES is at the top of the\n-- plausible range rather than the middle. A model that arrives with its own walk\n-- clip has whatever its author decided and none of this applies to it.\nlocal CADENCE_AT_UNIT_LEG = 3.2\n-- Floor under the derived stride, so a subject authored at walkSpeed zero cannot\n-- divide the phase by nothing.\nlocal MIN_STRIDE = 0.4\n-- Floor under the leg length the cadence is derived from, for the same reason in\n-- the other direction: a subject authored with no legs would take the root of zero\n-- and step infinitely fast.\nlocal MIN_LEG_LENGTH = 0.1\n\nlocal LEG_SWING_DEGREES = 36\n-- How far a leg picks up while it is swinging forward, as a fraction of its own\n-- length. A rigid leg pivoting about the hip drags its foot along the floor for\n-- the whole cycle, which is the thing that makes cheap quadrupeds look like\n-- windscreen wipers. Lifting only on the forward half is a knee's worth of\n-- correctness for one addition: the foot clears the ground going forward and is\n-- planted going back, which is what a stride *is*.\nlocal LEG_LIFT_FRACTION = 0.1\n-- Seconds to fade the gait in and out. Without it a dog that stops walking snaps\n-- its legs to attention mid-stride, which is the single most obvious tell that\n-- something is being animated by a formula.\nlocal GAIT_EASE_SECONDS = 0.22\n\n-- Vertical bob of the body over a stride, as a fraction of shoulder height. Runs\n-- at twice the leg frequency: a trot lifts the body as each diagonal pair passes\n-- under it. Small on purpose -- the legs are doing the work and a body that\n-- bounces reads as a cartoon.\nlocal BODY_BOB_FRACTION = 0.022\n-- Nod of the head over the same stride.\nlocal HEAD_NOD_DEGREES = 4\n-- Sway of the tail across a stride. Larger than the nod because a tail is the one\n-- part of an animal that is allowed to be theatrical.\nlocal TAIL_WALK_SWAY_DEGREES = 16\n\n-- Breathing while standing: rise and fall of the body, as a fraction of shoulder\n-- height, over this many seconds. Below the threshold of being noticed and well\n-- above the threshold of being missed.\nlocal BREATH_FRACTION = 0.012\nlocal BREATH_SECONDS = 3.1\n\n-- A slow drift of the head while standing, so a waiting animal is not a statue.\n-- Deliberately not in time with the breathing: two idle motions on the same\n-- period read as one mechanism.\nlocal IDLE_HEAD_DEGREES = 3\nlocal IDLE_HEAD_SECONDS = 5.3\n\n-- An occasional flick of the tail while standing. The gap is randomized between\n-- these bounds, which is the entire point -- anything on a metronome reads as a\n-- machine, and this is the cheapest possible signal that the thing is alive.\nlocal FLICK_DEGREES = 24\nlocal FLICK_SECONDS = 0.75\nlocal FLICK_GAP_MIN = 2.2\nlocal FLICK_GAP_MAX = 6.5\n\n-- How much of the body's remaining turn the head takes first, and the most it may\n-- lead by. Capped because an unbounded lead lets the head swing right around when\n-- the animal is asked to turn and face behind it.\nlocal HEAD_LEAD = 0.5\nlocal HEAD_LEAD_MAX_DEGREES = 32\n\n-- Lying down. How far the hips drop, as a fraction of leg length -- and that\n-- fraction is the only number chosen here, because the splay below is not a\n-- choice: a rigid leg pivoting at the hip keeps its foot at a fixed radius, so\n-- once the hip has dropped there is exactly one angle that leaves the foot on the\n-- floor, and it is the arccosine of what is left. Picking the angle by eye instead\n-- is how a lying animal ends up with its feet through the floorboards, which is\n-- the same class of mistake as legs that skate.\n--\n-- Half. Enough to read as lying rather than crouching, and it is also the value\n-- that brings the derived splay out at exactly sixty degrees -- worth having,\n-- because a round splay is the quickest way to check by eye that the derivation is\n-- still doing what it claims. Not further: a rigid leg has no knee, so past about\n-- two thirds the splay gets wide enough that the animal looks like it has been\n-- dropped rather than settled.\nlocal SETTLE_DROP_FRACTION = 0.5\n-- Seconds to get down and to get back up. Longer than the gait ease because\n-- lying down is a decision and standing up is an effort, and neither is something\n-- an animal does in a quarter of a second.\nlocal SETTLE_SECONDS = 0.9\n-- Biped-only: how far the arms swing, as a fraction of the leg swing. Gentler\n-- than the legs -- arms that swing as far as the legs read as a march.\nlocal ARM_SWING_FRACTION = 0.5\n-- How far the head pitches forward for a right-answer nod. The settle flag drives\n-- this the same way it drives the quadruped's lie-down: ease in, hold, ease out.\nlocal BIPED_NOD_DEGREES = 22\n-- How far the head comes down with the rest of it. Less than the body, so the\n-- animal is still looking at you from the floor rather than asleep face-first.\nlocal SETTLE_HEAD_DROP_DEGREES = 12\n-- How much of the tail's motion is left once it is down. Not zero: a still tail\n-- reads as an animal that has been switched off, and the whole reason the flick\n-- exists is that this is the cheapest signal of being alive.\nlocal SETTLE_TAIL_MOTION = 0.4\n-- How much deeper it breathes lying down. The only motion left at that point, so\n-- it is the one carrying the whole signal and is worth making visible.\nlocal SETTLE_BREATH_SCALE = 1.8\n\n-- Published because SceneService has to wait it out. An animal that is asked to\n-- get up and starts walking in the same frame slides across the floor on its\n-- side, which is precisely the failure this whole file exists to prevent -- so\n-- the number lives here, next to what it describes, and the scene reads it.\nSubjectMotion.SettleSeconds = SETTLE_SECONDS\n\n-- The one primitive: put a segment where its pivot says, transformed about that\n-- pivot, with every part back at its rest pose relative to it.\nlocal function poseSegment(segment: Segment, base: CFrame, transform: CFrame)\n	local at = base * segment.pivot * transform\n	for index, part in segment.parts do\n		part.CFrame = at * segment.rest[index]\n	end\nend\n\n-- One leg at one point in the cycle. `phase` is where this leg is in its own\n-- stride, so the two diagonal pairs are the same call half a cycle apart.\n--\n-- The angle is a plain sine: furthest forward at a quarter turn, furthest back at\n-- three quarters. The lift is the derivative's sign -- cosine is positive exactly\n-- while the leg is travelling forward -- so the foot is up through the swing and\n-- down through the stance, and the two need no state to stay in agreement.\n--\n-- `bias` is a standing offset the stride swings around, which is how a settled\n-- animal folds its front legs forward and its rear legs back without any of the\n-- above needing to know it is lying down. Positive is forward: the model faces -Z,\n-- and a positive rotation about X carries a leg hanging on -Y round toward -Z.\nlocal function poseLeg(segment: Segment, base: CFrame, phase: number, swing: number, lift: number, bias: number)\n	local angle = bias + swing * math.sin(phase)\n	local raise = lift * math.max(0, math.cos(phase))\n	poseSegment(segment, base, CFrame.new(0, raise, 0) * CFrame.Angles(angle, 0, 0))\nend\n\n-- The placeholder path: a trot computed from distance, and a set of small idle\n-- motions for when there is no distance to compute from.\nlocal function posedMotion(rig: SubjectRig, limbs: Limbs): Motion\n	local model = rig.model\n	-- Cadence first, stride second. The animal's pace is already fixed by its\n	-- authored walkSpeed, so once we have decided how often it puts a foot down the\n	-- stride is not a choice -- it is whatever length of step covers that pace at\n	-- that rate. Deriving it in this order is what keeps the feet under the body.\n	local cadence = CADENCE_AT_UNIT_LEG / math.sqrt(math.max(rig.legHeight, MIN_LEG_LENGTH))\n	local stride = math.max(rig.subject.walkSpeed / cadence, MIN_STRIDE)\n	local bobHeight = rig.subject.shoulderHeight * BODY_BOB_FRACTION\n	local breathHeight = rig.subject.shoulderHeight * BREATH_FRACTION\n\n	local swingLimit = math.rad(LEG_SWING_DEGREES)\n	local legLift = rig.legHeight * LEG_LIFT_FRACTION\n	local settleDrop = rig.legHeight * SETTLE_DROP_FRACTION\n	-- Derived, not chosen: the foot sits one leg-length from the hip whatever the\n	-- hip does, so this is the only angle that keeps it on the floor once the hip\n	-- has dropped by settleDrop. Clamped because the fraction is authored above and\n	-- a value past 1 would hand acos an argument it has no answer for.\n	local settleSplay = math.acos(math.clamp(1 - SETTLE_DROP_FRACTION, -1, 1))\n	local settleHeadDrop = math.rad(SETTLE_HEAD_DROP_DEGREES)\n	local nodLimit = math.rad(HEAD_NOD_DEGREES)\n	local swayLimit = math.rad(TAIL_WALK_SWAY_DEGREES)\n	local idleHeadLimit = math.rad(IDLE_HEAD_DEGREES)\n	local flickLimit = math.rad(FLICK_DEGREES)\n	local leadLimit = math.rad(HEAD_LEAD_MAX_DEGREES)\n\n	local biped = rig.subject.biped == true\n\n	local random = Random.new()\n	-- How much of the walk cycle is currently showing, 0 to 1. Eased rather than\n	-- switched, which is what stops the legs snapping when the animal arrives.\n	local gait = 0\n	-- How far down it is, 0 to 1, eased on exactly the same terms and for exactly\n	-- the same reason: an animal that snaps to the floor has not lain down, it has\n	-- been teleported into a different shape.\n	local settle = 0\n	-- A flag rather than an optional last-time, because the last time is written\n	-- from inside apply() and a nil-check on a value a closure assigns to is not\n	-- something the typechecker is willing to narrow.\n	local started = false\n	local lastElapsed = 0\n	local nextFlickAt = random:NextNumber(FLICK_GAP_MIN, FLICK_GAP_MAX)\n	local flickStartedAt = -math.huge\n\n	local function apply(pose: Pose)\n		-- Derived rather than passed, so a caller cannot get the two out of step. A\n		-- first frame has no previous one and therefore no elapsed time, which is\n		-- correct: nothing should have eased anywhere yet.\n		local delta = if started then math.max(0, pose.elapsed - lastElapsed) else 0\n		started = true\n		lastElapsed = pose.elapsed\n\n		local wanted = if pose.moving then 1 else 0\n		local step = if GAIT_EASE_SECONDS > 0 then delta / GAIT_EASE_SECONDS else 1\n		gait += math.clamp(wanted - gait, -step, step)\n\n		local wantedSettle = if pose.settled then 1 else 0\n		local settleStep = if SETTLE_SECONDS > 0 then delta / SETTLE_SECONDS else 1\n		settle += math.clamp(wantedSettle - settle, -settleStep, settleStep)\n\n		local phase = pose.traveled / stride * TAU\n\n		-- Moves everything that is not posed below -- which is only the invisible\n		-- root, but that root is what GetPivot reads, so the model would otherwise\n		-- report that it had never left the spot it spawned on.\n		model:PivotTo(pose.root)\n\n		-- Two beats per stride while walking, easing into a slow breath as it stops,\n		-- and into a deeper one as it goes down. Breathing is the only motion left on\n		-- a settled animal, so it is carrying the whole \"this is alive\" signal by\n		-- itself and is worth a little more amplitude to do it with. Biped never\n		-- settles down -- the settle flag means \"nod\" for a teacher, not \"lie down\".\n		local drop = if biped then 0 else settleDrop * settle\n		local walkBob = bobHeight * (0.5 - 0.5 * math.cos(phase * 2))\n		local breathScale = 1 + (SETTLE_BREATH_SCALE - 1) * settle\n		local breath = breathHeight * breathScale * (0.5 - 0.5 * math.cos(pose.elapsed / BREATH_SECONDS * TAU))\n		local body = pose.root * CFrame.new(0, walkBob * gait + breath * (1 - gait) - drop, 0)\n		poseSegment(limbs.body, body, CFrame.identity)\n\n		-- A trot: the diagonal pairs swing together and the two pairs oppose. Legs\n		-- ride the ground rather than the body, so the bob above never lifts a foot\n		-- off the floor -- only the swing does, and only on the half of the cycle\n		-- where a foot is meant to be off it.\n		--\n		-- The settle is the one exception, and has to be: the hips really do come\n		-- down, so the legs are hung off a base that drops with them and splayed by\n		-- exactly enough to leave the feet where they were. Front legs fold forward\n		-- and rear legs back, which is the shape of a dog on a floor.\n		local hips = if drop > 0 then pose.root * CFrame.new(0, -drop, 0) else pose.root\n		local splay = if biped then 0 else settleSplay * settle\n		local swing = swingLimit * gait\n		local lift = legLift * gait\n		poseLeg(limbs.legs.frontLeft, hips, phase, swing, lift, splay)\n		poseLeg(limbs.legs.frontRight, hips, phase + math.pi, swing, lift, splay)\n		if not biped then\n			poseLeg(limbs.legs.rearRight, hips, phase, swing, lift, -splay)\n			poseLeg(limbs.legs.rearLeft, hips, phase + math.pi, swing, lift, -splay)\n		end\n\n		-- Biped arms swing opposite their ipsilateral leg. Gentler than the legs:\n		-- arms that match the leg amplitude read as a march.\n		if biped and limbs.arms ~= nil then\n			local armSwing = swing * ARM_SWING_FRACTION\n			poseSegment(limbs.arms.left, body, CFrame.Angles(armSwing * math.sin(phase + math.pi), 0, 0))\n			poseSegment(limbs.arms.right, body, CFrame.Angles(armSwing * math.sin(phase), 0, 0))\n		end\n\n		local nod = nodLimit * gait * math.sin(phase * 2 + math.pi)\n		local drift = idleHeadLimit * (1 - gait) * math.sin(pose.elapsed / IDLE_HEAD_SECONDS * TAU)\n		local lead = math.clamp(pose.turning * HEAD_LEAD, -leadLimit, leadLimit) * (1 - gait)\n		-- Subtracted, because the head reaches along -Z from the neck and a positive\n		-- rotation about X lifts the snout. For a biped the settle is a nod (pitch\n		-- forward), not a lie-down, so the angle is larger and keeps the face toward\n		-- the player rather than toward the floor.\n		local headSettle = if biped\n			then math.rad(BIPED_NOD_DEGREES) * settle\n			else settleHeadDrop * settle\n		poseSegment(limbs.head, body, CFrame.Angles(nod - headSettle, drift + lead, 0))\n\n		-- Tail: invisible on bipeds, fully posed on quadrupeds. Flicks are only\n		-- scheduled while standing, so an animal that walks in without stopping\n		-- never banks a flick to spend the moment it arrives.\n		if not biped then\n			if not pose.moving then\n				if pose.elapsed >= nextFlickAt then\n					flickStartedAt = pose.elapsed\n					nextFlickAt = pose.elapsed + random:NextNumber(FLICK_GAP_MIN, FLICK_GAP_MAX)\n				end\n			else\n				nextFlickAt = pose.elapsed + random:NextNumber(FLICK_GAP_MIN, FLICK_GAP_MAX)\n			end\n\n			local flick = 0\n			local sinceFlick = pose.elapsed - flickStartedAt\n			if sinceFlick >= 0 and sinceFlick < FLICK_SECONDS then\n				-- A couple of beats, dying away. A flick that ends abruptly looks like a\n				-- dropped frame rather than like a tail coming to rest.\n				local progress = sinceFlick / FLICK_SECONDS\n				flick = flickLimit * math.sin(progress * TAU * 2) * (1 - progress)\n			end\n\n			-- Damped rather than stopped as it goes down. A tail that stops dead reads as\n			-- an animal that has been switched off, which is the opposite of what lying\n			-- down is meant to say.\n			local stillness = 1 - (1 - SETTLE_TAIL_MOTION) * settle\n			local sway = (swayLimit * gait * math.sin(phase) + flick * (1 - gait)) * stillness\n			poseSegment(limbs.tail, body, CFrame.Angles(0, sway, 0))\n		end\n	end\n\n	return {\n		apply = apply,\n		-- Nothing is playing and nothing is connected: every frame is written by\n		-- the caller's own loop, so there is nothing here to unwind. Present because\n		-- the caller must not have to know which of the two motions it got.\n		stop = function() end,\n	}\nend\n\n-- The adopted-model path: place it, and pick the clip.\nlocal function clipMotion(rig: SubjectRig): Motion\n	local model = rig.model\n	local animator = rig.animator\n	-- The rig's own root is somewhere around the hips rather than between the\n	-- feet, so a pose that puts feet on the floor has to be lifted to reach it.\n	local lift = CFrame.new(0, rig.groundOffset, 0)\n\n	local function load(name: string): AnimationTrack?\n		local clip = rig.clips[name]\n		if animator == nil or clip == nil then\n			return nil\n		end\n		-- Rebound as non-optional before the pcall rather than relied on through the\n		-- check above: the pcall body is a closure, and a nil-check refinement does\n		-- not survive being captured by one.\n		local host: Animator = animator\n		local wanted: Animation = clip\n		local ok, track = pcall(function()\n			return host:LoadAnimation(wanted)\n		end)\n		if not ok or track == nil then\n			warn(`[AGES] subject model \"{model.Name}\" could not load its \"{name}\" animation`)\n			return nil\n		end\n		track.Looped = true\n		return track\n	end\n\n	local walk = load(WALK_CLIP)\n	local idle = load(IDLE_CLIP)\n	local rest = load(REST_CLIP)\n	local playing: AnimationTrack? = nil\n\n	local function play(track: AnimationTrack?)\n		if track == playing then\n			return\n		end\n		if playing ~= nil then\n			playing:Stop(CLIP_FADE)\n		end\n		playing = track\n		if track ~= nil then\n			track:Play(CLIP_FADE)\n		end\n	end\n\n	return {\n		apply = function(pose: Pose)\n			model:PivotTo(pose.root * lift)\n			-- Falls back to whichever clip exists. A model that shipped one animation\n			-- should play it rather than stand frozen because the other name is\n			-- missing -- the alternative is a silent nothing that looks like a bug in\n			-- this file.\n			--\n			-- Moving wins over settled, which only matters for the frames either side\n			-- of getting up: a walk that started while the rest clip was still fading\n			-- would have the animal travelling on its side.\n			if pose.moving then\n				play(walk or idle)\n			elseif pose.settled then\n				play(rest or idle or walk)\n			else\n				play(idle or walk)\n			end\n		end,\n		stop = function()\n			play(nil)\n		end,\n	}\nend\n\n-- Binds a motion to a rig. Which of the two implementations comes back is not\n-- something any caller may ask, and nothing in the interface differs between\n-- them: a scene walks an animal in the same way whether the legs are being posed\n-- here or by a clip somebody uploaded.\nfunction SubjectMotion.Attach(rig: SubjectRig): Motion\n	local limbs = rig.limbs\n	if limbs ~= nil then\n		return posedMotion(rig, limbs)\n	end\n	return clipMotion(rig)\nend\n\nreturn SubjectMotion\n"
table.insert(AGES_MANIFEST, "src/server/world/SubjectMotion.luau")
AGES_SOURCES["src/server/world/Till.luau"] = "--!strict\n-- The drawer, the camera over it, and the spot the clerk stands on.\n--\n-- Split from TheftService for the reason Lab is split from ScienceService and Studio\n-- from ArtService: where a thing stands and what happens when you reach it are different\n-- questions, and re-laying a shop must never be able to touch what a robbery is worth.\n--\n-- Everything here is stood up relative to a place point rather than bolted onto the\n-- shop's own furniture, and that is not laziness -- it is the only way this survives the\n-- town being rebuilt. The generated city already puts a `Counter` box in every storefront\n-- and a `Teller` in the bank, and hanging the game off those names would mean the day\n-- somebody renames a box in the generator is the day four shops silently stop being\n-- robbable. A place point is the town's own promise about where the counter is; see\n-- PlaceService's first paragraph, which makes exactly this argument about coordinates.\n--\n-- The camera turns. That is worth stating plainly because it is the entire signposting\n-- of the activity: there is no warning on the HUD and there is never going to be one, so\n-- the housing physically sweeps and the lens is lit, and a player who wants to know when\n-- it is safe to hold has to watch the thing on the wall. Signposting is part of the\n-- mechanic here, not decoration on top of it.\n--\n-- Built lazily, one shop at a time, and left standing. Four tills' worth of parts is\n-- nothing, and tearing a shop down when a player walks out would mean rebuilding it -- and\n-- restarting its camera's sweep from zero -- every time somebody changes their mind at the\n-- door, which is precisely when the sweep is being read most carefully.\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Config = require(ReplicatedStorage:WaitForChild(\"Config\"))\nlocal Interact = require(ReplicatedStorage:WaitForChild(\"world\"):WaitForChild(\"Interact\"))\n\nlocal Ground = require(script.Parent.Ground)\n\nlocal Till = {}\n\nlocal THEFT = Config.Crime.Theft\n\n-- Cosmetic dimensions, kept out of Config for the reason ChoiceMarkers gives: nobody\n-- balances this game by changing how tall a till is.\nlocal DRAWER_SIZE = Vector3.new(2.6, 1.6, 1.8)\n-- How far in front of the place point the drawer sits. The point itself is where the\n-- player is put down, so the till goes a short step from it -- close enough that\n-- \"standing at the counter\" and \"in reach of the drawer\" are the same place.\nlocal DRAWER_FORWARD = 2.2\nlocal DRAWER_LIFT = 3.2\n\nlocal CAMERA_SIZE = Vector3.new(1.1, 1.1, 2.2)\nlocal CAMERA_LENS_SIZE = Vector3.new(0.6, 0.6, 0.35)\n-- High and behind the drawer, looking out into the room -- which is where a real one\n-- would be and, more usefully, where the player can see it from the spot they have to\n-- stand on. A camera above the player's own head would be a camera they never look at.\nlocal CAMERA_LIFT = 9\nlocal CAMERA_BACK = 3\n\n-- The lens, off and on. Red is the one colour this game uses for \"you are being seen\"\n-- and it is the same red the heat bar's border and the search ring take, so a player\n-- learns it once.\nlocal LENS_IDLE = Color3.fromRGB(70, 78, 88)\nlocal LENS_LIVE = Color3.fromRGB(226, 78, 74)\n\nlocal DRAWER_COLOR = Color3.fromRGB(150, 128, 92)\nlocal HOUSING_COLOR = Color3.fromRGB(58, 62, 70)\n\n-- How far the housing swings either side of straight ahead, in degrees. Wide enough that\n-- which way it is pointed is legible from the counter, narrow enough that it reads as a\n-- camera on a mount rather than a searchlight.\nlocal SWEEP_DEGREES = 70\n\n-- One built shop.\nexport type Fitting = {\n	place: string,\n	-- Where the drawer is, for the reach check. The part's position rather than the\n	-- part, because reach is arithmetic and nothing outside this file should be holding\n	-- a handle on a piece of shop furniture.\n	drawer: Vector3,\n	-- Where the clerk stands, facing the drawer. Nil when there was nowhere standable to\n	-- put one, which is a real outcome in a shop packed with generated fittings -- the\n	-- caller degrades to a camera-only shop rather than refusing the robbery, because a\n	-- door that cannot be robbed for reasons invisible from outside it is the worst\n	-- version of this.\n	clerkSpot: Vector3?,\n	clerkFacing: Vector3,\n	-- Where a gang's lookout stands, watching the door rather than the drawer. Nil for the\n	-- same reason `clerkSpot` can be: some shops have nowhere standable near the entrance\n	-- either, and a robbery that refused itself over that would be worse than one crew role\n	-- quietly unavailable there.\n	lookoutSpot: Vector3?,\n	lookoutFacing: Vector3,\n	drawerPart: BasePart,\n	housing: BasePart,\n	-- Where the housing sits and which way \"straight ahead\" is for it. Held rather than\n	-- read back off the part, because the part's rotation *is* the sweep -- reading the\n	-- swing off a thing that has already been swung would compound the angle every tick\n	-- and spin the camera like a top.\n	housingBase: CFrame,\n	lens: BasePart,\n	dots: Interact.InteractHandle?,\n}\n\nlocal fittings: { [string]: Fitting } = {}\nlocal folder: Folder? = nil\n\nlocal function tillFolder(): Folder\n	local existing = folder\n	if existing ~= nil and existing.Parent ~= nil then\n		return existing\n	end\n	local made = Instance.new(\"Folder\")\n	made.Name = \"AgesTills\"\n	made.Parent = workspace\n	folder = made\n	return made\nend\n\nlocal function buildBlock(parent: Instance, name: string, at: CFrame, size: Vector3, color: Color3): BasePart\n	local part = Instance.new(\"Part\")\n	part.Name = name\n	part.Size = size\n	part.CFrame = at\n	part.Anchored = true\n	part.CanCollide = false\n	part.Color = color\n	part.Material = Enum.Material.SmoothPlastic\n	part.TopSurface = Enum.SurfaceType.Smooth\n	part.BottomSurface = Enum.SurfaceType.Smooth\n	part.Parent = parent\n	return part\nend\n\n-- The shop, stood up. Nil when the place id is not in the built world at all, which the\n-- caller reports by name -- a till that silently failed to appear is a shop the player\n-- walks into and finds nothing in.\nfunction Till.Build(place: string, at: CFrame, label: string): Fitting?\n	local existing = fittings[place]\n	if existing ~= nil and existing.drawerPart.Parent ~= nil then\n		return existing\n	end\n\n	local parent = tillFolder()\n	local group = Instance.new(\"Folder\")\n	group.Name = place\n	group.Parent = parent\n\n	-- The place point faces into the room, so \"forward\" from it is where a player stands\n	-- and \"back\" is the counter. The drawer therefore goes behind the point and the\n	-- camera further behind and above it.\n	local forward = at.LookVector\n	local flat = Vector3.new(forward.X, 0, forward.Z)\n	if flat.Magnitude < 1e-3 then\n		-- A place point lying flat is a point with no heading to build against. Refused\n		-- rather than guessed at: a drawer built on a coin flip would be a drawer inside\n		-- a wall half the time, and a robbery that fails for reasons nobody can see.\n		group:Destroy()\n		return nil\n	end\n	flat = flat.Unit\n\n	local base = at.Position\n	local drawerAt = base + flat * DRAWER_FORWARD + Vector3.new(0, DRAWER_LIFT, 0)\n	local drawerPart = buildBlock(group, \"Drawer\", CFrame.new(drawerAt, drawerAt + flat), DRAWER_SIZE, DRAWER_COLOR)\n\n	local cameraAt = base - flat * CAMERA_BACK + Vector3.new(0, CAMERA_LIFT, 0)\n	local housing = buildBlock(group, \"Camera\", CFrame.new(cameraAt, cameraAt + flat), CAMERA_SIZE, HOUSING_COLOR)\n	local lensAt = cameraAt + flat * (CAMERA_SIZE.Z / 2)\n	local lens = buildBlock(group, \"Lens\", CFrame.new(lensAt, lensAt + flat), CAMERA_LENS_SIZE, LENS_IDLE)\n	lens.Material = Enum.Material.Neon\n\n	-- Somewhere for a clerk to stand: behind the drawer, off to one side, facing it. Asked\n	-- of Ground rather than assumed, because the shops are generated and what is behind a\n	-- counter differs from one to the next.\n	local ignore = Ground.IgnoreList({ group })\n	local clerkWanted = base - flat * 3.5 + Vector3.new(flat.Z, 0, -flat.X) * 2.5\n	local clerkSpot = Ground.SpotAt(clerkWanted, 2, 5, ignore, drawerAt)\n\n	-- Near the place point itself -- roughly where a customer walking in first stands --\n	-- and off the opposite side from the clerk, so the two never fight over the same patch\n	-- of floor. Still asked to be reachable from the drawer, same guard as the clerk: a\n	-- lookout who could not actually be walked to from the counter would be a body in a\n	-- room the robbery cannot see.\n	local lookoutWanted = base + Vector3.new(-flat.Z, 0, flat.X) * 3\n	local lookoutSpot = Ground.SpotAt(lookoutWanted, 2, 5, ignore, drawerAt)\n\n	local fitting: Fitting = {\n		place = place,\n		drawer = drawerAt,\n		clerkSpot = clerkSpot,\n		clerkFacing = drawerAt,\n		-- Facing back out the way a customer came in, since watching the door is the whole\n		-- point of standing here.\n		lookoutSpot = lookoutSpot,\n		lookoutFacing = base - flat * 20,\n		drawerPart = drawerPart,\n		housing = housing,\n		housingBase = housing.CFrame,\n		lens = lens,\n		dots = nil,\n	}\n\n	-- The invitation. Clicking it only ever puts the player at the till -- the verb is\n	-- held, from the panel that opens -- which is why this is a Till and not a Station;\n	-- see Interact.InteractKind, where the same distinction is made from the other side.\n	fitting.dots = Interact.Attach(drawerPart, {\n		kind = \"Till\",\n		id = place,\n		actionText = \"Open\",\n		objectText = label,\n	})\n\n	fittings[place] = fitting\n	return fitting\nend\n\nfunction Till.Get(place: string): Fitting?\n	local fitting = fittings[place]\n	if fitting == nil or fitting.drawerPart.Parent == nil then\n		return nil\n	end\n	return fitting\nend\n\n-- Points the camera. `share` is where it is through its sweep, 0 to 1, and `onTill` is\n-- whether it is currently looking at the drawer.\n--\n-- Both are handed in rather than worked out here, because the sweep's timing is the\n-- activity and the activity lives in TheftService. This file turns a part.\nfunction Till.AimCamera(place: string, share: number, onTill: boolean)\n	local fitting = Till.Get(place)\n	if fitting == nil then\n		return\n	end\n	-- A triangle rather than a sine, so the camera pauses at the ends of its travel the\n	-- way a real mount does and the player has a moment to read \"it has turned away\"\n	-- rather than a continuous glide they have to guess at.\n	local folded = if share < 0.5 then share * 2 else (1 - share) * 2\n	local swing = (folded - 0.5) * 2 * SWEEP_DEGREES\n	fitting.housing.CFrame = fitting.housingBase * CFrame.Angles(0, math.rad(swing), 0)\n	fitting.lens.CFrame = fitting.housing.CFrame * CFrame.new(0, 0, -(CAMERA_SIZE.Z / 2))\n	fitting.lens.Color = if onTill then LENS_LIVE else LENS_IDLE\nend\n\n-- Whether a position is close enough to have hands in the drawer. Here rather than in\n-- TheftService because it is a question about where the furniture is, and the answer has\n-- to stay true when the shop moves.\nfunction Till.InReach(place: string, from: Vector3): boolean\n	local fitting = Till.Get(place)\n	if fitting == nil then\n		return false\n	end\n	return Ground.FlatDistance(from, fitting.drawer) <= THEFT.ReachStuds\nend\n\nreturn Till\n"
table.insert(AGES_MANIFEST, "src/server/world/Till.luau")
AGES_SOURCES["src/server/world/Vault.luau"] = "--!strict\n-- The vault door at the back of the bank, the alarm panel by the entrance, and the ground\n-- the guard walks between them.\n--\n-- Split from BankService for the reason Till is split from TheftService, Lab from\n-- ScienceService and Wardrobe from DisguiseService: where a thing stands and what happens\n-- when you reach it are different questions, and re-laying a room must never be able to\n-- touch what a robbery is worth.\n--\n-- Stood up relative to a place point and a floor plan handed in from content, never off\n-- the generated room's own furniture. The city generator already puts a box called `Vault`\n-- in here and hanging the game off that name would mean the day somebody renames it is the\n-- day the bank silently stops being robbable. See content/Vaults, which owns the plan and\n-- explains why the numbers in it are the difficulty of this activity.\n--\n-- **Two things in this file are signposting rather than decoration, and both are load\n-- bearing.** The door swings as the vault empties, so a bank that has already been done is\n-- legible from the lobby -- which matters most to the second player through the entrance.\n-- And the lamp on the alarm panel is the only readout that exists inside the room: it is\n-- forty-eight studs from the vault on purpose, which is far enough that a player standing\n-- at the money has to actually look up and across at it. A HUD light would have been read\n-- without turning round, and turning round is the activity.\n--\n-- Built lazily, once, and left standing. One room's worth of parts is nothing, and tearing\n-- it down when the last player leaves would restart the door's pose from closed -- which\n-- would erase the one piece of shared state the room is carrying in the world.\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Config = require(ReplicatedStorage:WaitForChild(\"Config\"))\nlocal Interact = require(ReplicatedStorage:WaitForChild(\"world\"):WaitForChild(\"Interact\"))\n\nlocal Ground = require(script.Parent.Ground)\n\nlocal Vault = {}\n\nlocal BANK = Config.Crime.Bank\n\n-- Cosmetic dimensions, kept out of Config for the reason ChoiceMarkers gives: nobody\n-- balances this game by changing how thick a vault door is.\nlocal DOOR_SIZE = Vector3.new(7, 9, 1.4)\nlocal MOUTH_SIZE = Vector3.new(8.6, 10.2, 0.8)\n-- How far behind the door the dark recess sits, so a door standing open reveals something\n-- rather than revealing the wall behind it.\nlocal MOUTH_BACK = 1.6\nlocal WHEEL_SIZE = Vector3.new(0.5, 3.4, 3.4)\nlocal WHEEL_OUT = 0.9\n-- How far the door swings when the vault is empty, in degrees. Not a full ninety: a door\n-- flat against the wall reads as scenery, and one at three-quarters still reads as a door\n-- somebody opened.\nlocal DOOR_SWING_DEGREES = 74\n-- How many turns the wheel makes across the whole emptying. Enough that it is visibly\n-- moving while the player holds, which is the only feedback the door itself gives.\nlocal WHEEL_TURNS = 2.5\n\nlocal PANEL_SIZE = Vector3.new(2.4, 3.2, 0.6)\nlocal PANEL_LIFT = 4.6\nlocal LAMP_SIZE = Vector3.new(1.5, 1.5, 1.5)\nlocal LAMP_LIFT = 6.8\n\nlocal DOOR_COLOR = Color3.fromRGB(96, 102, 114)\nlocal WHEEL_COLOR = Color3.fromRGB(168, 152, 106)\nlocal MOUTH_COLOR = Color3.fromRGB(16, 17, 21)\nlocal PANEL_COLOR = Color3.fromRGB(58, 62, 70)\n\n-- The lamp, in its three states. Red is the one colour this game uses for \"you are being\n-- seen\" -- the same red as the heat bar's border, the shop camera's lens and the search\n-- ring -- and amber is the one it uses for \"in progress and not yet true\", the same amber\n-- as the hideout mark and the ring's sweep. A player learns both once.\nlocal LAMP_QUIET = Color3.fromRGB(52, 56, 64)\nlocal LAMP_RINGING = Color3.fromRGB(226, 78, 74)\nlocal LAMP_SILENCED = Color3.fromRGB(238, 176, 74)\n\n-- How far the light on the panel throws while the alarm is ringing. Reaches most of the\n-- room without lighting the street outside, because the alarm is a fact about the building\n-- and not an announcement to the town -- see BankService on why nothing here is broadcast.\nlocal GLOW_RANGE = 34\nlocal GLOW_BRIGHTNESS = 3\n-- How long one blink of the lamp takes. Slow enough to read as an alarm bell rather than a\n-- strobe, which matters because this thing is on for most of a minute.\nlocal FLASH_SECONDS = 1.1\n\n-- What the guard needs to stand in, for the standable check. A person's shoulders and a\n-- person's height, which is what every other placement in this tree asks for.\nlocal GUARD_RADIUS = 2\nlocal GUARD_HEIGHT = 5\n\n-- A spot on the floor, in studs from the place point. Declared here rather than imported\n-- from content so that this file requires nothing but Config, Interact and Ground -- it\n-- builds a room out of numbers and does not care who chose them. Structurally identical to\n-- Vaults.Offset, which is what lets the plan be passed straight through.\nexport type Offset = {\n	forward: number,\n	side: number,\n}\n\nexport type Plan = {\n	roomStuds: number,\n	vault: Offset,\n	alarm: Offset,\n	patrol: { Offset },\n}\n\n-- One built bank.\nexport type Room = {\n	place: string,\n	-- Where the entrance is and how far from it still counts as inside. Positions rather\n	-- than parts, because every question asked of this room is arithmetic and nothing\n	-- outside this file should be holding a handle on a piece of bank furniture.\n	door: Vector3,\n	roomStuds: number,\n	vault: Vector3,\n	alarm: Vector3,\n	-- Where the guard walks, in order. Empty when there was nowhere standable to put him,\n	-- which is a real outcome in a generated room -- the caller degrades to a bank with no\n	-- guard rather than refusing the robbery, because a vault that cannot be opened for\n	-- reasons invisible from the lobby is the worst version of this.\n	patrol: { Vector3 },\n\n	doorPart: BasePart,\n	-- The closed door's pose, and the edge it turns about. Held rather than read back off\n	-- the part, because the part's rotation *is* the swing -- reading the angle off a thing\n	-- that has already been swung would compound it and spin the door off its frame. Same\n	-- reason Till holds housingBase.\n	hinge: CFrame,\n	wheel: BasePart,\n	wheelOffset: CFrame,\n	lamp: BasePart,\n	glow: PointLight,\n	dots: Interact.InteractHandle?,\n}\n\nlocal rooms: { [string]: Room } = {}\nlocal folder: Folder? = nil\n\nlocal function vaultFolder(): Folder\n	local existing = folder\n	if existing ~= nil and existing.Parent ~= nil then\n		return existing\n	end\n	local made = Instance.new(\"Folder\")\n	made.Name = \"AgesVaults\"\n	made.Parent = workspace\n	folder = made\n	return made\nend\n\nlocal function buildBlock(parent: Instance, name: string, at: CFrame, size: Vector3, color: Color3): BasePart\n	local part = Instance.new(\"Part\")\n	part.Name = name\n	part.Size = size\n	part.CFrame = at\n	part.Anchored = true\n	-- Out of every ignore list in the game by construction, and the vault door especially.\n	-- It swings, so a queryable one would be a sight-blocker whose position depends on how\n	-- much of the vault the player has already taken -- which is to say the more you had\n	-- stolen the easier it would be to hide from the guard. That is exactly backwards, and\n	-- it is the kind of thing that would have read as the guard being unreliable rather\n	-- than as a door being in the way.\n	part.CanCollide = false\n	part.CanQuery = false\n	part.CanTouch = false\n	part.Color = color\n	part.Material = Enum.Material.SmoothPlastic\n	part.TopSurface = Enum.SurfaceType.Smooth\n	part.BottomSurface = Enum.SurfaceType.Smooth\n	part.Parent = parent\n	return part\nend\n\n-- The bank, stood up. Nil when the place point has no heading to build against, which the\n-- caller reports by name -- a vault that silently failed to appear is a room the player\n-- walks into and finds nothing in.\nfunction Vault.Build(place: string, at: CFrame, label: string, plan: Plan): Room?\n	local existing = rooms[place]\n	if existing ~= nil and existing.doorPart.Parent ~= nil then\n		return existing\n	end\n\n	local forward = at.LookVector\n	local flat = Vector3.new(forward.X, 0, forward.Z)\n	if flat.Magnitude < 1e-3 then\n		-- A place point lying flat is a point with no heading to build against. Refused\n		-- rather than guessed at: a vault built on a coin flip would be a vault inside a\n		-- wall half the time, and a robbery that fails for reasons nobody can see.\n		return nil\n	end\n	flat = flat.Unit\n	-- To the right of somebody standing on the point looking into the room, which is what\n	-- content/Vaults means by a positive `side`.\n	local right = Vector3.new(flat.Z, 0, -flat.X)\n\n	local group = Instance.new(\"Folder\")\n	group.Name = place\n	group.Parent = vaultFolder()\n\n	local base = at.Position\n	local function spotFor(offset: Offset): Vector3\n		return base + flat * offset.forward + right * offset.side\n	end\n\n	-- The vault, at the back. The door faces back into the room -- toward the player who\n	-- has to stand at it -- rather than out along the place point's heading.\n	local vaultAt = spotFor(plan.vault)\n	local doorAt = vaultAt + Vector3.new(0, DOOR_SIZE.Y / 2, 0)\n	local doorPart = buildBlock(group, \"VaultDoor\", CFrame.new(doorAt, doorAt - flat), DOOR_SIZE, DOOR_COLOR)\n\n	local mouthAt = doorAt + flat * MOUTH_BACK\n	buildBlock(group, \"VaultMouth\", CFrame.new(mouthAt, mouthAt - flat), MOUTH_SIZE, MOUTH_COLOR)\n\n	-- The wheel. A cylinder's flat faces are on its X axis, so standing one against a door\n	-- means turning it a quarter turn about Y first -- after which its spin is a roll about\n	-- its own X. Same shape of correction Wardrobe's floor disc needs, and the same note:\n	-- this is the one line here that looks like a mistake and is not.\n	local wheelOffset = CFrame.new(0, 0, -WHEEL_OUT) * CFrame.Angles(0, math.rad(90), 0)\n	local wheel = buildBlock(group, \"VaultWheel\", doorPart.CFrame * wheelOffset, WHEEL_SIZE, WHEEL_COLOR)\n	wheel.Shape = Enum.PartType.Cylinder\n\n	-- The alarm panel, by the entrance.\n	local alarmAt = spotFor(plan.alarm)\n	local panelAt = alarmAt + Vector3.new(0, PANEL_LIFT, 0)\n	buildBlock(group, \"AlarmPanel\", CFrame.new(panelAt, panelAt - flat), PANEL_SIZE, PANEL_COLOR)\n\n	local lampAt = alarmAt + Vector3.new(0, LAMP_LIFT, 0)\n	local lamp = buildBlock(group, \"AlarmLamp\", CFrame.new(lampAt, lampAt - flat), LAMP_SIZE, LAMP_QUIET)\n	lamp.Material = Enum.Material.Neon\n\n	local glow = Instance.new(\"PointLight\")\n	glow.Name = \"AlarmGlow\"\n	glow.Color = LAMP_RINGING\n	glow.Range = GLOW_RANGE\n	glow.Brightness = GLOW_BRIGHTNESS\n	glow.Enabled = false\n	glow.Parent = lamp\n\n	-- Somewhere for the guard to walk. Asked of Ground rather than assumed, because the\n	-- room is generated and what is standable in it differs from one build of the town to\n	-- the next. Spots that do not survive are dropped rather than nudged: a patrol that\n	-- silently moved itself would be a patrol the player learned and then found had changed.\n	local ignore = Ground.IgnoreList({ group })\n	local patrol: { Vector3 } = {}\n	for _, offset in plan.patrol do\n		local standable = Ground.SpotAt(spotFor(offset), GUARD_RADIUS, GUARD_HEIGHT, ignore, base)\n		if standable ~= nil then\n			table.insert(patrol, standable)\n		end\n	end\n	if #patrol < 2 then\n		-- One spot is not a patrol, it is a post. The caller runs the bank on its alarm\n		-- alone, which is easier and is allowed to be.\n		table.clear(patrol)\n	end\n\n	local room: Room = {\n		place = place,\n		door = base,\n		roomStuds = plan.roomStuds,\n		vault = vaultAt,\n		alarm = alarmAt,\n		patrol = patrol,\n		doorPart = doorPart,\n		hinge = doorPart.CFrame * CFrame.new(-DOOR_SIZE.X / 2, 0, 0),\n		wheel = wheel,\n		wheelOffset = wheelOffset,\n		lamp = lamp,\n		glow = glow,\n		dots = nil,\n	}\n\n	-- The invitation, and it is on the vault door alone. The alarm panel deliberately has\n	-- no dots on it: dots are how you enter an activity, and by the time the panel matters\n	-- the player is already inside one. Its control lives on the panel that this click\n	-- opens, which is also the only place it can live -- a second set of dots would mean\n	-- two things in one room competing to be the nearest prompt while somebody runs\n	-- between them.\n	room.dots = Interact.Attach(doorPart, {\n		kind = \"Vault\",\n		id = place,\n		actionText = \"Open\",\n		objectText = label,\n	})\n\n	rooms[place] = room\n	return room\nend\n\nfunction Vault.Get(place: string): Room?\n	local room = rooms[place]\n	if room == nil or room.doorPart.Parent == nil then\n		return nil\n	end\n	return room\nend\n\n-- Whether a position is inside the building at all. What the whole robbery is held by:\n-- walking away from the vault is the activity, walking out of here is the exit.\nfunction Vault.InRoom(place: string, from: Vector3): boolean\n	local room = Vault.Get(place)\n	if room == nil then\n		return false\n	end\n	return Ground.FlatDistance(from, room.door) <= room.roomStuds\nend\n\n-- Whether a position is close enough to have hands on the vault door.\nfunction Vault.AtVault(place: string, from: Vector3): boolean\n	local room = Vault.Get(place)\n	if room == nil then\n		return false\n	end\n	return Ground.FlatDistance(from, room.vault) <= BANK.ReachStuds\nend\n\n-- And on the alarm panel. The same reach as the vault, because it is the same gesture and\n-- two numbers for \"you are close enough to touch this\" would be two things to learn.\nfunction Vault.AtAlarm(place: string, from: Vector3): boolean\n	local room = Vault.Get(place)\n	if room == nil then\n		return false\n	end\n	return Ground.FlatDistance(from, room.alarm) <= BANK.ReachStuds\nend\n\n-- Swings the door and turns the wheel. `emptyShare` is how much of the vault is gone, 0 to 1.\n--\n-- Told what to draw rather than working it out, for the same reason Till.AimCamera and\n-- Wardrobe.Show are: what the money is doing is the activity and the activity lives in\n-- BankService. This file turns a part.\nfunction Vault.ShowDoor(place: string, emptyShare: number)\n	local room = Vault.Get(place)\n	if room == nil then\n		return\n	end\n	local share = math.clamp(emptyShare, 0, 1)\n	room.doorPart.CFrame = room.hinge\n		* CFrame.Angles(0, math.rad(-DOOR_SWING_DEGREES * share), 0)\n		* CFrame.new(DOOR_SIZE.X / 2, 0, 0)\n	room.wheel.CFrame = room.doorPart.CFrame\n		* room.wheelOffset\n		* CFrame.Angles(share * WHEEL_TURNS * math.pi * 2, 0, 0)\nend\n\n-- Paints the lamp. `state` is \"quiet\", \"ringing\" or \"silenced\".\n--\n-- The flash's rate is worked out here rather than handed in, which is the opposite of what\n-- Till.AimCamera does and the difference is worth naming. A shop camera's sweep *is* the\n-- activity -- the player is timing a hold against it -- so it has to come off the same\n-- clock the rules are read from. A bank alarm's blink is not timing anything; it is the\n-- lamp being obviously on. Making it a number the service passed down would have implied a\n-- beat there was something to play against.\n--\n-- Folded rather than a one-way fade, so the lamp is at its brightest twice a cycle and\n-- reads as a beacon rather than as something warming up.\nfunction Vault.ShowAlarm(place: string, state: string)\n	local room = Vault.Get(place)\n	if room == nil then\n		return\n	end\n	if state == \"ringing\" then\n		local pulse = (os.clock() / FLASH_SECONDS) % 1\n		local folded = if pulse < 0.5 then pulse * 2 else (1 - pulse) * 2\n		room.lamp.Color = LAMP_RINGING\n		-- Never fully dark on the off beat. A lamp that blinked out would be a lamp a\n		-- player glancing across the room at the wrong quarter-second reads as silent,\n		-- which is the one lie this readout must not tell.\n		room.lamp.Transparency = 0.45 * (1 - folded)\n		room.glow.Enabled = true\n		room.glow.Brightness = GLOW_BRIGHTNESS * (0.4 + 0.6 * folded)\n		return\n	end\n\n	room.lamp.Transparency = 0\n	room.glow.Enabled = false\n	room.lamp.Color = if state == \"silenced\" then LAMP_SILENCED else LAMP_QUIET\nend\n\nreturn Vault\n"
table.insert(AGES_MANIFEST, "src/server/world/Vault.luau")
AGES_SOURCES["src/server/world/VehicleChassis.luau"] = "--!strict\n-- Builds a car and drives it. Raycast suspension rather than a physical wheel\n-- collider, on purpose: a HingeConstraint wheel is a cylinder that can catch on a\n-- kerb, and this city is built out of kerbs -- MAP_PLAN.md's whole record of the\n-- street grid is nothing but edges a wheel could snag on. A raycast wheel never\n-- touches the road at all. It measures the distance to it, once per corner every\n-- tick -- see Config.Vehicles.TickSeconds -- and pushes back with a spring. There\n-- is nothing for a pavement lip to catch, because there is no wheel there to\n-- catch it.\n--\n-- The suspension is the textbook damped spring, one per corner:\n--\n--   F = k*x - c*v\n--\n-- k is Config.Vehicles.SuspensionStiffness, x is how far the spring is compressed\n-- from its rest length, c is SuspensionDamping, and v is how fast that corner is\n-- already moving along the spring's own axis -- without the second term every\n-- landing bounces forever. Applied through a VectorForce at an Attachment, which\n-- is the one force primitive that does not care what the part underneath it is\n-- built from: swap the placeholder body for a real mesh later and every force in\n-- this file still lands in the same four places.\n--\n-- Steering is not a turned wheel. It is a yaw rate written straight onto the\n-- chassis's own AssemblyAngularVelocity, scaled by how fast the car is already\n-- going -- a stationary car does not spin on the spot, because a stationary real\n-- car cannot either. That is a simplification and it is a deliberate one: a wheel\n-- whose raycast direction turned with the steering would need its own friction\n-- model to feel like anything, and the arcade version -- Jailbreak's version, and\n-- every casual Roblox driving game's version -- reads as correct to a player at\n-- street speed and is a fraction of the code.\n--\n-- **Network ownership is Roblox's own, handed off explicitly.** The moment a\n-- player sits in the VehicleSeat, this file gives them SetNetworkOwner on the\n-- chassis, so the physics they are watching are the physics their own machine is\n-- resolving -- zero-latency, the same as their own character. The moment they get\n-- out, ownership goes back to SetNetworkOwnershipAuto(). Left to Roblox's default\n-- assignment this breaks the moment a passenger seat exists and somebody sits in\n-- it before the driver does -- the passenger keeps ownership and the driver's\n-- input visibly lags -- which is why the explicit handoff is not optional. There\n-- is no passenger seat in this file for exactly that reason: one seat, one owner,\n-- nothing to get backwards.\n--\n-- What still drives every tick is a server Script, not the client. The client\n-- owns the *physics resolution* once they are seated; the *decision* of how much\n-- force that resolves into is read off VehicleSeat.Throttle/.Steer on the server\n-- every tick, which Roblox already replicates driver-to-server as part of what a\n-- VehicleSeat is. That is the whole of why this needs no Server Authority place\n-- migration: a car, unlike a shared ball, only ever has one owner, and Roblox's\n-- ordinary distributed physics already resolves that correctly once told who it\n-- is.\n\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Config = require(ReplicatedStorage:WaitForChild(\"Config\"))\nlocal Types = require(ReplicatedStorage:WaitForChild(\"Types\"))\n\ntype VehicleKind = Types.VehicleKind\n\nlocal VEHICLES = Config.Vehicles\n\nlocal VehicleChassis = {}\n\n-- Cosmetic geometry, kept out of Config for the reason every other placeholder\n-- model in this tree gives: the height of a wheel arch is not a number anyone\n-- balances a life simulator with.\nlocal WHEEL_THICKNESS = 0.9\nlocal CAB_HEIGHT_SHARE = 0.55\nlocal CAB_LENGTH_SHARE = 0.55\nlocal CAB_INSET_STUDS = 0.5\nlocal BODY_MATERIAL = Enum.Material.SmoothPlastic\nlocal WHEEL_COLOR = Color3.fromRGB(24, 24, 26)\nlocal WHEEL_MATERIAL = Enum.Material.Plastic\nlocal GLASS_COLOR = Color3.fromRGB(150, 190, 210)\nlocal GLASS_MATERIAL = Enum.Material.Glass\n\n-- How far in from the chassis's own edges the suspension attachments sit. Not\n-- flush with the corners -- a wheel is not a knife-edge, it has its own width --\n-- and not so far in that a wide, low car loses the roll stability that comes from\n-- spreading its four springs as wide as the body actually is.\nlocal WHEEL_INSET_X = 0.35\nlocal WHEEL_INSET_Z = 0.9\n\n-- How hard the chassis resists sliding sideways. Not a suspension number and not\n-- per-car: every car on the lot should feel like it is on the same road, and\n-- differences in cornering come from steerDegrees and speed, not from one car\n-- mysteriously gripping better in a straight line.\n-- Safe range: 900-1800.\nlocal LATERAL_GRIP = 1300\n\n-- How firmly steering input is allowed to change yaw rate per second. A hard\n-- `AssemblyAngularVelocity` write is instant and correct for the common case;\n-- this is what keeps a steering *reversal* from reading as the car teleporting\n-- its spin the other way in one frame.\nlocal YAW_RESPONSIVENESS = 6\n\n-- What one wheel corner needs to do its job: where it sits, and what it last\n-- measured, so the model can be turned to match what the physics decided.\ntype Corner = {\n	attachment: Attachment,\n	-- Held directly rather than found again each tick with\n	-- FindFirstChildOfClass -- there is exactly one per attachment and it never\n	-- changes, so the lookup would only ever be paying to confirm the same\n	-- answer sixty times a second.\n	force: VectorForce,\n	wheelModel: BasePart,\n	localOffset: Vector3,\n}\n\nexport type Chassis = {\n	model: Model,\n	seat: VehicleSeat,\n	kind: VehicleKind,\n	-- Stops the drive loop and disconnects everything. Safe to call once; a\n	-- second call is a no-op, which matters because both a despawn and the\n	-- model being destroyed out from under the loop reach here.\n	destroy: () -> (),\n}\n\n-- One wheel, as a squat cylinder. A cylinder's own length runs along local X, so\n-- it is rotated ninety degrees to stand it on its side facing outward -- the same\n-- correction ChoiceMarkers makes for the discs it paints on the floor.\nlocal function buildWheel(parent: Instance, radius: number): BasePart\n	local wheel = Instance.new(\"Part\")\n	wheel.Name = \"Wheel\"\n	wheel.Shape = Enum.PartType.Cylinder\n	wheel.Size = Vector3.new(WHEEL_THICKNESS, radius * 2, radius * 2)\n	wheel.Color = WHEEL_COLOR\n	wheel.Material = WHEEL_MATERIAL\n	wheel.Anchored = false\n	wheel.CanCollide = false\n	wheel.CanQuery = false\n	wheel.CanTouch = false\n	wheel.Massless = true\n	wheel.Parent = parent\n	return wheel\nend\n\n-- The body: a block for the chassis, a smaller block set back and up for the\n-- cab, and a glass band between them. Three primitives is the greeble floor\n-- Props.luau and PropModels already hold everywhere else in this game -- a car\n-- that was a single coloured box would read as a crate with wheels.\nlocal function buildBody(kind: VehicleKind, cframe: CFrame): Model\n	local model = Instance.new(\"Model\")\n	model.Name = `Vehicle_{kind.id}`\n\n	local chassis = Instance.new(\"Part\")\n	chassis.Name = \"Chassis\"\n	chassis.Size = kind.size\n	chassis.Color = kind.color\n	chassis.Material = BODY_MATERIAL\n	chassis.CFrame = cframe\n	chassis.Anchored = false\n	chassis.CanCollide = true\n	chassis.CustomPhysicalProperties = PhysicalProperties.new(\n		-- Density chosen so the body sits at a mass the suspension constants in\n		-- Config.Vehicles were tuned against -- roughly 1.4 tonnes for a\n		-- mid-sized car's worth of studs. A real mesh dropped in later inherits\n		-- whatever density it ships with; this only has to be right for the\n		-- placeholder.\n		0.7,\n		0.3,\n		0.5\n	)\n	chassis.Parent = model\n	model.PrimaryPart = chassis\n\n	local cabSize = Vector3.new(\n		kind.size.X - CAB_INSET_STUDS * 2,\n		kind.size.Y * CAB_HEIGHT_SHARE,\n		kind.size.Z * CAB_LENGTH_SHARE\n	)\n	local cab = Instance.new(\"Part\")\n	cab.Name = \"Cab\"\n	cab.Size = cabSize\n	cab.Color = kind.color\n	cab.Material = BODY_MATERIAL\n	-- Set back from centre toward the rear third, which is what makes a boxy\n	-- placeholder read as \"car\" rather than \"van\" from a passing glance -- the\n	-- cab is not centred over the wheelbase. Positive local Z is toward the\n	-- rear: CFrame.LookVector -- the direction the chassis is built facing,\n	-- see driveForce in this same file -- points along local -Z, so \"back\" is\n	-- the other way.\n	cab.CFrame = cframe * CFrame.new(0, kind.size.Y / 2 + cabSize.Y / 2 - 0.1, kind.size.Z * 0.08)\n	cab.Anchored = false\n	cab.CanCollide = true\n	cab.Massless = true\n	cab.Parent = model\n\n	local weld = Instance.new(\"WeldConstraint\")\n	weld.Part0 = chassis\n	weld.Part1 = cab\n	weld.Parent = cab\n\n	local glass = Instance.new(\"Part\")\n	glass.Name = \"Windshield\"\n	glass.Size = Vector3.new(cabSize.X - 0.4, cabSize.Y * 0.7, 0.2)\n	glass.Color = GLASS_COLOR\n	glass.Material = GLASS_MATERIAL\n	glass.Transparency = 0.35\n	-- The cab's front edge, which is its local -Z face -- same direction as the\n	-- chassis's own front, since the cab carries no rotation of its own.\n	glass.CFrame = cab.CFrame * CFrame.new(0, cabSize.Y * 0.12, -cabSize.Z / 2 + 0.05)\n	glass.Anchored = false\n	glass.CanCollide = false\n	glass.CanQuery = false\n	glass.Massless = true\n	glass.Parent = model\n\n	local glassWeld = Instance.new(\"WeldConstraint\")\n	glassWeld.Part0 = chassis\n	glassWeld.Part1 = glass\n	glassWeld.Parent = glass\n\n	-- Accent stripe along the flank, which is the one place the second colour\n	-- earns its keep -- see the note on Props.luau's accentColor for why a\n	-- placeholder gets two colours and not one.\n	local stripe = Instance.new(\"Part\")\n	stripe.Name = \"Stripe\"\n	stripe.Size = Vector3.new(kind.size.X + 0.05, 0.18, kind.size.Z * 0.85)\n	stripe.Color = kind.accentColor\n	stripe.Material = BODY_MATERIAL\n	stripe.CFrame = cframe * CFrame.new(0, -kind.size.Y * 0.05, 0)\n	stripe.Anchored = false\n	stripe.CanCollide = false\n	stripe.CanQuery = false\n	stripe.Massless = true\n	stripe.Parent = model\n\n	local stripeWeld = Instance.new(\"WeldConstraint\")\n	stripeWeld.Part0 = chassis\n	stripeWeld.Part1 = stripe\n	stripeWeld.Parent = stripe\n\n	return model\nend\n\nlocal function buildSeat(kind: VehicleKind, chassis: BasePart): VehicleSeat\n	local seat = Instance.new(\"VehicleSeat\")\n	seat.Name = \"DriverSeat\"\n	seat.Size = Vector3.new(math.min(kind.size.X - 1, 3.2), 1, 2.2)\n	-- Centred on X, which the research this file is built from names as the\n	-- single most common reason a Roblox car spins out the instant it turns --\n	-- an off-centre seat is an off-centre CFrame the whole steering model is\n	-- read from, and this chassis reads its own yaw off the seat's own CFrame\n	-- nowhere, so the centring here is about the model looking honest rather\n	-- than about the physics, but it is cheap to get right and worth doing.\n	seat.CFrame = chassis.CFrame * CFrame.new(0, kind.size.Y / 2 + 0.5, kind.size.Z * 0.05)\n	seat.Anchored = false\n	seat.CanCollide = false\n	seat.Massless = true\n	seat.Transparency = 1\n	-- Roblox's own drive numbers are not read here -- see the header on why the\n	-- chassis below reads .Throttle/.Steer directly instead of trusting the\n	-- seat's built-in HingeConstraint motoring, which assumes physical wheels\n	-- this chassis does not have.\n	seat.MaxSpeed = 0\n	seat.Torque = 0\n	seat.Parent = chassis.Parent\n\n	local weld = Instance.new(\"WeldConstraint\")\n	weld.Part0 = chassis\n	weld.Part1 = seat\n	weld.Parent = seat\n\n	return seat\nend\n\nlocal function buildCorners(kind: VehicleKind, chassis: BasePart): { Corner }\n	local halfX = kind.size.X / 2 - WHEEL_INSET_X\n	local halfZ = kind.size.Z / 2 - WHEEL_INSET_Z\n	local bottom = -kind.size.Y / 2\n\n	-- Labelled front/rear for readability only -- every corner runs the identical\n	-- tickCorner below, so nothing here actually branches on which is which.\n	-- Negative local Z is the front, matching CFrame.LookVector; see driveForce.\n	local offsets = {\n		Vector3.new(-halfX, bottom, -halfZ), -- front left\n		Vector3.new(halfX, bottom, -halfZ), -- front right\n		Vector3.new(-halfX, bottom, halfZ), -- rear left\n		Vector3.new(halfX, bottom, halfZ), -- rear right\n	}\n\n	local corners: { Corner } = {}\n	for _, offset in offsets do\n		local attachment = Instance.new(\"Attachment\")\n		attachment.Name = \"SuspensionMount\"\n		attachment.Position = offset\n		attachment.Parent = chassis\n\n		local force = Instance.new(\"VectorForce\")\n		force.Name = \"SuspensionForce\"\n		force.Attachment0 = attachment\n		force.RelativeTo = Enum.ActuatorRelativeTo.World\n		force.Force = Vector3.zero\n		force.Parent = attachment\n\n		local wheel = buildWheel(chassis.Parent :: Instance, VEHICLES.WheelRadius)\n		wheel.CFrame = chassis.CFrame * CFrame.new(offset) * CFrame.Angles(0, 0, math.rad(90))\n\n		table.insert(corners, { attachment = attachment, force = force, wheelModel = wheel, localOffset = offset })\n	end\n\n	return corners\nend\n\n-- The velocity of a point fixed to the chassis, in world space -- linear plus\n-- however fast that point is being carried around by the body's own spin.\n-- Needed for the damping term: a spring that only read the chassis's linear\n-- velocity would under-damp every corner during a turn, because the outside\n-- corners are moving faster than the centre of mass is.\nlocal function velocityAt(chassis: BasePart, worldPoint: Vector3): Vector3\n	local toPoint = worldPoint - chassis.Position\n	return chassis.AssemblyLinearVelocity + chassis.AssemblyAngularVelocity:Cross(toPoint)\nend\n\n-- One tick of suspension for one corner. Returns whether this wheel is touching,\n-- which the drive step needs -- force should not be pretending an airborne car\n-- still has grip.\nlocal function tickCorner(chassis: BasePart, corner: Corner, ignore: { Instance }): boolean\n	local attachment = corner.attachment\n	local force = corner.force\n	local worldPos = attachment.WorldPosition\n	-- Springs push along the chassis's own up, not world up -- see the header on\n	-- why this is deliberate: it is what lets a car lean into a bank on a hill\n	-- rather than the suspension fighting the slope on every corner at once.\n	local springAxis = chassis.CFrame.UpVector\n	local restLength = VEHICLES.SuspensionLength + VEHICLES.WheelRadius\n\n	local params = RaycastParams.new()\n	params.FilterType = Enum.RaycastFilterType.Exclude\n	params.FilterDescendantsInstances = ignore\n	params.IgnoreWater = true\n\n	local result = workspace:Raycast(worldPos, -springAxis * restLength, params)\n	if result == nil then\n		force.Force = Vector3.zero\n		corner.wheelModel.CFrame = CFrame.lookAt(worldPos - springAxis * restLength, worldPos - springAxis * restLength + chassis.CFrame.LookVector)\n			* CFrame.Angles(0, 0, math.rad(90))\n		return false\n	end\n\n	local distance = (result.Position - worldPos).Magnitude\n	local compression = math.clamp(restLength - distance, 0, restLength)\n	local velocity = velocityAt(chassis, worldPos):Dot(springAxis)\n\n	local magnitude = math.max(0, VEHICLES.SuspensionStiffness * compression - VEHICLES.SuspensionDamping * velocity)\n	force.Force = springAxis * magnitude\n\n	local wheelCenter = result.Position + springAxis * VEHICLES.WheelRadius\n	corner.wheelModel.CFrame = CFrame.lookAt(wheelCenter, wheelCenter + chassis.CFrame.LookVector) * CFrame.Angles(0, 0, math.rad(90))\n	return true\nend\n\n-- Longitudinal drive: seeks a target speed rather than applying a flat force, so\n-- there is no explicit top-speed clamp anywhere in this file -- the car simply\n-- stops being pushed once it is already going as fast as the throttle asks for.\n-- TopSpeedTaper narrows how hard that push is allowed to be as the car nears its\n-- rated top speed, which is what stops a light tap of throttle at speed reading\n-- as a full-force shove.\nlocal function driveForce(chassis: BasePart, kind: VehicleKind, throttle: number): Vector3\n	if throttle == 0 then\n		return Vector3.zero\n	end\n	-- CFrame.LookVector is Roblox's own convention for \"the way this part faces\" --\n	-- the local -Z direction -- and the chassis is built facing that way on purpose\n	-- (VehicleService spawns it with CFrame.lookAt pointed at the dealership), so\n	-- this is forward with no correction needed. Taking the negative here once read\n	-- as \"obviously forward is the other way\" and was wrong -- the car drove\n	-- backward relative to its own windshield the first time this ran.\n	local forward = chassis.CFrame.LookVector\n	local currentSpeed = chassis.AssemblyLinearVelocity:Dot(forward)\n	local targetSpeed = throttle * kind.topSpeedStuds\n	local speedShare = math.clamp(math.abs(currentSpeed) / kind.topSpeedStuds, 0, 1)\n	local headroom = 1 - speedShare * (1 - VEHICLES.TopSpeedTaper)\n	local error_ = targetSpeed - currentSpeed\n	local magnitude = math.clamp(error_ * kind.acceleration * 40, -kind.acceleration * 4000, kind.acceleration * 4000) * headroom\n	return forward * magnitude\nend\n\n-- Lateral grip: a plain damper against sideways velocity, so the car corners\n-- rather than slides. Cheap and it is the one liberty this file takes with the\n-- otherwise-honest suspension model -- a raycast wheel has no physical contact\n-- patch to generate real cornering friction from, so this stands in for one.\nlocal function gripForce(chassis: BasePart): Vector3\n	local right = chassis.CFrame.RightVector\n	local lateralSpeed = chassis.AssemblyLinearVelocity:Dot(right)\n	return -right * lateralSpeed * LATERAL_GRIP\nend\n\n-- Steering, written straight onto the yaw rate rather than built from a torque.\n-- See the header for why direct yaw is used at all; the *shape* of it here is a\n-- bicycle model, the standard arcade-racing approximation: a car turning on a\n-- steered front wheel traces a circle of radius `wheelbase / tan(steerAngle)`,\n-- so its yaw rate is `speed / radius`. That formula is what actually gives \"a\n-- stationary car does not spin on the spot\" for free -- it falls out of speed\n-- being the numerator, not a special case bolted on -- and it cannot blow up\n-- near zero speed the way dividing *by* speed would.\n--\n-- HighSpeedSteerShare/SteerTaperStuds is then a second, independent scale on\n-- top of the honest bicycle number: a real bicycle model gets twitchier at\n-- speed, not calmer, and letting that through untouched is exactly the spin-out\n-- this project's own numbers are named to prevent.\nlocal function tickSteer(chassis: BasePart, kind: VehicleKind, steer: number, elapsed: number)\n	-- See driveForce above for why this is the plain LookVector, un-negated.\n	local forward = chassis.CFrame.LookVector\n	local speed = chassis.AssemblyLinearVelocity:Dot(forward)\n	local wheelbase = math.max(kind.size.Z * 0.6, 1)\n\n	local speedShare = math.clamp(math.abs(speed) / VEHICLES.SteerTaperStuds, 0, 1)\n	local highSpeedScale = 1 - speedShare * (1 - VEHICLES.HighSpeedSteerShare)\n\n	local steerAngle = math.rad(steer * kind.steerDegrees)\n	local targetYaw = (speed / wheelbase) * math.tan(steerAngle) * highSpeedScale\n	targetYaw = math.clamp(targetYaw, -math.rad(kind.steerDegrees) * 1.6, math.rad(kind.steerDegrees) * 1.6)\n\n	local current = chassis.AssemblyAngularVelocity\n	local nextYaw = current.Y + (targetYaw - current.Y) * math.clamp(YAW_RESPONSIVENESS * elapsed, 0, 1)\n	chassis.AssemblyAngularVelocity = Vector3.new(current.X, nextYaw, current.Z)\nend\n\n-- Builds a car standing at `cframe`, with nothing driving it yet -- call `Start`\n-- to bring the chassis to life. Split from Start so a caller can pose the model,\n-- read its PrimaryPart, or decide not to start it at all (a showroom car parked\n-- for looks, one day) without paying for a running loop.\nfunction VehicleChassis.Build(kind: VehicleKind, cframe: CFrame): Chassis\n	local model = buildBody(kind, cframe)\n	local chassis = model.PrimaryPart :: BasePart\n	local seat = buildSeat(kind, chassis)\n	local corners = buildCorners(kind, chassis)\n\n	local running = true\n	local occupantConnection: RBXScriptConnection? = nil\n\n	local function stop()\n		if not running then\n			return\n		end\n		running = false\n		if occupantConnection ~= nil then\n			occupantConnection:Disconnect()\n			occupantConnection = nil\n		end\n	end\n\n	-- Computed once rather than rebuilt every tick -- the one thing a suspension\n	-- raycast must never hit is the car's own body, and which model that is\n	-- never changes for the life of this chassis.\n	local ignore: { Instance } = { model }\n\n	task.spawn(function()\n		while running and model.Parent ~= nil do\n			local elapsed = task.wait(VEHICLES.TickSeconds)\n			if not running or model.Parent == nil or chassis.Parent == nil then\n				break\n			end\n\n			local anyGrounded = false\n			for _, corner in corners do\n				if tickCorner(chassis, corner, ignore) then\n					anyGrounded = true\n				end\n			end\n\n			local throttle = seat.Throttle\n			local steer = seat.Steer\n\n			local total = Vector3.zero\n			if anyGrounded then\n				total += driveForce(chassis, kind, throttle)\n				total += gripForce(chassis)\n				tickSteer(chassis, kind, steer, elapsed)\n			end\n\n			if total.Magnitude > 0 then\n				chassis:ApplyImpulse(total * elapsed)\n			end\n		end\n	end)\n\n	occupantConnection = seat:GetPropertyChangedSignal(\"Occupant\"):Connect(function()\n		local occupant = seat.Occupant\n		local player = if occupant ~= nil then Players:GetPlayerFromCharacter(occupant.Parent) else nil\n		if player ~= nil then\n			-- The explicit handoff the header argues for. A car has exactly one\n			-- seat, so there is no passenger who could have claimed ownership\n			-- first -- but setting it explicitly rather than trusting Roblox's\n			-- default assignment costs one line and removes the question.\n			chassis:SetNetworkOwner(player)\n		else\n			chassis:SetNetworkOwnershipAuto()\n		end\n	end)\n\n	return {\n		model = model,\n		seat = seat,\n		kind = kind,\n		destroy = function()\n			stop()\n			if model.Parent ~= nil then\n				model:Destroy()\n			end\n		end,\n	}\nend\n\n-- Studs per second, read off the seat's own chassis. For a speedometer HUD --\n-- see client/ui/VehicleUI.luau -- so the number on screen and the number the\n-- drive force is actually seeking can never disagree.\nfunction VehicleChassis.SpeedOf(chassisInstance: BasePart): number\n	return chassisInstance.AssemblyLinearVelocity.Magnitude\nend\n\nreturn VehicleChassis\n"
table.insert(AGES_MANIFEST, "src/server/world/VehicleChassis.luau")
AGES_SOURCES["src/server/world/Wardrobe.luau"] = "--!strict\n-- The mark you stand on to change your clothes, and the sign over it that says how it is\n-- going.\n--\n-- Split from DisguiseService for the reason Till is split from TheftService and Lab from\n-- ScienceService: where a thing stands and what happens when you reach it are different\n-- questions. Re-laying the town must never be able to touch what an escape is worth.\n--\n-- A floor mark rather than three dots over somebody's head, and that is the interaction\n-- grammar being obeyed rather than bent. Dots are for *choices*; floor marks are for\n-- destinations, and this is the purest destination in the game -- there is nothing to\n-- decide when you get here, only somewhere to be. Nothing is clicked at any point: you run\n-- onto it, it counts, and stepping off cancels. Under a chase that is the right shape,\n-- because a panel you have to open is a panel you have to look away from the street to read.\n--\n-- Everything the player needs is written above the mark, in the world. That is deliberate\n-- and it is the same argument the shop camera makes: during the five seconds this takes,\n-- the player is standing still while officers converge, and the one thing they will be\n-- looking at is the spot they are standing on. A HUD panel would be off to the side of the\n-- only thing on screen that matters.\n--\n-- Stood up relative to a place point rather than bolted onto the room's own furniture, so\n-- the day somebody renames a box in the generator is not the day four escapes disappear.\n-- Built lazily and left standing: four marks' worth of parts is nothing.\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Config = require(ReplicatedStorage:WaitForChild(\"Config\"))\n\nlocal Wardrobe = {}\n\nlocal DISGUISE = Config.Crime.Disguise\n\n-- Cosmetic dimensions, kept out of Config for the reason ChoiceMarkers gives: nobody\n-- balances this game by changing how wide a floor mark is.\n--\n-- The disc is drawn *inside* ReachStuds rather than out to it. The mark is what the player\n-- aims at and the reach is what actually counts, so the paint has to be a promise the server\n-- always keeps: stand on it and you are certainly changing. The forgiving band lives outside\n-- the paint, where it costs nothing to be wrong about.\n--\n-- It used to be `ReachStuds * 2.2`, which is a *radius* of 1.1 reaches -- the paint was 10%\n-- wider than the area that worked. The comment above it argued for exactly this rule and\n-- then got the direction backwards, which is the worst version of the defect: a player\n-- standing on the outer 0.6 studs of the disc could see themselves on the mark, be off it as\n-- far as DisguiseService was concerned, and lose five seconds of change with the paint under\n-- their feet the whole time. An error in the other direction is invisible -- a player just\n-- off the paint who keeps working never learns anything was wrong.\n--\n-- Kept as a share rather than a width so it cannot drift from ReachStuds, and guarded below,\n-- because \"the paint means what it says\" is the whole point of drawing it.\nlocal DISC_REACH_SHARE = 0.9\nif DISC_REACH_SHARE >= 1 then\n	error(\n		`[AGES] Wardrobe DISC_REACH_SHARE is {DISC_REACH_SHARE}, so the change disc is drawn `\n			.. `at or beyond Crime.Disguise.ReachStuds ({DISGUISE.ReachStuds}). The paint would `\n			.. `then cover ground where DisguiseService refuses the change, and standing on the `\n			.. `mark would silently do nothing. Set it below 1.`\n	)\nend\nlocal DISC_THICKNESS = 0.2\nlocal DISC_LIFT = 0.08\nlocal RAIL_SIZE = Vector3.new(0.5, 0.5, 5.0)\nlocal RAIL_LIFT = 6.5\nlocal RAIL_BACK = 1.6\nlocal POST_SIZE = Vector3.new(0.35, 6.5, 0.35)\n\nlocal IDLE_COLOR = Color3.fromRGB(88, 96, 110)\n-- Amber while it is counting, and it is the same amber the search ring takes, because both\n-- of them mean \"this is in progress and not yet true\".\nlocal BUSY_COLOR = Color3.fromRGB(238, 176, 74)\n-- Red for blocked, matching the heat bar's border and the camera lens: this game uses one\n-- red and it means \"you are being seen\".\nlocal BLOCKED_COLOR = Color3.fromRGB(226, 78, 74)\nlocal DONE_COLOR = Color3.fromRGB(126, 208, 130)\nlocal RAIL_COLOR = Color3.fromRGB(150, 156, 168)\n\nlocal BILLBOARD_SIZE = UDim2.fromOffset(220, 62)\nlocal BILLBOARD_LIFT = 8.5\n\n-- One built hideout.\nexport type Mark = {\n	place: string,\n	-- Where the mark is, for the reach check. A position rather than the part, because reach\n	-- is arithmetic and nothing outside this file should be holding a piece of the world.\n	at: Vector3,\n	disc: BasePart,\n	label: TextLabel,\n	fill: Frame,\n	-- Whose progress the sign is currently showing. Two players on one mark would otherwise\n	-- flicker between two counts, and a sign that reads for nobody is worse than a sign that\n	-- reads for one of them. First to arrive keeps it until they step off.\n	owner: Player?,\n}\n\nlocal marks: { [string]: Mark } = {}\nlocal folder: Folder? = nil\n\nlocal function markFolder(): Folder\n	local existing = folder\n	if existing ~= nil and existing.Parent ~= nil then\n		return existing\n	end\n	local made = Instance.new(\"Folder\")\n	made.Name = \"AgesHideouts\"\n	made.Parent = workspace\n	folder = made\n	return made\nend\n\nlocal function buildPart(parent: Instance, name: string, at: CFrame, size: Vector3, color: Color3): BasePart\n	local part = Instance.new(\"Part\")\n	part.Name = name\n	part.Size = size\n	part.CFrame = at\n	part.Anchored = true\n	-- Out of every ignore list in the game by construction. An officer's line of sight and a\n	-- witness's are both raycasts, and a decoration a player could stand behind would let\n	-- them hide behind the very thing telling them where to run.\n	part.CanCollide = false\n	part.CanQuery = false\n	part.CanTouch = false\n	part.Color = color\n	part.Material = Enum.Material.SmoothPlastic\n	part.TopSurface = Enum.SurfaceType.Smooth\n	part.BottomSurface = Enum.SurfaceType.Smooth\n	part.Parent = parent\n	return part\nend\n\n-- The hideout, stood up. Nil when the place point has no heading to build against, which the\n-- caller reports by name -- a mark that silently failed to appear is a corner of the map a\n-- player sprints to during the worst thirty seconds of their afternoon and finds empty.\nfunction Wardrobe.Build(place: string, at: CFrame, label: string): Mark?\n	local existing = marks[place]\n	if existing ~= nil and existing.disc.Parent ~= nil then\n		return existing\n	end\n\n	local forward = at.LookVector\n	local flat = Vector3.new(forward.X, 0, forward.Z)\n	if flat.Magnitude < 1e-3 then\n		return nil\n	end\n	flat = flat.Unit\n\n	local group = Instance.new(\"Folder\")\n	group.Name = place\n	group.Parent = markFolder()\n\n	local base = at.Position\n	-- Diameter, so the reach -- which is a radius -- is doubled before the share is taken.\n	-- Getting that factor of two wrong is what put the paint outside the reach before.\n	local width = DISGUISE.ReachStuds * 2 * DISC_REACH_SHARE\n	-- A cylinder's flat faces are on its X axis, so a disc lying on the floor is one turned\n	-- on its side -- which is why the thickness is the X of the size and the roll is 90\n	-- degrees. This is the one thing in the file that looks like a mistake and is not.\n	local disc = buildPart(\n		group,\n		\"Mark\",\n		CFrame.new(base + Vector3.new(0, DISC_LIFT, 0)) * CFrame.Angles(0, 0, math.rad(90)),\n		Vector3.new(DISC_THICKNESS, width, width),\n		IDLE_COLOR\n	)\n	disc.Shape = Enum.PartType.Cylinder\n\n	-- A clothes rail behind the mark, so the thing is legible as somewhere you change rather\n	-- than as a glowing circle on the floor. Cheap, and it is what makes a player who has\n	-- never read a word of this understand the mark on sight.\n	local railAt = base - flat * RAIL_BACK + Vector3.new(0, RAIL_LIFT, 0)\n	buildPart(group, \"Rail\", CFrame.new(railAt, railAt + Vector3.new(flat.Z, 0, -flat.X)), RAIL_SIZE, RAIL_COLOR)\n	for _, side in { -1, 1 } do\n		local postAt = railAt\n			+ Vector3.new(flat.Z, 0, -flat.X) * (RAIL_SIZE.Z / 2) * side\n			- Vector3.new(0, POST_SIZE.Y / 2, 0)\n		buildPart(group, \"Post\", CFrame.new(postAt), POST_SIZE, RAIL_COLOR)\n	end\n\n	local anchor = buildPart(group, \"Sign\", CFrame.new(base + Vector3.new(0, BILLBOARD_LIFT, 0)), Vector3.new(0.2, 0.2, 0.2), RAIL_COLOR)\n	anchor.Transparency = 1\n\n	local billboard = Instance.new(\"BillboardGui\")\n	billboard.Name = \"Status\"\n	billboard.Size = BILLBOARD_SIZE\n	billboard.StudsOffsetWorldSpace = Vector3.new(0, 0, 0)\n	-- Not AlwaysOnTop. The search ring's pin is, because its whole job is telling you where\n	-- the police are looking from inside the building you are hiding in -- but this sign is\n	-- about a spot you have to physically be standing on, and one that showed through walls\n	-- would advertise four hiding places across the whole map at all times.\n	billboard.AlwaysOnTop = false\n	billboard.MaxDistance = 90\n	billboard.Adornee = anchor\n	billboard.Parent = anchor\n\n	local text = Instance.new(\"TextLabel\")\n	text.Size = UDim2.new(1, 0, 0, 26)\n	text.BackgroundTransparency = 1\n	text.Font = Enum.Font.GothamMedium\n	text.TextSize = 18\n	text.TextColor3 = Color3.fromRGB(238, 240, 244)\n	text.TextStrokeTransparency = 0.4\n	text.Text = label\n	text.Parent = billboard\n\n	local track = Instance.new(\"Frame\")\n	track.Size = UDim2.new(1, -20, 0, 8)\n	track.Position = UDim2.new(0, 10, 0, 32)\n	track.BackgroundColor3 = Color3.fromRGB(28, 31, 38)\n	track.BackgroundTransparency = 0.25\n	track.BorderSizePixel = 0\n	track.Parent = billboard\n\n	local fill = Instance.new(\"Frame\")\n	fill.Size = UDim2.fromScale(0, 1)\n	fill.BackgroundColor3 = BUSY_COLOR\n	fill.BorderSizePixel = 0\n	fill.Parent = track\n\n	local mark: Mark = {\n		place = place,\n		at = base,\n		disc = disc,\n		label = text,\n		fill = fill,\n		owner = nil,\n	}\n	marks[place] = mark\n	return mark\nend\n\nfunction Wardrobe.Get(place: string): Mark?\n	local mark = marks[place]\n	if mark == nil or mark.disc.Parent == nil then\n		return nil\n	end\n	return mark\nend\n\n-- How far a position is from the mark, flat, or nil if there is no mark there.\n--\n-- A distance rather than the yes/no the caller mostly wants, because the caller has four\n-- marks to choose between and \"am I on it\" cannot break a tie. Two hideouts are never close\n-- enough for that to matter today, but \"whichever the loop reached first\" is the kind of\n-- rule that is fine until somebody puts two in one building and then is impossible to debug.\n--\n-- Flat, ignoring height, for the same reason every reach check in this game is: a player on\n-- the step above a mark is standing on it as far as anybody watching is concerned.\nfunction Wardrobe.DistanceTo(place: string, from: Vector3): number?\n	local mark = Wardrobe.Get(place)\n	if mark == nil then\n		return nil\n	end\n	local dx = from.X - mark.at.X\n	local dz = from.Z - mark.at.Z\n	return math.sqrt(dx * dx + dz * dz)\nend\n\n-- Whether this player may drive the sign. First one on keeps it; everybody else is refused\n-- until they step off, which is the only sane answer for one sign and two counts.\nfunction Wardrobe.Claim(place: string, player: Player): boolean\n	local mark = Wardrobe.Get(place)\n	if mark == nil then\n		return false\n	end\n	local owner = mark.owner\n	if owner ~= nil and owner ~= player and owner.Parent ~= nil then\n		return false\n	end\n	mark.owner = player\n	return true\nend\n\n-- What the sign says and how full the bar is. `share` is 0 to 1.\n--\n-- Told what to draw rather than working it out, for the same reason Till.AimCamera is: the\n-- timing is the activity and the activity lives in the service. This file paints.\nfunction Wardrobe.Show(place: string, player: Player, headline: string, share: number, state: string)\n	local mark = Wardrobe.Get(place)\n	if mark == nil or mark.owner ~= player then\n		return\n	end\n	mark.label.Text = headline\n	mark.fill.Size = UDim2.fromScale(math.clamp(share, 0, 1), 1)\n	local color = if state == \"blocked\"\n		then BLOCKED_COLOR\n		elseif state == \"done\" then DONE_COLOR\n		elseif state == \"busy\" then BUSY_COLOR\n		else IDLE_COLOR\n	mark.fill.BackgroundColor3 = color\n	mark.disc.Color = color\nend\n\n-- Back to nothing happening here. Idempotent, and it releases the sign -- a mark left owned\n-- by somebody who walked away is a mark the next player cannot use, which is the worst\n-- possible bug for a thing whose entire job is being available in an emergency.\nfunction Wardrobe.Rest(place: string, player: Player, label: string)\n	local mark = Wardrobe.Get(place)\n	if mark == nil or (mark.owner ~= nil and mark.owner ~= player) then\n		return\n	end\n	mark.owner = nil\n	mark.label.Text = label\n	mark.fill.Size = UDim2.fromScale(0, 1)\n	mark.fill.BackgroundColor3 = BUSY_COLOR\n	mark.disc.Color = IDLE_COLOR\nend\n\nreturn Wardrobe\n"
table.insert(AGES_MANIFEST, "src/server/world/Wardrobe.luau")
AGES_SOURCES["src/server/world/WorkSpots.luau"] = "--!strict\n-- Somewhere in this workplace you could actually stand.\n--\n-- Every task in a shift needs a patch of floor to put a mark on, and the only thing\n-- that makes that hard is that nobody has told this code what the building looks\n-- like. There is no list of shelves and no tagged part for the stockroom -- there is\n-- a station the player clocked on at and a room around it that was built in Studio by\n-- hand and may have been rearranged since.\n--\n-- So the spot is found rather than authored: fan out around the station, and take the\n-- first bearing whose floor exists, has room for a body, and can be walked to in a\n-- straight line. Exactly the three questions EnactService asks before it puts a\n-- choice pad down, asked with the same Ground probes for the same reason -- they err\n-- toward rejecting a tight spot, and a rejected spot costs a fallback while an\n-- accepted bad one costs a player standing inside a wall being asked to sweep it.\n--\n-- What this buys is that a job gets tasks the moment the job exists. No parts to tag,\n-- no offsets to measure, and a workplace that gets refurnished next month does not\n-- silently start sending people into the new shelving.\n--\n-- Split from WorkService for the reason JobPosts was: where a mark can go and what\n-- happens when you reach it are different questions, and re-tuning the search should\n-- never be able to touch the wage loop.\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Config = require(ReplicatedStorage:WaitForChild(\"Config\"))\n\nlocal Ground = require(script.Parent.Ground)\n\nlocal WorkSpots = {}\n\n-- How far apart two marks in the same task must be, in multiples of the radius that\n-- counts as reaching one.\n--\n-- Three rather than two, and the extra one is not slack. At two, the marks are only\n-- as far apart as their own diameters, so a player standing on the near edge of the\n-- first is exactly on the far edge of the second -- and a two-mark task would\n-- complete itself on the following tick without anybody taking a step. Which is\n-- precisely the thing \"fetch it and bring it back\" exists to make impossible.\nlocal SEPARATION_REACHES = 3\n\n-- How far out the search reaches, resolved once from the two numbers that describe\n-- it. Kept well inside StationRadiusStuds because a mark painted beyond it would end\n-- the player's own shift for walking out on it -- see the Config comment.\nlocal function spreadStuds(): number\n	return math.max(\n		Config.Work.Tasks.MinSpreadStuds,\n		Config.Work.StationRadiusStuds * Config.Work.Tasks.SpreadShareOfStation\n	)\nend\n\n-- A patch of floor near `station` that a body could stand on and walk to, avoiding\n-- anywhere in `avoid`.\n--\n-- `avoid` is the marks already placed for this task, so a two-mark task does not\n-- paint both of them on the same tile and turn \"fetch it and bring it back\" into\n-- standing still. Measured against the reach radius rather than any smaller figure,\n-- because two marks a body's width apart are one mark as far as the player's feet are\n-- concerned.\n--\n-- Nil means the room defeated the search: a stockroom too small to fan out in, or a\n-- station somebody built facing a wall. The caller's job is to carry on without a\n-- task rather than to place one badly, which is why this returns nil instead of\n-- falling back to the station itself -- a mark under your feet teaches the player\n-- that the marks can be ignored, and that lesson is much more expensive than a\n-- missing task.\nfunction WorkSpots.Find(character: Model, station: Vector3, avoid: { Vector3 }): Vector3?\n	local tasks = Config.Work.Tasks\n	local radius = Ground.BodyRadius(character)\n	local height = Ground.BodyHeight(character)\n	local ignore = Ground.IgnoreList()\n	local spread = spreadStuds()\n\n	-- Scattered rather than walked in order, so the same task at the same counter does\n	-- not put its mark in the same corner every single time. The search is otherwise\n	-- completely deterministic, and a shift where every task happens in one spot is a\n	-- shift that stops being a room after about ninety seconds.\n	local bearings = Ground.ScatteredBearings(tasks.SearchArcDegrees, tasks.SearchBearings)\n\n	for _, bearing in bearings do\n		local direction = CFrame.Angles(0, math.rad(bearing), 0) * Vector3.new(0, 0, -1)\n\n		for _, step in tasks.SearchSteps do\n			local distance = math.max(tasks.MinSpreadStuds, spread * step)\n\n			-- Reachability measured from the station rather than from the player. The\n			-- station is the fixed point of the shift and the player is wherever they\n			-- happen to be standing; measuring from the player would let a spot be legal\n			-- when they asked for it and unreachable two seconds later.\n			local floor = Ground.SpotAt(station + direction * distance, radius, height, ignore, station)\n			if floor == nil then\n				continue\n			end\n			if not Ground.Apart(floor, avoid, tasks.ReachStuds * SEPARATION_REACHES) then\n				continue\n			end\n\n			return floor\n		end\n	end\n\n	return nil\nend\n\n-- Where somebody waiting on a task would stand, and where they walk in from.\n--\n-- Both measured out along the line from the station through the mark, so the player\n-- steps onto the mark and finds the other person across it facing them. That line is\n-- the only thing here that makes it read as a counter rather than as two people\n-- standing near each other, and it needs no knowledge of the building at all: the\n-- station is behind you because it is what you clocked on at, so anything beyond the\n-- mark is the customer's side by definition.\n--\n-- Three answers, and the caller has to handle all three, because a task must never\n-- fail for want of somewhere to put a person:\n--\n--   nil, nil        no room for them. Run the task alone, exactly as it ran before\n--                   anybody was ever waiting on it.\n--   stand, nil      room to stand, nowhere to come from. They appear where they\n--                   stand -- worse than walking in, and much better than nothing.\n--   stand, from     the whole thing.\n--\n-- Measured against Config.NPC's nominal body rather than a real one, for the reason\n-- that config states: building an avatar is a web-backed call, and spawning a person\n-- to discover there was nowhere for them to go is the wrong order to do it in.\nfunction WorkSpots.Attend(station: Vector3, spot: Vector3): (Vector3?, Vector3?)\n	local customers = Config.Work.Customers\n	local ignore = Ground.IgnoreList()\n	local radius = Config.NPC.BodyRadius\n	local height = Config.NPC.BodyHeight\n\n	local away = Vector3.new(spot.X - station.X, 0, spot.Z - station.Z)\n	if away.Magnitude < 0.1 then\n		-- The mark landed on top of the station, which the search is built to prevent.\n		-- There is no \"across the mark\" from a point with no direction to it, and\n		-- guessing one would put somebody behind the counter.\n		return nil, nil\n	end\n	local outward = away.Unit\n\n	-- Reachable from the mark rather than from the station: what matters is that the\n	-- player and the person they are serving can see each other across it. A pillar\n	-- between the counter and the customer is the one arrangement that would look broken.\n	local standFloor = Ground.SpotAt(spot + outward * customers.StandOffStuds, radius, height, ignore, spot)\n	if standFloor == nil then\n		return nil, nil\n	end\n\n	-- Nil here is not a failure of the whole thing: somebody can stand across the mark\n	-- with nowhere authored to walk in from, and the caller pops them into place. Which\n	-- is why this is a second call rather than another way for the first to fail.\n	local fromFloor =\n		Ground.SpotAt(standFloor + outward * customers.ArriveFromStuds, radius, height, ignore, standFloor)\n	return standFloor, fromFloor\nend\n\n-- Where a queue of `count` would stand, front first, and where they walk in from.\n--\n-- The same line as Attend, continued: the front stands across the mark, and everybody\n-- else is a QueueSpacingStuds further back along it. So a queue points away from the\n-- counter, which is the one arrangement that reads as a queue from any angle -- a\n-- cluster of four people near a till reads as a crowd, and a crowd does not have a\n-- front to serve.\n--\n-- Returns as many as fit and stops at the first slot that does not, rather than\n-- skipping it and carrying on. A gap in the middle of a line is worse than a short\n-- line: it looks like two queues, and the player has to guess which end is the front.\n--\n-- The list may be shorter than asked for and may be empty, and the caller has to cope\n-- with both. Empty is not a failure -- it is the same answer Attend gives for a room\n-- with no space beyond the mark, and it means the task runs with nobody in it.\nfunction WorkSpots.Line(station: Vector3, spot: Vector3, count: number): ({ Vector3 }, Vector3?)\n	local slots: { Vector3 } = {}\n	if count < 1 then\n		return slots, nil\n	end\n\n	local front, from = WorkSpots.Attend(station, spot)\n	if front == nil then\n		return slots, nil\n	end\n	table.insert(slots, front)\n	if count == 1 then\n		return slots, from\n	end\n\n	local customers = Config.Work.Customers\n	local ignore = Ground.IgnoreList()\n	local radius = Config.NPC.BodyRadius\n	local height = Config.NPC.BodyHeight\n\n	local away = Vector3.new(spot.X - station.X, 0, spot.Z - station.Z)\n	if away.Magnitude < 0.1 then\n		return slots, from\n	end\n	local outward = away.Unit\n\n	for index = 2, count do\n		local behind = front + outward * (customers.QueueSpacingStuds * (index - 1))\n\n		-- Reachability checked back to the slot in front rather than to the counter. What\n		-- matters for somebody third in line is that they can step up when the queue\n		-- moves; whether they can see the till from where they are standing is exactly\n		-- the thing about queueing that nobody enjoys, and is not a placement error.\n		local floor = Ground.SpotAt(behind, radius, height, ignore, slots[index - 1])\n		if floor == nil then\n			break\n		end\n\n		table.insert(slots, floor)\n	end\n\n	-- Re-measured from the back of the line that actually formed, not from the front.\n	-- Walking in to the point the first person came from would mean everybody after\n	-- them appearing inside the queue and walking backwards out of it.\n	local last = slots[#slots]\n	local arriveFloor = Ground.SpotAt(last + outward * customers.ArriveFromStuds, radius, height, ignore, last)\n	if arriveFloor == nil then\n		return slots, from\n	end\n\n	return slots, arriveFloor\nend\n\nreturn WorkSpots\n"
table.insert(AGES_MANIFEST, "src/server/world/WorkSpots.luau")
AGES_SOURCES["src/shared/Config.luau"] = "--!strict\n-- Every tunable number in the game lives here. No magic numbers in system code.\n\nlocal Config = {}\n\nConfig.Time = {\n	-- Age is stored in months for future sub-year content, but aging currently\n	-- moves a whole year at a time, so ageMonths is always a multiple of this.\n	MonthsPerYear = 12,\n\n	-- The world clock. Nothing displays it yet — the visible day/night cycle\n	-- arrives with the world in a later build step — but durations are already\n	-- expressed in game time so they don't need re-tuning when it lands.\n	-- Safe range: 6-30. Below ~6 a day is over before anything can happen in it.\n	RealMinutesPerGameDay = 12,\n	GameHoursPerDay = 24,\n\n	-- Weeks in a year, for rates that are quoted by the week. There is no in-year\n	-- week clock and deliberately isn't one: a week is simply how a person talks\n	-- about small recurring money -- \"you get five a week\" -- while a birthday is\n	-- the only moment the game has to actually hand any over. This is the number\n	-- that turns the one into the other.\n	--\n	-- Not a tunable in any honest sense; a year has 52 weeks. It lives here because\n	-- it appears in a payout, and a payout with a bare 52 sitting in it is exactly\n	-- the magic number this file exists to stop.\n	WeeksPerYear = 52,\n}\n\n-- Derived, not tuned: 12 real minutes across 24 game hours = 30 real seconds\n-- per game hour. Change RealMinutesPerGameDay and every game-time duration in\n-- the file rescales with it.\nConfig.Time.RealSecondsPerGameHour = (Config.Time.RealMinutesPerGameDay * 60) / Config.Time.GameHoursPerDay\n\n-- Aging is player-driven: no wall clock advances the world. A year ends when\n-- the player chooses to end it, or when a safety net decides they have been\n-- living the same year long enough. Every timer below counts *in-server*\n-- time only — time spent logged out never advances a life.\n\n-- Game hours of active play before an adolescent/adult/elder is aged up for\n-- them. At the current day length this is 100 x 30s = 50 real minutes.\n-- Safe range: 24-300. Too low and the manual button stops feeling like the\n-- player's decision; too high and an idle or distracted player stalls.\nConfig.AutoAgeUpGameHours = 100\n\n-- Same, but for the years below ManualAgeUpMinAge, where there is no button to\n-- press. 4 game hours = 2 real minutes, so early childhood costs\n-- ManualAgeUpMinAge x that in total. Safe range: 1-12.\nConfig.ChildAutoAgeUpGameHours = 4\n\n-- The age the player takes the wheel. Below this there is no Age Up button and\n-- the safety net alone carries them, because an infant choosing to grow up\n-- doesn't fit the fiction. From here on they can play sports, make friends and\n-- decide when a year is done, so the choice becomes theirs.\n-- Safe range: 0-12. At 0 there is no automatic-only stretch at all.\nConfig.ManualAgeUpMinAge = 5\n\n-- Completed lives before the \"Skip Childhood\" button appears in the years below\n-- ManualAgeUpMinAge. A first life always plays childhood through, because it is\n-- content rather than a wait; from the second life on it is opt-in. At 0 the\n-- skip exists immediately and most players would never see those years at all.\n-- Safe range: 1-3.\nConfig.SkipChildhoodMinLives = 1\n\n-- Minimum active seconds between two manual age-ups. Deliberately in *real*\n-- seconds, not game time: this is an input rate limit, not a world duration, so\n-- it shouldn't move when the day length is re-tuned. It is the \"once per year\"\n-- gate that stops the button being spammed from birth to death in one breath,\n-- and doubles as the retry guard on the RequestAgeUp remote.\n-- At 60 a player doing nothing else lives 13 to 80 in about an hour, while the\n-- auto net above is 50x slower — so pressing Age Up stays a deliberate act, not\n-- the thing you do while waiting. Expected to rarely bind once there is enough\n-- to do in a year. Safe range: 15-120.\nConfig.ManualAgeUpCooldownSeconds = 60\n\n-- The same rate limit, but for the years below ManualAgeUpMinAge. Shorter on\n-- purpose: a toddler year has no shift to work and no lesson to sit, so\n-- holding it to the same 60-second gate as a self-directed year would make\n-- the button a waiting room rather than pacing. 15 still stops it being\n-- spammed birth-to-five in one breath, which is what \"SkipChildhood\" is for\n-- if a player wants that instead. Safe range: 5-30.\nConfig.ChildManualAgeUpCooldownSeconds = 15\n\n-- How often the server banks playtime and refreshes the HUD progress bar.\n-- Safe range: 0.5-5. Lower is smoother but costs one remote per player per\n-- tick; against a 50 minute threshold the bar looks continuous even at 5.\nConfig.AgeUpProgressTickSeconds = 1\n\nConfig.LifeStages = {\n	{ id = \"Childhood\", minAge = 0, maxAge = 12 },\n	{ id = \"Adolescence\", minAge = 13, maxAge = 17 },\n	{ id = \"Adulthood\", minAge = 18, maxAge = 64 },\n	{ id = \"Elder\", minAge = 65, maxAge = math.huge },\n}\n\n-- How big a body is at a given age. **One curve for everybody in the world**, and\n-- that is the entire point of it rather than a tidiness note.\n--\n-- Height used to be answered twice. The player's answer was the childhood band\n-- ladder below -- a real one, with the head kept large so a toddler reads as a\n-- toddler. Everybody else's answer was a number drawn once at generation and never\n-- looked at again, which produced two separate wrongnesses at once: a child NPC was\n-- a *short adult* rather than a child, because nothing scaled the head with the\n-- body; and they never grew, so the kid you played out front with at four was\n-- exactly as tall at seventeen. Both are the same bug, and the fix is that age\n-- decides size for a townsperson exactly as it already did for the player.\n--\n-- Linear between keys, flat outside them. The first five keys reproduce the\n-- childhood bands **exactly** -- they are where those numbers now live -- so\n-- deriving the bands from this changes nothing about the player. The keys past\n-- five are new, and they are the years nothing modelled before: a twelve-year-old\n-- classmate is not adult-sized and never was.\n--\n-- head is deliberately above body everywhere below eighteen. Small people are\n-- mostly head, and it is the whole of what reads as \"young\" at a distance without\n-- a single piece of custom art.\nConfig.Growth = {\n	-- Sorted by age, and must stay sorted -- the lookup walks them in order.\n	-- Safe range: body 0.2-1.1, head 0.5-1.1, both climbing to 1 at eighteen.\n	Keys = {\n		{ age = 0, body = 0.30, head = 0.55 },\n		{ age = 1, body = 0.38, head = 0.60 },\n		{ age = 2, body = 0.46, head = 0.66 },\n		{ age = 4, body = 0.58, head = 0.74 },\n		{ age = 5, body = 0.68, head = 0.80 },\n		{ age = 8, body = 0.76, head = 0.86 },\n		{ age = 11, body = 0.83, head = 0.91 },\n		{ age = 14, body = 0.91, head = 0.96 },\n		{ age = 18, body = 1.00, head = 1.00 },\n		-- People do lose height, and a life that runs to ninety standing next to a\n		-- man who is exactly as tall as he was at twenty is a small lie the curve\n		-- is already shaped to avoid telling. Slight on purpose: three percent is\n		-- noticeable side by side and invisible on its own, which is correct.\n		{ age = 75, body = 0.97, head = 1.00 },\n	},\n}\n\n-- The lookup, and the one function in this file. It lives here rather than in a\n-- module of its own because the childhood bands below are *derived from it* at\n-- load, and a module Config required could not itself require Config. Keeping the\n-- keys and the reading of them together is what stops the two answers drifting\n-- apart again, which is the bug this whole section exists to close.\nfunction Config.Growth.At(ageYears: number): (number, number)\n	local keys = Config.Growth.Keys\n	local first = keys[1]\n	if ageYears <= first.age then\n		return first.body, first.head\n	end\n	for index = 2, #keys do\n		local key = keys[index]\n		if ageYears <= key.age then\n			local previous = keys[index - 1]\n			local span = key.age - previous.age\n			-- Guard rather than assume: two keys written at the same age would be a\n			-- divide by zero that produced a nan-sized body, which Roblox renders as\n			-- nothing at all and no error anywhere says why.\n			local t = if span > 0 then (ageYears - previous.age) / span else 1\n			return previous.body + (key.body - previous.body) * t,\n				previous.head + (key.head - previous.head) * t\n		end\n	end\n	local last = keys[#keys]\n	return last.body, last.head\nend\n\n-- The toddler years are playable rather than narrated, and the thing that\n-- progresses through them is the body itself: what you can do, how fast you can\n-- do it, and how tall you are to the world. The house never changes — you do.\n--\n-- Bands are matched in order by the first maxAge the player's age falls under,\n-- so they must stay sorted. The last band is the grown body and is deliberately\n-- unbounded, which is what everyone past childhood gets.\nConfig.Childhood = {\n	-- Last age of the playable toddler slice. Resolving an event advances the\n	-- year at or below this age and nowhere else: childhood has roughly one\n	-- event per year, but from age 6 the count per year climbs steeply and the\n	-- same rule would fire a player through a whole life in minutes.\n	-- Must line up with the last bounded band below. Safe range: 3-8.\n	EndAge = 5,\n\n	-- Quiet real seconds between a childhood event ending the year and the next\n	-- one being *handed over*, on the birthday path. Only reached by an event\n	-- authored Memory or Direct, which childhood no longer uses -- the toddler\n	-- years go through Wander below. Kept because that path is still legal and a\n	-- childhood event re-authored onto it tomorrow should not chain nose-to-tail.\n	-- Real seconds rather than game time: it is a pacing beat for the person\n	-- playing, not a duration in the world. Safe range: 5-45.\n	NextEventDelaySeconds = 15,\n\n	-- The toddler loop. A childhood event is not handed over on a birthday: it is\n	-- put somewhere on the floor with a line pointing at it, and reaching it is\n	-- what opens it. This is the whole of what a nought-to-five-year-old does, so\n	-- the numbers here are the pacing of the opening five minutes of the game.\n	Wander = {\n		-- How far off the thing is put, in studs. The floor of this is the number\n		-- that matters: too near and it is handed to you after all, which is the\n		-- exact failure this replaced. Twelve studs is three seconds of crawling at\n		-- the Crawl band's speed of 4 and about one at Run's 13, so the journey\n		-- shortens as the body gets better -- which is the growing up, told by\n		-- movement instead of by a number on a panel.\n		-- Safe range: 8-20 near, 20-45 far. Far must exceed near.\n		NearStuds = 12,\n		FarStuds = 28,\n\n		-- How many directions are tried before giving up on this tick. A full\n		-- circle is swept, because a toddler's room has no front. Twelve is one\n		-- every thirty degrees, which is finer than a body is wide at this\n		-- distance, so a reachable spot is not missed for want of looking.\n		-- Safe range: 6-24. Higher costs raycasts, not quality.\n		Bearings = 12,\n\n		-- How many distances are tried on each bearing, between NearStuds and\n		-- FarStuds. Two is near and far; more fills in between, which matters in a\n		-- small room where the far ring is entirely inside the walls.\n		-- Safe range: 2-6.\n		Rings = 3,\n\n		-- The distance tried only when every ring above has failed. A bedroom can\n		-- be under twenty-four studs corner to corner, and in that room NearStuds\n		-- is already through a wall -- so without this the honest rule \"never put\n		-- it within arm's reach\" quietly becomes \"never put out anything at all\",\n		-- and childhood is an empty floor. A short crawl is worse than a long one\n		-- and far better than nothing, which is the whole order of preference.\n		-- Safe range: 4-10. Must be below NearStuds or it is not a fallback.\n		FallbackStuds = 6,\n\n		-- How close counts as having got there. Generous on purpose: this is a\n		-- toddler with no jump and a wide turning circle, and a target that has to\n		-- be hit precisely would be a dexterity test at the age the player has the\n		-- least control they will ever have. Safe range: 3-7.\n		ReachStuds = 4.5,\n\n		-- How often the loop looks at where the player is. Safe range: 0.1-0.5.\n		TickSeconds = 0.25,\n\n		-- The beat between an event resolving and the next thing appearing across\n		-- the room. Not dead time: the outcome line is still on screen and the\n		-- subject of the last scene is still walking out, so this is the length of\n		-- the ending rather than a gap before the beginning. Anything much longer\n		-- and the toddler is standing in a room with nothing in it, which is the\n		-- one state this whole system exists to make impossible.\n		-- Safe range: 2-8.\n		NextSeconds = 4,\n\n		-- What is written over the thing when the event did not author a lure.\n		-- Deliberately plain and deliberately not empty: a pad with no words on it\n		-- is scenery, and a toddler who cannot tell it apart from the furniture has\n		-- nothing to do.\n		DefaultLure = \"Something over here\",\n	},\n\n	-- walkSpeed/jumpPower are Roblox defaults of 16 and 50 at the grown end.\n	-- jumpPower 0 removes jumping entirely, which is the honest version of a\n	-- body that cannot yet do it.\n	--\n	-- **Size is not here.** A band says what a body can *do*; Config.Growth above\n	-- says how big it is, continuously and for everybody, and the two were split\n	-- the day townsfolk needed the second answer without wanting the first. A band\n	-- carrying its own bodyScale meant the player grew in five visible steps and\n	-- an NPC never grew at all -- and it meant \"how tall is a two-year-old\" had two\n	-- answers in two files, which is the shape of a bug rather than of a tunable.\n	--\n	-- The bands still end at five while the curve runs to eighteen, and that is\n	-- correct: what changes between six and eighteen is your height, not whether\n	-- you can jump.\n	Bands = {\n		{ id = \"Crawl\", maxAge = 0, walkSpeed = 4, jumpPower = 0, cameraOffsetY = 0 },\n		{ id = \"Toddle\", maxAge = 1, walkSpeed = 6, jumpPower = 0, cameraOffsetY = 0 },\n		{ id = \"Walk\", maxAge = 2, walkSpeed = 8, jumpPower = 0, cameraOffsetY = 0 },\n		{ id = \"Steady\", maxAge = 4, walkSpeed = 11, jumpPower = 25, cameraOffsetY = 0 },\n		{ id = \"Run\", maxAge = 5, walkSpeed = 13, jumpPower = 35, cameraOffsetY = 0 },\n		{ id = \"Grown\", maxAge = math.huge, walkSpeed = 16, jumpPower = 50, cameraOffsetY = 0 },\n	},\n\n	-- How each band moves, keyed by band id, then by the slot names Roblox's own\n	-- Animate script uses: idle, walk, run, jump, fall, climb. A band with no\n	-- entry moves the way Roblox ships; a slot with no entry inside a band does\n	-- too, so overriding a crawl does not cost you a jump animation.\n	--\n	-- Ids may be written as a bare number or as \"rbxassetid://N\"; both are\n	-- normalised at startup, and anything else is refused there rather than\n	-- becoming a body that silently keeps standing up.\n	--\n	-- Empty because the animations are not uploaded yet -- that needs a Roblox\n	-- group to own them. This is the seam, not the content: filling in the two\n	-- commented lines below is the entire job once the group exists, and no code\n	-- changes with them.\n	--\n	--   Crawl = { idle = 0, walk = 0, run = 0 },\n	--   Toddle = { walk = 0, run = 0 },\n	--\n	-- Only the first three bands are likely to want anything. By Steady a child\n	-- walks like a short adult, which Roblox's default already is.\n	Animations = {} :: { [string]: { [string]: string | number } },\n}\n\n-- The seam between hand-authored geometry and code. An object in the Studio\n-- world becomes an event by being tagged and told which event id it carries, so\n-- the house can be rebuilt or redressed without a line of code moving.\n--\n-- The tag never decides *whether* an event fires — the engine still owns\n-- eligibility. A tagged object only says where an event may be reached.\nConfig.World = {\n	-- CollectionService tag added in the Studio Tag Editor.\n	InteractTag = \"AgesEvent\",\n\n	-- Attribute on the tagged instance holding the event id it offers, e.g.\n	-- \"childhood_first_morning\". Missing or unknown ids warn rather than\n	-- failing quietly, because a mistyped id looks exactly like a dead object.\n	InteractEventAttribute = \"EventId\",\n\n	-- Studs from the object's center that count as reaching it. Generous on\n	-- purpose: a toddler at walkSpeed 4 aiming at a flat rug should not have to\n	-- be precise, and the alternative (a Touched event) misses objects the\n	-- character never physically collides with.\n	-- Safe range: 3-12. Above ~12 objects in one room start overlapping.\n	InteractRadius = 6,\n\n	-- How often the server checks players against tagged objects. Cheap at this\n	-- scale: a handful of objects against a handful of players. Safe range:\n	-- 0.1-1. Above ~1 a toddler can cross a small object between checks.\n	InteractTickSeconds = 0.25,\n\n	-- Attribute holding the UserId of the one player a tagged object belongs to.\n	-- Hand-placed geometry leaves it off and is public: anyone who walks to the\n	-- rug may have the rug's event. A staged delivery sets it, because a letter\n	-- addressed to one player must not pay out for whoever else wanders past the\n	-- doormat first.\n	InteractOwnerAttribute = \"OwnerUserId\",\n\n	-- CollectionService tag that marks floor/wall parts as a named zone.\n	-- WorldEventService reads this and emits \"zone:{zoneId}\" into context\n	-- tags whenever a player stands inside a tagged part, so events can\n	-- prefer to fire when the player is in the right room -- gym events\n	-- when they are on the gym floor, for instance.\n	ZoneTag = \"AgesZone\",\n\n	-- Attribute on a zone-part holding its string id. The id is free-form\n	-- and becomes the tail of the context tag: a part tagged with ZoneTag\n	-- and an AgesZoneId attribute of \"gym\" emits \"zone:gym\". Unknown ids\n	-- are harmless — the picker simply sees a tag it has no event for and\n	-- moves on.\n	ZoneAttribute = \"AgesZoneId\",\n\n	-- How close the player has to be to a zone part before its id is emitted\n	-- as a context tag. Generous so a player who is in the room -- even standing\n	-- away from the tagged floor -- is \"in\" the zone. Safe range: 10-40.\n	ZoneContextRadius = 20,\n\n	-- Where staged deliveries appear. A point is an empty part in the house\n	-- tagged with DeliveryPointTag and told which mode it serves, so the mat,\n	-- the phone and the doorstep can be moved in Studio without code moving.\n	DeliveryPointTag = \"AgesDeliveryPoint\",\n\n	-- Attribute on a delivery point naming the mode it serves, matching a\n	-- Types.EventDelivery value: \"Letter\", \"PhoneCall\" or \"NPCApproach\".\n	DeliveryPointAttribute = \"DeliveryMode\",\n\n	-- Folder in ServerStorage holding real models for event subjects, each named\n	-- after the subject id it replaces -- a Model called \"dog\" takes over from the\n	-- built-in placeholder for the \"dog\" subject and nothing else changes.\n	--\n	-- The folder does not have to exist. Missing, or missing the model, is the\n	-- ordinary state and means the placeholder stands in, so a subject is never\n	-- blocked on a shopping trip. ServerStorage rather than ReplicatedStorage\n	-- because only the server ever builds one, and a model the client holds a copy\n	-- of is a model the client can read the game out of.\n	SubjectFolder = \"AgesSubjects\",\n\n	-- The same arrangement for props, and separate from the folder above rather\n	-- than shared with it because the two are different jobs: a subject is an\n	-- animal that walks in, and a prop is a rug you shove. Sharing one folder would\n	-- make \"dog\" ambiguous the first time somebody wants a toy dog.\n	PropFolder = \"AgesProps\",\n\n	-- Somewhere in the world the game can name. A place point is an empty part\n	-- tagged with PlacePointTag and told which id it answers to, and it exists\n	-- because the alternative is a table of coordinates in Luau: the moment a\n	-- wall moves in Studio, that table is a list of spots inside walls and\n	-- nothing in the game is in a position to notice.\n	--\n	-- Not a teleport network and not a fast-travel menu. It is the vocabulary a\n	-- system uses to say \"the shop floor\" -- what the debug console goes to now,\n	-- what a job will clock in at later, and what an event will one day be told\n	-- to fire at. The player still walks.\n	PlacePointTag = \"AgesPlacePoint\",\n\n	-- Attribute on a place point holding its id: \"home\", \"school\", \"store\". Ids\n	-- come from tools/world_plan.py, which is also what generates the points, so\n	-- read_house.py can hold the two to each other and fail when they disagree.\n	PlacePointAttribute = \"PlaceId\",\n\n	-- Attribute holding the human sentence for the same point, which is what a\n	-- listing prints. On the part rather than in a table here for the reason the\n	-- position is: one of the two would rot, and it would be this one.\n	PlacePointLabelAttribute = \"PlaceLabel\",\n\n	-- The id prefix both world generators use for a place point that is a *route\n	-- node* rather than a destination: a crossing, the middle of an avenue, the\n	-- corridor through the mall. Roughly 174 of the city's 382 points are these.\n	--\n	-- Here rather than open-coded in the one system that has to tell them apart,\n	-- because it is the world's own naming convention -- gen_town.py and\n	-- gen_city.py both hold to it -- and this block is already where the rest of\n	-- that convention is written down. A system that needs somewhere a player can\n	-- be *sent* (Geography's hunt is the first) must skip these: \"go to cross\n	-- street 4\" names a road marking, not a place, and being told to find one is\n	-- being told to find nothing.\n	--\n	-- If the generators ever rename the convention, this is the one line to change.\n	PlaceWaypointPrefix = \"wp_\",\n\n	-- How far above a place point a character is set down. A place point marks\n	-- the floor, and a body dropped with its middle on the floor is a body\n	-- half in it -- this is a body's own half-height plus a little air to fall\n	-- through, so the landing is a step rather than a shove.\n	-- Safe range: 3-8. Below ~3 the character can spawn inside the floor.\n	PlaceDropStuds = 4,\n\n	-- Somewhere a townsperson might be walking to. An empty part tagged with this and\n	-- nothing else -- no id, no label -- because unlike a place point it is not a spot\n	-- anything asks for by name. It is a street corner, a bench, the end of a path.\n	--\n	-- **Entirely optional.** With none of these tagged, townsfolk wander to probed spots\n	-- around the place they belong to, which works in a bare world and is what the game\n	-- does today. Tagging them is how a builder turns aimless wandering into people using\n	-- the paths that were actually built, without a line of code moving.\n	TownPointTag = \"AgesTownPoint\",\n\n	-- Sports facilities. Each interactive piece (goal, hoop, net, swing) is tagged\n	-- with SportTag and carries a FacilityKind attribute whose value is one of the\n	-- kind constants below. The code reads the tag to discover interactivity; the\n	-- kind tells it what kind of interaction to offer.\n	SportTag = \"AgesSportFacility\",\n	SportKindAttribute = \"FacilityKind\",\n	SportKind = {\n		Soccer = \"soccer\",\n		Basketball = \"basketball\",\n		Tennis = \"tennis\",\n		Playground = \"playground\",\n		Track = \"track\",\n	},\n}\n\n-- The world bringing an event to you, rather than a birthday handing it over or\n-- you walking into it. Every number here is in *real* seconds: these are pacing\n-- beats for the person playing, not durations in the world, so they must not\n-- move when the day length is re-tuned. Same reasoning as NextEventDelaySeconds.\nConfig.Ambient = {\n	-- Ambient events start the year *after* childhood ends, and the offset is\n	-- derived rather than typed twice. This is not a taste call: below and at\n	-- Childhood.EndAge, answering any event advances the year (see EventService),\n	-- so an ambient event down there would burn years two at a time and wreck\n	-- the one-event-per-year rhythm the toddler slice is built on.\n	MinAge = Config.Childhood.EndAge + 1,\n\n	-- The gap before the next ambient delivery is picked uniformly from this\n	-- window each time, so the world never arrives on a metronome. At these\n	-- values a player aging quickly meets one roughly every year and a half,\n	-- while one who lingers gets MaxPerYear and then quiet.\n	-- Safe range: 45-600, and Min must stay below Max.\n	MinSecondsBetween = 90,\n	MaxSecondsBetween = 240,\n\n	-- Ceiling per year of life. The auto age-up net is 50 real minutes, so\n	-- without a cap a single unhurried year could carry a dozen of these.\n	-- Safe range: 1-5. Above ~5 a year stops having any quiet in it.\n	MaxPerYear = 2,\n\n	-- How often the scheduler counts down and considers staging. Coarse on\n	-- purpose: this decides when something *starts*, not whether the player has\n	-- reached it, so it does not need the interact loop's resolution.\n	-- Safe range: 0.5-5.\n	TickSeconds = 1,\n\n	-- How long a staged delivery waits before giving up, per mode. Expiry is\n	-- silent and the event is *not* marked seen, so a missed one can come back\n	-- later in the life -- missing a phone call should feel like missing a phone\n	-- call, not like a penalty screen.\n	--\n	-- 0 means it never expires on a timer. A letter on the mat is patient; it is\n	-- cleared at the next birthday instead, along with the year it belonged to.\n	-- Safe range: 0, or 20-180. Below ~20 nothing in another room is reachable.\n	ExpirySeconds = {\n		Letter = 0,\n		PhoneCall = 45,\n		NPCApproach = 60,\n	},\n\n	-- How close an NPC has to be to the player for their cast to count as\n	-- \"someone is nearby\" in context routing. A friend at the end of the\n	-- hallway should weight a friend-tagged event; a stranger across town\n	-- should not. Measured in studs from the player's root part to the NPC's\n	-- root part. Safe range: 5-30.\n	NPCContextRadius = 15,\n\n	-- Which life flags are reported as context tags when the picker is\n	-- looking for a candidate. Each string here is emitted as \"flag:{flagId}\"\n	-- so an event can say \"I prefer to fire when this flag is held\" and another\n	-- event can say \"I only fire when it is absent\" via its `forbids` field.\n	-- Only flags that appear in Config.Flags should be listed; unknown flags\n	-- silently produce no tag rather than error, because the list grows with\n	-- content and the picker must not break when a new flag is authored.\n	FlagContext = { \"sick\", \"gym_joined\", \"in_debt\" },\n}\n\n-- How the player talks to anything at all. A badge on its chest reading \"E\"; get\n-- near, it wakes up, click it or press the key and the options come up. One\n-- grammar for a person and for an animal, because learning how to talk to this\n-- world should happen once.\n--\n-- Not for a lesson. A lesson is something you are already inside rather than a thing\n-- in the room, so its questions open themselves; see SchoolService.\nConfig.Interact = {\n	-- How close the player has to be before the badge can be clicked. Generous on\n	-- purpose: this is a game partly played as a toddler at walkSpeed 4, and a\n	-- reach that demands precision would turn talking to your mother into parking.\n	-- Roughly a room's width. Safe range: 8-20.\n	ReachStuds = 12,\n\n	-- How long the badge takes to wake up when you come into range, and to settle\n	-- again when you leave. Short enough to read as a response to you rather than\n	-- an animation playing at you. Safe range: 0.1-0.4.\n	WakeSeconds = 0.18,\n\n	-- The key that does the same thing as clicking the badge, and the letter printed\n	-- on it.\n	--\n	-- Set explicitly rather than left at the ProximityPrompt default, because the\n	-- badge has to print the key that actually works, and a default that Roblox\n	-- changes one day would leave the game telling the player to press a key that\n	-- does nothing. One source, both ends.\n	KeyboardKey = Enum.KeyCode.E,\n\n	-- The universal pickup key. Everything a shift ever asks you to physically pick\n	-- up or hand off -- a shelf item, a topping, a package -- answers to this one\n	-- key rather than each task inventing its own, for the same reason E is one key\n	-- and not forty-nine: a player who has learned it once has learned it for the\n	-- rest of the game. Distinct from KeyboardKey because the two answer different\n	-- questions -- E opens a conversation, P does something with your hands -- and a\n	-- prompt that used the same key for both would leave a player unable to tell,\n	-- from the letter alone, which one they were about to press.\n	PickupKeyboardKey = Enum.KeyCode.P,\n\n	-- How far the badge and the nameplate carry, as multiples of ReachStuds.\n	--\n	-- Two numbers rather than one because they answer different questions, and the gap\n	-- between them is the whole design. The badge is *signposting* -- \"there is somebody\n	-- over there worth walking to\" -- and it should out-range the reach that makes it\n	-- clickable, or a person only announces themselves once you are standing on them. A\n	-- name is *identification*, and it is only worth reading about somebody you are\n	-- actually approaching.\n	--\n	-- The name used to carry further than the badge (3.5, so 42 studs on a town whose whole\n	-- route graph spans about 150) and drew through walls, which meant standing anywhere\n	-- outdoors put a drift of names across the screen belonging to people behind buildings\n	-- on the other side of the street. Now it is the shorter of the two: you see that\n	-- somebody is there from a long way off, and you learn who they are as you close.\n	--\n	-- Safe range: badge 2-3.5, name 1.2-2. Name below about 1.2 arrives after the badge is\n	-- already clickable, which is too late to help you choose who to walk to.\n	DotsRangeMultiplier = 2.5,\n	NameRangeMultiplier = 1.6,\n}\n\nConfig.SpeechBubble = {\n	-- What a person says while standing in front of the player, read from over their own\n	-- head. See SpeechBubble.luau -- this replaces the reply that used to sit in the HUD's\n	-- standing-next-to caption, on the same \"a person's words belong to that person\" logic\n	-- the quoted caption already used.\n	Width = 5.6,\n	Height = 1.4,\n	MaxTextSize = 16,\n	-- How high above the top of a person's own bounding box the card floats, on top of the\n	-- three-dot billboard and the nameplate already stacked there -- DOTS_LIFT (1.1) plus\n	-- NAMEPLATE_LIFT (0.95) plus the nameplate's own height in Interact.luau. Not measured\n	-- to the pixel against that stack; generous on purpose so a tall nameplate can never\n	-- clip the bottom of a reply. Safe range: 2.2-3.2.\n	LiftAboveHeadStuds = 2.7,\n	MaxDistanceStuds = 45,\n	-- How long a line holds before it fades, and how long the fade itself takes.\n	HoldSeconds = 3.5,\n	FadeSeconds = 0.25,\n	BackgroundColor = Color3.fromRGB(18, 18, 22),\n	BackgroundTransparency = 0.12,\n	StrokeColor = Color3.fromRGB(255, 255, 255),\n	-- The one color channel this card has, same rule ChoicePanel's outcome color follows:\n	-- warm when the answer was good, the panel's own color otherwise. A refusal is not an\n	-- error, so it is never colored like one.\n	GoodStrokeColor = Color3.fromRGB(120, 220, 150),\n	TextColor = Color3.fromRGB(238, 234, 226),\n	GoodTextColor = Color3.fromRGB(150, 235, 170),\n}\n\n-- Answering an event by going to the thing it is about. An enacted event puts three\n-- dots over whatever it is about -- a dog, later a vehicle or a machine -- and the\n-- player walks across to it and clicks them. The prompt stays on screen as a banner\n-- while they do: no dimming, no buttons, nothing that takes the room away, because\n-- the room is the thing being crossed.\n--\n-- The four numbers below are all that is left of a much larger system. There used to\n-- be a fan of lit discs on the floor, one per choice, each at its own bearing off the\n-- animal, and walking onto one was the answer; roughly two thirds of this file was the\n-- geometry for fitting that arrangement into a living room. It is gone. A Roblox\n-- player expects to walk up to a thing and press it, and that is now what happens.\n--\n-- What survived is the walk. That was always the mechanic and it never needed the\n-- floor.\nConfig.Enact = {\n	-- How long the dots stand before the event gives up and becomes a panel. This is\n	-- the anti-softlock: a player who cannot find the animal, cannot reach it, or\n	-- simply does not want to walk still gets their choice. Long enough to cross a\n	-- room at a toddler's walkSpeed 4 several times over.\n	-- Safe range: 30-180. 0 disables the fallback, which is only safe in testing.\n	SecondsToChoose = 75,\n\n	-- How often the server checks that an enactment is still answerable -- its subject\n	-- still in the world, its prompt still the player's, its clock not yet run out.\n	-- Nothing about answering runs on this tick: a click arrives on its own remote the\n	-- instant it happens. Safe range: 0.1-1.\n	TickSeconds = 0.25,\n\n	-- Content limits, enforced at server start rather than discovered in play. More\n	-- than MaxChoices answers is a menu rather than a decision, and a label past\n	-- MaxLabelLength wraps to three lines on a 400-stud panel and stops being\n	-- readable at a glance. Both are authoring mistakes that would otherwise look\n	-- like a bad-feeling event rather than like a mistake.\n	-- Safe range: 2-5 and 24-64.\n	MaxChoices = 4,\n	MaxLabelLength = 48,\n}\n\n-- The schema fields every event carries, regardless of delivery. These are\n-- the bounds on the fields that have bounds; the rest are validated by the\n-- content loader against their own registries (Flags, StatName, the future\n-- Ties registry phase 5 installs). See `docs/phase2_event_schema.md` and\n-- Types.LifeEvent.\nConfig.Events = {\n	-- Upper bound on `cooldown`, in real seconds. Twice the longest ambient\n	-- gap, so a cooldown never outlasts the schedule that would have asked\n	-- for the event again. Above this, an authored cooldown is almost\n	-- certainly a number written in a different unit (game months, say)\n	-- rather than a longer real window; the check at load is what catches\n	-- that before a player notices the event they expected never came back.\n	-- Safe range: 300-1200.\n	MaxCooldownSeconds = 960,\n\n	-- Per-chapter cap on delivered events, taken from lifesim_design.md:\n	-- \"1–3 events per age chapter. More than that and no single one\n	-- registers.\" The picker refuses to deliver past this in a chapter;\n	-- see EventService.PickStageable. Shift events bypass it, because a\n	-- mid-shift refusal leaves the player with nothing happening, which\n	-- is the worse failure.\n	-- Safe range: 2-5. Below 2 and a chapter feels empty; above 5 and no\n	-- single one registers, per the design.\n	MaxPerChapter = 3,\n}\n\n-- How many ambient events a player can have this chapter, gated behind the\n-- actions they actually do. The world only brings events to a player who has\n-- earned them -- by working a shift, sitting a lesson, or paying a visit -- so\n-- the life feels responsive rather than pelted. Reset to 0 at every chapter\n-- break alongside pendingEventCountInChapter.\n--\n-- MaxPerChapter here is deliberately the same number as Config.Events.MaxPerChapter:\n-- the autonomy cap and the event cap are the same ceiling, because an event\n-- that fires without a point to spend costs the player nothing and the whole\n-- point of the gate is that it costs something.\nConfig.Autonomy = {\n	-- Upper bound on autonomy points the player can hold at any one time.\n	-- Same as Events.MaxPerChapter because each point buys one ambient event,\n	-- and the event cap says there are at most this many ambient events per\n	-- chapter anyway.\n	MaxPerChapter = 3,\n}\n\n-- Answering an event by doing the thing it describes.\n--\n-- The other two resolutions both end at a list. A panel event is a list you read; an\n-- enacted one is a list you walk to first. This one has no list anywhere. The event's\n-- answers are objects laid out in the room -- a rug, a puddle, a cookie -- and the\n-- answer is given by crawling to one, shoving one, picking one up and carrying it\n-- somewhere, or by holding still and letting the moment pass.\n--\n-- Childhood is what this was built for and childhood is the whole argument for it. A\n-- toddler cannot read. Every one of the first five years was, until now, a paragraph\n-- and three sentences to click, which is the one interface a two-year-old is least\n-- equipped to use and the first thing a new player is ever handed.\n--\n-- Everything below is either a tolerance or a tuning on how forgiving the verbs are.\n-- None of it decides what any event means; that is authored on the choice, in its\n-- act. See Types.ChoiceAct.\nConfig.Props = {\n	-- How long the props stand before the event gives up and becomes a panel. The\n	-- same anti-softlock as Enact.SecondsToChoose and set higher for the obvious\n	-- reason: clicking three dots is one walk, and carrying a cookie across a room to\n	-- somebody is several. A player who cannot work out what to do still gets to\n	-- answer.\n	-- Safe range: 45-240. 0 disables the fallback, which is only safe in testing.\n	SecondsToChoose = 110,\n\n	-- How often the server asks whether anything has been done yet. Faster than the\n	-- enactment tick and deliberately so: that one watches for a slow failure, and\n	-- this one is the input. At 0.25 a child who crawls over a prop's edge and out the\n	-- far side can cross its whole reach between two checks and answer nothing, which\n	-- reads exactly like the prop being broken.\n	-- Safe range: 0.05-0.2. Below 0.05 is spending a frame budget on a distance check.\n	TickSeconds = 0.1,\n\n	-- How far a prop is put from the player when its act does not say. Far enough that\n	-- reaching one is a decision rather than a step. Safe range: 6-20.\n	DefaultDistance = 12,\n\n	-- Total angle the set is laid out across, and how many base bearings are tried\n	-- within it before giving up. The set picks one direction with room in it and\n	-- every prop's offsetDegrees is measured from there, so an authored arrangement\n	-- keeps its shape wherever in the house it lands -- the rug stays between the\n	-- child and the toy whichever way the child happens to be facing.\n	-- Safe range: 180-360 and 8-24.\n	ArcDegrees = 360,\n	Bearings = 16,\n\n	-- How far round from its authored bearing a single prop may slide when its own\n	-- spot is inside a wall, and in how many steps. The set's shape bends before the\n	-- set is abandoned, because a rug two feet to the left of where it was written is\n	-- still the event, and a panel is not. Safe range: 20-70 and 2-6.\n	NudgeDegrees = 40,\n	NudgeSteps = 4,\n\n	-- How close a prop may be staged to another in the same set, measured centre to\n	-- centre. Below this the player reaching one is inside the reach of both, and the\n	-- event answers itself with whichever the loop happened to check first.\n	-- Safe range: 4-12.\n	MinSeparationStuds = 6,\n\n	-- Stay: how long the player has to hold still, and what counts as still. The\n	-- seconds are the mechanic -- a child waiting to be picked up is doing something,\n	-- and it should feel like a decision to keep doing it rather than like a pause.\n	-- The speed is a tolerance for a thumbstick drifting, not permission to walk.\n	-- Safe range: 1.5-5 and 0.5-3.\n	StayStillSeconds = 2.6,\n	StillSpeedStuds = 1.5,\n\n	-- Push: how far the prop has to travel from where it started before that counts as\n	-- having moved it, and how much of the player's shove it yields to. Below about\n	-- 1.5 studs a player who walks past it has answered by accident. The share being\n	-- under 1 is what makes it feel like weight rather than like a thing stuck to your\n	-- chest. Safe range: 1.5-6 and 0.3-0.9.\n	PushStuds = 3,\n	PushShare = 0.55,\n\n	-- Carry: how far in front of the player the carried thing rides, and how high up it\n	-- as a fraction of their own height. A toddler carries something in both arms in\n	-- front of them, which is also the only place the player can still see it.\n	--\n	-- There is deliberately no smoothing number here. The carried thing is welded to\n	-- the character rather than moved from the server tick, so it is already exactly as\n	-- smooth as the player is, and a catch-up rate would only be able to make it worse.\n	-- Safe range: 1.2-3 and 0.5-2.5.\n	CarryAheadStuds = 1.8,\n	CarryHeightFraction = 0.62,\n\n	-- How long the set is out and readable before any of it will take an answer. Not a\n	-- polish number: without it a Stay is answered by the player doing what every\n	-- player does for the first few seconds of a new prompt, which is stand still and\n	-- read it. The banner has to be readable before standing still can mean anything,\n	-- or the one answer that requires no action is the one nobody chooses on purpose.\n	--\n	-- It covers every verb rather than only Stay, because a prop that lands within\n	-- reach of where the player is already standing would otherwise answer the event on\n	-- the frame it appeared. The labels wake and dim normally throughout -- the set is\n	-- alive to look at, just not yet to answer.\n	-- Safe range: 1.5-4. Below about 1.5 a slow reader answers by accident; above 4 the\n	-- player has already walked to something and is waiting on the game.\n	GraceSeconds = 2.5,\n\n	-- How long the set stays in the room after it has been answered. Short, and not\n	-- zero: a rug that vanishes on the frame it finally gives way takes the answer\n	-- with it, and the player is left reading an outcome about a thing they never saw\n	-- happen. Long enough to watch it finish moving.\n	-- Safe range: 0.8-3. Above about 3 the next event is already being staged.\n	LingerSeconds = 1.6,\n\n	-- The label over a prop: how much further away it can be read than the prop can be\n	-- reached, and how much bigger it gets when you are close enough to use it. Both\n	-- mirror Interact's dots, and mirror them on purpose -- a player should learn one\n	-- rule about when a thing in this world is ready for them, not two.\n	-- Safe range: 1.5-4 and 1.05-1.4.\n	LabelDistanceMultiplier = 2.5,\n	LabelNearScale = 1.18,\n\n	-- Content limit, enforced at server start. A label past this wraps over the prop it\n	-- is meant to be naming. Shorter than Enact.MaxLabelLength because this one is read\n	-- in the world at distance rather than on a panel a foot from your eyes.\n	-- Safe range: 16-40.\n	MaxLabelLength = 32,\n}\n\n-- The thing the event is about, standing in the room. An event that names a\n-- subject spawns it when the prompt opens, walks it in, and takes it away again\n-- when the prompt is done with.\n--\n-- This is the half of an event that was previously only a sentence. \"There is a\n-- dog. It is at least as tall as you are, and it has noticed you\" was, until now,\n-- a description of an animal that was not there. It is also what enactment needs:\n-- three dots have to hang over something, and the subject is that something.\n--\n-- Best-effort throughout, on the same terms as enactment: a room with nowhere to\n-- put the animal simply doesn't get one. A subject may never be the reason an\n-- event cannot be answered, so every failure below is silent and ordinary.\nConfig.Scene = {\n	-- How close the subject settles to the player, measured to its *near edge* --\n	-- the scene adds the subject's own half-length, so one number here is right for a\n	-- cat and a dog alike.\n	--\n	-- Derived rather than typed, because it is a constraint and not a taste call: it\n	-- must come to rest outside arm's reach, or the event answers itself from where the\n	-- player is already standing. That is the failure this number exists to prevent --\n	-- the dog trots in, stops inside Interact.ReachStuds, and its dots are clickable\n	-- before the player has taken a step. The walk to the animal is the mechanic, and a\n	-- walk of zero studs is a panel with extra steps.\n	--\n	-- The four studs on top are what makes the walk read as one. Below about two the\n	-- animal is close enough that a player who was already drifting forward arrives\n	-- without meaning to. Safe range: ReachStuds + 3 to ReachStuds + 8; larger fails to\n	-- place indoors more often, because the room has to hold it.\n	ApproachStuds = Config.Interact.ReachStuds + 4,\n\n	-- How far beyond its resting place the subject appears, i.e. the length of the\n	-- walk in. This is the whole performance: something that materializes at its\n	-- final position has not arrived, it has popped. Safe range: 4-16. Larger\n	-- needs a bigger room and fails to place more often.\n	WalkInStuds = 8,\n\n	-- Retried once at this fraction of the walk-in when the full length won't fit,\n	-- for the reason Enact.SpreadSteps exists: a house is not a field. Below\n	-- ~0.3 the walk is over before it reads. Safe range: 0.3-0.9.\n	RetryWalkInScale = 0.5,\n\n	-- Total angle in front of the player that resting places are searched across,\n	-- and how many bearings are tried within it. Centered on the way the player is\n	-- facing, so the subject arrives where they are already looking.\n	-- Safe range: 60-200 and 3-15. More bearings costs three probes each.\n	ArcDegrees = 120,\n	Bearings = 7,\n\n	-- How much of the remaining turn the subject closes each frame while it faces\n	-- the player, 0-1. Low is a slow head-turn, 1 snaps. Same reasoning as\n	-- NPC.LookResponsiveness -- an animal that tracks you perfectly is a turret.\n	-- Safe range: 0.05-0.4.\n	TurnResponsiveness = 0.12,\n\n	-- How long the subject holds its reaction to the answer before it leaves. It\n	-- runs under the outcome the player is reading, so it wants to be close to\n	-- UI.EventOutcomeSeconds -- an animal that vanishes on the click undoes the\n	-- whole reason it walked in. Safe range: 0-8. At 0 it disappears mid-sentence.\n	--\n	-- Time spent walking is on top of this rather than inside it: an approach and\n	-- the walk out are journeys the player watches, not part of the pause, so a\n	-- subject that comes over stays a couple of seconds longer than one that does\n	-- not. That is deliberate -- it is also the answer that earned it.\n	LingerSeconds = 4,\n\n	-- How close an approaching subject comes, edge to edge. The scene adds the\n	-- player's own body radius and the animal's half-length, so one number here is\n	-- right for a toddler meeting a dog and an adult meeting a cat alike.\n	--\n	-- Safe range: 0.5-4. Below half a stud the animal is standing inside the player,\n	-- and past four it has not really come to them. Measured from wherever the player\n	-- is when they answer, which is next to the animal rather than where the prompt\n	-- opened -- so this is a small step on top of an already short distance.\n	ReactionCloseStuds = 1.5,\n\n	-- How often a scene checks that it is still wanted. Only bounds how quickly a\n	-- subject clears after the prompt it belongs to has gone, so it can be coarse.\n	-- Safe range: 0.1-1.\n	TickSeconds = 0.25,\n}\n\n-- Roblox asset ids, kept together because they are the one class of value that\n-- cannot be decided from here: an id has to be picked in Studio or uploaded to\n-- an account, and a wrong one fails at runtime rather than at build.\n--\n-- An empty string means \"not chosen yet\" and is handled everywhere it is read --\n-- the phone simply rings silently rather than erroring on a made-up id. That is\n-- deliberate: a placeholder id that happens to resolve to someone else's asset\n-- is far worse than no sound. Fill these in from the Studio asset picker.\nConfig.Assets = {\n	Sounds = {\n		PhoneRing = \"rbxassetid://123456789\",\n		LetterArrive = \"rbxassetid://123456789\",\n		DoorKnock = \"rbxassetid://123456789\",\n	},\n\n	-- Animation ids for visitors. Empty means the rig falls back to standing\n	-- still, which looks wrong on purpose -- a visibly unfinished NPC is better\n	-- than one that silently never animates and is assumed to be working.\n	-- Greet and Talk are one-shot; Idle and Walk are looped and cross-faded.\n	Animations = {\n		NPCIdle = \"rbxassetid://123456789\",\n		NPCWalk = \"rbxassetid://123456789\",\n		NPCGreet = \"rbxassetid://123456789\",\n		NPCTalk = \"rbxassetid://123456789\",\n	},\n}\n\n-- Visitors: the people the world can send to your door. Movement is a straight\n-- walk from the doorstep to a waiting spot, with no pathfinding graph -- the\n-- simplest version that is honest about what it does, flagged here because the\n-- moment a visitor has to cross a cluttered room it will need replacing with\n-- PathfindingService.\nConfig.NPC = {\n	-- How far in from the door a visitor comes before waiting. Far enough to be\n	-- indoors and clear of the door swing, close enough that they are not\n	-- standing in the middle of the room. Safe range: 3-10.\n	ApproachStuds = 6,\n\n	-- Slower than a player on purpose: someone arriving at your door is not in a\n	-- hurry, and it gives the walk time to read. Safe range: 6-16.\n	WalkSpeed = 9,\n\n	-- Seconds allowed for a walk in or out before the rig is removed regardless.\n	-- Movement can stall against geometry, and a visitor frozen in the hallway\n	-- forever is worse than one who quietly gives up. Safe range: 4-20.\n	WalkTimeoutSeconds = 8,\n\n	-- Head tracking. This is the whole difference between a mannequin and a\n	-- person and it costs no assets at all, so it runs even before a single\n	-- animation id has been filled in above.\n	-- LookTickSeconds safe range: 0.03-0.2 -- above ~0.2 the head visibly steps.\n	LookTickSeconds = 0.06,\n	-- Past these a real person turns their body rather than their neck, so the\n	-- head clamps instead of swivelling like an owl. Degrees.\n	-- Safe range: 40-90 and 15-40.\n	LookMaxYawDegrees = 70,\n	LookMaxPitchDegrees = 25,\n	-- How much of the remaining angle the head closes each tick, 0-1. Low is\n	-- languid, 1 snaps instantly. Safe range: 0.05-0.4.\n	LookResponsiveness = 0.18,\n\n	-- How far away a visitor bothers tracking the player at all. Beyond this\n	-- they face front. Safe range: 10-60.\n	LookMaxDistance = 30,\n\n	-- How long a visitor stays talking after the player reaches them, before\n	-- turning to leave. Runs underneath the prompt the player is reading, so it\n	-- wants to be close to how long that takes -- see UI.EventOutcomeSeconds.\n	-- Safe range: 0-8. At 0 they turn on their heel mid-sentence.\n	TalkBeatSeconds = 3,\n\n	-- What has to fit for a visitor to stand somewhere. Nominal rather than measured,\n	-- because anything looking for a place to put one has to ask before the avatar\n	-- exists -- building it is a web-backed call, and spawning a person in order to\n	-- discover there was nowhere for them to go is the wrong order to do it in.\n	--\n	-- Deliberately a little larger than any cast member actually is, so the error is\n	-- a spot rejected rather than a parent standing in a wall. Radius, so it is the\n	-- same measurement Ground.BodyRadius returns for a player.\n	-- Safe range: 1-2 and 5-7.\n	BodyRadius = 1.4,\n	BodyHeight = 5.8,\n\n	-- One leg of a computed path. Bounds a *waypoint*, not a journey, so it is much\n	-- shorter than WalkTimeoutSeconds above: waypoints are a few studs apart and one that\n	-- has not been reached in this long means the walk is wedged rather than slow. Timing\n	-- out abandons the whole path, which is the self-healing case -- the walker pauses and\n	-- picks somewhere else instead of grinding against whatever stopped them.\n	-- Safe range: 1.5-8.\n	WaypointTimeoutSeconds = 3,\n\n	-- Turning on the spot to look at somebody who has walked up.\n	--\n	-- Separate from the head tracking above and doing a different job: the neck says \"I\n	-- have noticed you\", the body says \"I have stopped what I was doing\". A person who\n	-- only ever did the first, with their back to you through a whole conversation, is the\n	-- single most mannequin thing a rig can do.\n	--\n	-- TurnResponsiveness is how much of the remaining angle is closed each tick, 0-1.\n	-- Safe ranges: 0.03-0.2, 0.05-0.5, 1-15.\n	TurnTickSeconds = 0.05,\n	TurnResponsiveness = 0.16,\n	-- Within this many degrees of facing them, stop stepping. Not zero, because easing\n	-- toward an angle never quite arrives and a rig that never stops nudging is a rig that\n	-- jitters forever.\n	TurnDoneDegrees = 2,\n}\n\nConfig.Stats = {\n	Min = 0,\n	Max = 100,\n	WarningThreshold = 15,\n\n	Starting = {\n		health = 100,\n		happiness = 70,\n		smarts = 50,\n		looks = 50,\n	},\n\n	-- Flat decay applied once per in-game year.\n	DecayPerYear = {\n		health = 1,\n		happiness = 1,\n		smarts = 0,\n		looks = 1,\n	},\n\n	-- Decay is multiplied by this once age crosses ElderDecayStartAge.\n	ElderDecayStartAge = 60,\n	ElderDecayMultiplier = 3,\n}\n\n-- Money. Arrives with the world because this is the first build in which there is\n-- both something to earn it from and something to spend it on.\n--\n-- The scale every authored price is measured against, written down here because\n-- content carries the prices and nothing else records what they are supposed to\n-- mean: an adult hour of ordinary work is worth about twenty of these. So a small\n-- child's pocket money is single digits, a teenager's weekend is tens, a month of\n-- adult wages is low thousands, and anything above five figures is a life event\n-- rather than a purchase. Realistic numbers on purpose -- a player who recognizes\n-- what a week's wages feels like is a player who can feel a price.\nConfig.Money = {\n	-- What a life begins with. Zero because you are born owning nothing, and because\n	-- every unit in the game should be traceable to something that happened in it.\n	--\n	-- Read through MoneyService.StartingBalance rather than used directly anywhere,\n	-- and that indirection is the whole point: it is the one seam inherited money\n	-- has to slot into. A life born into a family with something behind it changes\n	-- what that function returns, and nothing downstream of it needs to know.\n	-- Safe range: 0-1000. Past that an ordinary first life starts solvent, which\n	-- takes the meaning out of the first thing the player earns.\n	StartingBalance = 0,\n\n	-- Ceiling on a balance. Not a game rule -- no authored content comes within\n	-- several orders of magnitude of it -- but a guard, so that a payout loop\n	-- introduced by a future bug produces a visibly pinned balance rather than a\n	-- number too large to draw, or one large enough that integer arithmetic quietly\n	-- stops being exact. Comfortably below 2^53, where that would start.\n	-- Safe range: 1e6-1e12.\n	MaxBalance = 1e9,\n}\n\n-- Money you are given for being a child. The first income in a life, and the only\n-- one that arrives without being earned.\n--\n-- Quoted weekly and paid yearly, which is not a compromise but the honest shape of\n-- the thing. \"You get five a week\" is what an allowance is called by everyone who\n-- has ever had one, and a birthday is the only clock the game currently has to pay\n-- it out on -- so the rate is weekly, the grant is a year of it, and the player is\n-- told both.\n--\n-- Scaled with age on purpose. A seventeen-year-old on a five-year-old's allowance\n-- is a joke about being treated like a child, and a number that climbs every\n-- birthday is the cheapest way there is to make a birthday feel like a promotion.\nConfig.PocketMoney = {\n	-- The first birthday that pays. Below this a child has nothing to spend it on\n	-- and no sense that it is theirs. The same age as ManualAgeUpMinAge, so the year\n	-- the player takes the wheel is the year they are handed something to steer\n	-- with -- but written out rather than derived from it, because the two would\n	-- move for entirely different reasons.\n	-- Safe range: 3-8.\n	StartAge = 5,\n\n	-- The last birthday that pays. After this you are expected to earn it and wages\n	-- take over. Safe range: 15-18.\n	EndAge = 17,\n\n	-- Dollars per week, per year of age: at 1 a ten-year-old gets ten a week. The\n	-- scale to judge it against is the note above Config.Money -- an adult hour of\n	-- ordinary work is worth about twenty -- which puts a whole childhood at this\n	-- rate somewhere around seven thousand: real money to a child, a rounding error\n	-- to an adult, which is the shape it should have.\n	-- Safe range: 0.5-3. Above about 3 a teenager doing nothing out-earns a first\n	-- job, and the first wage packet stops meaning anything.\n	WeeklyPerYearOfAge = 1,\n\n	-- What being close to the parent bringing it is worth, as a share added on top.\n	--\n	-- Which parent turns up alternates by age, and this reads that same parent's bond --\n	-- so a childhood spent going and seeing your mother pays better on even years, and\n	-- the player works that out from the number rather than from being told. It is the\n	-- first place a bond turns into anything, years before a job reference could.\n	--\n	-- Only ever adds. A parent who barely speaks to you still hands over the full\n	-- allowance, because docking a child's pocket money for not visiting would be a\n	-- punishment stacked on the loss itself -- and \"failure worth playing\" means a\n	-- neglected childhood is poorer than it could have been, not one that cannot afford\n	-- to be a childhood.\n	--\n	-- At 0.5, a bond at the ceiling is worth half as much again -- roughly a thousand\n	-- across a childhood, which buys something and does not rewrite the economy.\n	-- Safe range: 0-1. Above 1 the allowance is mostly the relationship.\n	BondBonusShare = 0.5,\n\n	-- How the money actually reaches the player: a parent appears somewhere in the\n	-- room, walks over and hands it to them.\n	--\n	-- Not a cutscene, and that is a rule rather than a shortcut. Nothing in this game\n	-- takes the room away from the player -- an enacted prompt is a banner precisely\n	-- so it cannot -- and a birthday happens thirteen times in a childhood, which\n	-- makes it the very worst place to start seizing the camera. They come to you,\n	-- you keep control, and the scene reads as a scene because a person crossed a\n	-- room to find you.\n\n	-- How far off a parent appears, and the drawn-in second attempt for a room that\n	-- cannot hold the first. Far enough that the walk is visible and reads as someone\n	-- arriving, close enough to fit in a real room of this house.\n	--\n	-- Two attempts rather than a search, which is what EnactService and SceneService\n	-- both do and for the same reason: the difference between the two is the\n	-- difference between a room and a corner, and every value in between buys a scene\n	-- that is slightly worse for nobody's benefit. The retry was measured rather than\n	-- guessed -- at the full distance alone a parent can be staged in 54% of this\n	-- house, and with the retry in 83%, nearly all of the difference upstairs where no\n	-- bedroom is fourteen studs across.\n	--\n	-- Safe range: 8-20 and 0.4-0.8. Above about 20 nothing indoors can hold the first\n	-- attempt. Below about 0.4 the second one arrives already at arm's length, which\n	-- is a parent appearing beside you rather than coming to find you -- worse than\n	-- the fallback, which at least does not pretend to be a scene.\n	SpawnStuds = 14,\n	RetrySpawnScale = 0.5,\n\n	-- The arc around the player's facing they may appear in, and how many bearings\n	-- are tried inside it. Much wider than a subject's, because a parent is a person\n	-- who lives here and may perfectly well come from behind you -- unlike a dog,\n	-- which has to be seen arriving or it has teleported.\n	-- Safe range: 120-360 and 5-16.\n	ArcDegrees = 300,\n	Bearings = 9,\n\n	-- How close they get before handing it over. Measured between middles, so this\n	-- is roughly arm's length once both bodies are accounted for.\n	-- Safe range: 2-6. Below about 2 they walk into the player trying to reach it.\n	HandoverStuds = 4,\n\n	-- How long they stay after handing it over, before turning to leave. The money\n	-- is floating over their hands during this, so it is really \"how long the number\n	-- is readable with the person who gave it to you still standing there\".\n	-- Safe range: 1-6.\n	LingerSeconds = 3,\n\n	-- How often the chase re-aims at the player and checks whether it has arrived.\n	-- Safe range: 0.1-0.5. Above ~0.5 a walking player visibly out-runs the aim.\n	TickSeconds = 0.25,\n\n	-- How often the server looks for anyone still owed money and tries again. Only\n	-- ever runs for a player whose ledger is not empty, which is rare.\n	-- Safe range: 10-120.\n	RetrySeconds = 25,\n\n	-- Failed handovers before the money is simply credited where the player stands.\n	--\n	-- This is the panel-fallback of this feature and it has to exist: a player whose\n	-- corner cannot hold a parent must still be paid, because an allowance that never\n	-- arrives is indistinguishable from a broken game. Not the good version, and\n	-- never a silent failure.\n	-- Safe range: 1-6. At 1 there is no second chance at the good version.\n	MaxAttempts = 3,\n}\n\n-- Work. The first money in a life that is neither given nor found, and the reason\n-- the workplace was built at the far end of the street rather than bolted to the\n-- house: a wage should cost a walk.\n--\n-- The numbers here are shape, not price. What a job pays is authored per job in\n-- content/Jobs.luau as a yearly salary, and every rate the game actually uses is\n-- divided back out of that -- so a wage can be retuned in one place, by a person\n-- reading a figure they can judge, without a second number left disagreeing.\nConfig.Work = {\n	-- A shift, in game hours. At RealSecondsPerGameHour (30) this is the four\n	-- real minutes a shift was designed around: long enough to be a stretch of\n	-- time you decided to spend, short enough to sit inside one sitting.\n	-- Safe range: 4-12. Below ~4 a shift is a button press; above ~12 it outlasts\n	-- the patience of anyone not already being paid.\n	ShiftGameHours = 8,\n\n	-- Shifts in a working year. Working all of them earns exactly the job's\n	-- authored yearly salary, which is the entire reason this number exists: it\n	-- is the divisor that turns a salary a person can judge into an hourly rate\n	-- the game can pay out.\n	--\n	-- Also the year's ceiling. Not a punishment but the thing that keeps a salary\n	-- meaningful -- without it, \"8,000 a year\" describes nothing, because the\n	-- answer to \"how much can I earn?\" would be \"how long can you stand there?\".\n	-- Safe range: 3-10. Higher makes a year of work a grind; lower makes each\n	-- individual shift carry so much of the salary that missing one hurts.\n	ShiftsPerYear = 5,\n\n	-- How near a job's place point you must be to clock on. Small, because\n	-- clocking in should be a thing you did rather than a thing that happened to\n	-- you while walking past.\n	-- Safe range: 4-10.\n	ClockInRadiusStuds = 6,\n\n	-- How far you may roam from that point while still counted as working.\n	-- Deliberately room-sized rather than a dot: standing to attention for four\n	-- minutes is not a job, and the shop floor was built to be walked around.\n	-- Leaving this radius clocks you out.\n	-- Safe range: 12-40. Below ~12 the shop floor itself would clock you out;\n	-- above ~40 you could leave the building and still be drawing a wage.\n	StationRadiusStuds = 24,\n\n	-- How often the shift clock is read. Wages are credited per completed game\n	-- hour regardless, so this only sets how promptly leaving your station is\n	-- noticed and how smoothly the HUD moves.\n	-- Safe range: 0.1-1.\n	TickSeconds = 0.25,\n\n	-- The window, in game hours into a shift, within which the shift's one moment\n	-- can fire. Not at the start, because a thing that happens the instant you\n	-- clock on reads as a cutscene attached to the button; not at the very end,\n	-- because an event still open when the shift runs out is a question you\n	-- answer after the fact.\n	-- Safe range: 1 to ShiftGameHours - 1, low below high.\n	EventEarliestGameHour = 2,\n	EventLatestGameHour = 6,\n	-- Allow work-from-home jobs whose placeId points to a suburb house.\n	-- When false, home-based jobs are silently excluded from the job posts.\n	HomeJobAllowed = true,\n}\n\n-- The corner shop. A place with aisles and a counter, and a job that asks you\n-- to walk them in order rather than stand at one spot and click.\n--\n-- The swap contract: the generator stamps these tags on the parts that exist in\n-- the floor plan, and the service reads by tag rather than by name. A rebuild\n-- that swaps CounterBase for a different mesh keeps working because the tag is\n-- what the service looks for, not the part's name.\nConfig.Shop = {\n	-- The tagged parts the service uses to resolve fetch-and-bag geometry.\n	-- Each is a CollectionService tag; the attribute on the part says which zone\n	-- it is, so one tag covers every instance across every shop in the game.\n	CounterTag = \"AgesShopCounter\",\n	ShelfTag = \"AgesShopShelf\",\n	CrateTag = \"AgesShopCrate\",\n	ChillerTag = \"AgesShopChiller\",\n	QueueTag = \"AgesShopQueue\",\n\n	-- The attribute name read off every tagged part to learn which zone it is.\n	-- Values are \"counter\", \"shelf_food\", \"shelf_chilled\", \"crate\", \"queue\".\n	ShopZoneAttribute = \"ShopZone\",\n\n	-- Fetch-and-bag tuning. The corner shop's signature rhythm.\n	FetchBag = {\n		-- How many items a customer orders, per task. Randomised between these\n		-- bounds so a shift is not a metronome of identical lengths.\n		MinItems = 2,\n		MaxItems = 4,\n		-- How many items the player can carry in their basket at once. Starts at\n		-- one and grows with standing, but the config sets the baseline.\n		BaseBasketSize = 1,\n		-- How long the customer's patience bar runs, in real seconds. A full order\n		-- should be doable in well under this; the bar is a pressure dial, not a\n		-- soft lock.\n		PatienceSeconds = 45,\n		-- How much of the base tip survives when patience is half spent. At 0.5\n		-- a patient customer tips normally and an impatient one still leaves\n		-- something on the counter rather than nothing at all.\n		TipFloorAtHalfPatience = 0.5,\n		-- What the customer might ask for. Each entry is a grocery name that the\n		-- order resolver picks from at random. Kept short so every name reads as\n		-- something a person would actually say at a till.\n		Items = {\n			\"bread\",\n			\"milk\",\n			\"eggs\",\n			\"butter\",\n			\"cheese\",\n			\"apples\",\n			\"bananas\",\n			\"cereal\",\n			\"coffee\",\n			\"tea\",\n			\"sugar\",\n			\"flour\",\n			\"rice\",\n			\"pasta\",\n			\"soup\",\n			\"sandwich\",\n			\"chips\",\n			\"yogurt\",\n			\"carrots\",\n			\"oranges\",\n		},\n	},\n}\n\n-- Being hired, as opposed to working. Two different things that used to be one:\n-- standing near the counter used to hire you and clock you on in the same silent\n-- motion, so the moment a life gains its first job passed without being a moment at\n-- all. Now the workplace advertises, and taking the job is something you walk onto.\nConfig.Work.Hiring = {\n	-- How close to the hire pad counts as stepping on it. Smaller than\n	-- ClockInRadiusStuds on purpose, and that gap is the whole design: you can be\n	-- near enough to work at a counter you already work at without being near enough\n	-- to accidentally take a job you never chose.\n	-- Safe range: 2-5, and must stay below ClockInRadiusStuds or being hired and\n	-- clocking on collapse back into one event.\n	PadRadiusStuds = 3,\n\n	-- How high the hiring sign floats above the job's place point. Head height and\n	-- then some, so it reads as a sign over a counter rather than as something lying\n	-- on it.\n	-- Safe range: 3-8.\n	SignLiftStuds = 5,\n\n	-- How far away the sign is still drawn. Larger than a choice label's range,\n	-- because this one has a different job: a choice label is read once you have\n	-- arrived, and this is read to decide whether to walk over at all.\n	--\n	-- This was 160, chosen to be \"legible from the far end of the street\", and the\n	-- street turned out to be the wrong unit. Measured against the town: the median\n	-- place point has **31 other place points within 160 studs, and the worst has\n	-- 49** -- every job in the game. Signs are AlwaysOnTop, so all of them draw\n	-- through the buildings between, and standing anywhere in town meant reading\n	-- thirty overlapping NOW HIRING cards stacked through the walls. A sign that is\n	-- always on screen is wallpaper, and wallpaper is not signposting.\n	--\n	-- 45 is 2.5x the 18-stud median gap between neighbouring place points, so it\n	-- reaches the shop you are outside and its immediate neighbours -- a median of 3\n	-- at once, worst case 6 -- and stops there. Re-measure with the block in\n	-- tools/check_town.py if the generator's frontage spacing changes; this number is\n	-- a multiple of that spacing, not a distance somebody liked the look of.\n	-- Safe range: 40-70. Below ~40 you have to already be inside to learn the shop\n	-- is hiring, which is the problem this exists to fix; above ~70 the stacking\n	-- starts again.\n	SignMaxDistanceStuds = 45,\n\n	-- How many years before a job's minAge its sign starts appearing.\n	--\n	-- The signs used to be pushed to every living player at every age, which is how\n	-- a one-year-old ended up surrounded by job adverts. But hiding them until the\n	-- birthday you qualify is the opposite mistake, and the reason is already written\n	-- into postsFor: \"a job that is invisible until the year you qualify is a job\n	-- nobody plans for.\"\n	--\n	-- 4 is that comment's own example made into a number -- a twelve-year-old walking\n	-- past the shop and learning it hires at sixteen. So the signposting survives\n	-- intact and only stops reaching the ages that could not act on it under any\n	-- circumstances.\n	-- Safe range: 2-6. At 0 the sign is news you can do nothing with; above ~6 a\n	-- child is being advertised at again.\n	SignLeadYears = 4,\n}\n\n-- House ownership. Suburb homes a player can buy and use as a workplace.\n--\n-- All data is per-life, resetting on death just like money and bonds. A life\n-- that dies with a house leaves no inheritance -- the property vanishes with\n-- the slot, and the new life starts with nothing.\nConfig.House = {\n	-- Price to buy one suburb house. Single-digit thousands, so a teen can\n	-- afford it after a year of part-time work, but not so cheap that it's\n	-- meaningless.\n	BuyPrice = 5000,\n	-- Maximum houses a single life can own at once. One is the intended\n	-- experience -- a home base to return to -- but two or three won't break\n	-- anything for players who want property investment.\n	MaxPerPlayer = 1,\n	-- Fraction of BuyPrice returned when selling. Seven-tenths encourages\n	-- buying and selling as a cycle rather than hoarding; the 30% loss is\n	-- the cost of ownership, like property tax in the real world.\n	ResaleFraction = 0.7,\n}\n\n-- Apartment entrance doors. Every door is a tagged part in the generated world;\n-- ApartmentDoorService attaches the open/close interaction and swings it on a\n-- tween rather than teleporting the part, so walking up to a block reads as\n-- entering a building and not clipping through a wall.\nConfig.ApartmentDoor = {\n	-- How far the door swings open, in degrees, about its hinge edge. 90 is a\n	-- push-open door standing fully clear of the frame; more than that and it\n	-- would swing back past the wall it is hinged to.\n	-- Safe range: 60-100.\n	SwingDegrees = 90,\n	-- How long the open/close tween takes, in seconds. Quick enough that\n	-- walking through does not feel like waiting on the door, slow enough\n	-- that the swing reads as a door and not a flicker.\n	-- Safe range: 0.2-0.6.\n	AnimationSeconds = 0.4,\n}\n\n-- The car dealership queue. Runs alongside the work shift at auto_dealer so the place\n-- feels alive even when nobody is on the clock -- customers line up at the showroom and\n-- the player can serve them whether they are working there or just walking past.\nConfig.CarDealer = {\n	-- How many customers wait in line at once. More than three is a chore; two is a\n	-- conversation.\n	-- Safe range: 2-4.\n	MaxQueue = 3,\n	-- How long between one customer arriving and the next, in real seconds. Staggered\n	-- so the queue builds visibly rather than appearing full all at once.\n	-- Safe range: 8-20.\n	CustomerGapSeconds = 12,\n	-- How often the service ticks to check for new arrivals and advance the queue.\n	-- Safe range: 1-3.\n	TickSeconds = 2,\n	-- What a walk-in tip is worth, as a share of what the counter's own job pays for\n	-- the same stretch of time. A share rather than a price, because a price here was\n	-- how the dealership came to out-earn employment at it.\n	--\n	-- The flat 100 this replaces was worth more per minute than the job: car_salesperson\n	-- is 8,000 a year, which Work.YearGameHours divides to 200 a game hour, and a game\n	-- hour is 30 real seconds -- 2.5 customers at CustomerGapSeconds. So the counter paid\n	-- 100 x 2.5 = 250 a game hour to a passer-by and 200 to the person employed there,\n	-- and unlike the job it had no yearly ceiling. Work.ShiftsPerYear exists precisely so\n	-- that \"how much can I earn?\" is not answered with \"how long can you stand there?\",\n	-- and this was answering it that way.\n	--\n	-- A quarter, because a walk-in is a tip and not a commission: real money for a real\n	-- favour, never a reason to skip the shift. The arithmetic is done in CarDealerService\n	-- off Jobs.HourlyRate, so a content author who retunes the salary retunes this with it\n	-- and no second number is left disagreeing.\n	-- Safe range: 0.1-0.5. Above ~0.5 standing at the counter starts to compete with\n	-- holding the job; at 0 the queue is scenery and serving it is a chore with no point.\n	WalkInTipShare = 0.25,\n}\n\n-- Look a life stage up by id and answer the age it starts at. Used to derive an\n-- age gate from the stage that actually motivates it, rather than typing the same\n-- number twice and letting the two drift. Errors rather than defaulting: a missing\n-- stage means the table above was edited, and a gate that quietly falls back to\n-- zero is the failure this is here to prevent.\nlocal function stageMinAge(id: string): number\n	for _, stage in Config.LifeStages do\n		if stage.id == id then\n			return stage.minAge\n		end\n	end\n	error(`[AGES] Config: no life stage \"{id}\" to derive an age from`)\nend\n\n-- Drivable cars. What the dealership actually sells, on top of the counter job --\n-- see content/Vehicles.luau for the cars themselves and world/VehicleChassis.luau\n-- for the physics these numbers tune.\n--\n-- **The chassis is raycast suspension, not a physical wheel.** Four rays, one per\n-- corner, each pushing a damped spring: `F = k*x - c*v`, applied through a\n-- VectorForce rather than through a collider a curb can catch. A city built of\n-- kerbs and pavements is exactly the geometry a HingeConstraint wheel gets stuck\n-- on, and the whole reason this chassis was chosen over the older, simpler one is\n-- that it does not touch the road at all -- it only ever measures the distance to\n-- it.\n--\n-- **Ownership is Roblox's own, not a custom one.** The driver's client is handed\n-- network ownership of the assembly the moment they sit down and it is handed back\n-- to the server the moment they stand up. That is the entire multiplayer story: no\n-- Server Authority migration, no clone-and-blend render, because a car -- unlike a\n-- shared ball -- has exactly one owner at a time and Roblox already solves that\n-- correctly once the seat-enter handoff is done explicitly. See VehicleService.\nConfig.Vehicles = {\n	-- How many cars a single life may own at once. More than a couple is a garage\n	-- nobody visits; the point is trading up, not collecting.\n	-- Safe range: 1-4.\n	MaxOwned = 2,\n	-- Fraction of the buy price refunded on sale, the same shape and the same\n	-- reasoning as Config.House.ResaleFraction: it makes buying and selling a\n	-- cycle instead of a one-way ratchet, and the loss is the cost of having\n	-- driven it.\n	ResaleFraction = 0.6,\n\n	-- Suspension spring stiffness, in the raycast chassis's own force units --\n	-- not a real-world spring constant, just the k in F = kx - cv. Higher holds\n	-- the body up stiffer and fights bottoming out on landings harder.\n	-- Safe range: 12000-22000.\n	SuspensionStiffness = 17000,\n	-- Damping, c in the same equation. The tutorial rule of thumb this was tuned\n	-- from -- \"damping should run about a tenth of stiffness\" -- is a starting\n	-- point, not a law: too low and the body bounces after every bump, too high\n	-- and the suspension stops absorbing anything at all.\n	-- Safe range: 1200-2600.\n	SuspensionDamping = 1800,\n	-- How far the suspension can travel before the wheel is airborne, in studs.\n	-- This is also how far a wheel hangs below the body at full droop, which is\n	-- the number that decides whether a car clears a kerb or catches on it.\n	-- Safe range: 1.2-2.2.\n	SuspensionLength = 1.6,\n	-- Wheel radius, in studs. Purely geometric -- where the raycast starts\n	-- counting from -- and it is also what the wheel model is built at, so the\n	-- two can never disagree about where the tyre actually is.\n	-- Safe range: 1.2-1.8.\n	WheelRadius = 1.4,\n\n	-- How much of a car's rated `acceleration` actually reaches the road once it\n	-- is already near top speed, 0-1. Straight-line acceleration at low speed\n	-- for the first plate; a diminishing force as it approaches topSpeedStuds is\n	-- what makes \"flat out\" mean something rather than the car just stopping\n	-- dead at a wall.\n	-- Safe range: 0.1-0.4.\n	TopSpeedTaper = 0.25,\n	-- Steering is scaled down as the car speeds up, from full `steerDegrees` at a\n	-- stop to this share of it flat out -- the reason a car that turns sharply in\n	-- a parking lot does not spin out doing the same turn at speed. 1 would mean\n	-- no scaling at all.\n	-- Safe range: 0.25-0.55.\n	HighSpeedSteerShare = 0.4,\n	-- Studs per second above which the steering scale in HighSpeedSteerShare is\n	-- fully applied. Below this a car steers at its full rating regardless of\n	-- speed -- parking-lot manoeuvring should feel like parking-lot manoeuvring.\n	-- Safe range: 25-45.\n	SteerTaperStuds = 34,\n\n	-- How many bearings the parking search fans out across, and how wide, when\n	-- looking for somewhere to stand a spawned car near the dealership. Same\n	-- Ground.Bearings pattern every other placement in the game uses, sized for a\n	-- forecourt rather than a room -- a car needs more clearance than a person.\n	-- Safe range: 90-180 degrees, 5-9 bearings.\n	ParkArcDegrees = 140,\n	ParkBearings = 7,\n	-- How far out from the dealership's place point the search starts, and how\n	-- much further it tries once before giving up. A car is bigger than a body,\n	-- so this starts further out than PocketMoneyService's parent-arrival search\n	-- does for a person.\n	-- Safe range: 14-26 studs.\n	ParkStuds = 18,\n	ParkRetryScale = 1.6,\n\n	-- A car left both empty and unridden this long returns to the dealership on\n	-- its own, so an afternoon of parked cars does not become litter across the\n	-- city. Long enough that stepping into a shop for a shift does not lose the\n	-- car parked outside it.\n	-- Safe range: 300-1200 seconds.\n	IdleDespawnSeconds = 600,\n	-- How often the chassis re-derives its suspension forces and drive force.\n	-- Every RenderStepped-equivalent tick, on the server: fast enough that the\n	-- ride does not feel quantised, slow enough not to be the most expensive\n	-- thing running.\n	-- Safe range: 1/60-1/30.\n	TickSeconds = 1 / 60,\n}\n\n-- Monthly living expenses. Money leaves every game month whether the player\n-- wants it to or not, which is the one force that keeps a life from running\n-- forward on autopilot and turning the pocket-money trickle into a flood.\nConfig.Bills = {\n	-- The age a life starts paying its own way. Below it there are no bills at all\n	-- -- not a bill of zero, no bill.\n	--\n	-- This was missing, and its absence was not a rounding error: a newborn was\n	-- charged BaseMonthly on its first birthday, could not pay it, and was carrying\n	-- the \"in_debt\" flag at age one. Every consequence hung off that -- the happiness\n	-- drain, the loan-shark content door -- so the toddler years opened with a debt\n	-- spiral nobody could have avoided and no mechanic could answer.\n	--\n	-- Derived from Adulthood rather than typed because \"you pay your own way once\n	-- you are an adult\" is the actual rule; the number is a consequence of it. It is\n	-- deliberately not the first job at sixteen: a sixteen-year-old with a shop job\n	-- still lives at home, and the two years where you are earning and not yet\n	-- paying rent are the years the game gives you to build a cushion.\n	MinAge = stageMinAge(\"Adulthood\"),\n	-- The base cost of existing in the world each month, before anything else\n	-- is factored in. Small enough that a first job can cover it, large enough\n	-- that skipping work for a month leaves you behind.\n	-- Safe range: 100-400.\n	BaseMonthly = 200,\n	-- Extra cost per suburb house owned. A home is not free to maintain, and\n	-- this is the monthly slice of the 30% resale loss that the plan names\n	-- \"property tax.\" The house already cost BuyPrice to enter; this is the\n	-- rent you pay for staying.\n	-- Safe range: 100-500.\n	HouseMonthly = 200,\n	-- Money held above this threshold shifts you into a higher lifestyle tier,\n	-- and the monthly bill scales with it. A life that accumulates ten thousand\n	-- without paying more than a starter keeps drifting further ahead of the\n	-- curve -- this keeps the curve from becoming invisible.\n	-- Safe range: 5000-20000.\n	LuxuryThreshold = 10000,\n	-- Bill multiplier once the luxury threshold is passed. A life that has\n	-- climbed past the entry-level band pays more, not because the game is\n	-- punishing wealth but because a bigger life costs more to sustain.\n	-- Safe range: 1.2-2.0.\n	LuxuryMultiplier = 1.5,\n	-- What accumulates when a bill cannot be paid in full. Debt grows on top\n	-- of debt and the interest is what makes a life that runs behind for a\n	-- year hard to climb out of without a meaningful change.\n	-- Safe range: 0.03-0.10.\n	DebtInterestRate = 0.05,\n	-- Hard ceiling on how much debt a life can carry. Above this the life\n	-- flags as financially distressed and happiness drains faster; the cap\n	-- exists so the number never becomes abstract.\n	-- Safe range: 2000-10000.\n	MaxDebt = 5000,\n}\n\n-- A place to park money so it earns interest rather than sitting idle.\n-- The inverse of bills: debt compounds against you, savings compound for you.\n-- The gap between the two rates is what makes a life that saves feel the relief\n-- of compound growth, and what makes a life that defaults feel the squeeze of\n-- both sides of the same formula.\nConfig.Savings = {\n	-- Maximum balance a life can hold. Above this extra deposits go to money,\n	-- so the cap only applies to the savings account itself and never to the\n	-- total a life carries. Small enough that most lives never hit it; large\n	-- enough that a saver who stays on track has a real difference over time.\n	-- Safe range: 5000-20000.\n	MaxBalance = 10000,\n	-- Monthly interest paid on the savings balance. Compounded: interest\n	-- earned each month is added to the balance and earns interest itself the\n	-- following month. The rate is deliberately lower than debt interest so the\n	-- gap punishes default while rewarding caution, not so that saving beats\n	-- working.\n	-- Safe range: 0.005-0.02.\n	InterestRate = 0.01,\n}\n\n--\n-- A shift used to be a timer. You walked to a marker, stood on it, and a number went\n-- up for four real minutes -- which is not a job, it is a loading screen you are paid\n-- for. Everything in this block exists to fill that time with somewhere to be.\n--\n-- The loop is deliberately small and always the same: a mark appears somewhere in the\n-- workplace with an instruction over it, you have a few seconds to get there, and\n-- then another one appears. It is the same verb as every other choice in this game --\n-- walk onto the lit thing -- which is the point. A shift should not need teaching.\n--\n-- The numbers below are all about *pace*. They are the difference between a shift\n-- that feels like work and one that feels like being nagged, and they are the first\n-- thing to reach for if playtesting says the shift is either frantic or dead.\nConfig.Work.Tasks = {\n	-- How long after clocking on before the first task appears, and how long between\n	-- one ending and the next arriving.\n	--\n	-- Short on purpose. Idle time inside an activity is the bug this whole block\n	-- exists to fix, so the gap is only long enough to read what just happened --\n	-- \"done, +$12\" needs a beat to land, and a task that arrived the same frame the\n	-- last one ended would eat its own feedback.\n	-- Safe range: 1.5-6. Above ~6 the shift starts to have holes in it again.\n	GapSeconds = 3,\n\n	-- How many tasks may be running at once, late in a shift.\n	--\n	-- This is the difference between a to-do list and a shift. With one task at a time\n	-- the only question a shift ever asks is \"how fast can you walk\", and there is\n	-- exactly one right answer to it at every moment -- which means there is no\n	-- decision in the loop at all, only execution. With two, the shop is asking for two\n	-- things at once and the player has to decide which one to lose or which order to\n	-- take them in, and that decision is the skill the job is actually teaching.\n	--\n	-- Two and not three. Three marks lit on one shop floor is a scavenger hunt rather\n	-- than a job, the HUD would need a scrolling list, and the moment a player cannot\n	-- hold the whole problem in their head they stop planning and start reacting --\n	-- which is the very thing the second slot exists to move them away from.\n	-- Safe range: 1-2. At 1 the shift is a to-do list again, which is a legitimate\n	-- setting if the double load ever proves too much for the age range.\n	MaxConcurrent = 2,\n\n	-- The game hour of the shift from which a second task may be live.\n	--\n	-- The shift escalates by changing its shape rather than by tightening its numbers:\n	-- the clocks and the marks stay exactly as they were, and what changes is how much\n	-- of the room is asking for you at once. So a shift opens as the tutorial version\n	-- of itself -- one thing at a time, learn the floor -- and turns into the real one\n	-- a third of the way in, without a single number moving.\n	--\n	-- Also the reason a first shift is never unfair. A player's first two hours at any\n	-- new job are single-task, every time, including the day they are promoted into a\n	-- building they have never worked in.\n	-- Safe range: 2 to ShiftGameHours - 2. At 1 there is no ramp; above that the shift\n	-- ends before the second slot has been open long enough to matter.\n	SecondSlotFromHour = 3,\n\n	-- How much longer the wait is when a task is already in hand.\n	--\n	-- The two slots must fill *staggered*, never together. Two tasks arriving on the\n	-- same tick is one big task with two halves and the player just does them in the\n	-- order they are listed; a second one landing while the first is half walked is a\n	-- genuine interruption, and being interrupted is the thing being practiced.\n	--\n	-- At 2.5 against a 3s gap the second lands about seven seconds in, which is inside\n	-- every clock in JobTasks and outside the walk to a single mark -- so it reliably\n	-- arrives while the player is committed to something and reliably leaves them able\n	-- to still make it.\n	-- Safe range: 1.5-4. Below 1.5 the two arrive as a pair; above 4 the second slot\n	-- stops being used often enough to be worth having.\n	SecondTaskGapMultiplier = 2.5,\n\n	-- How long a missed task keeps its row on the HUD before it goes.\n	--\n	-- Its own number rather than GapSeconds, which used to do both jobs. With one slot\n	-- they were genuinely the same wait -- the miss sat there and the shift was idle\n	-- until the next task, so one clock described both. With two they are different\n	-- questions asked of different things: how long a miss stays readable is about the\n	-- player's attention, and how soon the next task arrives is about the shop's\n	-- workload. Sharing a field meant a missed task blocked the slot it was no longer\n	-- using, which with two slots is a quarter of the shift spent a task short for no\n	-- reason the player could see.\n	-- Safe range: 2-5. Under ~2 the row is gone before it has been read.\n	MissLingerSeconds = 3,\n\n	-- How far from the station a task mark can be painted, as a share of the distance\n	-- a player is allowed to wander before they count as having walked out.\n	--\n	-- Well inside it, and that gap is load-bearing: a task that sent you past\n	-- StationRadiusStuds would end your own shift for abandoning it, which is the\n	-- funniest possible bug and would be very hard to diagnose from the symptom.\n	-- Safe range: 0.25-0.7.\n	SpreadShareOfStation = 0.45,\n\n	-- The closest a task mark may be painted. Below this it lands under the feet of\n	-- somebody already standing at the counter, and a task you complete by not moving\n	-- is a task that taught the player the marks can be ignored.\n	-- Safe range: 4-12, and must stay below SpreadShareOfStation * StationRadiusStuds.\n	MinSpreadStuds = 7,\n\n	-- Arcs tried when looking for somewhere to paint a mark, in degrees around the\n	-- station, and how many bearings inside that arc. A full circle because a\n	-- workplace is a room you are in the middle of rather than a thing you face.\n	-- Safe range: arc 180-360, count 6-16. More bearings is a better chance of\n	-- finding a spot in a cluttered room and slightly more raycasting per task.\n	SearchArcDegrees = 360,\n	SearchBearings = 12,\n\n	-- Fractions of the spread tried along each bearing, near to far. Gives a cramped\n	-- stockroom somewhere to put a mark when the full spread is inside a wall.\n	SearchSteps = { 1, 0.75, 0.5 },\n\n	-- How close to the mark counts as reaching it. Matches the hire pad rather than\n	-- the clock-in radius: this is a thing you step onto, not a place you stand near.\n	-- Safe range: 2-5.\n	ReachStuds = 3,\n\n	-- What finishing a task pays, as a share of an hour's wage at that job.\n	--\n	-- A share rather than a number, so the tip climbs with the ladder and with your\n	-- record without a second table to keep in step: the office pays better per task\n	-- for the same reason it pays better per hour. At 0.2 a good shift adds roughly a\n	-- fifth again on top of the wage, which is worth chasing and is not a second\n	-- income.\n	-- Safe range: 0-0.5. At 0 tasks are worth only your record, which is a legitimate\n	-- setting if tips ever start to distort the economy.\n	TipShareOfHour = 0.2,\n\n	-- The ceiling on what one shift's tips may add up to, as a share of a full\n	-- shift's wage at that job.\n	--\n	-- Without a cap, tips are unbounded. A task closes the instant a foot touches its\n	-- mark and the next arrives GapSeconds later, so a player who ping-pongs between\n	-- marks clears forty-odd tasks in a four-minute shift rather than the eight or\n	-- nine this block was written for. Tips then out-earn the wage by more than\n	-- double, and because they never touch workGameHoursThisYear they slip straight\n	-- past the year's cap -- which breaks the promise Jobs.luau makes in its own\n	-- header that a job's pay is one authored salary.\n	--\n	-- At 0.25 the ceiling sits just above what TipShareOfHour always claimed tips\n	-- were worth (\"roughly a fifth again on top of the wage\"), so this enforces the\n	-- original intent rather than changing it. Tasks past the cap still count toward\n	-- the shift's verdict and still pay standing -- they simply stop paying money, so\n	-- the reason to keep working is the record rather than the tip.\n	-- Safe range: 0.1-0.6. At 0, tips are off entirely.\n	TipCapShareOfShift = 0.25,\n\n	-- What an hour of the shift actually pays, as a multiple of the job's rate,\n	-- decided by how the shift has gone by the time that hour lands.\n	--\n	-- This is the line between a job and an idle payout pad. The wage was credited\n	-- off a wall clock that read no task field whatsoever, so standing inside the\n	-- station radius for four minutes and touching nothing paid exactly what working\n	-- the shift properly paid. When outcomes do not differentiate, the skill has been\n	-- deleted -- there is no reason to do the tasks except the tips, and no reason to\n	-- clock on at all except to wait.\n	--\n	-- Graded rather than pass/fail, on Work at a Pizza Place's star model: a bad\n	-- shift should cost money, not the job. The bands reuse GoodShare and OkShare so\n	-- there is one definition of a good shift in this file rather than two that can\n	-- drift apart.\n	--\n	-- An hour that lands before the shift has issued its first task pays in full:\n	-- nothing was asked, so nothing can have been missed. That grace is also what\n	-- keeps the first hour of every shift honest, since the first task deliberately\n	-- waits out a gap before it appears. It lapses the moment the shop tries to ask\n	-- for something and comes up with nothing -- see UnansweredAsksBeforeBroken.\n	-- Safe range: Good 1, Ok 0.6-0.9, Poor 0.2-0.5, None 0-0.2, and descending.\n	WageShareGood = 1,\n	WageShareOk = 0.8,\n	WageSharePoor = 0.3,\n	WageShareNone = 0,\n\n	-- How many times the shop may ask for something, find nowhere to put it, and be\n	-- given the benefit of the doubt before the shift is called off.\n	--\n	-- The grace above is written for a shift that has not started yet, and for a long\n	-- time nothing distinguished that from a shift that can never start. A station\n	-- whose room is too cramped to fan a mark out in issues no tasks, so it misses\n	-- none, so it reads as a shift where nothing was asked -- which paid a full wage\n	-- and climbed the ladder at base rate for standing perfectly still. At 40 game\n	-- hours a year that is an entire salary for a player who never moved, and it is\n	-- the single largest hole this block was written to close.\n	--\n	-- Only counted when the floor is completely clear, which is what makes the count\n	-- trustworthy: a second-slot ask can fail honestly because the first task's marks\n	-- are standing in the space the second one wanted, and a station that works\n	-- perfectly well would otherwise condemn itself on its own busyness.\n	--\n	-- Three against a 3s gap calls it after about nine seconds, well inside the first\n	-- game hour, so a broken station is caught before it can pay for one.\n	-- Safe range: 2-6. At 1 a single unlucky search ends the shift; above ~6 the\n	-- player stands there long enough to wonder whether they are doing it wrong.\n	UnansweredAsksBeforeBroken = 3,\n\n	-- What the shift's tasks do to your record.\n	--\n	-- Deliberately *not* per task. Standing bands sit at 6, 14 and 24 and a whole\n	-- finished shift is worth PerShiftWorked = 1, so paying a point per task -- eight\n	-- or nine a shift -- would flatten the entire ladder in one afternoon. Instead the\n	-- tasks decide what the shift was worth: work it properly and the shift counts\n	-- double, coast through it and it counts for nothing.\n	--\n	-- The share of the shift's tasks that has to be finished for each verdict.\n	-- Safe range: Good 0.7-0.95, Ok 0.3-0.6, Good above Ok.\n	GoodShare = 0.8,\n	OkShare = 0.4,\n\n	-- Added to PerShiftWorked when the shift came in at or above GoodShare. The whole\n	-- reason to do the tasks rather than stand there: it is the difference between\n	-- reaching the office in three shifts and reaching it in six.\n	-- Safe range: 0-2.\n	PerGoodShift = 1,\n\n	-- What a shift below OkShare is worth, replacing PerShiftWorked entirely. Zero\n	-- rather than negative: turning up and doing nothing should not climb the ladder,\n	-- and it is not the same offense as walking out, which already costs -2.\n	-- Safe range: -1 to 1.\n	PoorShiftStanding = 0,\n\n	-- XP toward the next standing band, shown as a thin bar under the shift\n	-- progress. Distinct from standing itself: standing is the record the job\n	-- keeps, XP is the visible progress the player watches climb. Reset each\n	-- shift so the bar always shows how far into the current shift the next band\n	-- is. Per-task and per-event values are small so a shift of four minutes\n	-- yields a meaningful fill without making the bar a speed test.\n	-- Safe range: 1-10 per task, 1-5 per event.\n	StandingXp = {\n		PerTask = 5,\n		PerEvent = 3,\n	},\n}\n\n-- The people a task is for.\n--\n-- A task with somebody waiting on it is a different thing to do than the same task\n-- alone in a room, and none of that difference is in the rules -- the clock, the\n-- marks and the tip are identical. It is entirely that a person is standing there\n-- looking at you, which is the one thing this engine gives away for free: the head\n-- tracking in Config.NPC costs no asset and no animation and does more for a shift\n-- than any number here.\n--\n-- Everything in this block is about where they stand, and the whole block is\n-- optional: a room too tight to fit a customer runs the task without one rather than\n-- failing it.\nConfig.Work.Customers = {\n	-- How far beyond the mark the customer stands, along the line out from the\n	-- station. So the player steps onto the mark and the customer is across it facing\n	-- them, which is what a counter looks like from either side.\n	--\n	-- Must be more than a body's width. Visitors are solid to the player -- they are\n	-- real rigs, not props -- so too small a figure here is a shift spent shouldering\n	-- somebody out of the way at every till.\n	-- Safe range: 2.5-5.\n	StandOffStuds = 3.2,\n\n	-- How far out past their standing spot they walk in from. This is the whole\n	-- arrival: they appear here and walk to the counter, so it wants to be far enough\n	-- to be a walk and short enough to be over before the player has crossed the room.\n	-- Safe range: 8-24. Above ~24 they are still coming when the clock runs out.\n	ArriveFromStuds = 14,\n\n	-- How long they stay after being served before turning to leave. The beat where\n	-- they say something and you have already been paid.\n	-- Safe range: 0-4. At 0 they turn on their heel mid-sentence.\n	ServedBeatSeconds = 1.6,\n\n	-- How high above the head the line they say floats, in studs, and how far away it\n	-- can still be read. Name tags are off for these people -- a stranger in a shop\n	-- does not wear one -- so this text is the only thing over them.\n	-- Safe range: 2.5-5 and 20-80.\n	SpeechHeightStuds = 3.4,\n	SpeechRangeStuds = 45,\n\n	-- A queue is several of them, one behind the other, and these three numbers are\n	-- all it is.\n	--\n	-- The gap between one person and the next, measured back along the same line out\n	-- from the station. Wide enough that four of them read as a queue rather than as a\n	-- crowd, tight enough that the back of the line is still inside the room.\n	-- Safe range: 2-4. Below ~2 they overlap; above ~4 the line stops looking like one.\n	QueueSpacingStuds = 2.6,\n\n	-- How long between one person arriving and the next. They turn up one at a time so\n	-- the queue is seen forming rather than found already there, which is the\n	-- difference between a rush starting and a rush having been placed.\n	-- Safe range: 0.3-1.5. Above ~1.5 the back of the queue arrives after the clock.\n	QueueArriveGapSeconds = 0.7,\n\n	-- The most people a task may ever put in a line, whatever it asks for. A ceiling\n	-- rather than a tuning knob: a queue of six is six round trips on one clock, which\n	-- stops being pressure and becomes a chore.\n	-- Safe range: 3-5.\n	MaxQueue = 4,\n}\n\n-- What a job makes of you, and what that is worth.\n--\n-- The point of this whole block is that a wage should answer \"how well do you do\n-- this?\" and not only \"how long did you stand there?\". Standing is earned per job\n-- -- see LifeData.jobStanding -- and buys two things: a raise where you are, and\n-- the right to be hired somewhere better.\nConfig.Work.Standing = {\n	-- The floor. Deep enough that a run of bad shifts genuinely costs you the\n	-- ladder, shallow enough to be climbable back out of inside a year.\n	-- Safe range: -20 to -4.\n	Min = -10,\n\n	-- The ceiling. Reached by roughly two good years at one job, which is about the\n	-- point where a job has nothing further to say about you and the answer is a\n	-- different job.\n	-- Safe range: 20-60.\n	Max = 30,\n\n	-- Working a shift all the way out, on its own, with nothing happening in it.\n	-- Turning up is worth something and this is how much: enough that a player who\n	-- simply does the job climbs, slowly, without ever seeing a moment.\n	-- Safe range: 0-2. At 0, only events move your record.\n	PerShiftWorked = 1,\n\n	-- Leaving your station mid-shift. Costs more than a finished shift pays, so\n	-- walking out is never a way to farm anything, and a habit of it shows.\n	-- Safe range: -4 to 0.\n	PerWalkOut = -2,\n\n	-- Rock bottom. Let your standing sink all the way to the floor and the job lets\n	-- you go: the sacking lands at clock-off, not mid-shift, so a bad shift finishes\n	-- before it costs you the job. Anchored to Min so \"on thin ice\" is exactly the\n	-- warning band -- the last stretch before the drop -- and moving Min moves the\n	-- warning with it. Must satisfy Min <= FireAt < 0 (checked in WorkService).\n	-- Safe range: same as Min.\n	FireAt = -10,\n\n	-- The last warning before the sack, and it is deliberately literal: from here a\n	-- single worst answer (a -3 performance) reaches the floor, so \"one more bad\n	-- shift\" is exactly what the line means. Crossing at or below it pushes the\n	-- player the warning that one shift decides it. Must sit strictly between\n	-- FireAt and 0 so the two warnings land in order (checked in WorkService).\n	-- Safe range: FireAt + 1 .. -1.\n	FinalWarnAt = -8,\n}\n\n-- What each stretch of standing is called and what it pays, best first.\n--\n-- Read top-down: the first band whose `atLeast` you meet is the one you are in.\n-- Declared after the table above so the bottom band can be anchored to Min rather\n-- than to a magic number that would silently stop covering the range if Min moved.\n--\n-- `raise` is a fraction of the job's base hourly rate, added on top and floored to\n-- whole units. A fraction rather than a flat figure because the same raise has to\n-- mean the same thing to a $60 shop hour and a $200 office one -- a flat $20 would\n-- be a third of one and a tenth of the other.\n--\n-- Nothing below \"well thought of\" pays a bonus, and nothing pays a *penalty*. A bad\n-- record costs you the ladder, which is punishment enough and far more legible than\n-- a wage that quietly shrinks while you are trying to work out what you did wrong.\n--\n-- `name` is a lowercase phrase that has to read correctly in both places it is\n-- used: on the HUD (\"Well thought of · 3 of 5 shifts this year\") and inside the\n-- sentence explaining a job you cannot take yet (\"You need to be well thought of as\n-- a Shop assistant first\"). A phrase that does not fit both is the wrong phrase.\nConfig.Work.Standing.Bands = {\n	{ atLeast = 24, name = \"the one they ask for\", raise = 0.35 },\n	{ atLeast = 14, name = \"relied on\", raise = 0.20 },\n	{ atLeast = 6, name = \"well thought of\", raise = 0.10 },\n	{ atLeast = 0, name = \"finding your feet\", raise = 0 },\n	{ atLeast = Config.Work.Standing.Min, name = \"on thin ice\", raise = 0 },\n}\n\n-- Game hours of paid work available in a year. Derived rather than authored, so\n-- the cap and the salary can never drift apart: this is the number a yearly\n-- salary is divided by to get an hourly rate, and the number a year of work is\n-- measured against. Change either constant above and both move together.\nConfig.Work.YearGameHours = Config.Work.ShiftGameHours * Config.Work.ShiftsPerYear\n\n-- Health: being run down, and being ill.\n--\n-- Health is the one stat that can end a life, and until now it could only end it all\n-- at once: a life at 1 health was a life at no health, and everything below the\n-- ceiling was a warning you read rather than a system you played. This block is the\n-- middle of that range. A life that lets itself fall below RiskHealth starts catching\n-- things on birthdays, and being ill is a year that costs more than an ordinary one --\n-- extra drain on top of the ordinary decay, and a working year that reads as a bad\n-- one. Keeping health above the line is the point of every restful and healthy choice\n-- in the game, and it is the first number below the ceiling that actually threatens\n-- the life above it.\nConfig.Health = {\n	-- The line health must stay above to keep a clean record. A life at or above this\n	-- never falls ill on a birthday -- illness is the tax on being run down, not a\n	-- lottery everyone is in -- and below it, every birthday carries a chance to catch\n	-- something. Sickness is still possible above the line, but only as content, never\n	-- as a birthday roll: the loop never invents it for a healthy life.\n	-- Safe range: 30-60. Below ~30 illness is too rare to be the mechanism; above ~60\n	-- a life has to be nearly ruined before the loop can ever touch it.\n	RiskHealth = 40,\n\n	-- The birthday chance of falling ill, at its floor and its ceiling. The chance\n	-- rises in a straight line from BaseIllnessChance at RiskHealth to\n	-- MaxIllnessChance at zero health, so every point of health below the line is a\n	-- little more of the body failing to hold the line.\n	-- Safe range: floor 0.03-0.15, ceiling 0.2-0.5, floor strictly below ceiling.\n	BaseIllnessChance = 0.08,\n	MaxIllnessChance = 0.35,\n\n	-- What a year of being ill costs, on top of the ordinary yearly decay. The health\n	-- figure is the threat and the happiness figure is the feel: an illness should dim\n	-- a life even when it cannot end one. Kept near the ordinary decay so an ill year\n	-- reads as \"twice a normal year\" rather than as a cliff.\n	-- Safe range: health 3-10, happiness 2-8.\n	SickHealthPerYear = 6,\n	SickHappinessPerYear = 4,\n\n	-- A shift worked while ill is a bad shift before it has even been one. Applied once\n	-- at clock-off on top of the shift's own verdict, so a life that goes in sick pays\n	-- for it in the only currency work understands. Small enough that a good record\n	-- shrugs it off, and small enough that a thin one notices.\n	-- Safe range: -4 to -1.\n	SickShiftStanding = -2,\n\n	-- What a birthday spent recovering puts back at once. Smaller than a sick year\n	-- takes out, so recovering is a reprieve rather than a refill: an ill year drains\n	-- roughly seven points and this restores four, which is the whole shape of the loop\n	-- -- a life that falls ill pays a little each time until it either gets well or\n	-- runs out of the middle of the bar.\n	-- Safe range: 3-10. Near the sick health drain is where it stops being a tax.\n	RecoverHealth = 4,\n}\n\n-- School: the first half of a life, which until now had nothing in it to do.\n--\n-- Everything between being born and turning sixteen was a stat readout and a text\n-- prompt on a birthday. A player could not spend an afternoon being a child, because\n-- there was no afternoon -- childhood was a loading bar in front of the job.\n--\n-- The loop is the shift's loop with the walking taken out of the middle. A shift asks\n-- you to get somewhere before a clock; a lesson asks you to get the answer right before\n-- one. The walk is spent once, at the door -- you went to the school -- and the twenty\n-- seconds after that are thinking rather than travelling, which is the one place in\n-- this game where that is the right trade.\n--\n-- What it is for, mechanically, is that `smarts` was a number nothing in the game read.\n-- No job asked for it, no event moved it, and it decayed at zero a year. School is the\n-- one thing that moves it and the office is the one thing that wants it -- so the\n-- afternoons a nine-year-old spends here are the reason a sixteen-year-old can be\n-- something other than a shop assistant. That is the whole point of the system: it\n-- makes the first half of a life pay into the second.\n--\n-- Nothing here says what an answer looks like. It is a row on the one panel every\n-- question in this game is asked on, so its limits are Config.Enact's and there is\n-- deliberately no second set of numbers to keep in step.\nConfig.School = {\n	-- The years school runs over. Six because that is when the existing childhood\n	-- events start treating a life as old enough to be somewhere on its own, and\n	-- seventeen because eighteen is Adulthood -- the last school year is the year\n	-- before you are expected to be earning.\n	--\n	-- Deliberately overlapping Work.Hiring's first job at sixteen rather than handing\n	-- over cleanly at it. The two years where you could be at school or at work and\n	-- have time for neither are the most interesting years this game currently has.\n	-- Safe range: 5-8 and 15-18, low below high.\n	StartAge = 6,\n	EndAge = 17,\n\n	-- Lessons in a school year, and the year's ceiling. The same idea as\n	-- Work.ShiftsPerYear and a smaller number on purpose: a year of school should be\n	-- one good afternoon's decision rather than a thing to grind, because there are\n	-- twelve of these years and only about four of the working ones before the money\n	-- stops being the point.\n	-- Safe range: 2-6. Above ~6 a full childhood is over an hour of lessons.\n	LessonsPerYear = 3,\n\n	-- Questions in a lesson. Long enough that one lucky guess does not decide it,\n	-- short enough that a lesson is about ninety seconds -- roughly a third of a\n	-- shift, which is the right relative weight for a thing you do three times a year\n	-- rather than five.\n	-- Safe range: 3-8.\n	QuestionsPerLesson = 5,\n\n	-- How long you have to pick an answer.\n	--\n	-- Generous by design. It is thinking time and nothing else now that the answers are\n	-- a click rather than a walk, and it is deliberately not shortened to match: a clock\n	-- this loose fails only the player who did not know the answer, which is exactly who\n	-- school is\n	-- supposed to be failing.\n	-- Safe range: 10-40. Below ~10 a child at walkSpeed 8 is being tested on running.\n	SecondsPerQuestion = 20,\n\n	-- How long the answer's explanation holds before the next question. The one beat\n	-- in this system that is not a mechanic, and it is the reason it is school rather\n	-- than a quiz: getting it wrong tells you why, and the next lesson may ask again.\n	-- Safe range: 2-6. Below ~2 the line cannot be read; above ~6 the lesson has\n	-- holes in it, which is the bug Work.Tasks.GapSeconds exists to avoid.\n	VerdictSeconds = 3.5,\n\n	-- How often the server checks players against their answer pads. Matches\n	-- Enact.TickSeconds because it is doing the identical job on identical pads.\n	-- Safe range: 0.1-1.\n	TickSeconds = 0.25,\n\n	-- How near the school's place point you must be to go in, and how far you may\n	-- wander before the lesson counts as walked out of. The same two radii as a shift\n	-- and for the same reasons -- see Work.ClockInRadiusStuds and StationRadiusStuds.\n	--\n	-- The room is tighter than a workplace because a classroom you can leave and still\n	-- be answering questions in is not a classroom. It is the only thing holding the\n	-- player in the lesson, now that the answers travel with them rather than lying on\n	-- the floor. Safe range: 4-10 and 12-30.\n	AttendRadiusStuds = 6,\n	RoomRadiusStuds = 20,\n\n	-- Whether a lesson's answers are discs on the classroom floor that you answer by\n	-- walking onto, rather than rows on a panel you click. The panel still opens -- it\n	-- carries the question and the answer text, for reading -- but with discs down the\n	-- rows are locked and the floor is the interface.\n	--\n	-- False, and deliberately: docs/interaction_grammar.md settled this months before\n	-- this switch was written, in the user's own words -- \"instead of places on the\n	-- floor to walk on, make the mechanic more appealing like 3 dots over each\n	-- characters head and then the options come up\" -- and named lesson answers as one\n	-- of the three examples in the same breath as person offers and event choices. A\n	-- lesson answered by walking onto a disc is the one place that grammar regressed;\n	-- this is what puts it back. Kept a switch rather than deleted because a lesson\n	-- sat in a doorway is exactly the case where the panel is the right answer, and\n	-- because the whole point of the room is a place discs *could* go if that\n	-- decision is ever revisited -- it is not a decision this file gets to make twice.\n	PhysicalLessons = false,\n\n	-- The fan the answer discs are placed in. Distance is how far from the player the\n	-- fan reaches; reach is how near a disc counts as standing on it, and it is also\n	-- the radius the disc is drawn at, so the disc the player sees is the disc that\n	-- counts. The two are kept apart so a question is never answered by the disc it\n	-- was placed under your feet, and the arc widens with the answer count so no two\n	-- discs sit within reach of each other.\n	-- Safe range: Distance 4-7, Reach 2-3, Reach below Distance - 2, Arc 100-200.\n	DiscDistanceStuds = 5.5,\n	DiscReachStuds = 2.5,\n	DiscArcDegrees = 150,\n\n	-- Teacher. A humanoid at the front of the room facing the student while the\n	-- lesson is in session, reacting to answers -- a bow on right, a step back\n	-- on wrong. Placed opposite the player from the room centre, walked in at\n	-- the start and despawned at the end. Gateable for testing the lesson loop\n	-- without the presence, and gracefully skipped if the floor refuses a spot.\n	TeacherEnabled = true,\n	TeacherFrontStuds = 13, -- distance of the teacher's standing spot from the room centre\n	TeacherWalkInStuds = 5, -- how far behind the front spot the teacher spawns\n	TeacherNodSeconds = 1.2, -- how long the teacher holds a bow for a right answer\n	TeacherBackStuds = 2, -- how far the teacher steps back on a wrong answer\n	TeacherBackHoldSeconds = 1.2, -- how long they hold there before re-centring\n\n	-- The share of a lesson's questions you have to get right for each verdict. The\n	-- same shape as Work.Tasks' shares, and a lower bar: a shift's tasks are a test of\n	-- attention and these are a test of knowing, so four in five is a good day.\n	-- Safe range: Good 0.7-0.95, Ok 0.3-0.6, Good above Ok.\n	GoodShare = 0.8,\n	OkShare = 0.4,\n\n	-- What a lesson is worth in smarts, by verdict.\n	--\n	-- Per lesson rather than per answer, for exactly the reason work pays standing per\n	-- shift rather than per task: smarts runs 0-100 and starts at 50, so there are\n	-- fifty points of headroom to spend across twelve years. At two a lesson, a child\n	-- who attends and pays attention arrives at sixteen near the ceiling, and one who\n	-- turns up and guesses arrives about halfway there. A point an answer would cap\n	-- them both out before they were ten and make the back half of childhood pointless.\n	-- Safe range: 1-4, 0-2 and 0-1, best first.\n	SmartsPerGoodLesson = 2,\n	SmartsPerOkLesson = 1,\n	SmartsPerPoorLesson = 0,\n\n	-- What a school year you never turned up to costs, applied on the birthday that\n	-- ends it. Only ever between StartAge and EndAge, and only when the year had zero\n	-- lessons in it -- one lesson is enough to prove you went.\n	--\n	-- This is the entire stake. Without it school is free upside and skipping it costs\n	-- nothing but the upside, which is not a decision -- and a game where the whole of\n	-- childhood is optional has spent twelve years saying nothing. Smaller than a good\n	-- lesson pays, so a year you half-attended still comes out ahead of one you did\n	-- not, and a childhood spent elsewhere ends around thirty smarts rather than at\n	-- zero: behind, not ruined.\n	-- Safe range: -4 to 0. At 0 school has no downside and the office job is the only\n	-- reason to attend.\n	SmartsPerYearMissed = -2,\n\n	-- The mastery ladder, and it is per subject rather than per school: being good at\n	-- Science says nothing about Music, and one number over the whole timetable would let\n	-- a player master the one subject with a real verb and skip the five they had never\n	-- touched.\n	--\n	-- This is the Bully rule, and it is the reason school has an end rather than just a\n	-- last year. Attending a subject you have already beaten is the purest version of the\n	-- unskilled-dead-time anti-pattern: the same lesson, the same clock, and nothing left\n	-- in it to learn. So passing enough of a subject buys the right to stop sitting it --\n	-- see School.Mastery.Levels for what \"enough\" is -- and the afternoon it hands back is\n	-- the reward. Not a number: an hour of childhood you get to spend somewhere else.\n	Mastery = {\n		-- Rungs on the ladder, shared by every subject. Five because it has to be reachable\n		-- inside a childhood and still cost something: at PassesPerLevel = 2 that is eight\n		-- good lessons to top a subject out, against thirty-six lessons in a whole school\n		-- career -- so a player can master two or three subjects by graduation and not all\n		-- six, which is the shape that makes it a choice about what you are good at.\n		--\n		-- Science's RevealedStepsByLevel must be exactly this long. It is the one verb that\n		-- currently gives a level a meaning of its own, and a ladder with a rung the verb\n		-- has no answer for is a promotion that visibly does nothing.\n		-- Safe range: 3-6. Above ~6 the top rung arrives after school has ended.\n		Levels = 5,\n\n		-- Lessons at or above GoodShare that buy a rung. Two so a single lucky lesson does\n		-- not promote and a single bad one does not feel like it undid anything.\n		-- Safe range: 2-4.\n		PassesPerLevel = 2,\n	},\n\n	-- Geography, which is the errand: you are told the *name* of somewhere and you go\n	-- there. No lit disc, no line on the floor.\n	--\n	-- That absence is the whole verb, and it only works because of how much the rest of\n	-- the game does the opposite. Every other destination in AGES arrives as a gold disc\n	-- with a beam pointing at it and the distance written on the waypoint -- the shift,\n	-- the lure, the job post. A child has spent ten years being led by the hand. This is\n	-- the one lesson that lets go, and the skill being tested is the only one a town can\n	-- honestly test: do you know where anything is.\n	--\n	-- Nothing here names a place. The destinations are drawn from the live place graph at\n	-- the moment the lesson starts, so a town that grows grows the subject with it and a\n	-- place renamed in Studio is never a lesson pointing at somewhere that no longer\n	-- exists. See GeographyService.\n	Hunt = {\n		-- Destinations in one lesson. Three, which at the leg lengths below is a lesson of\n		-- roughly the same ninety seconds a quiz is -- and, more to the point, three is\n		-- enough for a bad first guess to be recoverable and few enough that each one still\n		-- counts for a third of the grade.\n		-- Safe range: 2-5. Above ~5 the lesson outlasts the walk home.\n		Stops = 3,\n\n		-- How far apart consecutive destinations may be, in studs. The town is about 930\n		-- studs across and a schoolchild walks at 16, so the far end of this band is a\n		-- twenty-eight second leg and the near end about twelve.\n		--\n		-- A band rather than a maximum, and the minimum is the important half: without it\n		-- the draw happily picks the shop next door, and a lesson made of three ten-stud\n		-- hops is not a lesson about a town. With it, a hunt walks a loop around a district\n		-- rather than crossing the map twice.\n		-- Safe range: 120-300 and 350-650, low below high.\n		MinLegStuds = 200,\n		MaxLegStuds = 450,\n\n		-- How near a destination counts as arriving. Looser than a classroom's attend\n		-- radius on purpose: a place point sits behind a counter or inside a doorway, and\n		-- being made to find the exact tile after already finding the building is precision\n		-- for its own sake -- the walk was the lesson and it is already over.\n		-- Safe range: 8-25.\n		ArriveRadiusStuds = 14,\n\n		-- How far above or below the spot the lesson started from a destination may be\n		-- and still be drawable, in studs.\n		--\n		-- This is the upstairs test. The city's fifty-six first-floor apartments are\n		-- place points like any other, sixteen studs up, and every one of them is a\n		-- stranger's home behind a door with no sign on it. A verb that gives you a name\n		-- and no marker can only be played by a player who can *see* the destination from\n		-- the street, so a place you have to already know the way into is not a\n		-- destination -- it is a riddle. Ground-floor shop interiors are well inside this\n		-- and stay drawable, which is right: the mall is findable from outside.\n		-- Safe range: 5-12. Above ~16 the upstairs flats come back.\n		MaxRiseStuds = 8,\n\n		-- The most a stop the clock ran out on can still be worth, as a share of one\n		-- found, scaled by how much of the way there the player actually got.\n		--\n		-- Without this the lesson has four possible scores -- none, one, two or three of\n		-- three -- and a player who was thirty studs from the bookstore when time went\n		-- scores exactly what a player who never left the school scores. That is the\n		-- undifferentiated-outcome trap, and the fix has to be in the verb's own units,\n		-- which are distance: credit is the fraction of the original gap closed at the\n		-- player's nearest approach. It is not a speed bonus and must never become one --\n		-- getting there fast earns nothing extra, because wandering is what the subject\n		-- is for.\n		-- Safe range: 0.3-0.6. At 1 a near miss pays the same as arriving.\n		MissedCreditCap = 0.5,\n\n		-- How often a running hunt re-reads where the player is standing. Matches\n		-- School.TickSeconds because it is the identical proximity job.\n		-- Safe range: 0.1-0.5. Above ~0.5 arrival visibly lags the footstep.\n		TickSeconds = 0.25,\n\n		-- How long each destination may take before the lesson gives up on it and moves on.\n		-- Sixty seconds is nearly four times the longest leg, so this only ever fires on a\n		-- player who is genuinely lost -- which is the honest failure for this verb.\n		--\n		-- Moving on rather than ending, deliberately: a missed stop scores nothing and the\n		-- lesson continues. A verb whose failure state is \"the activity stops\" punishes by\n		-- waiting, which is the one consequence shape we have ruled out everywhere else.\n		-- Safe range: 30-120. Below ~30 a wrong first guess cannot be recovered from.\n		SecondsPerStop = 60,\n\n		-- How long the line about the stop you just reached holds before the next name is\n		-- given. The same beat a lesson's verdict gets and for the same reason: arriving is\n		-- the payoff and a payoff with no pause is one nobody registers.\n		-- Safe range: 1-4.\n		ArrivedSeconds = 2,\n\n		-- What each mastery rung tells you, on top of everything the rungs below it told\n		-- you. This is the entire reward of the subject and it is deliberately not a\n		-- number: a level does not make you walk faster or score more, it makes the town\n		-- legible. That is Bully's map markers, which is the best reward in that game, and\n		-- it is the one progression a player feels as the world changing rather than as a\n		-- statistic moving.\n		--\n		-- Must be exactly School.Mastery.Levels long, checked at require time in\n		-- GeographyService for the same reason Science's RevealedStepsByLevel is: a rung\n		-- the verb has no answer for is a promotion that visibly does nothing.\n		--\n		--   name    -- the place's own label, and nothing else. Level one is being told\n		--              \"the pages & press\" and having to know that is the bookstore.\n		--   area    -- roughly where in town it is, as a compass sector from the school.\n		--   bearing -- an arrow at the top of the screen pointing at it. Direction only.\n		--   range   -- how far away it is, which with the arrow is very nearly the guide\n		--              line the rest of the game gives away for free.\n		--\n		-- The fifth rung adds nothing to the list because the fifth rung is the exit: it\n		-- tops the subject out and buys the right to skip, which is what every subject's\n		-- top rung buys.\n		RevealedByLevel = { \"name\", \"area\", \"bearing\", \"range\", \"range\" },\n	},\n\n	-- Content limits, enforced at server start rather than found in play. The answer\n	-- count is Enact's, because these are Enact's pads and a fifth of them crowds the\n	-- fan the same way whoever is asking -- and the question length is longer than a\n	-- choice label because a question is read from a HUD row rather than off the floor.\n	-- Safe range: 60-160.\n	MaxAnswers = Config.Enact.MaxChoices,\n	MaxAskLength = 96,\n}\n\n-- Science. The first subject with a verb of its own rather than a question with the\n-- word \"science\" written above it.\n--\n-- The shape is Bully's: every subject is a different *thing you do*, not a different\n-- question set, and passing buys the right to skip rather than the right to do it\n-- again. What Science does is run a procedure -- a board names an ordered list of\n-- stations, you walk the room clicking them in order, and each click stacks a step on\n-- a bench. Nothing is scored until you commit the bench, so the whole stack is undoable\n-- right up to that moment; that is the commit-and-undo pair every activity here owes.\n--\n-- Two benches run at once against a shared set of stations, which is where the load\n-- comes from: the second procedure is not twice the work, it is the same work with the\n-- room contested. Reagents are the traversal forcer -- steps spend from a shared pool\n-- and the cupboard is across the room -- and mastery does not raise a number, it shows\n-- you more of the board at once, so a level is felt as fewer walks back to read it.\n--\n-- Nothing in here restates a verdict share or a smarts payout. A procedure's score is\n-- a 0-1 share like a lesson's, so it lands on Config.School's GoodShare/OkShare and\n-- SmartsPer*Lesson and there is deliberately no second ladder to keep in step.\n\n-- Passive bonuses a life earns when a subject reaches mastery level 5 (cleared).\n-- Applied as a reduction to `minSmarts` on jobs that have both `minSmarts` and a\n-- gate for that subject. A life with smarts 50 and science level 5 hires for a\n-- job that asks for smarts 50 and science = 3, even though the raw number is\n-- exactly at the line -- the perk pushed it just over.\n--\n-- C decides which subjects get perks and at what level; B consumes them.\n-- Map entry keyed by subject id; absent key means no perk for that subject.\n-- Empty until C fills it in, and empty means `{}`. This was written as\n-- `{ [undefined] = nil }` to say \"nothing here yet\", which is not what it says to Lua:\n-- `undefined` is an unbound global, so the key is nil, and a nil key in a table\n-- constructor is a hard \"table index is nil\" thrown while Config's own module body is\n-- running. Every service in both places requires this file, so nothing in the game --\n-- not one service, in the lobby or the game place -- ever loaded. The player still got a\n-- character, because Roblox spawns that itself, which is why the symptom was \"I spawn\n-- normal size and cannot play\" rather than an error naming Config.\n-- `WorkService` reads this with a keyed lookup, so zero entries is inert, not special.\nConfig.SubjectPerks = {}\n\nConfig.School.Science = {\n	-- Benches running at once. Two, because one is a queue and three is a spectacle you\n	-- watch rather than a room you work: with two, every trip to a station is a choice\n	-- about which procedure it serves, and that choice is the whole mechanic.\n	-- Safe range: 1-3. At 1 there is no contention and this is a fetch quest.\n	Benches = 2,\n\n	-- The second bench does not open until the first procedure is this far along, so the\n	-- opening seconds teach the verb before they test it.\n	-- Safe range: 0.2-0.5. Above ~0.5 the second bench cannot be finished in time.\n	SecondBenchAtShare = 0.3,\n\n	-- The shortest procedure worth authoring. Four is long enough that order matters --\n	-- below it there is no sequence to get wrong, only a list to tick off. The ceiling is\n	-- MaxSteps, further down, and there is deliberately only one of those: two separately\n	-- tunable maximums is how a content check ends up quietly enforcing the looser one.\n	-- Safe range: 3-6, and below MaxSteps.\n	StepsMin = 4,\n\n	-- How long a procedure stands before the bench spoils and scores itself where it is.\n	-- Sized so an unmastered player crossing the room to re-read the board can finish\n	-- one bench comfortably and two only by planning the order of their trips.\n	-- Safe range: 50-120. Below ~50 the cupboard trip alone eats the clock.\n	SecondsPerProcedure = 80,\n\n	-- Speed is a multiplier on the score, never the score itself, and it has a floor: a\n	-- correct procedure committed on the buzzer is still worth most of a correct\n	-- procedure. Full credit needs this share of the clock still unspent at commit.\n	-- Safe range: Floor 0.6-0.85, FullShare 0.25-0.5. A floor of 0 makes a slow-but-right\n	-- run worthless, which punishes the player who is learning the room.\n	SpeedFloorFactor = 0.7,\n	SpeedFullShare = 0.4,\n\n	-- Reagents. Every step spends from one shared pool, refilled at a cupboard that is\n	-- deliberately not next to either bench. Twelve charges against a 4-8 step procedure\n	-- means roughly one cupboard trip per procedure and about one every fifty seconds\n	-- with two benches running -- close enough to the forty-to-sixty window that the room\n	-- never goes quiet, without the trip becoming the activity.\n	--\n	-- Shared rather than per-bench on purpose: it is the second thing the two procedures\n	-- have to fight over, and it is the one that makes committing a bench early a real\n	-- decision rather than always the safe one.\n	-- Safe range: Charges 8-20, ChargesPerStep 1-2, Refill 1.5-4.\n	SupplyCharges = 12,\n	ChargesPerStep = 1,\n	CupboardRefillSeconds = 2,\n\n	-- How much of the board you can see at once, by mastery level. This is requirement\n	-- six and the only progression the verb has: the player does not get faster hands or\n	-- a bigger number, they get to hold more of the procedure in their head at a time,\n	-- and they feel it as trips to the board that stop being necessary. At level one\n	-- three steps is one comfortable walk; by level five the whole longest procedure is\n	-- on screen and the board is furniture.\n	--\n	-- The length of this list is also the level ceiling -- ScienceService reads\n	-- `#RevealedStepsByLevel` rather than holding a separate maximum -- so adding a sixth\n	-- number here adds a sixth level and nothing else has to be told.\n	-- Safe range: rising, first 2-4, last at or above the longest authored procedure.\n	RevealedStepsByLevel = { 3, 4, 5, 6, 8 },\n\n	-- Escalation is deliberately *not* a station count that grows with mastery, which is\n	-- what this block held first. The lab is one room built once and shared by everyone\n	-- standing in it -- two players at different levels cannot be in differently furnished\n	-- versions of the same place -- so every station stands from the start, and the space\n	-- escalates by which stations a *procedure* sends you to. A nine-year-old's four-step\n	-- errand walks past five machines it never touches, which is also what a school lab\n	-- actually looks like.\n\n	-- What a pass is and how many buy a level both live on School.Mastery now, because\n	-- every subject climbs the same ladder and two ladders drifting apart would mean a\n	-- procedure and a quiz disagreeing about what \"mastered\" is. What is still Science's\n	-- own is what a level *buys*, which is RevealedStepsByLevel above -- and the length of\n	-- that list must equal School.Mastery.Levels, which ScienceService asserts at require\n	-- time rather than trusting.\n\n	-- Room and reach. The board is read from further away than a station is clicked from,\n	-- because reading is not an interaction and standing in the doorway squinting is a\n	-- legitimate way to play. Station reach is tight enough that two stations can stand\n	-- near each other without either answering for the other.\n	-- Safe range: Station 3-5, Bench 4-6, Board 5-9, Cupboard 3-5, Room 30-60.\n	StationRadiusStuds = 4,\n	BenchRadiusStuds = 5,\n	BoardRadiusStuds = 7,\n	CupboardRadiusStuds = 4,\n	-- 40 again. The art room is one of the deep rooms and the walk to the paint cupboard is\n	-- meant to cost real seconds, which is the mechanic. With the band back at 99 there is room\n	-- for it.\n	RoomRadiusStuds = 40,\n\n	-- Whether a lesson's answers are discs on the classroom floor that you answer by\n	-- walking onto, rather than rows on a panel you click. The panel still opens -- it\n	-- carries the question and the answer text, for reading -- but with discs down the\n	-- rows are locked and the floor is the interface.\n	--\n	-- False, and deliberately: docs/interaction_grammar.md settled this months before\n	-- this switch was written, in the user's own words -- \"instead of places on the\n	-- floor to walk on, make the mechanic more appealing like 3 dots over each\n	-- characters head and then the options come up\" -- and named lesson answers as one\n	-- of the three examples in the same breath as person offers and event choices. A\n	-- lesson answered by walking onto a disc is the one place that grammar regressed;\n	-- this is what puts it back. Kept a switch rather than deleted because a lesson\n	-- sat in a doorway is exactly the case where the panel is the right answer, and\n	-- because the whole point of the room is a place discs *could* go if that\n	-- decision is ever revisited -- it is not a decision this file gets to make twice.\n	PhysicalLessons = false,\n\n	-- The fan the answer discs are placed in. Distance is how far from the player the\n	-- fan reaches; reach is how near a disc counts as standing on it, and it is also\n	-- the radius the disc is drawn at, so the disc the player sees is the disc that\n	-- counts. The two are kept apart so a question is never answered by the disc it\n	-- was placed under your feet, and the arc widens with the answer count so no two\n	-- discs sit within reach of each other.\n	-- Safe range: Distance 4-7, Reach 2-3, Reach below Distance - 2, Arc 100-200.\n	DiscDistanceStuds = 5.5,\n	DiscReachStuds = 2.5,\n	DiscArcDegrees = 150,\n\n	-- Teacher. A humanoid at the front of the room facing the student while the\n	-- lesson is in session, reacting to answers -- a bow on right, a step back\n	-- on wrong. Placed opposite the player from the room centre, walked in at\n	-- the start and despawned at the end. Gateable for testing the lesson loop\n	-- without the presence, and gracefully skipped if the floor refuses a spot.\n	TeacherEnabled = true,\n	TeacherFrontStuds = 13, -- distance of the teacher's standing spot from the room centre\n	TeacherWalkInStuds = 5, -- how far behind the front spot the teacher spawns\n	TeacherNodSeconds = 1.2, -- how long the teacher holds a bow for a right answer\n	TeacherBackStuds = 2, -- how far the teacher steps back on a wrong answer\n	TeacherBackHoldSeconds = 1.2, -- how long they hold there before re-centring\n\n	-- The share of a lesson's questions you have to get right for each verdict. The\n	-- same shape as Work.Tasks' shares, and a lower bar: a shift's tasks are a test of\n	-- attention and these are a test of knowing, so four in five is a good day.\n	-- Safe range: Good 0.7-0.95, Ok 0.3-0.6, Good above Ok.\n	GoodShare = 0.8,\n	OkShare = 0.4,\n\n	-- What a lesson is worth in smarts, by verdict.\n	--\n	-- Per lesson rather than per answer, for exactly the reason work pays standing per\n	-- shift rather than per task: smarts runs 0-100 and starts at 50, so there are\n	-- fifty points of headroom to spend across twelve years. At two a lesson, a child\n	-- who attends and pays attention arrives at sixteen near the ceiling, and one who\n	-- turns up and guesses arrives about halfway there. A point an answer would cap\n	-- them both out before they were ten and make the back half of childhood pointless.\n	-- Safe range: 1-4, 0-2 and 0-1, best first.\n	SmartsPerGoodLesson = 2,\n	SmartsPerOkLesson = 1,\n	SmartsPerPoorLesson = 0,\n\n	-- What a school year you never turned up to costs, applied on the birthday that\n	-- ends it. Only ever between StartAge and EndAge, and only when the year had zero\n	-- lessons in it -- one lesson is enough to prove you went.\n	--\n	-- This is the entire stake. Without it school is free upside and skipping it costs\n	-- nothing but the upside, which is not a decision -- and a game where the whole of\n	-- childhood is optional has spent twelve years saying nothing. Smaller than a good\n	-- lesson pays, so a year you half-attended still comes out ahead of one you did\n	-- not, and a childhood spent elsewhere ends around thirty smarts rather than at\n	-- zero: behind, not ruined.\n	-- Safe range: -4 to 0. At 0 school has no downside and the office job is the only\n	-- reason to attend.\n	SmartsPerYearMissed = -2,\n\n	-- The mastery ladder, and it is per subject rather than per school: being good at\n	-- Science says nothing about Music, and one number over the whole timetable would let\n	-- a player master the one subject with a real verb and skip the five they had never\n	-- touched.\n	--\n	-- This is the Bully rule, and it is the reason school has an end rather than just a\n	-- last year. Attending a subject you have already beaten is the purest version of the\n	-- unskilled-dead-time anti-pattern: the same lesson, the same clock, and nothing left\n	-- in it to learn. So passing enough of a subject buys the right to stop sitting it --\n	-- see School.Mastery.Levels for what \"enough\" is -- and the afternoon it hands back is\n	-- the reward. Not a number: an hour of childhood you get to spend somewhere else.\n	Mastery = {\n		-- Rungs on the ladder, shared by every subject. Five because it has to be reachable\n		-- inside a childhood and still cost something: at PassesPerLevel = 2 that is eight\n		-- good lessons to top a subject out, against thirty-six lessons in a whole school\n		-- career -- so a player can master two or three subjects by graduation and not all\n		-- six, which is the shape that makes it a choice about what you are good at.\n		--\n		-- Science's RevealedStepsByLevel must be exactly this long. It is the one verb that\n		-- currently gives a level a meaning of its own, and a ladder with a rung the verb\n		-- has no answer for is a promotion that visibly does nothing.\n		-- Safe range: 3-6. Above ~6 the top rung arrives after school has ended.\n		Levels = 5,\n\n		-- Lessons at or above GoodShare that buy a rung. Two so a single lucky lesson does\n		-- not promote and a single bad one does not feel like it undid anything.\n		-- Safe range: 2-4.\n		PassesPerLevel = 2,\n	},\n\n	-- Geography, which is the errand: you are told the *name* of somewhere and you go\n	-- there. No lit disc, no line on the floor.\n	--\n	-- That absence is the whole verb, and it only works because of how much the rest of\n	-- the game does the opposite. Every other destination in AGES arrives as a gold disc\n	-- with a beam pointing at it and the distance written on the waypoint -- the shift,\n	-- the lure, the job post. A child has spent ten years being led by the hand. This is\n	-- the one lesson that lets go, and the skill being tested is the only one a town can\n	-- honestly test: do you know where anything is.\n	--\n	-- Nothing here names a place. The destinations are drawn from the live place graph at\n	-- the moment the lesson starts, so a town that grows grows the subject with it and a\n	-- place renamed in Studio is never a lesson pointing at somewhere that no longer\n	-- exists. See GeographyService.\n	Hunt = {\n		-- Destinations in one lesson. Three, which at the leg lengths below is a lesson of\n		-- roughly the same ninety seconds a quiz is -- and, more to the point, three is\n		-- enough for a bad first guess to be recoverable and few enough that each one still\n		-- counts for a third of the grade.\n		-- Safe range: 2-5. Above ~5 the lesson outlasts the walk home.\n		Stops = 3,\n\n		-- How far apart consecutive destinations may be, in studs. The town is about 930\n		-- studs across and a schoolchild walks at 16, so the far end of this band is a\n		-- twenty-eight second leg and the near end about twelve.\n		--\n		-- A band rather than a maximum, and the minimum is the important half: without it\n		-- the draw happily picks the shop next door, and a lesson made of three ten-stud\n		-- hops is not a lesson about a town. With it, a hunt walks a loop around a district\n		-- rather than crossing the map twice.\n		-- Safe range: 120-300 and 350-650, low below high.\n		MinLegStuds = 200,\n		MaxLegStuds = 450,\n\n		-- How near a destination counts as arriving. Looser than a classroom's attend\n		-- radius on purpose: a place point sits behind a counter or inside a doorway, and\n		-- being made to find the exact tile after already finding the building is precision\n		-- for its own sake -- the walk was the lesson and it is already over.\n		-- Safe range: 8-25.\n		ArriveRadiusStuds = 14,\n\n		-- How far above or below the spot the lesson started from a destination may be\n		-- and still be drawable, in studs.\n		--\n		-- This is the upstairs test. The city's fifty-six first-floor apartments are\n		-- place points like any other, sixteen studs up, and every one of them is a\n		-- stranger's home behind a door with no sign on it. A verb that gives you a name\n		-- and no marker can only be played by a player who can *see* the destination from\n		-- the street, so a place you have to already know the way into is not a\n		-- destination -- it is a riddle. Ground-floor shop interiors are well inside this\n		-- and stay drawable, which is right: the mall is findable from outside.\n		-- Safe range: 5-12. Above ~16 the upstairs flats come back.\n		MaxRiseStuds = 8,\n\n		-- The most a stop the clock ran out on can still be worth, as a share of one\n		-- found, scaled by how much of the way there the player actually got.\n		--\n		-- Without this the lesson has four possible scores -- none, one, two or three of\n		-- three -- and a player who was thirty studs from the bookstore when time went\n		-- scores exactly what a player who never left the school scores. That is the\n		-- undifferentiated-outcome trap, and the fix has to be in the verb's own units,\n		-- which are distance: credit is the fraction of the original gap closed at the\n		-- player's nearest approach. It is not a speed bonus and must never become one --\n		-- getting there fast earns nothing extra, because wandering is what the subject\n		-- is for.\n		-- Safe range: 0.3-0.6. At 1 a near miss pays the same as arriving.\n		MissedCreditCap = 0.5,\n\n		-- How often a running hunt re-reads where the player is standing. Matches\n		-- School.TickSeconds because it is the identical proximity job.\n		-- Safe range: 0.1-0.5. Above ~0.5 arrival visibly lags the footstep.\n		TickSeconds = 0.25,\n\n		-- How long each destination may take before the lesson gives up on it and moves on.\n		-- Sixty seconds is nearly four times the longest leg, so this only ever fires on a\n		-- player who is genuinely lost -- which is the honest failure for this verb.\n		--\n		-- Moving on rather than ending, deliberately: a missed stop scores nothing and the\n		-- lesson continues. A verb whose failure state is \"the activity stops\" punishes by\n		-- waiting, which is the one consequence shape we have ruled out everywhere else.\n		-- Safe range: 30-120. Below ~30 a wrong first guess cannot be recovered from.\n		SecondsPerStop = 60,\n\n		-- How long the line about the stop you just reached holds before the next name is\n		-- given. The same beat a lesson's verdict gets and for the same reason: arriving is\n		-- the payoff and a payoff with no pause is one nobody registers.\n		-- Safe range: 1-4.\n		ArrivedSeconds = 2,\n\n		-- What each mastery rung tells you, on top of everything the rungs below it told\n		-- you. This is the entire reward of the subject and it is deliberately not a\n		-- number: a level does not make you walk faster or score more, it makes the town\n		-- legible. That is Bully's map markers, which is the best reward in that game, and\n		-- it is the one progression a player feels as the world changing rather than as a\n		-- statistic moving.\n		--\n		-- Must be exactly School.Mastery.Levels long, checked at require time in\n		-- GeographyService for the same reason Science's RevealedStepsByLevel is: a rung\n		-- the verb has no answer for is a promotion that visibly does nothing.\n		--\n		--   name    -- the place's own label, and nothing else. Level one is being told\n		--              \"the pages & press\" and having to know that is the bookstore.\n		--   area    -- roughly where in town it is, as a compass sector from the school.\n		--   bearing -- an arrow at the top of the screen pointing at it. Direction only.\n		--   range   -- how far away it is, which with the arrow is very nearly the guide\n		--              line the rest of the game gives away for free.\n		--\n		-- The fifth rung adds nothing to the list because the fifth rung is the exit: it\n		-- tops the subject out and buys the right to skip, which is what every subject's\n		-- top rung buys.\n		RevealedByLevel = { \"name\", \"area\", \"bearing\", \"range\", \"range\" },\n	},\n\n	-- Content limits, enforced at server start rather than found in play. The answer\n	-- count is Enact's, because these are Enact's pads and a fifth of them crowds the\n	-- fan the same way whoever is asking -- and the question length is longer than a\n	-- choice label because a question is read from a HUD row rather than off the floor.\n	-- Safe range: 60-160.\n	MaxAnswers = Config.Enact.MaxChoices,\n	MaxAskLength = 96,\n}\n\n-- Science. The first subject with a verb of its own rather than a question with the\n-- word \"science\" written above it.\n--\n-- The shape is Bully's: every subject is a different *thing you do*, not a different\n-- question set, and passing buys the right to skip rather than the right to do it\n-- again. What Science does is run a procedure -- a board names an ordered list of\n-- stations, you walk the room clicking them in order, and each click stacks a step on\n-- a bench. Nothing is scored until you commit the bench, so the whole stack is undoable\n-- right up to that moment; that is the commit-and-undo pair every activity here owes.\n--\n-- Two benches run at once against a shared set of stations, which is where the load\n-- comes from: the second procedure is not twice the work, it is the same work with the\n-- room contested. Reagents are the traversal forcer -- steps spend from a shared pool\n-- and the cupboard is across the room -- and mastery does not raise a number, it shows\n-- you more of the board at once, so a level is felt as fewer walks back to read it.\n--\n-- Nothing in here restates a verdict share or a smarts payout. A procedure's score is\n-- a 0-1 share like a lesson's, so it lands on Config.School's GoodShare/OkShare and\n-- SmartsPer*Lesson and there is deliberately no second ladder to keep in step.\n\n-- Passive bonuses a life earns when a subject reaches mastery level 5 (cleared).\n-- Applied as a reduction to `minSmarts` on jobs that have both `minSmarts` and a\n-- gate for that subject. A life with smarts 50 and science level 5 hires for a\n-- job that asks for smarts 50 and science = 3, even though the raw number is\n-- exactly at the line -- the perk pushed it just over.\n--\n-- C decides which subjects get perks and at what level; B consumes them.\n-- Map entry keyed by subject id; absent key means no perk for that subject.\n-- Empty until C fills it in, and empty means `{}`. This was written as\n-- `{ [undefined] = nil }` to say \"nothing here yet\", which is not what it says to Lua:\n-- `undefined` is an unbound global, so the key is nil, and a nil key in a table\n-- constructor is a hard \"table index is nil\" thrown while Config's own module body is\n-- running. Every service in both places requires this file, so nothing in the game --\n-- not one service, in the lobby or the game place -- ever loaded. The player still got a\n-- character, because Roblox spawns that itself, which is why the symptom was \"I spawn\n-- normal size and cannot play\" rather than an error naming Config.\n-- `WorkService` reads this with a keyed lookup, so zero entries is inert, not special.\nConfig.SubjectPerks = {}\n\nConfig.School.Science = {\n	-- Benches running at once. Two, because one is a queue and three is a spectacle you\n	-- watch rather than a room you work: with two, every trip to a station is a choice\n	-- about which procedure it serves, and that choice is the whole mechanic.\n	-- Safe range: 1-3. At 1 there is no contention and this is a fetch quest.\n	Benches = 2,\n\n	-- The second bench does not open until the first procedure is this far along, so the\n	-- opening seconds teach the verb before they test it.\n	-- Safe range: 0.2-0.5. Above ~0.5 the second bench cannot be finished in time.\n	SecondBenchAtShare = 0.3,\n\n	-- The shortest procedure worth authoring. Four is long enough that order matters --\n	-- below it there is no sequence to get wrong, only a list to tick off. The ceiling is\n	-- MaxSteps, further down, and there is deliberately only one of those: two separately\n	-- tunable maximums is how a content check ends up quietly enforcing the looser one.\n	-- Safe range: 3-6, and below MaxSteps.\n	StepsMin = 4,\n\n	-- How long a procedure stands before the bench spoils and scores itself where it is.\n	-- Sized so an unmastered player crossing the room to re-read the board can finish\n	-- one bench comfortably and two only by planning the order of their trips.\n	-- Safe range: 50-120. Below ~50 the cupboard trip alone eats the clock.\n	SecondsPerProcedure = 80,\n\n	-- Speed is a multiplier on the score, never the score itself, and it has a floor: a\n	-- correct procedure committed on the buzzer is still worth most of a correct\n	-- procedure. Full credit needs this share of the clock still unspent at commit.\n	-- Safe range: Floor 0.6-0.85, FullShare 0.25-0.5. A floor of 0 makes a slow-but-right\n	-- run worthless, which punishes the player who is learning the room.\n	SpeedFloorFactor = 0.7,\n	SpeedFullShare = 0.4,\n\n	-- Reagents. Every step spends from one shared pool, refilled at a cupboard that is\n	-- deliberately not next to either bench. Twelve charges against a 4-8 step procedure\n	-- means roughly one cupboard trip per procedure and about one every fifty seconds\n	-- with two benches running -- close enough to the forty-to-sixty window that the room\n	-- never goes quiet, without the trip becoming the activity.\n	--\n	-- Shared rather than per-bench on purpose: it is the second thing the two procedures\n	-- have to fight over, and it is the one that makes committing a bench early a real\n	-- decision rather than always the safe one.\n	-- Safe range: Charges 8-20, ChargesPerStep 1-2, Refill 1.5-4.\n	SupplyCharges = 12,\n	ChargesPerStep = 1,\n	CupboardRefillSeconds = 2,\n\n	-- How much of the board you can see at once, by mastery level. This is requirement\n	-- six and the only progression the verb has: the player does not get faster hands or\n	-- a bigger number, they get to hold more of the procedure in their head at a time,\n	-- and they feel it as trips to the board that stop being necessary. At level one\n	-- three steps is one comfortable walk; by level five the whole longest procedure is\n	-- on screen and the board is furniture.\n	--\n	-- The length of this list is also the level ceiling -- ScienceService reads\n	-- `#RevealedStepsByLevel` rather than holding a separate maximum -- so adding a sixth\n	-- number here adds a sixth level and nothing else has to be told.\n	-- Safe range: rising, first 2-4, last at or above the longest authored procedure.\n	RevealedStepsByLevel = { 3, 4, 5, 6, 8 },\n\n	-- Escalation is deliberately *not* a station count that grows with mastery, which is\n	-- what this block held first. The lab is one room built once and shared by everyone\n	-- standing in it -- two players at different levels cannot be in differently furnished\n	-- versions of the same place -- so every station stands from the start, and the space\n	-- escalates by which stations a *procedure* sends you to. A nine-year-old's four-step\n	-- errand walks past five machines it never touches, which is also what a school lab\n	-- actually looks like.\n\n	-- What a pass is and how many buy a level both live on School.Mastery now, because\n	-- every subject climbs the same ladder and two ladders drifting apart would mean a\n	-- procedure and a quiz disagreeing about what \"mastered\" is. What is still Science's\n	-- own is what a level *buys*, which is RevealedStepsByLevel above -- and the length of\n	-- that list must equal School.Mastery.Levels, which ScienceService asserts at require\n	-- time rather than trusting.\n\n	-- Room and reach. The board is read from further away than a station is clicked from,\n	-- because reading is not an interaction and standing in the doorway squinting is a\n	-- legitimate way to play. Station reach is tight enough that two stations can stand\n	-- near each other without either answering for the other.\n	-- Safe range: Station 3-5, Bench 4-6, Board 5-9, Cupboard 3-5, Room 30-60.\n	StationRadiusStuds = 4,\n	BenchRadiusStuds = 5,\n	BoardRadiusStuds = 7,\n	CupboardRadiusStuds = 4,\n	-- 20, down from 40. This is the number the whole school was sized around: at 40 the art\n	-- stations sit up to 40 studs from the centre, which forced a 99-stud room band on every\n	-- floor and made ten other rooms into corridors so that one could have its walk.\n	--\n	-- The walk still costs real seconds -- 20 studs at a school-age walkspeed is over a second\n	-- each way, and the point was always that fetching paint is a decision rather than free, not\n	-- that it is a hike. Safe range: 14-28.\n	RoomRadiusStuds = 20,\n\n	-- How often the server re-checks players against benches, stations and the cupboard.\n	-- Matches School.TickSeconds because it is the identical proximity job.\n	-- Safe range: 0.1-1.\n	TickSeconds = 0.25,\n\n	-- How long a committed bench holds its result before it clears and re-lays. The same\n	-- beat as a lesson's verdict and for the same reason: the run has to be legible\n	-- before the next one starts.\n	-- Safe range: 2-6.\n	VerdictSeconds = 3.5,\n\n	-- A handful of procedures carry one step flagged `volatile` -- reaching it before its\n	-- predecessor is a genuinely dangerous mis-order, not just a wrong one, and commitBench\n	-- answers that with a small explosion at the bench rather than only a lower score. By\n	-- owner instruction: \"if ur options are to mix 2 things and it says could cause an\n	-- explosion, a small explosion should happen.\" `content/Procedures.luau`'s own header\n	-- forbade \"a result that goes bang\" -- this narrows that rule rather than breaking it,\n	-- the same way CLAUDE.md's \"combat is allowed\" narrows what 13+ actually forbids: the\n	-- explosion is cosmetic only (BlastPressure 0, so no damage and no knockback to\n	-- anything standing nearby), small, and never named after a real dangerous chemical\n	-- combination -- Procedures.luau stays entirely abstract furniture language, as it\n	-- already was.\n	-- Safe range: BlastRadius 4-10, HeightStuds 1-3.\n	ExplosionBlastRadiusStuds = 7,\n	ExplosionHeightStuds = 2,\n\n	-- Content limits, enforced at server start rather than found in play. A step label is\n	-- shorter than a question because it is read off a board in a list rather than a HUD\n	-- row, and ten steps is where the walk stops being a plan and becomes a memory test.\n	-- Safe range: MaxSteps 6-12 and above StepsMin, MaxStepLabelLength 16-40.\n	MaxSteps = 10,\n	MaxStepLabelLength = 28,\n\n	-- Where the lab's furniture stands, as fractions of RoomRadiusStuds rather than as\n	-- studs, so widening the room moves everything in it and nothing has to be re-measured.\n	--\n	-- The arrangement is the mechanic in physical form and the fractions are not\n	-- arbitrary. The board and the cupboard are on *opposite* sides, because the two\n	-- errands the verb forces -- go and re-read, go and refill -- have to be different\n	-- journeys or the player batches them into one and neither costs anything. The\n	-- benches sit between them on the cross axis so that every commit is a decision made\n	-- in the middle of the room rather than on the way past something else. The stations\n	-- ring the outside, further out than any of it, because they are the steps and the\n	-- steps are what the player should be spending their walking on.\n	Build = {\n		-- Safe range: 0.4-0.7 each, Station above both. Station at or above 1.0 puts a\n		-- step outside the room the player is held in and ends the lesson mid-procedure.\n		BoardDistanceShare = 0.55,\n		CupboardDistanceShare = 0.55,\n		BenchDistanceShare = 0.35,\n		StationDistanceShare = 0.75,\n\n		-- Bearings, in degrees clockwise from the room's forward. Board and cupboard face\n		-- each other across the room; the benches take the cross axis. Written out rather\n		-- than derived so a builder rearranging the room can see the whole layout in four\n		-- numbers.\n		BoardBearing = 0,\n		CupboardBearing = 180,\n		FirstBenchBearing = 90,\n		BenchBearingStep = 180,\n\n		-- How far off a station may be nudged when the floor refuses its first spot, as a\n		-- share of the room radius, and how many rings out are tried. Some floor is\n		-- better than a station that does not exist -- a missing station is a procedure\n		-- that cannot be finished, which is the one failure the player cannot play\n		-- around. Safe range: 0.05-0.2, 2-5.\n		StationRetryShare = 0.1,\n		StationRetries = 3,\n\n		-- Placeholder furniture, in studs. Sized so a bench reads as something you stand\n		-- at and a station as something you reach, from across a forty-stud room, and\n		-- deliberately blocky: these are stand-ins for models a builder drops in later,\n		-- and anything prettier here would only be harder to throw away.\n		-- Safe range: 2-6 wide, 1-4 tall.\n		StationSize = Vector3.new(2.6, 3, 2.6),\n		BenchSize = Vector3.new(6, 3, 3),\n		CupboardSize = Vector3.new(3.5, 6, 2),\n		BoardSize = Vector3.new(10, 6, 0.6),\n\n		-- How far away a station's own name label can still be read. Shorter than a shop\n		-- sign because it is not deciding whether you walk over -- the board already did\n		-- that -- it is confirming which thing you arrived at.\n		-- Safe range: 30-90.\n		LabelMaxDistanceStuds = 60,\n	},\n}\n\n-- Art. The study: a small picture is pinned to the wall of the room and you copy it,\n-- cell by cell, onto a canvas.\n--\n-- The line that makes this a different subject from Science rather than the same one\n-- with paint on it: **Science hides the board and asks you to remember. Art shows you\n-- everything and asks you to notice.** The wall is always in the room, the canvas is\n-- always on screen, and neither is ever annotated -- nothing marks a cell as wrong,\n-- ever. The verb is the comparison, and the day a feature helpfully outlines the cells\n-- that do not match is the day this subject stops existing.\n--\n-- Which is why the picture moves. A study that sat still would be a form to fill in, so\n-- part of every study is allowed to shift while you paint -- the light turns, somebody\n-- nudges the fruit -- and cells you have already painted quietly stop being right. You\n-- are told how many have gone stale and never which, so the two things worth doing at\n-- any moment are \"paint an empty cell\" and \"go and find the one that changed\", which is\n-- the two-queue requirement arriving from a single rule rather than from a second bench.\n--\n-- Signing is the commit and it is a real decision, unlike the lab's. Your score is the\n-- canvas at the moment you sign, and the canvas rots while you hold it -- so finishing\n-- is a trade between covering more of the picture and keeping what you have.\n--\n-- Nothing in here restates a verdict share or a smarts payout. A canvas scores a 0-1\n-- share exactly as a procedure and a quiz do, and lands on Config.School's GoodShare /\n-- OkShare and SmartsPer*Lesson.\nConfig.School.Art = {\n	-- The canvas, in cells. Sixteen is the number where the picture is still a picture --\n	-- a harbour with a sail and a hull in it -- and the painting is still about eighty\n	-- clicks including repairs, which is a ninety-second lesson at a comfortable pace\n	-- rather than a typing test.\n	--\n	-- Both numbers are load bearing on the content: every study in content/Studies is\n	-- authored as exactly Rows strings of exactly Columns letters, and changing either of\n	-- these without redrawing all five pictures errors at require time by design.\n	-- Safe range: 3-6 each. At 8x8 a lesson is four hundred clicks.\n	Columns = 4,\n	Rows = 4,\n\n	-- How long the canvas may be worked on before it is taken away and scored as it\n	-- stands. Longer than a quiz because there are sixteen cells to visit rather than\n	-- five questions, and short enough that the last thirty seconds are spent choosing\n	-- what to fix rather than idly touching up a finished picture.\n	-- Safe range: 60-180. Below ~60 nobody at two tubes can cover the canvas at all.\n	SecondsPerCanvas = 120,\n\n	-- How often something in the study is allowed to move, and how many cells go at once.\n	--\n	-- This is the pacing of the whole subject. At eighteen seconds a two-minute canvas\n	-- shifts about six times, so roughly a third of the lesson is spent repairing -- enough\n	-- that ignoring it loses the grade, few enough that the picture is still recognisably\n	-- the thing you started copying. One cell at a time rather than two, because a shift\n	-- you have to hunt for is the mechanic and a shift that redraws half the wall is just\n	-- the wall being replaced.\n	-- Safe range: 12-30 and 1-2. Below ~12 the canvas rots faster than anyone can paint.\n	ShiftSeconds = 18,\n	ShiftCells = 1,\n\n	-- Strokes in the pot, and how near the supply cupboard you have to get to fill it.\n	--\n	-- The traversal forcer, and it is a shared pot rather than one per tube on purpose:\n	-- per-tube supply would quietly delete this requirement at the top of the ladder,\n	-- where a player holds eight tubes and therefore four times the paint. Fourteen\n	-- against sixteen cells means every canvas needs at least one trip and a canvas with\n	-- repairs in it needs two.\n	--\n	-- What the trip costs is not the seconds. It is that the study wall is behind you the\n	-- whole way there and back -- see Build.CupboardBearing -- so the shift that happens\n	-- while you are fetching paint is the one you have no idea about. That is the\n	-- difference between this errand and the lab's, which only ever costs time.\n	-- Safe range: 10-24 and 4-10. Above ~24 the cupboard never gets visited.\n	StrokesPerRefill = 14,\n	CupboardRadiusStuds = 7,\n\n	-- How near the easel you have to be to put paint on the canvas. Tight, because the\n	-- easel is the one place in the room where the study and the canvas are both in front\n	-- of you, and painting from the cupboard would make the trip free.\n	-- Safe range: 4-10. Above ~10 it starts to overlap the cupboard's own radius.\n	EaselRadiusStuds = 6,\n\n	-- How far the player may get from the middle of the room before the canvas counts as\n	-- walked away from, and the scale everything in Build is laid out against.\n	--\n	-- Half again the size of the lab, which is the one number in this block that had to be\n	-- argued for. At the lab's forty the easel and the cupboard end up about twenty-five\n	-- studs apart, which a schoolchild covers in a second and a half -- and a fetch that\n	-- takes three seconds round trip is not a pacing interrupt, it is a button with a walk\n	-- animation. At sixty the trip is closer to seven seconds of not being able to see the\n	-- wall, against a study that moves every eighteen, so going for paint genuinely risks\n	-- missing something. The room is big because the mechanic is *distance from the\n	-- picture*, and there is no other way to buy that.\n	-- Safe range: 40-90. Below ~40 the cupboard stops costing anything.\n	RoomRadiusStuds = 60,\n\n	-- How often a running canvas re-reads where the player is standing and runs its\n	-- clocks. Matches School.TickSeconds because it is the identical proximity job.\n	-- Safe range: 0.1-0.5.\n	TickSeconds = 0.25,\n\n	-- How many tubes of paint each mastery rung hands over, taken from the study's own\n	-- colours most-used first -- so rung one gives you the two the picture is mostly made\n	-- of, and the rungs above it give you the ones it is barely made of, which are exactly\n	-- the ones that make it look like the thing it is of. A sail, a hull, a highlight.\n	--\n	-- This is the entire reward of the subject, and unlike Geography's it is not\n	-- information: it is how much room you have to be wrong. At two tubes the best\n	-- possible copy of the tightest study here scores 0.835 against a GoodShare of 0.8 --\n	-- a perfect painting barely passes, and every cell you fail to reach costs you the\n	-- lesson. At the top rung the ceiling is 1.0 and there is slack in it for a corner you\n	-- never got to. That is progression widening the player's own tolerance rather than\n	-- moving a number outside the verb, and it is checked at require time in ArtService:\n	-- a first rung whose ceiling drops under GoodShare would be a subject nobody could\n	-- ever pass their way out of.\n	--\n	-- The last entry is the whole shelf rather than six, because a study may be made of\n	-- more colours than five and the top rung is also the rung that buys the right to\n	-- skip -- so it should be the one where a perfect copy is actually possible.\n	-- Must be exactly School.Mastery.Levels long.\n	-- Safe range: 2-8 each, rising, first at or above 2. At 1 there is nothing to choose.\n	PaletteByLevel = { 2, 3, 4, 5, 8 },\n\n	-- How long the closing line holds before the panel clears. The same beat every other\n	-- subject's verdict gets.\n	-- Safe range: 2-6.\n	VerdictSeconds = 3.5,\n\n	-- Where the art room's furniture stands, in the same fractions-of-the-radius terms the\n	-- lab's Build block uses, so the two rooms are re-laid the same way.\n	--\n	-- The arrangement is the mechanic, again, and it is nearly the opposite of the lab's.\n	-- There the board and the cupboard face each other so the two errands cannot be\n	-- batched. Here there are not two errands -- there is one thing you must be looking at\n	-- and one thing you must occasionally walk to, and they are put on opposite sides so\n	-- that walking to the paint turns you away from the picture.\n	Build = {\n		-- Safe range: 0.4-0.8 each, Easel below both. The easel sits nearer the wall than\n		-- the middle so the study fills the view from it.\n		WallDistanceShare = 0.7,\n		EaselDistanceShare = 0.25,\n		CupboardDistanceShare = 0.65,\n\n		-- Bearings in degrees clockwise from the room's forward, matching the lab's\n		-- convention. The wall and the cupboard face each other across the easel.\n		WallBearing = 0,\n		EaselBearing = 0,\n		CupboardBearing = 180,\n\n		-- One cell of the study wall, in studs, and the gap between them. Big because the\n		-- whole subject is reading this thing from across a room -- a wall you have to walk\n		-- up to would make every comparison a round trip and the lesson would be a\n		-- pilgrimage. At 4.5 studs a four-wide study is about twenty studs across, which is\n		-- legible from the easel at the distances above.\n		-- Safe range: 3-7 and 0.1-0.6.\n		WallCellStuds = 4.5,\n		WallCellGapStuds = 0.35,\n\n		-- How far off the floor the bottom row of the wall sits, and how thick the panels\n		-- are. Lifted so the study is at eye height from a standing child rather than\n		-- something they are looking down at.\n		-- Safe range: 2-8 and 0.2-1.\n		WallLiftStuds = 4,\n		WallDepthStuds = 0.4,\n\n		-- Placeholder furniture, in studs, in the same blocky spirit as the lab's: these\n		-- are stand-ins for models a builder drops in later.\n		EaselSize = Vector3.new(3, 5, 2),\n		CupboardSize = Vector3.new(3.5, 6, 2),\n\n		-- How far away the room's own labels can still be read. Matches the lab's.\n		-- Safe range: 30-90.\n		LabelMaxDistanceStuds = 60,\n\n		-- Hand-placed interact anchors in the school building. Each entry names an\n		-- event id from LifeEvents/School.luau and a world position (x, z) where its\n		-- tagged anchor part lives. The service reads the tag and attribute itself;\n		-- this block is the inventory so the debug path can list and relist them.\n		-- Safe range: one entry per event, positions inside the school footprint.\n		Anchors = {\n			{ eventId = \"school_notice_board\", x = -114.0, z = 42.0 },\n			{ eventId = \"school_water_fountain\", x = -138.0, z = 48.0 },\n			{ eventId = \"school_locker_note\", x = -150.0, z = 22.0 },\n			{ eventId = \"school_library_book\", x = -150.0, z = 43.0 },\n		},\n	},\n}\n\n-- The gym. A room full of machines that is also a place a life goes to spend\n-- effort on itself.\n--\n-- The swap contract the user asked for lives here in its simplest form: the\n-- world's equipment is found by tag, not by name, so whoever builds a nicer\n-- treadmill into the gym later can replace the part and keep the mechanic. The\n-- generator stamps the tag on the machine and an attribute naming which machine\n-- it is; this file is the only place the two strings are agreed.\n-- The school building itself.\n--\n-- What stood here before was a sign, a pad and three rooms hung off one point in open air.\n-- It had no walls, no floors and nothing above head height, which is why it read as a menu\n-- with a roof on rather than as somewhere a child spends twelve years.\n--\n-- This is a real building: three storeys, two wings around a double-height atrium, a\n-- glazed front, an aquatic centre and a gym attached on either side, and a running track\n-- behind it. It is laid in Luau at runtime around the school place point, exactly as the\n-- lab and the art room already were -- which is the whole reason it can exist at all\n-- without anybody regenerating the eleven megabytes of City.rbxmx that tools/ owns.\n--\n-- **Every dimension below is in studs and every one of them is a real measurement.** A\n-- Roblox character is about 5 studs tall and walks at 16 studs a second, so a corridor at\n-- 14 studs wide is a wide school corridor, a classroom at 40x32 seats a class with room to\n-- walk behind the chairs, and a floor at 18 studs is a tall storey a person can live on\n-- rather than a crawlspace. Nothing here is a number that looked nice.\n--\n-- The rooms the verbs run in -- the lab, the studio, the reading desk, the corridor -- are\n-- positioned *inside* this building rather than beside it. The building is the architecture\n-- and those are the furniture; School.RoomAt is the join, and it is the only thing that\n-- knows which room a subject happens in.\nConfig.School.Building = {\n	-- Off switch. A school that fails to lay leaves the pad, the sign and the verb rooms\n	-- exactly as they were, so this can be turned off without taking school down with it.\n	Enabled = true,\n\n	-- Whether the building is already in the map as baked geometry.\n	--\n	-- `tools/gen_school.py` runs the real builder under the boot harness and writes what it\n	-- lays into `assets/School.rbxmx`, which the project mounts. That is what makes the school\n	-- visible in Studio **without pressing Play** -- runtime geometry does not exist until a\n	-- server starts, and a map you have to run to look at is not a map.\n	--\n	-- With this true the builder still runs, because the room anchors every verb positions\n	-- against are computed *by* laying the building -- but its parts are discarded instead of\n	-- being parented into the world. One school in the map, one set of anchors in memory, and\n	-- no second copy standing inside the first.\n	--\n	-- Set false to go back to laying it at runtime, which is the right setting if the asset is\n	-- stale: `check.py` cannot tell, because a stale asset is still valid XML.\n	Baked = true,\n\n	-- Storeys, and how tall each one is.\n	--\n	-- Three because the reference has three and because a two-storey school has no reason\n	-- for the stairs to exist. Eighteen studs is deliberately generous -- a character is\n	-- about five -- so that a floor reads as a room somebody could live on rather than as a\n	-- gap between slabs, and so the atrium cut through the first two has real height in it.\n	-- Safe range: 2-4 and 14-24. Below ~14 the light panels are in your hair.\n	-- **Two floors, not three.**\n	--\n	-- Three storeys gave the atrium the proportions of a lift shaft -- a tall narrow canyon with\n	-- a locker bank staring back at you from every level -- and it needed eleven rooms to fill,\n	-- which is more rooms than this school has reasons for. Two floors is a school you can read\n	-- from the door: everything social on the ground, everything taught above it.\n	--\n	-- It also makes the atrium a double-height *lobby* rather than a shaft, which is what the\n	-- reference actually has.\n	Floors = 2,\n\n	-- **27, so the building is 54 studs tall -- exactly what it was as three storeys.**\n	--\n	-- This is the whole point and it has been got wrong three times, so: the school is meant to\n	-- be as tall as a three-storey school and have two floors inside it. Three floors of 18 was\n	-- the original and looked right from the street. Two floors of 27 is the same 54 studs.\n	--\n	-- It was briefly dropped to 15 on the reasoning that 27 studs floor-to-ceiling is 5.4 avatars\n	-- and too tall for a room. That reasoning is correct about rooms and wrong about this\n	-- building: 2 x 15 is 30 studs, which took 44% off the height of the thing and compressed the\n	-- exterior the design was built around. Tall interior volumes are the trade for a tall\n	-- building, and they are what the atrium and clerestory glazing want anyway.\n	--\n	-- Do not reduce this without also changing DepthStuds/WidthStuds, or the school stops\n	-- matching its own footprint. Floors x FloorHeightStuds must stay 54.\n	FloorHeightStuds = 27,\n\n	-- The three horizontal lines that turn a stack of boxes into a building: a base course at\n	-- the ground, a cornice at the roofline, and a parapet standing above it.\n	--\n	-- This is the same argument as the mullions, one storey up. A wall that meets the ground\n	-- with no plinth looks like it was dropped there, and a roof that simply stops has no crown\n	-- -- both read as untextured geometry however good the proportions underneath are. Real\n	-- buildings are legible because they are banded horizontally, and three bands is the\n	-- cheapest possible version of that: about forty parts for the whole elevation.\n	--\n	-- The parapet does a second job. It hides the roof slab's cut edge from anyone standing on\n	-- the plaza, which is the angle the school is nearly always seen from.\n	-- Safe range: 2-6, 1-3, 3-9 and 0.6-2.\n	-- The lobby: what is actually in the atrium.\n	--\n	-- The atrium was circulation and nothing else -- three storeys of air, a stair at each end,\n	-- a rail round the hole, and not one object. It is the first room anybody walks into and it\n	-- was the emptiest space in the building, which is the wrong way round.\n	--\n	-- The banners are the piece that matters most and the reason this is a block rather than a\n	-- few props. The atrium exists to be three storeys tall; nothing in it used that height, so\n	-- the space read as a tall room rather than as a volume. A banner hanging the full drop is\n	-- the cheapest thing that makes the height *legible* -- you read the building's scale off\n	-- the banner, not off the ceiling you are not looking at.\n	-- Safe range: 2-8, 6-14 and 0.5-0.85.\n	-- How many vertical fins run down each flank of the atrium void. They exist to give a\n	-- 54-stud wall a countable rhythm; too few and the wall is still blank, too many and the\n	-- lobby reads as a cage. Safe range: 4-10.\n	-- **How deep a walkable gallery runs across the back of the atrium on the upper floor.**\n	--\n	-- The void used to be cut to the full depth of the atrium, which meant the upper floor had\n	-- no floor anywhere over it -- and both staircases land at the back of the atrium. You could\n	-- climb a flight and arrive over a hole. The patch for that was a 20x20 landing slab floating\n	-- at the head of each flight, which is where those two platforms hanging in mid-air came from.\n	--\n	-- A gallery is the real fix and the normal way an atrium works: the hole stops short of the\n	-- back wall, and the strip that is left is continuous floor joining the two side slabs to the\n	-- corridor behind. The stairs land on it, you walk off in any direction, and the lobby keeps\n	-- its double height over the entrance where it is actually worth having.\n	--\n	-- Must be at least the stair radius plus a couple of studs, or the flight tops out under the\n	-- slab. Safe range: 10-20.\n	GalleryDepthStuds = 12,\n\n	AtriumFins = 6,\n\n	LobbyBanners = 4,\n	LobbyBannerWidthStuds = 9,\n	LobbyBannerDropShare = 0.72,\n\n	-- The desk facing the doors, seating, planting and the trophy case.\n	-- Safe range: 16-40, 2-8, 2-8 and 0-3.\n	LobbyDeskWidthStuds = 26,\n	LobbyBenches = 6,\n	LobbyTrees = 4,\n	LobbyCases = 2,\n\n	-- **How many storeys the outside pretends to have.**\n	--\n	-- The building looked better as three from the street and works better as two inside, and\n	-- those are not in conflict: an elevation is a pattern of windows and floor bands, and it\n	-- does not have to agree with where the slabs actually are. Double-height rooms behind a\n	-- three-band facade is a thing real buildings do.\n	--\n	-- So the interior is two floors of 15 and the front carries three bands of 10. Same 30 studs\n	-- of wall, three rows of windows on it.\n	-- Safe range: 2-4.\n	ExteriorBands = 3,\n\n	PlinthHeightStuds = 3.5,\n	PlinthProudStuds = 1.2,\n	ParapetHeightStuds = 5,\n	CorniceProudStuds = 1.6,\n\n	-- The slab between storeys, and the walls. Thin, because every stud of thickness is a\n	-- stud of floor area lost twice over on an interior wall.\n	-- Safe range: 0.8-2 each.\n	SlabThicknessStuds = 1.2,\n	WallThicknessStuds = 1,\n\n	-- The main block, before the wings. Wide rather than deep, so the front elevation is\n	-- what you see from the road and the building reads long rather than blocky.\n	--\n	-- These were 210x140 and both were too small, which a layout audit caught rather than a\n	-- playtest: at that depth the band of rooms along the back was 32 studs deep, and the art\n	-- room alone lays its wall and its paint cupboard 81 studs apart -- so the studio would\n	-- have stood with its cupboard through the back wall of the building. The depth is set by\n	-- the deepest thing any subject lays inside it, and that is the art room.\n	-- Brought in from 300x210, which read as a campus rather than a school and left the\n	-- building crowding its neighbours on the plot. Down about 12% across and 10% deep -- a\n	-- trim rather than a rebuild, and both still inside the range the art room forces.\n	--\n	-- **The depth is the one that cannot be cut freely.** It is set by the deepest thing any\n	-- subject lays inside it: the art room puts its wall and its paint cupboard 81 studs apart,\n	-- so at the old 140 the studio stood with its cupboard through the back wall. 190 keeps\n	-- that clear with room to spare; below about 175 it starts to bite again.\n	-- Safe range: 240-360 and 170-260.\n	WidthStuds = 228,\n	-- 194, up from 170. The hall took 28 studs and the classrooms kept every one of theirs.\n	--\n	-- The alternative was taking it out of BackBandDepthStuds, which would have made all eleven\n	-- rooms shallower to widen one space -- the trade that quietly makes a plan worse everywhere\n	-- to improve it in one place.\n	DepthStuds = 194,\n\n	-- Where the building sits relative to its place point.\n	--\n	-- The place point marks the *door*, not the middle -- it is what routes, signs and walk-tos\n	-- navigate to, so it has to stay where the map put it. But a building centred on its own\n	-- door sits half a footprint further forward than it should, which is what pushed this one\n	-- into its neighbours.\n	--\n	-- Measured rather than guessed: the map's own school centres on (-291, 146) and the\n	-- `school` place point is at (-238, 151), so the map itself puts the building about 53\n	-- studs west of the point. This follows that, which also lands the school on ground that\n	-- was already a school and is therefore known to be clear.\n	-- Safe range: -90 to 90 on both.\n	-- A hair of lift, so the school's slabs never sit at *exactly* the height of the town's.\n	-- Two surfaces at the same Y z-fight: the renderer has no way to choose between them and\n	-- the ground flickers as the camera moves. check_city calls it coplanar and its tolerance\n	-- is 0.005, so three hundredths of a stud clears it by six times over while being far too\n	-- small to see or to step up.\n	OffsetYStuds = 0.03,\n	-- Where the building sits relative to its place point. **Found by the checkers, not by a\n	-- sweep of my own** -- and that distinction is the lesson here.\n	--\n	-- The first value was derived from where Agent A's school used to stand. A then relocated it\n	-- and re-laid the roads, and the old plot became a road corridor -- so this building was\n	-- standing on a carriageway with sixteen street-lamp poles through it.\n	--\n	-- I tried to re-place it by scoring positions with my own occupancy scan. That was wrong\n	-- twice over: it read the wrong footprint out of this file, and it ignored rotation, which\n	-- is exactly backwards for a building whose walls are long thin rotated boxes. It reported a\n	-- position as clean that check_city then failed with eleven roads through it.\n	--\n	-- So this is what the real checks accept. check_city's \"no street runs through a building\"\n	-- and check_town's \"every place point has room to stand\" between them name the offending\n	-- road and the offending stud, which is better information than any approximation of mine --\n	-- E0PavS cutting 30 studs into the back wall, then a waypoint half a stud from the gym sill.\n	--\n	-- Both clean at (-128, +4). If the school is ever resized, re-run those two checkers rather\n	-- than trusting a footprint number: this file's dimensions do not describe the built extent,\n	-- because the gym, the pool hall and the campus apron all hang off the building.\n	OffsetXStuds = -128,\n	OffsetZStuds = 4,\n\n	-- The atrium: a hole cut through the first two floors behind the entrance, so walking in\n	-- puts a ceiling three storeys up rather than one. This is the single most load-bearing\n	-- number for whether the building feels big, and it is why Floors and FloorHeightStuds\n	-- are worth arguing about.\n	-- Safe range: 60-120 and 50-90, and both well inside Width/Depth.\n	AtriumWidthStuds = 90,\n	-- **The void must stop short of the corridor.**\n	--\n	-- At 66, starting 14 studs in, the atrium ran to z 80 -- straight through the corridor at\n	-- 54-70 and into the room band that starts at 70. So on the upper floor the void was cutting\n	-- away the very floor the corridor stands on, and part of the rooms behind it. That is the\n	-- structural reason the interior read as incoherent: there was a hole where the first-floor\n	-- circulation should be.\n	--\n	-- 42 puts the far edge at z 50, four studs clear of the corridor. The lobby is the space in\n	-- front of the corridor, which is what a lobby is.\n	AtriumDepthStuds = 42,\n\n	-- Corridors. Wide enough that a class emptying into one is not a queue, and wide enough\n	-- for somebody to stand across you in it with room to walk round -- which the corridor\n	-- system depends on.\n	-- Safe range: 12-20.\n	-- **A hall, not a corridor.**\n	--\n	-- Sixteen studs is a service passage: two people abreast and a wall either side, which is\n	-- what the reference photographs are not. Theirs is a room you walk through -- columns down\n	-- it, planting in the middle, sightlines to the far end -- and the single change that gets\n	-- most of the way there is width. Forty-four is wide enough for a planting bed down the\n	-- centre with a walking route each side of it.\n	--\n	-- Paid for out of the footprint, not out of the rooms: see DepthStuds.\n	CorridorWidthStuds = 44,\n\n	-- The band of rooms along the back of each floor: how deep it is, how many rooms are cut\n	-- out of it, and the wall thickness between them.\n	--\n	-- **The depth is not a taste decision.** It is set by the deepest thing any subject lays\n	-- inside one of these rooms, and that is the art room: Studio puts the study wall at 0.7\n	-- of a 60-stud radius on one bearing and the paint cupboard at 0.65 on the opposite one,\n	-- which is 81 studs apart before the walls. Anything under about 90 puts the cupboard\n	-- through the back of the building -- silently, because nothing in the tree measures a\n	-- room against the furniture another module lays in it.\n	-- Safe range: 90-130, 3-5 and 1-4.\n	-- **94, and this number is load-bearing: it is what keeps the corridor off the atrium void.**\n	--\n	-- The corridor sits between the void and the room band, and its position is derived --\n	-- `corridorZ = backZ - BAND_D - CORRIDOR_W / 2`. At 99 that put the corridor's front edge at\n	-- z 53 while the void runs to z 56, so the corridor overlapped the void by three studs. Three\n	-- studs does not sound like much and it broke two visible things at once:\n	--\n	--   * on the upper floor there is no slab over a void, so the corridor had no floor under it\n	--   * the locker bank, which is set 1.4 studs off the corridor's front wall, ended up inside\n	--     the void pressed against the lobby feature wall -- lockers embedded in the logo\n	--\n	-- At 94 the band front is 74, the corridor runs 58..74, and the void ends at 56. Two studs of\n	-- daylight. If AtriumDepthStuds or CorridorWidthStuds change, this must be rechecked:\n	-- BackBandDepthStuds <= DepthStuds - 2 - (ATRIUM_Z2 + CorridorWidthStuds + 2).\n	BackBandDepthStuds = 94,\n	-- Six slots a floor rather than four. Two floors times four was eight rooms for eleven, and\n	-- the rooms were 55 studs wide against a 99-stud band -- proportions that read as corridors\n	-- with furniture. Six gives about 36 studs each, which against that depth is a classroom.\n	RoomsPerFloor = 6,\n	RoomGapStuds = 2,\n\n	-- How far the glazing runs up each storey, as a share of the floor height. Not 1: a\n	-- ribbon of solid wall at the head and the sill is what makes glass read as a window\n	-- wall rather than as a missing wall.\n	-- Safe range: 0.5-0.85.\n	GlassShare = 0.68,\n\n	-- The front plaza: the steps, the welcome sign and the crossing outside them.\n	Entrance = {\n		-- Safe range: 40-90 and 20-50.\n		PlazaWidthStuds = 70,\n		PlazaDepthStuds = 34,\n		-- How far the canopy projects over the doors, and how high it sits.\n		-- Safe range: 8-20 and 10-18.\n		-- Shallower and much higher, because both numbers were hiding the front door.\n		--\n		-- The canopy was 14 studs up over a door 17 studs tall: the roof crossed the *top of the\n		-- opening*, so from the plaza you saw a white shelf with a dark slot under it rather than a\n		-- way in. A canopy has to clear the thing it shelters. 23 puts the soffit six studs above\n		-- the door head, and 10 studs of projection shades the entrance without turning it into a\n		-- tunnel the daylight cannot reach.\n		--\n		-- Rule for anyone changing these: CanopyHeightStuds must stay well above DoorHeightStuds.\n		CanopyDepthStuds = 10,\n		CanopyHeightStuds = 23,\n		-- Columns across the front. Six reads as a school and not a temple.\n		-- Safe range: 4-10.\n		ColumnCount = 6,\n		-- The trees down the approach, per side.\n		-- Safe range: 3-8.\n		TreesPerSide = 5,\n\n		-- How many tiers each clipped topiary is built from, and how tall they stand.\n		-- The reference's forecourt is lined with these rather than with round park trees, and\n		-- the difference is most of why that frontage reads as maintained.\n		-- Safe range: 4-9 and 26-46.\n		TopiaryTiers = 6,\n		TopiaryHeightStuds = 34,\n\n		-- The black railings along the front boundary, and how far apart the uprights stand.\n		-- The reference fences its whole frontage, which is the thing that makes the forecourt a\n		-- *forecourt* rather than the building simply stopping at the pavement.\n		-- Safe range: 0-2 and 5-12.\n		RailingHeightStuds = 9,\n		RailingSpacingStuds = 7,\n\n		-- The front doors: one wide opening rather than four separate leaves.\n		--\n		-- There were four 8-stud panels with gaps between them, which read from the plaza as a\n		-- row of windows rather than as a way in -- and the way in is the single most important\n		-- thing an entrance elevation has to communicate. One opening, two leaves, and a frame\n		-- heavy enough to be read as a frame.\n		-- Safe range: 26-50 and 14-22.\n		DoorWidthStuds = 38,\n		DoorHeightStuds = 17,\n\n		-- The apron: a shallow paved lip in front of the doors.\n		--\n		-- This replaced a raised terrace with a flight of steps up to it, which was a mistake and\n		-- worth recording as one. A civic entrance *is* raised in the reference photographs, and\n		-- that reasoning was right -- but it stopped being right the moment it was built at the\n		-- scale of a doorway. Four studs of rise across the one route into the building meant a\n		-- step to climb to get in, and cheek walls either side meant a doorway with obstacles in\n		-- it. A school entrance is somewhere a crowd walks through at once.\n		--\n		-- One stud, full frontage width, nothing to climb and nothing to walk round.\n		-- Safe range: 14-30.\n		ApronDepthStuds = 22,\n\n		-- Flagpoles either side of the approach. Two, because one is a mast and three is a\n		-- forecourt -- two is a pair of gateposts, which is what the entrance wants.\n		-- Safe range: 0-4 and 18-34.\n		Flagpoles = 2,\n		FlagpoleHeightStuds = 26,\n\n		-- The pediment: the shallow gable over the entrance bay.\n		--\n		-- This is the single most load-bearing shape in the reference photographs and it is worth\n		-- saying why. Every building in this game is a flat-topped box, because a flat top is what\n		-- an extruded floor plan gives you for free. A school in the reference reads as *civic* --\n		-- as somewhere with a front rather than merely a wall facing the road -- and almost all of\n		-- that is one triangle over the doors. It costs a dozen parts and it changes the whole\n		-- elevation.\n		-- Safe range: 26-60, 6-16 and 2-6.\n		PedimentWidthStuds = 44,\n		PedimentRiseStuds = 11,\n		PedimentSteps = 5,\n\n		-- The crest over the doors, and the welcome board under it. Both are in the reference and\n		-- both are what stop the frontage being an anonymous glazed box.\n		-- Safe range: 7-16.\n		CrestRadiusStuds = 10,\n\n		-- Blue pilaster stripes up the white elevation. The reference's facade is banded rather\n		-- than plain, and the banding is what gives a long frontage a rhythm instead of a length.\n		-- Safe range: 6-20 and 1.5-5.\n		PilasterCount = 14,\n		PilasterWidthStuds = 3,\n\n		-- Clipped hedges and lamp standards down the approach, per side.\n		-- Safe range: 2-8 and 1-5.\n		HedgesPerSide = 4,\n		LampsPerSide = 2,\n\n		-- The two wings, stepped forward either side of the entrance bay.\n		--\n		-- This is the shape that makes the reference read as a *campus* rather than as a block.\n		-- A single flat elevation, however long and however well banded, is one wall; two wings\n		-- brought forward give the approach a courtyard to walk into, and give the building a\n		-- silhouette from three-quarters on -- which is the angle a player actually arrives at,\n		-- never the head-on elevation drawings are done in.\n		-- Safe range: 34-70, 20-44 and 6-20.\n		WingWidthStuds = 48,\n		WingDepthStuds = 30,\n		WingProjectionStuds = 6,\n\n		-- The pitched roof on each wing. Stepped, like the pediment, for the same reason.\n		-- Safe range: 5-14 and 3-7.\n		WingRoofRiseStuds = 9,\n		WingRoofSteps = 4,\n\n		-- The tall clipped cones down the forecourt. The most recognisable planting in the\n		-- reference photographs and the cheapest thing on this list -- a stack of narrowing\n		-- blocks reads as topiary at any distance a player sees it from.\n		-- Safe range: 2-8, 4-8 and 14-30.\n		TopiaryPerSide = 5,\n		TopiaryTiers = 6,\n		TopiaryHeightStuds = 22,\n\n		-- Black railings along the frontage, with a gap left for the gate.\n		-- Safe range: 14-40 and 10-26.\n		RailingPosts = 26,\n		GateWidthStuds = 18,\n\n		-- Flagpoles either side of the doors.\n		-- Safe range: 0-3 and 18-34.\n		FlagpolesPerSide = 1,\n		FlagpoleHeightStuds = 26,\n	},\n\n	-- The aquatic centre, attached on one side. A pool hall with a barrel-vaulted glass roof,\n	-- which is the thing that makes it read as an aquatic centre from outside rather than as\n	-- a shed with water in it.\n	Pool = {\n		-- Safe range: 70-120 and 50-90.\n		HallWidthStuds = 96,\n		HallDepthStuds = 68,\n		-- The water itself, inside the hall.\n		-- Safe range: 50-80, 24-44 and 4-10.\n		WaterWidthStuds = 64,\n		WaterDepthStuds = 34,\n		WaterDepthBelowStuds = 7,\n		-- Lanes painted on the bottom.\n		-- Safe range: 4-10.\n		Lanes = 6,\n		-- The barrel roof: how many ribs, and how high the arch springs.\n		-- Safe range: 7-16 and 10-22.\n		RoofRibs = 11,\n		RoofRiseStuds = 15,\n		-- Spectator benches down one side.\n		-- Safe range: 2-5.\n		BenchRows = 3,\n	},\n\n	-- The gymnasium, attached on the other side. A clear-span box, because that is what a gym\n	-- is -- but a *compact* one, and that is a correction rather than a default.\n	--\n	-- It was 88 x 62 x 30 and read as an aircraft hangar with a hoop in it. A school gym is\n	-- supposed to feel like a room you can shout across: the whole point of the space is that\n	-- everyone in it is aware of everyone else, and at 88 studs across a class scatters into\n	-- it and disappears. Smaller is also what makes it work as the prom hall -- a dance floor\n	-- in the middle of a hangar is six people in a field.\n	-- Safe range: 60-90, 44-70 and 22-32.\n	Gym = {\n		WidthStuds = 72,\n		DepthStuds = 52,\n		HeightStuds = 26,\n		-- Safe range: 2-4.\n		HoopCount = 2,\n		-- Wall bars, benches and a climbing rope down the sides -- the things that make a gym\n		-- read as a school gym rather than as a sports hall. Denser than the old room was\n		-- despite being smaller, which is the whole idea of compact.\n		-- Safe range: 4-12 and 2-6.\n		WallBars = 8,\n		RopeCount = 3,\n	},\n\n	-- Prom, and every other night the gymnasium is dressed for something.\n	--\n	-- The gym is the venue on purpose. A school has exactly one room big enough to put\n	-- everybody in, and dressing *that* room -- rather than building a ballroom nobody visits\n	-- for the other three hundred days of the year -- is both what a real school does and the\n	-- only version of this that does not add a dead space to the map.\n	--\n	-- Everything here is a layer laid over the gym and taken down again, which is why it is\n	-- its own block: School.SetEvent puts it up and clears it, and the gym underneath is\n	-- untouched throughout.\n	Events = {\n		-- The dance floor, in the middle of the room.\n		-- Safe range: 24-44.\n		FloorStuds = 34,\n		-- The stage the throne sits on, at one end.\n		-- Safe range: 14-30, 6-14 and 2-5.\n		StageWidthStuds = 22,\n		StageDepthStuds = 10,\n		StageRiseStuds = 3,\n\n		-- Balloons. The single most load-bearing decoration in the reference: a room with\n		-- balloon clusters in it reads as a party from any angle, and a room without them reads\n		-- as a gym with the lights off however much else is in there.\n		-- Safe range: 4-14 and 3-8.\n		BalloonClusters = 9,\n		BalloonsPerCluster = 5,\n\n		-- The arch by the entrance, in balloons.\n		-- Safe range: 9-21 -- odd, so one balloon sits at the crown.\n		ArchBalloons = 15,\n\n		-- Streamers across the ceiling, and how many coloured spots wash the floor.\n		-- Safe range: 4-12 and 4-12.\n		Streamers = 8,\n		Spotlights = 8,\n\n		-- Folding chairs round the edge, and round tables.\n		-- Safe range: 8-30 and 3-10.\n		Chairs = 20,\n		Tables = 6,\n	},\n\n	-- The student lounge: the room the reference photographs spend the most time in, and the\n	-- one thing the school had no equivalent of at all.\n	--\n	-- It exists because a school is not only lessons. Every other room in this building is\n	-- somewhere you are sent; this is the one you *choose*, which is what makes the building\n	-- somewhere a player hangs around rather than a place they visit twice a year.\n	Lounge = {\n		-- Safe range: 6-16, 2-6 and 1-4.\n		Sofas = 8,\n		Armchairs = 6,\n		PoolTables = 1,\n		-- Safe range: 3-10.\n		DiningTables = 6,\n		Planters = 6,\n		Rugs = 3,\n		-- The wall-mounted screen.\n		-- Safe range: 12-24 and 6-12.\n		ScreenWidthStuds = 18,\n		ScreenHeightStuds = 9,\n	},\n\n	-- Vending machines. Two kinds, standing in pairs where the reference has them: the\n	-- corridor on every floor, and the lounge.\n	--\n	-- Built rather than bought, like everything else in this file -- a machine that needed a\n	-- catalog mesh is a machine that does not appear on a fresh install.\n	-- The cafeteria's back wall and its window bar.\n	--\n	-- The room already had a servery, tables, stools and bunting. What it did not have was\n	-- anything on the largest blank surface in the building -- a two-storey wall behind the\n	-- counter that every person in the room faces while they queue.\n	--\n	-- A crest on that wall is worth more than its parts for a reason the trophy case shares:\n	-- it is the only thing in the room that says the school is a *particular* school rather\n	-- than a generic one. The reference photographs put a roundel exactly there.\n	-- Safe range: 14-30 and 3-8.\n	CafeCrestRadiusStuds = 20,\n	CafeCrestRings = 4,\n\n	-- The bar along the glass, with high stools. A canteen has two kinds of seat -- tables for\n	-- groups and a counter for one person with twenty minutes -- and having only tables is what\n	-- makes a dining room read as a set.\n	-- Safe range: 8-20.\n	CafeBarStools = 12,\n\n	-- The hexagon panel on the corridor's end wall, and the washrooms off it.\n	--\n	-- Both come straight from the reference photographs and both are things the building had no\n	-- version of. The hexagons are the one piece of *pattern* in the whole school -- every other\n	-- surface is a flat colour, and a wall of tiled hexes is what stops the end of a long\n	-- corridor being a blank rectangle you are walking toward.\n	--\n	-- The washrooms matter for a duller reason: a school without them is a set. They are two\n	-- small rooms off the corridor with a row of basins and a tiled stripe, and their whole job\n	-- is to be somewhere ordinary that exists.\n	-- Safe range: 3-9, 3-7 and 4-9.\n	-- **These have to fit across a 16-stud corridor.** At 4 columns of 7 the panel needed 34\n	-- studs of depth and ran straight through the classroom walls behind it -- eight tiles buried\n	-- in the science room, eight more in cooking, and so on. Two columns of six is 12 studs and\n	-- sits inside the corridor with a margin either side.\n	--\n	-- If CorridorWidthStuds ever changes, these are the numbers that have to follow it.\n	-- Safe range: 3-9, 2-3 and 4-7.\n	HexRows = 5,\n	HexPerRow = 2,\n	HexSizeStuds = 6,\n\n	-- Safe range: 2-5 and 12-24.\n	-- How wide the single locker bay is. Wide enough to be somewhere -- the reference locker\n	-- room is a proper alcove you stand in -- and nowhere near the 226-stud wall-to-wall run\n	-- this replaced.\n	-- Safe range: 30-70.\n	-- The curved lobby stair. Radius is to the middle of the tread, sweep is how far it turns\n	-- while climbing.\n	--\n	-- A quarter turn is the useful amount: enough that the flight shows its side to the entrance\n	-- and hands you off facing the corridor, not so much that the inside treads pinch to nothing.\n	-- Radius and width together decide that pinch -- at 22 and 12 the inner edge is still 16\n	-- studs from the turn centre, which is a tread you can stand on.\n	-- Safe range: 16-30, 9-15, 60-100 and 18-30.\n	-- 16, not 22. At 22 the two flights swept x 9 to 41 each and z 25 to 57 in a lobby that is\n	-- only 90 by 42 -- they filled it, and a scan found forty-seven parts standing inside twenty\n	-- studs of a tread. A stair wants air around its foot; arriving at one through a slalom of\n	-- benches and trophy cases is worse than having no stair.\n	--\n	-- At 16 each sweep is 32 studs across, leaving an 18-stud clear route straight up the middle\n	-- from the doors to the reception desk. That route is the lobby.\n-- How far both staircases slide along the corridor, in studs. Negative is toward -X.\n	--\n	-- Clamped per flight against the atrium's edge -- see stairCentre in world/School.luau. The\n	-- flights sit flush to that edge already, so a negative shift moves the right-hand one into\n	-- open floor and leaves the left one where it is.\n	-- Safe range: -8 to 8. Past that the moving flight starts eating the bridge between the wells.\n	-- Zero. This nudged a flight clear of something it was crowding back when both stairs sat in\n	-- the middle of the atrium. They are out at the walls now, which solves that properly, and a\n	-- leftover shift only made the pair asymmetric -- one flight hard against the glass and the\n	-- other nine studs off its partner.\n	StairShiftStuds = 0,\n\n	StairRadiusStuds = 16,\n	StairWidthStuds = 12,\n	-- Ninety. A quarter is the amount that actually reads as a turn: less than that and the\n	-- arc is a straight line with a kink, which is what 80 degrees over the wrong angle range\n	-- produced -- 74 studs of travel in x and 5 in z.\n	StairSweepDegrees = 90,\n	-- 20 treads over a 27-stud storey is a 1.35-stud riser against a 1.26-stud tread -- a normal\n	-- flight, and comfortably inside the 2-stud step-up a humanoid climbs without jumping.\n	StairSteps = 20,\n\n	-- How many locker bays each floor's corridor gets, evenly spaced along it. One bay in a\n	-- 226-stud corridor is not \"structured\", it is empty; three gives the corridor a rhythm at\n	-- about a bay every 75 studs. Safe range: 2-4 -- above that they merge back into the\n	-- wall-to-wall bank this was meant to get away from.\n	LockerBays = 3,\n\n	LockerBayStuds = 46,\n\n	BasinsPerWashroom = 3,\n	WashroomWidthStuds = 18,\n\n	-- The corridor floor, and the strips over it.\n	--\n	-- This is the largest single surface in the building and it was bare tile with three small\n	-- discs on it. The reference corridors are the opposite: enormous overlapping circles of\n	-- colour, wall to wall, so the floor is the thing you notice rather than the thing you walk\n	-- across without seeing.\n	--\n	-- It is worth the parts because of what a corridor *is* here. It is the longest sightline in\n	-- the school and the space a player spends the most time in -- every lesson, every bully,\n	-- every walk to the library goes down it. A dozen discs is the cheapest possible change to\n	-- the thing seen most.\n	--\n	-- Two sizes, overlapping, in two tones. One size at one spacing reads as a pattern somebody\n	-- generated; two sizes that run into each other read as a floor somebody designed.\n	-- Safe range: 3-8, 16-34 and 10-22.\n	FloorDiscs = 5,\n	FloorDiscLargeStuds = 26,\n	FloorDiscSmallStuds = 15,\n\n	-- Ceiling strips down the length of the corridor, replacing the square panels.\n	--\n	-- A strip is what a modern school actually has, and it does something a panel cannot: it\n	-- draws a line down the corridor and gives the eye somewhere to go. A row of squares is\n	-- lighting; a continuous line is architecture.\n	-- Safe range: 6-16.\n	CeilingStrips = 10,\n\n	-- Bins. Inside on every floor and outside along the approach.\n	--\n	-- The most ordinary object a school has, and the building had none. They are worth their\n	-- parts for the same reason the loose plates in the gym are: a floor with nothing on it\n	-- anywhere reads as a render rather than as a place people use.\n	-- Safe range: 2-8 and 3-10.\n	BinsPerFloor = 4,\n	BinsOutside = 6,\n\n	-- Water fountains along the corridor. The one fixture every school has and this one had\n	-- none of.\n	-- Safe range: 1-4 per floor.\n	FountainsPerFloor = 2,\n\n	Vending = {\n		-- Safe range: 5-9, 10-16 and 2-5.\n		WidthStuds = 7,\n		HeightStuds = 13,\n		DepthStuds = 3.4,\n		-- The snack machine's window grid. Sixteen, numbered 001 upward, because the numbers\n		-- are what make it read as a vending machine rather than as a fridge.\n		-- Safe range: 3-5 and 3-5.\n		Columns = 4,\n		Rows = 4,\n		-- How near you must be to use one.\n		-- Safe range: 6-12.\n		ReachStuds = 8,\n	},\n\n	-- The running track and the field inside it, behind the building. An oval, so the corners\n	-- are real curves rather than four straights meeting at a mitre.\n	Track = {\n		-- **Off, because the map already has one.**\n		--\n		-- Agent A ships `City.RunningTrack`, carrying `FacilityKind=track`, plus SoccerField and\n		-- the SchoolFields around it. Building a second track here was duplicating another\n		-- agent's facility -- two athletics tracks in one town -- and it was the single most\n		-- expensive thing this asset did: the track, its infield and its floodlights sit entirely\n		-- *beyond* the building, from z 378 to 546, and added 176 studs of depth to a school that\n		-- was already too big to fit anywhere in the city.\n		--\n		-- Dropping it takes the school from 463 studs deep to about 245, which is the difference\n		-- between \"nowhere in the map fits this\" and \"it fits on its own plot\".\n		--\n		-- Kept rather than deleted because the geometry is good and the day the school gets a plot\n		-- big enough for its own athletics ground, this is one word.\n		Enabled = false,\n\n		-- The straight, and the radius of each turn. A real track is roughly this shape at\n		-- about a third scale, which is the scale everything in Roblox is at.\n		-- Safe range: 90-160 and 40-70.\n		StraightStuds = 120,\n		TurnRadiusStuds = 52,\n		-- Safe range: 4-8 and 3-6.\n		Lanes = 6,\n		LaneWidthStuds = 4,\n		-- How finely the curve is stepped. Higher is smoother and costs parts.\n		-- Safe range: 12-40.\n		CurveSegments = 26,\n		-- Goalposts at each end of the infield.\n		GoalWidthStuds = 24,\n		GoalHeightStuds = 10,\n	},\n\n	-- Fit-out counts. These are what make a room read as the room it is rather than as an\n	-- empty box with a sign on it, and they are the numbers to raise if the building ever\n	-- feels thin.\n	FitOut = {\n		-- Safe range: 8-24.\n		LockersPerCorridorWall = 16,\n		-- Desks per classroom, laid in rows.\n		--\n		-- **A room 99 studs deep needs rows down its length, not three at the front.** Fifteen\n		-- desks in three rows filled the first 24 studs and left seventy empty behind them --\n		-- cramped at the front and abandoned at the back, which is most of why these rooms read\n		-- as unfinished. The band is deep because the art room's cupboard walk needs 80 studs of\n		-- it, and every other room inherits that depth and has to use it.\n		--\n		-- Six rows of four is the same class laid down the room instead of across it.\n		-- Safe range: 8-30 and 3-8.\n		-- 24 in six rows. The rows divide the room's depth rather than stepping at a fixed pitch,\n	-- so in a 99-stud room they spread across the whole of it instead of huddling by the door.\n	DesksPerClassroom = 24,\n		DeskRows = 6,\n		-- Cafeteria tables, library shelves, cooking benches.\n		-- Safe range: 6-20 each.\n		CafeteriaTables = 12,\n		LibraryShelves = 10,\n		CookingBenches = 9,\n		-- Ceiling light panels per room, along each axis.\n		-- Safe range: 2-6 each.\n		LightsAcross = 3,\n		LightsAlong = 4,\n		-- The blue floor rugs the reference is full of. Purely visual and the cheapest thing\n		-- in here that makes a white tiled floor stop reading as a warehouse.\n		-- Safe range: 0-8.\n		RugsPerCommonRoom = 3,\n		-- Hedge planters, which do the same job vertically.\n		-- Safe range: 0-10.\n		PlantersPerCommonRoom = 4,\n	},\n\n	-- How far away a room\\'s name sign can still be read. Matches the lab, the studio, the\n	-- corridor and the reading room rather than inventing a fifth number.\n	-- Safe range: 30-90.\n	LabelMaxDistanceStuds = 60,\n}\n\n-- Music, and the only lesson scored on *when* you act rather than on what you choose.\n--\n-- Four lanes, notes falling down them, and one thing to be good at: being on time. Every\n-- other subject in this school asks a question -- which step, which colour, which letter,\n-- which word -- and this one asks none. That is what keeps it from being any of the other\n-- five with different furniture on the floor.\n--\n-- **The chart is sent complete, at the downbeat, and never again.** A player who can see the\n-- next four bars is reading music; a player sent one note at a time is being startled, and\n-- the difference is whether the skill being trained is anticipation or reflex. It is also\n-- the reason the second queue exists: a held note occupies a hand while the other three\n-- lanes keep arriving, so the piece is a planning problem and not a stream of prompts.\n--\n-- **What mastery buys is the windows, and this is the cleanest instance of that rule in the\n-- game.** A level-one player is judged at 25/45/80ms; a level-five player at nearly twice\n-- that. Nothing else changes -- same chart, same lanes, same tempo -- and the player can\n-- feel their own margin widen, which is exactly what the activity law asks a progression to\n-- do and exactly what a wage going up cannot.\n--\n-- The windows are grounded rather than invented: StepMania judge-4 is 22.5/45/90ms and is\n-- the reference the whole rhythm genre is calibrated against. The floor here is a hair\n-- looser than that because Roblox input is not a rhythm-game input stack, and the ceiling\n-- is deliberately generous rather than merciful -- a mastered subject should feel *easy*,\n-- because the reward for mastering it is being allowed to stop attending.\n-- PE: the graded sports drill.\n--\n-- Every other subject pays smarts into academics. This one pays **health into athletics**,\n-- and that is the entire reason it is on the timetable rather than being a separate\n-- activity. `docs/school_and_sports.md` is explicit: *\"PE -- a graded sports drill. Do not\n-- build a separate PE minigame; this is the join between the two systems and it is what\n-- makes school carry the childhood years.\"* A PE class that awarded smarts would be a\n-- lesson wearing a tracksuit.\n--\n-- **The meter is the golf three-click**, which that document ranks first of twelve input\n-- primitives: *\"Zero RNG, every input owns one variable. The most reusable meter in all of\n-- gaming, and the overswing zone is free risk/reward.\"* One click starts the marker, the\n-- second sets power, the third sets accuracy:\n--\n--   click 1   the power marker starts sweeping\n--   click 2   locks power at the marker. Past OverswingFrom you get more power *and* a\n--             faster accuracy sweep -- the risk is bought with the reward, not rolled for\n--   click 3   locks accuracy against a centre window\n--\n-- It is deliberately a different problem from the gym's single timing window. The gym asks\n-- \"can you hit a moving target\"; this asks \"how much are you willing to make that harder\n-- for yourself\". A player who has mastered the treadmill knows nothing yet about this.\n--\n-- Built here rather than inside PEService so the soccer build can take the same numbers:\n-- this meter is the sports input primitive, and PE is its first customer rather than its\n-- owner.\n-- The other students.\n--\n-- The school had nobody in it. Teachers spawn for a lesson and bullies stand in the\n-- corridor, and that was the entire population of a building with fourteen rooms -- so\n-- every reference photograph of the genre is full of people and ours was an empty set with\n-- the lights on. A school is *other children*; that is what the word means.\n--\n-- Modelled on StadiumCrowdService, which already solved the hard half of this, and the two\n-- lessons it learned are the two that matter:\n--\n-- 1. **A rig is a web call.** NPCService.Spawn goes through\n--    Players:CreateHumanoidModelFromDescription, so a cap and a per-tick budget are not\n--    tuning, they are the difference between a school and a server that stalls on the first\n--    player to walk through the gate.\n-- 2. **Top up on a tick, never spawn once.** Streaming and failed builds lose rigs silently,\n--    and a missing student is not something a player reports -- it is something they never\n--    know was supposed to be there.\n--\n-- Everyone here is spawned **at the player's own age**, the way BullyService does it. That\n-- one argument is what makes them schoolmates rather than adults loitering in a corridor,\n-- and it is the whole difference between a school and a bus station.\n-- Sitting down, on L.\n--\n-- The school has sofas, bleachers, benches and a couple of hundred cafeteria stools in it and\n-- there was no way to be on any of them, which made all of that furniture scenery. One key,\n-- and what happens depends on what is near you: next to a bench you sit on the bench, in the\n-- middle of a corridor you sit where you stand.\nConfig.Sit = {\n	-- How far a seat can be and still be the one you meant. Generous enough that you do not\n	-- have to stand precisely, tight enough that it never picks a chair through a wall.\n	-- Safe range: 4-10.\n	ReachStuds = 7,\n\n	-- How far above a seat's surface the character's root sits. A Roblox root is at about hip\n	-- height, so this is what stops a sit either sinking into the bench or hovering over it.\n	-- Safe range: 1.5-3.5.\n	HipHeightStuds = 2.4,\n\n	-- How far above or below your own hips a surface may be and still count as a seat. This is\n	-- the check that stops \"BenchBase\" -- a skirting board at ankle height -- and the top of a\n	-- wall from both reading as somewhere to sit.\n	-- Safe range: 2-6.\n	MaxRiseStuds = 4,\n}\n\nConfig.School.Crowd = {\n	-- How many students at once, and how many of those are walking rather than standing.\n	-- Fourteen reads as a busy corridor without asking for fourteen web calls at once.\n	-- Safe range: 6-24, and Roaming below Max.\n	Max = 14,\n	Roaming = 6,\n\n	-- How many empty slots one tick may start filling. Low on purpose: the caps above can be\n	-- asking for the whole crowd the moment a player loads in, and firing all of them at once\n	-- is exactly the web-call burst the stadium's own budget exists to avoid.\n	-- Safe range: 1-3.\n	SpawnPerTick = 2,\n\n	-- How often the pool is re-examined.\n	-- Safe range: 1-4.\n	TickSeconds = 2,\n\n	-- How near the building a player must be for the school to be populated at all. Beyond\n	-- this the crowd is torn down: a full cohort of rigs standing in an empty building on the\n	-- other side of the map is pure cost.\n	--\n	-- Generously larger than the building so students are already there as you walk up rather\n	-- than popping in around you, which is the tell that a crowd is spawned rather than alive.\n	-- Safe range: 200-500.\n	NearStuds = 320,\n\n	-- How far a standing student may drift from the spot they were given, so a row of them\n	-- does not read as a shelf of dolls.\n	-- Safe range: 3-12.\n	ScatterStuds = 7,\n\n	-- How far away a student's name tag can still be read.\n	--\n	-- Short on purpose. A label readable across the atrium turns the building into a wall of\n	-- floating text, and the point of these is that you find out who somebody is by walking over\n	-- to them -- which is also what makes the clique rooms worth the trip.\n	-- Safe range: 30-90.\n	LabelDistanceStuds = 55,\n\n	-- Roamers, walking the building between rooms.\n	-- Safe range: 8-16, and 2-10 seconds.\n	WalkSpeed = 11,\n	PauseMinSeconds = 3,\n	PauseMaxSeconds = 9,\n}\n\nConfig.School.PE = {\n	-- Attempts per drill. Enough that one fluffed shot is not the lesson, few enough that the\n	-- class stays inside the 90-150s the school spec allows a period.\n	-- Safe range: 4-10.\n	Attempts = 6,\n\n	-- How long the power marker takes to cross the bar, and the accuracy marker after it. The\n	-- accuracy sweep is faster because it is the one being defended: an accuracy sweep as slow\n	-- as the power one would make overswing free.\n	-- Safe range: 1.4-3 and 0.9-2.\n	PowerSweepSeconds = 2.0,\n	AccuracySweepSeconds = 1.35,\n\n	-- What overswinging costs: the accuracy sweep runs this much faster. At 1.5 the window is\n	-- the same width in studs and 50% shorter in time, which is the honest way to make a choice\n	-- expensive -- it does not shrink the target, it shortens the clock.\n	-- Safe range: 1.15-2.\n	OverswingSpeedup = 1.5,\n\n	-- Where the overswing zone starts, as a share of the power bar.\n	-- Safe range: 0.7-0.92.\n	OverswingFrom = 0.8,\n\n	-- The accuracy bands, as shares of the bar, before fitness widens them. Centred, unlike\n	-- some of the gym's machines: a shot you are aiming is aimed at the middle.\n	-- Safe range: 0.1-0.3 and 0.03-0.12.\n	GoodFraction = 0.22,\n	PerfectFraction = 0.08,\n\n	-- How much the bands widen at full health, as a share of their own width. The same\n	-- mechanism as Config.Gym.HealthWindowBonus and for the same reason: progression that\n	-- lives in a readout is progression you cannot feel. A fit character's window is visibly\n	-- wider than an unfit one's.\n	-- Safe range: 0-1.\n	HealthWindowBonus = 0.5,\n\n	-- **The kindest rule in the spec, and it is stolen deliberately.** A missed accuracy click\n	-- does not score zero -- it falls back to the character's own fitness. From the ranked\n	-- primitives: *\"missing it falls back to your ratings rather than failing outright. The\n	-- kindest failure design in sports games. Steal this rule specifically.\"*\n	--\n	-- A miss at 0 health scores MissFloor of the power spent; at full health, MissFloorFit. So\n	-- a fit character is never humiliated by one bad click, and an unfit one has a reason to\n	-- train. Safe range: 0-0.3 and 0.2-0.6, MissFloorFit above MissFloor.\n	MissFloor = 0.08,\n	MissFloorFit = 0.38,\n\n	-- What a band multiplies the power by.\n	-- Safe range: 0.5-0.85 and 1 -- Perfect should not exceed the power actually spent.\n	GoodMultiplier = 0.7,\n	PerfectMultiplier = 1.0,\n\n	-- How near the drill you must stay. Walk further and the class is over, graded on what you\n	-- did -- the same walk-out rule every other subject has.\n	-- Safe range: 30-80.\n	ReachStuds = 55,\n\n	-- The pass mark, and how much it rises per mastery rung. **This is the \"rising threshold on\n	-- the same minigame\" the school spec asks for** -- level 5 is not a new drill, it is the\n	-- same drill wanting more of it. Five rungs at 0.06 takes the bar from 0.45 to 0.69, which\n	-- is demanding without ever being unreachable.\n	-- Safe range: 0.3-0.6 and 0-0.1.\n	PassShare = 0.45,\n	PassSharePerLevel = 0.06,\n\n	-- How far the value a click claims may sit from where the server's own marker was when it\n	-- arrived, as a share of the bar.\n	--\n	-- The click carries a *value* rather than a moment, which is right -- see RequestPEClick --\n	-- but it means a client could simply claim a perfect one. This is the bound on that. At\n	-- 0.25 on a 2s sweep it forgives about half a second of ping and lag-spike, and refuses a\n	-- claim that could not have come from the bar the player was looking at.\n	--\n	-- A refused click is *dropped*, not scored as a miss: punishing a genuine lag spike with a\n	-- failed attempt is how a fair rule becomes the thing players hate. Safe range: 0.12-0.4.\n	ClickTolerance = 0.25,\n\n	-- How often the drill is re-examined: the walk-off check and the clock.\n	-- Safe range: 0.15-0.5. Its own rather than shared with another subject's, because a tick\n	-- rate borrowed from elsewhere is a number that changes when somebody tunes a different\n	-- lesson.\n	TickSeconds = 0.25,\n\n	-- How long a drill may run before it is called, in seconds. A backstop for a player who\n	-- opens the meter and walks away from the keyboard rather than out of the field.\n	-- Safe range: 120-360.\n	TimeoutSeconds = 240,\n\n	-- The three drills, cycled so a year of PE is not one shot repeated. They differ in the\n	-- shape of the problem rather than its difficulty, which is the rule the gym's four\n	-- machines follow:\n	--\n	--   penalty   the teaching drill. Slow, wide, forgiving. Learn the three clicks.\n	--   cross     fast power, generous accuracy. Rewards committing early.\n	--   freekick  slow power, tight accuracy. Rewards not overswinging at all.\n	Drills = {\n		{\n			id = \"penalty\",\n			label = \"Penalties\",\n			line = \"Six from the spot. Start the meter, set your power, then place it.\",\n			powerScale = 1.0,\n			accuracyScale = 1.0,\n			windowScale = 1.15,\n		},\n		{\n			id = \"cross\",\n			label = \"Crossing\",\n			line = \"Six from the wing. The power runs quick -- commit before it looks right.\",\n			powerScale = 0.72,\n			accuracyScale = 1.1,\n			windowScale = 1.0,\n		},\n		{\n			id = \"freekick\",\n			label = \"Free kicks\",\n			line = \"Six over the wall. All the time in the world for power, none for placing it.\",\n			powerScale = 1.25,\n			accuracyScale = 0.78,\n			windowScale = 0.85,\n		},\n	},\n}\n\nConfig.School.Music = {\n	-- Lanes. Four, and it is the number the whole genre settled on for one hand: three is not\n	-- enough for a pattern to have shape and five needs a thumb doing two jobs.\n	-- Safe range: 4-5.\n	Lanes = 4,\n\n	-- How long a lesson runs, and how often it is looked at. The tick is slow because nothing\n	-- here moves on the server: the chart is fixed at the downbeat and the client owns every\n	-- frame of it. This clock only ends the lesson.\n	-- Safe range: 70-150 and 0.2-1.\n	SecondsPerLesson = 105,\n	TickSeconds = 0.25,\n\n	-- The judgement windows, in milliseconds, at mastery level one and at the top of the\n	-- ladder. Every level in between is interpolated.\n	--\n	-- Each list must be exactly Mastery.Levels long and MusicService errors at require time if\n	-- it is not -- the same guard Art keeps on its palette and Reading on its takebacks, and\n	-- for the same reason: a rung that buys nothing is a level-up the player is told about and\n	-- cannot feel.\n	-- Safe range: ascending, and Perfect < Great < Good at every level.\n	PerfectMsByLevel = { 25, 30, 36, 42, 48 },\n	GreatMsByLevel = { 45, 52, 60, 68, 76 },\n	GoodMsByLevel = { 80, 90, 100, 112, 124 },\n\n	-- What each judgement is worth, as a share of a perfect note. A miss is zero and costs\n	-- nothing else: the score is what you hit, never a penalty for what you did not, which is\n	-- the soft-failure rule every activity here runs on.\n	-- Safe range: 1, 0.5-0.85, 0.2-0.5.\n	PerfectScore = 1,\n	GreatScore = 0.7,\n	GoodScore = 0.35,\n\n	-- How far past a note the server will still accept a hit for it, in milliseconds. Wider\n	-- than the widest Good window on purpose: the client is measuring against its own clock\n	-- and a strict equality here would reject honest hits from a player on a bad connection.\n	-- It is a sanity bound, not a second judgement.\n	-- Safe range: 200-500.\n	AcceptMs = 320,\n\n	-- The chart.\n	Chart = {\n		-- Milliseconds per beat. 500 is 120bpm, which is the tempo almost every rhythm tutorial\n		-- in existence opens on because it is the one a person taps without being told to.\n		-- Safe range: 380-700.\n		BeatMs = 500,\n\n		-- How long the piece is, in beats, and how long the count-in is before the first note.\n		-- The count-in is not politeness: without it the first note arrives before the player\n		-- has found the lanes, and every chart would open on a guaranteed miss.\n		-- Safe range: 48-160 and 4-8.\n		Beats = 96,\n		CountInBeats = 4,\n\n		-- The chance a beat carries a note at all, and the chance a note that exists is a hold.\n		-- Under one so the piece breathes: a note on every beat is a drum roll, and a drum roll\n		-- has no rhythm in it to read.\n		-- Safe range: 0.5-0.85 and 0.05-0.25.\n		NoteChance = 0.68,\n		HoldChance = 0.14,\n\n		-- How many beats a hold lasts.\n		-- Safe range: 2-6.\n		HoldBeats = 3,\n\n		-- The chance a beat carries a *second* note in another lane. This is the second queue\n		-- and it is what makes the piece a planning problem: two lanes at once means choosing\n		-- which hand goes where a bar early.\n		-- Safe range: 0.1-0.35. Above ~0.35 it stops being music and becomes a wall.\n		ChordChance = 0.22,\n\n		-- How many beats into the piece before chords and holds are allowed to appear. A piece\n		-- that opens on its hardest figure teaches nothing, because the player has not yet\n		-- worked out where the lanes are.\n		-- Safe range: 8-24.\n		RampBeats = 16,\n	},\n\n	-- The music room fit-out: where the player stands to play, and how near they have to be.\n	Build = {\n		-- Safe range: 14-30.\n		RoomRadiusStuds = 18,\n		-- Safe range: 0-359 and 0.2-0.8.\n		StandBearing = 0,\n		StandDistanceShare = 0.4,\n		-- Safe range: 6-14.\n		ReachStuds = 9,\n		-- Safe range: 30-90.\n		LabelMaxDistanceStuds = 60,\n	},\n}\n\n-- Reading, and the one lesson where the answer is built rather than picked.\n--\n-- Two words stand on the board with letters missing, and there is one tray of tiles\n-- between them. That is the entire design: a letter spent on the left is a letter the\n-- right does not get, so the decision is never \"which letter goes here\" -- it is almost\n-- always obvious which letter goes here -- it is *which word to spend it on*. Two queues\n-- at half load each, which the activity law says is far more engaging than one at full,\n-- and it costs one shared tray to build rather than a second minigame.\n--\n-- The technique that falls out of it, and the reason this holds up past repetition thirty:\n-- fill the word that needs the rarer letters first. Nothing teaches that and nothing says\n-- it on screen. A player who has not noticed it still finishes most lessons; a player who\n-- has finishes more of them, which is the shape a discovered optimum is supposed to have.\n--\n-- What mastery buys here is **takebacks**, and it buys nothing else. Not shorter words, not\n-- more time, not a bigger tray -- the margin you are given for being wrong, counted on\n-- screen. That is requirement six of the activity law taken literally: the progression has\n-- to widen the player\\'s own tolerance somewhere they can see it, and a wage going up would\n-- be invisible inside the verb.\n--\n-- Difficulty is the age band instead, and it lives entirely in content/Words.luau. A\n-- seven-year-old fills one gap in a four-letter word and a sixteen-year-old fills three in\n-- a nine-letter one, and neither is a different mechanic.\nConfig.School.Reading = {\n	-- How long the board may be worked before it is taken away and scored as it stands.\n	-- Between the quiz\\'s hundred seconds and the canvas\\'s two minutes, because a word is\n	-- quicker to see than a picture is to copy and slower than a question is to answer.\n	-- Safe range: 70-160.\n	SecondsPerLesson = 110,\n\n	-- How many words a full lesson is. The score is what share of these came back, so this\n	-- is the denominator of the whole subject.\n	-- Safe range: 4-10. Above ~10 the tray refills stop being a decision and become a chore.\n	WordsPerLesson = 6,\n\n	-- How many stand on the board at once. **Two, and this is the load-bearing number in the\n	-- file.** One is a conveyor belt: the tray has one claim on it and every placement is\n	-- forced. Three is not three decisions, it is one decision with more reading -- the eye\n	-- cannot hold three letter-sets against one tray, and playtests of that shape in other\n	-- games collapse into working left to right. Two is the only count where the tray is\n	-- genuinely contested and the contest is legible.\n	-- Safe range: 2-3, and 2 unless something has been measured.\n	TargetsAtOnce = 2,\n\n	-- How often the lesson is looked at, in seconds. Slow, unlike the corridor\\'s: nothing\n	-- here moves on its own except the clock, and every change comes from a tap.\n	-- Safe range: 0.2-1.\n	TickSeconds = 0.25,\n\n	-- The tray.\n	Tray = {\n		-- How many tiles are dealt at once. Has to comfortably cover the gaps standing on the\n		-- board plus enough spare that a placement is a choice rather than the only tile that\n		-- fits -- a tray with exactly the right letters in it is a tray that plays itself.\n		-- Safe range: 8-16.\n		Size = 12,\n\n		-- How many of those are decoys: letters no gap on the board currently wants. Without\n		-- these the tray is an answer key and the lesson is dragging tiles in the only order\n		-- they go. With too many it is a search, and searching is not what this subject is\n		-- about -- the pressure is meant to come from the tray being *shared*, not from it\n		-- being cluttered.\n		-- Safe range: 2-6, and always below Size minus the largest gap count in content.\n		Decoys = 4,\n\n		-- How near the shelf you must be to draw a fresh tray, and how near the desk you must\n		-- be to place a tile. Both borrowed from the art room\\'s own radii rather than invented,\n		-- so a player who has learned how close is close enough in one school room has learned\n		-- it for the other.\n		-- Safe range: 6-14.\n		ReachStuds = 9,\n	},\n\n	-- Takebacks: pulling a placed tile back out of a gap. The undo window, and the whole of\n	-- what mastery buys.\n	--\n	-- Must be exactly Mastery.Levels long, and ReadingService errors at require time if it is\n	-- not -- the same guard Art keeps on its palette ladder, and for the same reason: a rung\n	-- the verb has no answer for is a promotion the player is told about and cannot feel.\n	-- Safe range: ascending, first entry 1-2, last 4-8.\n	TakebacksByLevel = { 1, 2, 3, 4, 6 },\n\n	-- The reading room, laid around the school place point like the lab, the studio and the\n	-- corridor. Two things in it and the distance between them is the pacing: the desk you\n	-- build at, and the shelf you draw a fresh tray from when the tray is spent.\n	--\n	-- The walk is deliberately shorter than the art room\\'s. There the distance *is* the\n	-- mechanic -- fetching paint costs you sight of the picture. Here the mechanic is the\n	-- allocation at the desk, and a long walk would only interrupt it; the shelf exists so\n	-- the tray is a resource with a refill cost, not so the room is big.\n	Build = {\n		-- Safe range: 14-30.\n		RoomRadiusStuds = 20,\n		-- Where the desk and the shelf sit on that circle, in degrees, and how far out as a\n		-- share of the radius. Turned away from the lab, the studio and the corridor so four\n		-- rooms around one point do not stand inside each other.\n		-- Safe range: 0-359 and 0.3-1.\n		DeskBearing = 90,\n		DeskDistanceShare = 0.45,\n		ShelfBearing = 30,\n		ShelfDistanceShare = 1,\n\n		-- Placeholder furniture, in studs, in the same blocky spirit as the lab\\'s.\n		DeskSize = Vector3.new(7, 3, 3),\n		ShelfSize = Vector3.new(6, 7, 1.5),\n\n		-- How far away the room\\'s own labels can still be read. Matches the other three.\n		-- Safe range: 30-90.\n		LabelMaxDistanceStuds = 60,\n	},\n}\n\n-- The corridor between lessons, and the people standing in it.\n--\n-- School had one shape before this: you walked to a pad and a lesson happened. Nothing\n-- stood between the door and the desk, so the school building was a menu with a roof on.\n-- This is what fills the walk -- somebody wants something from you, and the walk is\n-- where they ask.\n--\n-- The verb is holding your nerve, and it is a stare-down rather than a fight. You hold;\n-- your nerve rises and their patience falls; you let go when you think you are above\n-- them. That is the whole input, it is one key, and the release *value* is what decides\n-- it -- so it costs nothing on a phone and nothing at 200ms of ping.\n--\n-- What makes it a decision rather than a reflex is that there are two clocks, not one.\n-- Their patience is the clock you are playing against, and the bell is the clock you are\n-- playing under: standing your ground takes seconds the lesson has already started\n-- spending. Backing down is free and instant and costs you the toll. That is the shape\n-- the activity law asks for -- two queues at half load rather than one at full -- and it\n-- is why this is not simply a button that pays out.\n--\n-- 13+, deliberately and throughout. This is a toll and a stare, never an assault: no\n-- gore, no injury, nobody degraded, and the player is never the aggressor unprompted. If\n-- it tips into contact at all it tips into FightService, which is already a contest with\n-- a winner that ends with somebody back on their feet.\nConfig.School.Bully = {\n	-- Off switch for the whole system, so a corridor that misbehaves in a playtest can be\n	-- taken out without unpicking the school around it. Read once per tick.\n	Enabled = true,\n\n	-- How often the corridor is looked at, in seconds. Fast, because this is the only tick\n	-- in school that a player is holding a key through: the two bars move against each\n	-- other on this clock, and a coarse one would make the release land somewhere other\n	-- than where the player watched it land.\n	-- Safe range: 0.05-0.2. Above ~0.2 the bar visibly steps.\n	TickSeconds = 0.1,\n\n	-- The years anybody is in the corridor at all. Starts above School.StartAge because a\n	-- six-year-old being shaken down is not the game this is: the corridor is a teenage\n	-- pressure, and the early years are left as the uncomplicated ones on purpose.\n	-- Safe range: 10-13, and never below School.StartAge.\n	MinAge = 11,\n	MaxAge = Config.School.EndAge,\n\n	-- How near a bully has to be before they step across you, and how far you have to get\n	-- for them to lose interest. Two numbers rather than one so leaving is not a coin\n	-- balanced on the edge of the radius you arrived through -- a single distance makes the\n	-- encounter re-trigger while you are walking away from it.\n	-- Safe range: 10-20 and 22-40, and Release must exceed Engage by at least 8.\n	-- How near the school a bully stands around waiting to be walked past.\n	--\n	-- **They used to not exist until you were on top of them.** A bully was spawned the instant\n	-- the player crossed EngageRadiusStuds, which meant a rig appeared out of nothing an arm's\n	-- length away -- and, worse, meant the corridor held no information. You could not see who\n	-- was down there, so you could not decide anything about it; the only way to find out a\n	-- station was occupied was to already be in the encounter.\n	--\n	-- Now they loiter. The stations their tier makes live are occupied for as long as you are in\n	-- the building, so the corridor is something you *read* from the far end: that is the second\n	-- queue the activity law asks for, and it costs nothing extra because the escalation already\n	-- decides which stations are live. Walking the long way round is now a real option, and an\n	-- option a player invents themselves is worth more than one the game offers.\n	--\n	-- Generously wider than the engage radius so they are already standing there as you come in\n	-- rather than popping in around you, which is the tell that a crowd is spawned rather than\n	-- alive. Matches the school crowd's own reasoning.\n	-- Safe range: 150-400.\n	LoiterNearStuds = 260,\n\n	-- How often the loiterers are topped up. Slower than the encounter tick because nothing\n	-- here is per-frame: a station that stands empty for two seconds after a life ends is not\n	-- something anybody can see.\n	-- Safe range: 1-5.\n	LoiterTickSeconds = 2,\n\n	EngageRadiusStuds = 14,\n	ReleaseRadiusStuds = 28,\n\n	-- Seconds before the same bully steps across the same player again. Long enough that\n	-- walking the corridor twice in a lesson is not two shakedowns, short enough that it is\n	-- not a once-a-day event you forget exists.\n	-- Safe range: 45-180.\n	CooldownSeconds = 90,\n\n	-- The stare-down itself.\n	Nerve = {\n		-- Where your nerve starts, as a share of the bar, before the Nerve stat moves it.\n		-- Deliberately not zero: a child who has never stood up to anybody still has some,\n		-- and starting at the floor would make the first encounter unwinnable rather than\n		-- hard, which is the difference between a challenge and a wall.\n		-- Safe range: 0.1-0.35.\n		BaseShare = 0.18,\n\n		-- How much of the bar LifeData.bullyNerve is worth at its ceiling, added to\n		-- BaseShare.\n		-- Kept under half so the stat is an advantage and never a guarantee: a maxed player\n		-- who releases badly still loses, which is requirement six done honestly -- the\n		-- progression widens your margin, it does not play the game for you.\n		-- Safe range: 0.15-0.4.\n		StatShare = 0.3,\n\n		-- How fast nerve climbs while the key is held, in share per second.\n		-- Safe range: 0.2-0.5. Above ~0.5 the bar outruns the eye.\n		RisePerSecond = 0.34,\n\n		-- The release window, as a share of the bar above their patience. This is the band\n		-- the player is aiming to let go inside, and it is what LifeData.bullyNerve widens --\n		-- physically, on screen, the way Stardew grows the fishing bar. A stat that only\n		-- moved a hidden multiplier would be invisible inside the verb, which the law names\n		-- as the failure to avoid.\n		-- Safe range: 0.08-0.2 and 0.1-0.3, and Max must exceed Min.\n		WindowMinShare = 0.12,\n		WindowMaxShare = 0.24,\n\n		-- What holding past their patience costs. The bar keeps climbing after they have run\n		-- out, and letting go up there is overcommitting -- you did not face them down, you\n		-- made a scene. Kept above 1 so the bar has somewhere to go: an overhold has to be\n		-- visible as *too far*, not as the bar simply stopping.\n		-- Safe range: 1.1-1.5.\n		OverholdCeilingShare = 1.25,\n	},\n\n	-- How each drain in Types.BullyDrain actually falls. These are the numbers that make\n	-- three opponents out of one verb, so they are the numbers to move when the corridor\n	-- stops teaching -- not the patience lengths, which only make it longer.\n	Drain = {\n		-- How much faster the bluffer's patience falls than a steady one. Faster on purpose:\n		-- the whole lie is that the window looks like it is arriving early.\n		-- Safe range: 1.2-1.8.\n		BlufferRate = 1.45,\n\n		-- Where the bluffer's patience jumps back, and by how much. Once, ever, per\n		-- encounter -- a bluff that repeated would be a pattern to wait out rather than a\n		-- thing to learn, and the second time it happened the player would simply stop\n		-- releasing until it was over.\n		-- Safe range: 0.25-0.45 and 0.15-0.35.\n		BlufferJumpAt = 0.34,\n		BlufferJumpBy = 0.22,\n\n		-- How much of your own nerve rise the mirror subtracts from their patience. Above 1\n		-- so that leaning harder genuinely brings the window forward faster than you are\n		-- climbing toward it -- which is what makes holding the wrong answer against this\n		-- one, and it is the only opponent here where that is true.\n		-- Safe range: 1.1-2.0.\n		MirrorFactor = 1.5,\n	},\n\n	-- Whether overholding against somebody you have already faced down tips into a real\n	-- fight. This is the physical layer, and it is deliberately the only door into one:\n	-- you cannot start a fight in the corridor, you can only fail to end a stare-down with\n	-- somebody who already knows you will not back off.\n	--\n	-- FightService owns what happens next, which is already a 13+ contest with a winner --\n	-- no gore, a stagger rather than damage, and everybody back on their feet at the end.\n	-- If it refuses for any reason the overhold simply resolves as an overhold, so this can\n	-- be turned off without leaving a hole in the corridor.\n	TipsIntoFight = true,\n\n	-- The second clock. Standing your ground costs seconds, and the lesson has already\n	-- started spending them -- this is what stops the corridor being free upside.\n	Bell = {\n		-- Real seconds of grace from the bell before the lesson counts you late. Matches the\n		-- ~30 seconds the school design settles on, and is deliberately generous: the\n		-- consequence for lateness is loss of upside, never punishment-by-waiting.\n		-- Safe range: 20-45.\n		GraceSeconds = 30,\n\n		-- What arriving late costs, as a share of the lesson score. One segment's worth, so\n		-- a player who won the corridor and walked in late has traded one thing for another\n		-- rather than lost the afternoon.\n		-- Safe range: 0.1-0.3.\n		LateScoreShare = 0.2,\n	},\n\n	-- What they take when you back down, and what it costs you.\n	Toll = {\n		-- Lunch money, in the same currency as everything else. Small and frequent is the\n		-- rule: this should sting for a moment, not reset your week.\n		-- Safe range: 3-15.\n		Money = 6,\n\n		-- Backing down costs a little confidence and standing up buys a little. Both small,\n		-- because the corridor is a texture the whole of school runs on, and a texture that\n		-- moved stats hard would out-earn the lessons it is supposed to be framing.\n		-- Safe range: -3 to 0, and 0 to 3.\n		HappinessOnBackDown = -1,\n		HappinessOnStandUp = 2,\n\n		-- How much a faced-down bully moves LifeData.bullyNerve, and how much backing down\n		-- does.\n		-- Asymmetric on purpose: you learn more from the one you stood up to, and the one you\n		-- walked away from should not be a ladder you can slide down -- see School.Mastery for\n		-- the same rule stated about subjects.\n		-- Safe range: 1-4 and -1 to 0.\n		NerveOnStandUp = 2,\n		NerveOnBackDown = 0,\n	},\n\n	-- Your homework, which is the consumable that makes the corridor generate its own\n	-- pacing. A bully who takes it has not failed your lesson -- they have put a walk\n	-- between you and the top of it, and the walk is to the library. Burst, traversal,\n	-- burst, for the price of one flag on a profile.\n	Homework = {\n		-- How many rungs of the next lesson the missing homework costs. One, so it is a real\n		-- loss that a single detour undoes.\n		-- Safe range: 1-2.\n		LevelPenalty = 1,\n\n		-- Real seconds at the library desk to redo it. Short: this is the chorus between two\n		-- verses, not a third activity.\n		-- Safe range: 6-20.\n		RedoSeconds = 10,\n	},\n\n	-- Stepping in when they are working somebody else. The positive half of the system and\n	-- the reason it is not only a tax: a classmate you stood up for is a classmate who\n	-- knows you, which is the ties ladder being fed by school rather than beside it.\n	Intervene = {\n		-- How near the pair you must be for the three-dot to offer it.\n		-- Safe range: 8-18.\n		RadiusStuds = 12,\n\n		-- What winning on somebody else's behalf is worth in bond. Higher than what winning\n		-- for yourself is worth in nerve, deliberately: the game should pay better for the\n		-- harder, kinder choice, and this is the only place in school where one player's\n		-- afternoon can improve another person's.\n		-- Safe range: 2-8.\n		BondOnWin = 5,\n	},\n\n	-- How the corridor gets harder, and it is the space that changes rather than the\n	-- numbers. At the bottom they stand in the open where you can see them from the door;\n	-- as your reputation rises they take the chokepoints; at the top they come in pairs and\n	-- hold both ways round. Spatial escalation forces re-planning, and a bully with more\n	-- hit points would not.\n	-- Safe range: 2-5 tiers, standUps ascending, stations within Build.StationCount.\n	--\n	-- `paired` is where the second clock comes from. At a paired tier a second bully starts\n	-- walking the moment the first steps across you, and when they arrive the release\n	-- window shrinks to its narrowest whatever your nerve is -- so the release has to land\n	-- after the window opens and before it closes. Two clocks at half load each, which is\n	-- the shape the activity law asks for and the reason this is not one bar with a bigger\n	-- number on it at the top tier.\n	BackupSeconds = 3.2,\n\n	Tiers = {\n		{ standUps = 0, stations = 1, paired = false, label = \"in the open\" },\n		{ standUps = 3, stations = 2, paired = false, label = \"at the corner\" },\n		{ standUps = 7, stations = 3, paired = true, label = \"both ways round\" },\n	},\n\n	-- The corridor itself, laid around the school place point exactly as the lab and the art\n	-- room are. Built in Luau at runtime rather than shipped as geometry, which is what lets\n	-- the school grow without anybody regenerating an eleven-megabyte asset.\n	Build = {\n		-- How far out from the school point the corridor runs, and how wide. Longer than the\n		-- art room is across, because the length *is* the mechanic: a corridor you can cross\n		-- in two steps has no chokepoint in it and nowhere for a second bully to stand.\n		-- Safe range: 40-90 and 10-20.\n		LengthStuds = 64,\n		WidthStuds = 14,\n\n		-- How many places along it somebody can stand. Must be at least the largest\n		-- Tiers[].stations above, or the top tier asks for a station the corridor does not\n		-- have -- which is checked at require time rather than discovered on a spawn.\n		-- Safe range: 3-6.\n		StationCount = 3,\n\n		-- Which way the corridor runs from the point it is handed, in degrees, and how far\n		-- along before the first station.\n		--\n		-- 270 is +x, which is straight along the school building\\'s own hallway -- the corridor\n		-- is handed the left-hand end of it and measures forward. This used to be 210 and an\n		-- arbitrary bearing off the place point, which was right when the corridor was laying\n		-- its own hallway in open air and is wrong now that there is a building with a corridor\n		-- already in it.\n		-- Safe range: 0-359 and 12-30.\n		BearingDegrees = 270,\n		StartOffsetStuds = 22,\n\n		-- Placeholder furniture, in studs, in the same blocky spirit as the lab's and the\n		-- studio's: stand-ins for models a builder drops in later.\n		LockerSize = Vector3.new(2.5, 7, 1.2),\n		BenchSize = Vector3.new(6, 1.6, 2),\n\n		-- How many lockers line each wall. Cosmetic, and the only thing in this block that\n		-- is: the corridor has to read as a school rather than as a box with people in it.\n		-- Safe range: 4-20.\n		LockersPerWall = 10,\n\n		-- How far away the corridor's own labels can still be read. Matches the lab's and the\n		-- studio's rather than inventing a third number that would drift from them.\n		-- Safe range: 30-90.\n		LabelMaxDistanceStuds = 60,\n	},\n}\n\n-- The fixtures you can press E on: machines, fountains, doors.\n--\n-- **The design problem here is that a button which pays out is not a mechanic.** A vending\n-- machine that gives happiness for a keypress is an idle payout pad with a nice mesh, and\n-- docs/activity_design_law.md is explicit that those are the thing to avoid. So every one of\n-- these is a *trade*, and the trade is what makes it a decision:\n--\n--   The snack machine costs money. Money is earned, so spending it on two points of mood is a\n--   real choice against everything else money buys.\n--\n--   The coffee machine costs more and takes a point of health with it. It is coffee and sugar\n--   before a lesson: a genuinely two-sided deal rather than a smaller reward.\n--\n--   The fountain is free, and therefore has the smallest effect and the longest wait. Free\n--   and unlimited would be the payout pad; free and slow is a breather.\n--\n-- The cooldowns are per fixture kind and live only for the session. That is deliberate: they\n-- exist to stop a player standing at one machine pressing E, not to be an economy. Rejoining\n-- clears them, and farming two points of happiness across a rejoin is not a thing anybody\n-- will do twice.\nConfig.Fixtures = {\n	-- How near you must be for the server to accept the press, and how near the prompt lights\n	-- up. **The first must be larger than the second, and getting that backwards is a bug with\n	-- no error message.**\n	--\n	-- It was: prompt at 30, reach at 10. So the E appeared from three machine-lengths away, you\n	-- pressed it, and the server silently refused because you were outside its own radius --\n	-- which from the player's side is a prompt that does nothing, the worst possible failure\n	-- because it teaches them the whole system is broken.\n	--\n	-- Now the prompt is the tighter of the two. The server stays a little more generous so a\n	-- press that was legal when it left the client is not refused for a step taken during the\n	-- round trip.\n	-- Safe range: 10-20 and 8-16, with Reach the larger.\n	-- 24, and it must stay above PromptDistanceStuds below. This is the server's own check that\n	-- the player is really next to the thing they claim to be using; the prompt distance is what\n	-- the client draws. If the prompt were the larger of the two, a player would get a keypress\n	-- offered to them that the server then silently refuses -- which reads as the fixture being\n	-- broken rather than as them being too far away.\n	ReachStuds = 24,\n	-- 18, up from 12. This has to be comfortably less than ReachStuds (the server's own check)\n	-- and comfortably more than the distance a player actually stands from a fixture. A door\n	-- leaf's centre is half the door's height off the ground -- about 11 studs up on the\n	-- entrance -- so somebody standing right at it is already 8 or 9 studs away in a straight\n	-- line before they have moved back at all, and 12 made the prompt flicker in and out at the\n	-- one fixture in the building people use most.\n	PromptDistanceStuds = 18,\n\n	Kinds = {\n		snack = {\n			label = \"Snack machine\",\n			action = \"Buy\",\n			cost = 3,\n			happiness = 2,\n			health = 0,\n			cooldownSeconds = 45,\n			notice = \"A packet of something orange. Worth it.\",\n			broke = \"No change. The machine does not take promises.\",\n		},\n		coffee = {\n			label = \"Coffee machine\",\n			action = \"Buy\",\n			cost = 5,\n			happiness = 3,\n			-- The point of health is the whole design. See the header.\n			health = -1,\n			cooldownSeconds = 45,\n			notice = \"Hot, sweet, and mostly sugar. You feel great and slightly worse.\",\n			broke = \"The card reader blinks red at you.\",\n		},\n		-- The front doors. No cost, no cooldown and no stat: this one is a door, and the reward\n		-- for opening a door is that it is open. Listed here anyway so it goes through the same\n		-- prompt, reach check and dispatch as everything else -- a second path for one fixture\n		-- would be two things to keep working.\n		door = {\n			label = \"Front doors\",\n			action = \"Open\",\n			cost = 0,\n			happiness = 0,\n			health = 0,\n			cooldownSeconds = 0,\n			notice = \"\",\n			broke = \"\",\n		},\n		fountain = {\n			label = \"Water fountain\",\n			action = \"Drink\",\n			cost = 0,\n			happiness = 1,\n			health = 0,\n			-- Twice the wait, because it is free. Free and fast would be the payout pad.\n			cooldownSeconds = 90,\n			notice = \"Cold, and the arc is slightly too short. Familiar.\",\n			broke = \"\",\n		},\n	},\n\n	-- How far the front doors swing, and how long they take.\n	-- Safe range: 60-110 and 0.3-1.2.\n	DoorSwingDegrees = 85,\n	DoorSwingSeconds = 0.6,\n\n	-- What the cooldown says when you are early. One line, because a refusal that explains\n	-- itself once is information and a refusal that explains itself every time is nagging.\n	TooSoon = \"Not just yet.\",\n}\n\nConfig.Gym = {\n	-- The room itself, laid in code around the gym place point.\n	--\n	-- The equipment in this game has always been *found* rather than built: GymService walks\n	-- CollectionService for parts tagged AgesGymEquipment and reads a GymKind off each. That\n	-- is a good design and it is not changing -- but it meant the gym only existed if somebody\n	-- had hand-placed four parts in Studio, and on a fresh place there was nothing there at\n	-- all.\n	--\n	-- So this lays a real gym and tags what it lays. GymService does not know the difference:\n	-- a bench built here and a bench dragged in by hand arrive down the same signal. Anything\n	-- hand-placed keeps working exactly as it did.\n	--\n	-- Modelled on a powerlifting floor rather than a health club: racks and platforms down one\n	-- side, benches in the middle, cardio along the glass, dumbbells on the wall. Compact and\n	-- dense on purpose -- the reference is a room where every square foot has iron on it, and\n	-- that reads as a serious gym in a way a sparse one never does.\n	Build = {\n		-- **Smaller than the reference on purpose.** The Power Lifters floor in the reference\n		-- photographs is a warehouse -- two storeys of air, a running track's worth of concrete,\n		-- and equipment scattered far enough apart that the far wall is a different room. That\n		-- reads as impressive in a screenshot and as empty to walk through, which is the exact\n		-- mistake the school gymnasium already had to be corrected for.\n		--\n		-- So this keeps the reference's *character* -- brick, pendants, racks on platforms,\n		-- colour-coded plates -- at about half its floor area. Same iron, less walking. A gym is\n		-- meant to feel crowded and slightly too warm.\n		-- Safe range: 70-110 and 48-80.\n		WidthStuds = 86,\n		DepthStuds = 60,\n		-- Still tall, because a rack is 8 studs and the room has to have air above it -- but a\n		-- single storey rather than the reference's two.\n		-- Safe range: 15-22.\n		HeightStuds = 17,\n\n		-- Squat racks on platforms down the back, benches in front of them, treadmills along\n		-- one wall, dumbbell racks along the other. These counts are the whole of how full the\n		-- room looks.\n		-- Counts come down with the room, but by less than the floor area does -- that is what\n		-- makes it denser rather than merely smaller. Every kind GymService implements still has\n		-- at least two of it, so a busy server never has one machine for the whole floor.\n		-- Safe range: 3-8, 3-8, 3-8 and 2-5.\n		Racks = 5,\n		Benches = 4,\n		Treadmills = 4,\n		DumbbellRacks = 2,\n\n		-- The lifting platform under each rack.\n		-- Safe range: 9-16 and 7-12.\n		PlatformWidthStuds = 11,\n		PlatformDepthStuds = 9,\n\n		-- Pendant lights on the ceiling, in a grid. The reference is lit by dozens of small\n		-- hanging lamps rather than by panels, and that alone is most of why it reads as a\n		-- warehouse gym instead of a school corridor.\n		-- The lamp grid stays dense as the room shrinks: the reference reads as a warehouse gym\n		-- because of dozens of small hanging lights, and thinning them in proportion to the floor\n		-- would trade away the one thing worth keeping.\n		-- Safe range: 4-10 and 3-8.\n		LightsAcross = 6,\n		LightsAlong = 4,\n\n		-- A mirrored wall down one side, which is the other half of what a gym looks like.\n		-- Safe range: 0.4-0.9.\n		MirrorShare = 0.7,\n\n		-- How far away the room's own labels can still be read. Matches the school's.\n		-- Safe range: 30-90.\n		LabelMaxDistanceStuds = 60,\n	},\n\n	-- The tag a part carries to be read as gym equipment, and the attribute\n	-- naming the machine: \"treadmill\", \"bench\", \"dumbbells\", \"pullup\". A kind\n	-- the service has no routine for is refused at load, not in play.\n	EquipmentTag = \"AgesGymEquipment\",\n	GymKindAttribute = \"GymKind\",\n\n	-- How near a machine you must be to use it. Slightly tighter than a person's\n	-- reach, because a machine is a thing you stand at rather than a conversation\n	-- you stand in. Safe range: 4-10.\n	ReachStuds = 6,\n\n	-- A workout is a deliberate hour, not a button you can hammer: after one, the\n	-- machine is spent for the rest of the game year. Nil-able by the day's end\n	-- logic if a year ever needs it, and the reason it exists is that a machine\n	-- with unlimited reps is a stat button, which is not a life.\n	--\n	-- Safe range: 1-5. At 1 a gym session is once a year per machine and the room\n	-- has about as many sessions as school has lessons.\n	WorkoutsPerYear = 2,\n\n	-- Stamina. A session-local bar that drains per rep and penalises misses.\n	-- Push-your-luck: go for every rep and you finish with nothing left; miss\n	-- early and you lose the last rep or two.\n	--\n	-- Both live here rather than on the machine because they describe the body,\n	-- not the equipment: a missed lift and a missed pull-up tire you the same way.\n	MaxStamina = 100,\n	MissStamina = 5,\n\n	-- How much the sweet zone widens as health climbs, as a share of the machine's\n	-- own base width, at Config.Stats.Max health.\n	--\n	-- This is the whole reason the gym is worth repeating. Progression used to be a\n	-- health number that lived entirely outside the verb: a character at 90 health\n	-- had exactly the same timing window as one at 10, so getting fitter changed a\n	-- readout and nothing you could feel. Now the bar you are aiming at physically\n	-- grows, and you can see your own margin widen between one workout and the next.\n	--\n	-- At 0.6 a maxed character's window is 1.6x a beginner's -- a large, legible\n	-- difference that still leaves the hardest machine demanding at full health.\n	-- The Perfect band widens by the same share, so the ratio of Perfect to Good\n	-- holds and fitness never turns the machine into a single undifferentiated\n	-- target. Safe range: 0-1. At 0 the window is fixed and requirement 6 is gone.\n	HealthWindowBonus = 0.6,\n\n	-- The four machines.\n	--\n	-- Every field is stated by every machine, deliberately: these used to share one\n	-- set of numbers and one `gradeFor(progress)` that never saw which machine it\n	-- was grading, so the treadmill and the bench press ran byte-identical code and\n	-- differed only in the string on the panel. Four machines wearing one minigame\n	-- is not four machines.\n	--\n	-- What separates them is the shape of the timing problem, not its difficulty:\n	--\n	--   sweepSeconds   how long the needle takes to cross the bar\n	--   sweetCenter    where on the bar the zone sits -- NOT always the middle\n	--   sweetFraction  the zone's width as a share of the bar\n	--   perfectFrac    the inner band, same units\n	--   curve          how the needle moves: see SHAPES in GymService\n	--\n	--   \"steady\"      constant speed. Read it and press.\n	--   \"quickening\"  creeps, then rushes. You have to commit before it looks right.\n	--   \"easing\"      rushes, then crawls. Generous, and tempts you into over-waiting.\n	--\n	-- Same one input on all four; four different things to learn. A player who has\n	-- mastered the treadmill knows nothing yet about the pull-up bar, which is the\n	-- only way one button survives a hundred repetitions.\n	Kinds = {\n		-- The teaching machine. Middle of the bar, constant speed, widest zone,\n		-- cheapest reps, most of them. Health-heavy: running is not what makes you\n		-- look good, it is what makes you last.\n		treadmill = {\n			label = \"Treadmill\",\n			curve = \"steady\",\n			sweepSeconds = 2.2,\n			sweetCenter = 0.5,\n			sweetFraction = 0.24,\n			perfectFraction = 0.09,\n			reps = 12,\n			repStamina = 7,\n			healthPerPerfect = 2,\n			healthPerGood = 1,\n			looksPerPerfect = 0,\n			looksPerGood = 0,\n		},\n\n		-- Power. Few, heavy, expensive reps against a needle that creeps and then\n		-- rushes into a late zone -- you press where you think it will be, not where\n		-- it is. Biggest single-rep payout in the room and the fastest to exhaust.\n		bench = {\n			label = \"Bench Press\",\n			curve = \"quickening\",\n			sweepSeconds = 3.0,\n			sweetCenter = 0.74,\n			sweetFraction = 0.18,\n			perfectFraction = 0.06,\n			reps = 7,\n			repStamina = 15,\n			healthPerPerfect = 3,\n			healthPerGood = 1,\n			looksPerPerfect = 1,\n			looksPerGood = 0,\n		},\n\n		-- Control. The needle arrives fast and then crawls through a middle zone, so\n		-- the window is forgiving but sitting in it invites you to wait for a Perfect\n		-- that is already behind you. The looks machine.\n		dumbbells = {\n			label = \"Dumbbells\",\n			curve = \"easing\",\n			sweepSeconds = 2.6,\n			sweetCenter = 0.52,\n			sweetFraction = 0.20,\n			perfectFraction = 0.07,\n			reps = 10,\n			repStamina = 10,\n			healthPerPerfect = 1,\n			healthPerGood = 0,\n			looksPerPerfect = 2,\n			looksPerGood = 1,\n		},\n\n		-- The hard one. Early, narrow and quickening: the zone is past before a new\n		-- player has decided to press. Pays both stats well and costs the most per\n		-- rep, so it is the machine you graduate onto rather than the one you start\n		-- on. Nothing gates it -- the timing does.\n		pullup = {\n			label = \"Pull-Up Bar\",\n			curve = \"quickening\",\n			sweepSeconds = 2.4,\n			sweetCenter = 0.34,\n			sweetFraction = 0.15,\n			perfectFraction = 0.05,\n			reps = 8,\n			repStamina = 13,\n			healthPerPerfect = 2,\n			healthPerGood = 1,\n			looksPerPerfect = 2,\n			looksPerGood = 0,\n		},\n	},\n\n	-- How long the verdict beat lasts before the next rep starts.\n	-- Long enough to read \"Perfect\" or \"Good\", short enough not to stall.\n	VerdictSeconds = 1.2,\n\n	-- How often the server ticks the sweep forward. 5-6 times per sweep\n	-- second gives smooth motion without burning budget.\n	TickSeconds = 0.18,\n\n	-- How far from a machine's centre the player must stay. Matches the\n	-- school's room radius: a gym is the same size box as a classroom.\n	RoomRadiusStuds = 20,\n}\n\n-- The stadium's ambient crowd. tools/gen_city.py builds every seat in every\n-- tier as a real `AgesStadiumCrowdSeat` anchor now -- there is no separate\n-- static-mannequin fill any more, an empty seat is just an empty seat -- plus\n-- six roam anchors per stand's concourse (`AgesStadiumCrowdRoam`), and\n-- StadiumCrowdService reads both by tag to seat and walk real NPCs through\n-- the bowl. \"The crowd looks fake\" is only avoided while the caps below stay\n-- fed, which is why StandUp* and SpawnPerTick exist alongside them.\n--\n-- The tag/attribute names here are the Luau side of a pair; the Python side\n-- is `STADIUM_CROWD_SEAT_TAG`/`STADIUM_CROWD_ROAM_TAG`/`STADIUM_CROWD_STAND_\n-- ATTR` in gen_city.py and the two literal strings must match exactly or the\n-- service finds nothing -- there is no shared source for this pair, the same\n-- way `Config.Gym.EquipmentTag` and gen_city.py's own gym tag are two\n-- independently-typed copies of one string.\nConfig.Stadium = {\n	SeatTag = \"AgesStadiumCrowdSeat\",\n	RoamTag = \"AgesStadiumCrowdRoam\",\n	StandAttribute = \"Stand\",\n\n	-- How many real NPCs are ever seated/roaming at once. A hard ceiling\n	-- rather than \"spawn one per anchor found\" for the same reason\n	-- Config.Town.MaxBodied exists: NPCService.Spawn is a web call per rig,\n	-- and nothing under it stops a caller asking for hundreds at once --\n	-- there are well over a thousand seat anchors in the bowl now (every\n	-- seat is one, see gen_city.py's `stadium_seat`). Safe range: 8-200\n	-- seated, 4-48 roaming; MaxRoamingCrowd should stay a multiple of 4 so\n	-- StadiumCrowdService.indexAnchors can split it evenly across the four\n	-- stands. Raised well past the old 40/16 now that density is not the\n	-- bottleneck any more -- SpawnPerTick below is what keeps a cap this\n	-- size from asking NPCService for all of it in one burst.\n	MaxSeatedCrowd = 120,\n	MaxRoamingCrowd = 40,\n\n	-- How fast a roaming spectator walks the concourse. Slower than a\n	-- townsperson (Config.NPC.WalkSpeed) -- someone browsing a concourse\n	-- between stands is not in a hurry to get anywhere.\n	RoamWalkSpeed = 6,\n\n	-- How long a roamer waits at each concourse stop before moving to the\n	-- next. Safe range: 3-20.\n	RoamPauseMinSeconds = 4,\n	RoamPauseMaxSeconds = 12,\n\n	-- How often the crowd is re-checked and topped back up to its caps --\n	-- a lost rig (streaming, a failed build) is rebuilt on the next tick\n	-- rather than left as a gap for the rest of the server's life. Matches\n	-- GangService's TickSeconds for the same \"not every frame, not so rare\n	-- it visibly lags\" reasoning. Safe range: 2-15.\n	TickSeconds = 5,\n\n	-- How many empty slots (seated and roaming counted together) tickCrowd\n	-- is allowed to start spawning on any one tick. MaxSeatedCrowd and\n	-- MaxRoamingCrowd together can be asking for over 150 rigs from an empty\n	-- server the moment the first player loads in, and NPCService.Spawn is a\n	-- web call per rig -- firing all of them from the same tick in one burst\n	-- of task.spawn calls is the exact overload Config.Town's own bodied-NPC\n	-- cap exists to avoid elsewhere. A low cap here does not slow the crowd\n	-- down for long: at TickSeconds=5 and 8 a tick, the bowl is full inside\n	-- a couple of minutes of a server starting, which nobody is standing in\n	-- the forecourt timing. Safe range: 2-16.\n	SpawnPerTick = 8,\n\n	-- A seated fan sometimes stands up, takes a few steps back into the row\n	-- behind their seat, and sits back down -- read independently per\n	-- occupied seat on every tick, so no two get up in step with each\n	-- other. StandUpChancePerTick is deliberately tiny: at TickSeconds=5 and\n	-- a 120-seat crowd, 0.002 means roughly one fan in the whole bowl stands\n	-- up every couple of ticks, which is already enough motion to keep a\n	-- full stand from reading as a photograph. The step is straight back\n	-- along the stand's own StandFacing direction (see below), away from\n	-- the pitch and into the gap behind the row, not a pathfind through the\n	-- packed seats either side. Safe range: chance 0.0005-0.01, step 3-8\n	-- studs, seconds 3-15.\n	StandUpChancePerTick = 0.002,\n	StandUpStepStuds = 5.0,\n	StandUpMinSeconds = 4,\n	StandUpMaxSeconds = 10,\n\n	-- Every stand's outward-facing direction, as a unit-length (x, z) --\n	-- which way a seated spectator in that stand looks to be watching the\n	-- pitch rather than the wall behind them. A seat anchor is a plain,\n	-- unrotated `box()` part (see gen_city.py), so this is the only place\n	-- that direction is recorded at all.\n	StandFacing = {\n		StandSouth = { x = 0, z = 1 },\n		StandNorth = { x = 0, z = -1 },\n		StandWest = { x = 1, z = 0 },\n		StandEast = { x = -1, z = 0 },\n	},\n\n	-- The same two colours tools/gen_city.py's STAD_SEATS paints the tiers in\n	-- (home red, alternating away pale) -- no shared source between the two,\n	-- same as the tag names above, so a change to one palette means changing\n	-- both by hand. StadiumCrowdService alternates a seated fan between these\n	-- instead of a random Townsfolk shirt colour, so the stand reads as a\n	-- crowd in kit rather than a crowd that happens to be sitting together.\n	HomeShirtColor = Color3.fromRGB(178, 46, 46),\n	AwayShirtColor = Color3.fromRGB(210, 210, 214),\n}\n\n-- The stadium's entrance moment: walking through the bowl's own gate (not the\n-- forecourt atrium's front door, which is just the building's own threshold)\n-- plays a cinematic camera beat and sends a fan over for an autograph, once\n-- per player per server session. StadiumEntranceService reads GateTag off the\n-- single invisible trigger part tools/gen_city.py's GateArch stands in the\n-- doorway (STADIUM_GATE_TAG there) -- no shared source, so the literal string\n-- must match exactly, the same arrangement as Config.Stadium's tags above.\nConfig.StadiumEntrance = {\n	GateTag = \"AgesStadiumGate\",\n\n	-- Studs from the trigger part that count as having crossed the gate. Wider\n	-- than Config.World.InteractRadius's tighter room distance on purpose: this\n	-- is a doorway a player walks straight through at a normal pace, not an\n	-- object they stop in front of, and the check has to catch a crossing that\n	-- might only be a couple of ticks wide.\n	-- Safe range: 6-14.\n	TriggerRadius = 10,\n\n	-- How often the server checks players against the gate. Cheap: one part,\n	-- checked against whoever is near the stadium. Safe range: 0.1-0.5.\n	TickSeconds = 0.2,\n\n	-- Seconds the camera takes to snap in from the normal follow shot to the\n	-- close cinematic framing. Quick, so it reads as a cut to a replay angle\n	-- rather than a slow pan catching up to something that already happened.\n	-- Safe range: 0.3-1.2.\n	ZoomInSeconds = 0.6,\n\n	-- Seconds the camera holds the close framing before releasing -- long\n	-- enough to read the fan's approach and the autograph beat; too long and\n	-- standing still stops feeling like an entrance and starts feeling like a\n	-- wait. Safe range: 2.5-6.\n	HoldSeconds = 3.5,\n\n	-- Seconds the camera takes easing back out to the normal follow shot.\n	-- Safe range: 0.4-1.5.\n	ReleaseSeconds = 0.8,\n\n	-- The held shot's framing relative to the player: how far back, how high,\n	-- and how far to the side -- a three-quarter portrait rather than a\n	-- straight-on selfie, the same angle a walkout camera holds.\n	-- Safe range: distance 5-10, height 2-5, side 1.5-4.\n	FramingDistanceStuds = 7,\n	FramingHeightStuds = 3.2,\n	FramingSideStuds = 2.4,\n\n	-- Field of view during the held shot. Roblox's default is 70; a narrower\n	-- angle is what reads as a lens actually zoomed in rather than a camera\n	-- that just moved closer with the same wide lens.\n	-- Safe range: 35-55.\n	FramingFov = 42,\n\n	-- Studs from the player the fan stops at to ask for the autograph -- mirrors\n	-- Config.NPC.ApproachStuds, kept separate because this beat is much shorter\n	-- and closer than a delivery's doorstep wait.\n	-- Safe range: 3-6.\n	FanApproachStuds = 4,\n\n	-- Seconds the fan holds the \"talk\" beat once arrived, before turning away.\n	-- Safe range: 1.5-4.\n	FanTalkBeatSeconds = 2.5,\n}\n\n\n-- People. The pillar of a life this game did not have.\n--\n-- Everybody in AGES until now was a delivery. Somebody walked in, handed over a line\n-- or a five-dollar bill, walked out, and was gone -- and the next one was drawn from\n-- the same four ids with no memory that the first had ever happened. A life made of\n-- those is a life in which nobody knows you.\n--\n-- That absence is why the empty stretches of a life are empty. A sixty-five-year-old\n-- has nothing to do not because nothing was written for them, but because there is\n-- nobody to go and see; a toddler's parents are scenery for the same reason. Work gave\n-- the middle of a life somewhere to be and school gave the first half of it. This is\n-- what gives the whole of it somebody to be there with.\n--\n-- The verb is the game's only verb. They stand somewhere, you walk up, three dots wake\n-- over their head, and you click them -- the same sentence as a dog, a hiring sign or a\n-- birthday. What is on the list those dots open is the entire mechanic: somebody who\n-- barely knows you has small talk on offer and nothing else, and somebody who does will\n-- lend you money, talk you round, or put your name in somewhere. The relationship is\n-- read off what they will do for you rather than off a number.\n--\n-- Nobody gets a sign. A hiring post and a school need one because a building cannot say\n-- what it is, but a person already has their name over their head -- the humanoid draws\n-- it -- and hanging a placard on somebody would make them premises.\n--\n-- Nothing here says who exists, where they stand or what they will do for you. That is\n-- content, in content/People.luau, for the same reason jobs and lessons are: adding a\n-- sister should be a table entry and not a tunable.\nConfig.People = {\n	-- The range a bond moves in.\n	--\n	-- The floor is shallower than a job's, deliberately. A record at work is an opinion\n	-- held by an institution and it is allowed to be brutal; the floor of a person is\n	-- how bad it gets with somebody who is still, in the end, your mother. Below this\n	-- there is nothing further for the number to say and no story in saying it.\n	--\n	-- The ceiling is high enough that a whole life of turning up is still climbing at\n	-- the end of it. Reached by roughly ten good visits from a standing start, which is\n	-- a decade -- so it is an achievement of a childhood rather than of a year.\n	-- Safe range: -40 to -8, and 60-200.\n	MinBond = -20,\n	MaxBond = 100,\n\n	-- How close you have to get before somebody has time for you. Generous compared to\n	-- a job's clock-in radius, because walking up to a person is not a precision act --\n	-- you are near them or you are not, and being made to shuffle onto an exact spot to\n	-- talk to your dad would be the game asking for something nobody would think to give.\n	-- Safe range: 5-14. Above about 14 they notice you from across a room.\n	ReachStuds = 8,\n\n	-- What a year of not turning up costs.\n	--\n	-- SET TO 0: Positives ratchet, decay dies. The design document explicitly rejects\n	-- decay-on-neglect as a trap that turns relationships into a collectible grind.\n	-- Bonds only rise when you turn up; they never fall from absence. A relationship\n	-- that survives is one you chose to maintain, not one the game forced you to.\n	-- Safe range: -6 to 0. At 0 the bond is a collectible again -- which is the point.\n	DecayPerYearAway = 0,\n\n	-- Visits per person per year.\n	--\n	-- One, and this is the number that keeps the system from becoming a chore. Without a\n	-- cap the optimal play is a lap of everybody you know every year, forever, which is\n	-- a commute rather than a choice -- and the moment a game rewards a lap, players run\n	-- laps and stop enjoying it. One visit each means the question is *who* you go and\n	-- see this year, which is the question worth asking.\n	--\n	-- The same shape as five shifts and three lessons: a year holds a little of each of\n	-- the things a life is made of, and none of them can be ground.\n	-- Safe range: 1-3. Above 3 a year is mostly spent in conversation.\n	VisitsPerYear = 1,\n\n	-- How long what they say back stays on the row before it clears. Longer than a\n	-- lesson's verdict, because this is the only writing in the game that is somebody\n	-- talking to you rather than the game explaining itself, and it is worth the beat.\n	-- Safe range: 2.5-8.\n	ReplySeconds = 5,\n\n	-- The odds a favour is turned down, at the exact moment it becomes askable.\n	--\n	-- Only offers authored as an `ask` roll at all -- see PersonOffer. Small talk is\n	-- never refused, because being told no to \"how have you been\" is not a game.\n	--\n	-- The odds need no authored number because the offer already carries one. An ask\n	-- appears the instant the bond reaches its minBond, so asking right then is asking\n	-- somebody for something they have only just become willing to consider, and that\n	-- is where a no belongs. The distance the bond has climbed *past* that figure is\n	-- the whole of how safe it has become.\n	--\n	-- A coin flip at the floor. Higher and the ask may as well not have appeared yet;\n	-- lower and there is no decision in waiting for a better year.\n	-- Safe range: 0.25-0.7. At 0 nobody ever refuses and the system is off.\n	RefuseAtFloor = 0.5,\n\n	-- How far past an offer's minBond the odds take to fade to nothing.\n	--\n	-- A good visit is worth 3 to 5, so this is six or seven years of turning up every\n	-- year -- and the asks that exist today all unlock at 45, which puts a certain yes\n	-- at a bond of 70 out of 100. Long, deliberately. The ask is never locked, so the\n	-- span is not a wait for permission; it is how long somebody takes to become the\n	-- kind of person who does not have to think about it. That is the arc worth having,\n	-- and it is what makes a bond legible without a number: the same sentence that was\n	-- a coin flip at sixteen is simply true at twenty-three, and the player learns it\n	-- by asking rather than by reading a stat.\n	-- Safe range: 12-45. Below ~12 the gamble is over before it is noticed.\n	RefuseFadeSpan = 25,\n\n	-- What a refused ask still gives back, as a share of what taking it would have.\n	--\n	-- Not zero, and this is the number that keeps asking worth doing. A refusal\n	-- already costs the visit, which at one visit a year is the whole year with that\n	-- person. If it cost the bond as well, the year would end further from the thing\n	-- than it started -- decay would eat the difference -- and the correct play would\n	-- be to never ask at all, which deletes the mechanic rather than tensioning it.\n	-- You turned up and you asked; you get the turning up.\n	-- Safe range: 0.15-0.5. At 0 asking is strictly worse than small talk.\n	RefusedBondShare = 0.3,\n\n	-- How often the world is checked for a player standing near somebody. The same\n	-- quarter-second as work and school, and for the same reason: it is the rate at\n	-- which walking into a radius feels like arriving rather than like waiting.\n	-- Safe range: 0.1-0.5.\n	TickSeconds = 0.25,\n\n	-- Where somebody stands, relative to the place point they live at.\n	--\n	-- Several people share a place -- a house has a mother and a father in it -- so they\n	-- are set out around it on a ring rather than at it, and the bearings are how many\n	-- spots on that ring are tried before giving up on fitting one more in. A person who\n	-- cannot be fitted simply is not spawned, and the debug command says so: a mother\n	-- standing inside a wall is worse than a mother who is out at the moment.\n	-- Safe range: 4-12 and 6-16.\n	StandStuds = 7,\n	StandBearings = 10,\n\n	-- How long after a life ends before the people are put back. Nothing to do with\n	-- feel: it is a beat for the death screen to be read over an empty room rather than\n	-- over four relatives standing about waiting to meet the next occupant.\n	-- Safe range: 0.5-4.\n	RespawnDelaySeconds = 1.5,\n\n	-- How many years apart two people can be and still count as each other's age.\n	--\n	-- Not a rule about who may be talked to -- everybody may -- but the definition the\n	-- game uses for \"somebody you could build a life with\", and so the thing `/town`\n	-- counts and the thing dating will read. It exists as one number in one place\n	-- because those two must never be able to disagree: a harness that says there are\n	-- four people your age, next to a world where none of them can be asked out, is a\n	-- bug report about the wrong system.\n	--\n	-- Three rather than the peer archetype's own spread of two, because a peer is not\n	-- the only person who happens to be your age -- the older kid off your street and\n	-- the youngest person at your office land here too, and they should. Wider and it\n	-- stops meaning anything: at eighteen, a coworker two decades out would start being\n	-- counted as a contemporary of yours.\n	-- Safe range: 1-6. At 0 only somebody born the same year as you counts.\n	PeerAgeGap = 3,\n\n	-- Content limits, enforced at server start rather than found in play.\n	--\n	-- The offer count and the label length are Enact's, because this is Enact's panel and\n	-- a fifth row is a menu whoever is asking. The gift ceiling is the only number here\n	-- that is really a safety catch: an authoring slip of an extra zero on a\n	-- parent's loan is not visible by reading the line, and it would quietly hand a\n	-- nine-year-old more money than a year of adult work.\n	-- Safe range: 500-5000.\n	MaxOffers = Config.Enact.MaxChoices,\n	MaxLabelLength = Config.Enact.MaxLabelLength,\n	MaxGift = 2000,\n\n	-- Walking with somebody: the \"come with me\" offer, and how the person who accepts\n	-- it moves.\n	--\n	-- The whole mechanic is one visitor trailing the player at a fixed distance,\n	-- re-aimed every tick at a point just behind them, so the person walks the exact\n	-- path the player walks rather than cutting across it. These are the numbers that\n	-- make that read as two people out together rather than as a queue or a chase.\n	--\n	-- Safe ranges: FollowBehindStuds 2-6, FollowTickSeconds 0.1-0.4, ArriveRadiusStuds\n	-- 8-16, MaxWalkSeconds 90-600.\n	Companion = {\n		-- How far behind the player the companion aims for. Two studs is a queue, six\n		-- is losing them; three is walking with somebody.\n		FollowBehindStuds = 3,\n		-- How often the follow target is re-aimed. The pocket-money chase re-aims on\n		-- the same order of magnitude; slower reads as lag and faster is wasted work.\n		FollowTickSeconds = 0.2,\n		-- How close to the destination place point the walk counts as over.\n		ArriveRadiusStuds = 12,\n		-- The longest a walk may run, so a companion can never be followed for the\n		-- rest of a life that never reaches the shop.\n		MaxWalkSeconds = 240,\n	},\n\n	-- Bond milestones. When a bond crosses one of these thresholds the game fires\n	-- a celebration and the person's offers change character. The numbers sit\n	-- between MinBond and MaxBond and are checked in ascending order: the first\n	-- one the current bond meets is the one that fires, and each threshold fires\n	-- only once per life so the player gets the fanfare exactly once per rung.\n	-- Safe range: integers between MinBond (-20) and MaxBond (100), ascending.\n	BondMilestones = { 10, 25, 50, 75, 100 },\n\n	-- NPC memory. The rolling buffer of interactions per person.\n	-- Five is enough to feel like a history without being a novel the player\n	-- will never read. Defining moment is one per person, written at the\n	-- peak bond interaction.\n	InteractionsPerPerson = 5,\n\n	-- The odds that, when a person has a defining moment on record and no more\n	-- specific contextual line beats it, they call it back instead of saying\n	-- their flat ambient line. Not 1: a parent who recited the same memory\n	-- word for word on every single visit would stop sounding like she\n	-- remembered it and start sounding like the game replaying a save file.\n	-- Safe range: 0.2-0.5. Below that it never surfaces; above it drowns out\n	-- the ordinary contextual lines that give a person their everyday voice.\n	MemoryCallbackChance = 0.35,\n\n}\n\n-- Places a person can be asked to walk to with you.\n--\n-- The world's destinations are parts in the Street, not numbers here -- this list is\n-- not where a place lives, it is where an offer's `walksTo` is checked against at\n-- load so a typo in content is caught on startup rather than showing the player an\n-- offer that silently does nothing. It must never be the source a destination is\n-- built from.\nConfig.Places = {\n	Walkable = {\n		\"store\",\n		\"school\",\n		\"classroom\",\n		\"home\",\n		\"crossing\",\n		\"gate\",\n		\"work\",\n		\"office\",\n		\"gym\",\n		\"library\",\n		\"clinic\",\n		\"bakery\",\n		\"garage\",\n		\"park\",\n		\"home_1\",\n		\"home_2\",\n		\"home_3\",\n		\"home_4\",\n		-- City. Sports and a spread of commercial spots so the new districts\n		-- have people on the streets; a handful of suburb homes so companion\n		-- walks reach the residential side of the map.\n		\"soccer_field\",\n		\"basketball_court\",\n		\"tennis_court\",\n		\"playground\",\n		\"running_track\",\n		\"cafe\",\n		\"restaurant\",\n		\"supermarket\",\n		\"bank\",\n		\"cinema\",\n		\"pharmacy\",\n		\"suburb_1\",\n		\"suburb_5\",\n		\"suburb_10\",\n		\"suburb_20\",\n		\"suburb_30\",\n		\"suburb_50\",\n		-- New districts: fade offices and north strip so companions can walk there.\n		\"fade_1\",\n		\"north_shop_1\",\n		\"auto_dealer\",\n	},\n}\n\n-- The town. Everybody in the world who is not one of the four people a life is made of.\n--\n-- Generated rather than authored, because \"a lot of them\" and \"hand-written\" are not\n-- both possible, and because the thing that makes the four worth writing -- that they\n-- are *your* mother, *your* friend -- is exactly what a stranger at the shop should not\n-- have. What a stranger has instead is that they are there every time you go, and that\n-- turning up is the only thing that ever changes them.\n--\n-- Generated *once, from a fixed seed, the same for everybody*, and that is the load-\n-- bearing decision in this whole block. A bond is stored against a person id, so a\n-- population re-rolled per server or per player would hand the friend you spent fifteen\n-- years earning to a stranger with a different face. The town is a fact about the world;\n-- the bond is the only part of it that is yours.\nConfig.Town = {\n	-- The seed the whole population comes out of. Names, faces, ages, where they stand\n	-- and what they have to say are all downstream of this one number.\n	--\n	-- CHANGING THIS RE-ROLLS EVERY TOWNSPERSON. Ids stay put, so nothing errors -- but\n	-- every saved bond silently ends up against a different person, which is worse than\n	-- an error because it looks like the save worked. Change it before there are saves\n	-- worth keeping, or not at all.\n	Seed = 20260802,\n\n	-- How many of them there are. The number that decides whether the world reads as a\n	-- place people live or as four rooms with relatives in them.\n	--\n	-- Not a performance figure -- PresenceStuds and MaxBodied are what bound the cost --\n	-- so this is only \"how big is the town\". Enough that you cannot know everybody in one\n	-- life, which is the point.\n	--\n	-- **Prefer a whole multiple of #PATTERN in Townsfolk.luau** (23, so 46 is two of them).\n	-- This used to read \"(17, so 34 is two of them)\" and both numbers had gone stale:\n	-- PATTERN grew to 23 entries and Count was never moved with it, so 34 was one full\n	-- pass plus a partial one, `coworker` came out 1 man to 3 women, and Townsfolk threw\n	-- at require time on the boot path -- which took the whole server down rather than\n	-- producing a lopsided town. 46 is the only value in the safe range below that works:\n	-- 23 is a whole pass but still fails, because an archetype that appears more than once\n	-- inside one pattern lands on the same parity each time.\n	-- Genders alternate by index and archetypes repeat every #PATTERN, so a whole number of\n	-- passes gives every archetype an exact half-and-half split; a partial pass leaves the\n	-- last few slots one-sided. Townsfolk checks this at load and errors if any archetype\n	-- ends up more than one out, so a number that breaks it will say so rather than quietly\n	-- producing a town where every peer is a man.\n	-- Safe range: 8-60. Above ~60 the rings around the four places start refusing spots.\n	Count = 46,\n\n	-- Where townsfolk stand, relative to the place point they live at.\n	--\n	-- A wider ring than the family's, and further out on purpose. Your mother is in the\n	-- room; the people at the shop are around the shop. It also has to hold many more\n	-- bodies -- a bearing on a 16-stud ring is about 4 studs of arc, which is a person's\n	-- width and a bit.\n	-- Safe range: 10-26 and 12-36.\n	StandStuds = 16,\n	StandBearings = 24,\n\n	-- How near the player has to be **to a townsperson** before that person is given a\n	-- body at all.\n	--\n	-- Measured from the person, not from the place they belong to, and that is what lets\n	-- them leave it. Somebody with no body is not nowhere: they have a position that goes\n	-- on advancing along the paths while nobody is looking, so following one down a street\n	-- keeps them in front of you and turning a corner into a stranger spawns them there.\n	--\n	-- The whole reason a town of this size is affordable. A rig is a yielding web call\n	-- and there is no version of thirty of them at once that is not a stall on arrival,\n	-- so a townsperson away across the map is a row in a table and nothing else. Set\n	-- comfortably beyond the distance the dots are readable from, so nobody is ever seen\n	-- arriving.\n	-- Safe range: 60-250. Below about 60 they pop in while you are looking at them.\n	PresenceStuds = 140,\n\n	-- The hard ceiling on town rigs standing at once, whatever the radius lets through.\n	--\n	-- Belt and braces over PresenceStuds: two places tagged near each other would\n	-- otherwise put the whole town in one frame. Nearest place first, so what gets\n	-- dropped is always the furthest thing from the player.\n	-- Safe range: 6-24.\n	MaxBodied = 12,\n\n	-- How often the world is re-checked for which places the player is near. Coarser\n	-- than the people tick because crossing a 140-stud radius is not a precise moment\n	-- and a rebuild is the expensive thing on the other side of it.\n	-- Safe range: 0.5-4.\n	PresenceTickSeconds = 1,\n\n	-- A pause between two town rigs being built, so a walk into a busy place spreads its\n	-- avatar calls over a second or so instead of firing a dozen at once. They arrive\n	-- visibly one after another, which reads as people rather than as a spawn.\n	-- Safe range: 0-0.5. At 0 they all arrive on the same frame.\n	SpawnPaceSeconds = 0.12,\n\n	-- Past this, a nameplate shows the name and no age.\n	--\n	-- A patch over a hole rather than a rule: nobody in AGES dies of old age yet, so a\n	-- long life eventually stands next to a man the arithmetic says is a hundred and\n	-- thirty. Showing nothing is the smallest honest thing to do about that until NPC\n	-- mortality exists, and `/town` counts how many people are past it so the hole stays\n	-- visible rather than becoming a feature.\n	-- Safe range: 85-105.\n	OldestShownAge = 96,\n\n	-- How far from the place they belong to a townsperson wanders **when the world has no\n	-- paths tagged**. The fallback, not the rule.\n	--\n	-- Bounded because a probed spot is wherever the floor happens to be: somebody given a\n	-- hundred studs of open ground to aim at walks through the road, the flowerbed and the\n	-- neighbour's garden with equal enthusiasm. Tag some AgesTownPoints and RangeStuds\n	-- below takes over, which is a leash on a road network rather than on open country and\n	-- can therefore be much longer.\n	-- Safe range: 20-90.\n	RoamStuds = 55,\n\n	-- How far apart two route points can be and still be joined into one road.\n	--\n	-- This is the only thing deciding what \"connected\" means, so it wants to be a little\n	-- more than the gap a builder naturally leaves between corners -- generous enough that\n	-- a path tagged at reasonable intervals comes out as one network, tight enough that\n	-- two points either side of a building are not treated as a road through it. `/town\n	-- routes` reports how many disconnected pieces the current number produces, which is\n	-- the way to tune it.\n	--\n	-- 70 rather than a rounder 60 because of the street the game actually ships with: its\n	-- crossing is 65 studs from the school forecourt and 66 from outside the store, so 60\n	-- cuts that town into three islands and 70 makes it one. Raising it further starts\n	-- linking the school to the shop directly, which is a road through the houses.\n	-- Safe range: 30-120.\n	RouteLinkStuds = 70,\n\n	-- How far from their own place a townsperson will ever get, once there are paths to\n	-- walk on.\n	--\n	-- The number that decides whether this is a town or a set of four unrelated crowds.\n	-- Long enough that a classmate can turn up near the shop and the streets between the\n	-- buildings have somebody on them; short enough that the shop still has regulars and\n	-- the school still has your year group. Not a performance figure -- PresenceStuds and\n	-- MaxBodied bound the cost -- so this is purely about how far people's lives spread.\n	-- Safe range: 80-500.\n	RangeStuds = 250,\n\n	-- How much further than PresenceStuds somebody has to get before their body is taken\n	-- away again.\n	--\n	-- Hysteresis, and it is not optional. Spawn and despawn at one threshold means a\n	-- player standing at exactly that distance builds and destroys a rig every tick\n	-- forever -- and building a rig is a yielding web call, so it is the most expensive\n	-- possible thing to do on a loop.\n	-- Safe range: 1.05-1.4. At 1 it thrashes.\n	DespawnSlack = 1.15,\n\n	-- How far to step aside when two townsfolk arrive at the same corner at the same time.\n	-- Only ever used at the moment a body is built, since two bodies walking is Roblox's\n	-- problem rather than ours.\n	-- Safe range: 2-6.\n	NudgeStuds = 3,\n\n	-- The shortest walk worth taking. Below this they are shuffling on the spot, which\n	-- reads as indecision rather than as somebody going somewhere.\n	-- Safe range: 8-25, and always less than RoamStuds.\n	MinLegStuds = 14,\n\n	-- How many legs a townsperson has already walked by the time you first exist.\n	--\n	-- Without this everybody begins life standing exactly on the point their place is\n	-- tagged at, so the moment a life starts there is a huddle at your front door and\n	-- another in the shop doorway. They disperse within a minute, which does not help --\n	-- the first thing the player ever sees is the thing they remember, and a crowd that\n	-- melts is more obviously a spawner than a crowd that stays.\n	--\n	-- Drawn from 0 to this, not fixed at it: some of them *should* still be near home,\n	-- because some of them live there. At roughly a route link per leg, six is about four\n	-- hundred studs of walking, which is further than the leash -- so the draw spreads\n	-- people across the whole of their range rather than pushing them all to the edge of\n	-- it.\n	-- Safe range: 0-12. At 0 the huddle is back; above about 12 it costs a visible pause\n	-- on the first rebuild of a life and buys nothing, since the leash has already bound\n	-- where they can be.\n	SettleLegs = 6,\n\n	-- How long they stand still at the end of a walk, picked uniformly from this window.\n	-- The pause is what makes it a person going about their day rather than a patrol: a\n	-- town that never stops moving is a town of couriers.\n	-- Safe range: 1-20, min below max.\n	PauseMinSeconds = 3,\n	PauseMaxSeconds = 11,\n\n	-- A stroll, and slower than the visitor who came to your door because they are not\n	-- going anywhere in particular. Also what makes them catchable -- a player at 16 has\n	-- to be able to walk somebody down to talk to them.\n	-- Safe range: 4-12, and always below the player's speed.\n	WalkSpeed = 8,\n\n	-- How many spots are tried before a leg is given up on and the pause simply runs\n	-- again. Ground probes are cheap; a townsperson pinned in a corner is not, so the fan\n	-- wants to be wide enough to find the one bearing out of an alcove.\n	-- Safe range: 4-32.\n	RoamAttempts = 14,\n}\n\n-- What each stretch of a bond is called, best first.\n--\n-- Read top-down, exactly like the work bands: the first band whose `atLeast` you meet\n-- is the one you are in, and the bottom one is anchored to MinBond rather than to a\n-- magic number that would silently stop covering the range if the floor moved.\n--\n-- `name` is a lowercase phrase that has to read correctly in the two places it is used:\n-- on the HUD next to somebody's name (\"Dad · close\") and inside a sentence explaining\n-- what a bond is not yet enough for (\"Rae would have to be close to you first\"). A\n-- phrase that only fits one of those is the wrong phrase.\n--\n-- Deliberately no `raise` or any other number attached, unlike the work bands. What a\n-- bond is worth is written on the pads it unlocks, one offer at a time, in content --\n-- because \"close\" should mean your father will lend you rent, not that a hidden\n-- multiplier moved.\nConfig.People.Bands = {\n	{ atLeast = 70, name = \"inseparable\" },\n	{ atLeast = 45, name = \"close\" },\n	{ atLeast = 20, name = \"friendly\" },\n	{ atLeast = 0, name = \"on speaking terms\" },\n	{ atLeast = -8, name = \"barely speaking\" },\n	-- The bottom of the range, kept for the relationships a life can actively ruin\n	-- rather than merely drift away from. Reached only by a run of hostile offers on\n	-- top of the ordinary decay -- becoming enemies is a choice, like becoming a\n	-- friend is -- and reversible, because the repair offer gates on the same low\n	-- territory.\n	{ atLeast = Config.People.MinBond, name = \"sworn enemies\" },\n}\n\n-- What an ask's odds are called on the panel row, matched by the first `atLeast` the\n-- refusal chance meets. Words rather than a percentage, for the same reason a bond is\n-- a phrase: a figure invites arithmetic, and the player should be weighing whether to\n-- risk their one visit this year, not computing it.\n--\n-- An ask safer than the last band here shows no note at all, and that silence is the\n-- signal. A row that used to say \"a long shot\" and now says nothing is the game\n-- telling the player their father came around, without ever showing them a number.\nConfig.People.RiskBands = {\n	{ atLeast = 0.34, name = \"a long shot\" },\n	{ atLeast = 0.01, name = \"they might say no\" },\n}\n\n-- Pointing the player at something worth walking to.\n--\n-- The world is the menu in this game, which is a good thing to believe right up\n-- Crime, and the price of it.\n--\n-- The system is two halves and one number joins them: a crime *spends* heat and the\n-- police are what heat *buys*. Nothing here is a punishment bolted onto a reward -- how\n-- much you took is literally the difficulty setting for the next several minutes, which\n-- is the only reason taking more is a decision rather than a preference.\n--\n-- The load-bearing idea in this whole block is that the police do not know where you\n-- are. They know where you were *last seen*, and they search outward from it. Every\n-- number below that looks like it is about difficulty is really about that one fact:\n-- SearchRadiusStuds is how wrong they are allowed to be, SightStuds is how easily you\n-- make them right again, and ContactSeconds is how long being wrong saves you. Tune\n-- them together or not at all -- an officer who can see far enough to never lose you\n-- turns the whole system into a chase you cannot win, which is a different game and a\n-- worse one.\n--\n-- Deliberately no combat anywhere in here, and not because of the rating: if the police\n-- could be fought then the answer to every pursuit is to turn around, and last known\n-- position, dumping the goods and changing your coat all stop being decisions on the\n-- same afternoon. Running has to be the only verb or none of the rest of it has teeth.\nConfig.Crime = {\n	-- The heat number itself. Unbounded at the bottom by zero and capped here, because\n	-- every tier below reads off this scale and a bounty that could run away past the\n	-- top tier would be a fifth tier nobody wrote.\n	-- Safe range: 100 only. Change the tiers instead -- this is the scale they are cut\n	-- from, not a difficulty knob.\n	MaxBounty = 100,\n\n	-- How fast heat bleeds off, in points per second, once nobody has eyes on you.\n	--\n	-- Two and a half minutes from the cap to clean if you are never seen again. Long\n	-- enough that a big score is genuinely an afternoon you have to survive rather than\n	-- a corner to hide behind for twenty seconds; short enough that it is over inside one\n	-- sitting. The whole of it is spent hiding, which is why the decay is the pacing of\n	-- this system and not a formality.\n	-- Safe range: 0.4-1.2. Above ~1.2 the top tier never gets to happen.\n	DecayPerSecond = 0.65,\n\n	-- Heat does not fall at all while any officer can see you, and this is how long after\n	-- losing sight of you it stays frozen before the decay restarts. The pause is the\n	-- thing that makes breaking line of sight feel like it did something *later* rather\n	-- than instantly -- an officer who turns a corner has not given up, and a bounty that\n	-- resumed cooling the same frame would say they had.\n	-- Safe range: 3-12. Below ~3 there is no reason to hide rather than to keep running.\n	CoolStartSeconds = 6,\n\n	-- What the police can do at each level of heat, and the only place difficulty is\n	-- written. Escalation here is by *changing the space* rather than by raising numbers:\n	-- one officer who searches where you were is a different problem from four who spread\n	-- out, and neither is the same problem with a bigger multiplier.\n	--\n	-- `officers` is a hard cap on bodies in the world, and it is a performance budget as\n	-- much as a design one -- see PoliceService for the per-tick cost of one.\n	-- `sightStuds` is how far an officer recognises you at, which is the real difficulty\n	-- dial: it is how quickly a search turns back into a pursuit.\n	-- `searchRadiusStuds` is how far from your last known position they are willing to\n	-- spread. Bigger is harder, because standing still stops working.\n	-- Safe range: 1-6 officers. Past ~6 the town reads as a cordon rather than a response.\n	Tiers = {\n		{ atLeast = 0, name = \"clean\", officers = 0, sightStuds = 0, searchRadiusStuds = 0 },\n		{ atLeast = 15, name = \"reported\", officers = 1, sightStuds = 55, searchRadiusStuds = 40 },\n		{ atLeast = 40, name = \"wanted\", officers = 2, sightStuds = 70, searchRadiusStuds = 70 },\n		{ atLeast = 65, name = \"manhunt\", officers = 4, sightStuds = 85, searchRadiusStuds = 110 },\n		{ atLeast = 88, name = \"citywide\", officers = 6, sightStuds = 100, searchRadiusStuds = 160 },\n	},\n\n	-- How long an officer has to stay within ArrestStuds of you before it is an arrest.\n	--\n	-- The single most important number for how this feels. An instant arrest on contact\n	-- means one bad corner ends the afternoon and the player never learns what went\n	-- wrong; three seconds means being caught is something you can see coming and\n	-- sometimes escape, which is the difference between a fail state and a near miss.\n	-- This is the soft-failure requirement for the chase half, and it is the whole of it.\n	-- Safe range: 2-5. Below ~2 there is no near miss and above ~5 they never catch you.\n	ContactSeconds = 3,\n	-- Safe range: 6-14. Wider than a conversation because a humanoid closing on a moving\n	-- target overshoots, and an arrest that needed a perfect stop would mostly not happen.\n	ArrestStuds = 9,\n\n	-- How fast an officer moves, against Config.NPC.WalkSpeed for an ordinary person.\n	--\n	-- Slightly *under* the player's run on purpose. A pursuer who is faster than you\n	-- reduces every chase to how long the straight road is, and the interesting version\n	-- of this is one you can outrun in the open but not out-corner -- so the officers buy\n	-- their difficulty with numbers and knowing where you were, never with speed.\n	-- Safe range: 14-19. At or above the player's speed the chase stops being winnable.\n	OfficerWalkSpeed = 17,\n\n	-- How often the pursuit re-reads the world. Separate from the decay tick because the\n	-- two are asking different questions at different rates: where everyone is standing\n	-- has to be fresh, and a number falling by half a point does not.\n	-- Safe range: 0.15-0.4. Below ~0.15 the pathfinder is the bottleneck, not the tick.\n	TickSeconds = 0.2,\n\n	-- How stale a last known position may get before the officers stop believing it and\n	-- start spreading out instead of converging. Without this they walk to a spot, stand\n	-- on it and stay there, which reads as broken rather than as searching.\n	-- Safe range: 5-15.\n	SightingHoldSeconds = 9,\n\n	-- Custody, in years off the life, by the tier you were caught at.\n	--\n	-- Years rather than months because a year is the game's own unit of time and the\n	-- machinery for spending one already exists and already does the right things -- see\n	-- LifeService.AgeUp and the note on skipChildhood. Writing months directly would skip\n	-- the stat decay and the stage boundaries, which is the difference between a sentence\n	-- costing you something and a sentence costing you a number.\n	--\n	-- Never served in real time. The player is not made to sit in a cell: idle time inside\n	-- an activity is a bug by this project's own rules, and a jail you wait out is the\n	-- purest possible form of it. The years are spent, the life moves on, and what is left\n	-- behind is the record -- which is the actual sentence.\n	-- Safe range: 1-4. Past ~4 a single bust ends a life's prospects outright.\n	CustodyYearsByTier = { 0, 1, 1, 2, 3 },\n\n	-- What a record does, once you have one.\n	--\n	-- Both of these are multipliers on difficulty rather than locks, which is the whole\n	-- design of the consequence: a wall tells the player their save is ruined, a raised\n	-- bar tells them to be better. It also makes the only interesting version of this\n	-- character possible -- the one grinding stats to clear a bar everybody else walks\n	-- under.\n	Record = {\n		-- Cameras and officers recognise a known face faster. Multiplies the rate at\n		-- which being seen turns into heat.\n		-- Safe range: 1.2-2.5.\n		SuspicionMultiplier = 1.6,\n		-- Every job's stat requirements go up by this fraction. Not a refusal: a\n		-- requirement.\n		-- Safe range: 0.1-0.4. Past ~0.4 the top jobs are unreachable rather than hard.\n		HiringBarIncrease = 0.2,\n	},\n\n	-- The take. What you actually do to earn the heat above.\n	--\n	-- One verb: hold to empty the till. Everything interesting here is in the two\n	-- rhythms you have to hold *between*, and the numbers below are chosen so that the\n	-- two never settle into one pattern:\n	--\n	--   the clerk    turns to the register, then away to the shelves. A short cycle you\n	--                can count, and the one you learn first.\n	--   the camera   sweeps the room on its own clock, longer and slower, and it does\n	--                not care where the clerk is looking.\n	--\n	-- The two periods are deliberately not multiples of each other. The gaps where\n	-- neither is on the till therefore drift -- sometimes four seconds long, sometimes\n	-- none at all -- and the skill of this activity is reading the alignment rather than\n	-- counting to four. That is the whole design, and it is two numbers.\n	--\n	-- Being seen is never an arrest and never ends the robbery. It is heat and a\n	-- sighting, which is to say it hands you straight to the half of the system that is\n	-- already built. The soft failure is the point: a robbery that goes wrong should be\n	-- the *beginning* of the interesting part of the afternoon.\n	Theft = {\n		-- What a full shop till holds, against the note above Config.Money: an adult\n		-- hour of ordinary work is about twenty, and a first job is 2,400 a year. So a\n		-- clean till is worth about a fortnight of legitimate wages -- plainly worth\n		-- doing, and plainly not a career on its own.\n		-- Safe range: 120-400. Past ~400 one shop is a year's wages and nothing else in\n		-- the economy matters.\n		TillFloat = 220,\n\n		-- How fast it comes out while you are holding.\n		--\n		-- Set against the clerk's away window on purpose: one uninterrupted window is\n		-- worth a little over half a till, so a full till *cannot* be taken in one go.\n		-- The player has to either leave money in the drawer and walk, or stay for a\n		-- second window and take the alignment they are given. That choice, made every\n		-- few seconds, is the activity.\n		-- Safe range: 15-40. At the value where one window empties a till the whole\n		-- decision disappears.\n		TakePerSecond = 26,\n\n		-- How long a robbed till takes to be worth robbing again. Long enough that the\n		-- answer to \"I want more\" is the next shop rather than this one, which is what\n		-- makes a spree a walk across town with heat on you.\n		-- Safe range: 180-600.\n		RefillSeconds = 300,\n\n		-- The clerk's cycle, in seconds: facing the till, then away from it.\n		-- Safe range: 2-5 looking, 3-7 away. Away below ~3 leaves no window at all.\n		ClerkLookSeconds = 3.2,\n		ClerkAwaySeconds = 4.6,\n\n		-- The camera's, which is one number because a sweep is one motion. The share of\n		-- it spent pointed at the till is what makes the two rhythms interfere: 9 and\n		-- 7.8 have a lowest common multiple of about a minute, so the pattern the player\n		-- is reading takes a minute to repeat and never feels like a metronome.\n		-- Safe range: 7-14 seconds, 0.25-0.5 on the till.\n		CameraSweepSeconds = 9,\n		CameraOnTillShare = 0.35,\n\n		-- How close you have to be to have your hands in the drawer.\n		-- Safe range: 6-10. This is a reach, not a room.\n		ReachStuds = 8,\n\n		-- The undo window. How long after an attention turns onto you before it counts\n		-- as being seen -- which is to say, how long you have to let go.\n		--\n		-- The single most important number in this half of the system, the way\n		-- ContactSeconds is in the other. It is what makes releasing a decision the\n		-- player makes rather than a reaction they fail: half a second is enough to act\n		-- on something you were watching for and nowhere near enough to bail on\n		-- something you were not.\n		-- Safe range: 0.3-0.9. Above ~0.9 you can hold through a whole glance.\n		GraceSeconds = 0.5,\n\n		-- What being caught with your hands in it costs, in heat. Roughly the first\n		-- tier's threshold, so one bad window is one officer -- a consequence you can\n		-- see walking toward you rather than a number you read.\n		-- Safe range: 10-30.\n		HeatOnSpotted = 18,\n\n		-- And what it costs to keep holding after that. Per second, so a player who\n		-- brazens it out climbs tiers rather than sitting at one -- which is the version\n		-- of \"go loud\" this game can have without giving anybody a weapon.\n		-- Safe range: 3-12.\n		HeatPerSecondSpotted = 6,\n\n		-- How often the take is re-read. The same rate as the pursuit, because the two\n		-- are one activity from the player's side and a till that paid on a different\n		-- beat from the officers arriving would feel like two games.\n		-- Safe range: 0.1-0.3.\n		TickSeconds = 0.2,\n	},\n\n	-- Being noticed, which until now was two different questions with two different\n	-- answers and no name.\n	--\n	-- An officer used to see you the instant you crossed a distance line, and a passer-by\n	-- used to need a flat 2.2 seconds regardless of anything about you. Neither asked the\n	-- question the chase is actually built on: *how much do you stand out right now*. So\n	-- the player had no lever between \"wanted\" and \"not wanted\" -- nothing to do with a\n	-- street full of people except avoid it -- and the one number that should obviously\n	-- have made you easier to spot, the bounty on your head, did nothing of the kind.\n	--\n	-- Now both observers accumulate the same `notice`, at a rate set by how conspicuous\n	-- you are, and being spotted happens when it fills. That single change is what turns\n	-- a set of range checks into a system with play in it, because every term below is a\n	-- lever the player can move:\n	--\n	--   heat     the headline rule -- the more wanted you are, the faster anybody makes\n	--            you. This is what stops a citywide manhunt feeling identical to a first\n	--            report, without touching a single officer's stats.\n	--   speed    sprinting past a crowd is louder than walking through it. This is the\n	--            one term the player controls second to second, and it is the reason\n	--            \"keep your head down\" is now a real instruction rather than flavour.\n	--   colors   a gang bandana is meant to be legible across a street -- that is its\n	--            whole job -- so wearing one while wanted has to cost something. It is\n	--            also what Part 4 needs: being made in enemy territory is the trigger.\n	--\n	-- Notice resets the moment line of sight breaks, for both observers, and that is\n	-- deliberate rather than an omission: it is what keeps breaking sight a *move* rather\n	-- than a pause, which is the rule WitnessService was already built on and the one the\n	-- whole hiding half of the chase rests on.\n	Spotting = {\n		-- What you are worth noticing at all, wanted or not, stood perfectly still with\n		-- nothing on. The floor rather than the norm -- everything else adds to it.\n		-- Safe range: 0.2-0.5. At 0 a clean player standing still is literally invisible,\n		-- which reads as a broken officer rather than as good play.\n		Base = 0.35,\n\n		-- How much of the rate the bounty is worth, at full heat. The largest single term\n		-- on purpose: \"easier to spot with a higher bounty\" is the rule this table exists\n		-- to implement, and it should dominate the others rather than sit alongside them.\n		-- Safe range: 0.4-0.9.\n		HeatShare = 0.65,\n\n		-- How much moving flat out is worth, against standing still.\n		--\n		-- Smaller than heat, and it has to be: if running were the dominant term then the\n		-- correct play at every tier would be to walk everywhere, and a chase you win by\n		-- strolling is not a chase. It is a discount for playing carefully, not a\n		-- replacement for being uninteresting to the police.\n		-- Safe range: 0.2-0.6.\n		MovementShare = 0.4,\n\n		-- What counts as flat out, in studs per second, for the term above. Anything at\n		-- or past this is fully conspicuous; the scale is linear below it.\n		-- Safe range: 16-24. Should sit at or near the player's actual run speed, or the\n		-- term saturates before the player is really running and stops discriminating.\n		RunSpeedStuds = 20,\n\n		-- Wearing gang colors, flat. Not scaled by anything, because a bandana is either\n		-- on your head or it is not, and the whole design of gang colors is that they are\n		-- readable from across a street.\n		-- Safe range: 0.15-0.5.\n		ColorsBonus = 0.3,\n\n		-- How much of the rate survives at the very edge of an observer's range.\n		--\n		-- Without a falloff, sightStuds is a hard line: one stud closer and you are made\n		-- at full speed. With it, the edge of somebody's vision is a place you can be\n		-- briefly and get away with, which is what makes distance a thing to manage\n		-- rather than a boolean to be on the right side of.\n		-- Safe range: 0.2-0.5. At 1 the falloff is switched off entirely.\n		EdgeShare = 0.35,\n\n		-- Seconds for a *trained* observer to make you at point-blank range with a\n		-- conspicuousness of exactly 1. Officers only.\n		--\n		-- Short, because an officer who has to study you is an officer you can walk past,\n		-- and the pursuit half of this system was never the part that needed slowing\n		-- down. What this buys is the moment of grace that did not exist before: at low\n		-- heat, moving slowly, at the edge of their vision, you are not made instantly --\n		-- and that moment is the entire reason spotting is a system rather than a check.\n		-- Safe range: 0.6-2. Above ~2 officers stop feeling like a threat at all.\n		OfficerSeconds = 1.1,\n	},\n\n	-- The town, once it has your description.\n	--\n	-- The chase's second opponent, and the reason it exists is that without it the whole\n	-- of being wanted is standing behind a wall for two and a half minutes waiting for\n	-- DecayPerSecond to finish. That is the unskilled-dead-time bug this project keeps\n	-- designing away, sitting in the middle of the best part of the system. Ordinary\n	-- people recognising you turns hiding from a wait into a route: the empty back street\n	-- is now genuinely better than the busy one, and that is a decision made continuously\n	-- rather than once.\n	--\n	-- Only ever while the police have a description of you -- see Disguise below, which\n	-- is the answer to this and the verb the chase was missing.\n	Witness = {\n		-- How far away an ordinary person recognises a face they have been told to look\n		-- for. Deliberately shorter than every officer's sightStuds, including the\n		-- lowest: a passer-by glancing up is not a trained search, and a crowd that saw\n		-- further than the police would make the officers irrelevant.\n		-- Safe range: 30-60. Above ~60 a busy street is impassable at any tier.\n		SeeStuds = 45,\n\n		-- How long a passer-by needs to place a face of conspicuousness exactly 1, stood\n		-- right in front of them. No longer a flat hold: it is the denominator of the\n		-- rate in Crime.Spotting, so a calm clean player takes several times this and a\n		-- sprinting banded-up one takes well under it. Point-blank, too -- across the\n		-- street it stretches by the falloff in EdgeShare.\n		--\n		-- Still the undo window, and still the same idea as the till's GraceSeconds:\n		-- long enough that walking briskly past somebody is not automatically a report,\n		-- short enough that loitering in a crowd is. It is also the time their reaction\n		-- is on screen -- they stop and turn to face you the moment the notice starts\n		-- filling -- so this doubles as how much warning the player gets.\n		-- Safe range: 1.5-4. Below ~1.5 there is no warning, only a punishment.\n		SeeSeconds = 2.2,\n\n		-- What one report costs. Small on purpose: a witness is not a disaster, it is a\n		-- reason to keep moving. What actually hurts is the sighting it carries, which\n		-- drags the search back onto you.\n		-- Safe range: 2-8.\n		Heat = 4,\n\n		-- How long before the same person will report you again. Without it, standing in\n		-- front of one pedestrian is a heat firehose and the tier climbs on its own with\n		-- nothing interesting having happened.\n		-- Safe range: 12-40.\n		CooldownSeconds = 20,\n	},\n\n	-- Changing your clothes, which is the chase's verb.\n	--\n	-- Everything above is something happening *to* the player. This is the one thing they\n	-- can do about it, and it is deliberately powerful: it does not reduce the heat, it\n	-- deletes the police's belief about where you are. Officers converging on a corner\n	-- become officers searching a place you are not, and the town stops recognising you\n	-- until an officer lays eyes on you again.\n	--\n	-- Powerful, and paid for in the only currency a chase has: you have to be somewhere\n	-- specific, standing still, with nobody watching, for five seconds, while the search\n	-- ring drifts. Getting there is the traversal this activity needs; standing there is\n	-- the commit; walking off is the undo.\n	Disguise = {\n		-- How long you have to stand on the mark. The commit window, and the number that\n		-- decides whether this is a decision or a formality: five seconds is long enough\n		-- that starting it with an officer one street over is a genuine gamble.\n		-- Safe range: 3-8. Below ~3 it is free; above ~8 nobody will ever risk it.\n		ChangeSeconds = 5,\n\n		-- How close to the mark counts as standing on it. Generous, because the player\n		-- arrives here at a run and a rail that needed a precise stop would be a rail\n		-- nobody uses under pressure.\n		-- Safe range: 4-9.\n		ReachStuds = 6,\n\n		-- What a change of clothes costs. Priced against a small till float, so a spree\n		-- pays for its own escapes and a player who is caught broke has to run instead.\n		-- Not a lock: the heat still decays on its own, so being unable to afford this is\n		-- a worse afternoon rather than a dead end.\n		-- Safe range: 0-80. Above ~80 the escape costs more than the crime paid.\n		Cost = 35,\n\n		-- How often the mark re-reads who is standing on it and whether they are being\n		-- watched. The same beat as the pursuit, because a change that completed on a\n		-- different clock from the officer walking in would read as unfair.\n		-- Safe range: 0.1-0.3.\n		TickSeconds = 0.2,\n	},\n\n	-- The bank.\n	--\n	-- Deliberately not a bigger till, and this is the whole of the design. Escalation in this\n	-- project is by changing the space rather than by raising numbers -- see the note on\n	-- Tiers, which makes the same argument about officers -- and a vault that was a drawer\n	-- with more in it would be the numbers-only version of an activity we already have.\n	--\n	-- So it asks the opposite question with the same input. A till is \"do not be seen\": you\n	-- read two attentions and hold in the gap between them, and being spotted is the failure.\n	-- A bank is \"you *will* be seen\": the alarm goes the moment you commit, before you have\n	-- taken a penny, and the game is how long you are willing to stay. Nothing here is a\n	-- stealth check. Everything here is a clock you are choosing to run down.\n	--\n	-- Three things at once instead of the till's two, and the third is the room itself. The\n	-- vault is forty-odd studs from the alarm panel by the door, so silencing the alarm means\n	-- leaving the money -- which is the traversal requirement met by the floor plan rather\n	-- than by inventing a consumable to fetch. It is also the reason a second person is worth\n	-- having and never required: two players never run, one player always does.\n	Bank = {\n		-- What is in the vault, against a small shop's whole float of 220. Six or seven\n		-- tills, which is what makes this the afternoon rather than a stop on the way\n		-- through one -- and it has to be, because the heat it buys cannot be walked off in\n		-- the time a corner store's can.\n		-- Safe range: 900-2200. Below ~900 nobody would take the alarm for it.\n		VaultFloat = 1400,\n\n		-- How fast it comes out once the door is moving. Twenty-five seconds for the whole\n		-- vault, which is four times the till's window and is meant to be: the number the\n		-- player is really deciding is how much of those twenty-five seconds they can afford,\n		-- and every second of it is a second the officers are closer.\n		-- Safe range: 40-80. Above ~80 the alarm never gets to matter.\n		TakePerSecond = 55,\n\n		-- How long a robbed vault takes to be worth robbing again. Long, because a bank you\n		-- could go back to in five minutes would make the whole town's four tills pointless.\n		-- Safe range: 600-1800.\n		RefillSeconds = 900,\n\n		-- What tripping the alarm costs the instant you touch the door, before any money.\n		-- Straight past the first rung onto the second: two officers are dispatched by the\n		-- act of starting, which is the promise the activity makes up front.\n		-- Safe range: 20-45. Below ~20 the opening is not the commitment it should be.\n		HeatOnTrip = 30,\n\n		-- How long after being silenced before the alarm arms itself again.\n		--\n		-- The metronome the whole room is played against, and it is set so that a solo player\n		-- can just about hold the pattern together: a round trip to the panel is roughly six\n		-- seconds of running and holding, so twelve seconds means about a third of a solo\n		-- robbery is spent not at the vault. Two players spend none of it.\n		-- Safe range: 8-20. Below ~8 solo is impossible; above ~20 the panel is scenery.\n		RearmSeconds = 12,\n\n		-- What the alarm costs per second while it is ringing. On top of a live fix on your\n		-- position -- see BankService -- which is the part that actually hurts: ringing means\n		-- the officers converge on you, and silenced means they are searching a building.\n		-- Safe range: 3-9.\n		HeatPerSecondRinging = 5,\n\n		-- How long you have to hold the panel to silence it. Short, because the cost of the\n		-- trip is the trip; making the hold long as well would just be the same tax twice.\n		-- Safe range: 1-3.\n		SilenceSeconds = 2,\n\n		-- How close counts as being at the vault door or at the panel. The same reach as a\n		-- till drawer, because it is the same gesture and two different numbers for \"you are\n		-- close enough to touch this\" would be two things for the player to learn.\n		-- Safe range: 6-10.\n		ReachStuds = 8,\n\n		-- The guard.\n		--\n		-- The reason the alarm is not a clean twelve-second beat you can count. He walks a\n		-- patrol, and when he sees somebody at the vault he re-arms the panel there and then\n		-- -- which is the whole of what he does. He never touches the player, never blocks a\n		-- door and never ends anything: he is a non-combat opponent whose only weapon is\n		-- ruining your timing, and reading his patrol is the same skill as reading a clerk's\n		-- shoulders. Continuity with the till is the point.\n		--\n		-- How far he recognises somebody at the vault. Set against the floor plan rather\n		-- than against a feeling: from the door end of his patrol the vault is forty studs\n		-- away, so thirty means there is a stretch of his walk during which he genuinely\n		-- cannot see it. That stretch is the window, and it is the difference between a\n		-- guard who is an obstacle and a guard who is a rhythm.\n		-- Safe range: 20-38. At 40+ the window closes and the panel becomes unusable.\n		GuardSeeStuds = 30,\n\n		-- How old the guard is. Here rather than left to NPCService's default, which picks\n		-- an age near the player's -- a fine rule for a stranger in the street and the wrong\n		-- one for a man employed to stand in a bank, because it would put a nine-year-old on\n		-- the door for a nine-year-old robber.\n		-- Safe range: 25-55.\n		GuardAgeYears = 34,\n\n		-- How long his loop takes end to end. Deliberately not a multiple of RearmSeconds,\n		-- for the reason the clerk and the camera are not multiples of each other: the\n		-- interference is the thing worth reading.\n		-- Safe range: 12-30.\n		GuardPatrolSeconds = 17,\n\n		-- How long he stops and looks at you after catching you, before resuming his walk.\n		--\n		-- Not a cooldown and not a punishment -- the alarm has already gone by then. It is\n		-- there so the player can see *who* ruined their timing: an alarm that re-armed\n		-- while a man carried on strolling past would read as the twelve-second clock being\n		-- broken rather than as somebody having spotted them.\n		-- Safe range: 1.5-4. Below ~1.5 the stop is not visible from across the room.\n		GuardNoticeSeconds = 2.5,\n\n		-- How often the room is re-read. The same beat as the pursuit and the take, because\n		-- from the player's side this is one activity and a vault that paid on a different\n		-- clock from the officers arriving would feel like two games.\n		-- Safe range: 0.1-0.3.\n		TickSeconds = 0.2,\n	},\n}\n\n-- Who you run with.\n--\n-- The crime systems above are all solitary: one player, one drawer, one alarm, one\n-- pursuit. This is the layer that makes a second person mean something, and the\n-- design problem it has to solve is that the standard version of this feature is a\n-- name tag, a chat channel, and a number that goes up when you commit crimes -- which\n-- is the idle payout pad wearing a jacket.\n--\n-- Two things stop it being that, and both are rules borrowed from elsewhere in the\n-- tree rather than invented here:\n--\n-- **Standing is earned, rank is given.** `Ties.luau` argues that friendship cannot be a\n-- bond threshold, because then \"everybody you were reliably nice to would become your\n-- friend on some birthday you were not paying attention on, and the game would be\n-- telling you about your own life after the fact\". A rank that auto-promotes at 500\n-- points has exactly that defect. So standing accrues quietly and the *rung* is only\n-- ever conferred face to face, off a panel, by the person who runs the gang.\n--\n-- **The colors are worn.** Joining puts a bright band on your head, one color to a\n-- gang, readable across a street. That is what makes a mixed room of players and NPCs\n-- legible at a glance -- and it is also a liability, because the same band is what a\n-- witness describes. The bandana is an identity and a tell at once, and the whole\n-- feature leans on that being true in both directions.\nConfig.Gangs = {\n	-- The four rungs, and the ladder is deliberately short for the reason Ties.luau\n	-- keeps three: a ladder with eleven grades on it has quietly replaced a\n	-- relationship with a progress bar.\n	--\n	-- `standing` is what the rung costs to be *offered*. Reaching it is necessary and\n	-- never sufficient -- the boss still has to hand it to you.\n	--\n	-- Read in order and the last one reached wins, so these must stay ascending.\n	--\n	-- The labels carry their own article -- \"a hand\", not \"hand\" -- because three of the\n	-- four take one and the fourth does not, and a caller that wrote `You are a {label}`\n	-- would say \"You are a who calls it\". Putting the article in the content is what lets\n	-- every line that says a rung out loud be written the same way.\n	Ranks = {\n		-- Rung zero has no entry here: not being in a gang is the absence of a rank,\n		-- not a rank called \"nobody\", and giving it a row would put it on nameplates.\n\n		-- You are around. Nobody has asked you to do anything, and your cut is whatever\n		-- you were standing close enough to pick up.\n		{ id = \"hanger_on\", label = \"a hanger-on\", standing = 0 },\n		-- You get handed one job and told what to hold. The first rung that is worth\n		-- anything, because it is the first one where somebody else's plan has a slot\n		-- with your name in it.\n		{ id = \"hand\", label = \"a hand\", standing = 120 },\n		-- You pick your own role, and you can bring one person. The rung where the game\n		-- stops telling you where to stand.\n		{ id = \"name\", label = \"a name\", standing = 400 },\n		-- You choose the job, the crew, and who holds what.\n		--\n		-- Capped at one gang, which is the same device `closest` uses in Ties.luau and\n		-- is here for the same reason: it is the first gang decision that costs\n		-- something. Running the east side means not running the west side.\n		{ id = \"caller\", label = \"who calls it\", standing = 1000, oneGangOnly = true },\n	},\n\n	-- What standing a piece of work is worth.\n	--\n	-- The user's rule is that anything helping the gang counts, so this is deliberately\n	-- broad rather than a bank-robbery counter. The numbers are ratios first and\n	-- absolutes second: a till is a chore, a vault is an event, and getting clear\n	-- afterwards is worth more than either because it is the part players skip.\n	Earn = {\n		-- Per unit of money taken from a till or a vault. Small on purpose -- money is\n		-- already its own reward, and paying standing per dollar as well would make the\n		-- richest route the only route.\n		-- Safe range: 0.01-0.06.\n		PerMoneyStolen = 0.02,\n\n		-- Flat, once, for tripping a vault. The bank is the set piece and it should read\n		-- as one on the ladder too.\n		-- Safe range: 20-80.\n		VaultOpened = 45,\n\n		-- Flat, for coming down from a real bounty to nothing without being arrested.\n		-- The largest single award in the table, because escaping is the only line here\n		-- that cannot be farmed by standing still and holding a button.\n		-- Safe range: 40-140.\n		GotAway = 90,\n\n		-- The bounty you must have actually reached for GotAway to pay. Stops a player\n		-- collecting an escape award for the two points a witness gave them.\n		-- Safe range: 25-80.\n		GotAwayNeedsBounty = 40,\n\n		-- Per second spent inside a room where somebody else's alarm is ringing.\n		--\n		-- This is the one that makes a second person worth having. BankService already\n		-- charges heat to everybody in the room rather than to whoever tripped it, so\n		-- standing on the panel while a gang-mate empties the vault is heat you took\n		-- that was not yours -- and that is precisely the thing a gang should reward.\n		-- Safe range: 1-6.\n		PerSecondSharedHeat = 3,\n	},\n\n	-- What it costs.\n	--\n	-- Failure has to be worth playing, so these are real rather than decorative -- but\n	-- none of them can take a rung away. A rung was conferred in a moment by a person,\n	-- and quietly deleting it later is the exact \"telling you about your own life after\n	-- the fact\" that the offer model exists to prevent. Standing falls; the rung holds.\n	Lose = {\n		-- Standing lost on arrest. Being caught is not a betrayal, it is an occupational\n		-- hazard, so this is a setback and not a purge.\n		-- Safe range: 60-200.\n		OnArrest = 120,\n\n		-- Standing lost for leaving a room while its alarm was ringing and somebody else\n		-- was still holding the vault. This is the betrayal, and it is the only entry\n		-- here that is about another person rather than about the police.\n		-- Safe range: 100-300.\n		OnBailing = 180,\n\n		-- The floor. Standing never goes below this, so a bad night cannot cost a player\n		-- a rung's worth of history they earned weeks ago.\n		-- Safe range: 0-50.\n		Floor = 0,\n	},\n\n	-- Part 2: who runs with you. Slots, not a cost -- reaching the rung is the cost, the\n	-- same way reaching a rung is the only price a promotion ever has, and recruiting is\n	-- something the boss does for you rather than something bought off a menu.\n	Crew = {\n		-- Total crew slots at each rung, keyed by GangRankDef.id. \"hanger-on\" and \"hand\"\n		-- are deliberately absent rather than zero: GangService.crewSlotsFor treats a\n		-- missing rung as zero, and leaving them out says the same thing the spec does --\n		-- those two rungs are where somebody else's plan has a slot with your name in it,\n		-- not the other way round.\n		-- Safe range: 1-2 for \"name\", 2-4 for \"caller\".\n		SlotsByRank = {\n			name = 1,\n			caller = 3,\n		},\n\n		-- Where a new recruit's nerve starts. Low: they have not done anything with you\n		-- yet, and a recruit who started confident would make the meter a formality\n		-- rather than something earned.\n		-- Safe range: 10-30.\n		NerveStart = 20,\n\n		-- The ceiling. Never lowered, never spent -- see GangCrewMember.nerve.\n		NerveMax = 100,\n\n		-- Nerve gained per point of standing credited while this crew exists, split\n		-- across every member rather than multiplied by their count. A three-person crew\n		-- does not make the same job worth three times the steadying; it is still one\n		-- job.\n		-- Safe range: 0.05-0.2.\n		NerveGainPerPoint = 0.1,\n	},\n\n	-- Part 3: sending that crew on a job, rather than doing every job yourself. The bank's\n	-- alarm control is the whole role table for now -- one seat, filled by you or by them --\n	-- because it is the one control in the game that was already a shared, room-level thing\n	-- rather than a per-player one, which is what makes handing it to somebody else legible.\n	Jobs = {\n		-- The chance a called crew member simply fails to make the alarm go quiet, once per\n		-- time it rings, rolled at the low and high end of nerve and lerped between. This is\n		-- the \"badly\" in the spec's \"NPC crew execute them, badly if their nerve is low\" --\n		-- a fresh recruit (Crew.NerveStart, 20) is still wrong more often than not, so\n		-- sending one on a bank on day one is a real gamble, not a formality with a body\n		-- attached to it.\n		-- Safe range: 0.5-0.9.\n		AlarmFailChanceAtZeroNerve = 0.75,\n		-- Never zero -- a maxed-out crew member is reliable, not a second silence button\n		-- that never misses.\n		-- Safe range: 0.02-0.15.\n		AlarmFailChanceAtMaxNerve = 0.05,\n\n		-- A till has no seat to hand off -- the clerk and the camera are the whole\n		-- activity and stay the player's to read, on purpose (see TheftService's header).\n		-- What a lookout can do instead is soften getting caught, not prevent it: the\n		-- *first* time a robbery is spotted this session, one roll against their nerve\n		-- decides whether that one HeatOnSpotted hit lands or gets waived. Being spotted\n		-- still happens, the notice still says so, and the ongoing per-second heat while\n		-- you keep holding through it is untouched -- staying spotted is still on you.\n		-- Same fail-chance shape as the alarm, same reason: a fresh recruit misses this\n		-- more often than not.\n		-- Safe range: 0.5-0.9.\n		TillCoverFailChanceAtZeroNerve = 0.75,\n		-- Safe range: 0.02-0.15.\n		TillCoverFailChanceAtMaxNerve = 0.05,\n	},\n\n	-- The head covering.\n	--\n	-- Sized in studs against an unscaled R15 head, then scaled with the head it sits on,\n	-- so it fits a nine-year-old and a grown adult without a second set of numbers.\n	Bandana = {\n		-- How far the band sticks out past the head on each axis. Small: this is a band\n		-- around a head, not a helmet, and a value large enough to read as headgear from\n		-- across a street is also large enough to clip through a hair accessory.\n		-- Safe range: 0.05-0.25.\n		Swell = 0.12,\n\n		-- How tall the band is, and how far above the head's center it sits. Together\n		-- these put it across the forehead rather than over the eyes or on the crown.\n		-- Safe range: Height 0.3-0.8, Lift 0.1-0.45.\n		Height = 0.52,\n		Lift = 0.26,\n\n		-- How much of the color is emitted rather than lit. The point of the band is to\n		-- be identifiable at a distance in any weather and at night, and a purely\n		-- diffuse band goes grey at dusk exactly when a gang most needs to be counted.\n		-- Not 1: a fully neon head reads as a powerup, not as clothing.\n		-- Safe range: 0.25-0.7.\n		Glow = 0.45,\n	},\n\n	-- How much easier the colors make you to describe.\n	--\n	-- Multiplies heat from anything that saw you while you were wearing them, on top of\n	-- the record multiplier BountyService already applies. This is the liability half of\n	-- the bandana and it is what makes taking it off a real decision rather than a\n	-- cosmetic one.\n	-- Safe range: 1.1-1.8. At 1 the colors are free and the choice disappears.\n	ColorsSuspicion = 1.35,\n\n	-- How long you must be out of a gang before another will take you.\n	--\n	-- Not a punishment -- it is here so that \"which gang\" is a decision with a cost\n	-- rather than a menu a player reopens whenever a rival's job looks better. In game\n	-- seconds, real time.\n	-- Safe range: 60-600.\n	RejoinSeconds = 180,\n\n	-- How old the four bosses are.\n	--\n	-- Here for the same reason the bank guard's age is: NPCService otherwise picks an age\n	-- near the player's, which is right for a stranger in the street and wrong for somebody\n	-- who runs a gang -- it would put a nine-year-old in charge of the east side for a\n	-- nine-year-old player, and the one thing a boss has to read as is somebody older than\n	-- you who was already here.\n	-- Safe range: 28-60.\n	BossAgeYears = 41,\n\n	-- How often membership is re-read: colors re-applied after a respawn, standing\n	-- pushed to the client, escapes noticed. Slower than the crime tick because nothing\n	-- here is a reaction time.\n	-- Safe range: 0.4-1.5.\n	TickSeconds = 0.5,\n}\n\n-- The map the player reads: the minimap in the corner and the full sheet behind it.\n--\n-- The map has no extent written down here. It is measured from the place points that\n-- exist, so a city that grows draws a bigger map with nothing edited -- the same reason\n-- Territory has no region bounds. tools/world_plan.py owns the world's real numbers and\n-- nothing in Config transcribes them.\nConfig.Map = {\n	-- How far past the outermost place point the drawn map extends, in studs. Place\n	-- points sit at doorways, so an unpadded map is cropped exactly at the last building\n	-- and the world reads as ending at its own front step.\n	-- Safe range: 40-200.\n	EdgePadStuds = 90,\n\n	-- How many real place points must exist before the measured bounds are trusted and\n	-- cached. Place points are tagged instances that stream in, so a bounds taken from\n	-- the first three that happen to be loaded would pin a map the size of one street\n	-- for the life of the server. Below this the bounds are recomputed next time.\n	-- Safe range: 8-40.\n	MinPlacesForBounds = 12,\n\n	-- How much of the world the minimap shows, as a radius in studs from the player.\n	-- Small enough that the icons on it are the ones you could walk to in the next\n	-- minute; the full sheet is where you plan anything longer.\n	-- Safe range: 120-500.\n	MinimapRadiusStuds = 260,\n\n	-- How often the minimap re-reads the player's position and redraws, in seconds.\n	-- This is a camera-follow rather than a state push, so it wants to be smooth rather\n	-- than cheap -- but it is still redrawing icons, so it is not every frame.\n	-- Safe range: 0.03-0.2.\n	MinimapRefreshSeconds = 0.06,\n\n	-- The side of the square the full map is drawn in, as a fraction of the shorter\n	-- screen axis. Under 1 so the sheet never touches the screen edges.\n	-- Safe range: 0.6-0.95.\n	SheetScreenFraction = 0.82,\n\n	-- How wide to assume the map sheet is, in pixels, before Roblox has laid it out.\n	--\n	-- Only the terrain cull reads it: it decides which world rectangles are too small to\n	-- be worth an instance, and it needs a pixel size at the moment the server pushes map\n	-- data -- which is before the sheet has ever been shown, so `AbsoluteSize` is zero.\n	-- Being wrong here costs a few hundred extra or missing hairline rectangles, not a\n	-- broken map, so a sensible middle is better than a lazy first-open rebuild.\n	-- Safe range: 400-1200.\n	SheetAssumedPixels = 700,\n\n	-- How far in the sheet can be zoomed, and by how much per wheel click or button\n	-- press.\n	--\n	-- **Zoom is what makes the \"main spots only\" rule affordable.** This world has\n	-- several hundred place points and drawing all of them at once is a sheet nobody can\n	-- read -- but dropping the rest permanently would mean the map could not answer\n	-- \"where is the nearest cafe\", which is most of what a map is for. So the sheet shows\n	-- the landmarks at rest and hands the rest back as you zoom in. Nothing is hidden;\n	-- it is filed.\n	-- Safe range: 3-8 for the ceiling, 1.15-1.6 for the step. A step under about 1.15\n	-- takes too many clicks to cross the range and starts feeling broken.\n	MaxZoom = 5,\n	ZoomStep = 1.3,\n	-- How long a zoom takes to land. Short: this is a direct manipulation, and anything\n	-- a player is holding a wheel down to do must not queue up behind its own animation.\n	-- Safe range: 0.06-0.2.\n	ZoomSeconds = 0.12,\n\n	-- The zoom a place has to be at before it is drawn, and before its name is printed\n	-- beside it, by tier. Every rule in `Icons.Rules` names one of these three.\n	--\n	-- A name costs far more room than a dot does, so every label threshold sits above its\n	-- own dot threshold: a place appears first, and tells you what it is when there is\n	-- space to say so.\n	-- Safe range: 1 for landmark (it must be the resting picture), then increasing.\n	DetailZoom = {\n		-- The dozen or so places that are the reason to open a map at all: the bank, the\n		-- school, the hospital, the park, your own front door.\n		landmark = 1,\n		-- The rest of the named world -- offices, cafes, the gym, a marina.\n		district = 1.8,\n		-- Every generated address. Hundreds of them, and only worth drawing once the\n		-- player has zoomed far enough in that a street is what they are looking at.\n		street = 2.8,\n	},\n	LabelZoom = {\n		landmark = 1,\n		district = 2.4,\n		street = 3.6,\n	},\n\n	-- The graticule: one line every this many studs, in both axes.\n	--\n	-- Without it the sheet is dots on a void and the zoom has nothing to move against --\n	-- a player zooming into an empty patch cannot tell that anything happened. A grid\n	-- that scales with the zoom is the cheapest possible answer to both.\n	-- Safe range: 100-400. Under 100 it is a texture rather than a grid.\n	GridStuds = 200,\n\n	-- How many points across a strip are probed to find where the side changes.\n	--\n	-- This is a *search* width, not a drawing resolution, and it does not put a step in\n	-- the picture: a probe only says \"the boundary is somewhere between these two\", and\n	-- the exact crossing is then bisected to well under a pixel. So this only has to be\n	-- fine enough that no side is ever entirely skipped over between two probes -- a side\n	-- narrower than one probe spacing at some latitude would be missed.\n	-- Safe range: 24-72. Four sides on a world this size need nowhere near the top of it.\n	RegionSampleCells = 44,\n\n	-- How many horizontal strips the fill is cut into.\n	--\n	-- **This is the only place a staircase can still show, so it is much finer than the\n	-- column count above.** A side is a Voronoi cell and a Frame is a rectangle, so the\n	-- fill has to be built out of strips; the *ends* of each strip are solved for exactly\n	-- (see `buildRegions`), which leaves the strip height as the one remaining step. At\n	-- 44 that step is a visible ledge the moment anybody zooms in -- which was the whole\n	-- complaint about the old mosaic, reproduced at a quarter of the frame count.\n	--\n	-- Cost is roughly this many Frames times the number of sides a row crosses, so\n	-- doubling it doubles the build, and the build happens once when the overlay is first\n	-- switched on.\n	-- Safe range: 120-320. Below about 100 the ledges come back.\n	RegionRows = 220,\n\n	-- How opaque the region wash is. It sits under the icons and must never compete\n	-- with them -- it is an answer to \"whose side is that\", not a layer to read.\n	-- Safe range: 0.55-0.9.\n	RegionTransparency = 0.72,\n\n	-- The full sheet draws the same sampling as two layers rather than one, and this is\n	-- the pair of numbers that separates them.\n	--\n	-- **A flat mosaic is not a territory map.** Colouring every sampled cell at one\n	-- transparency -- which is what this did first -- gives four large blurry stains with\n	-- a visible grid in them, and the thing a player actually wants off a territory map\n	-- is the *line*: where does one side stop. So the fill is taken almost all the way\n	-- out, and the cells that have a different owner next to them are drawn again, bright\n	-- and opaque, as a border. Same sampling, same correctness, a picture with edges in\n	-- it.\n	-- Safe range: 0.8-0.94 fill, 0-0.3 border. The gap between them is the whole effect.\n	RegionFillTransparency = 0.88,\n	RegionBorderTransparency = 0.1,\n	-- How thick that border is drawn, in pixels at rest. It is drawn in offset so it\n	-- stays one line thick at every zoom -- a border that thickened as you zoomed in\n	-- would swallow the region it was outlining.\n	-- Safe range: 1-4.\n	RegionBorderPixels = 2,\n\n	-- How the drawn world is toned before it goes on the sheet.\n	--\n	-- `src/shared/world/MapShapes.luau` carries every shape in the colour the world\n	-- actually paints it, and dropping those on the sheet raw was the first version: it\n	-- looks like somebody pasted a screenshot into the menu. Bright green lawns and white\n	-- roofs against a near-black panel out-shout the icons, the territory lines and the\n	-- you-marker -- which are the things the map is *for*. The picture is the background\n	-- and has to behave like one.\n	--\n	-- Two knobs, applied in this order:\n	--\n	-- `Saturation` is how much of the colour's own hue survives. At 0 the world is\n	-- greyscale, which reads as a printed street map; at 1 it is the world's own palette.\n	-- In between you keep \"grass is greener than asphalt\" while losing \"grass is loud\".\n	--\n	-- `Tint` is how far the result then sits from the panel behind it. At 0 a shape is\n	-- invisible; at 1 it is at full strength. This is the contrast dial.\n	--\n	-- Buildings sit above ground on both, so that the blocks read as raised out of the\n	-- streets between them without needing an outline on nine hundred Frames.\n	-- Safe range: 0.2-0.7 for saturation, 0.35-0.8 for tint. Push tint past about 0.8 and\n	-- the icons stop winning.\n	Shapes = {\n		SurfaceSaturation = 0.4,\n		SurfaceTint = 0.5,\n		BuildingSaturation = 0.45,\n		BuildingTint = 0.62,\n\n		-- Shapes below this many pixels on their short side are skipped at build time\n		-- rather than drawn. Not a look setting -- a Frame under a pixel wide costs\n		-- exactly as much as one that can be seen. This is measured at the resting zoom,\n		-- so anything dropped was never visible without zooming in.\n		-- Safe range: 0-1.5. At 0 nothing is skipped.\n		MinPixels = 0.6,\n	},\n\n	-- What each kind of place draws as, and how a place id is sorted into a kind.\n	--\n	-- Matched by prefix, in order, first hit wins -- so the longer, more specific rules\n	-- must come before the shorter ones. Prefix rather than an exact list because most\n	-- place ids in this world are generated: gen_city.py emits apt_3, office_7, rise_2,\n	-- fade_5, est_haulage and a dozen suburb_n, so an exhaustive table would be stale the\n	-- next time the city is regenerated with one more block in it.\n	--\n	-- Anything matching nothing draws as `Default`, which is the honest outcome for a\n	-- place this table has not been taught about: a plain dot that is still findable and\n	-- still labelled, rather than an invisible one or a crash. A map is the wrong place\n	-- to be strict -- a missing category should cost the player a colour, not a marker.\n	Icons = {\n		Default = { color = Color3.fromRGB(176, 182, 196), size = 5, priority = 0 },\n\n		-- Ordered longest-prefix-first where two could both match.\n		--\n		-- `tier` is *when* it is drawn, not what it is -- see `DetailZoom`. A landmark is a\n		-- place a player would name if you asked them where they were headed; a street is a\n		-- generated address that only matters once you are already looking at that street.\n		-- Getting this wrong in the generous direction is what turns the sheet back into\n		-- the wall of dots it was, so there is no default: `StyleFor` errors on a rule with\n		-- no tier rather than guessing one.\n		Rules = {\n			-- Where you live. The one icon a player looks for to orient themselves, so it\n			-- is the largest and warmest thing on the sheet that is not a boss.\n			{ prefix = \"home\", kind = \"home\", tier = \"landmark\" },\n			{ prefix = \"suburb_\", kind = \"home\", tier = \"street\" },\n			{ prefix = \"apt_\", kind = \"home\", tier = \"street\" },\n\n			-- Money and civic business.\n			{ prefix = \"bank\", kind = \"civic\", tier = \"landmark\" },\n			{ prefix = \"town_hall\", kind = \"civic\", tier = \"landmark\" },\n			{ prefix = \"school\", kind = \"civic\", tier = \"landmark\" },\n			{ prefix = \"library\", kind = \"civic\", tier = \"landmark\" },\n			{ prefix = \"hospital\", kind = \"civic\", tier = \"landmark\" },\n			{ prefix = \"police\", kind = \"civic\", tier = \"landmark\" },\n\n			-- Places that pay. The works district and every generated industrial estate\n			-- unit, which between them are most of the east of the map.\n			{ prefix = \"works_\", kind = \"work\", tier = \"district\" },\n			{ prefix = \"est_\", kind = \"work\", tier = \"street\" },\n			{ prefix = \"office_\", kind = \"work\", tier = \"street\" },\n			{ prefix = \"factory\", kind = \"work\", tier = \"district\" },\n			{ prefix = \"freight_depot\", kind = \"work\", tier = \"district\" },\n			{ prefix = \"timber_mill\", kind = \"work\", tier = \"district\" },\n			{ prefix = \"power_plant\", kind = \"work\", tier = \"district\" },\n			{ prefix = \"scrapyard\", kind = \"work\", tier = \"district\" },\n			{ prefix = \"auto_dealer\", kind = \"work\", tier = \"district\" },\n\n			-- Somewhere to be that is not work or home.\n			{ prefix = \"cinema\", kind = \"leisure\", tier = \"landmark\" },\n			{ prefix = \"city_park\", kind = \"leisure\", tier = \"landmark\" },\n			{ prefix = \"park\", kind = \"leisure\", tier = \"district\" },\n			{ prefix = \"gym\", kind = \"leisure\", tier = \"district\" },\n			{ prefix = \"cafe\", kind = \"leisure\", tier = \"district\" },\n			{ prefix = \"mall_entrance\", kind = \"leisure\", tier = \"landmark\" },\n			{ prefix = \"marina\", kind = \"leisure\", tier = \"district\" },\n			{ prefix = \"baywalk\", kind = \"leisure\", tier = \"district\" },\n			{ prefix = \"circus_\", kind = \"leisure\", tier = \"district\" },\n		},\n\n		-- Size is a radius in pixels on the full sheet; the minimap scales these down by\n		-- MinimapIconScale. Priority decides who draws on top when two icons land in the\n		-- same few pixels, which on a city this dense is most of them.\n		Kinds = {\n			home = { color = Color3.fromRGB(245, 205, 120), size = 7, priority = 40 },\n			civic = { color = Color3.fromRGB(126, 196, 244), size = 6, priority = 30 },\n			work = { color = Color3.fromRGB(150, 210, 158), size = 5, priority = 20 },\n			leisure = { color = Color3.fromRGB(226, 158, 226), size = 5, priority = 10 },\n		},\n\n		-- How much smaller an icon is on the minimap than on the sheet. The minimap is\n		-- about a quarter the width and the icons cannot shrink by the same factor or\n		-- they stop being clickable targets, so this is deliberately gentler than the\n		-- size ratio between the two surfaces.\n		-- Safe range: 0.5-0.9.\n		MinimapIconScale = 0.7,\n	},\n\n	-- The player's own marker, on both surfaces. Bright, and the one thing on the map\n	-- drawn in a colour nothing else is allowed to use -- Config.Guide.Color is gold and\n	-- the gang bands own cyan, orange, magenta and lime, so this is none of those.\n	YouColor = Color3.fromRGB(96, 250, 140),\n	YouSizePixels = 9,\n}\n\n-- Whose side of the map you are standing on.\n--\n-- Gangs.luau has carried a `side` field read by nothing since it was written, waiting\n-- for \"the map expansion\". This is that expansion. The four sides stop being a label on\n-- a boss and become a partition of the ground.\n--\n-- **There are no bounds in this table, on purpose.** A region is \"the ground closer to\n-- this boss than to any other boss\" -- nearest-of-four, measured from the boss place\n-- points themselves. Authoring four rectangles here would have meant four more numbers\n-- to re-derive by hand every time the world regenerates or a boss moves, and this\n-- tree's most repeated defect is exactly that: one measurement written down twice.\n-- Nearest-boss cannot drift, covers the whole map with no gaps and no overlaps by\n-- construction, and needs no maintenance when the city grows.\nConfig.Territory = {\n	-- How often a player's position is re-tested against the four sides. This decides\n	-- how quickly crossing a line is noticed and nothing else -- no reaction time hangs\n	-- off it, so it is slow. Matched to Gangs.TickSeconds because both are asking a\n	-- question about the same membership.\n	-- Safe range: 0.4-2.\n	TickSeconds = 0.5,\n\n	-- How far past the line you must be before a crossing counts, in studs. Without it\n	-- a player walking the boundary would trip a crossing every tick, and every notice\n	-- the system can send would fire in a loop for as long as they stood there.\n	-- Hysteresis rather than a cooldown: the band is a place, so the fix belongs in\n	-- space rather than in time.\n	-- Safe range: 8-40.\n	EdgeBandStuds = 18,\n\n	-- What running the line pays, and what it costs.\n	--\n	-- **Nothing here pays for time.** Config.Gangs.Earn says of GotAway that it is the\n	-- largest award in that table \"because escaping is the only line here that cannot be\n	-- farmed by standing still and holding a button\", and that is the law this block is\n	-- written against. Depth is the only thing measured: how far into somebody else's\n	-- side you actually walked. Standing still adds nothing at any point, because the\n	-- award is a maximum over positions and never a sum over seconds.\n	Incursion = {\n		-- Standing with your own gang per stud of the deepest point you reached inside a\n		-- rival side, paid once when you come back out. Small per stud because the\n		-- distances are hundreds: crossing a side at its middle is worth a few hundred\n		-- studs of depth.\n		-- Safe range: 0.05-0.4.\n		PerStudDepth = 0.15,\n\n		-- The most one incursion can pay, whatever the depth. The map's long axis is over\n		-- 1600 studs, and without a ceiling a single walk corner to corner would outpay a\n		-- bank vault -- which would make the ladder a hiking trail.\n		-- Safe range: 40-160.\n		MaxAward = 80,\n\n		-- How deep you must go before it pays at all. Stops a player farming the boundary\n		-- by stepping over it and back: a crossing has to be a trip into their side, not a\n		-- toe over the line.\n		-- Safe range: 40-160.\n		MinDepthStuds = 90,\n\n		-- Standing lost with the gang whose side you walked onto, charged once on entry\n		-- while wearing another gang's colors. This is the price and it is a real one:\n		-- standing gates what that gang will ever offer you, so running their line often\n		-- enough is how you make sure they never take you. Choosing a side by wearing it\n		-- where it is not welcome is the whole point.\n		-- Safe range: 10-60.\n		RivalCost = 25,\n	},\n}\n\n-- until the player cannot find the menu. A shop that hires at sixteen is no use to\n-- someone who never learned the shop was there, and \"walk around until you find it\"\n-- is not discovery, it is a search. This draws the line from where you are to the\n-- thing that just opened up.\n--\n-- Read by the client, which is what draws it. The server only decides where to\n-- point and when to stop.\nConfig.Guide = {\n	-- A punchier, more saturated amber than the old pale gold -- the same family\n	-- as a choice marker so it keeps meaning \"this is for you, go to it\", but\n	-- bright enough to read against grass, asphalt and every skybox this game\n	-- ships rather than washing out against anything light.\n	Color = Color3.fromRGB(255, 176, 34),\n\n	-- Every wing gets a dark rim: a slightly larger, slightly lower backing part\n	-- in near-black behind the bright one. This is the standard \"bright core,\n	-- dark outline\" wayfinding trick -- it is what keeps a white or gold arrow\n	-- legible in Immortals Fenyx Rising's path regardless of what ground color it\n	-- crosses -- and it is why the arrow reads as a solid marker instead of a\n	-- neon smear the instant it crosses pale stone or sand.\n	OutlineColor = Color3.fromRGB(18, 14, 8),\n	-- How much larger the outline is than the wing it backs, added on every side.\n	-- Safe range: 0.03-0.12. Below ~0.03 the rim is too thin to read at a glance;\n	-- above 0.12 it starts to swallow the bright core it is supposed to frame.\n	ArrowOutlineMarginStuds = 0.06,\n	-- How far below the wing (along the ground normal) the outline sits, so the\n	-- bright top face is never fully covered by its own rim.\n	-- Safe range: 0.02-0.08.\n	ArrowOutlineDropStuds = 0.035,\n	-- The outline's own rest transparency. Not neon and not animated by the flow\n	-- wave -- it stays close to solid so the rim it draws never itself washes out,\n	-- only fading in step with the wing it backs at the path's edges.\n	-- Safe range: 0.0-0.3.\n	OutlineTransparency = 0.12,\n\n	-- Each arrow is two thin neon bars meeting in a \"V\", built from vectors rather\n	-- than a texture -- there is still no Roblox group to upload a chevron image\n	-- to, and a shape built from two boxes needs no asset at all. The angle is\n	-- measured from the direction of travel to each bar, so a wide angle reads as\n	-- a shallow, open chevron and a narrow one reads as a sharp arrowhead.\n	-- Bolder and flatter than the first pass: thicker bars read as a solid\n	-- painted mark instead of a wire, and a lower profile keeps them from casting\n	-- odd shadows or clipping the camera on a shallow slope.\n	-- Safe range: length 0.9-2.2, thickness 0.12-0.3, height 0.06-0.2, angle 20-50.\n	ArrowWingLengthStuds = 1.6,\n	ArrowWingThicknessStuds = 0.28,\n	ArrowWingHeightStuds = 0.07,\n	ArrowWingAngleDegrees = 32,\n\n	-- Centre-to-centre gap between one arrow and the next along the path.\n	-- Safe range: 3-10. Below ~3 the chevrons blur into a solid stripe; above 10\n	-- the path reads as scattered dashes rather than a direction.\n	ArrowSpacingStuds = 5,\n\n	-- Hard cap on how many arrows exist at once. Built once in Guide.new() and\n	-- only ever repositioned or hidden, never recreated -- a path longer than\n	-- MaxArrows * ArrowSpacingStuds spaces its arrows further apart instead of\n	-- growing the pool, so a cross-map guide never costs more than a next-door one.\n	-- Safe range: 20-60.\n	MaxArrows = 36,\n\n	-- How high above the real ground each arrow floats, along the ground's own\n	-- normal so it stays flush on a slope rather than only a flat floor. Just\n	-- enough to clear a kerb or a paving seam without visibly hovering.\n	-- Safe range: 0.15-0.6.\n	ArrowLiftStuds = 0.35,\n\n	-- The stretch at each end of the path where arrows fade out instead of\n	-- stopping dead: nearest the player, so the path does not look welded to your\n	-- feet, and nearest the destination, so it does not look stabbed into the\n	-- doorway.\n	-- Safe range: 4-15.\n	ArrowEdgeFadeStuds = 8,\n\n	-- The travelling brightness wave that makes the path feel like it is flowing\n	-- toward the destination rather than just sitting there. FlowSpeedStuds is how\n	-- fast the bright band moves along the path; FlowWaveLengthStuds is the\n	-- distance from one bright band to the next; the two transparency values are\n	-- what an arrow fades between at rest and at the peak of the wave passing\n	-- through it. FlowPeakColor is what the wing's own Color lerps toward at the\n	-- peak of the wave -- a near-white flash rather than only a brightness change,\n	-- so the flow reads as energy passing through gold rather than gold merely\n	-- dimming and brightening.\n	-- Safe range: speed 4-16, wavelength 8-25, rest 0.55-0.8, peak 0.05-0.25.\n	FlowSpeedStuds = 12,\n	FlowWaveLengthStuds = 12,\n	FlowRestTransparency = 0.6,\n	FlowPeakTransparency = 0.05,\n	FlowPeakColor = Color3.fromRGB(255, 244, 214),\n\n	-- How high off the ground the destination anchor sits, before the waypoint's\n	-- own separate lift (WAYPOINT_LIFT_STUDS in Guide.luau) stacks on top of it.\n	-- Only needs to clear the exact floor point now that the path itself hugs the\n	-- real ground instead of running to an artificial height.\n	-- Safe range: 0-3.\n	LiftAtTargetStuds = 1,\n\n	-- How often the client re-walks the path: re-raycasts every arrow's ground\n	-- height and repositions the pool. The flow animation above updates every\n	-- frame regardless of this -- this interval is about the shape of the path,\n	-- which only changes as fast as the player walks.\n	-- Safe range: 0.1-1.\n	RefreshSeconds = 0.25,\n\n	-- How often the road-following route itself is recomputed against the navmesh --\n	-- a separate, much coarser interval than RefreshSeconds above, because asking\n	-- PathfindingService for a route is real work and the corners it finds do not\n	-- move just because the player took another step. The leg nearest the player is\n	-- re-anchored to their live position every RefreshSeconds regardless of this, so\n	-- the path never visibly lags behind their feet even between recomputes.\n	-- Safe range: 0.75-4.\n	RouteRefreshSeconds = 1.5,\n\n	-- Close enough to count as arrived, at which point the path would be pointing\n	-- at the ground under your own feet. The label stays up -- you still want to\n	-- know what you are standing in front of -- but the arrows go.\n	-- Safe range: 8-40. Wants to be at or above Work.StationRadiusStuds so the\n	-- path clears once you are inside the workplace rather than at the doorway.\n	ArrivedRadiusStuds = 26,\n}\n\nConfig.UI = {\n	-- How long a passive notice (e.g. an automatic age-up) stays on screen, and\n	-- how long it takes to fade in/out. Safe range: 2-8 and 0.2-1.\n	NoticeSeconds = 4.5,\n	NoticeFadeSeconds = 0.4,\n\n	-- How long the outcome of a choice stays up before the panel clears. Long\n	-- enough to read two sentences without rushing. Safe range: 3-10.\n	EventOutcomeSeconds = 5.5,\n\n	-- The server answers every accepted choice, so silence means it was refused\n	-- or dropped in flight. After this the choices come back rather than leaving\n	-- a dead panel on screen. Safe range: 2-10 — long enough that a slow server\n	-- doesn't re-enable a choice that is about to resolve.\n	EventResponseTimeoutSeconds = 5,\n\n	-- The game's one palette.\n	--\n	-- **These are the lobby's colours, and that is the point.** A player meets this game in\n	-- the lobby -- a warm near-black with a single gold standing on it -- and thirty seconds\n	-- later they are in a town opening a menu. If that menu is cold blue-grey with a\n	-- different white in it, the two places read as two products, and the seam between them\n	-- is exactly where somebody decides whether the thing they are in was made by one hand.\n	--\n	-- Warm and low-saturation on purpose. This is a life sim and the register it wants is\n	-- lived-in, not clinical. The saturation budget is spent on the things that carry\n	-- meaning -- a gang's colour, a bar that is filling, a refusal -- and nowhere else: a\n	-- surface bright enough to compete with a warning has taken the warning's job.\n	--\n	-- `Config.Lobby.Menu.Palette` is this same identity written a second time for the\n	-- lobby's own two files. The two must agree; when the lobby is next opened it should be\n	-- folded into this one.\n	Palette = {\n		-- The ground, and the three steps up from it. `Panel` is the sheet, `PanelDeep` is\n		-- the bottom of its gradient, `Row` is a card at rest and `RowHover` is one under\n		-- the cursor. Four values rather than two because a panel with a single flat fill in\n		-- it has no depth to hang a hierarchy on, and every list on it then reads as one\n		-- undifferentiated block.\n		Panel = Color3.fromRGB(18, 18, 22),\n		PanelDeep = Color3.fromRGB(13, 13, 16),\n		Row = Color3.fromRGB(30, 30, 36),\n		RowHover = Color3.fromRGB(44, 44, 52),\n		-- A row that is present and cannot be acted on. Darker than `Row`, so it recedes\n		-- rather than looking like a card that failed to load.\n		RowLocked = Color3.fromRGB(24, 24, 28),\n		-- Hairlines, strokes and scroll bars. Never a fill.\n		Edge = Color3.fromRGB(62, 60, 72),\n\n		Text = Color3.fromRGB(240, 236, 228),\n		Muted = Color3.fromRGB(148, 144, 156),\n\n		-- The one warm colour and the game's signature, carried over from the lobby title.\n		Accent = Color3.fromRGB(225, 200, 150),\n		AccentDeep = Color3.fromRGB(198, 158, 92),\n		-- Dark text on an accent fill.\n		Ink = Color3.fromRGB(24, 20, 14),\n\n		-- A refusal, a debt, a thing that is going wrong. The only red on the screen.\n		Warn = Color3.fromRGB(214, 126, 116),\n		-- Open, paid, owned, earned. The only green.\n		Good = Color3.fromRGB(126, 198, 148),\n\n		-- The wash behind an open panel, and how far through it the world still shows.\n		-- Not opaque: the point of a menu that does not take the whole screen is that the\n		-- town is still there behind it, and a backdrop dark enough to hide the town would\n		-- have made the panel full-screen by another route.\n		-- Safe range: 0.15-0.6.\n		Backdrop = Color3.fromRGB(6, 6, 9),\n		BackdropTransparency = 0.35,\n	},\n\n	-- The menu: a rail of tiles down the left edge, and a panel that opens beside it.\n	--\n	-- The rail is always on screen and the panel is not, which is the whole shape of\n	-- the thing. A menu you have to remember a key for is a menu most players never\n	-- open, and every pane behind this one answers a question a player has while they\n	-- are standing in the street -- what work is going, who is worth calling, what am\n	-- I actually good at. Those want a thing to click, not a shortcut to learn.\n	Menu = {\n		-- The rail's tiles. Square, so this is both dimensions.\n		-- Safe range: 34-56.\n		RailTilePixels = 46,\n		-- The gap between tiles, and the rail's inset from the left edge.\n		-- Safe range: 4-12.\n		RailGapPixels = 7,\n		-- Safe range: 8-24.\n		RailInsetPixels = 14,\n		-- The padding inside the rail's own backing plate, which is what turns seven\n		-- separate tiles into one object sitting on the screen.\n		-- Safe range: 0-10.\n		RailPadPixels = 6,\n		-- The icon drawn inside a tile. Smaller than the tile by enough that the tile\n		-- still reads as a target rather than as a frame around a picture.\n		-- Safe range: 16-30, and never above `RailTilePixels - 8`.\n		RailIconPixels = 24,\n\n		-- The panel's *ceiling*, not its height. The panel is as tall as the pane it is\n		-- showing and no taller; this is the point past which it stops growing and the\n		-- list starts scrolling instead.\n		--\n		-- It was a flat fraction first, and that was the single worst thing about the\n		-- panel: five rows of money inside a sheet claiming three quarters of the screen\n		-- reads as a page that failed to finish loading, and the eye goes to the empty two\n		-- thirds rather than to the five rows. Deliberately not the whole screen either --\n		-- the map sheet is the full-screen surface, and a second one would take away the\n		-- one thing that makes the map feel like it takes over.\n		-- Safe range: 0.6-0.9.\n		PanelHeightFraction = 0.76,\n		-- And the floor, so a one-row pane is still a panel rather than a strip. Below\n		-- about this a surface stops reading as a surface and starts reading as a tooltip\n		-- that got out of hand.\n		-- Safe range: 200-320, and never above `PanelHeightFraction` of a phone screen.\n		PanelMinHeightPixels = 260,\n		-- Safe range: 0.4-0.75.\n		PanelWidthFraction = 0.56,\n		-- And the pixels that fraction is clamped between.\n		--\n		-- A fraction on its own is wrong at both ends of the range of screens this game\n		-- runs on: 56% of a phone held sideways is too narrow for a row with a figure\n		-- column, and 56% of an ultrawide is a panel you have to move your head to read.\n		-- Safe range: 380-460 min, 640-820 max, and min must stay below max.\n		PanelMinWidthPixels = 420,\n		PanelMaxWidthPixels = 720,\n\n		-- The header strip: the player card, and the title bar under it.\n		-- Safe range: 68-100 and 26-44.\n		HeaderPixels = 86,\n		TitleBarPixels = 34,\n		-- One list row, and the gap between two.\n		-- Safe range: 44-64 and 4-10.\n		RowPixels = 54,\n		RowGapPixels = 6,\n\n		-- How the menu moves.\n		--\n		-- **Three curves, and everything here is one of them.** In on `Back.Out`, out on\n		-- `Quad.In`, and the out is faster than the in -- a player closing a menu has\n		-- already decided and is waiting on the animation, whereas a player opening one is\n		-- being shown something. Most UI that feels unjuicy is the right curves played too\n		-- slowly; nothing in this table is above a third of a second.\n		Motion = {\n			-- The panel arriving: how far it travels from the rail, and how long it takes.\n			-- Nothing is gated on it finishing -- the panel is clickable from frame one.\n			-- Safe range: 0-48 pixels, 0.1-0.35 seconds. Zero on either is an instant menu.\n			EnterPixels = 26,\n			EnterSeconds = 0.22,\n			-- Leaving. Kept under the entrance on purpose; see above.\n			-- Safe range: 0.06-0.2.\n			ExitSeconds = 0.14,\n\n			-- How long between one row landing and the next, and how far each rises.\n			--\n			-- The stagger is the difference between a list being dealt and a block\n			-- appearing. It is small because the longest pane here can be forty rows:\n			-- multiply this by the row count and keep the total under about a third of a\n			-- second, or a big relationships list becomes a wait.\n			-- Safe range: 0-0.05 stagger, 0-24 pixels. Zero on the stagger lands them together.\n			RowStaggerSeconds = 0.022,\n			RowRiseSeconds = 0.26,\n			RowRisePixels = 14,\n			-- The most rows that are allowed to stagger at all. Past this they all land on\n			-- the last offset, so a forty-row pane costs the same wait as a ten-row one.\n			-- Safe range: 6-20.\n			RowStaggerLimit = 12,\n\n			-- A row under the cursor: how much its coloured spine grows at each end, and how\n			-- long the colour takes to get there. Tiny and fast -- this is feedback that the\n			-- thing is live, not an animation worth watching, and above about 0.2 seconds it\n			-- lags behind a player running down a list.\n			--\n			-- **The spine grows; the row does not slide.** Sliding the row sideways was the\n			-- first version and it is wrong in a list: the spines make one vertical line down\n			-- the left edge of the pane, and pushing a single row out of that line breaks the\n			-- alignment of the two rows either side of it. The hover then draws the eye to the\n			-- seam rather than to the row.\n			-- Safe range: 0-10 pixels, 0.05-0.2 seconds.\n			HoverSpinePixels = 5,\n			HoverSeconds = 0.12,\n\n			-- The squash a rail tile does when it is pressed: how far past its own size it\n			-- goes, and the two halves of the bounce. This is the whole of the menu's\n			-- click feel and it happens before the panel has drawn anything, which is the\n			-- point -- the press is acknowledged in under a tenth of a second regardless of\n			-- what the pane behind it costs to build.\n			-- Safe range: 1.0-1.25, 0.05-0.12, 0.08-0.18.\n			PressScale = 1.14,\n			PressOutSeconds = 0.07,\n			PressBackSeconds = 0.12,\n\n			-- How far the world behind the panel is blurred, and how long the blur takes to\n			-- arrive. The one place in this game allowed to blur the screen: a backdrop\n			-- behind a menu is a depth cue, whereas a blur during play is a fault.\n			-- Safe range: 0-28. Zero turns it off entirely.\n			BlurSize = 16,\n			BlurSeconds = 0.2,\n		},\n\n		-- The order the rail draws in, and the pane each tile opens.\n		--\n		-- `id` is also the icon: `MenuIcons` draws a shape per id and errors on one it has\n		-- never heard of, so a tab added here without a picture behind it is a boot failure\n		-- naming the tab rather than a blank square in the rail. Same rule as the pane\n		-- switch in `MenuUI`, for the same reason.\n		--\n		-- `color` is what that pane is worth on screen: the tile's icon, the stripe down the\n		-- left of its rows, and its title. Every one of them is desaturated against what it\n		-- would be on a white background, because they sit on a near-black panel and a\n		-- fully-saturated hue on this ground is a hue that glows.\n		Tabs = {\n			{ id = \"jobs\", label = \"Jobs Available\", color = Color3.fromRGB(132, 186, 232) },\n			-- Second because it is the pane a player opens most often after work, and\n			-- because it is the one that used to be four rows stacked on the HUD: what a\n			-- house cost, what a bill wants and what is in the bank are facts you go and\n			-- look up, not things you need in your eyeline while you are walking.\n			{ id = \"money\", label = \"Money\", color = Color3.fromRGB(225, 200, 150) },\n			{ id = \"relationships\", label = \"Relationships\", color = Color3.fromRGB(226, 150, 172) },\n			{ id = \"gangs\", label = \"Gangs\", color = Color3.fromRGB(224, 124, 96) },\n			{ id = \"skills\", label = \"Skills\", color = Color3.fromRGB(126, 198, 148) },\n			-- The last two are the housekeeping pair, and they sit at the bottom because\n			-- nothing about the life being played is behind them. A player opens the five\n			-- above during a life and these two either once, or when something has gone\n			-- wrong -- which is exactly the ordering the rail should teach.\n			{ id = \"codes\", label = \"Codes\", color = Color3.fromRGB(178, 158, 220) },\n			{ id = \"settings\", label = \"Settings\", color = Color3.fromRGB(150, 146, 158) },\n		},\n	},\n}\n\nConfig.Death = {\n	-- Natural mortality only rolls once age >= RampStartAge.\n	-- ChancePerYear = min(MaxChancePerYear, BaseChancePerYear * (age - RampStartAge) ^ Exponent)\n	RampStartAge = 65,\n	BaseChancePerYear = 0.01,\n	Exponent = 1.6,\n	MaxChancePerYear = 0.6,\n\n	-- How long the death screen holds before the player is sent back to the lobby.\n	--\n	-- A ceiling rather than a wait: the screen has a \"Back to the menu\" button on it, and\n	-- most players will press it. This is what happens for the ones who do not, so that a\n	-- death is never a screen somebody is stuck looking at.\n	-- Safe range: 3-15. Long enough to read the summary, short enough that it doesn't feel\n	-- like a punishment.\n	RespawnDelaySeconds = 5,\n}\n\nConfig.Verdict = {\n	-- Under this age, a life gets no ribbon and the death screen stays blank.\n	-- Childhood deaths and early deaths are honest rather than forced into a\n	-- category they did not earn.\n	-- Safe range: 14-18. Sixteen matches the age the working life begins.\n	MinAge = 16,\n}\n\n-- The chapter spine. A life is six bands of ages, and a \"months passed\" reel is\n-- shown at every band boundary the player has lived up to, suppressed when the\n-- shared \"what happened\" query returns no moments for the window.\n--\n-- The bands are a player-experience decision, not a calendar one. They sit on\n-- the design's own age-of-decision splits: ages 0-5 carry the ambient-event\n-- toy years, age 6 onwards turns the year over to events without aging, age 15\n-- opens the working life, age 20 is where the long adult band begins. The\n-- bands are wide enough to span 5-10 minutes each at walking pace; the last\n-- adult band is the widest because the verbs accumulate there.\n--\n-- `ChapterBands` is read by `LifeService` to decide when to fire a break and\n-- where to age the life to on continue. `ChapterMinAge` and `ChapterMaxAge`\n-- are derived from the first and last entries, kept here so a service does not\n-- have to walk the table every tick to find them.\nConfig.Life = {\n	-- Each entry is `{ fromAge, toAge }` inclusive on both ends. Adjacent bands\n	-- share no ages — a 5 year old is in band 2, not band 1 — and the union of\n	-- all bands is the whole of a life. Adding a band is an edit here and nothing\n	-- else.\n	ChapterBands = {\n		{ 0, 4 },\n		{ 5, 9 },\n		{ 10, 14 },\n		{ 15, 19 },\n		{ 20, 39 },\n		{ 40, 80 },\n	},\n}\n\n-- The menu a life is chosen in, before it starts running.\n--\n-- The load-bearing idea, and the reason this is not just a cosmetic screen: **the world\n-- is stopped while it is open.** A profile with no `setup` is a life that has not begun,\n-- and the age-up clock reads that before it banks a second. Without it the menu would be\n-- a thing the player has to beat, and the first thing AGES ever asked them to do would be\n-- to hurry.\nConfig.Slots = {\n	-- How many lives a player can keep at once.\n	--\n	-- Three because the menu has to show them all at a glance -- a slot you have to scroll\n	-- to is a slot you forget you own -- and because two reads as \"your life and a spare\"\n	-- while three reads as a choice about how you want to play.\n	--\n	-- **Raising this is safe at any time.** Every load runs `Lives.Reconcile` over the slot\n	-- list and appends empty lives up to this number, so an existing save simply gains the\n	-- new slots. **Lowering it is not**: slots past the new count stop being reachable and\n	-- the lives in them become invisible rather than deleted. Nothing in the code prevents\n	-- it, because the honest fix is a migration that asks the player which to keep, and that\n	-- is a feature rather than a guard.\n	-- Safe range: 1-6 going up. Do not go down on a build that has shipped.\n	Count = 3,\n\n	-- How long the delete confirmation stays armed, in seconds.\n	--\n	-- Deleting a life is the only irreversible thing in this game that is not dying, so it\n	-- takes two presses -- and the arming lapses rather than sticking, so a player who armed\n	-- it and walked away does not come back to a menu one stray click from erasing a life.\n	-- Safe range: 3-15. Below ~3 the second press becomes a race.\n	DeleteConfirmSeconds = 6,\n}\n\n-- The lobby: a second Roblox *place*, not a screen inside this one.\n--\n-- The player joins the lobby first, stands on a composed stage as their real Roblox\n-- avatar, picks a life, and is teleported into the game place. That split was the user's\n-- call -- \"it would make life much easier for later updates\" -- and it is the right one for\n-- a reason worth writing down: the game place is thirteen per-player tick loops, a streamed\n-- town and a house full of props, none of which have any business existing while somebody\n-- is reading a menu. A menu drawn over a running world has to *suppress* all of that and\n-- keep suppressing it as the world grows. A menu in its own place never has to.\n--\n-- The cost of the split is the handoff, and it is real: the two places share one\n-- ProfileStore session lock, so the lobby has to let go of the profile before the game\n-- place can pick it up. See LobbyService for how that is sequenced and what it means for\n-- how long Play takes.\nConfig.Lobby = {\n	-- **Both must be filled in before either place works, and they are the one pair of\n	-- numbers in this codebase that cannot be derived or defaulted.** A Roblox place id\n	-- only exists once the place has been published, so there is no honest value to ship:\n	-- zero means \"not published yet\", and every path that would use one says so by name\n	-- rather than failing at a web call.\n	--\n	-- To fill them in: publish the lobby as the *start place* of the experience and the\n	-- game as a second place under it, then read both ids off the Creator Dashboard.\n	-- GamePlaceId is where Play sends you; LobbyPlaceId is where the game place sends you\n	-- back to.\n	GamePlaceId = 0,\n	LobbyPlaceId = 0,\n\n	-- How long the lobby waits for a profile before it gives up on the Play button.\n	--\n	-- Longer than the game place's equivalent wait on purpose. Arriving at the lobby is the\n	-- *first* thing that happens to a player, so nothing is competing for the datastore and\n	-- a slow load here is a cold start rather than a contended lock -- but it is also the\n	-- one load with nothing behind it to fall back on, so waiting is strictly better than\n	-- refusing. Safe range: 10-60.\n	ProfileWaitSeconds = 30,\n\n	-- How long a Play press stays \"in flight\" before the lobby will accept another one.\n	--\n	-- `TeleportAsync` is a yielding web call, and a player who presses Play twice would\n	-- otherwise fire two of them. This is not a cooldown on pressing Play -- it is the\n	-- window in which the *first* press is still being answered. A failed teleport clears\n	-- it immediately, so this number is only ever reached when Roblox itself has gone quiet.\n	-- Safe range: 10-60.\n	TeleportTimeoutSeconds = 20,\n\n	-- How many times a failed teleport is retried, and how long between tries.\n	--\n	-- Teleports fail for reasons that pass on their own -- rate limits, a place still\n	-- starting up -- so a single failure is not news worth showing the player. Retried\n	-- silently; only the last failure is ever reported, and it is reported.\n	-- Safe range: 0-5 tries, 1-10 seconds.\n	TeleportRetries = 3,\n	TeleportRetrySeconds = 2,\n\n	-- The stage the avatar stands on. All of it is measured from the mark the character\n	-- stands on, which is the origin of the composition -- see `content/Stage.luau` for why\n	-- nothing here is an absolute world position.\n	Stage = {\n		-- Where the first stage sits in the world.\n		--\n		-- **The world origin, and that is not arbitrary.** An earlier version put the set 200\n		-- studs up to keep the void out of shot -- which the backdrop and the fog already do --\n		-- and it created a real problem in exchange: (0, 0, 0) is where Roblox puts a character\n		-- when there is no SpawnLocation yet, so the one spot a character can accidentally\n		-- appear was two hundred studs from the only floor in the place. Standing the set on\n		-- the origin means that accident lands on the disc instead of in the void.\n		Origin = Vector3.new(0, 0, 0),\n\n		-- How far apart two players' stages are built, in studs along X.\n		--\n		-- **Every player in the lobby gets their own stage, and this is why.** The screen is\n		-- one composed shot of *your* avatar; a shared stage would put every other player in\n		-- the lobby standing inside you on the mark. The alternatives are worse in both\n		-- directions -- separate marks around one stage means everyone else walks through\n		-- your shot, and hiding other characters means a client-side transparency loop that\n		-- is wrong for one frame every time somebody joins.\n		--\n		-- Must comfortably exceed the backdrop width (220 studs) or a neighbour's scenery\n		-- appears past the edge of yours. Twenty-odd anchored parts per player is nothing.\n		-- Safe range: 300-1000.\n		Spacing = 400,\n\n		-- Where the camera sits relative to the mark, and what it looks at relative to the\n		-- mark. Behind-right and slightly above, aimed at chest height rather than at the\n		-- feet: a camera level with the mark looks up somebody's nose, and one aimed at\n		-- head height leaves them standing on the bottom edge of the screen.\n		-- Safe range: 9-20 studs back, 3-8 up.\n		CameraOffset = Vector3.new(6.5, 4.2, 12),\n		CameraLookAt = Vector3.new(0, 3, 0),\n\n		-- The slow drift, so the screen is never a still image. Degrees of orbit either side\n		-- of the framing above, and seconds for one full there-and-back.\n		--\n		-- Small and slow on purpose: this has to sit behind a menu somebody is reading. A\n		-- drift wide enough to notice as movement is wide enough to be motion sickness by\n		-- the third life. Safe range: 0-6 degrees, 20-90 seconds. Zero holds it still.\n		DriftDegrees = 2.5,\n		DriftSeconds = 44,\n	},\n\n	-- What the menu drawn over that stage looks like.\n	--\n	-- **One palette, in one place, because the two files that draw the lobby meet at a seam\n	-- the player can see.** Pressing \"Create a life\" swaps the slot list for the setup card in\n	-- the same column, in place, with no transition between them -- so a colour that differed\n	-- by six points between `LobbyUI` and `SetupCard` would read as two different games\n	-- stitched together at the exact moment the player is deciding whether to trust this one.\n	-- Both files used to carry their own copy with a comment on each apologising for it; this\n	-- is that comment made structural.\n	--\n	-- Colours are `Color3.fromRGB`. There is no safe range for a colour, but there is a rule:\n	-- `Text` on `Panel` and `Ink` on `Accent` are the two pairs that carry every word on the\n	-- screen, and both must stay far enough apart to read on a phone in daylight.\n	Menu = {\n		Palette = {\n			-- The dark ground everything sits on, and the two steps up from it. `Row` is a\n			-- card at rest, `RowHover` is one under the cursor.\n			Panel = Color3.fromRGB(18, 18, 22),\n			Row = Color3.fromRGB(30, 30, 36),\n			RowHover = Color3.fromRGB(44, 44, 52),\n			-- A row that exists but cannot be pressed -- a locked era. Darker than `Row`, so it\n			-- reads as recessed rather than as a card that failed to load.\n			RowLocked = Color3.fromRGB(24, 24, 28),\n			Edge = Color3.fromRGB(62, 60, 72),\n\n			Text = Color3.fromRGB(240, 236, 228),\n			Muted = Color3.fromRGB(148, 144, 156),\n\n			-- The one warm colour, and the game's signature. Used for exactly three things:\n			-- the title, the selected slot, and Play. Spending it on a fourth would cost it\n			-- the first three.\n			Accent = Color3.fromRGB(225, 200, 150),\n			AccentHover = Color3.fromRGB(240, 218, 168),\n			-- The deep end of the title and Play gradients. Gold falling into amber, rather\n			-- than into brown -- keep the hue, drop the value.\n			AccentDeep = Color3.fromRGB(198, 158, 92),\n			-- Dark text on an accent fill.\n			Ink = Color3.fromRGB(24, 20, 14),\n\n			-- A refusal, and an armed delete. The only red on the screen.\n			Warn = Color3.fromRGB(214, 126, 116),\n			-- A life that is running. The spine on a playable slot card, and nothing else --\n			-- it is the colour that means \"there is somebody alive in here\".\n			Living = Color3.fromRGB(126, 198, 148),\n			-- A life that has ended. Grey rather than red: a dead slot is a record the player\n			-- earned, not an error, and colouring it like a failure would be the wrong reading\n			-- of the one screen where finished lives are kept.\n			Gone = Color3.fromRGB(120, 116, 126),\n			-- A control that is mid-request. Desaturated rather than transparent, so the button\n			-- stays exactly where it was and the screen never appears to lose a control.\n			Busy = Color3.fromRGB(118, 112, 98),\n			-- A control that is present and cannot be used right now -- the minus on a stat\n			-- already at its floor. Darker than `Muted`, because a disabled control has to lose\n			-- against body text it sits next to: the player should read the number, not the\n			-- button that will not move it.\n			Disabled = Color3.fromRGB(90, 88, 98),\n		},\n\n		Motion = {\n			-- The column's arrival: how far it travels, and how long it takes.\n			--\n			-- **The first motion in the game, so it sets the register for everything after it.**\n			-- Short and small: a menu that makes the player wait for it to finish assembling is\n			-- a menu that has decided its own animation matters more than the press it is\n			-- delaying. Everything is interactive from frame one regardless -- the tween moves\n			-- pixels, it does not gate input.\n			-- Safe range: 0-80 pixels, 0-1.2 seconds. Zero on either is an instant menu.\n			EnterPixels = 44,\n			EnterSeconds = 0.42,\n\n			-- How long between one slot card arriving and the next.\n			--\n			-- The stagger is what makes three cards read as a list being dealt rather than as a\n			-- block appearing. Multiplied by the card index, so the last card of `Config.Slots.Count`\n			-- sets the total -- keep `Count * CardStaggerSeconds` under about a third of a second\n			-- or raising the slot count turns the menu into a wait.\n			-- Safe range: 0-0.12. Zero lands them all together.\n			CardStaggerSeconds = 0.06,\n			CardRiseSeconds = 0.34,\n			-- How far a card travels on the way in, in pixels, and how far one slides right\n			-- under the cursor. The hover slide is deliberately tiny: it is feedback that the\n			-- row is live, not an animation worth watching.\n			-- Safe range: 0-60 rise, 0-12 hover.\n			CardRisePixels = 26,\n			CardHoverPixels = 6,\n			-- Hover in and out. Fast enough that the card feels attached to the cursor;\n			-- anything above ~0.2 lags behind a player moving down a list.\n			-- Safe range: 0.05-0.25.\n			HoverSeconds = 0.12,\n\n			-- The sheen that crosses the Play button, and how often.\n			--\n			-- **Only ever runs while Play would actually work.** A button that shines while\n			-- refusing to open anything is a button advertising a thing it will not do, and the\n			-- player learns to distrust the shine rather than reading the label under it.\n			-- Safe range: 2-12 seconds between passes, 0.5-1.6 per pass. Below ~2 it is a\n			-- strobe rather than a highlight.\n			SheenPeriodSeconds = 4.5,\n			SheenSweepSeconds = 0.9,\n		},\n\n		-- How wide the readability scrim behind the column is, as a fraction of the screen,\n		-- and how far into that width the fade to transparent runs.\n		--\n		-- The column is text standing directly on a 3D scene, and the scene has a lit avatar\n		-- and glowing shards in it. Without a scrim the subtitle is legible on a dark shoulder\n		-- and gone against the halo. The fade is what stops it reading as a grey box pasted on\n		-- the left: it is a gradient into the shot, not a panel over it.\n		-- Safe range: 0.3-0.7 width, and a fade start of 0.4-0.9 of that width. The fade start\n		-- must stay below 1 or there is no gradient at all.\n		ScrimWidth = 0.46,\n		ScrimFadeStart = 0.55,\n		-- How dark the scrim is at its darkest, left edge. Safe range: 0.05-0.5. At 0 the left\n		-- edge of the screen is pure black and the composition loses its floor.\n		ScrimTransparency = 0.12,\n	},\n\n	-- Join codes: a short string a player generates for one of their slots, then\n	-- enters (by hand or on another device) to jump straight to Play. It is a\n	-- convenience, not a security feature -- the code is checked against the\n	-- server's own table and the slot is still bounds-checked on arrival.\n	JoinCode = {\n		-- How many characters the code has. Six is long enough to not collide by\n		-- chance (36^6 ≈ 2 billion) and short enough to type without mistyping.\n		Length = 6,\n\n		-- What characters are allowed. Uppercase digits and letters only -- no\n		-- I, O, or l which look like 1 and 0 on small screens.\n		Charset = \"0123456789ABCDEFGHJKMNPQRSTUVWXYZ\",\n\n		-- How long a code lives after it is generated. Five minutes is enough to\n		-- type it into a second device and press Enter, and short enough that a\n		-- leaked code expires before it is worth anything.\n		TTLSeconds = 300,\n\n		-- How many active codes a single player may hold at once. One is the\n		-- sensible default -- a code is a one-time shortcut, not a persistent\n		-- share link -- and keeping it low means the server table stays small.\n		MaxPerPlayer = 1,\n	},\n}\n\n-- Spins: Robux buys a pull at a perk, disclosed odds and all. The one deliberate exception\n-- to the no-gambling rule in the content guidelines -- see `ages_lobby_spec.md` -- and the\n-- reason the exception is survivable is that a perk never gates content and, per the spec,\n-- rarer is never stronger: every pull is a flavour of ordinary start, not a chance at power.\nConfig.Spins = {\n	-- The odds, by rarity tier. Whole numbers out of their own sum rather than fractions of\n	-- one, so `RarityWeights.common / total` reads as a percentage without anyone doing the\n	-- division in their head first -- and so a designer can compare two tiers by eye.\n	--\n	-- Roblox requires the *per-item* probability be shown before a paid random purchase, not\n	-- just the tier's. `content/Perks.luau` divides a tier's weight by how many perks are in\n	-- it to get there -- see `Perks.Odds` -- so this table is the one place the tier-level\n	-- number is decided and every perk in a tier is owed an equal share of it.\n	-- Safe range: any positive integers. Must total something a human reads easily -- 100 is\n	-- not required, but it is why these four were picked.\n	RarityWeights = {\n		common = 55,\n		uncommon = 28,\n		rare = 13,\n		legendary = 4,\n	},\n\n	-- What Robux buys. Each entry is a developer product -- created once in the Creator\n	-- Dashboard, then its id pasted in here, the same refuse-by-name pattern as\n	-- `Config.Lobby.GamePlaceId`: a `ProductId` of 0 means \"not published yet\", and\n	-- `SpinsService` refuses that product by name rather than failing inside a Robux call.\n	--\n	-- `Spins` is what one purchase grants, and `RobuxPrice` is display-only -- the real price\n	-- is whatever was set on the product in the Dashboard, and this number exists only so the\n	-- buy page can show a price before it asks Roblox to open the purchase prompt. If the two\n	-- ever drift, the Dashboard is correct and this needs updating to match it.\n	Products = {\n		{\n			id = \"spins_1\",\n			name = \"1 Spin\",\n			spins = 1,\n			robuxPrice = 25,\n			productId = 0,\n		},\n		{\n			id = \"spins_5\",\n			name = \"5 Spins\",\n			spins = 5,\n			robuxPrice = 100,\n			productId = 0,\n		},\n		{\n			id = \"spins_12\",\n			name = \"12 Spins\",\n			spins = 12,\n			robuxPrice = 200,\n			productId = 0,\n		},\n	},\n}\n\nConfig.Setup = {\n	-- Points to spend across the four stats, on top of the starting values.\n	--\n	-- The mechanic, not a bonus. Points can be taken *out* of a stat as well as put in\n	-- (see MinPerStat), so the real question is not \"where do my eight points go\" but\n	-- \"what am I willing to be bad at\" -- and a menu that only ever gave things away\n	-- would be a reward screen with no decision in it.\n	--\n	-- Eight against starting values of 100/70/50/50 is deliberately modest: enough that\n	-- a choice is visible in the first years, far too little to buy a life. Two decades\n	-- of school move smarts further than this does.\n	-- Safe range: 0-25. At 0 the section is dead weight and should be removed rather\n	-- than zeroed; above ~25 the menu decides more about a life than the life does.\n	StatPoints = 8,\n\n	-- How far one stat can be pushed either way.\n	--\n	-- The floor is what makes the pool a trade rather than a wallet: -4 on looks buys\n	-- four more points for smarts, and the player has decided to be a plain clever child\n	-- instead of an average one. Capped well short of the pool in both directions so that\n	-- no single stat can absorb everything -- a menu whose optimal play is \"all eight into\n	-- smarts, every life\" is a menu with one answer.\n	--\n	-- Health is exempt in practice rather than by rule: it starts at 100 and StatService\n	-- clamps to Config.Stats.Max, so buying it up does nothing and the menu says so.\n	-- Safe range: 1 to StatPoints for the max, and -(StatPoints) to 0 for the min.\n	MaxPerStat = 6,\n	MinPerStat = -4,\n\n	-- The longest a typed first or last name may be.\n	--\n	-- Short on purpose. This name goes on a nameplate, a death screen and a debug row,\n	-- and none of those has room for a paragraph -- a limit the player meets while typing\n	-- is far kinder than a name that silently renders off the edge of a panel later.\n	-- Safe range: 8-24.\n	MaxNameLength = 16,\n\n	-- Eras. One real, three signposts.\n	--\n	-- The locked ones are here as *entries* rather than as a label reading \"more coming\",\n	-- because a row the player can read and press -- and be told, by name, that it is not\n	-- ready yet -- is a promise this game has made and can be held to. It is also the only\n	-- honest way to answer \"what else is there\": pointing at the actual list.\n	--\n	-- Adding one is meant to be this small: flip `available` once the content behind it\n	-- exists. Nothing else reads the id yet, which is exactly why the setup validator\n	-- refuses an unavailable era rather than trusting the menu to have greyed it out.\n	Eras = {\n		{\n			id = \"modern\",\n			name = \"Modern Day\",\n			blurb = \"The world as it is. Phones, jobs, school, rent.\",\n			available = true,\n		},\n		{\n			id = \"eighties\",\n			name = \"The Eighties\",\n			blurb = \"No internet. One phone, in the hall, and everyone can hear you.\",\n			available = false,\n		},\n		{\n			id = \"victorian\",\n			name = \"1880s\",\n			blurb = \"Work starts at twelve and medicine is mostly guessing.\",\n			available = false,\n		},\n		{\n			id = \"future\",\n			name = \"Near Future\",\n			blurb = \"The jobs are different. So is how long you get.\",\n			available = false,\n		},\n	},\n}\n\n-- ---------------------------------------------------------------------------\n-- Fighting.\n--\n-- A fight in AGES is a contest for *footing*, not for health. You do not injure\n-- anybody; you take them off their feet, they go down, and they get back up. That\n-- is not a content filter bolted on top of a damage system -- it is the damage\n-- system, and it is what keeps a brawl inside 13+ without anybody having to\n-- remember a rule. There is no blood, no injury state and no death animation here\n-- because there is nothing in the mechanic for one to describe.\n--\n-- The verb is charge-and-release, the same primitive the sports work settled on, so\n-- the game keeps one input language: hold to wind up, let go to commit. Around it sit\n-- two answers -- guard and sidestep -- and the three of them make a triangle rather\n-- than a ladder. Guard turns a strike into stamina loss; a *fully charged* strike\n-- breaks a guard; a sidestep beats anything already committed. Which means holding\n-- the charge longer is not simply better, and that is the whole game: the wind-up\n-- that breaks a guard is the wind-up somebody can step around.\n--\n-- Stamina is what stops all three being free, and it is the pacing mechanism as\n-- well. It recovers slowly while you are in range and quickly while you are not, so\n-- a fight paces itself into exchange, break, exchange without a timer anywhere in\n-- this table telling it to.\n-- ---------------------------------------------------------------------------\nConfig.Fight = {\n	-- Server tick. Matches the gym's rate: fast enough that a released charge lands on\n	-- the value the player saw, slow enough that a busy street is not paying for it.\n	-- Safe range: 0.05 .. 0.15.\n	TickSeconds = 0.1,\n\n	-- How much footing everybody starts a fight with before health is counted.\n	-- Safe range: 40 .. 80.\n	BaseFooting = 60,\n\n	-- What a full health bar adds to that, as a share of BaseFooting. This is the only\n	-- progression in the system and it is deliberately inside the mechanic rather than\n	-- beside it: a player who has been to the gym watches their own footing bar draw\n	-- longer, which is what GymService already does with its sweet zone and what the\n	-- activity law asks for in place of a number on a menu.\n	-- Safe range: 0.3 .. 1.0.\n	HealthFootingBonus = 0.6,\n\n	-- The shared pool every action spends from.\n	-- Safe range: 80 .. 140.\n	MaxStamina = 100,\n	-- Recovery while still in range of the opponent, per second. Low on purpose --\n	-- standing toe to toe should not refill you.\n	-- Safe range: 4 .. 14.\n	StaminaPerSecondEngaged = 9,\n	-- Recovery once you have broken off. The gap between these two is what makes\n	-- backing out of range a decision rather than a retreat, and it is where the verse\n	-- and chorus of a fight comes from.\n	-- Safe range: 15 .. 30.\n	StaminaPerSecondClear = 22,\n\n	-- Charge-and-release. Seconds to wind a strike from nothing to full.\n	-- Safe range: 0.7 .. 1.2.\n	ChargeSeconds = 0.9,\n	-- Below this share of a full charge a release is a jab: cheap, fast, and it will\n	-- not break anybody's guard. There is no dead zone where a release does nothing,\n	-- because an input that silently does nothing is the one thing a player cannot\n	-- learn from.\n	-- Safe range: 0.15 .. 0.35.\n	JabShare = 0.25,\n	-- Past this share the wind-up is an overcharge: it hits harder than a full charge\n	-- but leaves you in recovery for much longer, so the biggest punch in the game is\n	-- also the most punishable. Free risk/reward for one number, the same shape as the\n	-- golf-meter overswing.\n	-- Safe range: 0.8 .. 0.95.\n	OverchargeShare = 0.85,\n	-- What a strike costs, and what it takes off an opponent at minimum and maximum\n	-- charge. The floor is not zero: a jab that did nothing would make the fast option\n	-- a trap rather than a choice.\n	-- Safe range: StrikeStamina 10 .. 20, footing 4 .. 10 and 16 .. 26.\n	StrikeStamina = 14,\n	StrikeFootingMin = 6,\n	StrikeFootingMax = 20,\n	-- Extra footing an overcharged strike takes, as a multiplier on the maximum.\n	-- Safe range: 1.2 .. 1.8.\n	OverchargeFootingScale = 1.4,\n\n	-- Recovery: seconds of lockout after committing, during which nothing is available.\n	-- These three are the entire punish economy and they are ordered on purpose -- a\n	-- clean strike costs least, an overcharge more, and a strike that hit nothing at\n	-- all costs most.\n	-- Safe range: 0.3 .. 0.6, 0.7 .. 1.1, 0.9 .. 1.4.\n	StrikeRecoverSeconds = 0.45,\n	OverchargeRecoverSeconds = 0.9,\n	WhiffRecoverSeconds = 1.1,\n\n	-- Guard. Holding costs stamina per second, so a permanent block is not a strategy.\n	-- Safe range: 8 .. 18.\n	GuardStaminaPerSecond = 12,\n	-- What still gets through a successful block, as shares of the incoming strike.\n	-- Some footing leaks -- a block should be the better outcome, never a free one --\n	-- and the rest arrives as stamina cost, which is what eventually opens a turtling\n	-- player up without needing a rule that says \"you may not block\".\n	-- Safe range: footing 0.1 .. 0.25, stamina 0.6 .. 1.0.\n	GuardedFootingShare = 0.15,\n	GuardedStaminaShare = 0.8,\n	-- The charge at which a strike breaks a guard outright. Sent to the client so the\n	-- power meter can draw the line: the player has to see the threshold they are\n	-- holding for, or the overcharge decision is being made blind.\n	--\n	-- **This must stay above OverchargeShare, and FightService refuses to load if it is\n	-- not.** The two numbers together are the whole question the boxer asks. Below\n	-- overcharge, a guard could be broken by a strike that never entered the punishing\n	-- zone -- so breaking a guard would cost nothing at all, the safest play against a\n	-- fifty-percent guard would be to hold exactly this much every single time, and an\n	-- opponent built entirely around risk would have no risk left in him. Above it, there\n	-- is no way through a guard that does not also accept the near-second of recovery,\n	-- which is what makes squaring up to a boxer a bet rather than a routine.\n	-- Safe range: 0.88 .. 0.95, and always greater than OverchargeShare.\n	GuardBreakShare = 0.92,\n	-- What breaking a guard is worth, as a multiplier on the strike's footing.\n	-- Safe range: 1.3 .. 2.0.\n	GuardBreakFootingScale = 1.5,\n	-- Lockout on the guard that was broken. The reward for the read.\n	-- Safe range: 0.5 .. 1.0.\n	GuardBreakRecoverSeconds = 0.7,\n\n	-- Sidestep. Expensive, brief and total: inside the window nothing lands. It has to\n	-- be expensive, because a cheap dodge answers every question in the triangle.\n	-- Safe range: stamina 18 .. 30, window 0.25 .. 0.45.\n	SidestepStamina = 22,\n	SidestepSeconds = 0.35,\n	SidestepRecoverSeconds = 0.3,\n\n	-- Inside this many studs you can hit and be hit.\n	-- Safe range: 9 .. 16.\n	RangeStuds = 12,\n	-- Get this far away and the fight is over -- you walked out of it. Generous, so\n	-- that backing off to recover stamina cannot end a fight by accident.\n	-- Safe range: 40 .. 80.\n	BreakStuds = 55,\n\n	-- How long somebody stays down before getting back up. The fight is already over\n	-- when this starts; it is a beat for the result to land, not a punishment, and it\n	-- is short because the 13+ line is specifically about not dwelling here.\n	-- Safe range: 2 .. 4.\n	DownSeconds = 3,\n\n	-- How long the result stays on screen after they are back up.\n	-- Safe range: 2 .. 5.\n	OverSeconds = 3,\n\n	-- How far in front of the player a challenger squares up.\n	-- Safe range: 6 .. 10.\n	SquareUpStuds = 8,\n\n	-- Walk speed an opponent closes at. Slower than a running player on purpose:\n	-- breaking off has to be possible, or the stamina economy has no exit.\n	-- Safe range: 10 .. 18.\n	FoeWalkSpeed = 14,\n\n	-- How long a beat line (\"Blocked\", \"Broke guard\") stays on the client.\n	-- Safe range: 0.5 .. 1.5.\n	BeatSeconds = 0.9,\n\n	-- What losing costs, and what winning is worth.\n	--\n	-- Small on purpose, and health rather than money: a fight you lose should cost you\n	-- the thing that makes the next fight harder, not the thing that makes the next\n	-- hour harder. Because footing scales off health, a beating shortens your own bar\n	-- the next time somebody squares up -- the loop closes on itself without a single\n	-- number outside the mechanic, and a player on a losing streak feels it in the bar\n	-- they are watching rather than in a wallet they are not.\n	--\n	-- The win pays happiness because nothing else honestly fits. Winning a street fight\n	-- does not make you fitter or better looking, and paying it in money would make the\n	-- town's toughs an income stream -- which is the \"idle payout pad\" the activity law\n	-- names as the thing to avoid, just with a punch on the front of it.\n	-- Safe range: 4 .. 12, 2 .. 8.\n	LossHealth = 8,\n	WinHappiness = 4,\n\n	-- Notoriety: how known this life is for fighting, tracked in LifeData.notoriety.\n	-- Ratchet-only, the same rule gang standing and crew nerve already use -- a loss\n	-- never takes it back. Paid on every win, street tough or rival, so it is a\n	-- straight count of fights won rather than a currency with an exchange rate.\n	-- Safe range: 1 .. 3.\n	NotorietyPerWin = 1,\n\n	-- Getting caught. A fight is legal -- nobody is arrested for winning one -- but a\n	-- brawl loud enough for a stranger to watch the whole way through is still a\n	-- disturbance, and that is worth a small amount of heat, not a bounty tier. This\n	-- is deliberately a single roll at the bout's end rather than WitnessService's\n	-- continuous fill: a fight is over in twenty seconds, too short for a look-then-fill\n	-- gesture to read as anything but instant, so it is asked once rather than every tick.\n	--\n	-- Safe range: 10 .. 20.\n	WitnessSeeStuds = 14,\n	-- Chance any one bystander within range caught the whole thing, rolled once per\n	-- bystander at bout resolution. Several people nearby means several rolls, not\n	-- a bigger single one -- a crowd is more likely to have caught it, not more\n	-- damning when it does.\n	-- Safe range: 0.15 .. 0.4.\n	WitnessCatchChance = 0.25,\n	-- What being caught costs, in heat, same scale as Config.Crime. Well under\n	-- Config.Crime.Theft.HeatOnSpotted (18): the police are interested that a fight\n	-- happened, not that a crime did.\n	-- Safe range: 4 .. 10.\n	WitnessHeat = 6,\n\n	-- Rival gang fights. Standing paid to your own gang on a win is deliberately close\n	-- to Config.Gangs.Earn.VaultOpened (45) -- beating one of their own is worth about\n	-- what a job is -- and the charge against the rival gang mirrors\n	-- Config.Territory.Incursion.RivalCost, because losing an enforcer on their own\n	-- ground is the same kind of loss as being caught running their line. A loss costs\n	-- neither side any standing: only LossHealth, the same as any other fight.\n	-- Safe range: standing 30 .. 60, charge 15 .. 35.\n	RivalWinStanding = 45,\n	RivalWinChargeRival = 25,\n}\n\n-- Milestones. One-time bonuses for hitting life landmarks, fired once per life\n-- so the player gets the celebration exactly once. Each entry names the trigger,\n-- the label the client shows, and the money bonus attached.\nConfig.Milestones = {\n	FirstJob = { label = \"First Job\", bonus = 500 },\n	FirstHouse = { label = \"Homeowner\", bonus = 1000 },\n	TenShifts = { label = \"Steady Worker\", bonus = 300 },\n	FiftyShifts = { label = \"Dedicated\", bonus = 1000 },\n	MaxStanding = { label = \"Top Performer\", bonus = 2000 },\n	Age30 = { label = \"Thirty\", bonus = 1000 },\n	Age50 = { label = \"Fifty\", bonus = 2000 },\n	Age80 = { label = \"Long Life\", bonus = 5000 },\n}\n\n-- Skills. What the player has got good at, one line per discipline, earned by doing\n-- the thing and graded on how well it went.\n--\n-- The rule that shapes every number below: **XP is only ever awarded for a graded\n-- outcome, never for elapsed time and never for arriving somewhere.** A skill that\n-- ticks up while a player stands in a gym is not a skill, it is a clock with a label\n-- on it, and this game already has one of those it is trying to get rid of. Every\n-- Award call in the tree is downstream of something the server judged: a sweep hit\n-- landing in the sweet band, a lesson answer being right, a bout being won, a canvas\n-- being signed. If a hook cannot name the thing that was judged, it is not a hook.\n--\n-- Per life, like money and the job. A skill that survived death would make dying a\n-- setback rather than an ending, which is the one thing this game will not do.\nConfig.Skills = {\n	-- The ladder, shared by every skill so that \"level 4\" means the same amount of\n	-- work everywhere. Thresholds are cumulative XP, and the last band is the cap --\n	-- a skill that ran off the end of this table would have no name to show.\n	--\n	-- Superlinear, but only gently: each band costs roughly a third more than the one\n	-- before rather than double. Doubling is the usual choice and it is wrong here,\n	-- because the top of a doubling ladder is unreachable inside one life and a rung\n	-- nobody can stand on is decoration. These add up to 4,700 XP, which a player who\n	-- actually plays one discipline can finish.\n	Levels = {\n		{ level = 1, atXp = 0, name = \"Beginner\" },\n		{ level = 2, atXp = 120, name = \"Novice\" },\n		{ level = 3, atXp = 320, name = \"Capable\" },\n		{ level = 4, atXp = 640, name = \"Skilled\" },\n		{ level = 5, atXp = 1100, name = \"Practiced\" },\n		{ level = 6, atXp = 1750, name = \"Sharp\" },\n		{ level = 7, atXp = 2600, name = \"Expert\" },\n		{ level = 8, atXp = 4700, name = \"Master\" },\n	},\n\n	-- The disciplines, in the order the menu lists them. `id` is what services award\n	-- against and what the save is keyed by, so renaming one silently zeroes every\n	-- player's progress in it -- add a new id rather than editing an old one.\n	--\n	-- Deliberately short. Six lines a player can name beats fifteen they cannot, and\n	-- every entry here has at least one service already grading something that feeds\n	-- it. A skill with no source is a row that never moves, and a row that never moves\n	-- teaches the player to stop reading the panel.\n	Definitions = {\n		{\n			id = \"fighting\",\n			label = \"Fighting\",\n			-- What it is earned by, shown under the bar. Written as the player's own\n			-- action rather than as a system name: \"Won squares in a fight\" is\n			-- something they remember doing, \"FightService outcomes\" is not.\n			earnedBy = \"Winning squares and taking bouts\",\n			color = Color3.fromRGB(232, 92, 76),\n		},\n		{\n			id = \"athletics\",\n			label = \"Athletics\",\n			earnedBy = \"Timing sweeps on the gym machines\",\n			color = Color3.fromRGB(96, 200, 255),\n		},\n		{\n			id = \"academics\",\n			label = \"Academics\",\n			earnedBy = \"Answering lessons correctly\",\n			color = Color3.fromRGB(150, 140, 255),\n		},\n		{\n			id = \"science\",\n			label = \"Science\",\n			earnedBy = \"Committing a lab run that holds up\",\n			color = Color3.fromRGB(94, 226, 178),\n		},\n		{\n			id = \"art\",\n			label = \"Art\",\n			earnedBy = \"Signing a canvas you finished\",\n			color = Color3.fromRGB(255, 176, 74),\n		},\n		{\n			id = \"nerve\",\n			label = \"Nerve\",\n			earnedBy = \"Getting away with it\",\n			color = Color3.fromRGB(236, 120, 200),\n		},\n	},\n\n	-- The most XP one call may award, whatever it asks for. A guard on the callers\n	-- rather than a tuning knob: every hook in the tree passes a small constant today,\n	-- and this exists so that a future one multiplying by a streak, a combo count or a\n	-- payout cannot quietly turn a single action into a level.\n	-- Safe range: 20-100.\n	MaxPerAward = 60,\n\n	-- What each judged outcome is worth. Every name here corresponds to exactly one\n	-- call site, and the call site is named in the comment, so a number that looks\n	-- wrong can be traced to the thing it pays for without a search.\n	--\n	-- Sized against the ladder above: a Master at 4,700 XP is roughly 800 perfect gym\n	-- reps, 940 right answers, or 235 bouts taken. Those are large and they are meant\n	-- to be -- Master is one life's worth of one discipline, not an afternoon's.\n	Awards = {\n		-- GymService.answer, per rep, on the grade the sweep was judged at. A miss pays\n		-- nothing at all rather than a consolation trickle: the sweep is the only thing\n		-- the gym asks the player to get right, and paying for a miss would make the\n		-- timing decorative.\n		-- Safe range: 2-12.\n		GymPerfect = 6,\n		-- Safe range: 1-6.\n		GymGood = 3,\n\n		-- SchoolService.answer, per right answer. Time running out is a wrong answer\n		-- here, exactly as it is for the lesson's own grade.\n		-- Safe range: 2-10.\n		LessonCorrect = 5,\n\n		-- FightService.decide, on a bout the player took. Nothing for a loss, and that\n		-- is not a judgement about whether losing teaches you something -- it is that a\n		-- loss is the one fight outcome a player can produce on demand by standing\n		-- still and being hit, which is the exact shape this whole table exists to\n		-- refuse.\n		-- Safe range: 10-40.\n		FightWon = 25,\n\n		-- ScienceService, per procedure step matched in order on a committed bench.\n		-- Multiplied by the match count at the call site, which is the one place in the\n		-- tree where MaxPerAward is doing real work rather than sitting as a guard.\n		-- Safe range: 2-8.\n		LabStepMatched = 4,\n\n		-- ArtService.finish, multiplied by the share of the study actually reproduced,\n		-- so a canvas walked away from at a tenth done pays a tenth. Awarded however\n		-- the session ended, for the reason the lesson count is: leaving early is a way\n		-- of doing it badly, not a way of avoiding being graded.\n		-- Safe range: 15-50.\n		ArtCanvas = 30,\n\n		-- GangService.checkEscape, when a bounty that got above\n		-- Config.Gangs.Earn.GotAwayNeedsBounty falls to nothing without an arrest.\n		--\n		-- Deliberately paid to everybody, gang or not, unlike the standing award beside\n		-- it. Nerve is about what you got away with; needing a gang to be credited for\n		-- it would make the only unbanked discipline in the game a members-only one.\n		-- Safe range: 15-45.\n		GotAway = 30,\n\n		-- BullyService.resolve, on a stare-down the player faced down. Nothing at all for\n		-- backing off or overholding, for the reason FightWon pays nothing for a loss: both\n		-- are outcomes a player can produce on demand by doing nothing, and paying for them\n		-- would make the release decorative.\n		--\n		-- Feeds the same nerve discipline GotAway does rather than a school one of its own,\n		-- and that is the point of it. Nerve is what you did not flinch at; whether the thing\n		-- you did not flinch at was a police cordon or somebody in a corridor is a difference\n		-- the skill has no reason to care about, and a second nerve ladder would be the game\n		-- disagreeing with itself about what the word means. It is also the cross-system\n		-- upgrade the activity law asks for: an afternoon at school moves a discipline the\n		-- crime stack reads.\n		-- Safe range: 8-25.\n		StoodUp = 14,\n\n		-- ReadingService.finish, multiplied by the words actually handed in, so a board walked\n		-- away from at two words pays for two. Awarded however the lesson ended, for the\n		-- reason ArtCanvas is: leaving early is a way of doing it badly, not a way of avoiding\n		-- being graded.\n		--\n		-- Per word rather than per lesson, and small, because six of them land at once at the\n		-- end of a good afternoon and the ceiling above is what stops that being a level.\n		-- Safe range: 3-10.\n		WordBuilt = 6,\n\n		-- MusicService.finish, multiplied by the share of the piece actually kept, so a chart\n		-- walked out on halfway pays half. Awarded however the lesson ended, like ArtCanvas\n		-- and WordBuilt: leaving early is a way of doing it badly, not a way of dodging a\n		-- grade.\n		--\n		-- Into academics rather than a discipline of its own. A music lesson at school is\n		-- school, and inventing a sixth skill for one call site would put a row in the skills\n		-- panel that only ever moves on Tuesdays.\n		-- Safe range: 15-40.\n		-- One PE drill, cleared. Paid into athletics rather than academics, which is the\n		-- whole point of the subject -- see content/Curriculum.luau.\n		DrillCleared = 26,\n		MusicPiece = 26,\n	},\n}\n\n-- NPC gossip. When two townsfolk are near each other and the player has done\n-- something notable, one may share a line about the player with the other.\n-- The gossip fades over time and nudges bonds among nearby people.\nConfig.Gossip = {\n	-- How many game hours gossip stays active before fading.\n	-- Safe range: 24-96.\n	FadeHours = 48,\n	-- How often the gossip system checks for new opportunities.\n	-- Safe range: 30-120 seconds.\n	TickSeconds = 60,\n}\n\n-- Preferences. Every one of these is a switch that changes something the player can point\n-- at, and that is the entry bar rather than a style note: a settings screen collects\n-- switches by gravity, and the first one that toggles nothing teaches the player that none\n-- of them do.\n--\n-- The list is content and the *effects* are not. Each id below is matched by an explicit\n-- arm in the client, which errors by name on an id it does not know -- so adding a row\n-- here without wiring it is a crash on the first push rather than a dead switch shipping.\n--\n-- All of them default to the game as it plays today. Nobody is opted into a change by an\n-- update, and a player who never opens this pane never notices it exists.\nConfig.Settings = {\n	Options = {\n		{\n			id = \"ageUpConfirm\",\n			label = \"Confirm before ageing up\",\n			-- Two captions, one per state, in the player's words. See `SettingState` for why\n			-- a caption beats an \"On\"/\"Off\" figure.\n			captionOn = \"Pressing Age Up asks first. A year is never spent by a misclick.\",\n			captionOff = \"Pressing Age Up spends the year immediately.\",\n			-- Off, and it is the one row here where that is a close call. Ageing up is\n			-- irreversible and the button sits under the cursor for the whole life -- but a\n			-- confirm on the single most-pressed control in the game is a second click every\n			-- year for a player who never misclicks, and the ones who want it will find it\n			-- here the first time it costs them.\n			default = false,\n		},\n		{\n			id = \"minimap\",\n			label = \"Minimap\",\n			captionOn = \"The dial in the corner is showing.\",\n			captionOff = \"Hidden. The full map still opens on M.\",\n			default = true,\n		},\n		{\n			id = \"moneyPops\",\n			label = \"Money popups\",\n			captionOn = \"Every payment and charge floats up where it happened.\",\n			captionOff = \"Money changes silently. The balance is still on the HUD.\",\n			default = true,\n		},\n		{\n			id = \"celebrations\",\n			label = \"Celebrations\",\n			captionOn = \"Milestones and new friendships take the screen for a moment.\",\n			captionOff = \"They pass as a line of text instead.\",\n			default = true,\n		},\n	},\n}\n\n-- Codes. The redeem box, not the codes themselves -- those are content and live in\n-- `src/server/content/Codes.luau`, because a code is a thing somebody writes, dates and\n-- retires, and Config is for numbers that tune behaviour.\nConfig.Codes = {\n	-- The longest string the box will look at. A guard rather than a limit on what a code\n	-- may be called: the field is free text arriving from a client, and every free-text\n	-- field in this tree has a length it stops reading at.\n	-- Safe range: 16-64.\n	MaxLength = 32,\n	-- How long a player must wait between attempts.\n	--\n	-- The only reason this exists is that a code box is a guessing surface -- it is the one\n	-- input in the game where a client that fires it a thousand times a second is trying to\n	-- win rather than misbehaving. A second is invisible to somebody typing and ruinous to\n	-- somebody enumerating.\n	-- Safe range: 0.5-5.\n	AttemptCooldownSeconds = 1,\n	-- The most codes one account may hold. Not a balance lever -- the reward per code is\n	-- the balance lever -- but a bound on the size of a field that is written to the save\n	-- and never pruned.\n	-- Safe range: 50-500.\n	MaxRedeemed = 200,\n}\n\nreturn Config\n"
table.insert(AGES_MANIFEST, "src/shared/Config.luau")
AGES_SOURCES["src/shared/Delivery.luau"] = "--!strict\n-- What each delivery mode *is*, structurally. Config owns the tunable numbers;\n-- this owns the fixed facts that three separate systems would otherwise each\n-- keep a copy of and eventually disagree about.\n--\n-- Route is the important one. An event reaches the player exactly one way, and\n-- the routes are disjoint by construction:\n--\n--   Immediate  handed over the moment it is picked, by a birthday. No world\n--              presence at all -- the panel is the whole delivery.\n--   Ambient    staged into the world by the scheduler and collected by going to\n--              it. The object is spawned per event and belongs to one player.\n--   Wandered   put on whatever floor the player can reach and pointed at, then\n--              collected by going to it. Ambient's sibling, and the difference is\n--              the whole point: Ambient needs a tagged point to arrive at, so an\n--              untagged room is a room where nothing happens. Wandered finds its\n--              own spot, which is what lets a childhood be playable in a house\n--              nobody has dressed yet. Never scheduled -- it is a loop rather than\n--              a timer, and there is one out there whenever there could be.\n--   Anchored   reached by walking to hand-placed geometry that is always there.\n--              Never scheduled; the player finds it or they don't.\n--   Shift      fired by being at work while working. Not scheduled and not\n--              staged: the condition is an activity rather than a place or a\n--              date, which is why it is its own route rather than a filter over\n--              one of the others. Its own route is also what guarantees a\n--              birthday can never hand you \"a customer is shouting at you\" in\n--              your own kitchen -- the birthday pool asks for Immediate and\n--              these are not in it.\n--\n-- Keeping this here is what stops a birthday from handing out a letter (which\n-- would announce mail the player never picked up) or the scheduler from staging\n-- a Memory (which has nowhere to be staged). ROUTES is a closed record rather\n-- than a loose map on purpose: add a variant to Types.EventDelivery and this\n-- file stops type-checking until the new mode has been told which route it\n-- takes. The alternative is a mode that silently never fires and is never\n-- missed.\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal Types = require(ReplicatedStorage:WaitForChild(\"Types\"))\n\ntype EventDelivery = Types.EventDelivery\n\nlocal Delivery = {}\n\nexport type Route = \"Immediate\" | \"Ambient\" | \"Wandered\" | \"Anchored\" | \"Shift\"\n\nlocal ROUTES: {\n	Memory: Route,\n	Direct: Route,\n	Wander: Route,\n	Interact: Route,\n	Letter: Route,\n	PhoneCall: Route,\n	NPCApproach: Route,\n	Shift: Route,\n} = {\n	Memory = \"Immediate\",\n	Direct = \"Immediate\",\n	Wander = \"Wandered\",\n	Interact = \"Anchored\",\n	Letter = \"Ambient\",\n	PhoneCall = \"Ambient\",\n	NPCApproach = \"Ambient\",\n	Shift = \"Shift\",\n}\n\nfunction Delivery.RouteOf(delivery: EventDelivery): Route\n	return ROUTES[delivery]\nend\n\nreturn Delivery\n"
table.insert(AGES_MANIFEST, "src/shared/Delivery.luau")
AGES_SOURCES["src/shared/Lives.luau"] = "--!strict\n-- What a life *is*, independent of who is playing it: how to make a fresh one, how to\n-- repair a stored one, and how to find the one currently being played.\n--\n-- Replaces the old one-function `Life.luau`, which existed only to hold `HasBegun` where\n-- `EventService` could reach it without closing a require cycle. That constraint still\n-- applies -- this module requires Config and Types and nothing else, deliberately, so that\n-- every service and both places can require it freely -- but there is now enough here to\n-- justify the file on its own.\n--\n-- Shared rather than server-side because the lobby place needs all of it too: the lobby is\n-- where lives are created, deleted and chosen, and it must build a slot the game place will\n-- accept without a second definition of what a slot looks like.\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Config = require(ReplicatedStorage:WaitForChild(\"Config\"))\nlocal Types = require(ReplicatedStorage:WaitForChild(\"Types\"))\n\ntype LifeData = Types.LifeData\ntype ProfileData = Types.ProfileData\n\nlocal Lives = {}\n\n-- A brand new, unlived life.\n--\n-- A function rather than a constant table, and that is not a style preference. Three slots\n-- built from one shared constant would share the *same* `stats`, `bonds` and `flags`\n-- tables by reference, so a stat moved in slot 1 would move in slots 2 and 3 as well --\n-- silently, and only for players who had more than one life going. Every call builds fresh\n-- tables all the way down.\nfunction Lives.New(): LifeData\n	return {\n		ageMonths = 0,\n		stage = \"Childhood\",\n		alive = true,\n		stats = {\n			health = Config.Stats.Starting.health,\n			happiness = Config.Stats.Starting.happiness,\n			smarts = Config.Stats.Starting.smarts,\n			looks = Config.Stats.Starting.looks,\n		},\n		-- Read straight from Config rather than through MoneyService.StartingBalance,\n		-- which everything else uses. This is also the template a *stored* life is repaired\n		-- against, not only the start of one: it exists so that a save written before money\n		-- did gets the field added, and there is no player to ask about at the moment it is\n		-- filled in. Every actual life start goes through the service.\n		money = Config.Money.StartingBalance,\n		-- Both right for the newborn this describes, and both also right as the value a\n		-- *stored* life is repaired to: a save that predates pocket money gains an empty\n		-- ledger and a paid-through age of zero. Zero would back-pay a whole childhood at\n		-- that life's next birthday, so PocketMoneyService moves it up to the age the life\n		-- has actually reached before anything can read it.\n		pocketMoneyOwed = 0,\n		pocketMoneyPaidThroughAge = 0,\n		secondsSinceAgeUp = 0,\n		-- pendingEventId, deliveringEventId, jobId, gender and setup are all intentionally\n		-- absent, and the absence is the meaning in every case: nothing outstanding, nothing\n		-- staged in the world, holds no job, nobody decided yet, no life running. Because\n		-- `Lives.Reconcile` fills a stored life from exactly this table, a field that is not\n		-- here is a field it can never wrongly invent -- which is the entire reason the\n		-- absent-means-something idiom is safe to rely on.\n		seenEventIds = {},\n		-- Empty is the correct state for a save written before flags existed too: an old\n		-- life has done nothing the game can prove, which is exactly what filling this in\n		-- says.\n		flags = {},\n		-- Starts at the top of the window rather than 0, so the first ambient delivery of a\n		-- life is a wait and not an ambush the moment the player is old enough for one. The\n		-- countdown only runs while they are that old, so this is not silently spent during\n		-- childhood.\n		deliveryCountdown = Config.Ambient.MaxSecondsBetween,\n		deliveriesThisYear = 0,\n		workGameHoursThisYear = 0,\n		-- Empty, which reads the same as \"no job has an opinion of you yet\" -- true of the\n		-- newborn this describes, and the right thing to hand a save written before records\n		-- existed: that life's career starts being judged from now.\n		jobStanding = {},\n		-- Empty, which reads the same as \"no job has let you go this year\" -- true of the\n		-- newborn, and the right thing to hand an old save: nobody arrives already sacked.\n		firedFrom = {},\n		-- Empty, which reads the same as \"no machine has been worked out on this year\" --\n		-- true of the newborn, and the right thing to hand a save written before the gym\n		-- existed: that life has not worked out this year, which is exactly true.\n		workoutsThisYear = {},\n		-- Right for the newborn this describes, and right for a save written before school\n		-- existed: that life has sat no lessons this year, which is exactly true -- there was\n		-- nothing to sit.\n		lessonsThisYear = 0,\n		-- Empty, which reads as level one in every discipline -- true of the newborn, and the\n		-- only honest thing to hand a save written before skills existed. That life did throw\n		-- punches and sit lessons, but nothing was grading them at the time, so back-filling\n		-- XP here would be the game awarding credit for work it never watched.\n		skillXp = {},\n		-- Empty, which reads as level one in every subject with no passes banked -- true of\n		-- the newborn, and true of a save written before subjects had verbs. An old life\n		-- arrives at the lab as a beginner, which is what it is: it has never run a\n		-- procedure, because until now there were none to run.\n		subjectMastery = {},\n		subjectPasses = {},\n		-- Zero nerve, no corridors won, and nobody holding your homework -- true of the\n		-- newborn, and the only honest thing to hand a save written before the corridor\n		-- existed. That life was never stood in front of, so it has learned nothing about\n		-- it, and starting it part-way up would be the game crediting a fight it never saw.\n		bullyNerve = 0,\n		bullyStandUps = 0,\n		homeworkTaken = false,\n		-- Empty, which reads as \"no lessons yet this year\" and \"no year finished yet\" --\n		-- true of the newborn, and the right thing to hand a save written before the record\n		-- existed. That life's school years genuinely have no verdict: they were lived by a\n		-- build that was not keeping one, and inventing grades for them here would be the\n		-- game making up a childhood it did not watch.\n		--\n		-- `pendingReport` is intentionally absent, and the absence is the meaning: nothing\n		-- staged, nothing to collect at the school.\n		schoolYear = {},\n		schoolGrades = {},\n		-- Empty for a newborn, who has met nobody yet, and empty is also the honest thing to\n		-- hand a save written before people existed. An absent key is \"not met\", and the\n		-- authored starting bond is written the first time anything moves -- so a stored life's\n		-- mother starts where every mother starts rather than at nothing, which would have the\n		-- game open by telling them their family are strangers.\n		bonds = {},\n		-- Likewise empty: nobody has been visited, which for a save that predates visiting is\n		-- true.\n		visits = {},\n		-- Empty for a newborn, who is nobody to anybody yet. Unlike the two fields above this\n		-- costs a stored life nothing -- a tie is only ever conferred by an offer, so there is\n		-- no year of anything to make up and nothing to be charged for having missed.\n		ties = {},\n		-- No heat and no record, which is true of a newborn and is the only safe thing to\n		-- hand a save written before crime existed: an old life cannot be charged for a\n		-- bounty that was never running, and inventing a conviction for a life the game was\n		-- not watching would be the worst possible direction for this field to be wrong in.\n		--\n		-- Heat is persisted rather than held per session, and that is deliberate: it is the\n		-- one number in the game a player would otherwise clear by pressing Leave. Logging\n		-- out is the cheapest hiding place in any open world and it has to cost the same as\n		-- every other one, which is to say it has to cost time.\n		bounty = 0,\n		convictions = 0,\n		-- `gangId`, `gangRankId` and `leftGangAt` are all intentionally absent, and the\n		-- absence is the meaning in each case: runs with nobody, holds no rung, has never\n		-- walked away from one. Because Reconcile fills a stored life from exactly this\n		-- table, a field that is not here is one it can never wrongly invent -- so a save\n		-- written before gangs existed cannot arrive already in one, which is the only\n		-- direction these three would be dangerous to be wrong in.\n		--\n		-- Empty, which reads as \"no gang has an opinion of you yet\" -- true of the newborn,\n		-- and the right thing to hand an old save: that life's standing starts being kept\n		-- from now rather than being back-paid for crimes nobody was counting.\n		gangStanding = {},\n		-- No crew, same reasoning as `gangStanding` above: true of the newborn and the\n		-- right thing to hand an old save, since a save written before crews existed had\n		-- nobody running with it either way.\n		gangCrew = {},\n		-- False rather than absent, because unlike the three above this one is read on\n		-- every tick and an absent boolean would be a nil compared against `true` -- legal,\n		-- silent, and wrong only for the lives that predate the field. False is also\n		-- correct: a life not in a gang is not wearing anybody's colors.\n		wearingColors = false,\n		-- No houses owned, no home job linked. True of a newborn, and the right\n		-- thing to hand a save written before house ownership existed.\n		houses = {\n			owned = {},\n			homeJob = {},\n		},\n		-- No cars owned, none spawned. True of a newborn, and the right thing to\n		-- hand a save written before vehicles existed: that life's garage starts\n		-- empty rather than the game inventing a car it never bought.\n		vehicles = {\n			owned = {},\n			active = nil,\n		},\n		-- Bills start at zero debt, first bill charged at month 0, zero shifts completed.\n		bills = {\n			debt = 0,\n			lastBillMonth = 0,\n			shiftsCompleted = 0,\n		},\n		-- No savings at life start. Interest compounds monthly alongside bills\n		-- so a saver and a defaulter feel the gap from the very first month.\n		savings = {\n			balance = 0,\n		},\n		-- No XP earned yet this life. Reset on death like money.\n		workXp = 0,\n		-- No milestones achieved, no bond milestones fired.\n		milestones = {},\n		bondMilestones = {},\n		-- The current chapter began at birth for a newborn, which is what zero says.\n		-- Also right for a save written before chapters existed: that life has no\n		-- smaller window to report, so its first break lists the whole of it.\n		lastChapterBreakMonths = 0,\n		-- These three are the per-chapter counters, and they are written together in\n		-- LifeService's chapter break for the same reason they belong together here.\n		--\n		-- `pendingEventCountInChapter` was missing from this table, which is the exact\n		-- failure the Reconcile note below describes -- and it bit a *newborn*, not an old\n		-- save, because this table is what a fresh life is built from too. EventService\n		-- compares it against Config.Events.MaxPerChapter on every childhood tick, so the\n		-- tick threw \"attempt to compare number <= nil\" every time and the toddler years\n		-- did nothing at all. The game booted, the panel drew, and no event ever came.\n		pendingEventCountInChapter = 0,\n		worldEventsThisChapter = 0,\n		modalEventsThisChapter = 0,\n		cooldownTimers = {},\n		-- Zero autonomy points at the start of every life. The player has to\n		-- earn the first one the same way they earn every one after: by doing\n		-- something the chapter recognises as work.\n		autonomyPoints = 0,\n		-- NPC memory: 5 rolling interactions per person, plus 1 defining moment.\n		-- Empty for a newborn; a save written before memory existed has no\n		-- remembered conversations, which is exactly true -- the game was not\n		-- watching them happen.\n		interactions = {},\n		definingMoment = {},\n		-- No fights won yet, true of the newborn and the right thing to hand a save\n		-- written before notoriety existed: that life's name has not gone around yet.\n		notoriety = 0,\n	}\nend\n\n-- Fill in anything a stored life is missing, in place.\n--\n-- **This function is the entire reason the slot refactor is safe, and it exists because\n-- ProfileStore's `Reconcile` cannot reach inside an array.** Reconcile walks the profile\n-- template and fills absent keys, which covers every account-level field -- but `slots` is\n-- a list, and a list in a template has no per-element shape to reconcile against. So the\n-- day a new per-life field is added, every already-saved slot loads back missing it: no\n-- error, no warning, just `nil` where a number should be, surfacing weeks later as\n-- arithmetic on a nil value in whichever service happened to read it first.\n--\n-- Called for every slot on every load, so a save written by any older build is brought up\n-- to the current shape before a single service sees it.\n--\n-- Deliberately additive only. It never overwrites a value that is present, including a\n-- present-but-zero one, and it never *removes* a field this build no longer knows about --\n-- a downgrade should cost the player nothing, and a stale field costs a few bytes.\nfunction Lives.Reconcile(life: LifeData)\n	-- Recursive rather than a flat key loop, because `stats` is a record with four keys of\n	-- its own and a save written before a fifth stat existed needs that one key filled, not\n	-- the whole table replaced. Safe on the map-shaped fields beside it -- `bonds`, `flags`,\n	-- `visits`, `ties`, `jobStanding` are all empty in the template, so there is nothing to\n	-- recurse into and a player's actual data is never walked.\n	local function fill(target: { [string]: any }, template: { [string]: any })\n		for key, value in template do\n			local existing = target[key]\n			if existing == nil then\n				-- Copied rather than assigned when it is a table, for the same reason `New`\n				-- is a function: handing the template's own table to a slot would let two\n				-- slots repaired in the same load share it.\n				if type(value) == \"table\" then\n					local copy = {}\n					fill(copy, value)\n					target[key] = copy\n				else\n					target[key] = value\n				end\n			elseif type(existing) == \"table\" and type(value) == \"table\" then\n				fill(existing, value)\n			end\n		end\n	end\n\n	fill(life :: any, Lives.New() :: any)\nend\n\n-- Whether this is a life being lived, or an empty slot.\n--\n-- The one fact about a life that anything is allowed to ask and that depends on nothing.\n-- It is `setup` and not `alive` that answers it, because a dead life is still a life that\n-- was lived -- it has a name, a country and a history, and the slot should say so. An\n-- empty slot has never had a person in it at all.\nfunction Lives.HasBegun(life: LifeData): boolean\n	return life.setup ~= nil\nend\n\n-- Whether this life has ever been convicted, and what that costs.\n--\n-- Here rather than in BountyService, which is where the rest of crime lives and where these\n-- three started, because a criminal record is not a fact about a chase -- it is a fact\n-- about a life, and the two things that read it sit on opposite sides of the game. The\n-- pursuit asks \"does this face get recognised faster\"; hiring asks \"how high is this desk's\n-- bar for this person\", and hiring must never have to know that a police service exists.\n--\n-- The move was forced as well as right: WorkService -> BountyService -> LifeService ->\n-- WorkService is a require cycle, and this file is the one place in the tree with a\n-- standing promise to require nothing but Config and Types so that anybody can ask it\n-- anything. `HasBegun` is here for exactly the same reason -- see its own note. Config\n-- holds the numbers, this holds the one sentence in the codebase that says what they mean,\n-- and BountyService keeps thin Player-flavoured wrappers for callers holding a Player.\nfunction Lives.HasRecord(life: LifeData): boolean\n	return life.convictions > 0\nend\n\n-- How much faster a known face turns into heat. One for a clean life, so every caller can\n-- multiply unconditionally rather than branching on whether the player has a record -- a\n-- branch that would eventually be written in one place and forgotten in another.\nfunction Lives.SuspicionMultiplier(life: LifeData): number\n	if not Lives.HasRecord(life) then\n		return 1\n	end\n	return Config.Crime.Record.SuspicionMultiplier\nend\n\n-- Whether this life is currently wearing a gang's colors.\n--\n-- Both halves matter and neither implies the other: a member who has taken the band off is\n-- in a gang and not wearing it, and `wearingColors` is only ever true alongside a gang\n-- because taking a band off does not resign. Written as one question because every caller\n-- wants the same one -- is there a bright band on this head right now.\nfunction Lives.WearingColors(life: LifeData): boolean\n	return life.gangId ~= nil and life.wearingColors\nend\n\n-- How much easier the colors make a life to describe, stacked on top of the record.\n--\n-- Here rather than in GangService for the reason the two above are here: BountyService is\n-- what multiplies heat, and BountyService cannot require GangService without a cycle --\n-- GangService needs the bounty to decide whether somebody got away. This file requires\n-- nothing but Config and Types, so it is the one place both ends can reach.\n--\n-- Multiplied by the caller against the record multiplier rather than folded in here, so\n-- that a life with a record wearing colors is charged for both -- which is correct, and is\n-- the worst possible combination to be walking past a witness in.\nfunction Lives.ColorsMultiplier(life: LifeData): number\n	if not Lives.WearingColors(life) then\n		return 1\n	end\n	return Config.Gangs.ColorsSuspicion\nend\n\n-- How much higher every job's stat bar sits for this life. Also one for a clean record, for\n-- the same reason.\nfunction Lives.HiringBarMultiplier(life: LifeData): number\n	if not Lives.HasRecord(life) then\n		return 1\n	end\n	return 1 + Config.Crime.Record.HiringBarIncrease\nend\n\n-- The life this profile is currently playing.\n--\n-- Errors rather than clamping if the slot is out of range. `activeSlot` is guaranteed valid\n-- by DataService at load and is only ever written by code that has already bounds-checked\n-- it, so an out-of-range value here is a bug in this codebase rather than bad data -- and\n-- clamping would hand back somebody else's life while looking like it worked, which is the\n-- worst possible failure for a save system to have.\nfunction Lives.Active(data: ProfileData): LifeData\n	local life = data.slots[data.activeSlot]\n	if life == nil then\n		error(\n			`[AGES] active slot {data.activeSlot} does not exist -- the profile has {#data.slots} `\n				.. `slot(s). Something wrote activeSlot without bounds-checking it against Config.Slots.Count.`\n		)\n	end\n	return life\nend\n\nreturn Lives\n"
