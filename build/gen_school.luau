AGES_SOURCES["src/server/services/MusicService.luau"] = "--!strict\n-- Music: the only lesson scored on when you act rather than on what you choose.\n--\n-- Four lanes, a chart falling down them, one thing to be good at. Every other subject in\n-- this school asks a question -- which step, which colour, which letter, which word -- and\n-- this one asks none, which is what keeps it from being one of the other five wearing\n-- different furniture.\n--\n-- **The chart goes out complete, at the downbeat, and never again.** A player who can see\n-- the next four bars is reading music; a player sent one note at a time is being startled,\n-- and the difference is whether the thing being trained is anticipation or reflex. It is\n-- also what makes the second queue possible: a held note occupies a hand while the other\n-- three lanes keep arriving, so the piece is planned a bar ahead rather than reacted to.\n--\n-- **Timing is judged on the client and there is no honest alternative.** The window being\n-- measured is 25 to 124 milliseconds and a Roblox round trip is longer than that, so a\n-- server-timed rhythm game is not a strict rhythm game, it is an unplayable one. The client\n-- therefore sends its own offset and the server treats it as a *claim*: the note must exist,\n-- must not already be hit, the offset must be inside the widest window this life has earned,\n-- and the note must have been due about now. That does not make cheating impossible. It\n-- makes it cost more than playing, which is the honest bar for a 13+ school minigame where\n-- the prize is smarts.\n--\n-- **What mastery buys is the windows, and this is the cleanest instance of that rule in the\n-- game.** Level one is judged at 25/45/80ms and level five at 48/76/124. Nothing else\n-- changes -- same chart, same tempo, same lanes -- and the player feels their own margin\n-- widen. That is requirement six of the activity law done the way Stardew does it.\n--\n-- Failure is soft throughout: a miss scores nothing and costs nothing else. There is no\n-- combo to break that takes points away, because a scoring rule that punishes is a scoring\n-- rule that makes the last thirty seconds of a good run frightening.\n\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Config = require(ReplicatedStorage:WaitForChild(\"Config\"))\nlocal Lives = require(ReplicatedStorage:WaitForChild(\"Lives\"))\nlocal Remotes = require(ReplicatedStorage:WaitForChild(\"Remotes\"))\nlocal Types = require(ReplicatedStorage:WaitForChild(\"Types\"))\nlocal Mastery = require(ReplicatedStorage:WaitForChild(\"school\"):WaitForChild(\"Mastery\"))\nlocal Report = require(ReplicatedStorage:WaitForChild(\"school\"):WaitForChild(\"Report\"))\n\nlocal DataService = require(script.Parent.DataService)\nlocal EventService = require(script.Parent.EventService)\nlocal PlaceService = require(script.Parent.PlaceService)\nlocal SkillService = require(script.Parent.SkillService)\nlocal StatService = require(script.Parent.StatService)\nlocal MusicRoom = require(script.Parent.Parent.world.MusicRoom)\nlocal School = require(script.Parent.Parent.world.School)\n\ntype LifeData = Types.LifeData\ntype MusicState = Types.MusicState\ntype MusicNote = Types.MusicNote\n\nlocal MusicService = {}\n\nlocal MusicUpdatedRemote = Remotes.Get(\"MusicUpdated\")\nlocal RequestMusicHitRemote = Remotes.Get(\"RequestMusicHit\")\n\nlocal MUSIC = Config.School.Music\nlocal CHART = MUSIC.Chart\n\nlocal SUBJECT_ID = \"music\"\nlocal PLACE_ID = \"school\"\n\n-- Every rung has to buy something, and here every rung buys three things. Checked at require\n-- time, the same guard Art keeps on its palette and Reading on its takebacks.\nfor _, pair in { { \"PerfectMsByLevel\", MUSIC.PerfectMsByLevel }, { \"GreatMsByLevel\", MUSIC.GreatMsByLevel }, { \"GoodMsByLevel\", MUSIC.GoodMsByLevel } } do\n	local name = pair[1] :: string\n	local list = pair[2] :: { number }\n	if #list ~= Mastery.Levels then\n		error(\n			`[AGES config] Config.School.Music.{name} has {#list} entries but the mastery ladder has`\n				.. ` {Mastery.Levels} rungs. Every rung has to widen the window, or a level-up is a`\n				.. ` message with nothing behind it.`\n		)\n	end\nend\n\n-- The three windows must stay ordered at every level, or a hit lands in a band the judge\n-- never reaches and the tighter grade becomes unreachable without anything erroring.\nfor level = 1, Mastery.Levels do\n	if not (MUSIC.PerfectMsByLevel[level] < MUSIC.GreatMsByLevel[level] and MUSIC.GreatMsByLevel[level] < MUSIC.GoodMsByLevel[level]) then\n		error(\n			`[AGES config] Config.School.Music windows at level {level} are`\n				.. ` {MUSIC.PerfectMsByLevel[level]}/{MUSIC.GreatMsByLevel[level]}/{MUSIC.GoodMsByLevel[level]}`\n				.. ` -- they must widen in that order or the tighter grade is unreachable.`\n		)\n	end\nend\n\ntype Session = {\n	notes: { MusicNote },\n	-- Which notes have been judged already, by index. A note is scored exactly once: without\n	-- this a client could send the same perfect hit forty times.\n	hit: { [number]: boolean },\n	perfectMs: number,\n	greatMs: number,\n	goodMs: number,\n	score: number,\n	perfect: number,\n	great: number,\n	good: number,\n	missed: number,\n	streak: number,\n	bestStreak: number,\n	-- os.clock() at the downbeat.\n	startedAt: number,\n	endsAt: number,\n	levelAtStart: number,\n	atStand: boolean,\n	line: string,\n}\n\nlocal sessions: { [Player]: Session } = {}\nlocal pushed: { [Player]: string } = {}\nlocal notices: { [Player]: { text: string, until_: number } } = {}\nlocal enabled = true\nlocal roomBuilt = false\n\nlocal function characterPosition(player: Player): Vector3?\n	local character = player.Character\n	if character == nil then\n		return nil\n	end\n	local root = character:FindFirstChild(\"HumanoidRootPart\") :: BasePart?\n	if root == nil then\n		return nil\n	end\n	return root.Position\nend\n\nlocal function levelOf(data: LifeData): number\n	return Mastery.LevelOf(data, SUBJECT_ID)\nend\n\nlocal function ensureRoom(): boolean\n	if roomBuilt then\n		return MusicRoom.Room() ~= nil\n	end\n	local place = PlaceService.Find(PLACE_ID)\n	if place == nil then\n		return false\n	end\n	roomBuilt = true\n	School.Build(place.part.Position)\n	return MusicRoom.Build(School.RoomAt(\"music\") or place.part.Position) ~= nil\nend\n\nlocal function notice(player: Player, text: string)\n	notices[player] = { text = text, until_ = os.clock() + Config.UI.NoticeSeconds }\nend\n\n-- Writes a chart.\n--\n-- Generated rather than authored, unlike every other content bank in this tree, and the\n-- reason is the one thing that makes rhythm different: a hand-written chart is a piece of\n-- *music*, and thirty-six of them is a job for somebody who writes music. What a lesson\n-- needs is a piece with shape -- rests, chords, holds, a ramp -- and that is a handful of\n-- rules rather than a bank of files.\n--\n-- Held to the same standards a bank would be: it never opens on its hardest figure, it\n-- always breathes, and a chord never lands twice in one lane.\nlocal function writeChart(): { MusicNote }\n	local notes: { MusicNote } = {}\n	for beat = 1, CHART.Beats do\n		if math.random() > CHART.NoteChance then\n			continue\n		end\n		local atMs = (CHART.CountInBeats + beat) * CHART.BeatMs\n		local ramped = beat > CHART.RampBeats\n		local lane = math.random(1, MUSIC.Lanes)\n		local holdMs = 0\n		if ramped and math.random() < CHART.HoldChance then\n			holdMs = CHART.HoldBeats * CHART.BeatMs\n		end\n		table.insert(notes, { atMs = atMs, lane = lane, holdMs = holdMs })\n\n		-- The chord: a second note on the same beat in a different lane. Chosen by walking\n		-- from a random offset rather than by rerolling until it differs, because a reroll\n		-- loop with one lane free is a loop that can run a long time.\n		if ramped and math.random() < CHART.ChordChance then\n			local other = ((lane + math.random(1, MUSIC.Lanes - 1) - 1) % MUSIC.Lanes) + 1\n			table.insert(notes, { atMs = atMs, lane = other, holdMs = 0 })\n		end\n	end\n	return notes\nend\n\nlocal function stateFor(player: Player): MusicState\n	local session = sessions[player]\n	if session == nil then\n		local held = notices[player]\n		local line = \"\"\n		if held ~= nil and os.clock() < held.until_ then\n			line = held.text\n		else\n			notices[player] = nil\n		end\n		return {\n			active = false,\n			line = line,\n			notes = {},\n			startedAt = 0,\n			perfectMs = 0,\n			greatMs = 0,\n			goodMs = 0,\n			perfect = 0,\n			great = 0,\n			good = 0,\n			missed = 0,\n			streak = 0,\n			bestStreak = 0,\n			notesTotal = 0,\n			secondsLeft = 0,\n			atStand = false,\n			masteryLevel = 1,\n		}\n	end\n\n	local profile = DataService.GetProfile(player)\n	local level = if profile ~= nil then levelOf(Lives.Active(profile.Data)) else 1\n\n	return {\n		active = true,\n		line = session.line,\n		notes = session.notes,\n		startedAt = session.startedAt,\n		perfectMs = session.perfectMs,\n		greatMs = session.greatMs,\n		goodMs = session.goodMs,\n		perfect = session.perfect,\n		great = session.great,\n		good = session.good,\n		missed = session.missed,\n		streak = session.streak,\n		bestStreak = session.bestStreak,\n		notesTotal = #session.notes,\n		secondsLeft = math.max(session.endsAt - os.clock(), 0),\n		atStand = session.atStand,\n		masteryLevel = level,\n	}\nend\n\nlocal function push(player: Player)\n	local state = stateFor(player)\n	-- The chart is not in the signature. It is fixed for the whole lesson, it is the largest\n	-- thing on the channel, and hashing it every tick to discover it has not changed would\n	-- cost more than the throttle saves.\n	local signature = `{state.active}|{state.line}|{state.perfect}|{state.great}|{state.good}`\n		.. `|{state.missed}|{state.streak}|{state.atStand}|{math.floor(state.secondsLeft)}`\n	if pushed[player] == signature then\n		return\n	end\n	pushed[player] = signature\n	MusicUpdatedRemote:FireClient(player, state)\nend\n\nlocal function finish(player: Player, data: LifeData, session: Session, reason: string)\n	-- Decided before anything is written: work the outcome out, then record it.\n	local total = #session.notes\n	local share = if total > 0 then math.clamp(session.score / total, 0, 1) else 0\n	local band = Report.BandFor(share)\n	local gained = Report.SmartsFor(band)\n\n	sessions[player] = nil\n\n	if gained ~= 0 then\n		StatService.AddStat(player, \"smarts\", gained)\n	end\n\n	Mastery.Record(data, SUBJECT_ID, share)\n\n	local earned = math.floor(Config.Skills.Awards.MusicPiece * share)\n	if earned > 0 then\n		SkillService.Award(player, \"academics\", earned, \"kept time\")\n	end\n\n	data.lessonsThisYear += 1\n	EventService.AwardAutonomy(player, 1)\n\n	local level = levelOf(data)\n	Report.RecordLesson(data, SUBJECT_ID, band, gained, if level > session.levelAtStart then level else nil)\n\n	local percent = math.floor(share * 100 + 0.5)\n	local opening = if reason == \"played\" then \"That is the piece.\" elseif reason == \"left\" then \"You walked off mid-bar.\" else \"Time.\"\n	local reward = if gained > 0 then `. +{gained} smarts.` else \".\"\n	notice(player, `{opening} {percent}%, best run of {session.bestStreak}{reward}`)\n	push(player)\nend\n\n-- One claimed hit. Everything about it is checked, because everything about it came from the\n-- client -- see the note at the top of the file about why it has to.\nlocal function onHitRequested(player: Player, index: unknown, offsetMs: unknown)\n	local session = sessions[player]\n	if session == nil then\n		return\n	end\n	if typeof(index) ~= \"number\" or typeof(offsetMs) ~= \"number\" then\n		return\n	end\n	if index ~= math.floor(index) or index < 1 or index > #session.notes then\n		return\n	end\n	if session.hit[index] then\n		return\n	end\n	if offsetMs ~= offsetMs then\n		-- NaN. Compares false against every bound below, so it would slip through as a\n		-- perfect. It arrives from a client that computed a hit against a zero clock.\n		return\n	end\n\n	local note = session.notes[index]\n	local magnitude = math.abs(offsetMs)\n	if magnitude > session.goodMs then\n		return\n	end\n\n	-- And the note has to have been due about now. This is the bound the offset cannot fake:\n	-- a client can claim any offset it likes, but it cannot claim one for a note that is four\n	-- bars away without the server noticing the wall clock disagrees.\n	local dueAt = session.startedAt + note.atMs / 1000\n	if math.abs(os.clock() - dueAt) * 1000 > MUSIC.AcceptMs then\n		return\n	end\n\n	session.hit[index] = true\n	if magnitude <= session.perfectMs then\n		session.perfect += 1\n		session.score += MUSIC.PerfectScore\n	elseif magnitude <= session.greatMs then\n		session.great += 1\n		session.score += MUSIC.GreatScore\n	else\n		session.good += 1\n		session.score += MUSIC.GoodScore\n	end\n\n	session.streak += 1\n	if session.streak > session.bestStreak then\n		session.bestStreak = session.streak\n	end\n	push(player)\nend\n\n-- Sweeps notes whose window has closed without a hit. Done on the server tick rather than\n-- trusting the client to report its own misses, for the obvious reason: a client that never\n-- reports a miss has a perfect run.\nlocal function sweepMisses(session: Session)\n	local now = os.clock()\n	for index, note in session.notes do\n		if not session.hit[index] then\n			local dueAt = session.startedAt + note.atMs / 1000\n			if now > dueAt + session.goodMs / 1000 then\n				session.hit[index] = true\n				session.missed += 1\n				session.streak = 0\n			end\n		end\n	end\nend\n\nlocal function tickPlayer(player: Player, _dt: number)\n	local session = sessions[player]\n	if session == nil then\n		push(player)\n		return\n	end\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return\n	end\n\n	local position = characterPosition(player)\n	local room = MusicRoom.Room()\n	if position ~= nil and room ~= nil then\n		session.atStand = (position - room.stand).Magnitude <= MUSIC.Build.ReachStuds\n	end\n\n	sweepMisses(session)\n\n	-- Every note judged, or the clock ran out. The first is the normal end and arrives well\n	-- before the second, which is a backstop for a player who walked off.\n	local remaining = 0\n	for index = 1, #session.notes do\n		if not session.hit[index] then\n			remaining += 1\n		end\n	end\n	if remaining == 0 then\n		finish(player, Lives.Active(profile.Data), session, \"played\")\n		return\n	end\n	if os.clock() >= session.endsAt then\n		finish(player, Lives.Active(profile.Data), session, \"time\")\n		return\n	end\n	push(player)\nend\n\n-- The contract SchoolService dispatches against.\nfunction MusicService.Begin(player: Player, data: LifeData): (boolean, string?)\n	if sessions[player] ~= nil then\n		return false, \"You are already at the stand.\"\n	end\n	if not enabled then\n		return false, \"There is no music today.\"\n	end\n	if not ensureRoom() then\n		return false, \"The music room is closed today.\"\n	end\n\n	local notes = writeChart()\n	if #notes == 0 then\n		-- Possible only if NoteChance is set to zero, which is a config mistake rather than a\n		-- content one. Said out loud rather than starting a silent lesson.\n		return false, \"There is nothing written on the stand today.\"\n	end\n\n	local level = levelOf(data)\n	local lastMs = notes[#notes].atMs\n	local session: Session = {\n		notes = notes,\n		hit = {},\n		perfectMs = MUSIC.PerfectMsByLevel[level],\n		greatMs = MUSIC.GreatMsByLevel[level],\n		goodMs = MUSIC.GoodMsByLevel[level],\n		score = 0,\n		perfect = 0,\n		great = 0,\n		good = 0,\n		missed = 0,\n		streak = 0,\n		bestStreak = 0,\n		startedAt = os.clock(),\n		-- The longer of the lesson cap and the piece itself plus a bar. A chart that outran\n		-- the cap would be graded on the half of it that fitted.\n		endsAt = os.clock() + math.max(MUSIC.SecondsPerLesson, lastMs / 1000 + 4),\n		levelAtStart = level,\n		atStand = false,\n		line = \"Four lanes. Count yourself in.\",\n	}\n\n	sessions[player] = session\n	notices[player] = nil\n	push(player)\n	return true\nend\n\nlocal function forget(player: Player)\n	sessions[player] = nil\n	notices[player] = nil\n	pushed[player] = nil\nend\n\nfunction MusicService.ResetForNewLife(player: Player)\n	forget(player)\n	push(player)\nend\n\nfunction MusicService.ForceStart(player: Player): (boolean, string?)\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return false, \"no profile loaded\"\n	end\n	return MusicService.Begin(player, Lives.Active(profile.Data))\nend\n\nfunction MusicService.ForceEnd(player: Player): boolean\n	local session = sessions[player]\n	if session == nil then\n		return false\n	end\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return false\n	end\n	finish(player, Lives.Active(profile.Data), session, \"left\")\n	return true\nend\n\n-- Debug: judge every remaining note at the given grade, so the scoring, the report line and\n-- the mastery rung can be reached without playing a hundred-beat piece by hand.\nfunction MusicService.Autoplay(player: Player, grade: string): (boolean, string?)\n	local session = sessions[player]\n	if session == nil then\n		return false, \"no piece running\"\n	end\n	local value = if grade == \"perfect\" then MUSIC.PerfectScore elseif grade == \"great\" then MUSIC.GreatScore elseif grade == \"good\" then MUSIC.GoodScore else nil\n	if value == nil then\n		return false, `grade must be perfect, great or good -- got \"{grade}\"`\n	end\n	for index = 1, #session.notes do\n		if not session.hit[index] then\n			session.hit[index] = true\n			session.score += value\n			session.streak += 1\n			if grade == \"perfect\" then\n				session.perfect += 1\n			elseif grade == \"great\" then\n				session.great += 1\n			else\n				session.good += 1\n			end\n		end\n	end\n	if session.streak > session.bestStreak then\n		session.bestStreak = session.streak\n	end\n	push(player)\n	return true\nend\n\nfunction MusicService.SetEnabled(value: boolean)\n	enabled = value\nend\n\nfunction MusicService.IsEnabled(): boolean\n	return enabled\nend\n\nfunction MusicService.Describe(player: Player): string\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return \"no profile loaded\"\n	end\n	local data = Lives.Active(profile.Data)\n	local level = levelOf(data)\n	local room = MusicRoom.Room()\n	local lines = {\n		`enabled: {enabled}`,\n		`mastery: {level}/{Mastery.Levels}`\n			.. `  windows {MUSIC.PerfectMsByLevel[level]}/{MUSIC.GreatMsByLevel[level]}/{MUSIC.GoodMsByLevel[level]}ms`,\n		`room: {if room ~= nil then \"laid\" else \"not laid yet\"}`,\n	}\n	local session = sessions[player]\n	if session == nil then\n		table.insert(lines, \"no piece running\")\n	else\n		local judged = session.perfect + session.great + session.good + session.missed\n		table.insert(\n			lines,\n			`{judged}/{#session.notes} judged`\n				.. `  perfect {session.perfect}  great {session.great}  good {session.good}  missed {session.missed}`\n				.. `  streak {session.streak} (best {session.bestStreak})`\n				.. `  score {string.format(\"%.1f\", session.score)}`\n				.. `  {math.floor(math.max(session.endsAt - os.clock(), 0))}s left  stand={session.atStand}`\n		)\n	end\n	return table.concat(lines, \"\\n\")\nend\n\nfunction MusicService:Start()\n	Players.PlayerRemoving:Connect(forget)\n\n	RequestMusicHitRemote.OnServerEvent:Connect(function(player: Player, index: unknown, offsetMs: unknown)\n		local ok, err = pcall(onHitRequested, player, index, offsetMs)\n		if not ok then\n			warn(`[AGES] music hit failed for {player.Name}: {err}`)\n		end\n	end)\n\n	task.spawn(function()\n		while true do\n			local elapsed = task.wait(MUSIC.TickSeconds)\n			ensureRoom()\n			for _, player in Players:GetPlayers() do\n				local ok, err = pcall(tickPlayer, player, elapsed)\n				if not ok then\n					warn(`[AGES] music tick failed for {player.Name}: {err}`)\n				end\n			end\n		end\n	end)\nend\n\nreturn MusicService\n"
table.insert(AGES_MANIFEST, "src/server/services/MusicService.luau")
AGES_SOURCES["src/server/services/NPCService.luau"] = "--!strict\n-- Visitors. Builds a real R15 avatar for a member of the cast, walks them in\n-- from the doorstep, has them look at the player while they wait, and walks them\n-- back out afterwards.\n--\n-- Three layers, in order of how much they cost to have:\n--\n--   Body       HumanoidDescription scales and colors. Needs no asset ids at all,\n--              so a visitor is a properly proportioned person from the very\n--              first run rather than a placeholder waiting on a shopping trip.\n--   Motion     Two of them, and the caller picks. `walkTo` is a straight line via\n--              Humanoid:MoveTo, which is right for a visitor crossing an empty\n--              hallway to a spot chosen to be reachable. `pathTo` asks\n--              PathfindingService for a route and walks it waypoint by waypoint,\n--              which is what a townsperson crossing a built world needs -- a\n--              straight line there walks into the first wall it meets and gives up.\n--   Expression Looped idle/walk plus one-shot greet and talk clips, driven from\n--              Config.Assets.Animations, procedural head tracking, and turning on\n--              the spot to face somebody.\n--\n-- Head tracking is the part worth understanding. It is the single largest\n-- difference between a mannequin and a person, and it costs nothing: no asset,\n-- no upload, just the neck joint re-aimed a few times a second. So it runs even\n-- while every animation id above is still empty, and it is what carries the\n-- scene until they are filled in.\n--\n-- `face` is the same argument one level down the body. The neck says somebody has\n-- noticed you; turning to square up says they have stopped what they were doing.\n-- It exists because the town walks now, and being spoken to by a person facing\n-- away down the street is worse than being spoken to by a statue.\n\nlocal PathfindingService = game:GetService(\"PathfindingService\")\nlocal Players = game:GetService(\"Players\")\nlocal PhysicsService = game:GetService(\"PhysicsService\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Config = require(ReplicatedStorage:WaitForChild(\"Config\"))\nlocal Types = require(ReplicatedStorage:WaitForChild(\"Types\"))\nlocal Lives = require(ReplicatedStorage:WaitForChild(\"Lives\"))\n\nlocal Cast = require(script.Parent.Parent.content.Cast)\nlocal DataService = require(script.Parent.DataService)\n\ntype LifeEvent = Types.LifeEvent\ntype CastMember = Types.CastMember\ntype DeliveryPresentation = Types.DeliveryPresentation\n\nlocal NPCService = {}\n\nlocal VISITORS_FOLDER = \"AgesVisitors\"\n\n-- Below this the humanoid is standing still for animation purposes. Not a design\n-- tunable: it is the noise floor of Humanoid.Running, which reports small\n-- non-zero speeds while settling.\nlocal MOVING_SPEED_THRESHOLD = 0.5\n\n-- How often a walk is checked for having finished. Only bounds how quickly the\n-- *next* beat starts, so it can be coarse.\nlocal WALK_POLL_SECONDS = 0.1\n\n-- Cross-fade between idle and walk. Long enough not to pop, short enough that a\n-- visitor who stops does not keep striding for half a step.\nlocal ANIMATION_FADE_SECONDS = 0.2\n\n-- Below this, the vector from a rig to whoever it is turning toward is straight up\n-- or straight down and carries no heading. Not a tunable: it is the floating-point\n-- floor of the arithmetic it guards, the same one PlaceService keeps for the same\n-- reason.\nlocal FLAT_FACING_EPSILON = 1e-3\n\n-- Visitors are solid to the world and to the player, and pass through each other.\n--\n-- The world half is not a choice: a humanoid with nothing to collide with falls\n-- through the floor. The each-other half is what makes a queue possible at all --\n-- four rigs standing a couple of studs apart shove one another sideways within\n-- seconds, and a line that drifts apart under its own weight is not a line.\n--\n-- The player is deliberately left out of it. Somebody standing at a till is a person\n-- in your way, and walking through them would undo the only thing that makes them\n-- feel present.\nlocal VISITOR_COLLISION_GROUP = \"AgesVisitors\"\n\n-- Every rig currently alive, so a hot reload or a server restart can sweep up\n-- visitors whose delivery no longer exists.\nlocal active: { [Model]: boolean } = {}\n\n-- Positions of every active visitor, keyed by the rig model so the world event\n-- system can answer \"who is near the player\" without walking the whole cast.\n-- Each entry carries the cast id (used as the context tag) and the root position.\nlocal visitorPositions: { [Model]: { id: string, position: Vector3 } } = {}\n\n-- Registered once, on demand, and reported if it fails rather than left to be\n-- discovered as a queue that will not hold its shape.\nlocal collisionGroupReady = false\n\nlocal function ensureCollisionGroup(): boolean\n	if collisionGroupReady then\n		return true\n	end\n\n	local ok, err = pcall(function()\n		-- Checked rather than assumed: registering a name twice is an error, and this\n		-- runs again after every hot reload in Studio.\n		if not PhysicsService:IsCollisionGroupRegistered(VISITOR_COLLISION_GROUP) then\n			PhysicsService:RegisterCollisionGroup(VISITOR_COLLISION_GROUP)\n		end\n		PhysicsService:CollisionGroupSetCollidable(VISITOR_COLLISION_GROUP, VISITOR_COLLISION_GROUP, false)\n	end)\n	if not ok then\n		warn(`[AGES] visitors will push each other around: {err}`)\n		return false\n	end\n\n	collisionGroupReady = true\n	return true\nend\n\nlocal function visitorsFolder(): Folder\n	local existing = workspace:FindFirstChild(VISITORS_FOLDER)\n	if existing ~= nil then\n		return existing :: Folder\n	end\n	local folder = Instance.new(\"Folder\")\n	folder.Name = VISITORS_FOLDER\n	folder.Parent = workspace\n	return folder\nend\n\n-- How big this person is, right now, as the four numbers a rig is scaled by.\n--\n-- A CastMember carries a *build* -- how far off average for their age they are --\n-- and the age supplies the rest, from the one curve everybody in the world grows\n-- along. Nil age means grown, which is the honest default for every caller that\n-- spawns an adult and has no reason to say so: a shopkeeper, a delivery driver,\n-- somebody a scene needed. It reproduces exactly what this file did before there\n-- was a curve at all.\n--\n-- Depth is scaled with the rest, and it did not used to be. On an adult that is\n-- invisible, which is why it went unnoticed; on a body scaled to a third of its\n-- height it is the difference between a small child and a flattened one.\nlocal function scaleOf(member: CastMember, ageYears: number?): (number, number, number)\n	if ageYears == nil then\n		return member.heightScale, member.widthScale, member.headScale\n	end\n	local body, head = Config.Growth.At(ageYears)\n	return member.heightScale * body, member.widthScale * body, member.headScale * head\nend\n\n-- How old a peer is right now, for callers who never had a reason to work it out.\n-- PeopleService knows a townsperson's age already and passes it; everybody else --\n-- an event sending Rae round, a scene that just wants somebody there -- does not,\n-- and asking each of them to would be asking every caller to care about growth in\n-- order to spawn a person. So the question is answered here, once, off the member's\n-- own ageOffset.\n--\n-- nil for anybody without an offset, which is everybody but the peers, and nil again\n-- if the profile has not loaded: an adult-sized rig is a far smaller wrong than a\n-- newborn-sized one, which is what treating a missing profile as age nought would give.\nlocal function peerAge(player: Player, member: CastMember): number?\n	local offset = member.ageOffset\n	if offset == nil then\n		return nil\n	end\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return nil\n	end\n	return math.max(Lives.Active(profile.Data).ageMonths // Config.Time.MonthsPerYear + offset, 0)\nend\n\nlocal function buildDescription(member: CastMember, ageYears: number?): HumanoidDescription\n	local description = Instance.new(\"HumanoidDescription\")\n	local height, width, headSize = scaleOf(member, ageYears)\n	description.HeightScale = height\n	description.WidthScale = width\n	description.DepthScale = width\n	description.HeadScale = headSize\n	description.ProportionScale = member.proportionScale\n	description.BodyTypeScale = member.bodyTypeScale\n\n	description.HeadColor = member.skinColor\n\n	-- Arms and torso take the shirt colour when there is one, legs the pants\n	-- colour -- both fall back to skinColor, which is exactly the old\n	-- all-one-shade body for any CastMember that has not been given either.\n	-- This is what makes a crowd of these read as clothed people from across\n	-- a pitch rather than as a few hundred identical skin-toned dummies: no\n	-- asset upload, no shopping trip, just two more colours read off the body.\n	local shirt = member.shirtColor or member.skinColor\n	local pants = member.pantsColor or member.skinColor\n	description.LeftArmColor = shirt\n	description.RightArmColor = shirt\n	description.TorsoColor = shirt\n	description.LeftLegColor = pants\n	description.RightLegColor = pants\n\n	-- 0 is HumanoidDescription's own \"empty slot\", so an unchosen id is left\n	-- alone rather than written as a zero that would fail to load.\n	if member.shirtAssetId ~= 0 then\n		description.Shirt = member.shirtAssetId\n	end\n	if member.pantsAssetId ~= 0 then\n		description.Pants = member.pantsAssetId\n	end\n	if member.hairAssetId ~= 0 then\n		description.HairAccessory = tostring(member.hairAssetId)\n	end\n\n	return description\nend\n\n-- Written once when the rig is built and again on every birthday.\n--\n-- Belt and braces over the description, and both halves earn their place. The\n-- description is what gets the *proportions* right at build time; these\n-- NumberValues are what the engine actually renders from, they can be written\n-- to a body that already exists, and they are not subject to whatever the\n-- place's avatar rules would clamp a description to. Without the second half a\n-- classmate stays the size they were the day you met them until something else\n-- happens to tear their rig down -- which is a birthday you can watch not\n-- happening.\nlocal warnedAboutScales = false\nlocal function applyScale(humanoid: Humanoid, member: CastMember, ageYears: number?)\n	local height, width, headSize = scaleOf(member, ageYears)\n	local scales: { [string]: number } = {\n		BodyHeightScale = height,\n		BodyWidthScale = width,\n		BodyDepthScale = width,\n		HeadScale = headSize,\n	}\n\n	local scaled = true\n	for valueName, target in scales do\n		local value = humanoid:FindFirstChild(valueName)\n		if value ~= nil and value:IsA(\"NumberValue\") then\n			value.Value = target\n		else\n			scaled = false\n		end\n	end\n\n	-- Once per server, exactly as BodyService does for the player's own rig, and\n	-- for the same reason: silently not growing looks like a content mistake and\n	-- sends whoever is chasing it to the wrong file entirely.\n	if not scaled and not warnedAboutScales then\n		warnedAboutScales = true\n		warn(\"[AGES] a visitor rig has no R15 scale values; nobody in the world will be sized to their age\")\n	end\nend\n\n-- An empty id means one has not been chosen in Studio yet. Returning nil rather\n-- than loading an empty AnimationId keeps that at \"this clip is missing\" instead\n-- of an error on every play, and every caller already handles a nil track.\nlocal function loadTrack(animator: Animator, assetId: string, looped: boolean, priority: Enum.AnimationPriority): AnimationTrack?\n	if assetId == \"\" then\n		return nil\n	end\n\n	local animation = Instance.new(\"Animation\")\n	animation.AnimationId = assetId\n\n	local ok, track = pcall(function()\n		return animator:LoadAnimation(animation)\n	end)\n	if not ok or track == nil then\n		warn(`[AGES] visitor animation \"{assetId}\" could not be loaded: {track}`)\n		return nil\n	end\n\n	track.Looped = looped\n	track.Priority = priority\n	return track\nend\n\n-- Re-aims the neck at a point in the world and returns the angles it settled on,\n-- so the caller can carry them into the next tick. Angles are eased rather than\n-- snapped: a head that reaches its target in one frame reads as a turret.\n--\n-- Yaw is measured in the upper torso's space, where -Z is forward and +Y is up,\n-- which is the same frame the neck's rest C0 sits in -- so the rotation composes\n-- onto that rest pose directly instead of needing to be converted first.\nlocal function aimNeck(\n	neck: Motor6D,\n	restC0: CFrame,\n	upperTorso: BasePart,\n	head: BasePart,\n	target: Vector3?,\n	yaw: number,\n	pitch: number\n): (number, number)\n	local desiredYaw, desiredPitch = 0, 0\n\n	if target ~= nil then\n		local toTarget = target - head.Position\n		local distance = toTarget.Magnitude\n		-- Beyond LookMaxDistance they face front. Someone across the street is\n		-- not staring at you, and tracking that far reads as uncanny.\n		if distance > 0 and distance <= Config.NPC.LookMaxDistance then\n			local relative = upperTorso.CFrame:VectorToObjectSpace(toTarget.Unit)\n			desiredYaw = math.atan2(-relative.X, -relative.Z)\n			desiredPitch = math.asin(math.clamp(relative.Y, -1, 1))\n		end\n	end\n\n	-- Clamped rather than abandoned: past the limit a person turns as far as\n	-- their neck goes and holds it there, which is what this looks like.\n	local maxYaw = math.rad(Config.NPC.LookMaxYawDegrees)\n	local maxPitch = math.rad(Config.NPC.LookMaxPitchDegrees)\n	desiredYaw = math.clamp(desiredYaw, -maxYaw, maxYaw)\n	desiredPitch = math.clamp(desiredPitch, -maxPitch, maxPitch)\n\n	local responsiveness = Config.NPC.LookResponsiveness\n	local nextYaw = yaw + (desiredYaw - yaw) * responsiveness\n	local nextPitch = pitch + (desiredPitch - pitch) * responsiveness\n\n	neck.C0 = restC0 * CFrame.Angles(nextPitch, nextYaw, 0)\n	return nextYaw, nextPitch\nend\n\n-- Walks to a point and reports whether it arrived. Bounded by its own timeout\n-- rather than trusting MoveToFinished, because a humanoid wedged on geometry\n-- never fires it and a visitor frozen in the hallway forever is worse than one\n-- who quietly gives up.\n--\n-- `shouldStop` is how a walk is called off from outside while it is happening --\n-- somebody has walked up to talk, the roster is being torn down, the whole thing\n-- has been switched off in the harness. Asked on the poll rather than handed a\n-- cancel token, because the caller is the only thing that knows what \"call it off\"\n-- means and this way it never has to be told twice.\nlocal function walkTo(humanoid: Humanoid, position: Vector3, timeout: number, shouldStop: (() -> boolean)?): boolean\n	local finished = false\n	local reached = false\n\n	local connection = humanoid.MoveToFinished:Connect(function(ok: boolean)\n		reached = ok\n		finished = true\n	end)\n\n	humanoid:MoveTo(position)\n\n	local elapsed = 0\n	while not finished and elapsed < timeout do\n		if humanoid.Parent == nil then\n			break\n		end\n		if shouldStop ~= nil and shouldStop() then\n			-- Abandoned, not arrived. Aimed at where they already stand, which is the\n			-- only way to stop a humanoid without freezing it in mid-stride.\n			local root = humanoid.RootPart\n			if root ~= nil then\n				humanoid:MoveTo(root.Position)\n			end\n			reached = false\n			break\n		end\n		elapsed += task.wait(WALK_POLL_SECONDS)\n	end\n\n	connection:Disconnect()\n	return reached\nend\n\n-- The agent a route is computed for. Nominal, like everything else measured off\n-- Config.NPC.BodyRadius: a path has to be asked for before there is a body to\n-- measure, and asking for one slightly wider than anybody actually is means the\n-- error is a route refused rather than a route through a doorway they do not fit.\nlocal function agentParams(): { [string]: any }\n	return {\n		AgentRadius = Config.NPC.BodyRadius,\n		AgentHeight = Config.NPC.BodyHeight,\n		AgentCanJump = true,\n	}\nend\n\n-- Walks a computed route and reports whether the whole thing was walked.\n--\n-- Every failure here -- no route, a wedged waypoint, geometry that moved -- comes\n-- back as false rather than as a retry, because the caller is a wander loop that\n-- already has somewhere else to be. Grinding against an obstacle is the one\n-- behaviour that reads as broken from across the street; giving up and strolling\n-- somewhere else does not.\nlocal function pathTo(humanoid: Humanoid, root: BasePart, position: Vector3, shouldStop: (() -> boolean)?): boolean\n	if shouldStop ~= nil and shouldStop() then\n		return false\n	end\n\n	local path = PathfindingService:CreatePath(agentParams())\n\n	local ok = pcall(function()\n		path:ComputeAsync(root.Position, position)\n	end)\n	if not ok or path.Status ~= Enum.PathStatus.Success then\n		-- No route. Not warned: an unreachable spot is an ordinary answer when the\n		-- thing asking is picking spots at random, and a warning per attempt would\n		-- bury the log in a town of thirty.\n		path:Destroy()\n		return false\n	end\n\n	local waypoints = path:GetWaypoints()\n	path:Destroy()\n\n	-- The first waypoint is where the walker already is, so walking to it is a\n	-- MoveTo that finishes instantly and costs a poll interval each leg.\n	for index = 2, #waypoints do\n		if humanoid.Parent == nil then\n			return false\n		end\n		local waypoint = waypoints[index]\n		if waypoint.Action == Enum.PathWaypointAction.Jump then\n			humanoid.Jump = true\n		end\n		if not walkTo(humanoid, waypoint.Position, Config.NPC.WaypointTimeoutSeconds, shouldStop) then\n			return false\n		end\n	end\n\n	return true\nend\n\nlocal function resolveMember(event: LifeEvent): CastMember\n	local castId = event.cast\n	if castId == nil then\n		return Cast.Default\n	end\n	-- Validated at content load, so reaching here with an unknown id would mean\n	-- the validator was bypassed. Fall back rather than fail the whole delivery.\n	local member = Cast.ById[castId]\n	if member == nil then\n		warn(`[AGES] event \"{event.id}\" casts \"{castId}\", who is not in the cast; sending {Cast.Default.name}`)\n		return Cast.Default\n	end\n	return member\nend\n\n-- A person standing in the world, and everything anyone can ask one to do.\n--\n-- Handed back by Spawn rather than driven through the service, because a visitor is\n-- not a singleton and the caller is the only thing that knows the shape of the\n-- errand: a delivery walks to a fixed spot and waits, while a parent chases a\n-- moving toddler across a room. Both are the same person underneath, which is the\n-- whole point of the split.\nexport type Visitor = {\n	model: Model,\n	-- The part to hang things off -- the anchor a delivery's interact prompt sits on\n	-- and the point money floats up from.\n	root: BasePart,\n	-- Where they are now.\n	at: () -> Vector3,\n	-- Whether the rig has left the world. Every yield below is a place a visitor can\n	-- be torn down under the caller -- a server sweep, a life ending -- so anything\n	-- that comes back from a wait and touches them has to ask this first.\n	gone: () -> boolean,\n	-- Aims the walk at a point and returns immediately. For a target that moves, call\n	-- it again: a humanoid holds the last destination it was given, so a chase is a\n	-- re-aim on a tick rather than anything cleverer.\n	moveTo: (position: Vector3) -> (),\n	-- Stops where they stand. Needed because moveTo has no \"and stop here\" -- a\n	-- chaser that simply stopped re-aiming would keep walking into the player.\n	halt: () -> (),\n	-- Walks to a point and reports whether it arrived, yielding until it does or\n	-- until Config.NPC.WalkTimeoutSeconds gives up. The right call for a fixed\n	-- destination; useless for a moving one.\n	walkTo: (position: Vector3) -> boolean,\n	-- The same, by a route rather than in a straight line, and false the moment any\n	-- part of it fails. What to use when the destination is somewhere in a built\n	-- world rather than a spot picked to be reachable -- see the note above pathTo.\n	-- Yields for as long as the walk takes, so it takes a way to be called off: pass\n	-- a predicate that goes true when this walk has stopped being wanted.\n	pathTo: (position: Vector3, shouldStop: (() -> boolean)?) -> boolean,\n	-- Turns them on the spot to look at a point, easing rather than snapping, and\n	-- holds there. nil lets go, and is what has to be called before they walk again:\n	-- a body being held at an angle cannot also be steering itself.\n	--\n	-- Not a MoveTo. A humanoid turns by walking, so aiming one at a point a step\n	-- away to make it face somebody produces a shuffle, and a person who takes a\n	-- step toward you every time you speak to them is unnerving rather than warm.\n	face: (target: Vector3?) -> (),\n	-- How fast they walk from now on. Here rather than at spawn because the same\n	-- body does different things at different speeds -- crossing town is a stroll,\n	-- arriving at a door is not -- and both are properties of the errand.\n	setSpeed: (studsPerSecond: number) -> (),\n	-- How old they are from now on, which is the only thing that decides how big\n	-- they are. Here rather than only at spawn because a birthday must not cost a\n	-- rebuild: tearing a rig down and building a new one is a yielding web call and\n	-- a visible pop, so the whole street would flicker every time the player aged\n	-- up. nil is grown, matching Spawn.\n	setAge: (ageYears: number?) -> (),\n	greet: () -> (),\n	talk: () -> (),\n	destroy: () -> (),\n}\n\n-- Builds a person and puts them in the world facing the way `at` faces. Yields:\n-- creating an avatar from a description is a web-backed call. Returns nil if the rig\n-- could not be made, which every caller must treat as \"this did not happen\".\n--\n-- Knows nothing about why they are here. It takes a cast member and a place to\n-- appear, and everything above the neck -- head tracking, locomotion clips -- runs\n-- from the moment they exist, because those are properties of being a person rather\n-- than of any particular errand.\nfunction NPCService.Spawn(player: Player, member: CastMember, at: CFrame, ageYears: number?): Visitor?\n	local age = ageYears or peerAge(player, member)\n\n	local ok, rig = pcall(function()\n		return Players:CreateHumanoidModelFromDescription(buildDescription(member, age), Enum.HumanoidRigType.R15)\n	end)\n	if not ok or rig == nil then\n		warn(`[AGES] could not build visitor \"{member.id}\": {rig}`)\n		return nil\n	end\n\n	local visitor = rig :: Model\n	local humanoid = visitor:FindFirstChildOfClass(\"Humanoid\")\n	local root = visitor:FindFirstChild(\"HumanoidRootPart\") :: BasePart?\n	if humanoid == nil or root == nil then\n		warn(`[AGES] visitor \"{member.id}\" came back without a humanoid or root part`)\n		visitor:Destroy()\n		return nil\n	end\n\n	visitor.Name = `Visitor_{member.id}`\n	-- Again, over the description that already asked for it. See applyScale.\n	applyScale(humanoid, member, age)\n	humanoid.DisplayName = member.name\n	humanoid.WalkSpeed = Config.NPC.WalkSpeed\n	-- Nobody is fighting anybody in this game, so a health bar over a visitor's\n	-- head would be answering a question the player never asked.\n	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff\n\n	visitorPositions[visitor] = { id = member.id, position = root.Position }\n\n	-- Set before parenting, so no rig is ever briefly able to shove the one it is\n	-- queueing behind. One frame of that is enough to break a line.\n	if ensureCollisionGroup() then\n		for _, part in visitor:GetDescendants() do\n			if part:IsA(\"BasePart\") then\n				part.CollisionGroup = VISITOR_COLLISION_GROUP\n			end\n		end\n	end\n\n	-- Placed before parenting so the visitor is never briefly at the origin.\n	visitor:PivotTo(at)\n	visitor.Parent = visitorsFolder()\n	active[visitor] = true\n\n	local animator = humanoid:FindFirstChildOfClass(\"Animator\")\n	if animator == nil then\n		animator = Instance.new(\"Animator\")\n		animator.Parent = humanoid\n	end\n	local animationIds = Config.Assets.Animations\n	local idleTrack = loadTrack(animator :: Animator, animationIds.NPCIdle, true, Enum.AnimationPriority.Idle)\n	local walkTrack = loadTrack(animator :: Animator, animationIds.NPCWalk, true, Enum.AnimationPriority.Movement)\n	local greetTrack = loadTrack(animator :: Animator, animationIds.NPCGreet, false, Enum.AnimationPriority.Action)\n	local talkTrack = loadTrack(animator :: Animator, animationIds.NPCTalk, false, Enum.AnimationPriority.Action)\n\n	if idleTrack ~= nil then\n		idleTrack:Play(ANIMATION_FADE_SECONDS)\n	end\n\n	-- Locomotion is driven off the humanoid's own reported speed rather than off\n	-- our walk calls, so the clips stay right even when movement ends in a way\n	-- this service did not ask for -- a timeout, a shove, a stall on geometry.\n	local runningConnection = humanoid.Running:Connect(function(speed: number)\n		local moving = speed > MOVING_SPEED_THRESHOLD\n		if walkTrack ~= nil then\n			if moving and not walkTrack.IsPlaying then\n				walkTrack:Play(ANIMATION_FADE_SECONDS)\n			elseif not moving and walkTrack.IsPlaying then\n				walkTrack:Stop(ANIMATION_FADE_SECONDS)\n			end\n		end\n		if idleTrack ~= nil then\n			if not moving and not idleTrack.IsPlaying then\n				idleTrack:Play(ANIMATION_FADE_SECONDS)\n			end\n		end\n	end)\n\n	local head = visitor:FindFirstChild(\"Head\") :: BasePart?\n	local upperTorso = visitor:FindFirstChild(\"UpperTorso\") :: BasePart?\n	local neck = if head ~= nil then head:FindFirstChild(\"Neck\") :: Motor6D? else nil\n\n	local looking = true\n	if neck ~= nil and head ~= nil and upperTorso ~= nil then\n		local restC0 = neck.C0\n		task.spawn(function()\n			local yaw, pitch = 0, 0\n			while looking and visitor.Parent ~= nil do\n				local character = player.Character\n				local targetHead = if character ~= nil then character:FindFirstChild(\"Head\") :: BasePart? else nil\n				yaw, pitch = aimNeck(\n					neck :: Motor6D,\n					restC0,\n					upperTorso :: BasePart,\n					head :: BasePart,\n					if targetHead ~= nil then targetHead.Position else nil,\n					yaw,\n					pitch\n				)\n				task.wait(Config.NPC.LookTickSeconds)\n			end\n		end)\n	end\n\n	-- Copied out of the optionals above so the closures below close over plain\n	-- values. A refinement made here does not survive into a function body that runs\n	-- later, and every one of these is read from inside one.\n	local body = root :: BasePart\n	local walker = humanoid :: Humanoid\n\n	local function gone(): boolean\n		return visitor.Parent == nil or walker.Parent == nil\n	end\n\n	local function play(track: AnimationTrack?)\n		if track == nil or gone() then\n			return\n		end\n		track:Play(ANIMATION_FADE_SECONDS)\n	end\n\n	-- Where they are being held looking, and whether the loop doing the holding is\n	-- already running. One loop per rig at most: `face` is called again on every tick\n	-- of an open conversation so the turn tracks a player who walks around them, and\n	-- spawning a fresh loop each time would stack a dozen of them fighting over the\n	-- same root part within a few seconds.\n	local facing: Vector3? = nil\n	local turning = false\n\n	local function stepFacing()\n		while facing ~= nil and not gone() do\n			local target = facing :: Vector3\n			local flat = Vector3.new(target.X - body.Position.X, 0, target.Z - body.Position.Z)\n			if flat.Magnitude > FLAT_FACING_EPSILON then\n				local want = CFrame.lookAt(body.Position, body.Position + flat.Unit)\n				-- Slerped through CFrame:Lerp rather than by stepping a yaw angle,\n				-- because a yaw has a seam at +/-pi and a person turning the long way\n				-- round to greet somebody standing just behind them is a spin.\n				local stepped = body.CFrame:Lerp(want, Config.NPC.TurnResponsiveness)\n				body.CFrame = CFrame.lookAt(body.Position, body.Position + stepped.LookVector)\n\n				local left = math.deg(math.acos(math.clamp(body.CFrame.LookVector:Dot(want.LookVector), -1, 1)))\n				if left <= Config.NPC.TurnDoneDegrees then\n					-- Squared up. The hold stays -- AutoRotate is still off and the\n					-- target is still set -- so this only stops the arithmetic, which\n					-- would otherwise nudge forever without ever quite arriving.\n					body.CFrame = want\n					break\n				end\n			end\n			task.wait(Config.NPC.TurnTickSeconds)\n		end\n		turning = false\n	end\n\n	local function face(target: Vector3?)\n		if gone() then\n			return\n		end\n		facing = target\n		if target == nil then\n			-- Steering handed back. Without this a walker keeps whatever angle it was\n			-- held at and moons sideways down the street.\n			walker.AutoRotate = true\n			return\n		end\n		-- Off while held, because AutoRotate is the humanoid writing this same CFrame\n		-- from its own velocity, and the two take turns rather than settling.\n		walker.AutoRotate = false\n		if not turning then\n			turning = true\n			task.spawn(stepFacing)\n		end\n	end\n\n	return {\n		model = visitor,\n		root = body,\n		at = function()\n			return body.Position\n		end,\n		gone = gone,\n		moveTo = function(position: Vector3)\n			if gone() then\n				return\n			end\n			-- Any walk lets go of a held angle first. A body cannot be steering itself\n			-- and being held square to somebody at the same time, and the failure when\n			-- both are true is a rig sliding down the street sideways.\n			face(nil)\n			walker:MoveTo(position)\n		end,\n		halt = function()\n			if gone() then\n				return\n			end\n			-- Told to walk to where they already are, which is how a humanoid is\n			-- stopped without freezing it: it settles on the spot and the locomotion\n			-- clips follow its own reported speed back down to idle.\n			walker:MoveTo(body.Position)\n		end,\n		walkTo = function(position: Vector3): boolean\n			if gone() then\n				return false\n			end\n			face(nil)\n			return walkTo(walker, position, Config.NPC.WalkTimeoutSeconds)\n		end,\n		pathTo = function(position: Vector3, shouldStop: (() -> boolean)?): boolean\n			if gone() then\n				return false\n			end\n			face(nil)\n			return pathTo(walker, body, position, shouldStop)\n		end,\n		face = face,\n		setSpeed = function(studsPerSecond: number)\n			if gone() then\n				return\n			end\n			walker.WalkSpeed = studsPerSecond\n		end,\n		setAge = function(years: number?)\n			if gone() then\n				return\n			end\n			applyScale(walker, member, years)\n		end,\n		greet = function()\n			play(greetTrack)\n		end,\n		talk = function()\n			play(talkTrack)\n		end,\n		destroy = function()\n			looking = false\n			facing = nil\n			runningConnection:Disconnect()\n			active[visitor] = nil\n			visitorPositions[visitor] = nil\n			visitor:Destroy()\n		end,\n	}\nend\n\n-- A visitor for an event: in from the doorstep, waiting to be reached, and away\n-- again once they have been.\n--\n-- Thin on purpose. Everything about being a person is Spawn's, and everything here\n-- is about this particular errand -- which door, how far in, and what \"dismissed\"\n-- means to a delivery. The whole file used to be this function, and splitting it is\n-- what lets a parent bring pocket money without a LifeEvent or a delivery point\n-- existing to justify her.\nfunction NPCService.Arrive(player: Player, point: BasePart, event: LifeEvent): DeliveryPresentation?\n	local visitor = NPCService.Spawn(player, resolveMember(event), point.CFrame)\n	if visitor == nil then\n		return nil\n	end\n	local arriving = visitor :: Visitor\n\n	local arrivalPosition = point.Position\n	-- The waiting spot is straight in from the door along the point's own facing,\n	-- so where a visitor ends up is set in Studio by turning the marker rather\n	-- than by a number in here.\n	local waitPosition = (point.CFrame * CFrame.new(0, 0, -Config.NPC.ApproachStuds)).Position\n\n	local dismissed = false\n\n	task.spawn(function()\n		arriving.walkTo(waitPosition)\n		if dismissed then\n			return\n		end\n		arriving.greet()\n	end)\n\n	return {\n		anchor = arriving.root,\n		dismiss = function(collected: boolean)\n			if dismissed then\n				return\n			end\n			dismissed = true\n\n			task.spawn(function()\n				if collected then\n					-- Talk over the prompt the player is now reading, then leave.\n					-- Vanishing the instant they are reached would undo the whole\n					-- reason they walked in.\n					arriving.talk()\n					task.wait(Config.NPC.TalkBeatSeconds)\n				end\n\n				arriving.walkTo(arrivalPosition)\n				arriving.destroy()\n			end)\n		end,\n	}\nend\n\n-- Removes every visitor currently standing around. Used at server start, where\n-- a Rojo sync mid-session can otherwise leave rigs behind with nothing left\n-- holding a reference to them.\nfunction NPCService.DespawnAll()\n	for visitor in active do\n		active[visitor] = nil\n		visitorPositions[visitor] = nil\n		visitor:Destroy()\n	end\n\n	local folder = workspace:FindFirstChild(VISITORS_FOLDER)\n	if folder ~= nil then\n		folder:ClearAllChildren()\n	end\nend\n\n-- Asked for at start rather than at the first spawn, so a server that cannot have it\n-- says so in the log while somebody is still reading the log, instead of half an hour\n-- later in the shape of a queue that will not stand still.\nfunction NPCService:Init()\n	ensureCollisionGroup()\nend\n\nfunction NPCService:Start()\n	NPCService.DespawnAll()\nend\n\n-- Returns the cast id and current position of every active visitor, so\n-- EventService can build context tags from who is standing near the player.\n-- The list is rebuilt on every call from the live table, so it is always current.\nfunction NPCService.GetPositions(): { { id: string, position: Vector3 } }\n	local result: { { id: string, position: Vector3 } } = {}\n	for model, info in visitorPositions do\n		if info ~= nil then\n			table.insert(result, { id = info.id, position = info.position })\n		end\n	end\n	return result\nend\n\nreturn NPCService\n"
table.insert(AGES_MANIFEST, "src/server/services/NPCService.luau")
AGES_SOURCES["src/server/services/PEService.luau"] = "--!strict\n-- PE: the graded sports drill, and the join between school and sports.\n--\n-- Every other subject on the timetable pays smarts into academics. This one pays **health\n-- into athletics**, and that is the whole reason it is a subject rather than an activity.\n-- `docs/school_and_sports.md`: *\"PE -- a graded sports drill. Do not build a separate PE\n-- minigame; this is the join between the two systems and it is what makes school carry the\n-- childhood years.\"*\n--\n-- **The verb is the golf three-click meter**, ranked first of twelve input primitives in that\n-- document: *\"Zero RNG, every input owns one variable. The most reusable meter in all of\n-- gaming, and the overswing zone is free risk/reward.\"*\n--\n--   click 1   starts the power marker sweeping\n--   click 2   locks power. Past the overswing line you get more power *and* a faster\n--             accuracy sweep -- you buy the risk, you do not roll for it\n--   click 3   locks accuracy against a centre window\n--\n-- Deliberately a different problem from the gym's single timing window, which is the rule\n-- the gym's own four machines follow: what separates two minigames is the shape of the\n-- question, not its difficulty. The gym asks whether you can hit a moving target. This asks\n-- how much harder you are willing to make that for yourself.\n--\n-- **Two rules taken from the spec on purpose, both named there:**\n--\n-- 1. *\"Missing it falls back to your ratings rather than failing outright. The kindest\n--    failure design in sports games. Steal this rule specifically.\"* A missed accuracy click\n--    scores a floor that scales with health, so one bad click is never a zero.\n-- 2. *\"Difficulty is a rising threshold on the same minigame.\"* Level 5 is not a new drill --\n--    it is this drill wanting more of it. The pass mark rises; the meter does not change.\n--\n-- The click carries a value rather than a moment, for the reason MusicService's hit carries\n-- an offset: the marker is drawn on the client, and a server that recomputed position from\n-- arrival time would grade a bar the player never saw and punish ping instead of timing.\n-- Unlike music, though, the claim is *bounded* -- the server keeps its own marker and refuses\n-- a value that could not have come from the bar in front of the player. See onClickRequested.\n\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Config = require(ReplicatedStorage:WaitForChild(\"Config\"))\nlocal Lives = require(ReplicatedStorage:WaitForChild(\"Lives\"))\nlocal Remotes = require(ReplicatedStorage:WaitForChild(\"Remotes\"))\nlocal Types = require(ReplicatedStorage:WaitForChild(\"Types\"))\nlocal Mastery = require(ReplicatedStorage:WaitForChild(\"school\"):WaitForChild(\"Mastery\"))\nlocal Report = require(ReplicatedStorage:WaitForChild(\"school\"):WaitForChild(\"Report\"))\n\nlocal DataService = require(script.Parent.DataService)\nlocal EventService = require(script.Parent.EventService)\nlocal PlaceService = require(script.Parent.PlaceService)\nlocal SkillService = require(script.Parent.SkillService)\nlocal StatService = require(script.Parent.StatService)\nlocal School = require(script.Parent.Parent.world.School)\n\ntype LifeData = Types.LifeData\ntype PEState = Types.PEState\n\nlocal PEService = {}\n\nlocal PEUpdatedRemote = Remotes.Get(\"PEUpdated\")\nlocal RequestPEClickRemote = Remotes.Get(\"RequestPEClick\")\n\nlocal PE = Config.School.PE\nlocal SUBJECT_ID = \"pe\"\nlocal PLACE_ID = \"school\"\n\ntype Drill = {\n	id: string,\n	label: string,\n	line: string,\n	powerScale: number,\n	accuracyScale: number,\n	windowScale: number,\n}\n\ntype Session = {\n	drill: Drill,\n	attempt: number,\n	phase: string,\n	sweepStartedAt: number,\n	sweepSeconds: number,\n	power: number,\n	overswung: boolean,\n	scored: number,\n	bestAttempt: number,\n	goodFraction: number,\n	perfectFraction: number,\n	passShare: number,\n	endsAt: number,\n	levelAtStart: number,\n	atField: boolean,\n	line: string,\n	lastLine: string,\n}\n\nlocal sessions: { [Player]: Session } = {}\nlocal notices: { [Player]: { text: string, until_: number } } = {}\nlocal pushed: { [Player]: string } = {}\nlocal enabled = true\nlocal roomBuilt = false\n\n-- Which drill comes round next. Advanced per lesson rather than rolled, so a year of PE is\n-- all three rather than the same one three times by chance.\nlocal drillCursor = 0\n\nlocal function characterPosition(player: Player): Vector3?\n	local character = player.Character\n	if character == nil then\n		return nil\n	end\n	local root = character:FindFirstChild(\"HumanoidRootPart\") :: BasePart?\n	if root == nil then\n		return nil\n	end\n	return root.Position\nend\n\nlocal function levelOf(data: LifeData): number\n	return Mastery.LevelOf(data, SUBJECT_ID)\nend\n\nlocal function notice(player: Player, text: string)\n	notices[player] = { text = text, until_ = os.clock() + Config.UI.NoticeSeconds }\nend\n\n-- PE happens on the school track, and falls back to the gymnasium indoors.\n--\n-- No ground of its own is built. The school already lays a track with an infield, which is\n-- where penalties and free kicks belong; the gym is the wet-weather answer behind it. A pitch\n-- drawn on top of either would be two places occupying one lesson -- the same reasoning the\n-- art and music rooms use when they decline to draw a classroom over a room that exists.\n--\n-- Falls all the way back to the school door rather than refusing, because a drill at the\n-- gates is still a drill, and a PE class that could not run because one anchor was missing\n-- would be the subject silently absent from the timetable.\nlocal function ensureRoom(): Vector3?\n	local place = PlaceService.Find(PLACE_ID)\n	if place == nil then\n		return nil\n	end\n	if not roomBuilt then\n		roomBuilt = true\n		School.Build(place.part.Position)\n	end\n	return School.RoomAt(\"track\") or School.RoomAt(\"gym\") or place.part.Position\nend\n\n-- Health as a share of its maximum, which is what widens the windows and lifts the miss\n-- floor. Read from the life rather than the character: this is fitness, not current damage.\nlocal function fitnessOf(data: LifeData): number\n	local max = Config.Stats.Max\n	if max <= 0 then\n		return 0\n	end\n	return math.clamp(data.stats.health / max, 0, 1)\nend\n\n-- The marker, as a share of the bar, at a given point in a sweep.\n--\n-- A triangle wave rather than a saw: the marker runs to the end and comes back, so missing a\n-- click costs you the return trip rather than silently restarting the bar under your hand.\n-- Both the server and the client compute this, from the same start time, which is what makes\n-- the bound in onClickRequested meaningful.\nlocal function markerAt(elapsed: number, sweepSeconds: number): number\n	if sweepSeconds <= 0 then\n		return 0\n	end\n	local phase = (elapsed / sweepSeconds) % 2\n	return if phase <= 1 then phase else 2 - phase\nend\n\n-- The accuracy bands for a session, as (goodFrom, goodTo, perfectFrom, perfectTo). Centred\n-- on the bar, and widened by fitness.\nlocal function bandsOf(session: Session): (number, number, number, number)\n	local good = session.goodFraction\n	local perfect = session.perfectFraction\n	return 0.5 - good / 2, 0.5 + good / 2, 0.5 - perfect / 2, 0.5 + perfect / 2\nend\n\nlocal function stateFor(player: Player): PEState\n	local session = sessions[player]\n	if session == nil then\n		local held = notices[player]\n		local line = \"\"\n		if held ~= nil and os.clock() < held.until_ then\n			line = held.text\n		else\n			notices[player] = nil\n		end\n		return {\n			active = false,\n			line = line,\n			drill = \"\",\n			attempt = 0,\n			attempts = PE.Attempts,\n			phase = \"power\",\n			sweepStartedAt = 0,\n			sweepSeconds = 0,\n			overswingFrom = PE.OverswingFrom,\n			perfectFrom = 0,\n			perfectTo = 0,\n			goodFrom = 0,\n			goodTo = 0,\n			power = 0,\n			scored = 0,\n			bestAttempt = 0,\n			lastLine = \"\",\n			passShare = 0,\n			secondsLeft = 0,\n			masteryLevel = 1,\n			atField = false,\n		}\n	end\n\n	local goodFrom, goodTo, perfectFrom, perfectTo = bandsOf(session)\n\n	return {\n		active = true,\n		line = session.line,\n		drill = session.drill.label,\n		attempt = session.attempt,\n		attempts = PE.Attempts,\n		phase = session.phase,\n		sweepStartedAt = session.sweepStartedAt,\n		sweepSeconds = session.sweepSeconds,\n		overswingFrom = PE.OverswingFrom,\n		perfectFrom = perfectFrom,\n		perfectTo = perfectTo,\n		goodFrom = goodFrom,\n		goodTo = goodTo,\n		power = session.power,\n		scored = session.scored,\n		bestAttempt = session.bestAttempt,\n		lastLine = session.lastLine,\n		passShare = session.passShare,\n		secondsLeft = math.max(session.endsAt - os.clock(), 0),\n		masteryLevel = session.levelAtStart,\n		atField = session.atField,\n	}\nend\n\nlocal function push(player: Player)\n	local state = stateFor(player)\n	-- The sweep start is in the signature deliberately: it changes on every click and it is\n	-- the one number the client cannot infer, so a push that dropped it would leave the\n	-- marker running from the previous phase's clock.\n	local signature = `{state.active}|{state.line}|{state.lastLine}|{state.phase}|{state.attempt}`\n		.. `|{state.sweepStartedAt}|{state.power}|{state.scored}|{state.atField}`\n		.. `|{math.floor(state.secondsLeft)}`\n	if pushed[player] == signature then\n		return\n	end\n	pushed[player] = signature\n	PEUpdatedRemote:FireClient(player, state)\nend\n\n-- Opens the next attempt, or nil if the drill is done.\nlocal function startAttempt(session: Session)\n	session.attempt += 1\n	session.phase = \"power\"\n	session.power = 0\n	session.overswung = false\n	session.sweepSeconds = PE.PowerSweepSeconds * session.drill.powerScale\n	session.sweepStartedAt = os.clock()\nend\n\nlocal function finish(player: Player, data: LifeData, session: Session, reason: string)\n	-- Worked out before anything is written, then recorded -- the order every other subject\n	-- uses, and the reason a walk-out grades what was actually done rather than zero.\n	local share = math.clamp(session.scored / PE.Attempts, 0, 1)\n	local band = Report.BandFor(share)\n	local gained = Report.SmartsFor(band)\n\n	sessions[player] = nil\n\n	-- **Health, not smarts.** This is the line that makes PE the join rather than a lesson in\n	-- a tracksuit, and it is the only place in the school tree that awards it.\n	if gained ~= 0 then\n		StatService.AddStat(player, \"health\", gained)\n	end\n\n	Mastery.Record(data, SUBJECT_ID, share)\n\n	local earned = math.floor(Config.Skills.Awards.DrillCleared * share)\n	if earned > 0 then\n		SkillService.Award(player, \"athletics\", earned, \"drilled\")\n	end\n\n	data.lessonsThisYear += 1\n	EventService.AwardAutonomy(player, 1)\n\n	local level = levelOf(data)\n	Report.RecordLesson(data, SUBJECT_ID, band, gained, if level > session.levelAtStart then level else nil)\n\n	local percent = math.floor(share * 100 + 0.5)\n	local passed = share >= session.passShare\n	local opening = if reason == \"drilled\"\n		then (if passed then \"That will do.\" else \"Not enough of them found the net.\")\n		elseif reason == \"left\" then \"You walked off the pitch.\"\n		else \"Whistle.\"\n	local reward = if gained > 0 then `. +{gained} health.` else \".\"\n	notice(player, `{opening} {percent}%, best strike {math.floor(session.bestAttempt * 100 + 0.5)}%{reward}`)\n	push(player)\nend\n\n-- One click of the meter. Everything about it is checked, because the value came from the\n-- client -- see the note at the top of the file about why it has to.\nlocal function onClickRequested(player: Player, value: unknown)\n	local session = sessions[player]\n	if session == nil then\n		return\n	end\n	if typeof(value) ~= \"number\" or value ~= value then\n		return\n	end\n	local claimed = value :: number\n	if claimed < 0 or claimed > 1 then\n		return\n	end\n\n	-- The bound on a client-sent value. The server keeps its own marker from the same start\n	-- time, and a claim that could not have come from the bar in front of the player is\n	-- **dropped rather than scored as a miss** -- punishing a lag spike with a failed attempt\n	-- is how a fair rule becomes the one players hate.\n	local mine = markerAt(os.clock() - session.sweepStartedAt, session.sweepSeconds)\n	if math.abs(claimed - mine) > PE.ClickTolerance then\n		return\n	end\n\n	if session.phase == \"power\" then\n		session.power = claimed\n		session.overswung = claimed >= PE.OverswingFrom\n		session.phase = \"accuracy\"\n		session.sweepSeconds = PE.AccuracySweepSeconds * session.drill.accuracyScale\n		if session.overswung then\n			session.sweepSeconds /= PE.OverswingSpeedup\n		end\n		session.sweepStartedAt = os.clock()\n		session.line = if session.overswung\n			then \"Big swing. Now place it, and quickly.\"\n			else \"Now place it.\"\n		push(player)\n		return\n	end\n\n	-- Accuracy: the third click, which is where the attempt is scored.\n	local goodFrom, goodTo, perfectFrom, perfectTo = bandsOf(session)\n	local scoredThis: number\n	local said: string\n\n	if claimed >= perfectFrom and claimed <= perfectTo then\n		scoredThis = session.power * PE.PerfectMultiplier\n		said = \"Top corner.\"\n	elseif claimed >= goodFrom and claimed <= goodTo then\n		scoredThis = session.power * PE.GoodMultiplier\n		said = \"On target.\"\n	else\n		-- The kind failure. Falls back to the character's own fitness rather than to nothing.\n		local profile = DataService.GetProfile(player)\n		local fitness = if profile ~= nil then fitnessOf(Lives.Active(profile.Data)) else 0\n		local floor = PE.MissFloor + (PE.MissFloorFit - PE.MissFloor) * fitness\n		scoredThis = session.power * floor\n		said = if fitness >= 0.6 then \"Wide, but you got something on it.\" else \"Wide.\"\n	end\n\n	session.scored += scoredThis\n	if scoredThis > session.bestAttempt then\n		session.bestAttempt = scoredThis\n	end\n	session.lastLine = `{said} {math.floor(scoredThis * 100 + 0.5)}%`\n\n	local profile = DataService.GetProfile(player)\n	if session.attempt >= PE.Attempts then\n		if profile ~= nil then\n			finish(player, Lives.Active(profile.Data), session, \"drilled\")\n		else\n			sessions[player] = nil\n			push(player)\n		end\n		return\n	end\n\n	startAttempt(session)\n	session.line = session.drill.line\n	push(player)\nend\n\nlocal function tickPlayer(player: Player, _dt: number)\n	local session = sessions[player]\n	if session == nil then\n		push(player)\n		return\n	end\n\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return\n	end\n	local data = Lives.Active(profile.Data)\n\n	-- Walking off ends the class and grades what was done, which is the rule every subject\n	-- shares. The radius is generous because the field is a running track: a drill you could\n	-- fail by stepping backwards is a drill nobody would stand still for.\n	local field = ensureRoom()\n	local here = characterPosition(player)\n	if field ~= nil and here ~= nil then\n		local near = (here - field).Magnitude <= PE.ReachStuds\n		if near ~= session.atField then\n			session.atField = near\n		end\n		if not near then\n			finish(player, data, session, \"left\")\n			return\n		end\n	end\n\n	if os.clock() >= session.endsAt then\n		finish(player, data, session, \"time\")\n		return\n	end\n\n	push(player)\nend\n\nfunction PEService.Begin(player: Player, data: LifeData): (boolean, string?)\n	if sessions[player] ~= nil then\n		return false, \"You are already out on the field.\"\n	end\n	if not enabled then\n		return false, \"There is no PE today.\"\n	end\n	if ensureRoom() == nil then\n		return false, \"The gym is closed today.\"\n	end\n\n	local drills = PE.Drills :: { Drill }\n	if #drills == 0 then\n		return false, \"There is nothing set out today.\"\n	end\n	drillCursor = (drillCursor % #drills) + 1\n	local drill = drills[drillCursor]\n\n	local level = levelOf(data)\n	local fitness = fitnessOf(data)\n	-- Fitness widens the window; the drill scales it; mastery does not touch it. That split\n	-- is the point: what you *earn* is a wider target, what the drill sets is how hard the\n	-- shot is, and what mastery sets is how many of them you need. Three different levers,\n	-- none of them the same number.\n	local widen = 1 + PE.HealthWindowBonus * fitness\n\n	local session: Session = {\n		drill = drill,\n		attempt = 0,\n		phase = \"power\",\n		sweepStartedAt = os.clock(),\n		sweepSeconds = PE.PowerSweepSeconds * drill.powerScale,\n		power = 0,\n		overswung = false,\n		scored = 0,\n		bestAttempt = 0,\n		goodFraction = PE.GoodFraction * drill.windowScale * widen,\n		perfectFraction = PE.PerfectFraction * drill.windowScale * widen,\n		passShare = math.clamp(PE.PassShare + PE.PassSharePerLevel * (level - 1), 0, 1),\n		endsAt = os.clock() + PE.TimeoutSeconds,\n		levelAtStart = level,\n		atField = true,\n		line = drill.line,\n		lastLine = \"\",\n	}\n	startAttempt(session)\n\n	sessions[player] = session\n	notices[player] = nil\n	push(player)\n	return true\nend\n\nlocal function forget(player: Player)\n	sessions[player] = nil\n	notices[player] = nil\n	pushed[player] = nil\nend\n\nfunction PEService.ResetForNewLife(player: Player)\n	forget(player)\n	push(player)\nend\n\nfunction PEService.ForceStart(player: Player): (boolean, string?)\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return false, \"no profile loaded yet\"\n	end\n	return PEService.Begin(player, Lives.Active(profile.Data))\nend\n\nfunction PEService.ForceEnd(player: Player): boolean\n	local session = sessions[player]\n	if session == nil then\n		return false\n	end\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		sessions[player] = nil\n		push(player)\n		return true\n	end\n	finish(player, Lives.Active(profile.Data), session, \"time\")\n	return true\nend\n\n-- Plays a drill out to a given grade, for testing the report path without six clean clicks.\nfunction PEService.Autoplay(player: Player, grade: string): (boolean, string?)\n	local session = sessions[player]\n	if session == nil then\n		return false, \"no drill running\"\n	end\n	local share = if grade == \"perfect\" then 1 elseif grade == \"good\" then 0.72 elseif grade == \"poor\" then 0.2 else -1\n	if share < 0 then\n		return false, \"grade must be perfect, good or poor\"\n	end\n	session.scored = PE.Attempts * share\n	session.bestAttempt = share\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return false, \"no profile loaded yet\"\n	end\n	finish(player, Lives.Active(profile.Data), session, \"drilled\")\n	return true\nend\n\nfunction PEService.SetEnabled(value: boolean)\n	enabled = value\nend\n\nfunction PEService.IsEnabled(): boolean\n	return enabled\nend\n\nfunction PEService.Describe(player: Player): string\n	local lines = {}\n	table.insert(lines, `PE: {if enabled then \"on\" else \"off\"}`)\n\n	local field = ensureRoom()\n	table.insert(lines, `field: {if field ~= nil then \"found\" else \"no school place point\"}`)\n\n	local profile = DataService.GetProfile(player)\n	if profile ~= nil then\n		local data = Lives.Active(profile.Data)\n		local level = levelOf(data)\n		table.insert(lines, `mastery level {level}, fitness {math.floor(fitnessOf(data) * 100 + 0.5)}%`)\n		table.insert(lines, `pass mark {math.floor((PE.PassShare + PE.PassSharePerLevel * (level - 1)) * 100 + 0.5)}%`)\n	end\n\n	local session = sessions[player]\n	if session == nil then\n		table.insert(lines, \"no drill running\")\n	else\n		local share = session.scored / PE.Attempts\n		table.insert(\n			lines,\n			`{session.drill.label}: attempt {session.attempt}/{PE.Attempts}, `\n				.. `{session.phase}, scored {math.floor(share * 100 + 0.5)}%`\n		)\n	end\n\n	return table.concat(lines, \"\\n\")\nend\n\nfunction PEService:Start()\n	Players.PlayerAdded:Connect(function(player: Player)\n		task.spawn(function()\n			if DataService.WaitForProfile(player) ~= nil then\n				push(player)\n			end\n		end)\n	end)\n\n	Players.PlayerRemoving:Connect(function(player: Player)\n		forget(player)\n	end)\n\n	RequestPEClickRemote.OnServerEvent:Connect(function(player: Player, value: unknown)\n		local ok, err = pcall(onClickRequested, player, value)\n		if not ok then\n			warn(`[AGES] PE click failed for {player.Name}: {err}`)\n		end\n	end)\n\n	task.spawn(function()\n		while true do\n			local elapsed = task.wait(PE.TickSeconds)\n			for _, player in Players:GetPlayers() do\n				local ok, err = pcall(tickPlayer, player, elapsed)\n				if not ok then\n					warn(`[AGES] PE tick failed for {player.Name}: {err}`)\n				end\n			end\n		end\n	end)\nend\n\nreturn PEService\n"
table.insert(AGES_MANIFEST, "src/server/services/PEService.luau")
AGES_SOURCES["src/server/services/PeopleService.luau"] = "--!strict\n-- The people in your life, standing where they live.\n--\n-- Everybody in AGES up to now was a delivery. They walked in through a door, did one\n-- thing, walked out, and were forgotten -- and that is *why* the quiet stretches of a\n-- life were quiet, because there was nobody to go and see. A world with a shop and a\n-- school and a job in it still had no reason to walk anywhere that was not one of the\n-- three. This is the fourth reason.\n--\n-- The loop, and it is the smallest one in the game on purpose:\n--\n--   You walk up to somebody. Three dots over their head wake up. You click them, and\n--   what you could do with them comes up. You pick one. They say something back.\n--\n-- What makes it a system rather than a menu is that the list changes. Every person keeps\n-- a bond -- how they feel about you -- and an offer states the bond it needs before it\n-- appears at all. So what somebody who barely knows you has to offer is small talk, and\n-- what somebody who does has to offer is money, comfort and favours. The player is never\n-- shown the number. They watch the list get more generous.\n--\n-- Three rules hold it up, and dropping any one of them turns it back into a menu:\n--\n--   It decays.        A year you did not visit costs you. Without that, visiting is pure\n--                     upside, the right play is one lap and never again, and a\n--                     relationship becomes a collectible.\n--   It is capped.     Config.People.VisitsPerYear each, currently one. Without a cap the\n--                     right play is a lap of everybody, every year, forever -- a commute\n--                     rather than a choice.\n--   It pays out.      Into pocket money, into a job reference, into smarts. A bond that\n--                     only bought more bond would be a score.\n--\n-- These are *your* family, so they are spawned per player rather than shared. That is a\n-- real cost in a full server -- two players at home means two mothers -- and it is the\n-- right trade anyway: a person's age window and their bond are both read off one\n-- profile, and a single shared rig would have to be a compromise between two lives at\n-- once. The same call DeliveryService already makes about visitors, for the same reason.\n--\n-- Since the town arrived this file also stands about thirty strangers, and they are the\n-- same Person shape going through the same loop -- bond, decay, the once-a-year cap, the\n-- offer fan, the odds on an ask. Nothing about a conversation knows the difference.\n--\n-- Two things do, and both are about cost rather than about who anybody is:\n--\n--   Presence   A townsperson is only given a body while the player is within\n--              Config.Town.PresenceStuds of the place they live at, and there is a hard\n--              ceiling on how many wear one at once. Building a rig is a yielding web\n--              call; thirty at once is a stall on arrival and there is no version of it\n--              that is not. Away from you they are a row in a table, which is all a\n--              stranger across town has ever been.\n--   The ring   They stand on a wider one. Your mother is in the room; the people at the\n--              shop are around the shop, and there have to be room for a dozen of them.\n--\n-- Your family is never streamed. A house that emptied out when you walked to the far end\n-- of it would be a worse bug than any number of rigs.\n--\n-- One more difference, and this one is not about cost: the town walks. A townsperson gets\n-- a Roam, which wanders them around the place they belong to and stands them still in\n-- between; the family does not, because your mother is in the kitchen because that is\n-- where she is. Walking up to anybody stops them and turns them to face you, and walking\n-- away lets them go -- see `holdFor` and `release`, which are the whole of it.\n\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Config = require(ReplicatedStorage:WaitForChild(\"Config\"))\nlocal Remotes = require(ReplicatedStorage:WaitForChild(\"Remotes\"))\nlocal Types = require(ReplicatedStorage:WaitForChild(\"Types\"))\nlocal Interact = require(ReplicatedStorage:WaitForChild(\"world\"):WaitForChild(\"Interact\"))\nlocal Lives = require(ReplicatedStorage:WaitForChild(\"Lives\"))\n\nlocal CompanionService = require(script.Parent.CompanionService)\nlocal DataService = require(script.Parent.DataService)\nlocal EventService = require(script.Parent.EventService)\nlocal MoneyService = require(script.Parent.MoneyService)\nlocal NPCService = require(script.Parent.NPCService)\nlocal PlaceService = require(script.Parent.PlaceService)\nlocal StatService = require(script.Parent.StatService)\nlocal Cast = require(script.Parent.Parent.content.Cast)\nlocal People = require(script.Parent.Parent.content.People)\nlocal Ties = require(script.Parent.Parent.content.Ties)\nlocal Ground = require(script.Parent.Parent.world.Ground)\nlocal Roam = require(script.Parent.Parent.world.Roam)\nlocal Routes = require(script.Parent.Parent.world.Routes)\nlocal GossipService = require(script.Parent.GossipService)\n\ntype LifeData = Types.LifeData\ntype CastMember = Types.CastMember\ntype Person = Types.Person\ntype PersonOffer = Types.PersonOffer\ntype PersonState = Types.PersonState\ntype StatName = Types.StatName\ntype Gender = Types.Gender\ntype OfferedChoice = Types.OfferedChoice\ntype PersonRosterEntry = Types.PersonRosterEntry\ntype Visitor = NPCService.Visitor\n\nlocal PeopleService = {}\n\nlocal PersonUpdatedRemote = Remotes.Get(\"PersonUpdated\")\nlocal RequestPersonOfferRemote = Remotes.Get(\"RequestPersonOffer\")\nlocal PeopleRosterUpdatedRemote = Remotes.Get(\"PeopleRosterUpdated\")\nlocal RequestPersonContactRemote = Remotes.Get(\"RequestPersonContact\")\nlocal NoticeRemote = Remotes.Get(\"Notice\")\nlocal BOND_MILESTONE = Remotes.Get(\"BondMilestone\")\n\nlocal PEOPLE = Config.People\nlocal TOWN = Config.Town\n\n-- Two people are never set down nearer than this to each other. Not a design tunable:\n-- it is the nominal body's width, so the ring is spaced by what a body is rather than\n-- by a number that could be tuned under the fact.\nlocal MIN_APART = Config.NPC.BodyRadius * 2\n\n-- A rig's pivot sits at its root part rather than at its feet, so a spot on the floor\n-- has to be lifted by roughly half a body before anyone is placed there. They are\n-- unanchored and settle the rest of the way themselves; the lift only stops them being\n-- spawned with their shins through the pavement.\nlocal SPAWN_LIFT = Config.NPC.BodyHeight / 2\n\n-- Somebody currently standing in the world for one player.\ntype Standing = {\n	person: Person,\n	visitor: Visitor,\n	-- The three dots over their head. Optional only because attaching them can fail on\n	-- a rig whose parts have not arrived yet; a person without them is a person you can\n	-- walk up to and not talk to, so that failure is warned about rather than absorbed.\n	dots: Interact.InteractHandle?,\n	-- Their wandering, and nil for the family. Not an oversight: your mother is in the\n	-- kitchen because that is where she is, and a parent who strolled off mid-sentence\n	-- would be a bug rather than a life. The town walks because the town is the street.\n	roam: Roam.Roam?,\n}\n\n-- Who is standing where, per player, keyed by person id.\nlocal standing: { [Player]: { [string]: Standing } } = {}\n\n-- A person who is mid-walk with a player. The walk is the one thing that gets to keep a\n-- townsperson's body beyond the street's reach -- you asked them to come along, and the\n-- despawn pass must not take them down for the same reason the player is still there. The\n-- lease is set before the walk starts and cleared when it ends, so the despawn pass reads\n-- it the same way it reads alive and gone.\nlocal leased: { [Player]: { [string]: boolean } } = {}\n\nlocal function isLeased(player: Player, personId: string): boolean\n	local mine = leased[player]\n	return mine ~= nil and mine[personId] == true\nend\n\n-- A townsperson with no body: where they are, where they are heading, and the wander that\n-- decides both.\n--\n-- **Everybody in the town has one of these the whole time they are in the player's life,\n-- bodied or not, and that is the entire point of the thing.** Before this, a person only\n-- existed while the player was near the building they belong to, so presence was keyed on\n-- the building -- which meant nobody could ever walk further from it than the range that\n-- built them, or they would walk out of existence. That is why the town read as thirty\n-- shop fittings. A position that is maintained whether or not anyone can see it costs a\n-- lerp per person per second and buys a town whose people can cross it.\n--\n-- The `wander` is the same table the rig's Roam is driving when they have a body, which is\n-- what makes the handoff free in both directions: a body is built at `at` and picks up the\n-- journey mid-stride, and when it is taken down the ghost carries on from where the legs\n-- had got to. Nobody teleports on either edge, which is the only reason this is worth more\n-- than raising the range.\ntype Ghost = {\n	at: Vector3,\n	-- Where they are walking, or nil while they are standing about. The bodiless half of\n	-- the rest that `Roam.Start` spends a `task.wait` on -- and the reason a town nobody\n	-- is looking at does not march.\n	goal: Vector3?,\n	restUntil: number,\n	wander: Roam.Wander,\n}\n\n-- Every townsperson's position, per player, keyed by person id. Per player rather than\n-- global because who is in the town at all depends on whose life it is: an archetype is in\n-- or out by the player's own age.\nlocal ghosts: { [Player]: { [string]: Ghost } } = {}\n\n-- Who could not be fitted at their place last time the roster was rebuilt, and why.\n-- Kept only so `/people` can answer the one question a missing mother raises, which is\n-- whether she was never written or simply had nowhere to stand.\nlocal unplaced: { [Player]: { [string]: string } } = {}\n\n-- Which places each player was last found to be near, as a sorted string. Compared\n-- rather than recomputed-and-acted-on, because the answer is the same on almost every\n-- check and a rebuild is the expensive thing on the other side of a change: walking\n-- across the shop should cost nothing, and walking *into* the shop should cost one pass.\nlocal presence: { [Player]: string } = {}\n\n-- The conversation in front of a player. Only ever one -- you are next to somebody or\n-- you are not.\ntype Chat = {\n	personId: string,\n	-- What is on the panel if the player clicks the dots. Held here as the authored\n	-- offers rather than as what the client was shown, because this is also the list an\n	-- answer coming back is checked against -- the client is told ids and labels, and\n	-- what an id is worth is only ever read from here.\n	offers: { PersonOffer },\n	-- Nothing further to take. Set by every way a conversation can end -- an offer taken,\n	-- a refusal at the door -- and it is what stops a second click paying out twice.\n	-- Cleared by walking away, which is the only thing that clears it.\n	done: boolean,\n	replyLeft: number,\n	replyText: string?,\n	replyGood: boolean,\n	-- True when this chat came from a roster tap rather than from standing next to\n	-- somebody. A remote chat has no `stand`, so the walk has to find the person from\n	-- their id and every place a body would appear must be skipped.\n	remote: boolean,\n}\n\nlocal chats: { [Player]: Chat } = {}\n\n-- The last thing pushed to each player, so an unchanged row is not re-sent four times a\n-- second. Same reason work and school keep one.\nlocal pushed: { [Player]: string } = {}\n\n-- The last roster digest pushed to each player, so an unchanged list is not re-sent on\n-- every rebuild. Same reason `pushed` exists one block up, for the row.\nlocal pushedRoster: { [Player]: string } = {}\n\n-- Approach tracking. Records the timestamp of each time the player walked into reach\n-- of a new NPC. Used by the autonomy-rate debug command to report the real number,\n-- so the quota is a thing you can see failing rather than a thing you assume.\n--\n-- Each entry is { at: number, personId: string }. The list is kept small: after twenty\n-- approaches the oldest is dropped, which is roughly a minute at the tick rate and\n-- enough for a rolling average that does not bounce on a single outlying visit.\ntype ApproachEntry = { at: number, personId: string }\nlocal approaches: { [Player]: { ApproachEntry } } = {}\n-- The person the player was last recorded approaching, so a player standing still\n-- next to the same person does not flood the log on every tick.\nlocal approachTarget: { [Player]: string } = {}\n\n-- Studio harness switch. Off takes everybody out of the world, so the shop and the\n-- school can be tested in a street that is not also full of relatives.\nlocal enabled = true\n\n-- Every place any authored person lives at, worked out once. Iterated rather than\n-- `People.All` when rebuilding a roster, because the expensive half of the rebuild is\n-- resolving a place point and several people share one.\nlocal PLACE_IDS: { string } = {}\ndo\n	local seen: { [string]: boolean } = {}\n	for _, person in People.All do\n		if not seen[person.placeId] then\n			seen[person.placeId] = true\n			table.insert(PLACE_IDS, person.placeId)\n		end\n	end\nend\n\nlocal function ageYearsOf(data: LifeData): number\n	return data.ageMonths // Config.Time.MonthsPerYear\nend\n\n\nlocal function characterPosition(player: Player): Vector3?\n	local character = player.Character\n	if character == nil then\n		return nil\n	end\n	local root = character:FindFirstChild(\"HumanoidRootPart\")\n	if root == nil or not root:IsA(\"BasePart\") then\n		return nil\n	end\n	return root.Position\nend\n\n-- Which places the player is close enough to for the town who live there to be worth\n-- building bodies for, and how far each one is. Empty while there is no character to\n-- measure from, which is correct rather than a special case: somebody who is not in the\n-- world is not near anything, and the next check after they spawn puts it right.\n--\n-- Distances come back with it because the ceiling on bodied townsfolk has to drop the\n-- furthest place rather than whichever one the loop reached last.\nlocal function nearPlacesFor(position: Vector3?): { [string]: number }\n	local near: { [string]: number } = {}\n	if position == nil then\n		return near\n	end\n	for _, placeId in PLACE_IDS do\n		local place = PlaceService.Find(placeId)\n		if place == nil then\n			-- PlaceService has already warned about the missing tag, and the rebuild\n			-- records it against the people who wanted it. Nothing to add here.\n			continue\n		end\n		local distance = Ground.FlatDistance(position, place.part.Position)\n		if distance <= TOWN.PresenceStuds then\n			near[placeId] = distance\n		end\n	end\n	return near\nend\n\n-- One bodiless townsperson, moved on by however long it has been since they were last\n-- thought about.\n--\n-- Straight-line and flat, deliberately. There is no rig to collide with anything and\n-- nobody watching, so pathfinding here would be paying Roblox to route somebody around a\n-- bench that only exists as far as the renderer is concerned. The route itself is not\n-- straight -- `Roam.NextLeg` hands back one town point at a time, and those are on the\n-- paths -- so what this actually walks is the same polyline a body would, without the\n-- steering.\n--\n-- Height comes from the goal on arrival rather than being tracked along the way: the leg\n-- is short, the probe that turns a ghost back into a body looks six studs up and twelve\n-- down for the floor anyway, and carrying a stale Y up a hill is cheaper to fix at the end\n-- than to integrate all the way along.\nlocal function stepGhost(ghost: Ghost, elapsed: number)\n	local now = os.clock()\n	local goal = ghost.goal\n	if goal == nil then\n		if now < ghost.restUntil then\n			return\n		end\n		-- Nil means nothing was found to walk to -- no graph in reach and every probe\n		-- blocked. The answer is the same as the walker's: stand there and ask again\n		-- after the next rest, rather than burn a probe per tick forever.\n		ghost.goal = Roam.NextLeg(ghost.wander, ghost.at)\n		if ghost.goal == nil then\n			ghost.restUntil = now + TOWN.PauseMinSeconds\n		end\n		return\n	end\n\n	local step = TOWN.WalkSpeed * elapsed\n	local offset = Vector3.new(goal.X - ghost.at.X, 0, goal.Z - ghost.at.Z)\n	if offset.Magnitude <= step then\n		ghost.at = goal\n		ghost.goal = nil\n		ghost.restUntil = now + ghost.wander.rng:NextNumber(TOWN.PauseMinSeconds, TOWN.PauseMaxSeconds)\n		return\n	end\n	ghost.at = ghost.at + offset.Unit * step\nend\n\n-- Brings the set of positions into line with who is in the town for this player, which is\n-- the same idempotent shape as `rebuild` and for the same reason: a birthday changes who\n-- is in the town, and every caller should be able to say \"make this true\" rather than know\n-- which people to add.\n--\n-- New arrivals start at the place they belong to, which is the only honest answer -- they\n-- have not been walking anywhere, because until this second they were not in this life.\nlocal function ensureGhosts(player: Player, data: LifeData, age: number)\n	local mine = ghosts[player]\n	if mine == nil then\n		mine = {}\n		ghosts[player] = mine\n	end\n\n	-- Resolved once per pass. Several people share a place and `PlaceService.Find` is a\n	-- tag lookup rather than a field read.\n	local homes: { [string]: Vector3 } = {}\n	local present: { [string]: boolean } = {}\n\n	for _, person in People.All do\n		if not People.IsTown(person.id) or not People.IsAround(person, age, data.flags) then\n			continue\n		end\n		present[person.id] = true\n		if mine[person.id] ~= nil then\n			continue\n		end\n\n		local home = homes[person.placeId]\n		if home == nil then\n			local place = PlaceService.Find(person.placeId)\n			if place == nil then\n				-- PlaceService has already warned about the missing tag, and `rebuild`\n				-- records it against everybody who wanted it. Nothing to start them from,\n				-- so they simply have no position until it is tagged.\n				continue\n			end\n			home = place.part.Position\n			homes[person.placeId] = home\n		end\n\n		-- Unseeded, like the walker's, and for the same reason: where somebody happens to\n		-- be standing is not part of who the town is. The stagger is what stops a place\n		-- whose people all entered this life on one birthday sending all of them out of\n		-- the door on the same second, which reads as a shift change.\n		local rng = Random.new()\n		local ghost: Ghost = {\n			at = home,\n			goal = nil,\n			restUntil = os.clock() + rng:NextNumber(0, TOWN.PauseMaxSeconds),\n			wander = { node = nil, previous = nil, home = home, rng = rng },\n		}\n\n		-- The town has already had a morning. Everybody starting life at the exact point\n		-- their place is tagged puts six kids on your doorstep the second you are born and\n		-- four regulars in the shop doorway, and no amount of walking afterwards undoes the\n		-- first impression -- which is a spawner firing, not a street.\n		--\n		-- Walked rather than teleported to a random point, and that is the whole trick: the\n		-- legs are the same legs `stepGhost` would have taken, so wherever they end up is\n		-- somewhere the route graph actually goes and inside their own leash. It costs a\n		-- handful of table reads, because a leg nobody can see does not have to be walked\n		-- at walking pace.\n		for _ = 1, rng:NextInteger(0, TOWN.SettleLegs) do\n			local leg = Roam.NextLeg(ghost.wander, ghost.at)\n			if leg == nil then\n				break\n			end\n			ghost.at = leg\n		end\n\n		mine[person.id] = ghost\n	end\n\n	-- Anybody who has aged out of this life or been flagged away. Their body is taken down\n	-- by the rebuild; this is the half of them that never had one, and left behind it would\n	-- be a position quietly walking around the town for the rest of the session.\n	for id in mine do\n		if not present[id] then\n			mine[id] = nil\n		end\n	end\nend\n\n-- Which townsfolk are close enough to the player to be worth building a body for, and how\n-- far each one is.\n--\n-- Measured from the person rather than from the building they belong to. That one change\n-- is the feature: the old test asked whether the player was near a place and then built\n-- everybody who lived there, so a walk that took somebody a hundred studs down the road\n-- was a walk out of existence, and the range that governed the walking had to stay smaller\n-- than the range that governed the bodies.\n--\n-- The slack is hysteresis and it is not optional. Without it, somebody drifting along the\n-- exact edge is built, measured, torn down and built again once a second -- a person\n-- flickering rather than a person leaving -- and each of those builds is a web call.\nlocal function townInRange(player: Player, position: Vector3?): { [string]: number }\n	local near: { [string]: number } = {}\n	if position == nil then\n		return near\n	end\n	local mine = ghosts[player]\n	if mine == nil then\n		return near\n	end\n\n	local here = standing[player]\n	local keep = TOWN.PresenceStuds * TOWN.DespawnSlack\n\n	for id, ghost in mine do\n		local stand = if here ~= nil then here[id] else nil\n		local bodied = stand ~= nil and not stand.visitor.gone()\n		-- A bodied person is asked where they are; a bodiless one is only ever where the\n		-- integrator put them. One question, two places to ask it, which is the shape of\n		-- this whole system.\n		local at = if bodied and stand ~= nil then stand.visitor.at() else ghost.at\n		local distance = Ground.FlatDistance(position, at)\n		if distance <= (if bodied then keep else TOWN.PresenceStuds) then\n			near[id] = distance\n		end\n	end\n	return near\nend\n\n-- The set above as one comparable string. Sorted, so the same set of people never reads\n-- two different ways and triggers a rebuild for having been iterated in a new order.\nlocal function townDigest(near: { [string]: number }): string\n	local ids: { string } = {}\n	for id in near do\n		table.insert(ids, id)\n	end\n	table.sort(ids)\n	return table.concat(ids, \",\")\nend\n\n-- How they feel about you. Never nil here, unlike the content module's version: this is\n-- only ever asked about somebody already resolved out of the roster, so there is no\n-- unwritten person for it to have no answer about.\nlocal function bondOf(data: LifeData, person: Person): number\n	return People.BondIn(data.bonds, person.id) or person.startingBond\nend\n\n-- How many times this person has been seen at this age. A record left over from an\n-- earlier year reads as none, which is how a year rolls over without anything having to\n-- be cleared on the birthday.\nlocal function visitsAt(data: LifeData, personId: string, age: number): number\n	local record = data.visits[personId]\n	if record == nil or record.age ~= age then\n		return 0\n	end\n	return record.count\nend\n\nlocal function bandFor(bond: number): string\n	for _, band in PEOPLE.Bands do\n		if bond >= band.atLeast then\n			return band.name\n		end\n	end\n	-- Unreachable while the last band is anchored to MinBond and bonds are clamped to\n	-- it, which is exactly why this says so rather than returning an empty string that\n	-- would show up on the HUD as a missing word.\n	return PEOPLE.Bands[#PEOPLE.Bands].name\nend\n\nlocal BOND_MILESTONE_LABELS: { [number]: string } = {\n	[10] = \"Acquaintance\",\n	[25] = \"Friend\",\n	[50] = \"Close Friend\",\n	[75] = \"Best Friend\",\n	[100] = \"Soul Friend\",\n}\n\nlocal function milestoneLabel(milestone: number): string\n	return BOND_MILESTONE_LABELS[milestone] or \"Friend\"\nend\n\n-- Record an interaction with a person. Rolling buffer of 5 per person: oldest\n-- is dropped. The defining moment for that person is set when the bonding is\n-- strongest yet, so the player remembers the line said at the peak of the bond.\nlocal function recordInteraction(data: LifeData, personId: string, age: number, line: string)\n	local list = data.interactions[personId]\n	if list == nil then\n		list = {}\n		data.interactions[personId] = list\n	end\n	table.insert(list, { personId = personId, age = age, line = line })\n	while #list > PEOPLE.InteractionsPerPerson do\n		table.remove(list, 1)\n	end\nend\n\n-- The odds this ask is turned down, from 0 to 1. Zero for everything that is not an\n-- ask, which is most of what anybody has to say.\n--\n-- Read off the gap between the bond and what this particular offer asks of it. An ask\n-- appears the very year the bond reaches its minBond, so at that moment the player is\n-- asking for something the other person has only just become capable of saying yes to\n-- -- and the further past it they are, the less of a question it is. That is the whole\n-- rule, and it means no offer has to carry authored odds that could fall out of step\n-- with the bond it already names.\nlocal function refusalChance(offer: PersonOffer, bond: number): number\n	if not offer.ask then\n		return 0\n	end\n	local headroom = math.max(bond - offer.minBond, 0)\n	local warmth = math.min(headroom / PEOPLE.RefuseFadeSpan, 1)\n	return PEOPLE.RefuseAtFloor * (1 - warmth)\nend\n\n-- What those odds are called on the row, or nil when the ask has become safe enough\n-- to stop warning about. The nil is the point: a row that quietly loses its note is\n-- how the player finds out somebody came around.\nlocal function riskNote(chance: number): string?\n	for _, band in PEOPLE.RiskBands do\n		if chance >= band.atLeast then\n			return band.name\n		end\n	end\n	return nil\nend\n\n-- Studio harness switch over the coin. \"chance\" is the game; the other two force the\n-- branch, because a refusal is the one outcome in this system that cannot be reached on\n-- purpose -- waiting on a 50/50 to see the words somebody says when they turn you down\n-- is not a test, and at one visit a year a wrong guess costs a whole in-game year to\n-- retry.\nexport type RefusalMode = \"chance\" | \"always\" | \"never\"\nlocal refusalMode: RefusalMode = \"chance\"\n\n-- Whether this ask is turned down. The single place the coin is flipped, so there is\n-- exactly one thing to switch off and exactly one thing to read.\nlocal function rollRefusal(offer: PersonOffer, bond: number): boolean\n	-- Checked before the override, so forcing refusals on never turns small talk into\n	-- something that can be refused. Nothing that is not an ask has words to say no with.\n	if not offer.ask then\n		return false\n	end\n	if refusalMode == \"always\" then\n		return true\n	end\n	if refusalMode == \"never\" then\n		return false\n	end\n	return math.random() < refusalChance(offer, bond)\nend\n\nlocal function nameOf(person: Person): string\n	local member = Cast.ById[person.castId]\n	if member == nil then\n		-- Validated at content load, so this is only reachable if the validator was\n		-- bypassed. Their id is a worse name than their name and a much better one than\n		-- a blank row.\n		return person.id\n	end\n	return member.name\nend\n\n-- Who they are, for the one thing in this game allowed to ask: which first-name list\n-- they were named from. Nothing else reads it -- there is no partner system for it to\n-- feed, and the town listing shows the initial only as a label on a row.\n--\n-- Optional for the same reason nameOf falls back to an id -- a cast entry that is not\n-- there is a bypassed validator rather than a runtime state -- but answered with nil\n-- rather than a guess, because a person nobody can classify belongs outside a count and\n-- not in whichever half of it the fallback happened to pick.\nlocal function genderOf(person: Person): Gender?\n	local member = Cast.ById[person.castId]\n	return if member ~= nil then member.gender else nil\nend\n\n-- Whether these two are close enough in age to be each other's contemporaries. Read from\n-- the offset rather than from the archetype, so somebody who came out of the generator at\n-- the near edge of a wide spread counts and somebody at the far edge of a narrow one does\n-- not -- which is what the player sees, since what stands in front of them is a person of\n-- an age and not a category.\nlocal function isPeer(person: Person): boolean\n	return math.abs(person.ageOffset) <= PEOPLE.PeerAgeGap\nend\n\n-- Whether this person still has anything to give the player today. Asked of the\n-- profile rather than of an open conversation, because the answer has to be true from\n-- across the room: the dots over somebody's head are a promise that walking over there\n-- is worth the walk, and a lit set of dots on somebody you have already seen this year\n-- is the game lying about that.\n-- Everything that decides what is on somebody's panel, gathered in one place so that\n-- what the dots promise and what the panel then shows are worked out from the same\n-- answer. They were four arguments before ties existed and it did not matter; now that\n-- one of them is a fact about the whole roster, two call sites assembling it separately\n-- is two chances for a lit set of dots to open an empty list.\nlocal function offerContext(data: LifeData, person: Person): People.OfferContext\n	local age = ageYearsOf(data)\n	return {\n		age = age,\n		bond = bondOf(data, person),\n		flags = data.flags,\n		tie = data.ties[person.id],\n		tieFull = People.TieRoom(data.ties, age, data.flags),\n	}\nend\n\nlocal function hasSomethingLeft(data: LifeData, person: Person): boolean\n	if visitsAt(data, person.id, ageYearsOf(data)) >= PEOPLE.VisitsPerYear then\n		return false\n	end\n	return #People.OffersFor(person, offerContext(data, person)) > 0\nend\n\n-- What a person can say to you from the phone. Everything `OffersFor` yields minus the\n-- walks, because a walk is the one offer whose content is legs -- it needs the body\n-- standing in front of you, and a call has none. This is what the roster's green dot\n-- means and what a phone chat actually holds, so the two can never disagree.\nlocal function callableOffers(data: LifeData, person: Person): { PersonOffer }\n	local all = People.OffersFor(person, offerContext(data, person))\n	local callable: { PersonOffer } = {}\n	for _, offer in all do\n		if offer.walksTo == nil then\n			table.insert(callable, offer)\n		end\n	end\n	return callable\nend\n\n-- Everything written over one person's head: the dots, lit or quiet to match what they\n-- actually have, and the plate saying who they are and how old.\n--\n-- The dots are never taken away -- somebody who has given you their time this year is\n-- still standing there and is still worth walking up to, and removing them would say\n-- they had left. The plate is never taken away either, for a plainer reason: a name is\n-- true whether or not there is anything left to say.\nlocal function refreshOverhead(player: Player, stand: Standing)\n	local profile = DataService.GetProfile(player)\n\n	-- Ahead of the dots, and outside the nil check on them, because this is the one thing\n	-- here that is not about the marker over somebody's head. Everybody in the world gets\n	-- a year older on the player's birthday, and a body that did not resize is a classmate\n	-- who is still six in the year you leave school. Cheap -- four NumberValues -- which is\n	-- what lets a birthday resize the whole street instead of rebuilding it.\n	if profile ~= nil then\n		stand.visitor.setAge(math.max(ageYearsOf(Lives.Active(profile.Data)) + stand.person.ageOffset, 0))\n	end\n\n	local dots = stand.dots\n	if dots == nil then\n		return\n	end\n	local lit = profile ~= nil and Lives.Active(profile.Data).alive and enabled and hasSomethingLeft(Lives.Active(profile.Data), stand.person)\n	dots.SetEnabled(lit)\n\n	if profile ~= nil then\n		dots.SetNameplate({\n			name = nameOf(stand.person),\n			age = People.ShownAge(stand.person, ageYearsOf(Lives.Active(profile.Data))),\n			-- Nil for nearly everybody, which is the point of putting it here: a town\n			-- where one head in thirty says \"friend\" is a town you can read at a glance,\n			-- and it is the only place a tie is ever shown, because the alternative is a\n			-- relationships screen and this game does not have screens.\n			tie = Ties.LabelOf(Lives.Active(profile.Data).ties[stand.person.id]),\n		})\n	end\nend\n\n-- Every one of them, for the moments that change what everybody has at once: a birthday,\n-- a flag moving, a harness command. Cheap enough to do wholesale -- it is a handful of\n-- people and a table read each -- and doing it wholesale is what stops one path being\n-- forgotten and leaving a single relative permanently lit.\n--\n-- A birthday is also the one moment every age on every plate is wrong at once, and it\n-- already comes through here, which is why the plate rides along with the dots rather\n-- than getting a refresh path of its own that a caller could forget.\nlocal function refreshAllOverhead(player: Player)\n	local here = standing[player]\n	if here == nil then\n		return\n	end\n	for _, stand in here do\n		refreshOverhead(player, stand)\n	end\nend\n\nlocal function stateFor(player: Player): PersonState?\n	local chat = chats[player]\n	if chat == nil then\n		return nil\n	end\n	local person = People.ById[chat.personId]\n	if person == nil then\n		return nil\n	end\n\n	local profile = DataService.GetProfile(player)\n	local bond = if profile ~= nil then bondOf(Lives.Active(profile.Data), person) else nil\n	local band = if bond ~= nil then bandFor(bond) else \"\"\n\n	-- Ids, labels, and how likely a no is. What an offer is *worth* stays on this\n	-- machine: the panel is built to be read, and the answer that comes back off it is\n	-- priced from `chat.offers` and never from what was sent.\n	--\n	-- The odds are the one thing that has to travel, because a gamble the player cannot\n	-- see is not a gamble they are taking -- it is one the game is taking for them. Sent\n	-- as the word rather than the number so the client has nothing to arithmetic with,\n	-- and so the wording stays a single decision made here.\n	local offers: { OfferedChoice } = {}\n	for _, offer in chat.offers do\n		local note = if bond ~= nil then riskNote(refusalChance(offer, bond)) else nil\n		table.insert(offers, { id = offer.id, label = offer.label, cost = nil, note = note, locked = false })\n	end\n\n	-- Pick a contextual line if one is available for the current situation.\n	-- Tie-based lines come first: what somebody says to you when you are their\n	-- closest friend should not be the same as what they say when you are a stranger,\n	-- and the tie key lets content authors write those differences without adding a\n	-- second contextual system. The \"close\" key is a shorthand for any positive rung\n	-- tie -- friend, closest, mentor, sibling, rival, sibling -- so a single set of\n	-- friendly lines works for every warm relationship without repeating them.\n	local contextLine: string? = nil\n	if person.contextualLines ~= nil and chat.replyText == nil then\n		local data = Lives.Active(profile.Data)\n		local age = ageYearsOf(data)\n		local tieId = data.ties[person.id]\n\n		-- Tie keys first so a friend gets their friend line rather than a generic one.\n		local tieKeys: { string } = {}\n		if tieId ~= nil then\n			table.insert(tieKeys, tieId)\n		end\n		if tieId ~= nil and Ties.IsRung(tieId) and Ties.RankOf(tieId) > 0 then\n			table.insert(tieKeys, \"close\")\n		end\n		for _, key in tieKeys do\n			local lines = person.contextualLines[key]\n			if lines ~= nil and #lines > 0 then\n				contextLine = lines[math.random(1, #lines)]\n				break\n			end\n		end\n\n		-- A rare callback to the strongest thing this person has ever said to the\n		-- player -- the defining-moment buffer `take()` already writes and which,\n		-- until now, only `/people describe` could read. Tried after the tie-specific\n		-- lines (a freshly-earned tie always gets its own line first) and before the\n		-- everyday situational ones below, gated by a roll so it reads as something\n		-- they occasionally bring up rather than either burying what just happened or\n		-- never surfacing at all.\n		if contextLine == nil and person.memoryIntro ~= nil then\n			local moment = data.definingMoment[person.id]\n			if moment ~= nil and math.random() < PEOPLE.MemoryCallbackChance then\n				contextLine = `{person.memoryIntro} \"{moment.line}\"`\n			end\n		end\n\n		if contextLine == nil then\n			local keys: { string } = {}\n			if age < 16 then\n				table.insert(keys, \"unemployed\")\n			end\n			if data.jobId ~= nil then\n				table.insert(keys, \"onShift\")\n			end\n			table.insert(keys, \"morning\")\n			if data.houses ~= nil and next(data.houses) ~= nil then\n				table.insert(keys, \"atHome\")\n			end\n			for _, key in keys do\n				local lines = person.contextualLines[key]\n				if lines ~= nil and #lines > 0 then\n					contextLine = lines[math.random(1, #lines)]\n					break\n				end\n			end\n		end\n	end\n\n	return {\n		id = person.id,\n		name = nameOf(person),\n		band = band,\n		reply = chat.replyText,\n		replyGood = chat.replyGood,\n		offers = offers,\n		-- The one thing the client cannot infer from the row: this chat has no body to\n		-- walk to, so it must be drawn as a phone call rather than as a standing person.\n		contact = chat.remote,\n		contextualLine = contextLine,\n		-- What they are to you beyond the bond band. Nil for most people, which is the\n		-- point: a town where every row says \"friend\" is a town where the word means\n		-- nothing. Shown on the HUD so the relationship is visible the moment you stand\n		-- next to somebody, not only when you open the menu.\n		tie = if profile ~= nil then Ties.LabelOf(Lives.Active(profile.Data).ties[person.id]) else nil,\n	}\nend\n\nlocal function push(player: Player)\n	local state = stateFor(player)\n	local digest = \"none\"\n	if state ~= nil then\n		local ids: { string } = {}\n		for _, offer in state.offers do\n			table.insert(ids, offer.id)\n		end\n		-- The offer ids are in the digest because they are the only part of this that can\n		-- change while the name and the band sit still -- taking one leaves a row that reads\n		-- identically and a panel that must not. The tie is included for the same reason:\n		-- a conversation that changes a relationship must force the row to refresh.\n		digest = `{state.id}|{state.band}|{tostring(state.tie)}|{tostring(state.reply)}|{tostring(state.replyGood)}|{tostring(state.contact)}|{tostring(state.contextualLine)}|{table.concat(ids, \",\")}`\n	end\n	if pushed[player] == digest then\n		return\n	end\n	pushed[player] = digest\n	PersonUpdatedRemote:FireClient(player, state)\nend\n\n-- The people this player knows and could be speaking to, as a whole list for the HUD.\n-- The same gate that decides who is in the world at all decides who is on this list --\n-- it is the roster used to build the street, sent as rows -- and `available` is whether\n-- tapping them has anything to say this year. Distinct from `stateFor`'s single row in\n-- the same way `PeopleRosterUpdated` was split from `PersonUpdated`: one names everyone,\n-- the other names who is next to you right now.\nlocal function rosterFor(player: Player): { PersonRosterEntry }\n	local profile = DataService.GetProfile(player)\n	local entries: { PersonRosterEntry } = {}\n	if profile == nil then\n		return entries\n	end\n	local data = Lives.Active(profile.Data)\n	if not data.alive then\n		return entries\n	end\n	local age = ageYearsOf(data)\n	for _, person in People.All do\n		if not People.IsAround(person, age, data.flags) then\n			continue\n		end\n		table.insert(entries, {\n			id = person.id,\n			name = nameOf(person),\n			band = bandFor(bondOf(data, person)),\n			tie = Ties.LabelOf(data.ties[person.id]),\n			-- Callable rather than everything they have left: the dot is what a tap on\n			-- the roster is worth, and a walk that cannot transfer must not light it.\n			available = visitsAt(data, person.id, age) < PEOPLE.VisitsPerYear\n				and #callableOffers(data, person) > 0,\n		})\n	end\n	return entries\nend\n\nlocal function pushRoster(player: Player)\n	local entries = rosterFor(player)\n	local digests: { string } = {}\n	for _, entry in entries do\n		table.insert(digests, `{entry.id}:{entry.name}:{entry.band}:{tostring(entry.available)}`)\n	end\n	local digest = table.concat(digests, \"|\")\n	if pushedRoster[player] == digest then\n		return\n	end\n	pushedRoster[player] = digest\n	PeopleRosterUpdatedRemote:FireClient(player, entries)\nend\n\n-- A spot on the ring around a place that a body actually fits in, or nil if every\n-- bearing was taken or blocked. Full circle rather than an arc, because a place point\n-- is the middle of a room and there is no reason a mother should be in front of it.\n--\n-- The ring is passed in rather than read off Config here because there are two of them:\n-- the family stand close, and the town stand on a wider circle with more bearings on it,\n-- since a dozen strangers will not fit on a mother's.\nlocal function spotFor(center: Vector3, taken: { Vector3 }, ringStuds: number, ringBearings: number): Vector3?\n	local ignore = Ground.IgnoreList()\n	local radius = Config.NPC.BodyRadius\n	local height = Config.NPC.BodyHeight\n\n	for _, bearing in Ground.Bearings(360, ringBearings) do\n		local direction = CFrame.fromAxisAngle(Vector3.yAxis, math.rad(-bearing)) * Vector3.new(0, 0, -1)\n		local candidate = center + direction * ringStuds\n\n		-- No reachability test, and that is deliberate rather than an omission. These\n		-- people are not walking to the ring, they are already standing on it when the\n		-- player comes into view -- a mother in her own kitchen does not have to be able\n		-- to walk there from the middle of the room to be allowed to be in it.\n		local floor = Ground.SpotAt(candidate, radius, height, ignore)\n		if floor == nil then\n			continue\n		end\n		if Ground.Apart(floor, taken, MIN_APART) then\n			return floor\n		end\n	end\n\n	return nil\nend\n\n-- Where to put a body for somebody who has been walking without one. Three tries, and the\n-- order is the argument: exactly where they are, a step aside, and only then the ring\n-- around the place they belong to.\n--\n-- The first is the one that matters -- a person coming into view should appear where they\n-- had got to, because anything else is a teleport the player can see. The second covers\n-- two people arriving at one corner. The third is the interesting one: in a world with\n-- nothing tagged, everybody's ghost is still milling about within `RoamStuds` of their own\n-- doorstep, so a crowded doorstep falls through to the ring and spreads out exactly as it\n-- did before any of this existed. The old behaviour is the last resort rather than a\n-- separate code path.\nlocal function spotAt(at: Vector3, home: Vector3, taken: { Vector3 }): Vector3?\n	local ignore = Ground.IgnoreList()\n	local radius = Config.NPC.BodyRadius\n	local height = Config.NPC.BodyHeight\n\n	local floor = Ground.SpotAt(at, radius, height, ignore)\n	if floor ~= nil and Ground.Apart(floor, taken, MIN_APART) then\n		return floor\n	end\n\n	return spotFor(at, taken, TOWN.NudgeStuds, TOWN.StandBearings)\n		or spotFor(home, taken, TOWN.StandStuds, TOWN.StandBearings)\nend\n\nlocal function takeDown(player: Player, personId: string)\n	local here = standing[player]\n	if here == nil then\n		return\n	end\n	local stand = here[personId]\n	if stand == nil then\n		return\n	end\n	here[personId] = nil\n\n	-- The despawn half of the handoff, and it has to happen before the rig goes: where the\n	-- body had got to becomes where the person is. Without this, somebody the player\n	-- followed down a street and then walked away from would snap back to wherever their\n	-- ghost was last stepped, which is the doorstep they set off from.\n	--\n	-- The goal goes with the body rather than carrying over. The wander is shared and the\n	-- rig has been advancing it all the time it was walking, so whatever this ghost was\n	-- heading for before it grew legs is somewhere it has since walked past; asking for a\n	-- fresh leg from where they now actually are is the only reading that is not stale.\n	local mine = ghosts[player]\n	local ghost = if mine ~= nil then mine[personId] else nil\n	if ghost ~= nil and not stand.visitor.gone() then\n		ghost.at = stand.visitor.at()\n		ghost.goal = nil\n		ghost.restUntil = os.clock()\n	end\n\n	-- Ahead of the rig, and by hand rather than left to the model going away. Destroying\n	-- the character does take the prompt and the billboard with it, but not the three\n	-- looping tweens driving the dots, and those would go on bobbing nothing forever.\n	local dots = stand.dots\n	if dots ~= nil then\n		dots.Destroy()\n	end\n	-- Before the body, so the walk cannot issue one more leg against a rig that is\n	-- already halfway out of the world.\n	local roam = stand.roam\n	if roam ~= nil then\n		roam.stop()\n	end\n	stand.visitor.destroy()\nend\n\nlocal function despawnAll(player: Player)\n	-- Ahead of the early return, and not inside it. This is the record of which places had\n	-- bodies built for them, so it has to be wrong in the same direction as the world: left\n	-- set, the next presence check would compare against a street that no longer exists and\n	-- decide nothing had changed.\n	presence[player] = nil\n	-- And the positions with it. This is death, a new life or the harness switch, not the\n	-- player walking away: there is no journey left to resume, and a ghost kept across one\n	-- of those would have somebody from the last life still pacing the street.\n	ghosts[player] = nil\n\n	-- Any walk in progress ends here, ahead of the rigs below. Death, a new life and the\n	-- harness switch are not walks that finish, they are walks that stop existing -- the\n	-- callback fires once and the lease goes with the rigs.\n	CompanionService.Dismiss(player)\n	leased[player] = nil\n\n	local here = standing[player]\n	if here == nil then\n		return\n	end\n	standing[player] = nil\n	-- The reasons went with them. Left behind, they would have `/people` explaining why a\n	-- mother could not be fitted into a room nobody is standing in any more.\n	unplaced[player] = nil\n	for _, stand in here do\n		local dots = stand.dots\n		if dots ~= nil then\n			dots.Destroy()\n		end\n		local roam = stand.roam\n		if roam ~= nil then\n			roam.stop()\n		end\n		stand.visitor.destroy()\n	end\nend\n\n-- Brings the set of people standing in the world into line with who is actually in this\n-- player's life right now. Idempotent, which is the whole design: a birthday, a new life\n-- and a debug command all just ask for this again rather than each knowing which rigs to\n-- add or remove.\n--\n-- Yields -- building an avatar is a web-backed call -- so everything it holds across a\n-- yield is re-checked afterwards.\nlocal function rebuild(player: Player)\n	local profile = DataService.GetProfile(player)\n	if profile == nil or not enabled then\n		despawnAll(player)\n		return\n	end\n\n	local data = Lives.Active(profile.Data)\n	local age = ageYearsOf(data)\n\n	-- Re-bound rather than used through the optional, because the spawn below is a closure\n	-- over it and narrowing does not cross that boundary.\n	local roster = standing[player]\n	if roster == nil then\n		roster = {}\n		standing[player] = roster\n	end\n	local here: { [string]: Standing } = roster\n\n	-- Where the player is standing, decided once at the top and used for the whole pass.\n	-- Re-measuring per place would let somebody walking between two of them be counted as\n	-- near neither, and the symptom of that is a shop that empties as you cross it.\n	local position = characterPosition(player)\n\n	-- Before anything measures a distance to a townsperson, because a distance to somebody\n	-- with no position yet is a distance to their doorstep -- and on the birthday an\n	-- archetype enters the life, that would build the whole set of them at their buildings\n	-- rather than wherever the walking would have taken them.\n	if data.alive then\n		ensureGhosts(player, data, age)\n	end\n\n	local nearPlaces = nearPlacesFor(position)\n	local inRange = townInRange(player, position)\n	presence[player] = townDigest(inRange)\n\n	-- Anybody who has aged out of this life, or all of them if there is no life to be in\n	-- at the moment. Done first so their spot on the ring is free for whoever replaces\n	-- them at the same place.\n	--\n	-- A townsperson the player has walked away from goes here too. It is the same removal\n	-- for a different reason -- they have not left your life, you have left the street --\n	-- and doing it in this pass is what frees the rig budget before the pass below starts\n	-- spending it.\n	for id, stand in here do\n		local person = stand.person\n		local streamedOut = People.IsTown(person.id) and inRange[person.id] == nil\n		if\n			not data.alive\n			or not People.IsAround(person, age, data.flags)\n			or stand.visitor.gone()\n			-- Walking out of the street's reach does not take down somebody walking with\n			-- you -- that is the whole point of the lease, and without the exception a\n			-- companion would despawn the moment you led them past their own doorstep.\n			or (streamedOut and not isLeased(player, id))\n		then\n			takeDown(player, id)\n		end\n	end\n	if not data.alive then\n		-- The dead do not walk. Any walk still in flight is ended rather than left to\n		-- notice the gone visitor one tick later, and the leases go with the rigs.\n		CompanionService.Dismiss(player)\n		leased[player] = nil\n		unplaced[player] = nil\n		ghosts[player] = nil\n		return\n	end\n\n	-- How much of the rig ceiling is already spent, counted after the take-down above so\n	-- somebody who just walked out of range is not still holding a slot against the person\n	-- replacing them.\n	local townBodied = 0\n	for _, stand in here do\n		if People.IsTown(stand.person.id) then\n			townBodied += 1\n		end\n	end\n\n	local missing: { [string]: string } = {}\n	unplaced[player] = missing\n\n	-- Everything between \"this person should be standing here\" and \"they are\". Shared by\n	-- the two passes below, because the only thing that differs between the family and the\n	-- town is how the spot was chosen -- and a second copy of the spawn, the re-check and\n	-- the dots is exactly the kind of duplication that drifts apart one bug fix at a time.\n	--\n	-- A closure rather than a file-level function so it can hold the profile, the roster\n	-- and the reasons table without any of them having to be threaded through and, more to\n	-- the point, without `profile`'s type having to be nameable from out here.\n	--\n	-- False means the world moved under one of the yields, and abandoning the pass is the\n	-- caller's to do rather than this one's -- it does not know what else the caller was in\n	-- the middle of.\n	local function putDown(\n		person: Person,\n		member: CastMember,\n		spot: Vector3,\n		facing: Vector3,\n		wander: Roam.Wander?,\n		resume: Vector3?\n	): boolean\n		local at = spot + Vector3.new(0, SPAWN_LIFT, 0)\n\n		-- Their real age, not the one on the nameplate. ShownAge stops reporting past\n		-- OldestShownAge because the game declines to *claim* a number it does not model,\n		-- but a body still has to be some size, and \"no age shown\" must not come out as\n		-- \"newborn\". Floored at nought for the same reason it is on the nameplate: an\n		-- offset can put somebody a year from being born and nothing should be built\n		-- inside-out because of it.\n		local visitorAge = math.max(ageYearsOf(data) + person.ageOffset, 0)\n		local visitor = NPCService.Spawn(player, member, CFrame.lookAt(at, at + facing), visitorAge)\n		if visitor == nil then\n			-- NPCService has already said why.\n			missing[person.id] = \"could not be built\"\n			return true\n		end\n\n		-- Everything below was true before the spawn yielded and may not be now: the player\n		-- can have left, died, had a birthday that aged this person out, or had their roster\n		-- torn down and rebuilt underneath this loop.\n		local current = DataService.GetProfile(player)\n		if\n			standing[player] ~= here\n			or current ~= profile\n			or not data.alive\n			or not People.IsAround(person, ageYearsOf(data), data.flags)\n		then\n			visitor.destroy()\n			return false\n		end\n\n		-- The invitation, attached to the rig itself so it travels with them. \"Talk\" and\n		-- their name, which is the only place in this game a person's name is written in\n		-- the world rather than on the HUD.\n		--\n		-- The plate goes on at attach rather than being left to the refresh below, so\n		-- there is never a frame of a nameless stranger standing there. It is kept in\n		-- step after that by `refreshOverhead`, which every birthday already runs.\n		local dots = Interact.Attach(visitor.model, {\n			kind = \"Person\",\n			id = person.id,\n			actionText = \"Talk\",\n			objectText = member.name,\n			nameplate = {\n				name = member.name,\n				age = People.ShownAge(person, ageYearsOf(data)),\n			},\n		})\n		if dots == nil then\n			-- Said out loud because the symptom is silent and looks like content: a\n			-- relative standing in the kitchen that the player can circle forever and\n			-- never speak to. They are left standing anyway -- a person with no dots is\n			-- worse than a person, and much better than an empty room.\n			warn(`[AGES] could not put dots over \"{person.id}\" for {player.Name}`)\n		end\n\n		-- The spawn half of the handoff, and nil for the family: your mother is in the\n		-- kitchen because that is where she is. For the town, `wander` is the very table\n		-- their position has been walking and `resume` is the leg it was partway through,\n		-- so the legs pick the journey up mid-stride instead of setting off on a new one\n		-- from wherever the body was set down.\n		local roam = if wander ~= nil then Roam.Start(visitor, wander, resume) else nil\n\n		local stand: Standing = { person = person, visitor = visitor, dots = dots, roam = roam }\n		here[person.id] = stand\n		refreshOverhead(player, stand)\n		return true\n	end\n\n	-- **Pass one: the family**, on the ring around the place they belong to, nearest place\n	-- first. They are never counted against the town's ceiling and never skipped for it --\n	-- your mother is in the kitchen whether or not the street outside is busy.\n	local orderedPlaces = table.clone(PLACE_IDS)\n	table.sort(orderedPlaces, function(a: string, b: string): boolean\n		local da = nearPlaces[a] or math.huge\n		local db = nearPlaces[b] or math.huge\n		if da == db then\n			return a < b\n		end\n		return da < db\n	end)\n\n	for _, placeId in orderedPlaces do\n		local wanted: { Person } = {}\n		for _, person in People.At(placeId) do\n			-- The town is pass two. They are placed by where they have walked to rather\n			-- than by which building they belong to, which is a different question with a\n			-- different answer, so it is not a branch inside this loop.\n			if People.IsTown(person.id) then\n				continue\n			end\n			if not People.IsAround(person, age, data.flags) or here[person.id] ~= nil then\n				continue\n			end\n			table.insert(wanted, person)\n		end\n		if #wanted == 0 then\n			continue\n		end\n\n		local place = PlaceService.Find(placeId)\n		if place == nil then\n			-- PlaceService has already warned once about the missing tag, and warning\n			-- again per birthday would bury the log. Recorded so `/people` can say it out\n			-- loud to whoever is standing in the room wondering where their mother is.\n			for _, person in wanted do\n				missing[person.id] = `no part tagged \"{placeId}\"`\n			end\n			continue\n		end\n\n		local center = place.part.Position\n		local taken: { Vector3 } = {}\n		for _, person in People.At(placeId) do\n			local already = here[person.id]\n			if already ~= nil then\n				table.insert(taken, already.visitor.at())\n			end\n		end\n\n		for _, person in wanted do\n			local member = Cast.ById[person.castId]\n			if member == nil then\n				missing[person.id] = `cast as \"{person.castId}\", who is not in the cast`\n				continue\n			end\n\n			local spot = spotFor(center, taken, PEOPLE.StandStuds, PEOPLE.StandBearings)\n			if spot == nil then\n				-- Not spawned rather than crammed in. A mother standing inside a wall is\n				-- worse than a mother who is out at the moment, and this is the one failure\n				-- of the system that looks exactly like a bug in the place tagging -- which\n				-- is why it is written down instead of dropped.\n				missing[person.id] = `no room to stand within {PEOPLE.StandStuds} studs of \"{placeId}\"`\n				continue\n			end\n			-- Claimed before the yield below, so two people asked for in the same rebuild\n			-- cannot be handed the same bearing.\n			table.insert(taken, spot)\n\n			-- Facing out from the middle of the place, so they are looking at whoever walks\n			-- up rather than at the wall behind it. Head tracking takes over from there.\n			local outward = spot - center\n			local flat = Vector3.new(outward.X, 0, outward.Z)\n			local facing = if flat.Magnitude < 0.01 then Vector3.new(0, 0, -1) else flat.Unit\n\n			if not putDown(person, member, spot, facing, nil, nil) then\n				return\n			end\n		end\n	end\n\n	-- **Pass two: the town**, and this one is ordered by where its people actually are\n	-- rather than by which building they belong to. That is the same change as everywhere\n	-- else in this file: when the ceiling is reached it is now somebody genuinely across\n	-- town who goes without a body, rather than somebody standing in front of the player\n	-- who happens to belong to a further-away place.\n	local mine = ghosts[player] or {}\n\n	-- One list for the whole town rather than one per place, because they are no longer at\n	-- their places -- two people from opposite ends of the roster can be standing on the\n	-- same corner, and a per-place list would let them into each other.\n	local townTaken: { Vector3 } = {}\n	for _, stand in here do\n		if People.IsTown(stand.person.id) then\n			table.insert(townTaken, stand.visitor.at())\n		end\n	end\n\n	local townWanted: { { person: Person, ghost: Ghost, distance: number } } = {}\n	for _, person in People.All do\n		if not People.IsTown(person.id) or not People.IsAround(person, age, data.flags) then\n			continue\n		end\n		if here[person.id] ~= nil then\n			continue\n		end\n\n		local ghost = mine[person.id]\n		if ghost == nil then\n			-- `ensureGhosts` declines for exactly one reason. Recorded here rather than\n			-- there because this is the table `/people` reads, and a townsperson missing\n			-- because their building was never tagged looks identical from the pavement to\n			-- one missing because they are across town.\n			missing[person.id] = `no part tagged \"{person.placeId}\"`\n			continue\n		end\n\n		local distance = inRange[person.id]\n		if distance == nil then\n			-- Out of range: a row in a table, and a position still walking around the town,\n			-- until the player comes down whichever street they are on.\n			continue\n		end\n		table.insert(townWanted, { person = person, ghost = ghost, distance = distance })\n	end\n\n	table.sort(townWanted, function(a, b): boolean\n		if a.distance == b.distance then\n			return a.person.id < b.person.id\n		end\n		return a.distance < b.distance\n	end)\n\n	for _, entry in townWanted do\n		local person = entry.person\n		if townBodied >= TOWN.MaxBodied then\n			-- The ceiling, and it is a real one: every body past it is a yielding web call\n			-- and a rig to animate. Written down rather than dropped quietly, because a\n			-- street that is a third as busy as the content says it is looks exactly like a\n			-- generator bug from the pavement.\n			missing[person.id] = `over the {TOWN.MaxBodied}-body town limit`\n			continue\n		end\n\n		local member = Cast.ById[person.castId]\n		if member == nil then\n			missing[person.id] = `cast as \"{person.castId}\", who is not in the cast`\n			continue\n		end\n\n		local ghost = entry.ghost\n		local spot = spotAt(ghost.at, ghost.wander.home, townTaken)\n		if spot == nil then\n			missing[person.id] = `no room to stand where they had walked to, nor at \"{person.placeId}\"`\n			continue\n		end\n		table.insert(townTaken, spot)\n\n		-- Facing the way they were already going, so somebody appearing at the edge of view\n		-- is mid-journey rather than mid-turn. Standing still, they face away from the place\n		-- they belong to, which is what the ring used to give them for free.\n		local look = if ghost.goal ~= nil then ghost.goal - spot else spot - ghost.wander.home\n		local flat = Vector3.new(look.X, 0, look.Z)\n		local facing = if flat.Magnitude < 0.01 then Vector3.new(0, 0, -1) else flat.Unit\n\n		-- A breath between strangers. Walking onto a busy street asks for up to a dozen\n		-- rigs at once, and a dozen simultaneous web-backed avatar builds is a hitch you\n		-- can feel; spread out, they fill in over about a second and read as people walking\n		-- into view. Deliberately before the spawn rather than after, so the re-check inside\n		-- `putDown` covers this yield as well as the build's.\n		task.wait(TOWN.SpawnPaceSeconds)\n\n		if not putDown(person, member, spot, facing, ghost.wander, ghost.goal) then\n			return\n		end\n		-- Counted off the roster rather than off the call, because `putDown` reports a\n		-- world that is still standing even when the rig itself could not be built.\n		if here[person.id] ~= nil then\n			townBodied += 1\n		end\n	end\n\n	-- Everybody, not just the arrivals. This runs on every birthday and every flag that\n	-- moves, and both of those change what people who were already standing there have\n	-- left to give -- a year rolling over is what re-lights the whole street.\n	refreshAllOverhead(player)\n\n	-- The roster is rebuilt on exactly the occasions the world is -- join, birthday, a\n	-- flag that moved -- because those are the same occasions a name can appear on it.\n	pushRoster(player)\nend\n\n-- Rebuilds are serialized per player and coalesced, because `rebuild` yields and two\n-- overlapping ones would each spawn the people the other had not finished spawning yet.\n-- A request arriving mid-rebuild sets a flag rather than queueing, so any number of\n-- birthdays in a row cost one extra pass.\nlocal rebuilding: { [Player]: boolean } = {}\nlocal rebuildAgain: { [Player]: boolean } = {}\n\nlocal function requestRebuild(player: Player)\n	if rebuilding[player] then\n		rebuildAgain[player] = true\n		return\n	end\n	rebuilding[player] = true\n\n	task.spawn(function()\n		repeat\n			rebuildAgain[player] = false\n			local ok, err = pcall(rebuild, player)\n			if not ok then\n				warn(`[AGES] could not put people in the world for {player.Name}: {err}`)\n			end\n		until not rebuildAgain[player]\n		rebuilding[player] = nil\n		rebuildAgain[player] = nil\n	end)\nend\n\n-- What they say back, held on the row for a beat. `good` is only the colour of it, and a\n-- refusal at the door comes through as a reply that is not good -- which is the honest\n-- reading of somebody telling you they have no time today.\nlocal function reply(chat: Chat, text: string, good: boolean)\n	chat.replyText = text\n	chat.replyGood = good\n	chat.replyLeft = PEOPLE.ReplySeconds\nend\n\n-- Walking up to somebody. This is not the conversation -- that starts when the player\n-- clicks the dots -- it is the game working out what would be on the panel if they did,\n-- so the row on the HUD can name who they are next to and the panel can open the instant\n-- it is asked for rather than a round trip later.\nlocal function open(player: Player, data: LifeData, stand: Standing)\n	local person = stand.person\n	local chat: Chat = {\n		personId = person.id,\n		offers = {},\n		done = false,\n		replyLeft = 0,\n		replyText = nil,\n		replyGood = false,\n	}\n	chats[player] = chat\n	stand.visitor.greet()\n\n	local age = ageYearsOf(data)\n	if visitsAt(data, person.id, age) >= PEOPLE.VisitsPerYear then\n		-- Their line, said unprompted. Somebody you have already had your hour with this\n		-- year tells you so as you walk up, rather than making you click three dots to be\n		-- turned away by a panel with nothing on it.\n		chat.done = true\n		reply(chat, person.busyLine, false)\n		refreshOverhead(player, stand)\n		push(player)\n		return\n	end\n\n	local offers = People.OffersFor(person, offerContext(data, person))\n	if #offers == 0 then\n		-- The content file checks every age of every person has something takeable at any\n		-- bond, so this cannot happen while that check stands. Said out loud rather than\n		-- left as somebody you can walk up to and get nothing from, which is precisely the\n		-- symptom that check exists to prevent.\n		chat.done = true\n		warn(`[AGES] \"{person.id}\" has nothing to offer at age {age}`)\n		refreshOverhead(player, stand)\n		push(player)\n		return\n	end\n\n	chat.offers = offers\n	refreshOverhead(player, stand)\n	push(player)\nend\n\n-- An offer taken, off the panel. Returns whether it was: an id that is not on the list\n-- this player was actually offered is refused rather than guessed at.\nlocal function take(player: Player, data: LifeData, chat: Chat, stand: Standing?, offerId: string): boolean\n	local offer: PersonOffer? = nil\n	for _, candidate in chat.offers do\n		if candidate.id == offerId then\n			offer = candidate\n			break\n		end\n	end\n	if offer == nil then\n		return false\n	end\n\n	-- A conversation walked up to has a body to react; a conversation on the phone has\n	-- only the profile. Everything below guards on `stand` so one path serves both.\n	local person = if stand ~= nil then stand.person else People.ById[chat.personId]\n	if person == nil then\n		return false\n	end\n	local age = ageYearsOf(data)\n\n	-- Rolled before anything is written, so the branch below is deciding what to record\n	-- rather than unpicking what it already did. Rolled on the server and never sent as\n	-- odds the client could re-roll: this is the verdict, and it happens once.\n	local refused = rollRefusal(offer, bondOf(data, person))\n\n	-- The conversation is closed and the visit is recorded before anything is paid out, so\n	-- a second click arriving behind the first -- a double tap, a retry, a payout that\n	-- yields -- finds a conversation that is already over rather than paying twice.\n	--\n	-- A refusal spends the visit exactly like a yes does, and that is the cost that makes\n	-- asking a decision. At one visit a year, a no is the year -- so what the player is\n	-- weighing on the panel is not \"is this free to try\" but \"is this the year to try it\".\n	chat.offers = {}\n	chat.done = true\n	data.visits[person.id] = { age = age, count = visitsAt(data, person.id, age) + 1 }\n	-- Visiting someone is an act of social agency. Each visit earns the right\n	-- to one ambient event this chapter, capped so the player cannot bank\n	-- hundreds of visits and then sit still while the world dumps content.\n	EventService.AwardAutonomy(player, 1)\n\n	-- Record this interaction in NPC memory. The line they said back is what\n	-- the player will remember -- a refused ask keeps the refused line, a yes\n	-- keeps the offer's promise. Rolling buffer of 5 per person, oldest dropped.\n	local interactionLine = if refused\n		then (offer.refusedLine or person.busyLine)\n		else (offer.yesLine or offer.line or person.busyLine)\n	recordInteraction(data, person.id, age, interactionLine)\n\n	-- A refused ask keeps a share of what saying yes would have been worth: you turned up\n	-- and you asked, and the turning up happened either way. Rounded away from zero on\n	-- purpose, so a share that would round down to nothing still moves something -- the\n	-- difference between a softened blow and no softening at all.\n	--\n	-- Only for an ask that pays bond, though. The two loans cost bond to accept, because\n	-- taking money off your mother is not free with her -- and a refusal must not hand\n	-- that back as a *gain*. Zero is the honest answer there: she said no, and nothing\n	-- about the two of you moved.\n	--\n	-- Computed here rather than after the defining moment below, which is the fix: that\n	-- block reads it, and it was declared eighteen lines further down. A local is not in\n	-- scope above its own declaration, so the read was a *global* -- nil -- and `nil > 0`\n	-- threw on every conversation the player did not get refused on. Every accepted offer\n	-- in the game died on that line, after the visit had already been spent.\n	local bondGain = if refused\n		then (if offer.bond > 0 then math.max(math.round(offer.bond * PEOPLE.RefusedBondShare), 1) else 0)\n		else offer.bond\n\n	-- A defining moment is the strongest interaction yet -- the line said at the\n	-- highest bond this person has ever reached with the player. Replaces the\n	-- previous defining moment for this person only.\n	if not refused then\n		local existing = data.definingMoment[person.id]\n		if existing == nil or bondGain > 0 then\n			data.definingMoment[person.id] = {\n				personId = person.id,\n				age = age,\n				line = interactionLine,\n			}\n		end\n	end\n\n	data.bonds[person.id] = math.clamp(bondOf(data, person) + bondGain, PEOPLE.MinBond, PEOPLE.MaxBond)\n\n	-- Check whether a bond milestone was just crossed, and seed gossip about it.\n	local newBond = data.bonds[person.id]\n	for _, milestone in PEOPLE.BondMilestones do\n		if newBond >= milestone then\n			local key = person.id .. \"_\" .. milestone\n			if data.bondMilestones[key] ~= true then\n				data.bondMilestones[key] = true\n				local label = milestoneLabel(milestone)\n				GossipService.OnBondMilestone(player, person.name, label)\n				BOND_MILESTONE:FireClient(player, {\n					person = person.name,\n					milestone = milestone,\n					label = label,\n				})\n			end\n		end\n	end\n\n	if refused then\n		-- Nothing else moves. The stats and the money are what the favour *was*, and a\n		-- favour that was not done cannot pay half of itself out.\n		if stand ~= nil then\n			stand.visitor.talk()\n		end\n		-- Validated at content load, so an ask always has one. The fallback is here\n		-- because a missing line would otherwise show an empty row rather than a person.\n		reply(chat, offer.refusedLine or person.busyLine, false)\n		if stand ~= nil then\n			refreshOverhead(player, stand)\n		end\n		push(player)\n		return true\n	end\n\n	-- What this leaves behind, written before anything that yields or can fail. Same\n	-- ordering rule EventService uses on an answer, and for the same reason: the record\n	-- of what you did and the thing you did are one write, so there is no window in which\n	-- a payout has landed and the fact that earned it has not.\n	--\n	-- Cleared before set, so an offer that does both ends up holding what it sets.\n	if offer.clears ~= nil then\n		for _, flagId in offer.clears do\n			data.flags[flagId] = nil\n		end\n	end\n	if offer.sets ~= nil then\n		for _, flagId in offer.sets do\n			-- Not overwritten if already held, exactly as on an event answer: the age on\n			-- a flag is the year the life first did this, and it should not be quietly\n			-- moved to the present by doing it again.\n			if data.flags[flagId] == nil then\n				data.flags[flagId] = age\n			end\n		end\n	end\n\n	-- The rung. Guarded rather than assigned, because the panel was built from a snapshot\n	-- of the life and a birthday or another answer can have landed between it opening and\n	-- this row being clicked -- and the two ways that matters are the two ways it would\n	-- be wrong: a tie that has since been climbed past must not be walked back down, and\n	-- a capped rung somebody else has taken in the meantime must not be handed out twice.\n	local gives = offer.gives\n	if gives ~= nil then\n		local held = data.ties[person.id]\n		local room = People.TieRoom(data.ties, age, data.flags)\n		-- The same test `People.OffersFor` used to decide the row was worth showing, so what\n		-- is conferred here can never disagree with what was offered there. On the ladder\n		-- `Ties.Meets` is \"at this rung or above\", so a tie already climbed past is not\n		-- walked back down. Off the ladder it is \"is exactly this\", which is what lets an\n		-- enemy replace a friend, a sibling, even a rival -- the ladder being burned is the\n		-- point, and the only way to have an enemy is to have had a relationship first.\n		if not Ties.Meets(held, gives) and not room[gives] then\n			data.ties[person.id] = gives\n		end\n	end\n\n	local stats = offer.stats\n	if stats ~= nil then\n		for statName, delta in stats do\n			StatService.AddStat(player, statName :: StatName, delta)\n		end\n	end\n\n	local money = offer.money\n	if money ~= nil then\n		MoneyService.Add(player, money, `{person.id}:{offer.id}`)\n	end\n\n	-- A flag that moved can have changed who is in the life at all -- people gate on\n	-- flags exactly as offers do -- and waiting for the next birthday to notice would\n	-- mean earning somebody and then standing in an empty room for a year. Only when\n	-- flags actually moved: a tie needs no rebuild, because nobody anywhere is gated on\n	-- one and the plate over their head is refreshed below either way.\n	if offer.sets ~= nil or offer.clears ~= nil then\n		requestRebuild(player)\n	end\n\n	if stand ~= nil then\n		stand.visitor.talk()\n	end\n	reply(chat, offer.line, offer.bond >= 0)\n\n	-- A walk offer is the one offer whose content is the person leaving with you: nothing\n	-- else happens on it, just the lease and the walk. The lease is set before Start --\n	-- Start is the thing that reads it, and the despawn pass can run between these lines.\n	-- It is the visitor already standing in front of you that walks, so no double is ever\n	-- spawned and there is no ownership to hand back when the walk ends.\n	--\n	-- Walks are cut out of the phone list before it is offered, so this branch cannot\n	-- actually run with `stand == nil` -- it is guarded for the type checker, not for the\n	-- game: a person you are talking to through the roster has no legs to walk with.\n	local walksTo = offer.walksTo\n	if walksTo ~= nil and stand ~= nil then\n		local mine = leased[player]\n		if mine == nil then\n			mine = {}\n			leased[player] = mine\n		end\n		mine[person.id] = true\n		local started = CompanionService.Start(\n			player,\n			stand.visitor,\n			stand.roam,\n			walksTo,\n			offer.arrivalLine or \"\",\n			nameOf(person),\n			function()\n				local owned = leased[player]\n				if owned ~= nil then\n					owned[person.id] = nil\n				end\n				refreshAllOverhead(player)\n			end\n		)\n		if not started then\n			mine[person.id] = nil\n			warn(`[AGES] walk to \"{walksTo}\" did not start for \"{person.id}\"`)\n		end\n	end\n\n	if stand ~= nil then\n		refreshOverhead(player, stand)\n	end\n	-- A take can change who has anything left to say -- the visit is spent, the bond moved\n	-- -- so the roster is refreshed off the same answer.\n	pushRoster(player)\n	push(player)\n	return true\nend\n\n-- The nearest person within reach, or nil. Nearest rather than first found, because two\n-- parents in one room stand a few studs apart and walking up to your father should not\n-- get you your mother on the strength of table order.\nlocal function nearest(player: Player, position: Vector3): Standing?\n	local here = standing[player]\n	if here == nil then\n		return nil\n	end\n\n	local best: Standing? = nil\n	local bestDistance = PEOPLE.ReachStuds\n	for _, stand in here do\n		if stand.visitor.gone() then\n			continue\n		end\n		local distance = Ground.FlatDistance(position, stand.visitor.at())\n		if distance <= bestDistance then\n			best = stand\n			bestDistance = distance\n		end\n	end\n	return best\nend\n\n-- Being spoken to. They stop walking and turn to look at whoever walked up.\n--\n-- Two halves of one gesture and both are needed. Stopping without turning leaves you\n-- talking to somebody's back; turning without stopping has them square up to you and\n-- then stroll off mid-sentence, which is worse than either. Called every tick rather\n-- than once, so the turn follows a player who circles them.\n--\n-- Skipped entirely while the person is walking with you. Their facing is the walk's to\n-- aim -- it stands them behind you and turns them to you when you stop -- and a hold\n-- that fought it would have somebody sliding sideways down the street, two drivers on\n-- one body.\nlocal function holdFor(player: Player, stand: Standing, position: Vector3)\n	if isLeased(player, stand.person.id) then\n		return\n	end\n	local roam = stand.roam\n	if roam ~= nil then\n		roam.pause()\n	end\n	stand.visitor.face(position)\nend\n\n-- Letting go. The order matters: the hold is what has AutoRotate switched off, so\n-- releasing it after the walk resumed would be a step or two of somebody sliding\n-- sideways down the street before they turned to face where they were going.\n--\n-- Skipped while the person is walking with you for the same reason the hold is: the\n-- walk paused the roam when it started and resumes it when it ends, and a release that\n-- resumed it early would be the walk and the wander fighting over one set of legs.\nlocal function release(player: Player, stand: Standing)\n	if isLeased(player, stand.person.id) then\n		return\n	end\n	stand.visitor.face(nil)\n	local roam = stand.roam\n	if roam ~= nil then\n		roam.resume()\n	end\nend\n\n-- Walking away. Nothing to take down -- the dots belong to the person and stay with\n-- them -- so this is only the game forgetting what it had worked out, which is also what\n-- makes walking a step away and back the way to get a stale panel recomputed.\n--\n-- It is also where somebody goes back to their day, and that has to happen here rather\n-- than at any of the places a conversation ends: there are several of those and only one\n-- of this, and a person left held forever is a person who never walks again.\nlocal function closeChat(player: Player)\n	local chat = chats[player]\n	chats[player] = nil\n	if chat == nil then\n		return\n	end\n	local here = standing[player]\n	local stand = if here ~= nil then here[chat.personId] else nil\n	if stand ~= nil and not stand.visitor.gone() then\n		release(player, stand)\n	end\nend\n\n-- The town, one second at a time: everybody who has no body walks a little further, and\n-- then the set of people close enough to deserve one is compared against what it was.\n--\n-- Both halves on one clock rather than two, and that is deliberate -- the second question\n-- is asked about the answer to the first, and a presence check running against positions\n-- from a different tick would build somebody at where they used to be.\n--\n-- Slower than the conversation tick because it is asking where in town somebody is, which\n-- changes on the scale of a walk rather than of a frame. The comparison is against the\n-- digest rather than against the rig list for the same reason: this has to be cheap enough\n-- to run forever and do nothing, because doing nothing is the answer almost every time.\nlocal function tickTown(player: Player, elapsed: number)\n	local profile = DataService.GetProfile(player)\n	if profile == nil or not enabled or not Lives.Active(profile.Data).alive then\n		return\n	end\n	-- Mid-rebuild. The pass in flight is already measuring presence for itself, and moving\n	-- people underneath it would put somebody between the take-down and the spawn.\n	if rebuilding[player] then\n		return\n	end\n\n	local mine = ghosts[player]\n	if mine == nil then\n		return\n	end\n\n	if Roam.IsEnabled() then\n		local here = standing[player]\n		for id, ghost in mine do\n			-- Only the bodiless. Anybody with a rig is being walked by Roblox along this\n			-- same wander, and integrating them as well would be two things moving one\n			-- person -- the position would arrive at the far end of town while the body\n			-- was still crossing the road.\n			local stand = if here ~= nil then here[id] else nil\n			if stand == nil or stand.visitor.gone() then\n				stepGhost(ghost, elapsed)\n			end\n		end\n	end\n\n	local digest = townDigest(townInRange(player, characterPosition(player)))\n	if presence[player] == digest then\n		return\n	end\n	requestRebuild(player)\nend\n\nlocal function tickPlayer(player: Player, elapsed: number)\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return\n	end\n	local data = Lives.Active(profile.Data)\n	local position = characterPosition(player)\n\n	local chat = chats[player]\n	if chat ~= nil then\n		local here = standing[player]\n		local stand = if here ~= nil then here[chat.personId] else nil\n\n		-- A conversation on the phone. There is no body to walk away from, so the\n		-- ends that matter are different: the person we called is now in the room, which\n		-- hands the conversation straight back to the walk-up path; somebody else is\n		-- standing in reach, which means the next tick's `open` would overwrite us anyway,\n		-- so we end cleanly first.\n		if chat.remote then\n			if not enabled or not data.alive or position == nil then\n				closeChat(player)\n				push(player)\n				return\n			end\n\n			if stand ~= nil and not stand.visitor.gone() then\n				closeChat(player)\n				open(player, data, stand)\n				return\n			end\n\n			if nearest(player, position) ~= nil then\n				closeChat(player)\n				push(player)\n				return\n			end\n\n			if chat.replyLeft > 0 then\n				chat.replyLeft -= elapsed\n				if chat.replyLeft <= 0 then\n					chat.replyLeft = 0\n					chat.replyText = nil\n				end\n			end\n			push(player)\n			return\n		end\n\n		-- Every way a conversation ends by itself, asked before anything is asked of the\n		-- player. Walking away is the only one of these that is a choice.\n		if\n			not enabled\n			or not data.alive\n			or position == nil\n			or stand == nil\n			or stand.visitor.gone()\n			or Ground.FlatDistance(position, stand.visitor.at()) > PEOPLE.ReachStuds\n		then\n			closeChat(player)\n			push(player)\n			return\n		end\n\n		-- Re-aimed every tick, so somebody who walks around the person they are talking\n		-- to is followed rather than left looking at where they used to be.\n		holdFor(player, stand, position)\n\n		if chat.replyLeft > 0 then\n			chat.replyLeft -= elapsed\n			if chat.replyLeft <= 0 then\n				chat.replyLeft = 0\n				chat.replyText = nil\n			end\n			push(player)\n			return\n		end\n\n		push(player)\n		return\n	end\n\n	if not enabled or not data.alive or position == nil then\n		return\n	end\n\n	local found = nearest(player, position)\n	if found ~= nil then\n		-- Held before the greeting rather than after, so a walker is stopped on the tick\n		-- they are reached instead of taking one more stride out of range and closing the\n		-- conversation that just opened.\n		holdFor(player, found, position)\n		open(player, data, found)\n\n		-- Record the approach the first tick the player reaches this person. A player\n		-- standing still next to the same NPC does not count as a new approach on every\n		-- tick; the target is cleared when the player walks away or a different person\n		-- is reached.\n		local target = approachTarget[player]\n		if target == nil or target ~= found.person.id then\n			local list = approaches[player]\n			if list == nil then\n				list = {}\n				approaches[player] = list\n			end\n			table.insert(list, { at = os.clock(), personId = found.person.id })\n			if #list > 20 then\n				table.remove(list, 1)\n			end\n			approachTarget[player] = found.person.id\n		end\n	else\n		approachTarget[player] = nil\n	end\nend\n\n-- Something picked off the panel in front of somebody.\n--\n-- Everything the client sent is re-derived here rather than trusted: which person, that\n-- they are still standing there, that the player is still next to them, and that the\n-- offer is one of the ones this profile was actually shown. The client is a screen. What\n-- it says arrived is only ever a question.\nlocal function onOfferRequested(player: Player, personId: unknown, offerId: unknown)\n	if type(personId) ~= \"string\" or type(offerId) ~= \"string\" then\n		return\n	end\n	if not enabled then\n		return\n	end\n	local profile = DataService.GetProfile(player)\n	if profile == nil or not Lives.Active(profile.Data).alive then\n		return\n	end\n\n	-- `done` is the whole of the double-click defence. `take` sets it before it pays\n	-- anything out, so a second click behind the first stops here.\n	local chat = chats[player]\n	if chat == nil or chat.done or chat.personId ~= personId then\n		return\n	end\n\n	local here = standing[player]\n	local stand = if here ~= nil then here[personId] else nil\n	if stand == nil or stand.visitor.gone() then\n		return\n	end\n\n	-- Checked again rather than taken from the fact that a conversation is open, because\n	-- the panel stays up while the player walks: this is what stops somebody opening the\n	-- dots on their mother and then collecting from the far side of the house.\n	local position = characterPosition(player)\n	if position == nil or Ground.FlatDistance(position, stand.visitor.at()) > PEOPLE.ReachStuds then\n		return\n	end\n\n	take(player, Lives.Active(profile.Data), chat, stand, offerId)\nend\n\n-- A conversation started off the roster, without a body in the room. Same shape as `open`\n-- -- the profile, the offers, the once-a-year visit -- but the person is resolved from\n-- their id rather than a standing rig, `remote` marks it for the panel and the tick, and\n-- the walks are cut out because a phone call has no legs.\nlocal function openRemote(player: Player, data: LifeData, person: Person): boolean\n	local chat: Chat = {\n		personId = person.id,\n		offers = {},\n		done = false,\n		replyLeft = 0,\n		replyText = nil,\n		replyGood = false,\n		remote = true,\n	}\n	chats[player] = chat\n\n	local age = ageYearsOf(data)\n	if visitsAt(data, person.id, age) >= PEOPLE.VisitsPerYear then\n		chat.done = true\n		reply(chat, person.busyLine, false)\n		push(player)\n		return true\n	end\n\n	local callable = callableOffers(data, person)\n	if #callable == 0 then\n		-- The roster's green dot is callable offers, so this cannot happen while the\n		-- roster and this function read the same list. Said out loud for the same reason\n		-- `open` says its own impossible case out loud.\n		chat.done = true\n		reply(chat, person.busyLine, false)\n		push(player)\n		return true\n	end\n\n	chat.offers = callable\n	push(player)\n	return true\nend\n\n-- A name tapped on the roster. Everything the client sent is re-derived rather than\n-- trusted, exactly as on an offer: that the person is real and in this life, and -- for\n-- the one rule worth refusing over -- that no other conversation is already open.\nlocal function onContactRequested(player: Player, personId: unknown)\n	if type(personId) ~= \"string\" then\n		return\n	end\n	if not enabled then\n		return\n	end\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return\n	end\n	local data = Lives.Active(profile.Data)\n	if not data.alive then\n		return\n	end\n\n	-- The one-chat rule, refused out loud. There is no panel to overwrite here -- the\n	-- roster is not in the room with you -- so the player who taps somebody while already\n	-- mid-conversation gets told rather than silently ignored.\n	local chat = chats[player]\n	if chat ~= nil and not chat.done then\n		if chat.personId == personId then\n			push(player)\n		else\n			NoticeRemote:FireClient(player, \"You're already in the middle of a conversation.\")\n		end\n		return\n	end\n\n	local person = People.ById[personId]\n	if person == nil or not People.IsAround(person, ageYearsOf(data), data.flags) then\n		return\n	end\n\n	-- If the person we are calling is actually standing within reach, the tap is really\n	-- a walk-up: open in person, so the dots and the reaction are real.\n	local here = standing[player]\n	local stand = if here ~= nil then here[personId] else nil\n	if stand ~= nil and not stand.visitor.gone() then\n		local position = characterPosition(player)\n		if position ~= nil and Ground.FlatDistance(position, stand.visitor.at()) <= PEOPLE.ReachStuds then\n			open(player, data, stand)\n			return\n		end\n	end\n\n	openRemote(player, data, person)\nend\n\n-- Forgets this player entirely. The people themselves go with `despawnAll`, and their\n-- dots go with them -- there is nothing of this player's left in the workspace once\n-- their rigs are gone.\nlocal function forget(player: Player)\n	closeChat(player)\n	despawnAll(player)\n	unplaced[player] = nil\n	presence[player] = nil\n	pushed[player] = nil\n	pushedRoster[player] = nil\n	rebuilding[player] = nil\n	rebuildAgain[player] = nil\n	approaches[player] = nil\n	approachTarget[player] = nil\nend\n\n-- A birthday. Positives ratchet; decay is removed. Bonds only rise when you turn up;\n-- they never fall from absence. The roster is rebuilt because a year is when people\n-- arrive in a life and leave it.\n--\n-- LifeService calls this after the age has moved, so the year being judged is the one\n-- just left: the age reached, less one. Getting that off by one would charge for a year\n-- somebody was not around for and let the year they arrived go unjudged.\nfunction PeopleService.OnAgeUp(player: Player)\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return\n	end\n	local data = Lives.Active(profile.Data)\n\n	-- No decay loop. Bonds are ratcheted gains only -- see Config.People.DecayPerYearAway = 0.\n\n	requestRebuild(player)\n	-- Ahead of the rebuild as well as inside it. The rebuild yields on avatar builds, and\n	-- the year rolling over is what re-lights everybody -- a street that stays dark for\n	-- however long a web call takes is a street that looks like it has nothing in it.\n	refreshAllOverhead(player)\n	push(player)\nend\n\n-- A new life. Nobody inherits a relationship, which is the point: a bond that survived\n-- the person who had it would be the one thing in this game death did not cost.\n--\n-- Called twice by LifeService -- once when the player dies and once when the next one\n-- starts -- and safe both times. The rebuild is delayed so the death screen is read over\n-- an empty room rather than over four relatives waiting to meet the next occupant.\nfunction PeopleService.ResetForNewLife(player: Player)\n	closeChat(player)\n	despawnAll(player)\n	push(player)\n\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return\n	end\n	Lives.Active(profile.Data).bonds = {}\n	Lives.Active(profile.Data).visits = {}\n	-- Emptied with the bonds, and this one is the harder half to accept: the friend the\n	-- last life earned is that person's friend, not the next child's. A tie that outlived\n	-- its owner would be the one relationship in the game death did not cost, and it\n	-- would also be nonsense -- the town is thirty adults, and a newborn who arrives\n	-- already being somebody's closest friend has not been born, they have been restored.\n	Lives.Active(profile.Data).ties = {}\n\n	task.delay(PEOPLE.RespawnDelaySeconds, function()\n		-- Re-read rather than closing over the profile: the player can leave, or die\n		-- again, inside the delay.\n		if DataService.GetProfile(player) ~= profile then\n			return\n		end\n		requestRebuild(player)\n	end)\nend\n\n-- Studio harness: sets what somebody thinks of this player, so the offers a bond unlocks\n-- can be stood in front of without spending a childhood earning them.\nfunction PeopleService.SetBond(player: Player, personId: string, bond: number): boolean\n	local profile = DataService.GetProfile(player)\n	local person = People.ById[personId]\n	if profile == nil or person == nil then\n		return false\n	end\n	Lives.Active(profile.Data).bonds[personId] = math.clamp(bond, PEOPLE.MinBond, PEOPLE.MaxBond)\n\n	-- The offers held for them were worked out from the old number, so they are wrong now.\n	-- Dropped rather than recomputed in place: a panel the player already has open would\n	-- otherwise silently become a different list of things than the one they are reading.\n	local chat = chats[player]\n	if chat ~= nil and chat.personId == personId then\n		closeChat(player)\n	end\n	refreshAllOverhead(player)\n	push(player)\n	return true\nend\n\n-- What the life is to everybody in it, for the harness. Only the people who are actually\n-- something -- a list that named all thirty-four would be thirty-odd rows of \"nothing in\n-- particular\" hiding the two that matter.\nfunction PeopleService.DescribeTies(player: Player): string\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return \"ties | no profile\"\n	end\n	local data = Lives.Active(profile.Data)\n	local age = ageYearsOf(data)\n\n	local rows: { string } = {}\n	local lapsed = 0\n	for _, person in People.All do\n		local tieId = data.ties[person.id]\n		if tieId == nil then\n			continue\n		end\n		local label = Ties.LabelOf(tieId) or tieId\n		-- Marked rather than hidden, because \"why is nobody offering me the closest-friend\n		-- row\" and \"why *is* somebody offering it when I already have one\" are the two\n		-- questions this command exists to answer, and both turn on exactly this.\n		if People.IsAround(person, age, data.flags) then\n			table.insert(rows, `{nameOf(person)}: {label}`)\n		else\n			lapsed += 1\n			table.insert(rows, `{nameOf(person)}: {label} (lapsed)`)\n		end\n	end\n\n	local room = People.TieRoom(data.ties, age, data.flags)\n	local capped: { string } = {}\n	for _, def in Ties.All do\n		if def.limit ~= nil then\n			table.insert(capped, `{def.id} {if room[def.id] then \"full\" else \"open\"}`)\n		end\n	end\n\n	local head = `ties | {#rows} held, {lapsed} lapsed | {table.concat(capped, \", \")}`\n	if #rows == 0 then\n		return `{head} | nobody in particular yet`\n	end\n	return `{head} | {table.concat(rows, \" · \")}`\nend\n\n-- Approach-rate debug. Reports seconds-since-last-approach and the rolling average of\n-- the last twenty intervals, so the quota (\"at least one approach per sixty seconds\n-- of walking\") is visible rather than assumed.\n--\n-- Returns nil when there is no data to report.\nfunction PeopleService.DescribeApproaches(player: Player): string?\n	local list = approaches[player]\n	if list == nil or #list < 2 then\n		return nil\n	end\n\n	local now = os.clock()\n	local last = list[#list]\n	local secondsSince = now - last.at\n\n	-- Rolling average of the intervals between the last twenty approaches.\n	local total = 0.0\n	for i = 2, #list do\n		total += list[i].at - list[i - 1].at\n	end\n	local average = total / (#list - 1)\n\n	return `approaches | last {math.floor(secondsSince)}s ago | rolling avg {math.floor(average)}s | {#list} recorded`\nend\n\n-- Studio harness: makes somebody what they would otherwise take a childhood of turning up\n-- to become, so the offers a tie unlocks can be stood in front of. Deliberately ignores\n-- the cap -- this is the one place that should be able to produce the state a capped rung\n-- is supposed to make impossible, because that is the state worth testing.\nfunction PeopleService.SetTie(player: Player, personId: string, tieId: string?): boolean\n	local profile = DataService.GetProfile(player)\n	local person = People.ById[personId]\n	if profile == nil or person == nil then\n		return false\n	end\n	if tieId ~= nil and Ties.ById[tieId] == nil then\n		return false\n	end\n	Lives.Active(profile.Data).ties[personId] = tieId\n\n	-- Same reason SetBond drops the open panel: the rows the player is reading were\n	-- worked out from the old answer, and a tie changes which of them exist.\n	local chat = chats[player]\n	if chat ~= nil and chat.personId == personId then\n		closeChat(player)\n	end\n	refreshAllOverhead(player)\n	push(player)\n	return true\nend\n\n-- Studio harness: clears the once-a-year cap, so the same visit can be run again without\n-- waiting on a birthday.\nfunction PeopleService.ClearVisits(player: Player): boolean\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return false\n	end\n	Lives.Active(profile.Data).visits = {}\n	closeChat(player)\n	refreshAllOverhead(player)\n	push(player)\n	return true\nend\n\n-- Everybody currently standing in the world for this player, as ids and positions.\n--\n-- Exists for WitnessService, which needs to know who can see a wanted player and must not\n-- be given the rigs to find out: a service that could reach a Visitor could pause a walk,\n-- turn a head or destroy a body, and the crowd's only business is looking. Positions rather\n-- than handles is the whole of the encapsulation, and it is the same argument Till makes\n-- about handing out a Vector3 instead of a piece of shop furniture.\n--\n-- Includes the family, who are people too and who live in rooms the player has every reason\n-- to hide in. A mother who does not notice her son sprinting through the kitchen with the\n-- police outside would be a strange thing to have built on purpose.\nexport type Bystander = {\n	personId: string,\n	position: Vector3,\n}\n\nfunction PeopleService.Bystanders(player: Player): { Bystander }\n	local out: { Bystander } = {}\n	local here = standing[player]\n	if here == nil then\n		return out\n	end\n	for personId, stand in here do\n		local visitor = stand.visitor\n		if visitor.gone() then\n			continue\n		end\n		table.insert(out, { personId = personId, position = visitor.root.Position })\n	end\n	return out\nend\n\n-- Everybody who exists in the world for this player, bodied or ghost, keyed by\n-- person id. The body is what matters for tags: a person whose rig has not yet\n-- arrived is still a person, and the context builder must not lose them the\n-- moment the player steps far enough away to dissolve the model.\nfunction PeopleService.GetPersonPositions(player: Player): { [string]: Vector3 }\n	local out: { [string]: Vector3 } = {}\n	local here = standing[player] or {}\n	for personId, stand in here do\n		local visitor = stand.visitor\n		if visitor.gone() then\n			continue\n		end\n		out[personId] = visitor.at()\n	end\n	local mine = ghosts[player] or {}\n	for personId, ghost in mine do\n		if out[personId] == nil then\n			out[personId] = ghost.at\n		end\n	end\n	return out\nend\n\n-- Somebody stops walking and turns to look, or goes back to what they were doing.\n--\n-- The reaction, and it is the whole of the crowd's signposting: a witness is on screen for\n-- Config.Crime.Witness.SeeSeconds *before* the report lands, which is the player's warning\n-- and their chance to walk out of it. The gesture is deliberately the same one a person\n-- makes when you walk up to talk to them -- stop, turn -- because a town has one vocabulary\n-- and a second \"notice\" animation would read as a different kind of creature.\n--\n-- Refused outright while the player is mid-conversation with them. Two systems driving one\n-- pair of legs is the bug the hold and release below were written to avoid, and a chat is\n-- the one that was there first.\nfunction PeopleService.Alarm(player: Player, personId: string, at: Vector3?): boolean\n	local here = standing[player]\n	local stand = if here ~= nil then here[personId] else nil\n	if stand == nil or stand.visitor.gone() then\n		return false\n	end\n	local chat = chats[player]\n	if chat ~= nil and chat.personId == personId then\n		return false\n	end\n	if at == nil then\n		release(player, stand)\n	else\n		holdFor(player, stand, at)\n	end\n	return true\nend\n\n-- Off empties the street of everybody, on puts them back. Applied to every player rather\n-- than to whoever typed it, because this is a switch on the world and a server with\n-- people in it for one player and not another would be a worse test than either state.\nfunction PeopleService.SetEnabled(value: boolean)\n	enabled = value\n	for _, player in Players:GetPlayers() do\n		if not value then\n			closeChat(player)\n			push(player)\n		end\n		requestRebuild(player)\n	end\nend\n\n-- What the harness prints. Everybody who should be in this life, whether they are\n-- standing in it, and what they think of the player -- in that order, because that is\n-- the order the questions get asked in when somebody is missing.\n--\n-- The four only. The town is thirty more rows of the same shape and would push the\n-- family off the top of the output, which is the one thing this command exists to show;\n-- `/town` answers for them, and it can answer in the terms that actually matter for a\n-- stranger -- where they are and whether they have a body -- rather than these.\nfunction PeopleService.Describe(player: Player): string\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return \"people: no profile loaded\"\n	end\n	local data = Lives.Active(profile.Data)\n	local age = ageYearsOf(data)\n\n	local here = standing[player] or {}\n	local missing = unplaced[player] or {}\n\n	local lines: { string } = {}\n	for _, person in People.All do\n		if People.IsTown(person.id) or not People.IsAround(person, age, data.flags) then\n			continue\n		end\n		local bond = bondOf(data, person)\n		local where = if here[person.id] ~= nil\n			then `at {person.placeId}`\n			else `NOT SPAWNED ({missing[person.id] or \"no reason recorded\"})`\n		local seen = visitsAt(data, person.id, age)\n		local visited = if seen > 0 then `, seen {seen}/{PEOPLE.VisitsPerYear} this year` else \"\"\n		local offers = People.OffersFor(person, offerContext(data, person))\n		-- The odds spelled out as a figure, which is the one place in this system they\n		-- are. The panel says \"a long shot\" because the player is making a judgement;\n		-- a harness needs to know whether the number behind it is the one intended.\n		local asks: { string } = {}\n		for _, offer in offers do\n			if offer.ask then\n				table.insert(asks, `{offer.id} {math.round(refusalChance(offer, bond) * 100)}% no`)\n			end\n		end\n		local risk = if #asks > 0 then `, asks: {table.concat(asks, \", \")}` else \"\"\n		table.insert(lines, `{person.id} {where}, {bond} ({bandFor(bond)}), {#offers} offers{visited}{risk}`)\n	end\n	if #lines == 0 then\n		table.insert(lines, `nobody is in this life at age {age}`)\n	end\n\n	local talking = \"not talking to anybody\"\n	local chat = chats[player]\n	if chat ~= nil then\n		talking = `next to {chat.personId}, {#chat.offers} offers`\n			.. (if chat.done then \", nothing left to take\" else \"\")\n	end\n\n	return string.format(\n		\"people: %s | refusals %s | age %d | %s | %s | town: see /town\",\n		if enabled then \"enabled\" else \"DISABLED\",\n		refusalMode,\n		age,\n		talking,\n		table.concat(lines, \" · \")\n	)\nend\n\n-- The town, in the terms a town raises. Not \"who is missing\" -- thirty people with no\n-- bodies is the normal state of this system -- but where the player is, how much of the\n-- rig budget is spent, and who is close enough to walk up to.\n--\n-- `OldestShownAge` is reported as a count rather than left implicit, because a plate with\n-- no age on it is the game declining to claim a number it does not model, and a hole like\n-- that should be visible from the harness instead of only from the pavement.\nexport type TownDetail = \"summary\" | \"all\" | \"bodied\"\n\nfunction PeopleService.DescribeTown(player: Player, detail: TownDetail): string\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return \"town: no profile loaded\"\n	end\n	local data = Lives.Active(profile.Data)\n	local age = ageYearsOf(data)\n\n	local here = standing[player] or {}\n	local mine = ghosts[player] or {}\n	local position = characterPosition(player)\n	local nearPlaces = nearPlacesFor(position)\n\n	local inLife = 0\n	local bodied = 0\n	local ageless = 0\n	local rows: { { text: string, distance: number } } = {}\n\n	-- People close enough to your own age to be your contemporaries, counted separately\n	-- from the roster because the roster answers \"is the town there\" and this answers \"is\n	-- there anybody in it your age\", and for most of adulthood those had wildly different\n	-- answers. Not split by anything: there is no partner system, so every peer counts the\n	-- same, and the number that matters is simply whether it is zero.\n	local peers = 0\n\n	-- The youngest the player could be and have anybody in the town at all. Only ever\n	-- printed when the answer is nobody, and it is the reading that would have saved the\n	-- most time: an empty street looks exactly like a spawner that has stopped working,\n	-- and the one thing that tells the two apart is that an age window has not opened yet.\n	local soonest: number? = nil\n\n	for _, person in People.All do\n		if not People.IsTown(person.id) then\n			continue\n		end\n		if not People.IsAround(person, age, data.flags) then\n			-- Read through a local rather than compared against the upvalue directly, so the\n			-- nil case is narrowed somewhere the checker can see it across the assignment.\n			local best = soonest\n			if person.minAge > age and (best == nil or person.minAge < best) then\n				soonest = person.minAge\n			end\n			continue\n		end\n		inLife += 1\n		if People.ShownAge(person, age) == nil then\n			ageless += 1\n		end\n\n		local gender = genderOf(person)\n		if isPeer(person) then\n			peers += 1\n		end\n\n		local stand = here[person.id]\n		if stand ~= nil then\n			bodied += 1\n		end\n		if detail == \"summary\" or (detail == \"bodied\" and stand == nil) then\n			continue\n		end\n\n		-- Distance to where they *are*, which for most of the town is a position with no\n		-- rig on it. Reporting the place they belong to instead is what made the old\n		-- listing agree with a bug: everybody read as being at their building because the\n		-- only thing that had ever been measured was their building.\n		local ghost = mine[person.id]\n		local distance = if stand ~= nil and position ~= nil\n			then Ground.FlatDistance(position, stand.visitor.at())\n			elseif ghost ~= nil and position ~= nil then Ground.FlatDistance(position, ghost.at)\n			else math.huge\n		local shown = People.ShownAge(person, age)\n		local roam = if stand ~= nil then stand.roam else nil\n		local body = if stand ~= nil\n			then `{math.round(distance)} studs away, {if roam ~= nil then roam.state() else \"planted\"}`\n			elseif ghost ~= nil\n				then `no body, {math.round(distance)} studs away, {if ghost.goal ~= nil then \"walking\" else \"resting\"}`\n			else \"no body, nowhere to be\"\n		local bond = bondOf(data, person)\n		-- The gender initial is a bare label -- the only place gender surfaces to a human --\n		-- and \"peer\" rides with the age rather than the name, because whether they counted\n		-- in the peer tally above is only legible beside the number that put them there.\n		local marks = if gender ~= nil then string.sub(gender, 1, 1) else \"?\"\n		if isPeer(person) then\n			marks ..= \" peer\"\n		end\n		table.insert(rows, {\n			distance = distance,\n			text = `{person.id} {nameOf(person)} ({People.ArchetypeOf(person.id) or \"?\"}) `\n				.. `at {person.placeId}, age {if shown ~= nil then tostring(shown) else \"hidden\"} `\n				.. `{marks}, bond {bond} ({bandFor(bond)}), {body}`,\n		})\n	end\n\n	-- Nearest first, so the rows a harness cares about -- the people actually in front of\n	-- the player -- are the ones at the top rather than wherever the id order put them.\n	table.sort(rows, function(a, b): boolean\n		if a.distance == b.distance then\n			return a.text < b.text\n		end\n		return a.distance < b.distance\n	end)\n\n	local nearIds: { string } = {}\n	for placeId, distance in nearPlaces do\n		table.insert(nearIds, `{placeId} {math.round(distance)}`)\n	end\n	table.sort(nearIds)\n	local nearText = if #nearIds > 0 then table.concat(nearIds, \", \") else \"nowhere\"\n\n	local peerText = string.format(\"%d within %d years of you\", peers, PEOPLE.PeerAgeGap)\n\n	-- The tagged-point count is here rather than only in the listing because zero is the\n	-- reading that explains the most: it means everyone is wandering to probed spots,\n	-- which is working as designed and looks nothing like people using the streets.\n	--\n	-- The peer count is here for the mirror-image reason: zero peers is a generator that\n	-- put nobody your age in the world, which reads as an empty life even when the roster\n	-- is full -- and those two have to be tellable apart from one line.\n	local head = string.format(\n		\"town: %d in this life at age %d (%s) | %s | %d/%d bodied | \"\n			.. \"walking %s, %d town points tagged | near: %s | %d past age %d so no age shown\",\n		inLife,\n		age,\n		data.gender or \"no gender\",\n		peerText,\n		bodied,\n		TOWN.MaxBodied,\n		if Roam.IsEnabled() then \"on\" else \"OFF\",\n		Routes.NodeCount(),\n		nearText,\n		ageless,\n		TOWN.OldestShownAge\n	)\n\n	-- Zero is the one count that has to explain itself. Every other reading here can be\n	-- chased -- no points tagged, walking OFF, nobody within the radius -- but \"nobody in\n	-- this life\" is indistinguishable from a broken spawner unless the listing says out\n	-- loud that it is an age window rather than a fault. That distinction cost a whole\n	-- debugging session once; it is one line and it never has to cost it again.\n	if inLife == 0 then\n		local first = soonest\n		if first ~= nil then\n			head ..= ` | nobody is around at this age -- the earliest townsfolk turn up at {first}`\n		else\n			head ..= \" | nobody is around at this age, and nobody ever will be -- check Townsfolk\"\n		end\n	end\n\n	if detail == \"summary\" then\n		return head\n	end\n	if #rows == 0 then\n		return `{head} | nobody to list`\n	end\n\n	local texts: { string } = {}\n	for _, row in rows do\n		table.insert(texts, row.text)\n	end\n	return `{head} | {table.concat(texts, \" · \")}`\nend\n\n-- The roads the town walks on, for `/town routes`. Routed through here rather than reached\n-- into from the debug service so that everything `/town` can answer comes from one place --\n-- and because \"how many points are tagged\" and \"who is standing where\" are two halves of\n-- the same question whenever the answer to either is surprising.\nfunction PeopleService.DescribeRoutes(): string\n	return Routes.Describe()\nend\n\n-- The town's legs, all of them at once. The one switch that tells a walking bug apart\n-- from a bonding one: with this off the town is exactly the standing roster Part 1 had,\n-- so anything still wrong is not the walking.\n--\n-- Nobody is taken down or moved, and nobody mid-stride is frozen -- the walk in flight\n-- is called off and they settle where they are, which is also what makes turning it back\n-- on cost nothing.\nfunction PeopleService.SetTownWalking(value: boolean)\n	Roam.SetEnabled(value)\nend\n\n-- Forces or frees the coin behind an ask. Affects the roll only: the words on the panel\n-- still read off the real odds, so \"always\" is a way to see a refusal without also\n-- lying to the player about how likely one was.\nfunction PeopleService.SetRefusalMode(mode: RefusalMode)\n	refusalMode = mode\nend\n\n-- Studio harness, and the hook below. Debounced like every other rebuild request, so\n-- several flags moving in one answer costs one pass over the roster rather than one each.\nfunction PeopleService.Rebuild(player: Player)\n	requestRebuild(player)\nend\n\n-- An answer that changed what this life has done can have changed who is in it, and\n-- waiting for the next birthday to notice would mean earning a friend and then standing\n-- in an empty room for a year. Only when flags actually moved: every other answer in the\n-- game leaves the roster exactly as it was, and rebuilding on all of them would put a\n-- pass over every person behind every choice a player makes.\nlocal function onAnswered(player: Player, _event: Types.LifeEvent, choice: Types.EventChoice)\n	if choice.sets == nil and choice.clears == nil then\n		return\n	end\n	requestRebuild(player)\nend\n\n-- The top of the friendship ladder, which is the boundary a tie has to be *past* before\n-- standing next to that person is worth telling the event system about. Named rather than\n-- written as the number 4, because 4 is not a fact about anything -- it is `closest` plus\n-- one, and it stops being true the day a rung is inserted. A mistyped id here would tag\n-- nobody and fire no events, with no symptom, so it is checked at load.\nlocal TIE_TAG_ABOVE = \"closest\"\nTies.AssertKnown(TIE_TAG_ABOVE, \"PeopleService tie-context tags\")\n\n-- Returns the tie-context tags for a player as a list of strings. Called by\n-- EventService every tick to decide whether a tie-gated event should fire.\nlocal function buildTieContextTags(player: Player): { string }\n	local tags: { string } = {}\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return tags\n	end\n	local data = Lives.Active(profile.Data)\n	local positions = PeopleService.GetPersonPositions(player)\n	local radius = Config.Ambient.NPCContextRadius\n	local playerPos = characterPosition(player)\n	if playerPos == nil then\n		return tags\n	end\n	for personId, position in positions do\n		local tieId = data.ties[personId]\n		if tieId == nil then\n			continue\n		end\n		-- Two kinds of tie earn a tag: the structural slots above the friendship ladder\n		-- (mentor, rival, sibling) and the ties that sit off it entirely (enemy). What\n		-- they have in common is that each names one particular person in a life rather\n		-- than a degree of closeness, which is what makes \"your mentor is standing here\"\n		-- something an event can be about. Being somebody's friend is not -- most of a\n		-- town ends up there, and a tag every one of them carries gates nothing.\n		--\n		-- Asked as \"on the ladder and no higher than the top of it\", so a second off-ladder\n		-- tie is included the day it is declared and needs no edit here. Written as a rank\n		-- comparison guarded by `IsRung` because rank alone cannot answer it: enemy scores\n		-- 0, so the plain comparison excluded the one tie this gate most needs to see.\n		if Ties.IsRung(tieId) and Ties.RankOf(tieId) <= Ties.RankOf(TIE_TAG_ABOVE) then\n			continue\n		end\n		if (playerPos - position).Magnitude <= radius then\n			table.insert(tags, \"tie:\" .. tieId .. \":\" .. personId)\n		end\n	end\n	return tags\nend\n\nfunction PeopleService:Start()\n	EventService.OnAnswered(onAnswered)\n	EventService.SetTieContextBuilder(buildTieContextTags)\n\n	RequestPersonOfferRemote.OnServerEvent:Connect(function(player: Player, personId: unknown, offerId: unknown)\n		local ok, err = pcall(onOfferRequested, player, personId, offerId)\n		if not ok then\n			warn(`[AGES] person offer failed for {player.Name}: {err}`)\n		end\n	end)\n\n	RequestPersonContactRemote.OnServerEvent:Connect(function(player: Player, personId: unknown)\n		local ok, err = pcall(onContactRequested, player, personId)\n		if not ok then\n			warn(`[AGES] person contact failed for {player.Name}: {err}`)\n		end\n	end)\n\n	Players.PlayerAdded:Connect(function(player: Player)\n		task.spawn(function()\n			if DataService.WaitForProfile(player) ~= nil then\n				requestRebuild(player)\n				push(player)\n			end\n		end)\n	end)\n\n	Players.PlayerRemoving:Connect(forget)\n\n	for _, player in Players:GetPlayers() do\n		task.spawn(function()\n			if DataService.WaitForProfile(player) ~= nil then\n				requestRebuild(player)\n			end\n		end)\n	end\n\n	task.spawn(function()\n		while true do\n			local elapsed = task.wait(PEOPLE.TickSeconds)\n			for _, player in Players:GetPlayers() do\n				local ok, err = pcall(tickPlayer, player, elapsed)\n				if not ok then\n					warn(`[AGES] people tick failed for {player.Name}: {err}`)\n				end\n			end\n		end\n	end)\n\n	-- The town walking, and the town coming and going. Its own loop rather than a line in\n	-- the tick above, because that one runs four times a second to keep a panel honest and\n	-- this one is moving thirty people a stride -- a question worth a fraction of that.\n	--\n	-- `elapsed` is the real gap rather than the asked-for one, so the town covers the same\n	-- ground on a struggling server as on an idle one instead of walking in slow motion\n	-- whenever something else is busy.\n	task.spawn(function()\n		while true do\n			local elapsed = task.wait(TOWN.PresenceTickSeconds)\n			for _, player in Players:GetPlayers() do\n				local ok, err = pcall(tickTown, player, elapsed)\n				if not ok then\n					warn(`[AGES] town tick failed for {player.Name}: {err}`)\n				end\n			end\n		end\n	end)\nend\n\nreturn PeopleService\n"
table.insert(AGES_MANIFEST, "src/server/services/PeopleService.luau")
AGES_SOURCES["src/server/services/PlaceService.luau"] = "--!strict\n-- The world's index of itself. Every named spot outside the player's own feet --\n-- the front path, the crossing, a classroom, the shop floor -- is a tagged part\n-- in the built world, and this is the one place that knows how to find them.\n--\n-- The alternative, and the reason this exists, is a table of coordinates in\n-- Luau. That table is correct exactly until somebody nudges a wall in Studio,\n-- and then it is a list of spots inside walls that nothing in the game is in a\n-- position to notice. A tagged part moves when the building moves because it is\n-- part of the building.\n--\n-- What this is not: a teleport network. Send() exists for the harness and for\n-- the recovery cases a system will genuinely need later (clocking off should put\n-- you outside the door, not wherever you were standing when your shift ended).\n-- Ordinary travel is walking, and Part 1 of this slice is only done when the\n-- walk itself works.\n--\n-- Attributes are read at use rather than cached at tag time, matching\n-- DeliveryService and WorldEventService: an id corrected in Studio mid-session\n-- takes effect without a restart.\n\nlocal CollectionService = game:GetService(\"CollectionService\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Config = require(ReplicatedStorage:WaitForChild(\"Config\"))\nlocal Types = require(ReplicatedStorage:WaitForChild(\"Types\"))\n\ntype Place = Types.Place\n\nlocal PlaceService = {}\n\n-- Below this, a flattened look vector is noise rather than a heading. Not a\n-- tunable: it is the floating-point floor of \"this vector points straight up\",\n-- so it lives with the arithmetic it guards rather than in Config.\nlocal FLAT_FACING_EPSILON = 1e-3\n\n-- Everything currently tagged. A set rather than a map by id, because two parts\n-- can carry the same id at once while somebody is mid-edit in Studio, and the\n-- lookup wants to be able to say so rather than silently keep one of them.\nlocal points: { [BasePart]: boolean } = {}\n\nlocal warnedPoints: { [Instance]: boolean } = {}\nlocal warnedIds: { [string]: boolean } = {}\n\nlocal function warnPointOnce(instance: Instance, message: string)\n	if warnedPoints[instance] then\n		return\n	end\n	warnedPoints[instance] = true\n	warn(`[AGES] place point \"{instance:GetFullName()}\" {message}`)\nend\n\n-- The id a point answers to, or nil if it is misconfigured. An untagged-but-\n-- present point looks exactly like a working one nothing has asked for yet, so\n-- the bad cases are said out loud once rather than skipped.\nlocal function pointId(point: BasePart): string?\n	local raw = point:GetAttribute(Config.World.PlacePointAttribute)\n	if raw == nil then\n		warnPointOnce(point, `has no \"{Config.World.PlacePointAttribute}\" attribute, so nothing can ask for it`)\n		return nil\n	end\n	if typeof(raw) ~= \"string\" then\n		warnPointOnce(point, `has a non-string \"{Config.World.PlacePointAttribute}\" attribute`)\n		return nil\n	end\n	if raw == \"\" then\n		warnPointOnce(point, `has an empty \"{Config.World.PlacePointAttribute}\" attribute`)\n		return nil\n	end\n	return raw\nend\n\n-- The human sentence for a point. Falls back to the id rather than to nothing:\n-- a listing with a missing label should still be a listing, because the label is\n-- flavour and the id is the thing you actually need to see.\nlocal function pointLabel(point: BasePart, id: string): string\n	local raw = point:GetAttribute(Config.World.PlacePointLabelAttribute)\n	if typeof(raw) == \"string\" and raw ~= \"\" then\n		return raw\n	end\n	return id\nend\n\n-- Nil when no point carries that id. Warned once per id, not per call, because\n-- the thing asking is likely to be asking on a loop.\nfunction PlaceService.Find(id: string): Place?\n	local found: BasePart? = nil\n	for point in points do\n		if point.Parent == nil then\n			continue\n		end\n		if pointId(point) ~= id then\n			continue\n		end\n		if found ~= nil then\n			-- Two points answering to one name is a build mistake, and picking one\n			-- quietly would mean the game sometimes puts you in the wrong room and\n			-- nothing ever explains why.\n			warnPointOnce(point, `duplicates the id \"{id}\", which \"{found:GetFullName()}\" already answers to`)\n			continue\n		end\n		found = point\n	end\n\n	if found == nil then\n		if not warnedIds[id] then\n			warnedIds[id] = true\n			warn(`[AGES] nothing tagged \"{Config.World.PlacePointTag}\" answers to the place id \"{id}\"`)\n		end\n		return nil\n	end\n\n	-- Copied into a fresh non-optional local, because a refinement on a variable\n	-- the loop above assigns to is not one the type checker will carry this far.\n	local part = found :: BasePart\n	return { id = id, label = pointLabel(part, id), part = part }\nend\n\n-- Every place, sorted by id so a listing reads the same way twice running.\nfunction PlaceService.All(): { Place }\n	local places: { Place } = {}\n	for point in points do\n		if point.Parent == nil then\n			continue\n		end\n		local id = pointId(point)\n		if id == nil then\n			continue\n		end\n		table.insert(places, { id = id, label = pointLabel(point, id), part = point })\n	end\n	table.sort(places, function(a: Place, b: Place): boolean\n		return a.id < b.id\n	end)\n	return places\nend\n\n-- Puts a character down at a place. False when the id is unknown or there is no\n-- body to move, so the caller can say which rather than reporting a move that\n-- never happened.\n--\n-- The lift is not decoration. A place point marks the floor, and a body pivoted\n-- onto the floor is a body half inside it -- either wedged or ejected upward by\n-- the physics solver, both of which look like a bug. Dropping from just above\n-- lets the fall do the seating.\nfunction PlaceService.Send(player: Player, id: string): boolean\n	local place = PlaceService.Find(id)\n	if place == nil then\n		return false\n	end\n\n	local character = player.Character\n	if character == nil then\n		return false\n	end\n\n	-- The player keeps whichever way they were already looking, flattened. A place\n	-- point is a marker, not a pose: taking its rotation would tip the player over\n	-- if the part were ever turned, and taking no rotation at all would spin them\n	-- to face due north for no reason they could work out. Flattening is what\n	-- stands up a character who was mid-fall when this was called.\n	local look = character:GetPivot().LookVector\n	local facing = Vector3.new(look.X, 0, look.Z)\n	if facing.Magnitude < FLAT_FACING_EPSILON then\n		-- Looking straight up or straight down, so there is no heading to keep.\n		facing = -Vector3.zAxis\n	end\n\n	local origin = place.part.Position + Vector3.new(0, Config.World.PlaceDropStuds, 0)\n	character:PivotTo(CFrame.lookAt(origin, origin + facing.Unit))\n	return true\nend\n\nfunction PlaceService:Init() end\n\nfunction PlaceService:Start()\n	local tag = Config.World.PlacePointTag\n\n	local function add(instance: Instance)\n		if instance:IsA(\"BasePart\") then\n			points[instance :: BasePart] = true\n		else\n			warnPointOnce(instance, `is a {instance.ClassName}, which has no position; nothing can be sent to it`)\n		end\n	end\n\n	CollectionService:GetInstanceAddedSignal(tag):Connect(function(instance: Instance)\n		add(instance)\n		-- A point arriving may be the one an earlier lookup complained about --\n		-- someone tagging a part in Studio to fix exactly that. Clearing the whole\n		-- memo rather than reasoning about which id it was keeps the fix quiet.\n		table.clear(warnedIds)\n	end)\n	CollectionService:GetInstanceRemovedSignal(tag):Connect(function(instance: Instance)\n		if instance:IsA(\"BasePart\") then\n			points[instance :: BasePart] = nil\n		end\n		warnedPoints[instance] = nil\n	end)\n	for _, instance in CollectionService:GetTagged(tag) do\n		add(instance)\n	end\nend\n\nreturn PlaceService\n"
table.insert(AGES_MANIFEST, "src/server/services/PlaceService.luau")
AGES_SOURCES["src/server/services/PocketMoneyService.luau"] = "--!strict\n-- Pocket money. From Config.PocketMoney.StartAge to EndAge, every birthday hands\n-- the player a year of an allowance quoted by the week.\n--\n-- The first money in a life that arrives without being earned, and the first thing\n-- in the game that pays out without a prompt attached to it. Both of those are the\n-- point: an economy where every unit came from answering a question is an economy\n-- made entirely of quiz rewards, and pocket money is what makes being a child of a\n-- particular age worth something on its own.\n--\n-- Three steps, and the gap between the first two is the whole feature:\n--\n--   accrue    A birthday counts what it is worth into pocketMoneyOwed.\n--   handover  A parent appears, crosses the room and gives it to the player.\n--   settle    Whatever is owed comes out of the ledger and into the balance.\n--\n-- Accrue is instant and atomic; the handover takes several seconds and can fail in\n-- half a dozen ordinary ways -- a room too tight to put an adult in, a player who\n-- died on the birthday, a child who runs off mid-walk. Money is therefore counted as\n-- owed the moment it is earned and only cleared when it is actually handed across,\n-- so every one of those failures comes out as money *delayed* rather than money\n-- quietly not paid. A retry loop asks again, and after MaxAttempts the money is\n-- simply credited where the player stands.\n--\n-- That fallback is the ugly version on purpose and it is never removed. An allowance\n-- that sometimes fails to arrive is indistinguishable from a broken game, and the\n-- one thing this file will not do is let a scene it could not stage cost the player\n-- anything. It was built before the scene was, for the same reason.\n--\n-- Not a cutscene, and that is a rule rather than a shortcut. Nothing in this game\n-- takes the room away from the player -- an enacted prompt is a banner precisely so\n-- that it cannot -- and thirteen birthdays in a childhood is the worst place in the\n-- game to start seizing the camera. They come to you and you keep control the whole\n-- time; it reads as a scene because somebody crossed a room to find you.\n--\n-- Idempotency lives here rather than in MoneyService, which says so explicitly: the\n-- balance is a dumb, atomic number and every caller is responsible for not paying\n-- twice. pocketMoneyPaidThroughAge is how this one does it.\n\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Config = require(ReplicatedStorage:WaitForChild(\"Config\"))\nlocal Money = require(ReplicatedStorage:WaitForChild(\"Money\"))\nlocal Types = require(ReplicatedStorage:WaitForChild(\"Types\"))\nlocal Lives = require(ReplicatedStorage:WaitForChild(\"Lives\"))\n\nlocal DataService = require(script.Parent.DataService)\nlocal MoneyService = require(script.Parent.MoneyService)\nlocal NPCService = require(script.Parent.NPCService)\nlocal Cast = require(script.Parent.Parent.content.Cast)\nlocal People = require(script.Parent.Parent.content.People)\nlocal Ground = require(script.Parent.Parent.world.Ground)\nlocal MoneyPop = require(script.Parent.Parent.world.MoneyPop)\n\ntype LifeData = Types.LifeData\ntype CastMember = Types.CastMember\ntype Visitor = NPCService.Visitor\n\nlocal PocketMoneyService = {}\n\n-- How far above the head the figure appears when the money simply lands, and how far\n-- above a parent's root when they hand it over -- the second is larger because a\n-- root part sits at the hips and the money should leave their hands. Cosmetic, so\n-- locals: nobody balances this game by adjusting where a number floats.\nlocal POP_LIFT = 1.4\nlocal HANDOVER_POP_LIFT = 1.6\n\n-- Below this a direction is noise rather than a heading -- a player looking straight\n-- down, or a parent asked to face a point they are standing on.\nlocal MIN_DIRECTION = 1e-3\n\n-- How much short of HandoverStuds still counts as having arrived.\n--\n-- Needed because a humanoid told to walk somewhere stops when it is near enough\n-- rather than on the dot, and without any slack the chase would re-aim forever a few\n-- inches out and then time out on a handover the player watched happen. Cosmetic in\n-- the sense that matters: it changes nothing about how close a parent gets, only\n-- about when this file agrees that they got there.\nlocal HANDOVER_SLACK = 0.75\n\n-- Who turns up. Alternating on age rather than chosen at random, so both parents\n-- appear across a childhood and so a birthday replayed in the harness produces the\n-- same person: a scene that is different every time it is run is a scene that cannot\n-- be tested. Even ages are the first of these.\n--\n-- Cast ids rather than Config entries, because these are content -- the recurring\n-- people the house belongs to -- and not numbers anyone tunes.\nlocal PARENTS = { \"mom\", \"dad\" }\n\n-- Which of them a given birthday belongs to. One line, but it is read from three places\n-- -- who is sent, whose bond the allowance is scaled by, and what the harness prints --\n-- and two copies of this that drifted apart would mean a mother handing over money\n-- scaled by her husband's opinion of you.\nlocal function parentIdFor(ageYears: number): string\n	return PARENTS[(ageYears % 2) + 1]\nend\n\n-- What the allowance is worth per week at a given age, in whole units.\n--\n-- Rounded down at the *weekly* rate rather than at the yearly total, because the\n-- weekly figure is the one the player is told and a rate quoted in fractions of a\n-- dollar is not a rate anybody has ever been given. Zero outside the window, which\n-- is what makes the window a fact about the money rather than a check every caller\n-- has to remember to make.\nfunction PocketMoneyService.WeeklyRate(ageYears: number): number\n	if ageYears < Config.PocketMoney.StartAge or ageYears > Config.PocketMoney.EndAge then\n		return 0\n	end\n	return math.floor(ageYears * Config.PocketMoney.WeeklyPerYearOfAge)\nend\n\n-- What a birthday at this age is worth: the weekly rate, multiplied out.\nfunction PocketMoneyService.GrantFor(ageYears: number): number\n	return PocketMoneyService.WeeklyRate(ageYears) * Config.Time.WeeksPerYear\nend\n\n-- What the parent who brings this birthday's money thinks of the player, as a\n-- multiplier on it.\n--\n-- Reads the same parent `parentFor` will send, so the two cannot disagree: the year your\n-- mother is due is the year her bond is the one that counts. One for anybody the game\n-- has no opinion about, and never less than one -- see Config.PocketMoney.BondBonusShare\n-- for why a bad relationship does not take money off a child.\nlocal function parentBonus(data: LifeData, ageYears: number): number\n	local bond = People.BondIn(data.bonds, parentIdFor(ageYears))\n	if bond == nil then\n		return 1\n	end\n	local share = math.clamp(bond, 0, Config.People.MaxBond) / Config.People.MaxBond\n	return 1 + share * Config.PocketMoney.BondBonusShare\nend\n\n-- Counts every birthday not yet counted into what the player is owed.\n--\n-- A loop rather than a single add, and it is doing two jobs at once. It is the\n-- idempotency guard -- run this twice for one birthday and the second pass finds\n-- paidThroughAge already level with the age and adds nothing -- and it is also what\n-- makes a multi-year jump pay correctly, which is what \"Skip Childhood\" is. A life\n-- that skips five to nine in one motion is owed five birthdays, not the last one.\n--\n-- No yields anywhere in it, which is what makes the whole read-modify-write atomic\n-- on the same terms MoneyService relies on.\nlocal function accrue(data: LifeData)\n	local ageYears = data.ageMonths // Config.Time.MonthsPerYear\n\n	while data.pocketMoneyPaidThroughAge < ageYears do\n		data.pocketMoneyPaidThroughAge += 1\n		local age = data.pocketMoneyPaidThroughAge\n		-- The bonus is read per year inside the loop rather than once outside it, so a\n		-- skipped childhood is paid at the bond each of those years actually had. Floored\n		-- per birthday for the same reason the weekly rate is: money is whole units.\n		data.pocketMoneyOwed += math.floor(PocketMoneyService.GrantFor(age) * parentBonus(data, age))\n	end\nend\n\n-- Shows the amount, over the hands that gave it when there were hands and over the\n-- player's own head when there were not. Feedback only: the money is already in the\n-- balance by the time this runs, so a character that is mid-load or mid-removal\n-- costs a float and nothing else. That is the correct trade -- being paid silently\n-- is a bad birthday, being paid nothing is a broken game.\n--\n-- The two cases are not cosmetic variants of each other. Money appearing over a\n-- parent who just walked across the room is somebody giving you something; the same\n-- number over your own head is the game crediting an account. The second is the\n-- fallback and is meant to read as the lesser of the two.\nlocal function announce(player: Player, amount: number, at: Vector3?)\n	if at ~= nil then\n		MoneyPop.Show(at, amount)\n		return\n	end\n\n	local character = player.Character\n	if character == nil then\n		return\n	end\n	local head = character:FindFirstChild(\"Head\") :: BasePart?\n	if head == nil then\n		return\n	end\n	MoneyPop.Show(head.Position + Vector3.new(0, POP_LIFT, 0), amount)\nend\n\n-- Hands over everything outstanding, right now, wherever the player happens to be.\n-- Returns the amount, which is zero when there was nothing owed.\n--\n-- The balance is credited before the ledger is cleared, and the order is a\n-- deliberate choice about which way to be wrong. Neither is actually reachable --\n-- nothing between the two lines yields, so they are one atomic step -- but if that\n-- ever stops being true, this order pays a player twice and the other loses money\n-- they were owed. Only one of those is a betrayal.\n--\n-- `at` is where the money should be seen to come from, and is the whole difference\n-- between the two ways this is reached: a parent passes the point their hands are at\n-- and the number floats out of them, while every other caller passes nothing and it\n-- floats over the player instead.\n--\n-- Public because three callers need it: the handover below, the fallback that runs\n-- when the handover could not happen, and the Studio harness.\nfunction PocketMoneyService.Settle(player: Player, at: Vector3?): number\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return 0\n	end\n\n	local data = Lives.Active(profile.Data)\n	local owed = data.pocketMoneyOwed\n	if owed <= 0 then\n		return 0\n	end\n\n	MoneyService.Add(player, owed, \"pocket money\")\n	data.pocketMoneyOwed = 0\n\n	announce(player, owed, at)\n	return owed\nend\n\n-- Flattened onto the floor plane, so a player looking at their feet or up the stairs\n-- cannot tip the arc of bearings over. The same guard, for the same reason, as the\n-- one in SceneService.\nlocal function flatten(direction: Vector3): Vector3?\n	local flat = Vector3.new(direction.X, 0, direction.Z)\n	if flat.Magnitude < MIN_DIRECTION then\n		return nil\n	end\n	return flat.Unit\nend\n\n-- Where a parent can appear, or nil if this room cannot hold one.\n--\n-- The same three probes every placement in this game runs, asked about an adult:\n-- there has to be a floor, a body has to fit standing on it, and there has to be a\n-- clear line back to the player -- a parent who materializes in the next room and\n-- walks into the wall between you is worse than one who never came.\n--\n-- Measured with Config.NPC.BodyRadius and BodyHeight rather than off the rig,\n-- because the rig does not exist yet: building it is a web-backed call, and spawning\n-- a person in order to discover there was nowhere to put them is the wrong order.\n-- The reach test uses the parent's height too, since the parent is the one walking.\n--\n-- The full arc first and then the whole arc again drawn in, rather than one sweep\n-- that gives up. Measured, not assumed: the far distance alone can stage a parent in\n-- 54% of this house and the pair manage 83%, and nearly every room that changed its\n-- answer is upstairs, where nothing is fourteen studs across.\nlocal function spawnSpot(character: Model): Vector3?\n	local pivot = character:GetPivot()\n	local origin = pivot.Position\n	local forward = flatten(pivot.LookVector)\n	if forward == nil then\n		return nil\n	end\n\n	local radius = Config.NPC.BodyRadius\n	local height = Config.NPC.BodyHeight\n	local ignore = Ground.IgnoreList()\n\n	local far = Config.PocketMoney.SpawnStuds\n	local bearings = Ground.Bearings(Config.PocketMoney.ArcDegrees, Config.PocketMoney.Bearings)\n\n	for _, out in { far, far * Config.PocketMoney.RetrySpawnScale } do\n		for _, angle in bearings do\n			local direction = CFrame.Angles(0, math.rad(angle), 0) * forward\n\n			-- Reachability measured from the player, which is what \"a parent can get to\n			-- you from there\" means. This used to cast the other way; see `Ground.SpotAt`\n			-- for why the direction is fixed there rather than chosen per caller.\n			local ground = Ground.SpotAt(origin + direction * out, radius, height, ignore, origin)\n			if ground == nil then\n				continue\n			end\n\n			return ground\n		end\n	end\n\n	return nil\nend\n\n-- Where a parent should be walking to right now: HandoverStuds out from the player,\n-- along the line they are already approaching on.\n--\n-- Recomputed every tick rather than fixed when the walk began, because the target is\n-- a child who can run. Measured from the player outward rather than from the parent\n-- inward so the spot stays put when the parent is already close -- aiming at a point\n-- a fixed distance ahead of themselves would have them orbiting.\nlocal function handoverSpot(character: Model, from: Vector3): Vector3?\n	local origin = character:GetPivot().Position\n	local direction = flatten(from - origin)\n	if direction == nil then\n		return nil\n	end\n	return origin + direction * Config.PocketMoney.HandoverStuds\nend\n\n-- Which parent turns up. Alternating on age rather than random: both of them appear\n-- across a childhood, and a birthday replayed in the harness produces the same\n-- person, which is the difference between a scene that can be tested and one that\n-- cannot.\nlocal function parentFor(ageYears: number): CastMember\n	local id = parentIdFor(ageYears)\n	local member = Cast.ById[id]\n	if member == nil then\n		-- The cast is content and could be edited out from under this. Warn and send\n		-- somebody rather than let a birthday go unpaid over a missing id.\n		warn(`[AGES] pocket money wanted \"{id}\", who is not in the cast; sending {Cast.Default.name}`)\n		return Cast.Default\n	end\n	return member\nend\n\n-- One parent, mid-errand.\ntype Handover = {\n	member: CastMember,\n	visitor: Visitor,\n	-- Where they came in, which is also where they leave by, so the exit is the\n	-- entrance run backwards rather than a second piece of placement that could fail.\n	spawnAt: Vector3,\n	-- Set by stop(); the chase loop checks it. A handover owns a coroutine and a rig,\n	-- and this is the one thing that ends both.\n	cancelled: boolean,\n}\n\nlocal inFlight: { [Player]: Handover } = {}\n\n-- Set for the length of the Spawn call, which yields -- building an avatar from a\n-- description is a web-backed round trip. Without this, two birthdays landing either\n-- side of that yield each look to the other like nobody is coming, and two parents\n-- walk out of two walls holding the same money.\nlocal starting: { [Player]: boolean } = {}\n\n-- Handovers that could not be made since the last one that was. In memory rather\n-- than on the profile, deliberately: rejoining resets the count, which costs one\n-- retry cycle before the fallback pays out and never costs the money itself, and a\n-- persisted counter would be a third piece of state to keep in step with the ledger\n-- for no gain at all.\nlocal failures: { [Player]: number } = {}\n\n-- Ends a handover immediately and without ceremony -- a death, a player leaving, a\n-- server sweep. Everything with a graceful ending goes through finish() instead.\nlocal function stop(player: Player)\n	local current = inFlight[player]\n	if current == nil then\n		return\n	end\n	inFlight[player] = nil\n	current.cancelled = true\n	current.visitor.destroy()\nend\n\n-- Ends a handover from inside its own coroutine, and only if it is still the one in\n-- play: run() reaches its tail across several yields, and clearing by player alone\n-- would take down a newer handover that had superseded this one.\n--\n-- `graceful` is whether they walk back out or simply vanish, and the caller decides\n-- it by asking whether anyone is left to watch. Nobody sees a parent leave a room\n-- the player has just died in, and making them walk it anyway holds a rig alive\n-- through a death for the benefit of an empty screen.\nlocal function finish(player: Player, current: Handover, graceful: boolean)\n	if inFlight[player] ~= current then\n		return\n	end\n\n	if graceful then\n		current.visitor.walkTo(current.spawnAt)\n		-- The walk yields, and anything at all may have happened across it.\n		if inFlight[player] ~= current then\n			return\n		end\n	end\n\n	stop(player)\nend\n\n-- Whether there is still a reason for anyone to be crossing the room. Every way a\n-- handover can stop being wanted -- the debt paid by the harness, a death, a life\n-- ended, a profile gone -- shows up here as one condition, which is the same trick\n-- the scene and enactment loops use.\nlocal function stillOwed(player: Player): boolean\n	local profile = DataService.GetProfile(player)\n	if profile == nil or not Lives.Active(profile.Data).alive then\n		return false\n	end\n	return Lives.Active(profile.Data).pocketMoneyOwed > 0\nend\n\n-- Credits the ledger where the player stands, because the good version could not\n-- happen often enough that waiting longer is no longer honest.\n--\n-- Counted rather than immediate, so a single bad moment -- a player in a doorway,\n-- a character mid-respawn -- costs a retry rather than the scene. Loud when it\n-- finally fires: this is a real failure of the intended feature and the log is the\n-- only place anyone would ever find out it had been happening.\nlocal function missed(player: Player)\n	if not stillOwed(player) then\n		-- Nothing left to hand over; whatever went wrong stopped mattering.\n		return\n	end\n\n	local count = (failures[player] or 0) + 1\n	failures[player] = count\n	if count < Config.PocketMoney.MaxAttempts then\n		return\n	end\n\n	local paid = PocketMoneyService.Settle(player)\n	failures[player] = nil\n	if paid > 0 then\n		warn(\n			`[AGES] no parent could reach {player.Name} in {count} attempts; `\n				.. `credited {Money.Format(paid)} of pocket money directly`\n		)\n	end\nend\n\n-- The whole life of a handover: cross the room, hand it over, stand there a moment\n-- while the number is read, and walk back out.\nlocal function run(player: Player, current: Handover)\n	local visitor = current.visitor\n	local arrived = false\n	local waited = 0\n\n	-- Bounded by the same timeout an ordinary walk gets. A chase has no natural end\n	-- -- the player can simply keep running -- and a parent trailing a sprinting\n	-- child around the house forever is not a scene, it is a bug with a face on it.\n	while waited < Config.NPC.WalkTimeoutSeconds do\n		-- Cancelled means stop() has already cleared the table and destroyed the rig,\n		-- so there is nothing left here to do or to tidy.\n		if current.cancelled then\n			return\n		end\n		-- These two are not that, and are not failures either: the rig went out from\n		-- under this errand -- a server sweep, a hot reload -- or the debt did, which\n		-- is what the harness paying it out by hand looks like from in here. Drop the\n		-- errand, tidy the parent away, and do not count it against the fallback.\n		if visitor.gone() or not stillOwed(player) then\n			finish(player, current, false)\n			return\n		end\n\n		local character = player.Character\n		if character ~= nil then\n			local at = visitor.at()\n			local gap = Ground.FlatDistance(at, character:GetPivot().Position)\n			if gap <= Config.PocketMoney.HandoverStuds + HANDOVER_SLACK then\n				arrived = true\n				break\n			end\n			-- Re-aimed rather than walked: a humanoid holds the last destination it\n			-- was given, so following something that moves is this call on a tick.\n			local target = handoverSpot(character, at)\n			if target ~= nil then\n				visitor.moveTo(target)\n			end\n		end\n\n		waited += task.wait(Config.PocketMoney.TickSeconds)\n	end\n\n	if current.cancelled then\n		return\n	end\n	if visitor.gone() then\n		finish(player, current, false)\n		return\n	end\n\n	if not arrived then\n		finish(player, current, false)\n		missed(player)\n		return\n	end\n\n	-- Stopped explicitly, because moveTo has no \"and stop here\": a parent who simply\n	-- stopped being re-aimed would keep walking into the player.\n	visitor.halt()\n	visitor.greet()\n\n	-- The money comes out of their hands rather than off the top of the player's\n	-- head, which is the entire reason anyone walked anywhere.\n	PocketMoneyService.Settle(player, visitor.at() + Vector3.new(0, HANDOVER_POP_LIFT, 0))\n	failures[player] = nil\n\n	-- Still standing there while the number is readable. Vanishing on the instant of\n	-- payment would undo the handover as surely as never having walked in.\n	task.wait(Config.PocketMoney.LingerSeconds)\n\n	local profile = DataService.GetProfile(player)\n	local watched = profile ~= nil and Lives.Active(profile.Data).alive and player.Character ~= nil\n	finish(player, current, watched)\nend\n\n-- Puts a parent in the room and starts them walking. Yields, and reports whether\n-- anyone is actually on the way -- false is an ordinary answer meaning \"not here,\n-- not now\", and the caller counts it toward the fallback.\nlocal function begin(player: Player): boolean\n	if inFlight[player] ~= nil or starting[player] then\n		return false\n	end\n\n	local profile = DataService.GetProfile(player)\n	if profile == nil or not Lives.Active(profile.Data).alive then\n		return false\n	end\n\n	local character = player.Character\n	if character == nil then\n		return false\n	end\n\n	local spot = spawnSpot(character)\n	if spot == nil then\n		return false\n	end\n\n	local ageYears = Lives.Active(profile.Data).ageMonths // Config.Time.MonthsPerYear\n	local member = parentFor(ageYears)\n\n	-- Lifted to hip height, because an R15 model's pivot is its root part and putting\n	-- that on the floor buries the parent to the waist. Erring high instead costs a\n	-- short drop the humanoid absorbs on the first frame.\n	local lift = Vector3.new(0, Config.NPC.BodyHeight / 2, 0)\n	local from = spot + lift\n	-- Facing the player from the first frame. A parent who appears with their back\n	-- turned and then spins is somebody who was placed there, not somebody who came.\n	local facing = flatten(character:GetPivot().Position - spot)\n	local pose = if facing ~= nil then CFrame.lookAt(from, from + facing) else CFrame.new(from)\n\n	starting[player] = true\n	local visitor = NPCService.Spawn(player, member, pose)\n	starting[player] = nil\n\n	if visitor == nil then\n		return false\n	end\n	local arriving = visitor :: Visitor\n\n	-- Spawn yielded, and a life can end inside a yield. A parent built for a birthday\n	-- that is no longer owed is a rig standing in an empty house.\n	if not stillOwed(player) then\n		arriving.destroy()\n		return false\n	end\n\n	local current: Handover = {\n		member = member,\n		visitor = arriving,\n		spawnAt = spot,\n		cancelled = false,\n	}\n	inFlight[player] = current\n	task.spawn(run, player, current)\n\n	return true\nend\n\n-- Someone is owed money: send a parent, or count the failure to.\n--\n-- A parent already crossing the room is neither, and returns without counting\n-- anything: the second birthday's money is added to the ledger the first one is\n-- already on its way to settle, and gets handed over in the same motion.\nlocal function dispatch(player: Player)\n	if not stillOwed(player) then\n		return\n	end\n	if inFlight[player] ~= nil or starting[player] then\n		return\n	end\n	if begin(player) then\n		return\n	end\n	missed(player)\nend\n\n-- Studio harness: send a parent now, for a debt that already exists. Returns whether\n-- one set off, so the harness can say why not.\nfunction PocketMoneyService.Send(player: Player): boolean\n	if not stillOwed(player) then\n		return false\n	end\n	return begin(player)\nend\n\n-- Called by LifeService on every birthday. Safe on a birthday that pays nothing,\n-- which is most of them: below StartAge and above EndAge accrue adds zero and\n-- dispatch finds an empty ledger and does nothing at all.\n--\n-- The accrual is synchronous and the handover is not, and that split is the whole\n-- design in one line. Counting what is owed happens now, inside the same atomic\n-- stretch as the birthday itself; the person carrying it across the room takes\n-- several seconds and must not be standing between a birthday and the death rolls\n-- that follow it.\nfunction PocketMoneyService.OnAgeUp(player: Player)\n	local profile = DataService.GetProfile(player)\n	if profile == nil or not Lives.Active(profile.Data).alive then\n		return\n	end\n\n	accrue(Lives.Active(profile.Data))\n	task.spawn(dispatch, player)\nend\n\n-- Called by LifeService when a life ends, alongside the rest of the teardown.\n--\n-- The two fields are zeroed even though the life they belong to is about to be left behind\n-- untouched, and that is on purpose: a dead life is still readable -- the lobby draws it on a\n-- card, and a later screen may well summarise it -- and \"the world owes this dead person\n-- $40\" is not a fact worth keeping. The stopping below is the part that matters right now.\nfunction PocketMoneyService.ResetForNewLife(player: Player)\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return\n	end\n	local data = Lives.Active(profile.Data)\n	data.pocketMoneyOwed = 0\n	data.pocketMoneyPaidThroughAge = 0\n\n	-- And anyone still carrying this life's money across the room. Abruptly, because the\n	-- person they were bringing it to has just died -- a parent finishing the walk and\n	-- politely letting themselves out is not a nicer ending, it is a stranger in the house.\n	stop(player)\n	failures[player] = nil\nend\n\n-- Brings a freshly loaded profile's paid-through age up to the age it is actually\n-- at, without paying for the difference.\n--\n-- This is the migration, and it only has one job: a save written before pocket money\n-- existed reconciles to a paid-through age of zero, and its owner may be twelve. Left\n-- alone, their next birthday would walk the accrual loop from one to thirteen and\n-- hand them the entire childhood they already lived through in a lump.\n--\n-- A clamp rather than a rewrite, so it can only ever move forward. The cost is that\n-- it also forfeits a birthday in one genuinely broken case -- a server that died\n-- between advancing the age and running the grant -- and that is the trade being\n-- made on purpose: at most one missed birthday, against back-paying thirteen.\nlocal function catchUpOnLoad(player: Player)\n	local profile = DataService.WaitForProfile(player)\n	if profile == nil then\n		return\n	end\n\n	local data = Lives.Active(profile.Data)\n	local ageYears = data.ageMonths // Config.Time.MonthsPerYear\n	if data.pocketMoneyPaidThroughAge < ageYears then\n		data.pocketMoneyPaidThroughAge = ageYears\n	end\nend\n\n-- Studio harness only: puts a debt in the ledger without a birthday to justify it.\n--\n-- It exists because the only honest way to reach the state a handover starts from is\n-- to have a birthday, and a birthday is a poor test rig: it happens once, it moves\n-- the age out from under you, and it cannot be repeated without dying first. This\n-- puts the ledger in that state directly, so \"/pocket owe 500\" then \"/pocket send\"\n-- is the whole scene on demand, as many times as it takes to watch it properly.\n--\n-- Kept out of the accrual path so a debt conjured by a tester can never be mistaken\n-- for one the game granted -- paidThroughAge does not move, so nothing here can\n-- silently pay for a birthday that has not happened.\nfunction PocketMoneyService.Owe(player: Player, amount: number): boolean\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return false\n	end\n	local owed = math.floor(amount)\n	if owed <= 0 then\n		return false\n	end\n	Lives.Active(profile.Data).pocketMoneyOwed += owed\n	return true\nend\n\n-- Studio harness: the rate, the ledger, how far the grant has been counted, and\n-- whether anybody is currently crossing a room with it.\n--\n-- The last of those is the reason this exists in its current form. \"Owed $312\" is\n-- the same line whether a parent is three steps away or whether the room could not\n-- hold one and the money is quietly waiting on a retry, and those are completely\n-- different things to go and fix.\nfunction PocketMoneyService.Describe(player: Player): string\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return \"no profile loaded yet\"\n	end\n\n	local data = Lives.Active(profile.Data)\n	local ageYears = data.ageMonths // Config.Time.MonthsPerYear\n	local weekly = PocketMoneyService.WeeklyRate(ageYears)\n	local bonus = parentBonus(data, ageYears)\n	local rate = if weekly > 0\n		then `{Money.Format(weekly)}/week -> `\n			.. `{Money.Format(math.floor(PocketMoneyService.GrantFor(ageYears) * bonus))} a birthday `\n			.. `(x{string.format(\"%.2f\", bonus)} from {parentIdFor(ageYears)})`\n		else `nothing at {ageYears} (pays {Config.PocketMoney.StartAge}-{Config.PocketMoney.EndAge})`\n\n	local current = inFlight[player]\n	local misses = failures[player] or 0\n	local status: string\n	if current ~= nil then\n		local character = player.Character\n		local away = if character ~= nil\n			then string.format(\"%.1f studs away\", Ground.FlatDistance(current.visitor.at(), character:GetPivot().Position))\n			else \"nobody to reach\"\n		status = `{current.member.name} on the way, {away}`\n	elseif starting[player] then\n		status = \"a parent is being built\"\n	elseif misses > 0 then\n		status = `nobody on the way, {misses}/{Config.PocketMoney.MaxAttempts} missed`\n	else\n		status = \"nobody on the way\"\n	end\n\n	return `age {ageYears} | {rate} | owed {Money.Format(data.pocketMoneyOwed)} `\n		.. `| counted through age {data.pocketMoneyPaidThroughAge} | {status}`\nend\n\nfunction PocketMoneyService:Init() end\n\nfunction PocketMoneyService:Start()\n	MoneyPop.ClearAll()\n\n	Players.PlayerAdded:Connect(function(player: Player)\n		task.spawn(catchUpOnLoad, player)\n	end)\n	-- And whoever is already here, which in Studio is always the person testing:\n	-- services start after the local player has joined, so PlayerAdded alone would\n	-- never run the migration in the one place it is being written to be checked.\n	for _, player in Players:GetPlayers() do\n		task.spawn(catchUpOnLoad, player)\n	end\n\n	Players.PlayerRemoving:Connect(function(player: Player)\n		stop(player)\n		-- Both keyed by Player, so leaving them behind holds a reference to somebody\n		-- who has gone. Small, and exactly the kind of small that accumulates over a\n		-- server's lifetime.\n		starting[player] = nil\n		failures[player] = nil\n	end)\n\n	-- The one thing that makes a delayed handover a delay rather than a loss.\n	--\n	-- Everything above only tries at the moment of a birthday, and the moment of a\n	-- birthday is a bad time to need a room: the player may be in a doorway, mid\n	-- respawn, or halfway up the stairs. This comes back and asks again, and keeps\n	-- asking until either a parent gets through or the fallback pays out -- so\n	-- \"nowhere to stand right now\" costs seconds instead of an allowance.\n	--\n	-- Cheap to leave running: it only does anything for a player whose ledger is not\n	-- empty, which is the few seconds after a birthday and otherwise never.\n	task.spawn(function()\n		while true do\n			task.wait(Config.PocketMoney.RetrySeconds)\n			for _, player in Players:GetPlayers() do\n				-- Spawned per player rather than awaited in turn, because begin()\n				-- yields on a web call and one player's slow avatar build must not\n				-- hold up everybody else's.\n				task.spawn(dispatch, player)\n			end\n		end\n	end)\nend\n\nreturn PocketMoneyService\n"
table.insert(AGES_MANIFEST, "src/server/services/PocketMoneyService.luau")
AGES_SOURCES["src/server/services/PoliceService.luau"] = "--!strict\n-- The officers: bodies in the street, and what they do about a bounty.\n--\n-- Reads BountyService and is never read by it. That one-way dependency is the whole\n-- architecture of this feature and it is worth saying why it is worth protecting: an\n-- arrest, in this file, is a call into BountyService and then nothing. Nobody here tears\n-- an officer down at the moment of the arrest. The number goes to zero, and on the next\n-- pass the ordinary \"how many officers should exist\" line reads zero and takes them off\n-- the street the same way it would if the player had simply cooled off. There is exactly\n-- one piece of code that removes an officer, and it does not know why it is doing it.\n--\n-- The other thing to read before changing anything is what an officer actually knows.\n-- It is not where the player is. Every tick, one at a time, each officer asks whether it\n-- can *see* the player -- near enough, and with nothing solid in between -- and only a\n-- yes feeds the thing below. A no means it carries on walking toward a spot that may be\n-- half a minute out of date. That is not an approximation of better AI. It is the game:\n-- the whole of hiding is the gap between where they are going and where you are, and any\n-- change here that lets an officer read the player's live position without seeing them\n-- deletes the feature while leaving every test passing.\n--\n-- Seeing is not the same as having made you, and that gap is new. An officer in view of\n-- the player fills a `notice` from 0 to 1 at a rate set by how conspicuous the player is\n-- right now -- see world/Spotting, which the crowd uses too so the two cannot drift apart\n-- on what any of this means. Only a full notice produces a sighting and starts a pursuit.\n-- Before this the sight test *was* the sighting, which meant a player's bounty bought more\n-- officers and longer sight lines and had no effect whatsoever on how quickly the ones\n-- already looking at them worked it out. Now walking calmly across the top of an officer's\n-- range is a thing you can survive, and sprinting in gang colors across the same ground is\n-- not, and the difference is a decision the player gets to make.\n--\n-- What is deliberately absent: any way for an officer to affect the player except by\n-- standing next to them. No weapons, no damage, no shoving. An arrest is proximity held\n-- for a few seconds. If the police could do anything else, the answer to a pursuit would\n-- be to turn around and deal with them, and last known position, hiding and every other\n-- decision in this system would stop being decisions on the same afternoon.\n\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Config = require(ReplicatedStorage:WaitForChild(\"Config\"))\n\nlocal BountyService = require(script.Parent.BountyService)\nlocal NPCService = require(script.Parent.NPCService)\nlocal Ground = require(script.Parent.Parent.world.Ground)\nlocal Spotting = require(script.Parent.Parent.world.Spotting)\nlocal Police = require(script.Parent.Parent.content.Police)\n\ntype Visitor = NPCService.Visitor\n\nlocal PoliceService = {}\n\nlocal CRIME = Config.Crime\nlocal SPOT = CRIME.Spotting\n\n-- One officer in the world, and what it currently believes it is doing.\ntype Officer = {\n	visitor: Visitor,\n	-- Which numbered post in the response this is. Fixes which body it wears and which\n	-- bearing it searches on, so a manhunt fans out instead of four people walking in a\n	-- line -- and so those two things stay stable across ticks rather than being re-rolled\n	-- into a twitch.\n	post: number,\n	-- \"pursue\" once this officer has made the player, \"search\" the rest of the time. Held\n	-- rather than recomputed by every reader because the walk legs below key off the\n	-- transition.\n	mode: string,\n	-- How far this officer has got toward placing the player, 0 to 1. Fills only while they\n	-- are actually in view, at a rate set by how conspicuous the player is; **reset to 0 the\n	-- moment the view breaks, not decayed**. That rule is what makes stepping behind a van a\n	-- move rather than a pause, and it is the same rule the crowd plays by -- see\n	-- world/Spotting, which is the only place either of them is allowed to define it.\n	--\n	-- Per officer rather than per response, because six officers looking at you from six\n	-- distances are six different opinions and the near one should get there first.\n	notice: number,\n	-- Where a search leg is currently walking to, and whether one is in flight. A leg is a\n	-- yielding pathfind on its own thread, so this is the handshake that stops the tick\n	-- from starting a second one on top of it four times a second.\n	legTarget: Vector3?,\n	legRunning: boolean,\n	-- Seconds this officer has been within arresting distance, continuously. Reset the\n	-- moment it is not, which is what makes a near miss a near miss.\n	contactFor: number,\n}\n\nlocal officers: { [Player]: { Officer } } = {}\n-- Set while a spawn is in flight for a player. Spawning is a yielding web call, so\n-- without this the tick would ask for a second body a fifth of a second after asking for\n-- the first and end up with twice the response the tier called for.\nlocal spawning: { [Player]: boolean } = {}\nlocal enabled = true\n\n-- How far out an officer arrives, as a share of the tier's search radius. Not in Config\n-- because it is not a difficulty dial: it exists so that police *arrive* rather than\n-- appear, and any value that does that is as good as any other. At 1.0 they turn up at\n-- the edge of where they are willing to look, which is the honest place for them to\n-- start.\nlocal ARRIVE_AT_EDGE_SHARE = 1\n\n-- How near a search leg has to get before it counts as walked and the officer picks\n-- somewhere else to look. Loose, because a humanoid stopping exactly on a point is not a\n-- thing that happens and a tighter number here reads as officers refusing to move on.\nlocal LEG_ARRIVED_STUDS = 8\n\nlocal function characterPosition(player: Player): Vector3?\n	local character = player.Character\n	if character == nil then\n		return nil\n	end\n	local root = character:FindFirstChild(\"HumanoidRootPart\")\n	if root == nil or not root:IsA(\"BasePart\") then\n		return nil\n	end\n	return root.Position\nend\n\n-- Everything a sight test should shoot through rather than stop on. Players are already\n-- in Ground.IgnoreList; the visitors folder is added because an officer must not be\n-- blinded by another officer standing in front of it, which at the top tier is most of\n-- the time.\nlocal function sightIgnore(): { Instance }\n	local extra: { Instance } = {}\n	local folder = workspace:FindFirstChild(\"AgesVisitors\")\n	if folder ~= nil then\n		table.insert(extra, folder)\n	end\n	return Ground.IgnoreList(extra)\nend\n\n-- Whether this officer can see that point.\n--\n-- Thin, because the test itself now lives in world/Spotting where the crowd can reach it\n-- too. What stays here is the two things that are genuinely the police's own: they look\n-- from head height because they are bodies, and they look through `sightIgnore()` because\n-- an officer must not be blinded by the officer standing in front of them.\nlocal function canSee(from: Vector3, to: Vector3, sightStuds: number): boolean\n	return Spotting.CanSee(from, to, sightStuds, Config.NPC.BodyHeight, sightIgnore())\nend\n\n-- A standable spot on a bearing out from a centre point, or nil if the town has nothing\n-- there. Used both for arrivals and for search legs, because they are the same question\n-- asked at different radii.\nlocal function spotOut(center: Vector3, bearing: number, distance: number): Vector3?\n	local direction = CFrame.Angles(0, math.rad(bearing), 0) * Vector3.new(0, 0, -1)\n	local candidate = center + direction * distance\n	return Ground.SpotAt(candidate, Config.NPC.BodyRadius, Config.NPC.BodyHeight, sightIgnore())\nend\n\n-- Where officer number `post` should look, given what the police believe.\n--\n-- The whole behaviour of a search is in this function, and it is one branch. A *fresh*\n-- sighting sends everybody to the same place, because that is what a real report does:\n-- somebody just saw you there and everybody goes there. A *stale* one fans them out on\n-- their own bearings, because standing on a spot nobody has confirmed in ten seconds is\n-- not searching, it is waiting -- and an officer who does that reads as broken rather\n-- than as looking for someone.\n--\n-- The player never sees this rule, only its consequence: hiding near where you were seen\n-- works for about ten seconds and then stops working, so the correct play is to keep\n-- moving away rather than to find one good bush. That is the behaviour worth having, and\n-- it falls out of one `if`.\nlocal function searchSpot(lastKnown: Vector3, sightingAge: number, post: number, radiusStuds: number): Vector3?\n	if sightingAge < CRIME.SightingHoldSeconds then\n		return Ground.SpotAt(lastKnown, Config.NPC.BodyRadius, Config.NPC.BodyHeight, sightIgnore()) or lastKnown\n	end\n\n	-- Spread. Each post keeps its own slice of the circle so that officers do not all\n	-- wander to the same side, and the slice is offset by how long the search has run so a\n	-- long one sweeps rather than re-walking the same four spokes.\n	local slice = 360 / math.max(1, #Police.Bodies)\n	local bearing = (post - 1) * slice + sightingAge * 6\n	-- Two thirds out rather than the full radius, so a spread search still covers the\n	-- middle. At the full radius every officer stands on the rim of a circle with the\n	-- player comfortably inside it.\n	local out = radiusStuds * (2 / 3)\n	return spotOut(lastKnown, bearing, out) or spotOut(lastKnown, bearing + slice / 2, out * 0.6)\nend\n\n-- Stops any walk this officer is on and forgets the leg. Called whenever the mode changes,\n-- because a search leg that is still yielding when a pursuit starts would keep steering\n-- the body toward a corner the player has already left.\nlocal function dropLeg(officer: Officer)\n	officer.legTarget = nil\nend\n\nlocal function removeOfficer(officer: Officer)\n	dropLeg(officer)\n	officer.visitor.destroy()\nend\n\n-- Takes every officer off a player. The single place a body is removed, and deliberately\n-- ignorant of why -- arrest, cooling off, death, leaving, the harness turning the system\n-- off and a new life all arrive here identically.\nlocal function clearOfficers(player: Player)\n	local list = officers[player]\n	if list == nil then\n		return\n	end\n	officers[player] = nil\n	for _, officer in list do\n		removeOfficer(officer)\n	end\nend\n\n-- Puts one more body in the world, on its own thread because building a rig is a yielding\n-- web call and the pursuit tick must not stop for it.\nlocal function spawnOfficer(player: Player, post: number, near: Vector3, radiusStuds: number)\n	if spawning[player] then\n		return\n	end\n	spawning[player] = true\n\n	task.spawn(function()\n		local bearing = (post - 1) * (360 / math.max(1, #Police.Bodies)) + math.random() * 40\n		local at = spotOut(near, bearing, math.max(radiusStuds, 1) * ARRIVE_AT_EDGE_SHARE)\n			or spotOut(near, bearing + 90, math.max(radiusStuds, 1) * 0.5)\n		if at == nil then\n			-- The town has nowhere to put them. Not an error and not worth a warning every\n			-- fifth of a second: the next tick asks again, and by then the player has moved\n			-- and the geometry around their last known position is different.\n			spawning[player] = false\n			return\n		end\n\n		local body = Police.Body(post)\n		local visitor = NPCService.Spawn(player, body, CFrame.new(at, near))\n		spawning[player] = false\n\n		if visitor == nil then\n			return\n		end\n\n		-- Checked *after* the spawn rather than before, because the spawn yields and\n		-- everything can have changed underneath it: the player may have cooled off, died,\n		-- left, or been arrested by an officer that got there first. A body arriving into\n		-- any of those is a policeman standing in an empty street forever.\n		local list = officers[player]\n		if list == nil or not enabled or BountyService.Get(player) <= 0 then\n			visitor.destroy()\n			return\n		end\n\n		visitor.setSpeed(CRIME.OfficerWalkSpeed)\n		table.insert(list, {\n			visitor = visitor,\n			post = post,\n			mode = \"search\",\n			notice = 0,\n			legTarget = nil,\n			legRunning = false,\n			contactFor = 0,\n		})\n	end)\nend\n\n-- Sends an officer walking to a fixed point, by route rather than in a straight line.\n--\n-- Pathfinding rather than a plain aim, and only here: a search leg is a walk across a\n-- built town to somewhere the officer cannot see, which is exactly the case a straight\n-- line fails at -- it ends with a body pressed into the side of a building. A pursuit\n-- does the opposite and re-aims every tick, because the destination is a person who is\n-- moving and a route computed to where they were is worse than useless.\nlocal function walkLeg(player: Player, officer: Officer, to: Vector3)\n	officer.legTarget = to\n	officer.legRunning = true\n\n	task.spawn(function()\n		local visitor = officer.visitor\n		-- Called on every waypoint. Everything that could have made this walk pointless is\n		-- asked about here rather than trusted for the length of a crossing.\n		local function shouldStop(): boolean\n			return not enabled\n				or visitor.gone()\n				or officer.mode ~= \"search\"\n				or officer.legTarget ~= to\n				or BountyService.Get(player) <= 0\n		end\n		visitor.pathTo(to, shouldStop)\n		officer.legRunning = false\n	end)\nend\n\n-- One officer, for one tick. Returns true if this officer has *made* the player -- not\n-- merely got them in view -- which the caller folds into the single sighting the whole\n-- response is allowed to produce.\n--\n-- `loud` is how conspicuous the player is right now, computed once for the whole response\n-- rather than per officer: it is a fact about the player, not about who is looking, and\n-- six officers reading it six times would be the same number six times.\nlocal function tickOfficer(\n	player: Player,\n	officer: Officer,\n	playerAt: Vector3?,\n	loud: number,\n	elapsed: number\n): boolean\n	local visitor = officer.visitor\n	if visitor.gone() then\n		return false\n	end\n\n	local tier = BountyService.TierOf(player)\n	local at = visitor.at()\n\n	if playerAt ~= nil and canSee(at, playerAt, tier.sightStuds) then\n		-- Capped at 1 rather than allowed to run, so that an officer who has been staring at\n		-- a wanted player for a minute is not carrying thirty seconds of credit that would\n		-- let them re-acquire instantly through a wall they cannot see through anyway.\n		officer.notice = math.min(\n			1,\n			officer.notice\n				+ Spotting.NoticeRate(\n						Ground.FlatDistance(at, playerAt),\n						tier.sightStuds,\n						loud,\n						SPOT.OfficerSeconds\n					)\n					* elapsed\n		)\n	else\n		-- Reset, not decay. See the field comment: this is the rule that makes cover work.\n		officer.notice = 0\n	end\n\n	if officer.notice >= 1 and playerAt ~= nil then\n		if officer.mode ~= \"pursue\" then\n			officer.mode = \"pursue\"\n			dropLeg(officer)\n		end\n		-- Re-aimed every tick rather than pathed, because a humanoid holds the last\n		-- destination it was given and the destination is a person who is running.\n		visitor.moveTo(playerAt)\n\n		-- Contact. Measured flat, because an officer at the bottom of a staircase is not\n		-- holding onto anybody at the top of it -- but neither is a chase up a ramp meant\n		-- to be an escape, and flat distance is what every other proximity check in this\n		-- game means by near.\n		if Ground.FlatDistance(at, playerAt) <= CRIME.ArrestStuds then\n			officer.contactFor += elapsed\n		else\n			officer.contactFor = 0\n		end\n		return true\n	end\n\n	-- Lost them, never had them, or has them in plain view and has not placed them yet.\n	-- The third case is the point of the whole system and it deliberately falls through to\n	-- here: an officer part-way up their notice keeps walking their search leg, so what the\n	-- player sees is somebody who has not reacted to them *yet*. There is no tell for it,\n	-- and there should not be -- the read is the distance and your own behaviour, not the\n	-- officer's animation.\n	if officer.mode ~= \"search\" then\n		officer.mode = \"search\"\n		officer.contactFor = 0\n	end\n	officer.contactFor = 0\n\n	local lastKnown, sightingAge = BountyService.LastKnown(player)\n	if lastKnown == nil then\n		-- Nobody has any idea. The officer stops rather than wandering: a police force\n		-- with no information walking the streets at random would be indistinguishable\n		-- from one that knows exactly where you are, and the player could not tell that\n		-- their hiding had worked.\n		if officer.legTarget ~= nil then\n			dropLeg(officer)\n			visitor.halt()\n		end\n		return false\n	end\n\n	-- A leg is already in flight and still going somewhere useful.\n	if officer.legRunning then\n		local target = officer.legTarget\n		if target ~= nil and Ground.FlatDistance(target, lastKnown) <= tier.searchRadiusStuds then\n			return false\n		end\n		-- The belief has moved further than this walk was ever going to cover. Dropping the\n		-- target is what makes the in-flight leg's shouldStop go true and hand the body back.\n		dropLeg(officer)\n		return false\n	end\n\n	local target = officer.legTarget\n	if target ~= nil and Ground.FlatDistance(at, target) > LEG_ARRIVED_STUDS then\n		-- Walked it, did not arrive, and no leg is running -- the pathfind failed or was\n		-- called off. Ask again next tick rather than hammering it this one.\n		officer.legTarget = nil\n		return false\n	end\n\n	local spot = searchSpot(lastKnown, sightingAge, officer.post, tier.searchRadiusStuds)\n	if spot ~= nil then\n		walkLeg(player, officer, spot)\n	end\n	return false\nend\n\n-- One player's whole response, for one tick.\nlocal function tickPlayer(player: Player, elapsed: number)\n	local bounty = BountyService.Get(player)\n	local tier = BountyService.TierOf(player)\n	local wanted = if enabled then tier.officers else 0\n\n	if bounty <= 0 or wanted <= 0 then\n		clearOfficers(player)\n		return\n	end\n\n	local list = officers[player]\n	if list == nil then\n		list = {}\n		officers[player] = list\n	end\n\n	-- Sweep bodies that have left the world under us -- a server clean-up, a rig that\n	-- failed to build. Done before counting, so the count below is of officers that\n	-- actually exist rather than of table entries.\n	for index = #list, 1, -1 do\n		if list[index].visitor.gone() then\n			table.remove(list, index)\n		end\n	end\n\n	-- Too many, because the player cooled down a tier. Removed from the end so the\n	-- officers who keep their posts keep their bearings too, and a de-escalation looks\n	-- like people being stood down rather than like the whole search restarting.\n	while #list > wanted do\n		local last = list[#list]\n		table.remove(list, #list)\n		removeOfficer(last)\n	end\n\n	local playerAt = characterPosition(player)\n	-- Once, above the loop. Every officer is filling their notice against the same player,\n	-- and reading a speed off the same body six times a tick would be six answers to one\n	-- question.\n	local loud = BountyService.Conspicuousness(player)\n\n	local anySighting = false\n	for _, officer in list do\n		local fine, problem = pcall(function()\n			if tickOfficer(player, officer, playerAt, loud, elapsed) then\n				anySighting = true\n			end\n		end)\n		if not fine then\n			warn(`[AGES] officer tick failed for {player.Name}: {problem}`)\n		end\n	end\n\n	-- One sighting for the whole response rather than one per officer. Six officers all\n	-- reporting the same player in the same frame is one fact, and pushing it six times\n	-- would be six writes of an identical position -- harmless today, and exactly the kind\n	-- of thing that stops being harmless the moment a sighting starts adding heat.\n	if anySighting and playerAt ~= nil then\n		BountyService.Sighted(player, playerAt)\n	end\n\n	-- The arrest, checked after every officer has moved, so that the officer who has been\n	-- holding contact longest is the one that closes it regardless of table order.\n	for _, officer in list do\n		if officer.contactFor >= CRIME.ContactSeconds then\n			if BountyService.Arrest(player) then\n				-- Nothing is torn down here. The bounty is zero now, and the top of this\n				-- function will read that on the next pass and take the whole response off\n				-- the street -- which is the same line that handles cooling off, dying and\n				-- the harness being switched off. One exit, not four.\n				return\n			end\n		end\n	end\n\n	-- Too few. Asked for one at a time rather than all at once, because each is a yielding\n	-- rig build and a manhunt arriving as six simultaneous web calls is a hitch on the\n	-- server and a row of policemen materialising in step on the screen.\n	if #list < wanted and not spawning[player] then\n		local lastKnown = select(1, BountyService.LastKnown(player))\n		local from = lastKnown or playerAt\n		if from ~= nil then\n			spawnOfficer(player, #list + 1, from, tier.searchRadiusStuds)\n		end\n	end\nend\n\n-- How many bodies are actually on a player right now. For the harness, and for the day\n-- something else wants to know whether the street is busy.\nfunction PoliceService.OfficerCount(player: Player): number\n	local list = officers[player]\n	if list == nil then\n		return 0\n	end\n	local count = 0\n	for _, officer in list do\n		if not officer.visitor.gone() then\n			count += 1\n		end\n	end\n	return count\nend\n\n-- Everything off the street for one player, without touching their heat. For the harness\n-- only.\n--\n-- There is deliberately no ResetForNewLife here, and no death hook, which makes this the\n-- one system in the game LifeService does not have to remember to tear down. It cannot\n-- have one -- this file reads BountyService, which spends years through LifeService, so a\n-- call back the other way would close a require cycle -- and it turns out not to need one.\n-- A dead player's heat reads as zero (see BountyService.Get) and a new life is a new\n-- Lives.New() with the number already at zero, so both arrive at the same line at the top\n-- of tickPlayer that handles cooling off, and the street empties on the next pass.\n--\n-- Worth stating rather than leaving to be rediscovered: if anything here ever starts\n-- holding state that outlives a life, this stops being true and the hook has to be found\n-- a home that does not cycle.\nfunction PoliceService.Clear(player: Player)\n	clearOfficers(player)\nend\n\nfunction PoliceService.SetEnabled(value: boolean)\n	enabled = value\n	if not value then\n		for player in officers do\n			clearOfficers(player)\n		end\n	end\nend\n\nfunction PoliceService.IsEnabled(): boolean\n	return enabled\nend\n\n-- What the harness prints: every officer, where it is, what it thinks it is doing, how far\n-- up its notice the player is, and how close it is to making an arrest. Those three are\n-- exactly the things that cannot be seen by standing in the street -- an officer walking\n-- toward you looks the same whether it has made you, is halfway to making you, or is going\n-- to where you were half a minute ago.\nfunction PoliceService.Describe(player: Player): string\n	local list = officers[player]\n	if list == nil or #list == 0 then\n		return `no officers out — {if enabled then \"on\" else \"off\"}`\n	end\n	local parts: { string } = {}\n	for _, officer in list do\n		if officer.visitor.gone() then\n			table.insert(parts, `post {officer.post}: gone`)\n		else\n			local at = officer.visitor.at()\n			table.insert(\n				parts,\n				string.format(\n					\"post %d: %s at %d,%d notice %.2f contact %.1f/%.1f\",\n					officer.post,\n					officer.mode,\n					at.X,\n					at.Z,\n					officer.notice,\n					officer.contactFor,\n					CRIME.ContactSeconds\n				)\n			)\n		end\n	end\n	local loud = BountyService.Conspicuousness(player)\n	return string.format(\n		\"%d out — %s — conspicuousness %.2f — %s\",\n		#list,\n		table.concat(parts, \" · \"),\n		loud,\n		if enabled then \"on\" else \"off\"\n	)\nend\n\nfunction PoliceService:Start()\n	Players.PlayerRemoving:Connect(function(player: Player)\n		clearOfficers(player)\n		spawning[player] = nil\n	end)\n\n	task.spawn(function()\n		while true do\n			local elapsed = task.wait(CRIME.TickSeconds)\n			for _, player in Players:GetPlayers() do\n				local fine, problem = pcall(tickPlayer, player, elapsed)\n				if not fine then\n					warn(`[AGES] police tick failed for {player.Name}: {problem}`)\n				end\n			end\n		end\n	end)\nend\n\nreturn PoliceService\n"
table.insert(AGES_MANIFEST, "src/server/services/PoliceService.luau")
AGES_SOURCES["src/server/services/PropService.luau"] = "--!strict\n-- Answering an event by doing the thing it describes.\n--\n-- This is the third and last way an event can be answered, and it is the only one\n-- with no list in it anywhere. A panel event is a list you read. An enacted event is\n-- a list you walk to first -- the dots on the dog buy you the right to be asked, and\n-- then a panel opens after all. This one never opens anything. The event's answers\n-- are objects put in the room, and the answer is given by crawling to one, shoving\n-- one, picking one up and carrying it somewhere, or by holding still and letting the\n-- moment pass.\n--\n-- Childhood is the argument for it. A toddler cannot read, and every one of the\n-- first five years was a paragraph and three sentences to click -- which is the one\n-- interface a two-year-old is least equipped to use and the first thing a new player\n-- is ever handed. \"The bright thing is on the far side of a rug that has never\n-- seemed so wide\" was a sentence about a rug that was not there. Now there is a rug,\n-- and you can shove it.\n--\n-- The division of labour is EnactService's, deliberately, because it was right\n-- there. EventService alone decides which event fires and alone validates an answer;\n-- this decides only that the room can hold the question, lays it out, and watches.\n-- Every answer still arrives through EventService.ResolveChoice -- the same function\n-- the panel's remote lands in -- so there is exactly one place a choice is ever paid\n-- out, and a prop has never been a second way to cheat one. A forged remote and a\n-- rug being pushed are the same three guards deep.\n--\n-- Nothing here talks to the client. The props are world objects and the labels over\n-- them are BillboardGuis in the workspace, so the player sees them because they are\n-- there, not because they were told. An answered prop event costs exactly the one\n-- remote message the banner cost, and doing the thing costs none at all.\n--\n-- Best-effort, like everything else in this layer. A room with nowhere to lay the\n-- set out is a panel. A prop that could not be built is a panel. A player who cannot\n-- work out what to do gets the panel when the clock runs out. Answering by doing may\n-- never be the reason an event cannot be answered at all.\n\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Config = require(ReplicatedStorage:WaitForChild(\"Config\"))\nlocal Types = require(ReplicatedStorage:WaitForChild(\"Types\"))\nlocal PropLabel = require(ReplicatedStorage:WaitForChild(\"world\"):WaitForChild(\"PropLabel\"))\nlocal Lives = require(ReplicatedStorage:WaitForChild(\"Lives\"))\n\nlocal DataService = require(script.Parent.DataService)\nlocal EventService = require(script.Parent.EventService)\nlocal Ground = require(script.Parent.Parent.world.Ground)\nlocal PropModels = require(script.Parent.Parent.world.PropModels)\nlocal Props = require(script.Parent.Parent.content.Props)\n\ntype LifeEvent = Types.LifeEvent\ntype EventChoice = Types.EventChoice\ntype PropKind = Types.PropKind\ntype PropVerb = Types.PropVerb\ntype PropPlacement = Types.PropPlacement\n\nlocal PROPS = Config.Props\n\nlocal PropService = {}\n\n-- What floats over something you are meant to pick up. One line for every carried\n-- prop there will ever be, and not authored per event on purpose: the three answers\n-- to \"the last cookie\" are the three places you can take it, and if the cookie\n-- itself carried one of their labels it would read as a fourth.\nlocal CARRY_LABEL = \"Pick it up\"\n\ntype Staged = {\n	kind: PropKind,\n	model: Model,\n	-- Where it was put. Push measures against this rather than against the player,\n	-- so a rug counts as moved when it has actually travelled, not when somebody has\n	-- leaned on it for long enough.\n	origin: Vector3,\n	at: Vector3,\n	label: PropLabel.PropLabelHandle?,\n	near: boolean,\n}\n\ntype Watch = {\n	choiceId: string,\n	verb: PropVerb,\n	-- Nil only for a Stay given where the player already is.\n	propId: string?,\n	toId: string?,\n	-- Stay's accumulator, in seconds. Reset rather than paused the moment the player\n	-- moves: waiting to be picked up is a thing you are doing, and a bar that\n	-- remembered progress across three false starts would let it be done by accident.\n	stillFor: number,\n}\n\ntype Active = {\n	eventId: string,\n	folder: Folder,\n	props: { [string]: Staged },\n	watches: { Watch },\n	-- Which prop is in the player's arms, if any. One at a time: every Carry in an\n	-- event shares its carried object, which is what makes picking it up a commitment\n	-- to nothing.\n	carrying: string?,\n	carryWeld: Weld?,\n	-- The label for a prop-less Stay, worn by the player themselves.\n	selfLabel: PropLabel.PropLabelHandle?,\n	-- Where the player was last tick, for working out how fast they are actually\n	-- moving. Taken from displacement rather than from the humanoid's MoveDirection\n	-- because that reports intent -- a child walking into a wall is trying to move\n	-- and is not moving, and for Stay it is the second that matters.\n	lastAt: Vector3?,\n	-- When the set starts accepting answers. Everything is visible before then and\n	-- nothing is live, so the seconds the player spends reading the banner cannot be\n	-- mistaken for the seconds they spend standing still on purpose.\n	liveAt: number,\n	expiresAt: number?,\n	-- Set the moment an answer is taken, before anything is paid out. Everything the\n	-- tick does is guarded on it, so a second verb completing on the same frame as\n	-- the first cannot also be resolved.\n	answered: boolean,\n}\n\nlocal active: { [Player]: Active } = {}\n\n-- Debug switch for the Studio harness, never touched in a live server. Off means\n-- every event falls back to its panel, which is also the state to put the game in\n-- while testing something that has nothing to do with props.\nlocal enabled = true\n\n\nlocal function characterOf(player: Player): (Model?, BasePart?)\n	local character = player.Character\n	if character == nil then\n		return nil, nil\n	end\n	local root = character:FindFirstChild(\"HumanoidRootPart\")\n	if root == nil or not root:IsA(\"BasePart\") then\n		return nil, nil\n	end\n	return character, root\nend\n\n-- Everything one player's event has out lives in one folder, so a Studio session can\n-- see the whole set at once and clear the lot if a test left something behind.\nlocal function setFolder(player: Player): Folder\n	local folder = Instance.new(\"Folder\")\n	folder.Name = `Props_{player.Name}`\n	folder.Parent = workspace\n	return folder\nend\n\n-- Puts a carried prop down, wherever it happens to be, and gives it back to the\n-- world. Called on teardown rather than on a change of mind, because there is no\n-- changing your mind about having picked something up -- only about where it goes.\nlocal function release(current: Active)\n	local weld = current.carryWeld\n	if weld ~= nil then\n		weld:Destroy()\n		current.carryWeld = nil\n	end\n\n	local carried = current.carrying\n	current.carrying = nil\n	if carried == nil then\n		return\n	end\n	local staged = current.props[carried]\n	if staged == nil then\n		return\n	end\n	for _, descendant in staged.model:GetDescendants() do\n		if descendant:IsA(\"BasePart\") then\n			descendant.Anchored = true\n		end\n	end\nend\n\nlocal function teardown(player: Player)\n	local current = active[player]\n	if current == nil then\n		return\n	end\n	active[player] = nil\n\n	release(current)\n	for _, staged in current.props do\n		local label = staged.label\n		if label ~= nil then\n			label.Destroy()\n		end\n	end\n	local selfLabel = current.selfLabel\n	if selfLabel ~= nil then\n		selfLabel.Destroy()\n	end\n	current.folder:Destroy()\nend\n\n-- The set stays out for a moment after it has been answered, then goes. Short and\n-- not zero: a rug that vanishes on the frame it finally gives way takes the answer\n-- with it, and the player is left reading an outcome about something they never saw\n-- happen.\n--\n-- Guarded on the event id so a linger started by one event cannot clear the set of\n-- the next -- which is a real sequence, because answering a childhood event ends the\n-- year and the birthday immediately stages another one.\nlocal function lingerThenTeardown(player: Player, eventId: string)\n	task.delay(PROPS.LingerSeconds, function()\n		local current = active[player]\n		if current ~= nil and current.eventId == eventId then\n			teardown(player)\n		end\n	end)\nend\n\n-- Every prop the event needs, and where each one wants to be. Built once so that\n-- placement can be tried as a set rather than a prop at a time: an arrangement is\n-- only worth keeping if all of it fits.\nlocal function placementsFor(event: LifeEvent): ({ PropPlacement }, boolean)\n	local wanted: { PropPlacement } = {}\n	local seen: { [string]: boolean } = {}\n\n	local function add(placement: PropPlacement?): boolean\n		if placement == nil then\n			return true\n		end\n		if Props.ById[placement.prop] == nil then\n			warn(`[AGES] event \"{event.id}\" names an unknown prop \"{placement.prop}\"; falling back to a panel`)\n			return false\n		end\n		-- The carried object is declared by every Carry that uses it, so the same id\n		-- arriving twice is expected. Content has already checked the repeats agree\n		-- with each other; this only has to place it once.\n		if not seen[placement.prop] then\n			seen[placement.prop] = true\n			table.insert(wanted, placement)\n		end\n		return true\n	end\n\n	for _, choice in event.choices do\n		local act = choice.act\n		if act == nil then\n			continue\n		end\n		if not add(act.at) or not add(act.to) then\n			return {}, false\n		end\n	end\n	return wanted, true\nend\n\n-- A floor point at this bearing and distance that a body could stand on and get to,\n-- or nil. The same three probes every system that puts something on the floor runs,\n-- in the same order, for the reasons Ground gives at length.\nlocal function spotAt(\n	from: Vector3,\n	bearingDegrees: number,\n	distance: number,\n	radius: number,\n	height: number,\n	ignore: { Instance }\n): Vector3?\n	-- Reachability is not optional here whatever the room says. A prop behind a wall,\n	-- with an instruction floating over it that the player can read and can never act\n	-- on, is worse than one answer fewer -- the event would look broken in a way that is\n	-- entirely invisible from the outside.\n	local direction = CFrame.fromAxisAngle(Vector3.yAxis, math.rad(-bearingDegrees)) * Vector3.new(0, 0, -1)\n	return Ground.SpotAt(from + direction * distance, radius, height, ignore, from)\nend\n\n-- How close the straight line from `from` to `to` ever gets to `point`, on the flat.\n-- Segment rather than infinite line: a prop the player would only pass if they kept\n-- walking past their destination is not on the way to anything.\nlocal function distanceToPath(from: Vector3, to: Vector3, point: Vector3): number\n	local start = Vector3.new(from.X, 0, from.Z)\n	local finish = Vector3.new(to.X, 0, to.Z)\n	local at = Vector3.new(point.X, 0, point.Z)\n\n	local along = finish - start\n	local length = along.Magnitude\n	if length < 0.01 then\n		return (at - start).Magnitude\n	end\n	local t = math.clamp((at - start):Dot(along) / (length * length), 0, 1)\n	return (at - (start + along * t)).Magnitude\nend\n\n-- Tries to lay the whole set out along one base bearing, and reports the spots or\n-- nothing. All or nothing on purpose: a set with two of its three answers placed is\n-- an event the player can only answer two ways, and neither they nor anyone reading\n-- a bug report would be able to tell that from the event simply being written that\n-- way.\nlocal function layOut(\n	wanted: { PropPlacement },\n	from: Vector3,\n	baseBearing: number,\n	radius: number,\n	height: number,\n	ignore: { Instance }\n): { [string]: Vector3 }?\n	local placed: { [string]: Vector3 } = {}\n	local taken: { { at: Vector3, reach: number } } = {}\n\n	for _, placement in wanted do\n		local distance = placement.distance or PROPS.DefaultDistance\n		local wish = baseBearing + (placement.offsetDegrees or 0)\n		local reach = Props.ById[placement.prop].reachStuds\n\n		local found: Vector3? = nil\n		-- Straight out from the authored bearing first, then alternating either side\n		-- of it in widening steps, so the arrangement keeps its shape whenever the\n		-- room allows and bends only as far as it has to.\n		for step = 0, PROPS.NudgeSteps do\n			local nudge = (PROPS.NudgeDegrees / PROPS.NudgeSteps) * step\n			for _, signed in { nudge, -nudge } do\n				local spot = spotAt(from, wish + signed, distance, radius, height, ignore)\n				if spot == nil then\n					continue\n				end\n				-- Two rules, and the second is the one that took a bad playtest to\n				-- find. The first is the obvious one: two props inside each other's\n				-- reach means the player standing at one is standing at both, and the\n				-- event answers itself with whichever this loop checked first.\n				--\n				-- The second is that a prop must not sit beside the walk to another\n				-- one. A rug 4.9 studs off the line to the toy has a 5-stud reach, so\n				-- crawling to the toy shoves the rug on the way past and takes an\n				-- answer the player was not giving -- and from their side nothing\n				-- happened except that the game decided for them. Checked both ways,\n				-- because this spot can be beside an existing walk or have an existing\n				-- prop beside its own.\n				--\n				-- Content authors the bearings that keep this true, but content cannot\n				-- be the guarantee: a wall in the way sends a prop up to NudgeDegrees\n				-- off where it was written to be, which is easily far enough to walk it\n				-- into somebody else's path.\n				local clear = true\n				for _, other in taken do\n					if Ground.FlatDistance(spot, other.at) < PROPS.MinSeparationStuds then\n						clear = false\n						break\n					end\n					if distanceToPath(from, spot, other.at) <= other.reach then\n						clear = false\n						break\n					end\n					if distanceToPath(from, other.at, spot) <= reach then\n						clear = false\n						break\n					end\n				end\n				if clear then\n					found = spot\n					break\n				end\n			end\n			if found ~= nil then\n				break\n			end\n			if step == 0 then\n				-- Zero and minus zero are the same bearing; skip the wasted second probe.\n				continue\n			end\n		end\n\n		if found == nil then\n			return nil\n		end\n		placed[placement.prop] = found\n		table.insert(taken, { at = found, reach = reach })\n	end\n\n	return placed\nend\n\n-- Where every prop goes, or nil when this room cannot hold the arrangement at all.\nlocal function findSpots(character: Model, from: Vector3, wanted: { PropPlacement }): { [string]: Vector3 }?\n	if #wanted == 0 then\n		return {}\n	end\n\n	local ignore = Ground.IgnoreList({ character })\n	local radius = Ground.BodyRadius(character)\n	local height = Ground.BodyHeight(character)\n\n	-- Straight ahead first, then alternating outward, so the set turns up where the\n	-- player is already looking whenever the room allows it.\n	for _, bearing in Ground.Bearings(PROPS.ArcDegrees, PROPS.Bearings) do\n		local placed = layOut(wanted, from, bearing, radius, height, ignore)\n		if placed ~= nil then\n			return placed\n		end\n	end\n	return nil\nend\n\n-- What the label over a prop should say, given everything the set is watching for.\n-- A destination says what taking it there means; the carried object says only that\n-- it can be picked up, because its three meanings are the three places it can go.\nlocal function labelFor(watches: { Watch }, propId: string, choiceLabels: { [string]: string }): string?\n	for _, watch in watches do\n		if watch.toId == propId then\n			return choiceLabels[watch.choiceId]\n		end\n	end\n	for _, watch in watches do\n		if watch.propId == propId then\n			if watch.verb == \"Carry\" then\n				return CARRY_LABEL\n			end\n			return choiceLabels[watch.choiceId]\n		end\n	end\n	return nil\nend\n\n-- Called by EventService at the moment a prompt opens, and the answer decides what\n-- the client is told. Returns false for every ordinary reason the room could not\n-- hold the question, so callers must not treat false as a fault: it means \"this one\n-- is a panel\", which is always a valid answer.\nlocal function begin(player: Player, event: LifeEvent): boolean\n	teardown(player)\n\n	if not enabled then\n		return false\n	end\n\n	local character, root = characterOf(player)\n	if character == nil or root == nil then\n		return false\n	end\n\n	local watches: { Watch } = {}\n	local choiceLabels: { [string]: string } = {}\n	for _, choice in event.choices do\n		local act = choice.act\n		if act == nil then\n			continue\n		end\n		choiceLabels[choice.id] = choice.label\n		table.insert(watches, {\n			choiceId = choice.id,\n			verb = act.verb,\n			propId = if act.at ~= nil then act.at.prop else nil,\n			toId = if act.to ~= nil then act.to.prop else nil,\n			stillFor = 0,\n		})\n	end\n	if #watches == 0 then\n		return false\n	end\n\n	local wanted, ok = placementsFor(event)\n	if not ok then\n		return false\n	end\n\n	local spots = findSpots(character, root.Position, wanted)\n	if spots == nil then\n		return false\n	end\n\n	local folder = setFolder(player)\n	local staged: { [string]: Staged } = {}\n	for _, placement in wanted do\n		local kind = Props.ById[placement.prop]\n		local spot = spots[placement.prop]\n		local model = PropModels.Build(kind)\n		-- Built with its pivot at the centre of its own underside, so one PivotTo onto\n		-- the floor point plus the prop's own lift puts it exactly where it belongs.\n		local at = spot + Vector3.new(0, kind.liftStuds, 0)\n		model:PivotTo(CFrame.new(at))\n		model.Parent = folder\n\n		local text = labelFor(watches, placement.prop, choiceLabels)\n		staged[placement.prop] = {\n			kind = kind,\n			model = model,\n			origin = at,\n			at = at,\n			-- Nil is survivable rather than fatal: a label that could not attach leaves\n			-- a prop that still works and is merely harder to find, which is a much\n			-- better failure than no prop at all.\n			label = if text ~= nil then PropLabel.Attach(model, text, kind.reachStuds) else nil,\n			near = false,\n		}\n	end\n\n	-- A Stay given where the player already is has nothing in the room to be written\n	-- over, so it is written over them. Deliberately not put on the floor under their\n	-- feet: this game's grammar is that a thing with something to say wears it above\n	-- its head, and the player is a thing.\n	local selfLabel: PropLabel.PropLabelHandle? = nil\n	for _, watch in watches do\n		if watch.verb == \"Stay\" and watch.propId == nil then\n			local handle = PropLabel.Attach(character, choiceLabels[watch.choiceId], PROPS.DefaultDistance)\n			if handle ~= nil then\n				-- Always within reach of itself, so it never gets to be asleep.\n				handle.SetNear(true)\n				selfLabel = handle\n			end\n			break\n		end\n	end\n\n	active[player] = {\n		eventId = event.id,\n		folder = folder,\n		props = staged,\n		watches = watches,\n		carrying = nil,\n		carryWeld = nil,\n		selfLabel = selfLabel,\n		lastAt = root.Position,\n		liveAt = os.clock() + PROPS.GraceSeconds,\n		-- 0 means the fallback is off, which is a testing state only -- see the safe\n		-- range on SecondsToChoose. Measured from here rather than from liveAt: the\n		-- grace is part of the time the player has, not an extension of it.\n		expiresAt = if PROPS.SecondsToChoose > 0 then os.clock() + PROPS.SecondsToChoose else nil,\n		answered = false,\n	}\n	return true\nend\n\n-- Picks the thing up. Welded to the player rather than moved by the server every\n-- tick, which is the one place this file lets physics do something: a weld hands\n-- network ownership to the player, so the thing in their arms is exactly as smooth\n-- as they are. Anything driven from here would arrive at whatever rate the tick runs\n-- at, which is a cookie that stutters.\n--\n-- The constraints are made here rather than at build time so they capture an offset\n-- that is definitely current -- the prop has been placed and possibly pushed since\n-- it was built.\nlocal function grab(player: Player, current: Active, propId: string)\n	local staged = current.props[propId]\n	if staged == nil then\n		return\n	end\n	local character, root = characterOf(player)\n	if character == nil or root == nil then\n		return\n	end\n	local primary = staged.model.PrimaryPart\n	if primary == nil then\n		return\n	end\n\n	for _, descendant in staged.model:GetDescendants() do\n		if descendant:IsA(\"BasePart\") and descendant ~= primary then\n			local hold = Instance.new(\"WeldConstraint\")\n			hold.Part0 = primary\n			hold.Part1 = descendant\n			hold.Parent = primary\n		end\n	end\n	for _, descendant in staged.model:GetDescendants() do\n		if descendant:IsA(\"BasePart\") then\n			descendant.Anchored = false\n		end\n	end\n\n	-- A part's LookVector is its own -Z, and the character faces theirs, so the thing\n	-- being carried sits at negative Z. Held in front and a little up: that is how a\n	-- toddler carries anything, and it is also the only position where the player can\n	-- still see what they picked up.\n	local weld = Instance.new(\"Weld\")\n	weld.Part0 = root\n	weld.Part1 = primary\n	weld.C0 = CFrame.new(0, Ground.BodyHeight(character) * PROPS.CarryHeightFraction, -PROPS.CarryAheadStuds)\n	weld.Parent = primary\n\n	current.carrying = propId\n	current.carryWeld = weld\n\n	-- It is in their arms. An instruction to pick it up, still floating over it, would\n	-- be telling them to do the thing they have just done.\n	local label = staged.label\n	if label ~= nil then\n		label.SetText(nil)\n	end\nend\n\n-- Shoves the prop along, away from the player, by a share of how far they actually\n-- moved. Refused when the new spot is not one a body could stand in, which is what\n-- stops a rug being walked through a wall and left there.\nlocal function shove(\n	character: Model,\n	staged: Staged,\n	playerAt: Vector3,\n	moved: Vector3\n): ()\n	local away = Vector3.new(staged.at.X - playerAt.X, 0, staged.at.Z - playerAt.Z)\n	if away.Magnitude < 0.05 then\n		return\n	end\n	local direction = away.Unit\n\n	local flatMoved = Vector3.new(moved.X, 0, moved.Z)\n	-- Only a shove that was actually toward the thing counts. Walking backwards away\n	-- from a rug must not drag it along behind you.\n	local into = flatMoved:Dot(direction)\n	if into <= 0 then\n		return\n	end\n\n	local step = direction * (into * PROPS.PushShare)\n	local candidate = staged.at + step\n\n	-- No reachability: the prop is being shoved one short step by a player already\n	-- touching it, so there is no route to check -- they are standing at both ends of it.\n	local ignore = Ground.IgnoreList({ character, staged.model })\n	local floor = Ground.SpotAt(candidate, Ground.BodyRadius(character), Ground.BodyHeight(character), ignore)\n	if floor == nil then\n		return\n	end\n\n	staged.at = floor + Vector3.new(0, staged.kind.liftStuds, 0)\n	staged.model:PivotTo(CFrame.new(staged.at))\nend\n\n-- Takes the answer. Guarded twice over: `answered` stops a second verb completing on\n-- the same frame from also being taken, and ResolveChoice itself refuses anything\n-- whose event is no longer the player's pending one. Neither guard is redundant --\n-- the first is about this tick and the second is about every other way an answer can\n-- arrive.\nlocal function resolve(player: Player, current: Active, choiceId: string)\n	if current.answered then\n		return\n	end\n	current.answered = true\n	EventService.ResolveChoice(player, current.eventId, choiceId)\nend\n\n-- Whether the player is near enough to this prop to be doing something with it, and\n-- keeping the label's waking-up in step with that answer. One place, so what the\n-- player is told and what the game will accept can never disagree.\nlocal function updateNear(staged: Staged, playerAt: Vector3): boolean\n	local near = Ground.FlatDistance(playerAt, staged.at) <= staged.kind.reachStuds\n	if near ~= staged.near then\n		staged.near = near\n		local label = staged.label\n		if label ~= nil then\n			label.SetNear(near)\n		end\n	end\n	return near\nend\n\nlocal function tickPlayer(player: Player, current: Active, delta: number)\n	local profile = DataService.GetProfile(player)\n	-- The prompt is the authority, not this table. An event answered on a panel, a\n	-- player who died, a life that ended, a profile that went away -- all of them show\n	-- up here as \"the pending id is no longer mine\", so there is one condition to get\n	-- right rather than a subscription to every service that could have ended it.\n	if profile == nil or not Lives.Active(profile.Data).alive or Lives.Active(profile.Data).pendingEventId ~= current.eventId then\n		teardown(player)\n		return\n	end\n\n	local character, root = characterOf(player)\n	if character == nil or root == nil then\n		return\n	end\n	local playerAt = root.Position\n	local moved = if current.lastAt ~= nil then playerAt - current.lastAt else Vector3.zero\n	current.lastAt = playerAt\n	local speed = Vector3.new(moved.X, 0, moved.Z).Magnitude / math.max(delta, 0.001)\n\n	local expiresAt = current.expiresAt\n	if expiresAt ~= nil and os.clock() >= expiresAt then\n		-- The prompt stays open; only the way of answering it changes. Nothing has been\n		-- lost and the player is not told off for taking too long -- the panel appears\n		-- and every answer is still on it.\n		local eventId = current.eventId\n		teardown(player)\n		EventService.FallBackToPanel(player, eventId)\n		return\n	end\n\n	local settling = os.clock() < current.liveAt\n\n	for _, watch in current.watches do\n		if current.answered then\n			return\n		end\n\n		local propId = watch.propId\n		local staged = if propId ~= nil then current.props[propId] else nil\n		if propId ~= nil and staged == nil then\n			continue\n		end\n\n		-- Still readable, not yet answerable. The labels are kept in step so the set\n		-- looks exactly as alive as it will be a second later -- what is withheld is the\n		-- answer, not the signposting, because a prop that stayed dim until it was armed\n		-- would teach the player that being close to it does nothing.\n		if settling then\n			if staged ~= nil then\n				updateNear(staged, playerAt)\n			end\n			continue\n		end\n\n		if watch.verb == \"Go\" or watch.verb == \"Take\" then\n			if staged ~= nil and updateNear(staged, playerAt) then\n				resolve(player, current, watch.choiceId)\n			end\n		elseif watch.verb == \"Push\" then\n			if staged ~= nil and updateNear(staged, playerAt) then\n				shove(character, staged, playerAt, moved)\n				if Ground.FlatDistance(staged.at, staged.origin) >= PROPS.PushStuds then\n					resolve(player, current, watch.choiceId)\n				end\n			end\n		elseif watch.verb == \"Carry\" then\n			local toId = watch.toId\n			local target = if toId ~= nil then current.props[toId] else nil\n			if target == nil then\n				continue\n			end\n			if current.carrying ~= propId then\n				-- Not carrying it yet. Picking it up is not an answer to anything, so\n				-- nothing is resolved here -- it only becomes possible to answer.\n				if staged ~= nil and updateNear(staged, playerAt) and current.carrying == nil then\n					grab(player, current, propId :: string)\n				end\n			elseif updateNear(target, playerAt) then\n				resolve(player, current, watch.choiceId)\n			end\n		elseif watch.verb == \"Stay\" then\n			local inPlace = staged == nil or updateNear(staged, playerAt)\n			if inPlace and speed <= PROPS.StillSpeedStuds then\n				watch.stillFor += delta\n			else\n				watch.stillFor = 0\n			end\n\n			local label = if staged ~= nil then staged.label else current.selfLabel\n			if label ~= nil then\n				-- Nil rather than zero when nothing is being held, so a player who moved\n				-- off does not leave an empty bar sitting there looking broken.\n				label.SetProgress(if watch.stillFor > 0 then watch.stillFor / PROPS.StayStillSeconds else nil)\n			end\n\n			if watch.stillFor >= PROPS.StayStillSeconds then\n				resolve(player, current, watch.choiceId)\n			end\n		end\n	end\nend\n\nlocal function tick(delta: number)\n	if next(active) == nil then\n		return\n	end\n	-- Collected first because tickPlayer can tear its own entry down, and removing a\n	-- key mid-traversal is only safe for the key being visited -- a fallback that\n	-- restaged something would add one.\n	local players: { Player } = {}\n	for player in active do\n		table.insert(players, player)\n	end\n\n	for _, player in players do\n		local current = active[player]\n		if current == nil then\n			continue\n		end\n		-- One player's set must not stop the next player's, so a fault here is\n		-- reported and stepped over rather than taking the loop down.\n		local ok, err = pcall(tickPlayer, player, current, delta)\n		if not ok then\n			warn(`[AGES] prop tick failed for {player.Name}: {err}`)\n		end\n	end\nend\n\n-- Answered, however it was answered -- by doing the thing, on a panel after a\n-- fallback, or by the harness forcing it. The set stops being live immediately and\n-- goes a moment later.\nlocal function onAnswered(player: Player, event: LifeEvent, _choice: EventChoice)\n	local current = active[player]\n	if current == nil or current.eventId ~= event.id then\n		return\n	end\n	current.answered = true\n	-- Put down before the linger rather than after it: a cookie welded to a player who\n	-- is already walking away from an outcome would follow them out of the scene.\n	release(current)\n	lingerThenTeardown(player, event.id)\nend\n\n-- Studio harness: what is out in the room right now, and what it is waiting for.\nfunction PropService.Describe(player: Player): string\n	local current = active[player]\n	if current == nil then\n		return `nothing staged | props {if enabled then \"on\" else \"off\"}`\n	end\n\n	local parts: { string } = {}\n	for _, watch in current.watches do\n		local where = watch.propId or \"here\"\n		local staged = if watch.propId ~= nil then current.props[watch.propId] else nil\n		local detail = \"\"\n		if watch.verb == \"Push\" and staged ~= nil then\n			detail = string.format(\" %.1f/%.0f studs\", Ground.FlatDistance(staged.at, staged.origin), PROPS.PushStuds)\n		elseif watch.verb == \"Stay\" then\n			detail = string.format(\" %.1f/%.1fs\", watch.stillFor, PROPS.StayStillSeconds)\n		elseif watch.verb == \"Carry\" then\n			detail = if current.carrying == watch.propId then ` held -> {watch.toId}` else ` -> {watch.toId}`\n		end\n		if staged ~= nil and staged.model.Parent == nil then\n			detail ..= \" PROP GONE\"\n		end\n		table.insert(parts, `{watch.choiceId}={watch.verb}({where}){detail}`)\n	end\n\n	local remaining = if current.expiresAt ~= nil\n		then string.format(\"%.0fs left\", math.max(0, current.expiresAt - os.clock()))\n		else \"no timeout\"\n	local settling = current.liveAt - os.clock()\n	local state = if current.answered\n		then \"ANSWERED\"\n		elseif settling > 0 then string.format(\"settling %.1fs\", settling)\n		else remaining\n	return `\"{current.eventId}\" | {table.concat(parts, \", \")} | {state}`\nend\n\nfunction PropService.SetEnabled(value: boolean)\n	enabled = value\n	if value then\n		return\n	end\n	-- Switching off mid-event leaves a prompt whose only way of being answered is\n	-- about to stop existing. Hand each one back to its panel rather than stranding\n	-- it. Collected first, because falling back must not run inside the traversal.\n	local stranded: { { player: Player, eventId: string } } = {}\n	for player, current in active do\n		table.insert(stranded, { player = player, eventId = current.eventId })\n	end\n	for _, entry in stranded do\n		teardown(entry.player)\n		EventService.FallBackToPanel(entry.player, entry.eventId)\n	end\nend\n\n-- Studio harness: clears every set on the server, for the test that left one behind.\nfunction PropService.ClearAll()\n	for _, player in Players:GetPlayers() do\n		teardown(player)\n	end\nend\n\nfunction PropService:Init()\n	-- Injected rather than required the other way around: EventService is what this\n	-- calls to resolve a choice, so it must not know about this file.\n	EventService.SetActHandler(begin)\nend\n\nfunction PropService:Start()\n	EventService.OnAnswered(onAnswered)\n	Players.PlayerRemoving:Connect(teardown)\n\n	task.spawn(function()\n		while true do\n			local delta = task.wait(PROPS.TickSeconds)\n			tick(delta)\n		end\n	end)\nend\n\nreturn PropService\n"
table.insert(AGES_MANIFEST, "src/server/services/PropService.luau")
AGES_SOURCES["src/server/services/ReadingService.luau"] = "--!strict\n-- Reading: the lesson where the answer is built rather than picked.\n--\n-- Two words stand on the board with letters missing, and there is one tray of tiles between\n-- them. That is the whole design. It is almost always obvious *which letter* goes in a gap\n-- -- that is not the question and was never meant to be -- and the question the player is\n-- actually answering, forty times a lesson, is **which word to spend it on**.\n--\n-- Two queues at half load each, which the activity law says is far more engaging than one\n-- at full, bought with one shared tray rather than with a second minigame. One target would\n-- be a conveyor belt: every placement forced, no decision anywhere in it.\n--\n-- The technique nothing teaches and nothing shows: fill the word that needs the rarer\n-- letters first. A player who has not noticed still finishes most lessons; a player who has\n-- finishes more. That is the shape a discovered optimum is supposed to have, and it is why\n-- the tray carries decoys and a little slack rather than exactly the letters required.\n--\n-- What mastery buys is takebacks, and nothing else. Not shorter words, not more time, not a\n-- bigger tray -- the number of times you may pull a placed tile back out, counted on screen.\n-- Requirement six of the activity law is that progression must widen the player\\'s own\n-- tolerance somewhere they can *see*, and a hidden multiplier or a wage would be invisible\n-- inside the verb. Difficulty comes from the age band instead and lives entirely in\n-- content/Words.luau.\n--\n-- Failure is soft everywhere. A word can be handed in half-built and scores the letters\n-- that are right; the lesson can be walked away from and scores what came back. Nothing\n-- here can take away a rung already earned, and there is no state a player has to wait\n-- their way out of.\n--\n-- Split three ways like the rest of school: ReadingRoom lays the desk and the shelf,\n-- content/Words.luau is the bank, and this file is the only thing that knows how a board is\n-- dealt or scored. It pays the ladder and the year itself, exactly as Science, Geography\n-- and Art do, because SchoolService deliberately does not know how any verb is graded.\n\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Config = require(ReplicatedStorage:WaitForChild(\"Config\"))\nlocal Lives = require(ReplicatedStorage:WaitForChild(\"Lives\"))\nlocal Remotes = require(ReplicatedStorage:WaitForChild(\"Remotes\"))\nlocal Types = require(ReplicatedStorage:WaitForChild(\"Types\"))\nlocal Mastery = require(ReplicatedStorage:WaitForChild(\"school\"):WaitForChild(\"Mastery\"))\nlocal Report = require(ReplicatedStorage:WaitForChild(\"school\"):WaitForChild(\"Report\"))\n\nlocal DataService = require(script.Parent.DataService)\nlocal EventService = require(script.Parent.EventService)\nlocal PlaceService = require(script.Parent.PlaceService)\nlocal SkillService = require(script.Parent.SkillService)\nlocal StatService = require(script.Parent.StatService)\nlocal ReadingRoom = require(script.Parent.Parent.world.ReadingRoom)\nlocal School = require(script.Parent.Parent.world.School)\nlocal Words = require(script.Parent.Parent.content.Words)\n\ntype LifeData = Types.LifeData\ntype ReadingState = Types.ReadingState\ntype WordCell = Types.WordCell\ntype WordTarget = Types.WordTarget\ntype TrayTile = Types.TrayTile\ntype Word = Words.Word\n\nlocal ReadingService = {}\n\nlocal ReadingUpdatedRemote = Remotes.Get(\"ReadingUpdated\")\nlocal RequestReadingPlaceRemote = Remotes.Get(\"RequestReadingPlace\")\nlocal RequestReadingSubmitRemote = Remotes.Get(\"RequestReadingSubmit\")\n\nlocal READING = Config.School.Reading\nlocal TRAY = READING.Tray\n\n-- The subject id this service answers to. A constant rather than a parameter because there\n-- is exactly one building subject; the day there is a second, this becomes an argument and\n-- nothing else here changes.\nlocal SUBJECT_ID = \"reading\"\n\n-- The place id the room answers to, the same one the lessons and the corridor use.\nlocal PLACE_ID = \"school\"\n\n-- The two ladders have to be the same length, and this is the only place that can notice. A\n-- sixth rung on one and not the other is a promotion the verb has no answer for -- the\n-- player is told they levelled up and the takeback count does not change -- which is the\n-- numbers-only progression this rebuild exists to remove, arriving by accident. Art keeps\n-- the same guard on its palette for the same reason.\nif #READING.TakebacksByLevel ~= Mastery.Levels then\n	error(\n		`[AGES config] Config.School.Reading.TakebacksByLevel has {#READING.TakebacksByLevel} entries`\n			.. ` but the mastery ladder has {Mastery.Levels} rungs. Every rung has to buy something`\n			.. ` here, or a level-up is a message with nothing behind it.`\n	)\nend\n\n-- One word on the board, server side. Holds the truth, which is the one thing the pushed\n-- shape must never carry: the client is sent the gaps and the tray, and what goes in which\n-- gap is the lesson.\ntype LiveTarget = {\n	word: Word,\n	cells: { WordCell },\n	done: boolean,\n}\n\ntype Session = {\n	targets: { LiveTarget },\n	tray: { TrayTile },\n	-- The tile in hand, by id, or nil. Held here rather than on the client because the\n	-- placement is scored server side, and a tile the client believed it was holding would be\n	-- a placement refused for no visible reason.\n	held: string?,\n	takebacks: number,\n	-- The words still to be dealt onto the board, in order.\n	pool: { Word },\n	wordsDone: number,\n	-- Fixed the moment the lesson is dealt: every gap in every word the lesson intends to\n	-- ask, including the ones never reached. The denominator, so walking out early scores\n	-- what came back rather than what was attempted -- the same rule Art scores a canvas by.\n	gapsTotal: number,\n	gapsCorrect: number,\n	endsAt: number,\n	levelAtStart: number,\n	atDesk: boolean,\n	atShelf: boolean,\n	line: string,\n	nextId: number,\n}\n\nlocal sessions: { [Player]: Session } = {}\nlocal pushed: { [Player]: string } = {}\nlocal notices: { [Player]: { text: string, until_: number } } = {}\nlocal enabled = true\nlocal roomBuilt = false\n\nlocal function characterPosition(player: Player): Vector3?\n	local character = player.Character\n	if character == nil then\n		return nil\n	end\n	local root = character:FindFirstChild(\"HumanoidRootPart\") :: BasePart?\n	if root == nil then\n		return nil\n	end\n	return root.Position\nend\n\nlocal function ageYearsOf(data: LifeData): number\n	return math.floor(data.ageMonths / Config.Time.MonthsPerYear)\nend\n\nlocal function levelOf(data: LifeData): number\n	return Mastery.LevelOf(data, SUBJECT_ID)\nend\n\n-- Lays the room once the school has streamed in. Retried rather than given up on, for the\n-- reason SchoolService retries its own: the building may still be arriving.\nlocal function ensureRoom(): boolean\n	if roomBuilt then\n		return ReadingRoom.Room() ~= nil\n	end\n	local place = PlaceService.Find(PLACE_ID)\n	if place == nil then\n		return false\n	end\n	roomBuilt = true\n	-- Raises the building if nobody has yet. Idempotent, and called from here as well as from\n	-- SchoolService so that a Reading lesson forced from the debug console before anybody has\n	-- walked to school still finds a room to stand in.\n	School.Build(place.part.Position)\n	return ReadingRoom.Build(School.RoomAt(\"reading\") or place.part.Position) ~= nil\nend\n\nlocal function notice(player: Player, text: string)\n	notices[player] = { text = text, until_ = os.clock() + Config.UI.NoticeSeconds }\nend\n\n-- Fisher-Yates, in place. Written out rather than reached for because there is no shuffle in\n-- the standard library and a sort with a random comparator is not one -- it biases, and the\n-- bias here would show up as the same letter always landing in the same corner of the tray.\nlocal function shuffle<T>(list: { T })\n	for i = #list, 2, -1 do\n		local j = math.random(1, i)\n		list[i], list[j] = list[j], list[i]\n	end\nend\n\n-- Cuts a word into cells with `gaps` of its letters taken out.\n--\n-- Never takes the first letter. A word missing its opening letter is materially harder to\n-- recognise than one missing any other, which would make the difficulty depend on which\n-- position the shuffle happened to pick rather than on the age band -- and two lessons of\n-- the same word would not be the same lesson.\nlocal function cutWord(word: Word): { WordCell }\n	local letters = string.split(word.word, \"\")\n	local positions: { number } = {}\n	for index = 2, #letters do\n		table.insert(positions, index)\n	end\n	shuffle(positions)\n\n	local hidden: { [number]: boolean } = {}\n	for index = 1, math.min(word.gaps, #positions) do\n		hidden[positions[index]] = true\n	end\n\n	local cells: { WordCell } = {}\n	for index, letter in letters do\n		if hidden[index] then\n			table.insert(cells, { letter = \"\", placed = false, gap = true })\n		else\n			table.insert(cells, { letter = letter, placed = false, gap = false })\n		end\n	end\n	return cells\nend\n\n-- Every letter the board is currently short of, across both words.\nlocal function neededLetters(session: Session): { string }\n	local out: { string } = {}\n	for _, target in session.targets do\n		if not target.done then\n			local letters = string.split(target.word.word, \"\")\n			for index, cell in target.cells do\n				if cell.gap then\n					table.insert(out, letters[index])\n				end\n			end\n		end\n	end\n	return out\nend\n\nlocal function nextId(session: Session): string\n	session.nextId += 1\n	return `t{session.nextId}`\nend\n\n-- Tops the tray back up to size: every letter the board is short of that is not already\n-- sitting unspent in the tray, plus decoys, shuffled.\n--\n-- **Spent tiles are replaced and unspent ones are kept.** That is what makes a trip to the\n-- shelf a refill rather than a reroll: a player who does not like the tray they were dealt\n-- cannot walk over and ask for a different one, they can only replace what they have\n-- already used. Without that the allocation this whole subject is built on is optional.\nlocal function fillTray(session: Session)\n	local kept: { TrayTile } = {}\n	for _, tile in session.tray do\n		if not tile.spent then\n			table.insert(kept, tile)\n		end\n	end\n\n	-- What the board still needs, minus what is already in hand on the tray.\n	local have: { [string]: number } = {}\n	for _, tile in kept do\n		have[tile.letter] = (have[tile.letter] or 0) + 1\n	end\n\n	local wanted: { string } = {}\n	for _, letter in neededLetters(session) do\n		local spare = have[letter] or 0\n		if spare > 0 then\n			have[letter] = spare - 1\n		else\n			table.insert(wanted, letter)\n		end\n	end\n\n	local fresh: { TrayTile } = {}\n	for _, letter in wanted do\n		if #kept + #fresh >= TRAY.Size then\n			break\n		end\n		table.insert(fresh, { id = nextId(session), letter = letter, spent = false })\n	end\n\n	-- Decoys, and everything left over after the needed letters are covered. Drawn from the\n	-- alphabet rather than from the words on the board, because a decoy that is always a\n	-- letter one of the two words wants is not a decoy, it is a spare.\n	local alphabet = string.split(\"ABCDEFGHIJKLMNOPQRSTUVWXYZ\", \"\")\n	while #kept + #fresh < TRAY.Size do\n		table.insert(fresh, { id = nextId(session), letter = alphabet[math.random(1, #alphabet)], spent = false })\n	end\n\n	local tray: { TrayTile } = {}\n	for _, tile in kept do\n		table.insert(tray, tile)\n	end\n	for _, tile in fresh do\n		table.insert(tray, tile)\n	end\n	shuffle(tray)\n	session.tray = tray\nend\n\n-- Puts the next word from the pool onto the board in the slot that just came free. Leaves\n-- the slot showing the finished word when the pool is empty, which is what \"the lesson ran\n-- out of words\" should look like -- not a blank square.\nlocal function dealNext(session: Session, slot: number)\n	local word = table.remove(session.pool, 1)\n	if word == nil then\n		return\n	end\n	session.targets[slot] = { word = word, cells = cutWord(word), done = false }\nend\n\nlocal function tileById(session: Session, id: string): TrayTile?\n	for _, tile in session.tray do\n		if tile.id == id then\n			return tile\n		end\n	end\n	return nil\nend\n\n-- What the client is shown. Built fresh and compared as a string before sending, the same\n-- throttle every other school channel uses.\nlocal function stateFor(player: Player): ReadingState\n	local session = sessions[player]\n	if session == nil then\n		local held = notices[player]\n		local line = \"\"\n		if held ~= nil and os.clock() < held.until_ then\n			line = held.text\n		else\n			notices[player] = nil\n		end\n		return {\n			active = false,\n			line = line,\n			targets = {},\n			tray = {},\n			heldTileId = nil,\n			takebacks = 0,\n			wordsDone = 0,\n			wordsTarget = READING.WordsPerLesson,\n			secondsLeft = 0,\n			atDesk = false,\n			atShelf = false,\n			masteryLevel = 1,\n		}\n	end\n\n	local targets: { WordTarget } = {}\n	for index, target in session.targets do\n		local cells: { WordCell } = {}\n		for _, cell in target.cells do\n			table.insert(cells, { letter = cell.letter, placed = cell.placed, gap = cell.gap })\n		end\n		table.insert(targets, { id = `w{index}`, cells = cells, done = target.done })\n	end\n\n	local profile = DataService.GetProfile(player)\n	local level = if profile ~= nil then levelOf(Lives.Active(profile.Data)) else 1\n\n	return {\n		active = true,\n		line = session.line,\n		targets = targets,\n		tray = session.tray,\n		heldTileId = session.held,\n		takebacks = session.takebacks,\n		wordsDone = session.wordsDone,\n		wordsTarget = READING.WordsPerLesson,\n		secondsLeft = math.max(session.endsAt - os.clock(), 0),\n		atDesk = session.atDesk,\n		atShelf = session.atShelf,\n		masteryLevel = level,\n	}\nend\n\nlocal function push(player: Player)\n	local state = stateFor(player)\n	local parts = { tostring(state.active), state.line, tostring(state.takebacks), tostring(state.wordsDone) }\n	table.insert(parts, tostring(state.heldTileId))\n	table.insert(parts, tostring(state.atDesk))\n	table.insert(parts, tostring(state.atShelf))\n	-- Whole seconds only. A clock compared to the millisecond counts as a change every tick\n	-- and the throttle would do nothing at all.\n	table.insert(parts, tostring(math.floor(state.secondsLeft)))\n	for _, target in state.targets do\n		for _, cell in target.cells do\n			table.insert(parts, if cell.gap then \"_\" else cell.letter)\n		end\n		table.insert(parts, tostring(target.done))\n	end\n	for _, tile in state.tray do\n		table.insert(parts, `{tile.letter}{if tile.spent then \"-\" else \"+\"}`)\n	end\n\n	local signature = table.concat(parts, \"|\")\n	if pushed[player] == signature then\n		return\n	end\n	pushed[player] = signature\n	ReadingUpdatedRemote:FireClient(player, state)\nend\n\n-- Scores a word as it stands and banks the letters that are right. Called by handing one in\n-- and by the clock running out, so an unfinished board is scored the same way a finished one\n-- is -- there is no second calculation here to disagree with the first.\nlocal function scoreTarget(session: Session, target: LiveTarget)\n	if target.done then\n		return\n	end\n	local letters = string.split(target.word.word, \"\")\n	for index, cell in target.cells do\n		if cell.placed and cell.letter == letters[index] then\n			session.gapsCorrect += 1\n		end\n	end\n	target.done = true\nend\n\nlocal function finish(player: Player, data: LifeData, session: Session, reason: string)\n	-- Decided before anything is written, which is the idempotency rule this codebase runs\n	-- on: work the outcome out, then record it.\n	for _, target in session.targets do\n		scoreTarget(session, target)\n	end\n\n	local share = if session.gapsTotal > 0 then session.gapsCorrect / session.gapsTotal else 0\n	local band = Report.BandFor(share)\n	local gained = Report.SmartsFor(band)\n\n	sessions[player] = nil\n\n	if gained ~= 0 then\n		StatService.AddStat(player, \"smarts\", gained)\n	end\n\n	-- Banked once on the whole board rather than per word, for the reason Art banks once per\n	-- canvas: a lesson is a lesson. Paying the ladder six times would make Reading climb at\n	-- six times every other subject\\'s rate and top out inside a single afternoon.\n	Mastery.Record(data, SUBJECT_ID, share)\n\n	local earned = math.floor(Config.Skills.Awards.WordBuilt * session.wordsDone)\n	if earned > 0 then\n		SkillService.Award(player, \"academics\", earned, \"finished a word\")\n	end\n\n	-- Counted however it ended, including walked away from, for the reason every other\n	-- lesson is: otherwise a player could start, look at the board, leave, and start again\n	-- until they were dealt words they liked.\n	data.lessonsThisYear += 1\n	EventService.AwardAutonomy(player, 1)\n\n	local level = levelOf(data)\n	Report.RecordLesson(data, SUBJECT_ID, band, gained, if level > session.levelAtStart then level else nil)\n\n	local percent = math.floor(share * 100 + 0.5)\n	local opening = if reason == \"handed\"\n		then \"You handed the board in.\"\n		elseif reason == \"left\" then \"You walked away from it.\"\n		else \"Time.\"\n	local reward = if gained > 0 then `. +{gained} smarts.` else \".\"\n	notice(player, `{opening} {session.wordsDone} of {READING.WordsPerLesson} words, {percent}%{reward}`)\n	push(player)\nend\n\n-- Takes a tile, puts the one in hand into a gap, or pulls a placed one back out.\n--\n-- One entry point for all three because they are one verb with a target, and splitting them\n-- would mean three remotes that can disagree about what is in the player\\'s hand.\nlocal function onPlaceRequested(player: Player, targetIndex: unknown, cellIndex: unknown)\n	local session = sessions[player]\n	if session == nil then\n		return\n	end\n	if not session.atDesk then\n		notice(player, \"You have to be at the desk.\")\n		push(player)\n		return\n	end\n\n	-- A tile id rather than a board position: picking up.\n	if typeof(targetIndex) == \"string\" then\n		local tile = tileById(session, targetIndex)\n		if tile == nil or tile.spent then\n			return\n		end\n		-- Tapping the tile already in hand puts it down, which is the only way to change your\n		-- mind without spending a takeback.\n		session.held = if session.held == targetIndex then nil else targetIndex\n		push(player)\n		return\n	end\n\n	if typeof(targetIndex) ~= \"number\" or typeof(cellIndex) ~= \"number\" then\n		return\n	end\n	local target = session.targets[targetIndex]\n	if target == nil or target.done then\n		return\n	end\n	local cell = target.cells[cellIndex]\n	if cell == nil then\n		return\n	end\n\n	-- A filled gap: the takeback. Free until they run out, and the tile comes back unspent --\n	-- that is what makes it a takeback rather than an apology.\n	if cell.placed then\n		if session.takebacks <= 0 then\n			notice(player, \"No takebacks left.\")\n			push(player)\n			return\n		end\n		for _, tile in session.tray do\n			if tile.spent and tile.letter == cell.letter then\n				tile.spent = false\n				break\n			end\n		end\n		session.takebacks -= 1\n		cell.letter = \"\"\n		cell.placed = false\n		cell.gap = true\n		push(player)\n		return\n	end\n\n	if not cell.gap then\n		-- One of the word\\'s own letters. Not an error worth a line: the player tapped a\n		-- square that was never theirs to fill.\n		return\n	end\n\n	local heldId = session.held\n	if heldId == nil then\n		return\n	end\n	local tile = tileById(session, heldId)\n	if tile == nil or tile.spent then\n		session.held = nil\n		push(player)\n		return\n	end\n\n	-- The placement. Not scored here and deliberately not told to the player either: a gap\n	-- that turned green on a right letter would do the reading for them, and the subject is\n	-- looking at the word and seeing what it is missing.\n	cell.letter = tile.letter\n	cell.placed = true\n	cell.gap = false\n	tile.spent = true\n	session.held = nil\n	push(player)\nend\n\n-- Hands a word in. The commit, and the only irreversible act in the lesson.\nlocal function onSubmitRequested(player: Player, targetIndex: unknown)\n	local session = sessions[player]\n	if session == nil or typeof(targetIndex) ~= \"number\" then\n		return\n	end\n	if not session.atDesk then\n		notice(player, \"You have to be at the desk.\")\n		push(player)\n		return\n	end\n	local target = session.targets[targetIndex]\n	if target == nil or target.done then\n		return\n	end\n\n	scoreTarget(session, target)\n	session.wordsDone += 1\n	dealNext(session, targetIndex)\n	fillTray(session)\n	push(player)\n\n	if session.wordsDone >= READING.WordsPerLesson then\n		local profile = DataService.GetProfile(player)\n		if profile ~= nil then\n			finish(player, Lives.Active(profile.Data), session, \"handed\")\n		end\n	end\nend\n\nlocal function tickPlayer(player: Player, _dt: number)\n	local session = sessions[player]\n	if session == nil then\n		push(player)\n		return\n	end\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return\n	end\n\n	local position = characterPosition(player)\n	local room = ReadingRoom.Room()\n	if position ~= nil and room ~= nil then\n		session.atDesk = (position - room.desk).Magnitude <= TRAY.ReachStuds\n		local atShelf = (position - room.shelf).Magnitude <= TRAY.ReachStuds\n		-- Arriving at the shelf is what draws tiles, not standing at it. Otherwise a player\n		-- who parked there would be handed a fresh tray every tick, which is the reroll the\n		-- refill rule exists to prevent.\n		if atShelf and not session.atShelf then\n			fillTray(session)\n			notice(player, \"You took a fresh handful.\")\n		end\n		session.atShelf = atShelf\n	end\n\n	if os.clock() >= session.endsAt then\n		finish(player, Lives.Active(profile.Data), session, \"time\")\n		return\n	end\n	push(player)\nend\n\n-- Starts a lesson. The contract SchoolService dispatches against, and the same one Science,\n-- Geography and Art hold: refuse with a line worth saying out loud, or take the afternoon.\nfunction ReadingService.Begin(player: Player, data: LifeData): (boolean, string?)\n	if sessions[player] ~= nil then\n		return false, \"You are already at the desk.\"\n	end\n	if not enabled then\n		return false, \"There is no reading today.\"\n	end\n	if not ensureRoom() then\n		return false, \"The reading room is closed today.\"\n	end\n\n	local pool = Words.ForAge(ageYearsOf(data))\n	if #pool < READING.WordsPerLesson then\n		-- Impossible if the content file loaded, which checks every age has enough. Reachable\n		-- only if the bank is thinned without the check being updated, and the honest thing is\n		-- to say so rather than deal a board with nothing on it.\n		return false, \"There is nothing on the board today.\"\n	end\n\n	local chosen: { Word } = {}\n	for _, word in pool do\n		table.insert(chosen, word)\n	end\n	shuffle(chosen)\n	while #chosen > READING.WordsPerLesson do\n		table.remove(chosen)\n	end\n\n	local gapsTotal = 0\n	for _, word in chosen do\n		gapsTotal += word.gaps\n	end\n\n	local level = levelOf(data)\n	local session: Session = {\n		targets = {},\n		tray = {},\n		held = nil,\n		takebacks = READING.TakebacksByLevel[level],\n		pool = chosen,\n		wordsDone = 0,\n		gapsTotal = gapsTotal,\n		gapsCorrect = 0,\n		endsAt = os.clock() + READING.SecondsPerLesson,\n		levelAtStart = level,\n		atDesk = false,\n		atShelf = false,\n		line = \"Two words. One tray. Spend it well.\",\n		nextId = 0,\n	}\n\n	for slot = 1, READING.TargetsAtOnce do\n		dealNext(session, slot)\n	end\n	fillTray(session)\n\n	sessions[player] = session\n	notices[player] = nil\n	push(player)\n	return true\nend\n\nlocal function forget(player: Player)\n	sessions[player] = nil\n	notices[player] = nil\n	pushed[player] = nil\nend\n\nfunction ReadingService.ResetForNewLife(player: Player)\n	forget(player)\n	push(player)\nend\n\n-- Debug: start a lesson from where the player stands.\nfunction ReadingService.ForceStart(player: Player): (boolean, string?)\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return false, \"no profile loaded\"\n	end\n	return ReadingService.Begin(player, Lives.Active(profile.Data))\nend\n\n-- Debug: grade the board where it stands, the way walking out does.\nfunction ReadingService.ForceEnd(player: Player): boolean\n	local session = sessions[player]\n	if session == nil then\n		return false\n	end\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return false\n	end\n	finish(player, Lives.Active(profile.Data), session, \"left\")\n	return true\nend\n\n-- Debug: fill every gap on the board correctly, so the scoring and the hand-in can be\n-- reached without spelling six words by hand.\nfunction ReadingService.Solve(player: Player): boolean\n	local session = sessions[player]\n	if session == nil then\n		return false\n	end\n	for _, target in session.targets do\n		if not target.done then\n			local letters = string.split(target.word.word, \"\")\n			for index, cell in target.cells do\n				if cell.gap then\n					cell.letter = letters[index]\n					cell.placed = true\n					cell.gap = false\n				end\n			end\n		end\n	end\n	push(player)\n	return true\nend\n\nfunction ReadingService.SetEnabled(value: boolean)\n	enabled = value\nend\n\nfunction ReadingService.IsEnabled(): boolean\n	return enabled\nend\n\nfunction ReadingService.Describe(player: Player): string\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return \"no profile loaded\"\n	end\n	local data = Lives.Active(profile.Data)\n	local room = ReadingRoom.Room()\n	local lines = {\n		`enabled: {enabled}`,\n		`mastery: {levelOf(data)}/{Mastery.Levels}  takebacks at that level: {READING.TakebacksByLevel[levelOf(data)]}`,\n		`room: {if room ~= nil then \"laid\" else \"not laid yet\"}`,\n	}\n	local session = sessions[player]\n	if session == nil then\n		table.insert(lines, \"no lesson running\")\n	else\n		table.insert(\n			lines,\n			`words {session.wordsDone}/{READING.WordsPerLesson}`\n				.. `  gaps {session.gapsCorrect}/{session.gapsTotal}`\n				.. `  takebacks {session.takebacks}`\n				.. `  {math.floor(math.max(session.endsAt - os.clock(), 0))}s left`\n				.. `  desk={session.atDesk} shelf={session.atShelf}`\n		)\n		for index, target in session.targets do\n			local shown = {}\n			for _, cell in target.cells do\n				table.insert(shown, if cell.gap then \"_\" else cell.letter)\n			end\n			table.insert(lines, `  {index}: {table.concat(shown, \"\")}  (answer {target.word.word}) done={target.done}`)\n		end\n	end\n	return table.concat(lines, \"\\n\")\nend\n\nfunction ReadingService:Start()\n	Players.PlayerRemoving:Connect(forget)\n\n	RequestReadingPlaceRemote.OnServerEvent:Connect(function(player: Player, targetIndex: unknown, cellIndex: unknown)\n		local ok, err = pcall(onPlaceRequested, player, targetIndex, cellIndex)\n		if not ok then\n			warn(`[AGES] reading place failed for {player.Name}: {err}`)\n		end\n	end)\n\n	RequestReadingSubmitRemote.OnServerEvent:Connect(function(player: Player, targetIndex: unknown)\n		local ok, err = pcall(onSubmitRequested, player, targetIndex)\n		if not ok then\n			warn(`[AGES] reading submit failed for {player.Name}: {err}`)\n		end\n	end)\n\n	task.spawn(function()\n		while true do\n			local elapsed = task.wait(READING.TickSeconds)\n			ensureRoom()\n			for _, player in Players:GetPlayers() do\n				local ok, err = pcall(tickPlayer, player, elapsed)\n				if not ok then\n					warn(`[AGES] reading tick failed for {player.Name}: {err}`)\n				end\n			end\n		end\n	end)\nend\n\nreturn ReadingService\n"
table.insert(AGES_MANIFEST, "src/server/services/ReadingService.luau")
AGES_SOURCES["src/server/services/ReturnService.luau"] = "--!strict\n-- The way out. The game place's half of the handshake `LobbyService.Play` starts.\n--\n-- **This file is what replaced being reborn where you stood.** Until part 3, dying wound the\n-- same body back to age zero, cleared the setup and drew the character menu over the town --\n-- so a player had exactly one life at a time and no way to look at it once it was over. Now\n-- a life ends in the slot it was lived in and stays there, and the player comes back here to\n-- pick a card: the one the dead person is in, to read them and delete them, or another one.\n--\n-- The trip is the same three steps as Play, in the same order and for the same reason (see\n-- LobbyService's header): the profile is written, the player leaves, ProfileStore's session\n-- ends and does its final save, and the *lobby* then opens a key nobody is holding. Nothing\n-- travels in TeleportData. There is nothing to put in it -- the lobby reads the save.\n--\n-- The one thing this file does that Play does not: it is also the arrival check. A player\n-- who lands in the game place on a slot with no life in it, or with a dead one, is a player\n-- who got here by a route the lobby would not have offered -- joining the place id directly,\n-- or dying and rejoining before the teleport landed. There is no menu here to show them any\n-- more, so the only honest answer is to send them back to the one that exists.\n\nlocal Players = game:GetService(\"Players\")\nlocal RunService = game:GetService(\"RunService\")\nlocal TeleportService = game:GetService(\"TeleportService\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Config = require(ReplicatedStorage:WaitForChild(\"Config\"))\nlocal Lives = require(ReplicatedStorage:WaitForChild(\"Lives\"))\nlocal Remotes = require(ReplicatedStorage:WaitForChild(\"Remotes\"))\n\nlocal DataService = require(script.Parent.DataService)\nlocal SetupService = require(script.Parent.SetupService)\n-- The Studio arrival path below calls BodyService.Apply to force the child body on, and\n-- this require was missing -- so that call was a nil index that threw on every join in\n-- Studio, out of a PlayerAdded handler, after the life had already been rolled. The\n-- player landed in a begun life with an adult body and the rest of the handler skipped.\n-- BodyService reaches only DataService, so this closes no cycle.\nlocal BodyService = require(script.Parent.BodyService)\n\nlocal RequestReturnToLobbyRemote = Remotes.Get(\"RequestReturnToLobby\")\nlocal ReturnRefusedRemote = Remotes.Get(\"ReturnRefused\")\n\nlocal ReturnService = {}\n\n-- Who has a teleport in the air, and since when. A timestamp rather than a boolean, for the\n-- reason spelled out on the lobby's copy of this table: a boolean cleared only on success or\n-- on a caught failure stays true forever the one time neither happens, and the player is then\n-- looking at a death screen whose only button will never work again.\nlocal inFlight: { [Player]: number } = {}\n\nlocal function refuse(player: Player, reason: string)\n	ReturnRefusedRemote:FireClient(player, reason)\nend\n\n-- Why the trip cannot be made, in a sentence, or nil.\n--\n-- Both refusals here are developer-facing and neither is hidden. A player will never see\n-- either in a published build, and the developer who does see one has been handed the fix in\n-- the same line rather than a teleport that quietly does nothing.\nlocal function blockedBecause(player: Player): string?\n	local since = inFlight[player]\n	if since ~= nil and os.clock() - since < Config.Lobby.TeleportTimeoutSeconds then\n		return \"Already heading back -- hold on.\"\n	end\n	if RunService:IsStudio() then\n		return \"Teleporting does not work in Studio, so there is no way back to the menu from \"\n			.. \"here. Publish both places and test in-game.\"\n	end\n	if Config.Lobby.LobbyPlaceId == 0 then\n		return \"This build has no lobby place id yet. Publish the lobby as the start place and \"\n			.. \"set Config.Lobby.LobbyPlaceId to its id.\"\n	end\n	return nil\nend\n\n-- Retried rather than reported on the first failure, because the common failures here pass on\n-- their own. Only the last one is ever shown, and it is always shown.\nlocal function teleport(player: Player): (boolean, string?)\n	local lastError: string? = nil\n	for attempt = 1, Config.Lobby.TeleportRetries + 1 do\n		if player.Parent ~= Players then\n			-- They left while we were retrying, which is the outcome this function was trying\n			-- to arrange anyway. Not an error, and firing a refusal at somebody who has gone is\n			-- a warning in the log for nothing.\n			return false, nil\n		end\n		local ok, err = pcall(function()\n			TeleportService:TeleportAsync(Config.Lobby.LobbyPlaceId, { player })\n		end)\n		if ok then\n			return true, nil\n		end\n		lastError = tostring(err)\n		if attempt <= Config.Lobby.TeleportRetries then\n			task.wait(Config.Lobby.TeleportRetrySeconds)\n		end\n	end\n	return false, lastError\nend\n\n-- Send the player back to the menu.\n--\n-- Public because three completely different things need it and all three mean the same thing:\n-- the death screen's button, a player choosing to switch lives mid-run, and the arrival check\n-- below finding nothing here to play. Safe to call twice -- the in-flight stamp makes the\n-- second call a refusal rather than a second teleport.\nfunction ReturnService.Send(player: Player)\n	local blocked = blockedBecause(player)\n	if blocked ~= nil then\n		refuse(player, blocked)\n		return\n	end\n\n	inFlight[player] = os.clock()\n	local ok, err = teleport(player)\n	if ok then\n		return\n	end\n	inFlight[player] = nil\n	if err ~= nil then\n		warn(`[AGES] return: teleport to the lobby failed for {player.Name} after {Config.Lobby.TeleportRetries + 1} tries -- {err}`)\n		refuse(player, \"Could not get back to the menu -- Roblox refused the teleport. Try again in a moment.\")\n	end\nend\n\n-- Is there anything in this place for this player to do?\n--\n-- Deliberately not \"is the life alive\": an *unbegun* slot is the more likely of the two, and\n-- it is the more dangerous. Every clock in this game checks `Lives.HasBegun` before it moves,\n-- so a player standing in a slot with no setup in it is standing in a world that will never\n-- start -- and before part 3 that was fine, because the menu was drawn over it. It is not\n-- drawn over it any more.\nlocal function onPlayerAdded(player: Player)\n	-- Must run synchronously (no task.spawn) so it fires before BodyService's watch\n	-- on the same PlayerAdded queue. If deferred, BodyService sizes the character\n	-- to the saved adult age first and the child life never gets applied on join.\n	local profile = DataService.WaitForProfile(player)\n	if profile == nil or player.Parent ~= Players then\n		return\n	end\n	-- In Studio, always start a fresh child life on join. This runs BEFORE the\n	-- \"has an adult life already?\" check so that BodyService, which sizes the\n	-- character as adult on the first frame it sees a begun life, never gets a\n	-- chance to apply adult scales. A force-skipped life is always age zero, so\n	-- beginLife runs BodyService.Apply against a child body right here.\n	-- /setup skip is still available mid-session to restart at will.\n	if RunService:IsStudio() then\n		local rolled = SetupService.Skip(player, true)\n		if rolled == nil then\n			warn(\n				`[AGES] return: {player.Name} could not begin a life in Studio -- `\n					.. `SetupService.Skip returned nil`\n			)\n			return\n		end\n		-- Skip/commit calls beginLife which calls BodyService.Apply, but BodyService's\n		-- CharacterAdded handler may have already fired (with the default adult body) before\n		-- the profile was ready. Calling Apply again here guarantees the child scales are on\n		-- the character regardless of timing.\n		BodyService.Apply(player)\n		-- Yield one frame so BodyService's PlayerAdded handler (connected after ours)\n		-- cannot fire its synchronous character check before we finish. Without this,\n		-- BodyService reads the still-unbegun profile and sizes the character adult-sized\n		-- on the very first frame, overwriting the child scales we just applied.\n		task.wait()\n		return\n	end\n	local life = Lives.Active(profile.Data)\n	if Lives.HasBegun(life) and life.alive then\n		return\n	end\n	warn(\n		`[AGES] return: {player.Name} arrived on slot {profile.Data.activeSlot} with no life to play `\n			.. `(begun={Lives.HasBegun(life)}, alive={life.alive}); sending them back to the lobby`\n	)\n	ReturnService.Send(player)\nend\n\nfunction ReturnService:Init()\n	RequestReturnToLobbyRemote.OnServerEvent:Connect(function(player: Player)\n		ReturnService.Send(player)\n	end)\n\n	-- A teleport can fail *after* TeleportAsync returned successfully, and this is the only\n	-- place that hears about it. Without it the player sits on a death screen whose button has\n	-- already been pressed, refusing to work for TeleportTimeoutSeconds, saying nothing.\n	TeleportService.TeleportInitFailed:Connect(function(player, result, message)\n		inFlight[player] = nil\n		warn(`[AGES] return: teleport init failed for {player.Name} -- {result.Name}: {message}`)\n		refuse(player, \"Could not get back to the menu -- the teleport was rejected. Try again in a moment.\")\n	end)\n\n	Players.PlayerRemoving:Connect(function(player: Player)\n		inFlight[player] = nil\n	end)\nend\n\nfunction ReturnService:Start()\n	-- Connected in Start rather than Init so that a player arriving in the first moments of a\n	-- server is checked by a service that is fully up, and -- more to the point -- so that the\n	-- loop below cannot fire before DataService is ready to be waited on.\n	Players.PlayerAdded:Connect(onPlayerAdded)\n\n	for _, player in Players:GetPlayers() do\n		task.spawn(onPlayerAdded, player)\n	end\nend\n\nreturn ReturnService\n"
