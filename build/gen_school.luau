AGES_SOURCES["src/shared/Money.luau"] = "--!strict\n-- How money is written down. Nothing here moves a balance -- that is\n-- MoneyService, and this is to that what Delivery.luau is to DeliveryService: the\n-- shared facts about a thing, on the client's side of the fence as well as the\n-- server's.\n--\n-- Shared because the same amount is read in three places that do not otherwise\n-- know about each other: the HUD, a priced choice on a panel, and a label floating\n-- over a marker on the floor. A balance that formats one way on the HUD and\n-- another way in the room reads as two different currencies, and the player has to\n-- work out for themselves that it isn't.\n\nlocal Money = {}\n\n-- US dollars, matching the US English the events are already written in. One\n-- constant rather than a Config entry: this is not a number anyone tunes, and a\n-- currency that could be switched at runtime would need every authored price\n-- rewritten to mean anything.\nlocal SYMBOL = \"$\"\n\n-- Thousands separators. Below four digits nothing here does anything at all, which\n-- is most of childhood -- but an adult's savings are exactly the number the player\n-- most needs to read at a glance, and \"184000\" is not readable at a glance.\nlocal GROUP_SIZE = 3\nlocal GROUP_SEPARATOR = \",\"\n\n-- Groups the digits from the right, which is the only direction that works: the\n-- separators fall every three digits counting back from the units, so a number of\n-- unknown length cannot be grouped by walking forward through it.\nlocal function grouped(digits: string): string\n	local out = \"\"\n	local sinceBreak = 0\n	for index = #digits, 1, -1 do\n		out = string.sub(digits, index, index) .. out\n		sinceBreak += 1\n		-- The `index > 1` is what stops a leading separator on an exact multiple of\n		-- three: without it 100 formats as \",100\".\n		if sinceBreak == GROUP_SIZE and index > 1 then\n			out = GROUP_SEPARATOR .. out\n			sinceBreak = 0\n		end\n	end\n	return out\nend\n\n-- An amount as the player reads it. Truncated rather than rounded, because every\n-- amount in the game is authored whole and reaches here whole -- if a fraction ever\n-- does arrive, showing the smaller figure is the honest way to be wrong about\n-- someone's balance.\n--\n-- Negatives are formatted rather than clamped. MoneyService guarantees a balance\n-- never goes below zero, so a minus sign on screen would be a bug -- and one worth\n-- being able to see, rather than one hidden by the thing that displays it.\nfunction Money.Format(amount: number): string\n	local sign = if amount < 0 then \"-\" else \"\"\n	local whole = math.floor(math.abs(amount))\n	return `{sign}{SYMBOL}{grouped(tostring(whole))}`\nend\n\nreturn Money\n"
table.insert(AGES_MANIFEST, "src/shared/Money.luau")
AGES_SOURCES["src/shared/Remotes.luau"] = "--!strict\n-- Single source of truth for remotes. Both server and client require this\n-- module; it lazily creates (server) or waits for (client) the RemoteEvent\n-- instances so there is never a second place that spells out remote names.\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal RunService = game:GetService(\"RunService\")\n\n-- The `Request` remotes are the only client -> server ones; everything else is a\n-- one-way state push. In the game place they carry no payload at all (RequestAgeUp)\n-- or only ids, which the server checks against what it actually offered this player\n-- — so there is nothing useful to forge. Clicking the dots over somebody's head is\n-- not itself sent anywhere: it opens a menu the client was already holding, and only\n-- what the player picks off that menu ever leaves this machine.\n--\n-- The one exception is `RequestCreateLife`, which carries a typed name, and it lives\n-- in the *lobby*. That is not a coincidence: free text is the one input that needs a\n-- filter and a refusal path, and putting the only screen that takes it in a place with\n-- no world running behind it means a name being rejected costs the player nothing.\nexport type RemoteName =\n	\"StatsUpdated\"\n	| \"MoneyUpdated\"\n	| \"AgeUpdated\"\n	| \"AgeUpProgress\"\n	| \"LifeStageChanged\"\n	| \"PlayerDied\"\n	| \"RequestAgeUp\"\n	| \"RequestReturnToLobby\"\n	| \"ReturnRefused\"\n	| \"EventOffered\"\n	| \"EventResolved\"\n	| \"RequestEventChoice\"\n	| \"ShiftUpdated\"\n	| \"Notice\"\n	| \"GuideUpdated\"\n	| \"JobPostsUpdated\"\n	| \"TaskUpdated\"\n	| \"LessonUpdated\"\n	| \"PersonUpdated\"\n	| \"RequestPersonOffer\"\n	| \"RequestLessonAnswer\"\n	-- The two roster remotes. Their prose lives down in `REMOTE_NAMES` rather than being\n	-- repeated here, the same as most of the names above them; what matters at this end is\n	-- only that they are here at all. They were not, for a while, and the gap is worth a\n	-- word because nothing caught it: `REMOTE_NAMES` is annotated `{ RemoteName }`, so a\n	-- name in that list and missing from this union is a type error in two places at once\n	-- -- the list literal and every `Remotes.Get` that spells it -- and yet the file\n	-- compiles, both places build, and the remotes work perfectly at runtime. Only the\n	-- analyzer ever objects, which means only Studio ever objects.\n	| \"PeopleRosterUpdated\"\n	| \"RequestPersonContact\"\n	| \"LobbySlotsUpdated\"\n	| \"LobbySetupOptions\"\n	| \"RequestPlay\"\n	| \"PlayRefused\"\n	| \"RequestSelectSlot\"\n	| \"RequestDeleteSlot\"\n	| \"RequestCreateLife\"\n	| \"SlotActionRefused\"\n	-- The spins remotes. Live in this list for the same reason the rest of the lobby's do --\n	-- one place that spells out remote names -- and the game place pays the same small cost\n	-- as it already does for the slot remotes: a handful of RemoteEvents it never fires.\n	--\n	-- What this player owns and can still buy, pushed whole whenever either changes. Whole\n	-- rather than split, on the same reasoning as `LobbySlotsUpdated`: spins and perks are\n	-- read off the same page at the same moment, and a spin landing while a perk count is\n	-- mid-flight is exactly the kind of out-of-order redraw a single push avoids.\n	| \"SpinsUpdated\"\n	-- \"Open the purchase prompt for this product.\" Carries a product id from\n	-- `Config.Spins.Products`; the server still bounds-checks it and still refuses a\n	-- `productId` of 0, the same as if it had been typed. The grant itself never happens on\n	-- this remote -- it happens in `ProcessReceipt`, which Roblox calls back on its own, so a\n	-- client cannot claim spins by firing this a second time.\n	| \"RequestBuySpins\"\n	-- \"Pull.\" No payload -- what it lands on is decided entirely server-side and pushed back\n	-- as part of the next `SpinsUpdated`, so there is nothing on this wire a client could\n	-- have forged the result of.\n	| \"RequestSpin\"\n	-- Why a spins purchase or a pull did not happen, in a sentence meant for the player.\n	--\n	-- Its own remote rather than a reuse of `SlotActionRefused`, on the precedent that already\n	-- split `PlayRefused` from it: spins are read on a different page, at a different moment,\n	-- from a different set of buttons, and a single shared channel would leave the client\n	-- guessing which screen a refusal was even about.\n	| \"SpinActionRefused\"\n	-- The workout in progress, pushed as a whole snapshot. Its own remote rather than\n	-- a field on StatsUpdated, because a workout changes four times a second during\n	-- the sweep and the stat bars it moves change once or twice a minute.\n	| \"WorkoutUpdated\"\n	-- \"Start a workout on this machine.\" Carries a machine kind string from the\n	-- attribute on the part the player is standing next to; the server bounds-\n	-- checks it against Config.Gym.Kinds and still refuses a kind it does not\n	-- know. The session itself runs entirely server-side after this point.\n	| \"RequestStartWorkout\"\n	-- \"I pushed.\" The player clicked the button at the right moment (or the wrong\n	-- one). No payload beyond the fact of the click; the server decides quality\n	-- from the sweep position it is already tracking, so a client that fires this\n	-- twice gains nothing.\n	| \"RequestRep\"\n	-- The Science lab in progress, pushed as a whole snapshot. Its own remote rather\n	-- than a field on LessonUpdated, because the two are different activities that\n	-- happen to share a building: a lesson is one question and a clock, and a lab is two\n	-- benches, a reagent pool and a mastery level. Folding them together would mean\n	-- every quiz question carried an empty bench list.\n	| \"LabUpdated\"\n	-- \"I clicked that station.\" Carries the station id off the prompt's own attribute.\n	-- Never trusted: the server checks it against the stations it actually built and\n	-- against the bench it would land on, and refuses a click from a player with no\n	-- procedure running rather than starting one.\n	| \"RequestLabStep\"\n	-- \"Take the last step back off that bench.\" Carries the bench index. The undo half\n	-- of the commit-and-undo pair, and free -- there is no cost, no cooldown and no\n	-- limit before commit, because a draft you are charged to edit is not a draft.\n	| \"RequestLabUndo\"\n	-- \"Score that bench, I am done with it.\" Carries the bench index. The commit half,\n	-- and the only irreversible thing in the verb: everything before it can be taken\n	-- back and nothing after it can.\n	| \"RequestLabCommit\"\n	-- The report card waiting at the school, or nil when there is none.\n	--\n	-- Its own remote rather than a fifth thing on LessonUpdated, and the restraint is\n	-- deliberate: that channel already carries a question, a verdict, a notice and a skip\n	-- offer, told apart by which of its numbers are zero. A card is a different shape --\n	-- rows that are not answers, prose that is not a question, and no clock at all -- and\n	-- a fifth tenant told apart by yet another zero is how a channel stops being readable.\n	| \"ReportCardUpdated\"\n	| \"TimetableUpdated\"\n	| \"RequestUseFixture\"\n	-- \"I have read it.\" Carries the age the card was about, which the server checks\n	-- against the card it actually staged -- so a press that lands after a birthday has\n	-- replaced the card cannot put away a year the player has not seen.\n	| \"RequestReportCardRead\"\n	-- The geography errand in progress, pushed as a whole snapshot: which stop you are on,\n	-- what you have earned the right to be told about it, and the clock.\n	--\n	-- It has no request remote to pair with, and that is the verb rather than an oversight.\n	-- Every other activity in the game answers by pressing something; this one is answered\n	-- by *being somewhere*, so the only input is the character controller the player\n	-- already has and the only judge is the server's own distance check. Adding a \"check\n	-- here\" button would turn walking into a formality performed next to the answer.\n	| \"HuntUpdated\"\n	-- The art canvas in progress, pushed as a whole snapshot: what the player has painted,\n	-- what paint they were handed, and how many cells have gone stale.\n	--\n	-- What it does *not* carry is the study being copied, and that omission is the subject.\n	-- The picture is on the wall of the room; putting it on this channel would put it on\n	-- screen an inch from the copy, and a comparison you can make without turning your head\n	-- is not the comparison this lesson is about.\n	| \"ArtUpdated\"\n	-- Heat, pushed as a whole snapshot: what tier you are at, how many officers are out,\n	-- whether anybody can see you this second, and where the police believe you are.\n	--\n	-- Carries no officer positions. The bodies are already in the world and finding them\n	-- is the game -- a channel that shipped their coordinates would let a client draw the\n	-- one thing this system is asking the player to work out.\n	| \"BountyUpdated\"\n	-- The till in front of you, pushed as a whole snapshot: what is left in the drawer,\n	-- what you are holding, and -- the whole of it -- which way the clerk and the camera\n	-- are currently pointed.\n	--\n	-- The two attentions are sent as *state*, not as a warning. There is no \"you are\n	-- about to be seen\" field and there must never be one: the clerk turns and the camera\n	-- sweeps in the world where the player can watch them, and a channel that told the\n	-- client when to let go would be playing the activity on their behalf.\n	| \"TheftUpdated\"\n	-- \"Put the tube I am holding on that cell.\" Carries the cell index and the pigment id.\n	-- Never trusted: the server checks the cell is on the canvas, the pigment is one this\n	-- rung was actually handed, the pot is not empty and the player is at the easel -- a\n	-- painting made from the cupboard would make the paint run free.\n	| \"RequestArtPaint\"\n	-- \"I am done, that is the painting.\" The commit, and the only irreversible act in the\n	-- verb. Unlike the lab's it is a real decision rather than a formality, because the\n	-- study keeps moving: holding on covers more of the canvas and lets what you have\n	-- already done go stale.\n	| \"RequestArtSign\"\n	-- The stare-down in the corridor, pushed as a whole snapshot: both bars, the band the\n	-- player is aiming to release inside, and how long the bell will wait.\n	--\n	-- The window is sent rather than derived on the client, and that is the load-bearing\n	-- choice on this channel. It is what a life's nerve *buys* -- the band physically\n	-- widens as you get harder to push around -- so a client that computed it could\n	-- disagree with the server that scored against it, and the player would watch\n	-- themselves release inside a green band and be told they backed down.\n	--\n	-- What it does not carry is who else is in the corridor. A bully working somebody else\n	-- is a thing you see by looking down the hall, and a channel that listed them would\n	-- turn a room you read into a list you read.\n	| \"NerveUpdated\"\n	-- Hold and release, as one boolean. The whole input of the corridor.\n	--\n	-- The release *value* is what decides the encounter and the server owns the bar, so\n	-- this carries intent and never a score: a client that sent \"I released at 0.71\" would\n	-- be a client that could send 0.71 whenever it liked.\n	| \"RequestNerveHold\"\n	-- The reading lesson: both words, the tray, what is in hand, and how many takebacks are\n	-- left. Pushed whole rather than as deltas, for the reason every other school channel is\n	-- -- the panel is redrawn on receipt and a tray that arrived in pieces could be drawn\n	-- half-spent.\n	--\n	-- It carries the *answer* in the sense that the gaps and the tray together imply it, and\n	-- that is unavoidable and fine: the subject is recognising which letters a word is\n	-- missing, not being unable to see the letters. What it does not carry is which tile\n	-- belongs in which gap.\n	| \"ReadingUpdated\"\n	-- Take a tile, or put the one in hand into a gap, or pull a placed one back out. One\n	-- remote for all three because they are one verb with a target: nil target means put\n	-- down what you are holding.\n	| \"RequestReadingPlace\"\n	-- Hand in a word as it stands. The commit, and the only irreversible thing in the\n	-- lesson.\n	| \"RequestReadingSubmit\"\n	-- The music lesson: the chart, the downbeat, the windows this life has earned and the\n	-- tallies so far. Pushed whole on every change, like every other school channel.\n	--\n	-- The chart goes out **once, complete, at the start**. That is deliberate and it is the\n	-- difference between a rhythm lesson and a reaction test: a player who can see the next\n	-- four bars is reading music, and a player who is sent one note at a time is being\n	-- startled. It also means the client holds the answers, which is why the server scores\n	-- the offsets it is sent rather than the hits -- see RequestMusicHit.\n	| \"MusicUpdated\"\n	-- PE. One state remote out and one click in, the same shape as music: see RequestPEClick\n	-- for why the click carries a value rather than a timestamp.\n	| \"PEUpdated\"\n	-- One note hit: which note, and how far off the client was in milliseconds.\n	--\n	-- The offset is the client\\'s measurement and cannot be anything else -- the round trip is\n	-- longer than the window being measured, so a server-timed rhythm game is unplayable. The\n	-- server therefore treats it as a claim rather than a fact: it checks the note exists, has\n	-- not been hit, that the offset is inside the widest window it granted, and that the note\n	-- was actually due around now. That does not make cheating impossible; it makes it cost\n	-- more than playing.\n	| \"RequestMusicHit\"\n	-- One click of the three-click meter, carrying the marker position the player clicked at\n	-- as a share of the bar. The *value* rather than the moment, for the reason the music hit\n	-- carries an offset: the marker is drawn on the client and a server that recomputed the\n	-- position from arrival time would score a different bar than the one the player saw, and\n	-- would punish ping rather than timing. The server validates the value is in range and\n	-- that the sweep is actually running before it spends it.\n	| \"RequestPEClick\"\n	-- \"My hands are in the drawer\" / \"they are not any more.\" One remote with a boolean\n	-- rather than two, because the two are the same fact and a start that arrived without\n	-- its stop -- or in the wrong order after a hiccup -- would leave a player taking\n	-- money from across the street. The server re-checks reach on every tick regardless.\n	| \"RequestTillHold\"\n	-- \"I clicked the drawer.\" Opens the panel and puts the player at that till, and does\n	-- nothing else -- no money moves on this remote. Kept separate from the hold so that\n	-- the click and the verb are separate acts, which is the whole reason a till is not a\n	-- Station: clicking a station *is* the answer, and clicking a till is walking up to it.\n	| \"RequestTillOpen\"\n	-- \"Send this one to watch the door.\" A crew id, checked against the caller's own\n	-- roster server-side, same as RequestBankCallCrew -- the till has no seat to claim, so\n	-- what this actually toggles is TheftService's own lookout state for that shop.\n	| \"RequestTillCallCrew\"\n	-- The bank room you are standing in, pushed as a whole snapshot: what is left in the\n	-- vault, what the alarm is doing, where the guard is, and which of the room's two\n	-- controls is within arm's reach right now.\n	--\n	-- The alarm's countdown *is* sent, which is the one place this system tells the client\n	-- something the till's deliberately does not. That is not an inconsistency, it is the\n	-- difference between the two rooms: a till asks you to read two attentions moving in\n	-- the world, and a bank hands you a clock up front and asks how much of it you are\n	-- willing to spend. Hiding a number the alarm is already screaming would be coy rather\n	-- than skilful.\n	| \"BankUpdated\"\n	-- \"I clicked the vault door.\" Puts the player in the room's activity and opens the\n	-- panel. Takes nothing and trips nothing -- the alarm goes on the first *hold*, so\n	-- walking up to a vault and reading the guard's patrol is free, which is the whole\n	-- read-before-you-commit window this activity has.\n	| \"RequestBankOpen\"\n	-- \"My hands are on it\" / \"they are not any more.\" One boolean for both of the room's\n	-- controls, because which one it means is decided by where the player is standing and\n	-- the server is the only end that gets to say. A client that could name the control\n	-- could silence an alarm from the vault, which is the one shortcut that would delete\n	-- the activity outright.\n	| \"RequestBankHold\"\n	-- \"Send this one to the alarm.\" A crew id, checked against the caller's own roster\n	-- server-side same as every other choice in this tree -- see GangService.CrewFor. Part\n	-- 3's first slice: the seat this claims is BankService's, not a gang panel's, because\n	-- it only means anything while standing in the room it is for.\n	| \"RequestBankCallCrew\"\n	-- Who you run with and how far up you are. Pushed on change rather than on a clock,\n	-- because standing moves in bursts -- a vault pays forty-five points in one instant and\n	-- then nothing for a minute -- and a fixed-rate push would spend most of its traffic\n	-- resending a number that had not moved.\n	| \"GangUpdated\"\n	-- What the boss in front of you is saying, and what you can say back. Separate from\n	-- GangUpdated because they have different lifetimes: your rank is true everywhere and\n	-- all the time, whereas this is true only while you are standing in front of one\n	-- specific person, and nil the moment you walk away.\n	| \"GangPanelUpdated\"\n	-- The map itself: its bounds, everything drawn on it, and the four sides. Sent once\n	-- on join and never again, because none of it changes while the server is up -- the\n	-- world is built before the first player arrives and no place point moves afterwards.\n	| \"MapData\"\n	-- Which side you are standing on and how deep into it. This one *is* on a clock: it\n	-- is a question about where a body is, and a body moves continuously. Split from\n	-- MapData for exactly that reason -- one is a fact about the world and one is a fact\n	-- about you, and sending them together would resend the whole map twice a second.\n	| \"TerritoryUpdated\"\n	| \"SkillsUpdated\"\n	-- Preferences, pushed whole on join and again after every change -- including after a\n	-- change the client itself asked for. The client never draws what it clicked, only what\n	-- came back, which is what stops a switch that failed to save from looking like it saved.\n	| \"SettingsUpdated\"\n	-- \"Flip that one.\" Carries the setting id and the value wanted. Both are checked: an id\n	-- that is not in `Config.Settings.Options` is refused rather than written, because the\n	-- settings table is a dictionary in a save file and a client that could name its own key\n	-- could grow that save without limit.\n	| \"RequestSetSetting\"\n	-- Which codes this account has already used, and what each one paid. Pushed on join and\n	-- after every successful redeem.\n	| \"CodesUpdated\"\n	-- \"I typed this.\" The one free-text remote in the game place, which is why it is rate\n	-- limited, length capped and matched only against a fixed list. Nothing about the reward\n	-- travels on this wire in either direction -- what a code pays is decided entirely from\n	-- the content table, so a client that sent a longer string or a faster one gains nothing\n	-- but a refusal.\n	| \"RequestRedeemCode\"\n	-- What happened to one attempt, in a sentence for the player. Sent for successes too:\n	-- a box that only answers when you are wrong is a box you cannot tell you have used.\n	| \"CodeResult\"\n	-- \"I clicked the boss.\" Opens the panel and nothing else -- joining is a row on it, not\n	-- this. Walking up to all four bosses to read what they want is free, deliberately, for\n	-- the same reason clicking a vault door trips nothing: a decision this permanent should\n	-- not be made by the first person the player happened to bump into.\n	| \"RequestGangOpen\"\n	-- \"I picked that row.\" Carries the row id only. What a row *costs* and whether it is\n	-- allowed is decided here from the player's own standing, never from what was sent --\n	-- a client that could name its own rung would be a client that promotes itself.\n	| \"RequestGangChoice\"\n	-- \"Band on\" / \"band off.\" The one piece of gang state a player changes without a\n	-- person present, because taking your colors off is something you do in an alley at the\n	-- moment you decide to, and routing it through a boss would mean the only way to go\n	-- unmarked was to walk back across the city to the person who marked you.\n	| \"RequestGangColors\"\n	-- House ownership updates. Pushed whenever a life buys or sells a suburb\n	-- home, or changes the job linked to it. The client reads the whole table\n	-- to redraw the property panel, so it always arrives complete.\n	| \"HouseUpdated\"\n	-- \"I want to buy this suburb house.\" Carries the house id string; the\n	-- server checks ownership limit, money, and id validity before granting.\n	| \"RequestBuyHouse\"\n	-- \"I want to sell this suburb house.\" Carries the house id string. The\n	-- server clears any linked home job first, then refunds the resale value.\n	| \"RequestSellHouse\"\n	-- \"I want to link this job to my house.\" Carries the house id and the job id.\n	-- The server checks ownership and that the job's placeId matches the house.\n	| \"RequestSetHomeJob\"\n	-- \"I want to toggle this apartment door.\" Carries the door part; the\n	-- server checks distance and animates the door.\n	| \"RequestToggleApartmentDoor\"\n	-- The dealership queue in progress, pushed as a whole snapshot: how many\n	-- are waiting, who is at the front, and where the counter is. Its own remote\n	-- rather than a field on ShiftUpdated because the queue is independent of\n	-- any shift -- it exists whether the player is working at the dealership or not.\n	| \"CarDealerUpdated\"\n	-- \"I served the customer at the counter.\" No payload -- the server checks\n	-- that there is a queue and a front customer before granting the tip.\n	| \"RequestCarDealerServe\"\n	-- The showroom and the garage in one push: every car sold, what this life\n	-- already owns, and which one -- if any -- is standing in the world. Its own\n	-- remote rather than a field on CarDealerUpdated, on the same reasoning that\n	-- keeps HouseUpdated separate from everything else at a counter: the queue is\n	-- the room being alive whether or not anybody is buying a car, and a garage is\n	-- a fact about one life's money, not about the shop floor.\n	| \"VehicleUpdated\"\n	-- \"I want to buy this car.\" Carries a vehicle id from `content/Vehicles.luau`;\n	-- the server checks the id is real, the price against the balance, and the\n	-- garage is not already at Config.Vehicles.MaxOwned before granting anything.\n	| \"RequestBuyVehicle\"\n	-- \"I want to sell this car.\" Carries a vehicle id. Refuses on the currently\n	-- active one -- selling the car you are about to be told to get into would\n	-- have to also answer what \"active\" now points at, and the honest UI move is\n	-- to put it away first.\n	| \"RequestSellVehicle\"\n	-- \"Bring this one out of the garage.\" Carries a vehicle id already owned; puts\n	-- away whatever was active first, exactly one car standing in the world per\n	-- life at a time. Server-built at a spot near the dealership rather than\n	-- wherever the request was fired from, so a forged id cannot summon a car\n	-- through a wall.\n	| \"RequestSpawnVehicle\"\n	-- \"Put it away.\" No payload -- despawns whichever car is active, if any. The\n	-- same action idle-timeout and a death both drive from the server side; this\n	-- is the player choosing to do it early.\n	| \"RequestStoreVehicle\"\n	-- The fight in progress, pushed whole every tick it changes. Whole rather than\n	-- split into \"my bars\" and \"their bars\" because a fight is read as one picture --\n	-- a charge held against a wind-up filling opposite it -- and two remotes landing a\n	-- frame apart would let the player see a strike land before the tell that sold it.\n	| \"FightUpdated\"\n	-- \"I am holding the strike button / I let go / I am guarding / I stepped.\" Carries\n	-- an action name and a boolean for the held ones. What it deliberately does not\n	-- carry is a charge value: the server owns the clock the meter is drawn from, so\n	-- the strongest thing a forged packet can claim is that a button went down.\n	| \"RequestFightAction\"\n	-- \"Square up.\" Carries the id of the challenger whose dots were clicked, which the\n	-- server checks against the one it actually stood in front of this player.\n	| \"RequestFightSquare\"\n	-- Monthly bill update. Pushed whenever a bill is charged or debt changes.\n	| \"BillDue\"\n	-- Savings account state, pushed on every balance change and on join.\n	| \"SavingsUpdated\"\n	-- \"Put this amount into my savings account.\" Carries a positive number.\n	| \"RequestDeposit\"\n	-- \"Take this amount out of my savings account.\" Carries a positive number.\n	| \"RequestWithdraw\"\n	-- A milestone was achieved this life. Carries milestone id, label, and bonus.\n	| \"MilestoneAchieved\"\n	-- A bond milestone was crossed with a specific person. Carries person name and milestone.\n	| \"BondMilestone\"\n	-- An NPC shared gossip about the player. Carries speaker, topic, and effect.\n	| \"GossipUpdate\"\n	-- A join code was entered. Carries the code string; the server looks it up\n	-- and, if valid, selects the target slot and calls Play.\n	| \"RequestJoinByCode\"\n	-- Why a join code was not accepted, in a sentence meant for the player.\n	| \"JoinRefused\"\n	-- The chapter seam: a band boundary has been reached. Carries the age the\n	-- next chapter starts at and the moments the shared \"what happened\" query\n	-- found for the window since the last break. An empty list is the suppressed\n	-- reel — the client opens the next chapter cold with no screen.\n	| \"ChapterBreak\"\n	-- \"Give up the job I hold.\" No payload -- there is only ever one job to quit,\n	-- and the server reads it off the profile rather than trust an id, so the worst\n	-- a forged send does is quit a job the caller does not hold, which is a no-op.\n	| \"RequestQuitJob\"\n	-- \"Point me at this job.\" Carries a job id off a post the player was already\n	-- shown, which the server checks against Jobs.ById and PlaceService the same\n	-- as every other id on the wire -- an unknown id is refused rather than\n	-- pointing a line at nothing. Overrides the automatic best-job arrow until the\n	-- player takes it, picks another, or it stops existing.\n	| \"RequestGuideToJob\"\n	-- \"I pressed the pickup key at the mark I'm standing on.\" Carries the task id\n	-- the mark belongs to and nothing else -- the client only ever claims it pressed\n	-- the key, never that it was in range or that the pickup should count, and the\n	-- server re-checks both against the shift it already has before anything\n	-- happens. A press for a task that has finished, expired, or was never issued to\n	-- this player is a no-op.\n	| \"RequestTaskPickup\"\n	-- \"You just walked through the stadium's own gate.\" Carries no payload --\n	-- StadiumEntranceService already decided this player earns the moment\n	-- (once per session) before firing it, so there is nothing on the wire for\n	-- a client to forge; the only thing this remote can do is play a camera\n	-- cutscene early or not at all. The fan NPC that walks over is a real\n	-- server-spawned visitor, not part of this payload, the same separation\n	-- NPCService.Arrive already keeps between \"play a moment\" and \"who is in it\".\n	| \"StadiumEntranceCue\"\n\nlocal REMOTE_NAMES: { RemoteName } = {\n	\"StatsUpdated\",\n	-- Its own remote rather than a fifth field on StatsUpdated. Money is not a stat\n	-- -- it is unbounded, it does not decay, and it moves on different occasions --\n	-- and folding it in would mean every stat push carried a balance and every\n	-- balance change redrew four bars.\n	\"MoneyUpdated\",\n	\"AgeUpdated\",\n	\"AgeUpProgress\",\n	\"LifeStageChanged\",\n	-- A life ending, carrying the age it ended at and the ribbon it earned. There is no\n	-- `PlayerRespawned` to pair with it any more, and its absence is the whole of part 3\n	-- in one line: a life does not restart in place. It stays dead in the slot it was lived\n	-- in, and the player goes back to the lobby to pick another card. The death screen is\n	-- therefore the last thing this place ever says to that life -- nothing takes it down,\n	-- the place going away does.\n	\"PlayerDied\",\n	\"RequestAgeUp\",\n	-- \"Take me back to the menu.\" Pressed off the death screen, and available from the HUD\n	-- for a player who simply wants to change life mid-run.\n	--\n	-- A request rather than the client teleporting itself, because a teleport out is also a\n	-- profile handoff: the session in this place has to end cleanly for the lobby to be able\n	-- to open the same key, and only the server knows when it has.\n	\"RequestReturnToLobby\",\n	-- Why the trip back did not happen. Almost always one of exactly two things -- running\n	-- in Studio, where teleports do not work at all, or an unpublished lobby place id -- and\n	-- both are sentences a developer needs to read rather than errors a player caused.\n	--\n	-- Load-bearing for the same reason PlayRefused is: the death screen's only button\n	-- silently doing nothing is indistinguishable from the game having hung.\n	\"ReturnRefused\",\n	\"EventOffered\",\n	\"EventResolved\",\n	\"RequestEventChoice\",\n	-- The shift in progress, pushed as a whole snapshot. Its own remote rather than\n	-- a field on MoneyUpdated for the same reason money is not a fifth stat: a wage\n	-- arriving is a balance change, but being three hours into a shift is not, and\n	-- folding them together would redraw the shift row every time a letter paid out.\n	\"ShiftUpdated\",\n	-- A single sentence for the player, spoken by the server and shown as the same\n	-- transient banner the client already raises on an auto age-up. A general channel\n	-- rather than a firing-specific remote, because the thing being said -- \"you've\n	-- been let go\" -- is one the server composes and the client only displays: the\n	-- client cannot know it was coming, so it cannot draw it off any state it holds.\n	-- Carries only the finished string; nothing on this wire is acted on, only read.\n	\"Notice\",\n	-- Where the player is being pointed, if anywhere. Sent rather than drawn on the\n	-- server because guidance is addressed to exactly one person: most of what this\n	-- game puts in the workspace -- a choice pad, a dog, a delivery van -- is meant\n	-- to be seen by whoever walks past, and a line to your first job is not.\n	\"GuideUpdated\",\n	-- The \"NOW HIRING\" posts this player should be looking at, as a whole list.\n	--\n	-- The same argument as GuideUpdated, arrived at the hard way. These were once\n	-- built by the server and shared by everyone in the room, which was fine right up\n	-- until somebody took the job: the sign and the mark stayed standing over the head\n	-- of the one person they were no longer for. An offer has to stop being made once\n	-- it is accepted, and only a per-player post can do that.\n	\"JobPostsUpdated\",\n	-- What the player is doing this minute, inside the shift they are already on.\n	--\n	-- Its own remote rather than a field on ShiftUpdated, on the rule that keeps money\n	-- and shifts apart: a shift is eight game hours and a wage, and it changes when an\n	-- hour completes. A task is a sentence and a countdown, and it changes four times\n	-- a second. Folding them together would redraw the whole shift row every tick for\n	-- the sake of one number.\n	\"TaskUpdated\",\n	-- The question in front of the player, inside the lesson they are already in.\n	--\n	-- Exactly the same argument as TaskUpdated, which is the point: school and work are\n	-- the two things this game asks you to actually do, and they push at the same rate\n	-- for the same reason. The answers themselves are not in here -- those are pads on\n	-- the floor, built by the server, because an answer you give by walking has to be\n	-- somewhere you can walk.\n	\"LessonUpdated\",\n	-- Who the player is standing next to, and what they just said back.\n	--\n	-- The third of the three rows that are pushed rather than drawn, alongside a task and\n	-- a lesson, and it is here for the same reason as both: the pads in front of a person\n	-- are built by the server, because an offer you take by walking has to be somewhere you\n	-- can walk, but what is written on them was decided by reading one profile.\n	--\n	-- Further than a lesson, in fact. The person themselves is spawned per player rather\n	-- than shared: who is around depends on the player's age and what they say depends on\n	-- the player's bond, so two players standing in the same kitchen are looking at two\n	-- rigs offering two different things. Family is not scenery.\n	\"PersonUpdated\",\n	-- What the player picked off the panel in front of somebody, and off the panel in a\n	-- lesson. Their own remotes rather than a shared one carrying a kind and an id,\n	-- because a person and a lesson are checked against completely different things --\n	-- who you are standing next to and their bond, versus which question you are on --\n	-- and one handler doing both would be one handler that could confuse them.\n	\"RequestPersonOffer\",\n	\"RequestLessonAnswer\",\n	-- The people the player has met, as a whole list for the HUD's people section.\n	--\n	-- Distinct from PersonUpdated in the way a whole list is always distinct from a\n	-- single row: PersonUpdated names who is standing next to you and what they will\n	-- say; this names everyone whose name you know, whether or not they are near. The\n	-- HUD's avatars are built from it, and the list is why tapping an avatar is a\n	-- conversation rather than a guess — the server sent the person's name and face,\n	-- and the tap only carries their id.\n	\"PeopleRosterUpdated\",\n	-- \"I tapped this avatar, open the conversation.\" Carries a person id, checked\n	-- against the roster the server sent, and the conversation itself is answered by\n	-- the same PersonUpdated push a proximity approach already raises.\n	\"RequestPersonContact\",\n	-- The lobby remotes. They live in this list rather than a `LobbyRemotes` module of\n	-- their own for the reason at the top of the file -- one place that spells out remote\n	-- names -- and the cost is that each place creates a handful of RemoteEvents it never\n	-- fires. A few unused instances is a smaller price than two files that can disagree\n	-- about a string.\n	--\n	-- Every slot the player owns, as a whole list, whenever any of it changes. A whole\n	-- list rather than a per-slot push because the menu is three cards read side by side:\n	-- there is no moment where one card is meaningfully newer than the others, and a\n	-- per-slot remote would let a delete and a rebuild land out of order and leave a card\n	-- showing a life that no longer exists.\n	\"LobbySlotsUpdated\",\n	-- \"Choose who you are about to be\", carrying everything the create page needs to draw\n	-- itself. Sent rather than the client reading Config, because these are the exact\n	-- numbers the server is about to validate the answer against -- so a page physically\n	-- cannot offer a spend that will then be refused.\n	--\n	-- Its own remote rather than a field on LobbySlotsUpdated, even though both are pushed\n	-- on load. Slots change every time a card is touched; the options change only when a\n	-- life *ends*, which happens in the other place entirely. Folding them together would\n	-- resend the full country list on every delete.\n	--\n	-- The client holds the Create button disabled until this arrives, rather than opening a\n	-- page with empty steppers on it. There is no honest thing to draw before it lands.\n	\"LobbySetupOptions\",\n	-- \"Start this slot.\" Carries the slot number, which the server bounds-checks against\n	-- Config.Slots.Count exactly as if it had been typed -- the client picked it off a\n	-- list the server sent, but the client is still the client.\n	\"RequestPlay\",\n	-- Why Play did not happen, in a sentence meant for the player. The accepted path\n	-- already announces itself by teleporting you, so the only outcome needing words is\n	-- the one that did not.\n	--\n	-- Kept apart from SlotActionRefused below, which is the one distinction between these\n	-- two refusal channels that is worth a remote: everything on the cards is instant and\n	-- local, and Play is a slow call to another server that can fail *after* the screen has\n	-- already gone busy. They are read in different places on screen and at different\n	-- moments, so a single remote would have the client guessing which one it just got.\n	--\n	-- Load-bearing, because the most likely refusal here is not the player's fault at all\n	-- -- an unpublished place id, a teleport rate limit, a profile that has not loaded yet.\n	-- A Play button that silently does nothing is indistinguishable from a frozen game.\n	\"PlayRefused\",\n	-- \"Make this card the one Play uses.\" Carries a slot number and nothing else.\n	--\n	-- A remote at all, rather than the client remembering which card is highlighted and\n	-- telling the server only at Play time, because the choice is *persisted* -- it is\n	-- written to `activeSlot` on the profile, which is how the game place learns which life\n	-- to run. See ProfileData.activeSlot: that field is deliberately not something a\n	-- teleport payload can assert.\n	\"RequestSelectSlot\",\n	-- \"Delete the life in this slot.\" The only irreversible thing in this game that is not\n	-- dying, so the card asks twice before it fires -- but the second press is a fact about\n	-- the *screen*, not about the wire, and the server does not attempt to verify that it\n	-- happened. It cannot: any check it could make is a value the client would be sending\n	-- itself. What the server does enforce is that the slot is real, that something is in\n	-- it, and that it is not the slot currently mid-teleport.\n	\"RequestDeleteSlot\",\n	-- The answer to the create page: a slot number and the life to put in it.\n	--\n	-- The only remote in the game that carries free text -- a name the player typed, which\n	-- goes through TextService before it is stored and is refused outright if the filter\n	-- cannot be reached.\n	\"RequestCreateLife\",\n	-- Why a card action was not accepted, in a sentence meant to be read by the player\n	-- rather than by a log. Shared by select, delete and create because all three are\n	-- answered in the same instant and read on the same line under the cards.\n	--\n	-- A sentence rather than a code, and a refusal rather than an acceptance flag: the\n	-- accepted path already has a message -- the cards redrawing -- and a boolean that is\n	-- false only on failure is a sentence with nowhere to put the reason.\n	\"SlotActionRefused\",\n	\"SpinsUpdated\",\n	\"RequestBuySpins\",\n	\"RequestSpin\",\n	\"SpinActionRefused\",\n	\"WorkoutUpdated\",\n	\"RequestStartWorkout\",\n	\"RequestRep\",\n	\"LabUpdated\",\n	\"RequestLabStep\",\n	\"RequestLabUndo\",\n	\"RequestLabCommit\",\n	\"ReportCardUpdated\",\n	\"TimetableUpdated\",\n	\"RequestUseFixture\",\n	\"RequestReportCardRead\",\n	\"HuntUpdated\",\n	\"ArtUpdated\",\n	\"BountyUpdated\",\n	\"TheftUpdated\",\n	\"RequestArtPaint\",\n	\"RequestArtSign\",\n	\"NerveUpdated\",\n	\"RequestNerveHold\",\n	\"ReadingUpdated\",\n	\"RequestReadingPlace\",\n	\"RequestReadingSubmit\",\n	\"MusicUpdated\",\n	\"PEUpdated\",\n	\"RequestMusicHit\",\n	\"RequestPEClick\",\n	\"RequestTillHold\",\n	\"RequestTillOpen\",\n	\"RequestTillCallCrew\",\n	\"BankUpdated\",\n	\"RequestBankOpen\",\n	\"RequestBankHold\",\n	\"RequestBankCallCrew\",\n	\"GangUpdated\",\n	\"GangPanelUpdated\",\n	\"MapData\",\n	\"TerritoryUpdated\",\n	\"SkillsUpdated\",\n	\"SettingsUpdated\",\n	\"RequestSetSetting\",\n	\"CodesUpdated\",\n	\"RequestRedeemCode\",\n	\"CodeResult\",\n	\"RequestGangOpen\",\n	\"RequestGangChoice\",\n	\"RequestGangColors\",\n	\"HouseUpdated\",\n	\"RequestBuyHouse\",\n	\"RequestSellHouse\",\n	\"RequestSetHomeJob\",\n	\"RequestToggleApartmentDoor\",\n	\"CarDealerUpdated\",\n	\"RequestCarDealerServe\",\n	\"VehicleUpdated\",\n	\"RequestBuyVehicle\",\n	\"RequestSellVehicle\",\n	\"RequestSpawnVehicle\",\n	\"RequestStoreVehicle\",\n	\"FightUpdated\",\n	\"RequestFightAction\",\n	\"RequestFightSquare\",\n	\"BillDue\",\n	\"SavingsUpdated\",\n	\"RequestDeposit\",\n	\"RequestWithdraw\",\n	\"MilestoneAchieved\",\n	\"BondMilestone\",\n	\"GossipUpdate\",\n	\"RequestJoinByCode\",\n	\"JoinRefused\",\n	\"ChapterBreak\",\n	\"RequestQuitJob\",\n	\"RequestGuideToJob\",\n	\"RequestTaskPickup\",\n	\"StadiumEntranceCue\",\n}\n\nlocal FOLDER_NAME = \"RemoteEvents\"\n\nlocal Remotes = {}\n\nlocal function getFolder(): Folder\n	local existing = ReplicatedStorage:FindFirstChild(FOLDER_NAME)\n	if existing then\n		return existing :: Folder\n	end\n\n	if RunService:IsServer() then\n		local folder = Instance.new(\"Folder\")\n		folder.Name = FOLDER_NAME\n		for _, name in REMOTE_NAMES do\n			local remote = Instance.new(\"RemoteEvent\")\n			remote.Name = name\n			remote.Parent = folder\n		end\n		folder.Parent = ReplicatedStorage\n		return folder\n	end\n\n	return ReplicatedStorage:WaitForChild(FOLDER_NAME) :: Folder\nend\n\nfunction Remotes.Get(name: RemoteName): RemoteEvent\n	local folder = getFolder()\n	return folder:WaitForChild(name) :: RemoteEvent\nend\n\nreturn Remotes\n"
table.insert(AGES_MANIFEST, "src/shared/Remotes.luau")
AGES_SOURCES["src/shared/Sweep.luau"] = "--!strict\n-- How a timing needle crosses its bar.\n--\n-- Shared because both ends need the same answer and neither may be the authority\n-- alone: the server grades the hit and must decide where the needle really was, and\n-- the client draws the needle every frame between the server's ticks. Two copies of\n-- these curves would be two curves the moment one was edited, and the symptom would\n-- be a bar that visibly disagrees with the grade it produces -- the single worst bug\n-- a timing minigame can have, because it teaches the player the game is lying.\n--\n-- Each shape maps elapsed share of the sweep (0-1) to needle position (0-1). Every\n-- shape is pinned at both ends: f(0) = 0 and f(1) = 1. A sweep therefore always\n-- starts at the left edge and always expires at the right, whatever it does between\n-- them, so \"the sweep ran out\" means one thing everywhere.\n--\n-- The gym uses these to make four machines out of one button. Anything else that\n-- wants a timing verb -- a sports charge meter, a school rhythm lesson -- should\n-- take its curve from here rather than growing a private one.\n\nlocal Sweep = {}\n\nexport type Curve = \"steady\" | \"quickening\" | \"easing\"\n\n-- Constant speed. What you see is what it is doing, and the only machine a new\n-- player can read on sight.\nlocal function steady(t: number): number\n	return t\nend\n\n-- Creeps, then rushes. By the time the needle looks close, the zone is already\n-- behind it -- so the bar has to be played by anticipation rather than reaction.\nlocal function quickening(t: number): number\n	return t * t\nend\n\n-- Rushes, then crawls. Easy to reach and hard to leave: the needle spends most of\n-- the sweep near the far end, which makes holding out for a better moment feel free\n-- right up to the instant the sweep expires.\nlocal function easing(t: number): number\n	return 1 - (1 - t) * (1 - t)\nend\n\n-- Named so content and saved data can refer to a curve by string rather than holding a\n-- function. Deliberately private: a caller that reaches in for a raw shape would be\n-- skipping the clamps in `At`, which is the one place the overshoot from a tick or a\n-- frame is absorbed.\nlocal shapes: { [string]: (number) -> number } = {\n	steady = steady,\n	quickening = quickening,\n	easing = easing,\n}\n\n-- Needle position for a named curve at an elapsed share.\n--\n-- Clamps both ways rather than trusting the caller: the share arrives from a tick\n-- accumulator on the server and from a RenderStepped accumulator on the client, and\n-- either can overshoot by a frame. An unknown curve name is a content error and says\n-- so, rather than quietly drawing a straight line that grades differently to the bar\n-- the player was looking at.\nfunction Sweep.At(curve: string, elapsedShare: number): number\n	local shape = shapes[curve]\n	if shape == nil then\n		error(`[AGES] unknown sweep curve \"{curve}\" -- add it to the shapes table in Sweep.luau, or fix the machine that names it`)\n	end\n	return math.clamp(shape(math.clamp(elapsedShare, 0, 1)), 0, 1)\nend\n\nreturn Sweep\n"
table.insert(AGES_MANIFEST, "src/shared/Sweep.luau")
AGES_SOURCES["src/shared/Types.luau"] = "--!strict\n-- Shared Luau type definitions. Pure types, no runtime content.\n\nlocal Types = {}\n\nexport type StatName = \"health\" | \"happiness\" | \"smarts\" | \"looks\"\n\nexport type Stats = {\n	health: number,\n	happiness: number,\n	smarts: number,\n	looks: number,\n}\n\nexport type LifeStageId = \"Childhood\" | \"Adolescence\" | \"Adulthood\" | \"Elder\" | \"Death\"\n\n-- Why a year ended. The client only announces \"Auto\" — the others are either\n-- the player's own doing or a silent state resync on join/respawn. \"Skip\" marks\n-- the years crossed by Skip Childhood, which pass without offering an event.\n-- \"Event\" is a childhood year ended by answering its event: silent, because the\n-- outcome the player is already reading is the announcement.\n-- \"Custody\" is a sentence being served. It runs the ordinary per-year path like every\n-- other cause here, which is the point of it having a name: the years in a cell decay\n-- stats and cross stage boundaries exactly as if they had been lived, because they were.\nexport type AgeUpCause = \"Manual\" | \"Auto\" | \"Sync\" | \"Skip\" | \"Event\" | \"Custody\"\n\n-- Server's verdict on the Age Up button, so the HUD never invents its own\n-- gating rule: Hidden (dead), Cooldown (too soon, self-directed years),\n-- Ready (self-directed years), SkipChildhood (offered instead of ChildReady\n-- before the manual age, once the player has already lived childhood at\n-- least once), ChildCooldown/ChildReady (the same Ready/Cooldown pair, but\n-- for a first-life toddler year on its own, shorter cooldown -- a distinct\n-- name rather than reusing Ready/Cooldown because the two run different\n-- Config constants and the HUD has to know which one to count down against).\nexport type ManualAgeUpState = \"Hidden\" | \"Cooldown\" | \"Ready\" | \"SkipChildhood\" | \"ChildCooldown\" | \"ChildReady\"\n\n-- A partial map: a choice names only the stats it moves.\nexport type StatDelta = { [StatName]: number }\n\n-- One thing a life can have done, declared in content/Flags.luau.\nexport type FlagDef = {\n	id: string,\n	-- What having it means, in the past tense, as a sentence about the player. Read\n	-- by nothing at runtime and required anyway: a flag id is four words with the\n	-- spaces taken out, and four words is not enough to stop two authors using the\n	-- same one for two different things a year apart.\n	meaning: string,\n}\n\n-- The flags a life is currently carrying, mapped to the age they were earned at.\n--\n-- The age is there because it costs one number and answers the question every piece of\n-- writing about a flag wants to ask -- \"ever since you were six\" is a better sentence\n-- than \"ever since\", and without this it is not a sentence the game can produce. Absent\n-- means not held; there is no false, because a flag that was never earned and a flag\n-- that was earned and undone are the same state and storing them apart would invite\n-- content that tried to tell them apart.\nexport type FlagSet = { [string]: number }\n\n-- One rung of the childhood body ladder: what a body of this age can *do*. Matched\n-- by the first band whose maxAge the player's age falls under, so\n-- Config.Childhood.Bands must stay sorted.\n--\n-- No size here. How big a body is at an age is Config.Growth, which is a continuous\n-- curve rather than a ladder and applies to everybody in the world rather than only\n-- to the player -- see the note on it.\nexport type ChildhoodBand = {\n	id: string,\n	maxAge: number,\n	walkSpeed: number,\n	jumpPower: number,\n	cameraOffsetY: number,\n}\n\n-- What a body of a given age moves like, keyed by the slot names Roblox's own\n-- Animate script uses -- \"idle\", \"walk\", \"run\", \"jump\", \"fall\", \"climb\". Partial\n-- on purpose: a band that overrides only walking keeps Roblox's default for\n-- everything else, which is the correct look for most of the ladder.\n--\n-- A crawl is not a slow walk. WalkSpeed alone gets a small person moving at a\n-- believable speed and still standing upright, which reads as a shrunk adult\n-- rather than a baby -- so the speed and the animation are one mechanic, not a\n-- mechanic and a decoration.\nexport type AnimationSet = { [string]: string }\n\n-- How an event reaches the player. The engine decides *which* event fires;\n-- delivery decides *how*, and the two are kept separate so a mode can be added\n-- here without touching content or selection logic.\n--\n-- Memory and Direct are handed over on a birthday and have no world presence at\n-- all. Memory is now a legacy of the age before there was a world to put things\n-- in, and childhood no longer uses it.\n--\n-- Wander is what childhood uses instead, and it is the mode for an event that has\n-- no fixed home and no schedule: the server finds a piece of floor the player can\n-- reach, puts the thing there, and points at it. Unlike Interact it needs nothing\n-- hand-placed, which is the whole reason it exists -- a toddler's house cannot\n-- require twenty-two tagged props to be playable, and an event that has to be\n-- crawled to is a different mechanic from one that is handed over whether or not\n-- the room is interesting.\n--\n-- Letter, PhoneCall and NPCApproach are the world coming to *you*: something is\n-- staged in the house and the prompt only opens once you go to it. Which route\n-- each mode takes -- and therefore which system is allowed to pick it -- lives\n-- in Delivery.luau, so no system has to hardcode the list.\nexport type EventDelivery =\n	\"Memory\"\n	| \"Direct\"\n	| \"Wander\"\n	| \"Interact\"\n	| \"Letter\"\n	| \"PhoneCall\"\n	| \"NPCApproach\"\n	| \"Shift\"\n\n-- How an event is *answered*, which is a separate question from how it reached\n-- the player. A Panel event is read and clicked. An Enacted one puts its choices\n-- three dots over the thing it is about, and you answer it by going over there and\n-- clicking them -- the prompt stays on screen as a banner and the world stays live\n-- behind it.\n--\n-- The two axes are independent on purpose: a letter can be read off a panel or\n-- walked away from, and which it is should be a content decision rather than a\n-- consequence of how the letter arrived.\n--\n-- A Handled event has no list of answers anywhere. Its choices are objects in the\n-- room and you answer it by doing something to one of them -- crawling to the toy,\n-- shoving the rug aside, carrying the cookie to your mouth. The prompt is on screen\n-- as a banner, exactly as an enacted one is, and that is all: there is never a row\n-- to click, because a row to click is what this exists instead of.\n--\n-- The difference from Enacted is what walking buys you. Enacted spends the walk on\n-- the *right to be asked* -- you go to the dog, click the dots, and then choose. In\n-- a Handled event the walk is the choosing. There is no moment where the world stops\n-- and a menu opens.\n--\n-- Enacted and Handled are both always a *request*. If there is nothing in the room to\n-- hang the dots on -- an event about nothing, or a subject the room had nowhere to\n-- put -- and likewise if the room has nowhere to lay out a prop set, the event falls\n-- back to a panel rather than becoming unanswerable. That means the field is never a\n-- guarantee and no caller may treat it as one.\nexport type EventResolution = \"Panel\" | \"Enacted\" | \"Handled\"\n\n-- Closed rather than a loose string, so that a third value can never arrive from\n-- content and pass silently through a comparison that only ever tested for one of\n-- these two.\n--\n-- What it is for is narrow and worth stating, because a type like this invites being\n-- read as more than it is: it decides which first-name list a generated person is\n-- named from, and nothing else. It is not attached to what anybody can *do* -- no job,\n-- no event, no stat and no offer anywhere reads it -- and nothing in this game should\n-- ever be gated on it. There is deliberately no partner system for it to feed: a\n-- romantic relationship is the one thing this game cannot write and stay 13+.\nexport type Gender = \"male\" | \"female\"\n\n-- One person the world can send to your door. Built from body scales and colors\n-- rather than from a catalog bundle on purpose: those need no asset ids at all,\n-- so the cast exists and reads as a person before a single id has been picked in\n-- Studio. The id fields are polish layered on top, and 0 means \"not chosen yet\"\n-- because that is what HumanoidDescription itself uses for an empty slot.\n--\n-- The cast is fixed rather than randomized so that the neighbor who turns up at\n-- nine is the same neighbor at forty. That continuity is the whole reason these\n-- are authored people instead of generated ones.\nexport type CastMember = {\n	id: string,\n	-- Shown over their head. Kept out of the event text so a line can be reused\n	-- by a different visitor without being rewritten.\n	name: string,\n	-- Lives here rather than on Person because it belongs with the *name*, and the\n	-- name is here. A generated person's first name is drawn from the list this\n	-- picks, so the two cannot disagree without somebody deliberately editing one of\n	-- them -- which is worth more than the convenience of reading it one hop closer\n	-- to the offers that care.\n	gender: Gender,\n	skinColor: Color3,\n	-- Build, **not size**: how far off average for their age this particular person\n	-- is, with 1 meaning average. Age is applied on top by Config.Growth when the\n	-- rig is built, so a schoolfriend at 0.9 is a slightly small six-year-old at six\n	-- and a slightly small seventeen-year-old at seventeen -- which is what a person\n	-- is. Writing an absolute here instead is what used to make every child NPC a\n	-- short adult who never grew.\n	-- Safe range: 0.85-1.15. Outside that they read as a caricature.\n	heightScale: number,\n	widthScale: number,\n	headScale: number,\n	proportionScale: number,\n	bodyTypeScale: number,\n	shirtAssetId: number,\n	pantsAssetId: number,\n	hairAssetId: number,\n	-- Clothing colour, used only while the matching asset id above is 0. A body\n	-- with no shirt asset and no shirt colour renders every limb in `skinColor`\n	-- -- NPCService's own \"needs no asset ids at all\" claim was only half true\n	-- until these existed, because a torso and a pair of legs painted the same\n	-- shade as the face is not a clothed person, it is a bare mannequin wearing\n	-- its own skin. nil means \"not chosen\", the same as an asset id of 0, and\n	-- falls back to skinColor so every existing CastMember written before this\n	-- field keeps rendering exactly as it did.\n	shirtColor: Color3?,\n	pantsColor: Color3?,\n	-- Set only on peers: how many years off the player's own age this person is,\n	-- so they are re-sized to the player's age every time they are sent rather\n	-- than being whatever size they were written at. nil means an adult, whose\n	-- size is a fact about them and not about you.\n	--\n	-- This is what makes the friend you play out front with at six a\n	-- seventeen-year-old at seventeen without a second rig or a second id.\n	-- Safe range: -3 to 3. Beyond that they are not a peer, they are a relative.\n	ageOffset: number?,\n}\n\n-- The thing an event is *about*, when that thing is something you can look at.\n-- \"There is a dog. It is at least as tall as you are\" is a sentence describing an\n-- absent animal until a dog walks into the room; a subject is what makes the\n-- second half of that true.\n--\n-- Distinct from CastMember, and deliberately not folded into it. A cast member is\n-- a person the world sends to your door, they are the *delivery*, and they are\n-- built from a HumanoidDescription because they are a Roblox avatar. A subject is\n-- whatever the prompt happens to be about -- an animal, later a vehicle or a\n-- machine -- it arrives with an event however that event was delivered, and it\n-- has no avatar to be described by. Sharing a type would have meant a dog with a\n-- shirt id.\n--\n-- Described in plain dimensions rather than by an asset id for the reason the\n-- cast is described in body scales: these need nothing bought or uploaded, so the\n-- subject exists and is the right size from the first run. A real model dropped\n-- into the Studio folder named by Config.World.SubjectFolder takes over, and\n-- nothing here changes when it does.\nexport type SceneSubject = {\n	id: string,\n	-- Never shown to the player -- there is no nameplate over a dog. This is what\n	-- the warnings and the Studio harness call it.\n	name: string,\n	-- Top of the back, in studs. The number that decides whether the animal reads\n	-- as looming or as underfoot, so it is measured against the childhood body\n	-- ladder rather than against an adult: see Config.Childhood.Bands.\n	shoulderHeight: number,\n	bodyLength: number,\n	bodyWidth: number,\n	-- Studs per second on the way in. Slower than the thing itself would move,\n	-- for the reason Config.NPC.WalkSpeed is slower than a player: the approach\n	-- has to be legible, and something that crosses the room in half a second has\n	-- not arrived so much as appeared.\n	walkSpeed: number,\n	color: Color3,\n	-- Muzzle, paws, tail tip. One second color is the entire difference between a\n	-- shape and an animal at placeholder fidelity.\n	accentColor: Color3,\n	-- True for a two-legged human figure. The placeholder builds two legs, two\n	-- arms and a head instead of four legs, a tail and a snout, and the motion\n	-- walks on two legs and nods instead of lying down.\n	biped: boolean?,\n}\n\n-- What a staged delivery actually put in the world. `anchor` is the thing the\n-- player has to reach, and it may move -- a visitor's is their own root part, so\n-- reaching them means reaching where they now are rather than where they came\n-- in. `dismiss` owns *all* teardown including the anchor, which is what lets a\n-- presentation end gracefully instead of blinking out of existence.\nexport type DeliveryPresentation = {\n	anchor: BasePart,\n	-- `collected` distinguishes the player arriving from the delivery giving up,\n	-- because those two endings should not look the same.\n	dismiss: (collected: boolean) -> (),\n}\n\n-- A job you can hold. Content, not config: the numbers here are what the job is,\n-- and adding a second shop assistant on a different street should be a new entry\n-- rather than a new tunable.\n--\n-- `yearlySalary` is the authored figure and the only one written down, because it\n-- is the one a person can judge. Everything else -- what a shift pays, what an\n-- hour pays -- is divided out of it at the point of use, so the salary can be\n-- retuned without a second number silently disagreeing with it.\n--\n-- `placeId` points at a place point in the built world (see Config.World\n-- PlacePointTag). The job does not carry coordinates for the same reason nothing\n-- else does: the shop floor is wherever the shop floor was built.\n-- What a job asks of you before it will have you, beyond being old enough: a\n-- standing at some *other* job. This is the career ladder, expressed as content\n-- rather than as code, so adding a third rung is a table entry and branching into\n-- two rungs off the same one is two entries naming the same prerequisite.\n--\n-- Deliberately a reference to another job rather than a global \"career score\".\n-- Being relied on at the shop should say nothing about whether a hospital would\n-- have you, and a single number would quietly claim that it does.\nexport type JobRequirement = {\n	jobId: string,\n	standing: number,\n}\n\n-- Somebody whose good word gets you in the door on less than the job would otherwise\n-- ask for.\n--\n-- A reference, and the whole point of it is that there is no reference *object*: the\n-- relationship is the reference. Nothing is handed over, nothing is stored on the\n-- profile, no favour is spent. The office simply reads how the neighbor feels about you\n-- on the day you apply, which is what makes twenty years of being decent to a man worth\n-- something to a system that never mentioned him.\n--\n-- Lowers the bar rather than removing it, deliberately. A vouch that skipped `minSmarts`\n-- outright would make school optional for anyone who had made a friend, and the two\n-- things this game asks of a childhood have to add up rather than substitute.\nexport type JobVouch = {\n	personId: string,\n	-- What they have to think of you before they will say anything.\n	minBond: number,\n	-- How much of the smarts bar their word is worth. Never enough to reach the floor:\n	-- a job that could be had on a reference and nothing else is a job with no bar.\n	worthSmarts: number,\n}\n\nexport type Job = {\n	id: string,\n	title: string,\n	placeId: string,\n	minAge: number,\n	yearlySalary: number,\n	-- What you must already have done elsewhere. Nil means the job is an entry\n	-- point -- the bottom of a ladder, open to anyone old enough -- and at least one\n	-- job must always be one of those or nobody could ever start working.\n	requires: JobRequirement?,\n	-- Smarts the job asks for, or nil for a job that does not care.\n	--\n	-- Deliberately separate from `requires` rather than another field inside it,\n	-- because it is a different kind of claim: `requires` is about what you did at\n	-- another job, this is about what you are. A job can ask either, both or neither.\n	--\n	-- This is the only thing in the game that reads `smarts`, and it is what school is\n	-- for. A childhood spent sitting lessons and a childhood spent skipping them end\n	-- twenty or thirty points apart, and this is the door that difference opens.\n	minSmarts: number?,\n	-- Subjects that must be cleared to open this job, and to what level.\n	-- Nil means the job does not care about school beyond `minSmarts`.\n	--\n	-- Multiple entries are OR, not AND: a player who cleared any one of them\n	-- satisfies the gate. A life with smarts 70 but zero subject mastery can\n	-- still apply to a job that only has `minSmarts`; a life with smarts 55 but\n	-- science level 3 can apply to a job that has both `minSmarts = 50` and a\n	-- science gate. The two gates are independent.\n	subjectGates: { [SchoolSubjectId]: number }?,\n	-- Who could put in a word for you here, if anyone would. Only ever read alongside\n	-- `minSmarts`, because lowering a bar that does not exist is not a favour.\n	vouch: JobVouch?,\n	-- Job-specific shift events. Picked from first, falling back to the global pool.\n	-- Nil means the job uses only the generic event pool.\n	shiftEvents: { JobShiftEvent }?,\n}\n\nexport type JobShiftEvent = {\n	id: string,\n	weight: number,\n	-- Text shown when the event triggers.\n	line: string,\n	-- Optional standing change.\n	standing: number?,\n	-- Optional money bonus or penalty.\n	money: number?,\n	-- Optional happiness change.\n	happiness: number?,\n}\n\n-- A named archetype at the end of a life. Computed from the life's data — job\n-- history, bonds, grades, convictions, money, age — and authored as content\n-- rather than code so adding a new ribbon is a table edit, not a rebuild.\n--\n-- Three causal moments are selected from the life's actual flags, bonds, grades\n-- and standing so the player can trace each one back to a moment they lived.\n-- Near-misses answer \"what was one step away from a different ending?\" and are\n-- computed by scoring every other ribbon against the same data.\nexport type RibbonMoment = {\n	age: number,\n	line: string,\n}\n\n-- One fact a life has accumulated, addressed to a reader.\n--\n-- The shared \"what happened\" shape. The end-of-life verdict picks three of these\n-- as its causal moments; the chapter reel picks every one since the last band\n-- break. Both read the same `LifeService.Moments` query, and both render through\n-- the same `FormatMoment` — the duplication that would otherwise grow between a\n-- reel and a verdict is closed by construction because there is only one walk.\nexport type Moment = {\n	ageMonths: number,\n	kind: string,\n	id: string,\n	line: string,\n}\n\nexport type Ribbon = {\n	id: string,\n	title: string,\n	description: string,\n	moments: { RibbonMoment },\n	nearMisses: { string }?,\n}\n\n-- What the HUD is told about the shift in progress. A snapshot rather than a\n-- stream of deltas, because it is redrawn wholesale anyway and a client that\n-- missed one push would otherwise be permanently wrong about the total.\n--\n-- `earned` is money already paid, not money pending: wages are credited as each\n-- game hour completes, so this is a running receipt rather than a promise.\nexport type ShiftState = {\n	-- Nil when the player holds no job, which is the ordinary state before 16.\n	jobTitle: string?,\n	-- The id behind jobTitle, so a quit button and a \"point me back at my own job\"\n	-- click have something to send that is not a display string. Nil exactly when\n	-- jobTitle is nil.\n	jobId: string?,\n	-- What an hour at the held job pays this player right now, standing raise\n	-- included. Nil exactly when jobId is nil -- there is no rate to have without\n	-- a job to have it at.\n	wage: number?,\n	onShift: boolean,\n	-- Game hours into the current shift, and how many make a full one.\n	gameHoursWorked: number,\n	shiftGameHours: number,\n	-- Paid so far in this shift, in whole currency units.\n	earned: number,\n	-- Against the year's allowance, in shifts rather than hours: \"3 of 5\" is\n	-- something a player can hold in their head, \"24 of 40 game hours\" is not.\n	shiftsThisYear: number,\n	shiftsPerYear: number,\n	-- How the job you hold thinks of you, as a phrase rather than a number\n	-- (\"well thought of\"). A phrase because a record is an opinion people hold\n	-- about you, and nobody has ever been told they are a 14.\n	--\n	-- Nil when there is no job to have an opinion.\n	standing: string?,\n	-- Why you cannot clock on at the station you are standing next to, in words the\n	-- player can act on. Nil in the overwhelmingly common case of not standing next\n	-- to one at all.\n	--\n	-- This exists because clocking on is automatic and proximity-based, which makes\n	-- its failure mode silence: you walk up to the office at 18, nothing happens,\n	-- and the game has told you nothing about why. A refusal has to say what it\n	-- wants from you or the ladder is invisible.\n	blockedReason: string?,\n	-- XP carried from `workXp` on this life's data. Reset to zero when the shift\n	-- starts and refilled each tick from the server so the bar stays honest.\n	standingXp: number,\n	-- The XP value at which the next standing band is reached. Used by the HUD\n	-- to turn the raw `standingXp` into a fraction for the progress bar. Nil when\n	-- the player is at the maximum band.\n	nextBandXp: number?,\n}\n\n-- Where the game is currently pointing the player, and what they will find when they\n-- get there. A nil `target` means \"nowhere\", and that is the state almost all of the\n-- time: an arrow that is always up is nagging rather than guidance, and stops being\n-- read long before it stops being drawn.\n--\n-- Drawn entirely on the client, which is the whole reason this crosses the wire as a\n-- position instead of being a Beam the server parents into the workspace. A line\n-- leading to your first job is personal -- three players in one shop would otherwise\n-- stand in a cat's cradle of each other's directions.\n--\n-- The label travels with it because a line across the floor does not say what is at\n-- the end of it. \"Shop assistant\" waiting there is the difference between being led\n-- somewhere and being told where you are being led.\nexport type GuideState = {\n	target: Vector3?,\n	label: string?,\n}\n\n-- One \"NOW HIRING\" post standing at one workplace: a sign to read from the street\n-- and a mark on the floor to step onto.\n--\n-- Sent per player and drawn on the client, for the same reason GuideState is. A post\n-- is an offer, not scenery, and the one thing an offer has to do is stop being made\n-- to the person who accepted it -- so the player who took the job is simply not sent\n-- one. A single object in the workspace could never do that.\n--\n-- Being personal is also what lets `padLocked` exist. A shared pad had to invite\n-- everybody, because it had no idea who was looking; this one is told, so a job you\n-- are two years short of can be painted grey and still say what it wants.\n--\n-- Every string here is composed by the server. The client picks no words -- it\n-- decides where the text sits and what colour it goes when locked, and nothing else.\nexport type JobPostState = {\n	jobId: string,\n	-- The job's place point: the floor at the counter. The sign floats above it and\n	-- the pad is painted on it.\n	position: Vector3,\n	-- \"NOW HIRING\". Passed rather than hardcoded so a post can eventually say other\n	-- things -- a job with nobody's shift free this year -- without a second builder.\n	headline: string,\n	title: string,\n	-- The terms, shown on one line: pay, the age, whatever the ladder wants first.\n	terms: { string },\n	-- What the mark on the floor says. \"Take the job\" when it is open, and the reason\n	-- it is not when it is locked.\n	padLabel: string,\n	padLocked: boolean,\n}\n\n-- One thing you are asked to do during a shift, as authored. Content, not state --\n-- see TaskState for the one in progress.\n--\n-- Deliberately one primitive. A task is some marks to walk onto, in order, before a\n-- clock runs out, and that is almost all it will ever be: the variety comes from the\n-- words and the numbers, not from new verbs. Restocking a shelf and carrying a box to\n-- the stockroom are the same mechanic wearing different sentences, and pretending\n-- otherwise would buy a lot of code for a difference the player cannot feel.\n--\n-- Reaching a mark no longer finishes it by itself, either -- see Config.Interact's\n-- PickupKeyboardKey. The mark arms a prompt, and the player presses the pickup key to\n-- actually do the thing, the same way arriving next to somebody arms the badge that\n-- opens a conversation rather than opening it for you. That one change is what makes\n-- forty-nine mark-and-reach tasks read as forty-nine different jobs instead of one\n-- job wearing forty-eight different labels.\n--\n-- What the marks are *near* is not authored. They are found at run time around\n-- wherever the player clocked on, which is what lets a job get tasks without anybody\n-- tagging six new parts in Studio, and what stops a task from ever sending somebody\n-- into a wall in a room the author never saw.\nexport type JobTask = {\n	id: string,\n	-- What the HUD says you are doing. A sentence, in the present tense: the player\n	-- reads it once, while walking.\n	label: string,\n	-- What the mark on the floor says. Shorter than the label, because it is read at\n	-- a glance from across a room with a body in the way.\n	mark: string,\n	-- How many marks, visited in order. One is \"go there\"; two is \"fetch it and bring\n	-- it back\", which is the only structure in the game that makes a workplace feel\n	-- like it has a layout.\n	-- Two is the practical ceiling: three marks in twenty seconds is a chore.\n	spots: number,\n	-- What the far mark says, on a task that has two. Defaults to `mark`, and is worth\n	-- filling in on anything shaped like a fetch: \"Fetch the box\" written on the place\n	-- you are bringing the box back *to* is the one word in the task pointing the wrong\n	-- way.\n	handMark: string?,\n	-- How many people queue for this task, or nil for the ordinary shape.\n	--\n	-- The one field here that changes what a task *is* rather than what it says. A rush\n	-- is one round trip per person in the queue -- fetch, hand over, fetch, hand over --\n	-- so the clock stops being a countdown you walk out and becomes a line of people\n	-- getting shorter. Being slow is visible from anywhere in the room, because the ones\n	-- still waiting are standing in it.\n	--\n	-- The counter end stays put, because that is where the queue is. The other end is\n	-- looked up again for every person, so a rush is a shop you have to know your way\n	-- around under a clock rather than one lane run six times.\n	--\n	-- Needs `spots = 2` and a `customer` line, and the validator insists on both: a\n	-- queue at one mark would be served without moving, and a queue with nobody in it\n	-- is just a long task.\n	rush: number?,\n	-- The clock, in real seconds, for the whole task.\n	--\n	-- On a rush this is the clock for the authored number of people. A room with space\n	-- for two of the three shortens the queue and shortens this with it, so a cramped\n	-- shop is an easier shift to look at and exactly as hard a one to work.\n	seconds: number,\n	-- What the person waiting on this task says while they wait, or nil if nobody is.\n	--\n	-- The only field here that puts a body in the room, and it is one string because\n	-- that is genuinely all the authoring a person needs: where they stand is found at\n	-- run time from the mark, who they are is drawn from the public, and what they do\n	-- is wait. A task with a line has somebody standing across its last mark looking\n	-- at you; a task without one is the same task in an empty shop.\n	--\n	-- Written as speech, in their words, not the game's. \"Just these, thanks\" is a\n	-- person; \"Customer waiting for service\" is a status bar with a head.\n	customer: string?,\n	-- Whether this task is a fetch-and-bag order rather than a plain walk-to-mark.\n	-- When true the task generates its own spots from tagged shop geometry and\n	-- tracks an order of items instead of a single mark. Only used on shop_assistant.\n	fetchBag: boolean?,\n}\n\n-- One task in progress, pushed to the HUD. They arrive as a list, and an empty list\n-- means \"nothing right now\" -- either between tasks or not on shift at all, which the\n-- HUD does not need to tell apart because in both cases there is nothing to be doing.\n--\n-- Up to Config.Work.Tasks.MaxConcurrent of them at once, late in a shift. That is the\n-- whole reason this is a list: a shift that can only ever ask for one thing is asking\n-- how fast the player walks, and a shift that asks for two is asking which one they\n-- would rather lose.\n--\n-- A whole snapshot every push, like every other state in this game: a dropped message\n-- is corrected by the next one rather than leaving a countdown permanently a second\n-- out, or a mark on the floor for a task that finished ten seconds ago.\nexport type TaskState = {\n	-- The job task's authored id. Not shown anywhere -- it is how the client tells two\n	-- live tasks apart between pushes, so it can leave one mark standing untouched\n	-- while the other is replaced. Without it the client can only match by position in\n	-- the list, and the list shortens from the middle every time the first of two is\n	-- finished.\n	id: string,\n	label: string,\n	-- Where the mark you are currently heading for goes, and what is written on it.\n	--\n	-- Drawn on the client for the third time in this system and for the same reason as\n	-- the other two: a task is yours. Two shop assistants on the same floor would\n	-- otherwise be walking through each other's instructions, each being told to sweep\n	-- a spot the other one is being told to fetch a box from.\n	--\n	-- The server picks the position -- it is the one that knows where the walls are --\n	-- and the server also decides when you have reached it. The client draws a disc\n	-- there and nothing else; deleting it by hand would remove the mark and change\n	-- nothing about whether the task can be completed.\n	spot: Vector3,\n	mark: string,\n	-- Which mark you are on and how many there are, so the HUD can say \"1 of 2\"\n	-- without knowing anything about what a task is.\n	spotIndex: number,\n	spotCount: number,\n	-- How many people are still queueing for this one, or nil if it is not that kind of\n	-- task. Replaces the mark count on the row rather than joining it: \"3 of 6\" is a\n	-- true fact about a rush and a useless one, because what the player wants to know\n	-- is how many more times they are doing this, and that is people, not marks.\n	waiting: number?,\n	secondsLeft: number,\n	secondsTotal: number,\n	-- True while the clock is held. Currently only ever because an event prompt is\n	-- open: a shift moment is something to read and answer, and racing a task timer\n	-- while doing it would teach players to dismiss the writing unread.\n	--\n	-- Sent rather than inferred from a frozen countdown, because a paused clock and a\n	-- broken one look identical on a HUD and only one of them is worth waiting out.\n	paused: boolean,\n	-- The clock ran out on this one. It is still sent, for the few seconds before the\n	-- next task, so that missing one is something the player is told rather than\n	-- something they work out at the end of the shift from a number going the wrong\n	-- way.\n	--\n	-- `spot` is still filled in and still real, but there is nowhere left to go: the\n	-- client takes the mark off the floor and keeps the row. Which is the honest shape\n	-- of it -- the task is over, the fact of it is not.\n	missed: boolean,\n	-- Whether this is a rush task (repeating serve cycle) rather than a fetch/hand.\n	-- The client uses it to colour the bar differently: a rush is visually urgent\n	-- even when the clock is not in its last third, because the whole shape of the\n	-- task is \"keep the line moving\" rather than \"get to the mark and back.\"\n	rush: boolean,\n	-- Present only on fetch-and-bag tasks. The HUD reads it to show the order\n	-- line, the basket level, and the patience bar instead of the ordinary\n	-- waiting-person count. Nil on every task that is not the corner shop's\n	-- signature rhythm.\n	fetchBag: {\n		-- Which items the customer wants, in order. Each entry is the name of\n		-- an item and the shelf zone it lives on.\n		order: { { name: string, zone: string } },\n		-- How many items have already been collected from shelves.\n		collected: number,\n		-- How many items are currently in the basket, from 0 up to basketSize.\n		basketCount: number,\n		-- How many items the basket can hold at once.\n		basketSize: number,\n		-- How much patience remains out of the total. The client draws this as\n		-- a bar; when it hits zero the tip has scaled to the floor.\n		patienceLeft: number,\n		patienceTotal: number,\n	}?,\n}\n\n-- One thing a lesson asks you.\n--\n-- Content data, and the whole reason school can be a mechanic rather than a stat that\n-- goes up. What makes it one is the clock: five questions, twenty seconds each, and a\n-- child who is getting them wrong finds that out while there are still some left.\n--\n-- Deliberately not a school syllabus. These are the things a child in this game would\n-- plausibly be asked in a room with a board in it, kept short enough to be read and\n-- answered inside twenty seconds.\nexport type LessonQuestion = {\n	id: string,\n	-- Asked in the second person where it can be, and never longer than a line. It sits\n	-- on the panel above a twenty-second countdown; anything that needs re-reading has\n	-- already failed.\n	ask: string,\n	-- Two to four of them, and exactly one is right. Order here is the order they were\n	-- written, not the order they are shown -- the rows are shuffled per question, so\n	-- an answer cannot be learned as \"the top one\".\n	answers: { string },\n	-- Which entry in `answers` is the right one, from 1.\n	correct: number,\n	-- What the teacher says once it has been answered, either way. The one thing that\n	-- makes this school rather than a quiz: getting it wrong should still leave you\n	-- knowing the answer, because that is what the lesson was for.\n	because: string,\n	-- An optional teacher gesture on a correct answer, overriding the default bow.\n	-- Nil means the teacher bows. Content-only; wrong answers are never decorated.\n	reaction: LessonReaction?,\n	-- The youngest and oldest this is asked of. A seven-year-old and a sixteen-year-old\n	-- are in different rooms, and a game that asked them the same thing would be\n	-- admitting that the eleven years in between did not happen.\n	minAge: number,\n	maxAge: number,\n}\n\n-- The question in front of the player, pushed to the HUD. Nil means no lesson is\n-- running, which is almost all of a life.\n--\n-- A whole snapshot every push, like every other state in this game, and that now\n-- includes the answers: they are rows on a panel rather than discs on the classroom\n-- floor, so they travel with the question rather than being built in the room around\n-- it.\nexport type LessonState = {\n	ask: string,\n	-- The answers, and by their presence the thing that opens the panel: a lesson is\n	-- the one thing in this game with nothing to click, so a push carrying answers *is*\n	-- the question being asked, and a push carrying none closes it again. That covers\n	-- the beat the teacher's line is up, the summary at the end of a lesson, and the\n	-- refusal at the door of one you cannot sit.\n	answers: { OfferedChoice },\n	-- Which question of how many, so the row can say \"3 of 8\". Unlike a shift's marks,\n	-- this genuinely is the number the player wants: a lesson is a fixed number of\n	-- questions and knowing how much is left is knowing how the day is going.\n	--\n	-- Both zero on the two pushes that are not a question: the summary at the end of a\n	-- lesson, and the refusal at the door of one you cannot sit. Those carry their whole\n	-- message in `ask` and `verdict` and have no position in anything, which is what a\n	-- zero here means -- see `secondsTotal`.\n	index: number,\n	count: number,\n	-- How many of the ones asked so far were right. On screen the whole time rather\n	-- than saved for a report at the end, because a child who is getting them wrong\n	-- should find that out while there are still some left.\n	right: number,\n	secondsLeft: number,\n	-- Zero means there is no clock on this at all, and the client draws no bar. The\n	-- signal rather than an extra flag, because a countdown out of nothing is not a\n	-- countdown -- and the two pushes it applies to, a lesson's closing summary and a\n	-- refusal at the door, are exactly the two the player is not being timed on.\n	secondsTotal: number,\n	-- Set for the beat after an answer, and the only time this row says anything the\n	-- player did not already know. Holds the question's `because` line, so getting it\n	-- wrong teaches the answer instead of only recording that you did not have it.\n	verdict: string?,\n	-- Whether the answers are discs on the classroom floor this question -- the walk-\n	-- to-answer mechanic -- rather than rows to click. The rows travel locked either\n	-- way, so this is what the panel reads to know it is showing a reference list and\n	-- to say so. Nil for the pushes that are not a question.\n	physical: boolean?,\n	-- Whether that verdict was a right answer, for the colour of it. Meaningless while\n	-- `verdict` is nil.\n	wasRight: boolean,\n}\n\n-- Which subject a school lesson is, and by that which *verb* it runs.\n--\n-- The reason this exists at all is a reversal, and it is worth saying so where the\n-- reversal lands rather than only where it was made: content/Lessons.luau's header\n-- argues at length that there are no subjects, only a room with a board in it. That was\n-- right while every subject was the same act -- a question and three answers -- because\n-- naming them would have bought a menu and made every gap in the question bank look\n-- like a missing feature. It stops being right the moment a subject is a different\n-- thing to do with your hands. Science is not chemistry-flavoured multiple choice; it\n-- is a procedure you walk. Once one subject has its own verb the others need names to\n-- be told apart by, and the menu the old note was protecting against is now the point.\n--\n-- Not the same word as content/Subjects.luau, which holds SceneSubject -- the animals\n-- and people an event can be *about*. Unrelated, and the collision is unfortunate; this\n-- is the one on a timetable.\nexport type SchoolSubjectId = \"science\" | \"math\" | \"reading\" | \"art\" | \"music\" | \"geography\"\n\n-- How a subject is played. The whole content of the Bully model in one union: a\n-- subject is a verb, and two subjects sharing a verb are the same activity in\n-- different words, which is the thing this rebuild exists to stop.\n--\n-- \"quiz\" is the old path -- ask, three answers, a clock -- and it is transitional, not\n-- a design. Every subject still on it is a subject whose verb has not been written yet,\n-- and the list of them is meant to reach zero. It is kept because the alternative was\n-- deleting eleven of a childhood's twelve school years until all six verbs existed, and\n-- a childhood with one subject in it is worse than one with five placeholders.\n-- How a bully's patience falls while you are holding, which is the only thing that\n-- makes one of them different to play against. Same input every time, different\n-- opponent -- the seventh requirement in the activity law, and the reason there are\n-- three of these rather than one bully with a difficulty number on it.\n--\n--   steady  -- falls at one rate and never lies. The one you learn the verb on.\n--   bluffer -- falls fast, then jumps back up once when it is nearly out. Releasing on\n--              the first sight of the window loses to this one; waiting one beat beats\n--              it, and that beat is the technique.\n--   mirror  -- falls in proportion to how fast your own nerve is rising, so holding\n--              longer does not help and the window has to be taken early.\nexport type BullyDrain = \"steady\" | \"bluffer\" | \"mirror\"\n\n-- What they are standing there for. Money is the small frequent cost; homework is the\n-- one that puts a walk in your afternoon; seat is the pure standing contest with nothing\n-- taken, which exists so the corridor is not only ever a tax.\nexport type BullyDemand = \"money\" | \"homework\" | \"seat\"\n\n-- One bully as content declares them.\nexport type BullyArchetype = {\n	id: string,\n	-- The body the corridor builds for them. A whole CastMember rather than a cast id\n	-- because a bully is not one of the recurring people: the cast is the handful of faces\n	-- a life keeps meeting, and putting four interchangeable corridor kids in it would\n	-- dilute the one thing that list is for.\n	body: CastMember,\n	-- Seconds they will stand there before their patience is gone. The clock you are\n	-- playing against; Config.School.Bully.Bell is the one you are playing under.\n	patienceSeconds: number,\n	drain: BullyDrain,\n	demand: BullyDemand,\n	-- What they say when they step across you, when you face them down, and when you back\n	-- off. Three lines rather than one, because an encounter that reads the same whichever\n	-- way it went is an encounter the player stops reading.\n	openingLine: string,\n	standUpLine: string,\n	backDownLine: string,\n	-- The ages this one turns up between, matched the way a subject's band is.\n	minAge: number,\n	maxAge: number,\n}\n\n-- The stare-down as the client draws it. Pushed on change rather than per frame, for the\n-- reason the lesson HUD is: a bar that redraws four times a second cannot be read.\nexport type NerveState = {\n	active: boolean,\n	-- Who is in front of you and what they want, in their words. Empty while inactive.\n	bullyName: string,\n	line: string,\n	-- Both 0..Config.School.Bully.Nerve.OverholdCeilingShare, and both shares of the same\n	-- bar so the client never has to know what either is measured in.\n	nerve: number,\n	patience: number,\n	-- The band the player is trying to release inside, as shares of the same bar. Sent\n	-- rather than computed on the client because it is what the nerve number *buys*, and a\n	-- window the client derived could disagree with the one the server scored against.\n	windowLow: number,\n	windowHigh: number,\n	holding: boolean,\n	-- Seconds before somebody else reaches you and the window closes to its narrowest,\n	-- or nil when nobody is coming. This is the second clock, and at the tiers where the\n	-- corridor sends people in pairs it is the whole of the difficulty: the first bar\n	-- tells you when the window *opens* and this one tells you when it shrinks, so the\n	-- release has to land between two clocks rather than after one.\n	--\n	-- Nil below those tiers, which is deliberate -- a countdown that is always on screen\n	-- and usually irrelevant is a countdown players learn to stop reading.\n	secondsToBackup: number?,\n}\n\n-- One square of a word on the board. Either a letter that was always there, or a gap\n-- waiting for one, or a gap somebody has put a tile into.\n--\n-- `placed` and `letter` are separate because a filled gap and a given letter must not be\n-- the same thing to the panel: a player has to be able to see at a glance which letters\n-- are theirs to take back and which are the word\\'s own, and one field could not say.\nexport type WordCell = {\n	letter: string,\n	-- True when this square was a gap the player filled. Only these can be taken back.\n	placed: boolean,\n	-- True when this square is still empty. `letter` is \"\" when it is.\n	gap: boolean,\n}\n\n-- One word being built. Two of these are live at once, which is where the whole decision\n-- in this subject lives: the tray is shared, so a letter spent here is a letter the other\n-- word does not get.\nexport type WordTarget = {\n	id: string,\n	cells: { WordCell },\n	-- True once it has been handed in and is waiting to be replaced. Kept for a beat rather\n	-- than removed immediately, so the player sees the word they finished rather than a\n	-- slot that changed under them.\n	done: boolean,\n}\n\n-- One tile in the tray.\nexport type TrayTile = {\n	id: string,\n	letter: string,\n	-- True once it has been placed into a gap. Spent tiles stay in the tray, greyed, rather\n	-- than vanishing -- a tray that shuffles up under the thumb is a tray you cannot aim at,\n	-- and seeing what you have already spent is half of knowing what is left.\n	spent: boolean,\n}\n\n-- The reading lesson as the client draws it.\nexport type ReadingState = {\n	active: boolean,\n	-- The closing line, or a refusal. Survives `active` going false for a beat.\n	line: string,\n	targets: { WordTarget },\n	tray: { TrayTile },\n	-- Which tile is in hand, or nil. Held on the server rather than the client because the\n	-- placement is scored server-side and a tile the client thought it was holding would be\n	-- a placement the server refuses for no visible reason.\n	heldTileId: string?,\n	-- Takebacks left. This is what mastery buys and it is deliberately a number on screen:\n	-- the margin the player is being given has to be visible inside the verb, not folded\n	-- into a hidden tolerance.\n	takebacks: number,\n	wordsDone: number,\n	wordsTarget: number,\n	secondsLeft: number,\n	-- Where they are standing, so the panel can light the controls that are actually live.\n	atDesk: boolean,\n	atShelf: boolean,\n	masteryLevel: number,\n}\n\n-- One note in a chart. Sent to the client at the start of a lesson and never again: the\n-- whole piece is known up front, which is what lets a player *read ahead* and is the\n-- difference between a rhythm lesson and a reaction test.\nexport type MusicNote = {\n	-- Milliseconds from the downbeat. Integer, because a note at 1000.4ms and a note at\n	-- 1000ms are the same note and only one of them survives a round trip as a float.\n	atMs: number,\n	-- 1..Config.School.Music.Lanes.\n	lane: number,\n	-- How long it is held for, in milliseconds, or 0 for a tap. A held note is the second\n	-- queue: it occupies a hand while the other lanes keep arriving.\n	holdMs: number,\n}\n\n-- How a note was judged. Named rather than numbered because the words are shown to the\n-- player and a band that only existed as an index would be renamed in one place and not\n-- the other.\nexport type MusicJudgement = \"perfect\" | \"great\" | \"good\" | \"miss\"\n\n-- The music lesson as the client draws it.\n-- PE, which is a graded sports drill rather than a lesson -- see content/Curriculum.luau\n-- and services/PEService.luau for why that is the whole point of the subject.\n--\n-- The meter is the golf three-click: one click starts it, the second sets power, the third\n-- sets accuracy. Every field the client needs to *draw* that meter is sent from the server\n-- rather than read from Config, for the reason MusicState sends its judgement windows: the\n-- windows are what fitness and mastery buy, and a client that computed them could disagree\n-- with the server that scored against them.\nexport type PEState = {\n	active: boolean,\n	line: string,\n	-- Which drill is on, and how far through it you are.\n	drill: string,\n	attempt: number,\n	attempts: number,\n	-- Which click comes next: \"power\" or \"accuracy\". Never \"ready\" -- the first click of an\n	-- attempt starts the power sweep, so there is no idle phase to represent.\n	phase: string,\n	-- `os.clock()` on the server when the current sweep started, converted by the client to\n	-- its own clock on receipt. The marker is drawn from this and nothing else.\n	sweepStartedAt: number,\n	-- How long the running sweep takes to cross. The accuracy sweep is faster than the power\n	-- one, and faster again if the last click overswung -- which is the whole risk in the\n	-- risk/reward.\n	sweepSeconds: number,\n	-- Where the overswing zone starts on the power bar, as a share of it. Past here you get\n	-- more power and a faster accuracy sweep.\n	overswingFrom: number,\n	-- The accuracy bands, as shares of the bar.\n	perfectFrom: number,\n	perfectTo: number,\n	goodFrom: number,\n	goodTo: number,\n	-- The power locked in by the second click, or 0 before it. Drawn as a held marker so you\n	-- can see what you are about to spend.\n	power: number,\n	-- Running tallies. `scored` is in attempts, so 4.2 out of 6 is a share of 0.7.\n	scored: number,\n	bestAttempt: number,\n	lastLine: string,\n	-- What this drill has to reach to pass, which rises with mastery. Sent so the bar can be\n	-- drawn with the mark on it rather than the player being graded against a number they\n	-- were never shown.\n	passShare: number,\n	secondsLeft: number,\n	masteryLevel: number,\n	atField: boolean,\n}\n\nexport type MusicState = {\n	active: boolean,\n	line: string,\n	-- The whole chart, sent once. Empty while inactive.\n	notes: { MusicNote },\n	-- `os.clock()` on the server when the downbeat falls, converted to the client\\'s own\n	-- clock by the client on receipt. The one number everything else is measured from.\n	startedAt: number,\n	-- The judgement windows this life has earned, in milliseconds. Sent rather than read\n	-- from Config on the client for the reason the corridor sends its release window: it is\n	-- what mastery *buys*, and a client that computed it could disagree with the server that\n	-- scored against it.\n	perfectMs: number,\n	greatMs: number,\n	goodMs: number,\n	-- Running tallies, so the panel can show a streak without keeping its own count and\n	-- drifting from the server\\'s.\n	perfect: number,\n	great: number,\n	good: number,\n	missed: number,\n	streak: number,\n	bestStreak: number,\n	notesTotal: number,\n	secondsLeft: number,\n	-- Where they are standing, so the panel lights the lanes only when the server would\n	-- honour a hit.\n	atStand: boolean,\n	masteryLevel: number,\n}\n\nexport type SchoolVerb = \"quiz\" | \"procedure\" | \"hunt\" | \"copy\" | \"build\" | \"keep\" | \"drill\"\n\n-- One school subject as content declares it.\n-- One period on the timetable, as the player sees it.\n--\n-- Sent rather than derived on the client, for the reason every other panel in this game is\n-- pushed: the rotation lives in one function on the server (SchoolService.subjectForSlot) and\n-- a client that recomputed it would be a second copy of the timetable, free to disagree with\n-- the one that actually decides what lesson you sit.\nexport type TimetableEntry = {\n	slot: number,\n	subjectId: SchoolSubjectId,\n	name: string,\n	blurb: string,\n	-- \"done\" is behind you, \"now\" is the one the next bell rings for, \"later\" is still to come.\n	-- Three states rather than a boolean because \"which one is next\" is the single thing a\n	-- player opens a timetable to find out.\n	state: \"done\" | \"now\" | \"later\",\n}\n\nexport type Timetable = {\n	ageYears: number,\n	entries: { TimetableEntry },\n}\n\nexport type SchoolSubject = {\n	id: SchoolSubjectId,\n	-- Shown on the board, the timetable and the report. Title case, one or two words:\n	-- it is read as a label rather than a sentence.\n	name: string,\n	verb: SchoolVerb,\n	-- What the subject asks of you, in the player's words rather than the system's. Read\n	-- once, at the door, by somebody deciding whether to walk in.\n	blurb: string,\n	-- The ages this subject is taught between, matched the way a question's band is. Not\n	-- every subject runs the whole twelve years -- a six-year-old is not running a\n	-- titration, and the year a subject opens is one of the few things that makes a\n	-- birthday change what school *is* rather than only what it asks.\n	minAge: number,\n	maxAge: number,\n}\n\n-- One lesson as the record remembers it. Written the moment a lesson ends -- by whichever\n-- verb ended it -- and read once, on the card handed over at the start of the next year.\n--\n-- It stores what was decided rather than what it was decided from. The band is the word\n-- the verb already graded itself with and the smarts are what it already paid, so a card\n-- can never contradict the closing line the player read at the time: there is no second\n-- calculation here to disagree with the first.\nexport type SchoolLessonRecord = {\n	subjectId: string,\n	-- One of school/Report's four: good, ok, poor, skipped. A plain string rather than a\n	-- union because it is written to a save file, and a saved life holding a band this\n	-- build has never heard of has to load rather than fail to type-check.\n	band: string,\n	smarts: number,\n	-- The mastery rung this lesson promoted the subject to, or absent if it promoted\n	-- nothing. Only the promotion, never the standing level -- see Report.RecordLesson.\n	level: number?,\n}\n\n-- A school year that has ended, named. `lessons` is the year's record; the grade is what\n-- Report.GradeFor made of it.\nexport type SchoolYearRecord = {\n	ageYears: number,\n	grade: string,\n	lessons: { SchoolLessonRecord },\n}\n\n-- One line of the school history: an age and what that year came to. The lessons are\n-- deliberately not kept -- twelve years of five-field records on every profile, to draw a\n-- line that counts them, is a save file paying for detail nothing reads.\nexport type SchoolYearGrade = {\n	ageYears: number,\n	grade: string,\n}\n\n-- The card itself, on its way to the player. Composed entirely on the server, the way a\n-- Notice is: every string on it is finished prose, and the client's whole job is to put\n-- it on the panel.\n--\n-- The rows are already panel-shaped rather than being facts for the client to lay out.\n-- That is the same call `LessonState.answers` makes and for the same reason: what a row\n-- looks like when you read it is one decision, made once, and a card that laid its own\n-- rows out would be a second place for it to be made differently.\nexport type ReportCard = {\n	-- The age the reported year ended at. Echoed back on the acknowledgement so a press\n	-- landing after a birthday cannot clear a card it was never shown.\n	ageYears: number,\n	title: string,\n	-- One locked row per lesson slot -- including the empty ones, which is most of what a\n	-- bad year's card has to say -- and one row at the bottom that is not locked, which is\n	-- the press that puts the card away.\n	rows: { OfferedChoice },\n	-- The muted line under the rows: what this life is close to, and what its record is.\n	footnote: string,\n}\n\n-- One step of a Science procedure: go to this station, do the thing it does.\n--\n-- A step is a station id and nothing else at authoring time. There is no \"how\" here on\n-- purpose -- the station is the how, and a step that carried its own instructions would\n-- let two steps at the same bench mean different things, which is exactly the\n-- undifferentiated-outcome trap the verb is built to avoid.\nexport type ProcedureStep = {\n	station: string,\n	-- What the board writes on this line. Short: it is one row of a list read at a\n	-- glance from across a room, capped by Config.School.Science.MaxStepLabelLength.\n	label: string,\n	-- True for the handful of steps that are genuinely dangerous to take before the step\n	-- in front of them -- mixing the second reagent in before the first has cooled, and\n	-- the like. Nil (the common case) means this step is only ever *wrong*, never\n	-- dangerous: getting the order wrong costs the share, same as any other step, and\n	-- nothing else happens.\n	--\n	-- Still just a station and a label at authoring time -- this is not the \"how\" the\n	-- header above forbids, it is a property of *when*, not of what the station does. A\n	-- volatile step never changes what clicking that station does; it only changes what\n	-- commitBench does when the stack shows it was reached ahead of its predecessor.\n	volatile: boolean?,\n}\n\n-- A Science procedure as content authors it: an ordered list of stations, and a name.\nexport type Procedure = {\n	id: string,\n	-- Named as a thing you did, not a topic you covered -- \"Grow a salt crystal\" rather\n	-- than \"Crystallisation\". The report card reads better and so does the board.\n	name: string,\n	steps: { ProcedureStep },\n	minAge: number,\n	maxAge: number,\n}\n\n-- One bench's stack, as the client draws it.\n--\n-- Steps taken are station ids the player has clicked, in the order they clicked them.\n-- Freely removable until `committed`, which is the undo half of the commit-and-undo\n-- pair: the bench is a draft right up to the moment it is not.\nexport type BenchState = {\n	-- 1-based, and the client's whole way of telling the two benches apart.\n	index: number,\n	-- The procedure's name -- \"Grow a salt crystal\". The one thing about a bench that is\n	-- true from across the room, so a player deciding which bench to pick up knows what\n	-- they would be picking up.\n	name: string,\n	-- Station ids, in click order. May be longer than the procedure and may hold stations\n	-- it never asked for -- that is exactly what makes it a draft rather than a form.\n	taken: { string },\n	-- The next few steps, and *only* while the player is standing at the board -- empty\n	-- everywhere else in the room.\n	--\n	-- This is the whole verb, so it is worth being explicit about why it empties. If the\n	-- list stayed on screen after the walk back, the board would be a button you press\n	-- once and mastery would buy nothing, because nobody would ever need to return. The\n	-- player carries the steps in their head across the room; how many they can carry is\n	-- what a level is. Emptying this is not the UI being unhelpful, it is the mechanic.\n	--\n	-- Windowed from where the stack currently stands rather than from step one, so the\n	-- board always answers \"what now\" instead of reminding you what you already did --\n	-- the bench in front of you is the record of that.\n	revealed: { ProcedureStep },\n	-- Where the revealed window starts, 1-based, and how many steps there are in total.\n	-- Together they let the board say \"steps 4-6 of 8\" -- and saying that there *is* a\n	-- hidden tail is what makes the next mastery level something to want, where hiding\n	-- the fact would make progression invisible.\n	--\n	-- May be `total + 1` or beyond, which is not an error and has to be drawn as one: it\n	-- means the stack has reached or run past the end of the procedure, `revealed` is\n	-- empty, and the honest thing for the board to say is \"that is all of it, go and\n	-- commit\". A board that clamped back to the last step would be telling a player who\n	-- has just finished to do the final step a second time.\n	revealedFrom: number,\n	total: number,\n	secondsLeft: number,\n	secondsTotal: number,\n	-- Whether this is the bench the player has in hand. Steps land here and nowhere else,\n	-- and it changes by walking up to the other bench -- which is what makes running two\n	-- procedures a matter of planned trips rather than of clicking twice as fast.\n	active: boolean,\n	-- Set once the bench is scored: the 0-1 share it earned, which lands on\n	-- Config.School's GoodShare/OkShare like every other verdict in the game.\n	score: number?,\n	-- The one line said about a committed bench, naming what went wrong and where. A\n	-- score with no sentence attached teaches nothing, which is the same reason a\n	-- question carries a `because`.\n	verdict: string?,\n	committed: boolean,\n}\n\n-- The Science lab in progress, pushed as a whole snapshot like every other state here.\n-- Nil means no procedure is running, which is almost all of a life.\nexport type LabState = {\n	-- Both benches, or one while the second is still closed. Ordered by `index`.\n	benches: { BenchState },\n	-- Reagent charges left in the shared pool, and what it holds when full. Shared across\n	-- both benches on purpose -- it is the second thing the two procedures fight over, and\n	-- the reason committing a bench early is ever the right call rather than always the\n	-- timid one.\n	charges: number,\n	chargesMax: number,\n	-- Mastery level, the ceiling, and how many passes stand against the next one. On\n	-- screen because the thing mastery buys -- more of the board at once -- is otherwise\n	-- something a player only notices in hindsight, and a progression nobody can feel\n	-- arriving is a number.\n	level: number,\n	levelMax: number,\n	passes: number,\n	passesPerLevel: number,\n	-- Where the player is standing, which is the entire input state of this activity.\n	-- Nil or false almost all the time: this is a room you cross rather than a room you\n	-- stand in, and that is the point.\n	--\n	-- The client draws its affordances off these three and nothing else -- Commit is live\n	-- only at a bench, the step list only at the board, the refill bar only at the\n	-- cupboard -- so a button the player can see is always a button the server will honour.\n	atBoard: boolean,\n	atBench: number?,\n	atCupboard: boolean,\n	-- How far through the cupboard's refill the player is, 0-1. Only ever moving while\n	-- they stand there, and reset the moment they walk off: a refill you can start and\n	-- come back to would turn the trip into two half-trips.\n	refillProgress: number,\n	-- Set for the beat after the whole lab is done, replacing the benches on screen.\n	summary: string?,\n	-- The last thing the lab refused to do and why -- \"No reagents left\", \"Go to a bench\n	-- first\". Cleared on the next push that changes anything else, because a refusal is a\n	-- reply to a click and not a state to sit in.\n	notice: string?,\n}\n\n-- A geography lesson in progress: one destination at a time, and how much the player has\n-- earned the right to be told about it.\n--\n-- Pushed as a whole snapshot like every other activity state. Small on purpose -- there is\n-- no board, no benches and no rows, because the interface for this verb is the town.\nexport type HuntState = {\n	-- Which stop of how many, both 1-based and both on screen: \"2 of 3\" is the only\n	-- structure this activity has and hiding it would make a lesson feel unbounded.\n	stop: number,\n	stops: number,\n	-- The place's own authored label -- \"the pages & press\", \"number 5, on avenue 2\". The\n	-- whole of level one, and the thing every higher rung is drawn on top of rather than\n	-- instead of.\n	label: string,\n	-- Roughly where in town, as a compass sector: \"north-east side of town\". Nil below the\n	-- rung that buys it, and nil is the meaning -- the client draws nothing rather than a\n	-- blank line, so the difference between rungs is visible as the panel growing.\n	area: string?,\n	-- Compass bearing to the destination in degrees, 0 = north, clockwise. Sent as a\n	-- number rather than as a drawn arrow so the client can point it continuously as the\n	-- player turns, which is the difference between an arrow and a hint.\n	bearing: number?,\n	-- Studs to the destination. Nil below its rung. Deliberately the last thing bought:\n	-- with the bearing it is very nearly the guide line every other system gives away, and\n	-- the top of this ladder should feel like being handed the map.\n	rangeStuds: number?,\n	-- Seconds left on this stop before the lesson gives up on it and moves to the next.\n	secondsLeft: number,\n	-- Stops reached so far, which is what the lesson is graded on. On screen because a\n	-- player who has missed one should be able to see that the remaining two still matter.\n	found: number,\n	-- Where this life stands on the geography ladder, and how close the next rung is.\n	--\n	-- On the panel rather than left to be discovered, and for a stronger reason than the\n	-- lab has: what a rung buys here is *the panel itself* growing a line. A player who\n	-- was never told the ladder exists has no way to read a compass sector appearing as a\n	-- reward rather than as the game having quietly changed its mind about how much to\n	-- tell them.\n	level: number,\n	levelMax: number,\n	passes: number,\n	passesPerLevel: number,\n	-- Set for the beat after arriving, replacing the destination on screen. The pause that\n	-- makes arriving register as an event rather than as the name silently changing.\n	arrived: string?,\n	-- Set for the beat after the whole lesson is done. Same slot the lab's summary uses and\n	-- read the same way: the closing line, held, and then the activity is gone.\n	summary: string?,\n}\n\n-- One tube of paint as the player has been handed it. The colour travels rather than the\n-- id alone even though the client can resolve one from the other, because this is the row\n-- the swatch is drawn from and a palette that had to do a lookup per swatch per push\n-- would be doing it to save eight numbers.\nexport type PaletteSwatch = {\n	id: string,\n	name: string,\n	color: Color3,\n}\n\n-- An Art lesson in progress: a picture on the wall, a canvas on screen, and the gap\n-- between them.\n--\n-- Two rules about this payload, and they are the subject rather than an implementation\n-- detail. It carries the *canvas* and never the study -- the picture being copied is\n-- physically on the wall of the room and sending it would put it on screen next to the\n-- copy, which turns comparing two things across a room into comparing two things an inch\n-- apart. And nothing in it says which cells are wrong. `stale` is a count and there is\n-- deliberately no list beside it: being told how much you owe and having to find it is\n-- the entire verb, and a field here naming the cells would delete the subject in one\n-- line without breaking a single test.\nexport type ArtState = {\n	-- The canvas shape, so the client lays out a grid without a second copy of Config.\n	columns: number,\n	rows: number,\n	-- What the player has painted, one entry per cell, reading left to right then top to\n	-- bottom. Nil for an untouched cell -- and nil is drawn as bare canvas rather than as\n	-- white paint, which matters because white is a pigment you can be handed.\n	painted: { Color3? },\n	-- The study's title, which is all the help the wall's own label gives.\n	title: string,\n	-- The tubes this life's mastery rung has been handed, most-used-in-this-picture first.\n	-- Ordered rather than a set because the order is the reward made visible: the colours\n	-- at the end of the row are the ones a lower rung would not have had.\n	palette: { PaletteSwatch },\n	-- Which tube is in hand, as an index into `palette`, or nil before the first pick.\n	held: number?,\n	-- Strokes left in the shared pot and what it holds when full. Shared across every\n	-- tube on purpose -- see School.Art.StrokesPerRefill -- so the cupboard trip does not\n	-- quietly disappear at the top of the ladder.\n	strokes: number,\n	strokesMax: number,\n	-- How many painted cells no longer match the wall, and nothing about which. See the\n	-- note above the type: this number is the second queue, and a list would be the bug.\n	stale: number,\n	-- How many cells have any paint on them at all, which with `stale` is the whole of\n	-- what the player knows about their own canvas.\n	filled: number,\n	secondsLeft: number,\n	-- Where the player is standing. The canvas only takes paint at the easel and the pot\n	-- only fills at the cupboard, and the client greys its own affordances off these two\n	-- so a control that looks live is always one the server will honour.\n	atEasel: boolean,\n	atCupboard: boolean,\n	-- Mastery, on screen for the same reason it is in the other two verbs: what a rung\n	-- buys here is the row of tubes getting longer, and a player who was never told the\n	-- ladder existed would read a new colour appearing as the game changing its mind.\n	level: number,\n	levelMax: number,\n	passes: number,\n	passesPerLevel: number,\n	-- Set for the beat after the canvas is signed or taken away. Same slot the lab's\n	-- summary uses and read the same way.\n	summary: string?,\n	-- The last thing the easel refused and why -- \"Out of paint\", \"Go back to the easel\".\n	-- Cleared by the next push that changes anything else: a refusal answers a click, it\n	-- is not a state to sit in.\n	notice: string?,\n}\n\n-- Heat, as the player is allowed to know it.\n--\n-- The interesting asymmetry in this whole system is that the player knows more about\n-- what the police think than the police know about the player, and this type is that\n-- sentence written down. `lastKnown` is the payload: it is where they believe you are,\n-- which is a thing a person being hunted genuinely would know -- you were there, you\n-- remember being seen -- and it is the only information that makes hiding a decision\n-- rather than a guess.\n--\n-- That is a deliberate inversion of Geography, which refuses to tell you where anything\n-- is. Both are the same rule applied honestly: show the player what their character\n-- would actually know, and nothing else.\n--\n-- Carries no officer positions and never will. A live readout of where the police are\n-- standing would delete the search: the entire game is inferring that from where you\n-- last saw one, and a field here would answer it for free.\nexport type BountyState = {\n	-- 0..1 against Config.Crime.MaxBounty, for the bar. The raw number is deliberately\n	-- not here -- a player reading \"63\" starts optimising against the tier thresholds\n	-- instead of against the street.\n	share: number,\n	-- The tier's name, which is the only label shown: \"reported\", \"manhunt\".\n	tier: string,\n	-- How many officers are actually in the world after you. Shown because it is a fact\n	-- you could establish by looking, and because \"four\" is a better sentence than a bar.\n	officers: number,\n	-- Right now, this second, does anybody have eyes on you. The single most important\n	-- field here -- it is the feedback that teaches the whole system, and without it a\n	-- player cannot tell a successful hide from a lucky one.\n	seen: boolean,\n	-- True once the freeze after being seen has elapsed and the number is actually\n	-- falling. Separate from `not seen` on purpose: the gap between them is\n	-- Config.Crime.CoolStartSeconds, and a player who cannot see that gap thinks the\n	-- decay is broken.\n	cooling: boolean,\n	-- Where the police believe you are, and how wide they are willing to search around\n	-- it. Nil once nobody has any idea, which is the state worth playing for.\n	lastKnown: Vector3?,\n	searchRadiusStuds: number,\n	-- Whether this life has a record. Changes nothing on screen except one word, but it\n	-- is the reason the numbers behave differently, so it has to be visible or the\n	-- difficulty looks like a bug.\n	hasRecord: boolean,\n	notice: string?,\n}\n\n-- The till you are standing at, pushed as a whole snapshot.\n--\n-- The two attention fields are the activity. They say where the clerk and the camera are\n-- pointed *now*, and nothing here predicts, warns or counts down to the moment either of\n-- them turns -- the clerk's shoulders and the camera's housing do that in the world,\n-- which is where a player watching for it should be looking. A HUD that flashed a second\n-- before the glance would replace the whole verb with a reaction test.\n--\n-- Nil is every moment of every life that is not spent robbing somewhere, which is almost\n-- all of them.\nexport type TheftState = {\n	-- The shop's name, for the panel to say. The name rather than the place id, because\n	-- this is the one readout the player reads as a sentence -- \"First Pharmacy\" is where\n	-- they are, \"pharmacy\" is where the game keeps it.\n	place: string,\n	-- What is left in the drawer, and what a full one holds -- both, so the panel can\n	-- draw a share without the client having to know Config's float.\n	tillLeft: number,\n	tillFull: number,\n	-- What this visit has taken so far. Already banked: money is credited as it comes\n	-- out, not on release, so being interrupted never costs the player what they had\n	-- already lifted. There is no pot to lose, only a drawer to stop taking from.\n	taken: number,\n	-- Whether the player's hands are actually in it this second. False the moment they\n	-- let go, walk out of reach, or the drawer empties.\n	holding: boolean,\n	-- Where the two attentions are pointed. True means \"on the till\".\n	clerkWatching: boolean,\n	cameraWatching: boolean,\n	-- Being seen, which is the state the grace window ends in. Distinct from\n	-- `clerkWatching or cameraWatching` by Config.Crime.Theft.GraceSeconds -- the gap\n	-- between them is the undo, and a panel that could not show both would be showing\n	-- the player a punishment with no visible chance to have avoided it.\n	spotted: boolean,\n\n	-- Crew you could send to watch the door instead of taking your chances alone. Same\n	-- shape as BankState's pair below, and the same reason: length is the eligibility\n	-- check, the panel does not need a second flag.\n	crewCallable: { GangCrewMember },\n	-- Whose crew is watching the door right now, if anybody's -- by name, a readout and\n	-- not a control. Nil once nobody is covering, same as BankState.crewOnAlarm.\n	crewOnLookout: string?,\n\n	notice: string?,\n}\n\n-- The bank room you are standing in, pushed as a whole snapshot.\n--\n-- Where TheftState describes a *drawer*, this describes a *room*, and almost every field\n-- below is shared: the vault, the alarm and the guard are one set of facts that every\n-- player in the building is looking at. Two people robbing one bank are playing the same\n-- game, which is the difference between a second player being a partner and a second\n-- player being a duplicate.\nexport type BankState = {\n	-- The bank's name, for the panel to say. The name rather than the place id, for the\n	-- same reason TheftState carries one.\n	place: string,\n	-- What is left in the vault and what a full one holds -- both, so the panel can draw a\n	-- share without the client having to know Config's float.\n	vaultLeft: number,\n	vaultFull: number,\n	-- What this visit has taken so far. Already banked as it came out, exactly as the till\n	-- does: there is no pot to lose here, only a vault to stop taking from. What *is* still\n	-- at risk is the money itself, because an arrest confiscates what you are carrying --\n	-- so the run home is the last part of the activity and it is not drawn on this panel.\n	taken: number,\n\n	-- Which of the room's two controls the player is standing at: \"vault\", \"alarm\", or\n	-- \"between\" for the thirty-odd studs of floor in the middle.\n	--\n	-- The panel has one button and this is what decides what it says. Sent as a place\n	-- rather than as a verb because the place is the honest fact -- the player is not\n	-- \"in take mode\", they are stood at the vault -- and because a client that was told\n	-- the verb could ask for the wrong one.\n	at: \"vault\" | \"alarm\" | \"between\",\n	-- Whether the player's hands are actually on it this second. False the moment they let\n	-- go, walk out of reach of both, or the vault empties.\n	holding: boolean,\n	-- How far through a silence hold they are, 0 to 1. Zero at the vault, where holding\n	-- takes money instead.\n	silencing: number,\n\n	-- \"quiet\" before anybody has committed, then \"ringing\" or \"silenced\" for the rest of\n	-- the visit. There is no fourth state: once tripped, this building is against you until\n	-- the last person leaves it.\n	alarm: \"quiet\" | \"ringing\" | \"silenced\",\n	-- Seconds until a silenced alarm arms itself again, and how long a ringing one has been\n	-- going. Exactly one of the two is ever non-zero, but both are sent rather than one\n	-- signed number, because they are two different sentences and the panel says them\n	-- differently.\n	rearmIn: number,\n	ringingFor: number,\n\n	-- Where the guard's attention is. \"away\" is the window; \"near\" means he is in the room\n	-- with you and has not looked up; \"onYou\" means he has, and the alarm went with it.\n	-- Nil when this bank could not stand one up at all, which the panel says plainly rather\n	-- than drawing an \"away\" lamp for a man who does not exist.\n	guard: (\"away\" | \"near\" | \"onYou\")?,\n\n	-- Part 3: crew you could send to the alarm instead of holding it yourself. Empty for\n	-- almost every player, almost every visit -- it only has entries once a rank has both\n	-- crew (Config.Gangs.Crew) and nobody else's crew is already on the panel. The panel\n	-- can just check length rather than carrying a second \"am I eligible\" flag.\n	crewCallable: { GangCrewMember },\n	-- Whose crew is on the alarm right now, if anybody's -- by name, because this is a\n	-- readout, not a control. Nil when the alarm is uncovered, which includes the case\n	-- where you are standing on it yourself: that is already what `at`/`holding` say.\n	crewOnAlarm: string?,\n\n	notice: string?,\n}\n\n-- A workout in progress, pushed as a whole snapshot. Three phases:\n-- \"offer\"  — the machine is near, the panel asks Start/Leave\n-- \"rep\"    — the sweep bar is live, the PUSH button is up\n-- \"verdict\" — the hit was scored, the beat before the next rep\n--\n-- The sweep fraction is computed client-side from `progress`, `sweetCenter`\n-- and `sweetHalf`; no payload travels per frame.  The verdict phase is the\n-- only push that carries a `grade` and the stat gains so far.\nexport type WorkoutState = {\n	phase: \"offer\" | \"rep\" | \"verdict\",\n	-- Machine kind string (\"treadmill\", \"bench\", \"dumbbells\", \"pullup\").\n	machine: string,\n	-- Human-readable label for the UI.\n	machineLabel: string,\n	-- Current rep number (1-indexed), only meaningful during rep/verdict.\n	rep: number,\n	-- Total reps attempted so far.\n	reps: number,\n	-- 0-1 position of the sweep needle, computed from elapsed time.\n	progress: number,\n	-- Centre of the sweet zone. Per-machine, and NOT 0.5 on three of the four --\n	-- where the zone sits is one of the things that makes them different machines.\n	sweetCenter: number,\n	-- Half-widths of the sweet and perfect zones. Sent rather than read from Config\n	-- because they are no longer constants: both widen with the character's health,\n	-- so the bar the client draws has to come from the same place the grade does.\n	sweetHalf: number,\n	perfectHalf: number,\n	-- How long this machine's sweep takes, and how the needle moves across it. The\n	-- client needs both to draw the needle between server ticks; `curve` names a shape\n	-- in src/shared/Sweep.luau, which is shared precisely so the drawn bar and the\n	-- graded hit can never disagree.\n	sweepSeconds: number,\n	curve: string,\n	-- Share of the sweep already elapsed, 0-1. The client accumulates forward from\n	-- this every frame; `progress` is where the needle stood at the last server tick\n	-- and is what the verdict freeze displays.\n	elapsedShare: number,\n	-- Session-local stamina remaining.\n	stamina: number,\n	maxStamina: number,\n	-- Non-nil only during verdict: \"Perfect\", \"Good\", or \"Miss\".\n	grade: string?,\n	-- Running totals for the session, so the client can show gains.\n	healthGained: number,\n	looksGained: number,\n}\n\n-- A fight in progress, as the client needs to draw it.\n--\n-- Everything here is server-owned. The client renders bars and sends button presses;\n-- it decides nothing, which is why a charge that is worth more than the meter showed\n-- is not a thing that can happen. The one concession to smoothness is `charge`, which\n-- the client advances between ticks the same way the gym advances its needle -- and,\n-- like the gym, from a share the server sent rather than from a clock of its own.\nexport type FightState = {\n	-- \"square\" is the moment before it starts, when somebody is stood in front of you\n	-- and the panel is asking. \"down\" is either fighter on the floor; \"over\" is the\n	-- result sitting on screen. Both exist as phases rather than as a closed panel\n	-- because the end of a fight is the part the player most needs to read.\n	phase: \"square\" | \"fight\" | \"down\" | \"over\",\n	-- Who, and what kind of fighter they are. The style is shown because it is the\n	-- thing worth learning: the whole depth of this system is that a brawler and a\n	-- scrapper want opposite answers out of the same three buttons, and a player who\n	-- cannot name what they are facing cannot build that knowledge.\n	foeName: string,\n	foeStyle: string,\n	-- One sentence naming the answer to this opponent, shown only while squaring up.\n	-- It is on the state rather than in the client because the whole difficulty curve\n	-- lives in content/Fighters.luau, and a style added there with no advice written\n	-- beside it should arrive on screen mute rather than arrive wrong.\n	foeBlurb: string,\n	-- The contest. Footing is what runs out; whoever hits zero goes down.\n	footing: number,\n	maxFooting: number,\n	foeFooting: number,\n	foeMaxFooting: number,\n	-- The shared pool the player's three actions spend from.\n	stamina: number,\n	maxStamina: number,\n	-- What the player is doing. `charge` is 0-1 through a wind-up and only moves while\n	-- the strike button is held; `recover` is 0-1 of a lockout still to run, which is\n	-- what greys the buttons out.\n	charge: number,\n	guarding: boolean,\n	sidestepping: boolean,\n	recover: number,\n	-- What the opponent is doing, which is the entire read. `foeWind` runs 0-1 through\n	-- their wind-up and the strike lands at 1, so the tell the player is reacting to is\n	-- a bar filling rather than an animation they have to have seen before.\n	foeIntent: \"wait\" | \"close\" | \"wind\" | \"guard\" | \"recover\" | \"down\",\n	foeWind: number,\n	-- Whether the opponent is close enough to hit and be hit. Drives the \"break off to\n	-- recover\" read, since stamina comes back faster out here.\n	engaged: boolean,\n	-- The last exchange, in a word: \"Blocked\", \"Dodged\", \"Broke guard\", \"Whiffed\".\n	-- Carries its own good/bad rather than letting the client infer one from the\n	-- wording, for the same reason a person's reply does.\n	beat: string?,\n	beatGood: boolean,\n	-- Thresholds the power meter has to draw. Sent rather than read from Config on the\n	-- client because the meter is the only place the overcharge decision is visible,\n	-- and a client drawing the line from its own copy is a client that can disagree\n	-- with the server about where it was.\n	jabShare: number,\n	guardBreakShare: number,\n	overchargeShare: number,\n	-- Non-nil once the fight is decided: what to put on screen.\n	result: string?,\n	won: boolean,\n}\n\n-- A kind of fighter: one opponent personality, expressed entirely in timings.\n--\n-- This is the \"same input, different opponent\" requirement, and it is the reason the\n-- fight can survive a hundred repetitions on three buttons. Nothing here adds a move.\n-- What it changes is how long the tell lasts, how hard the answer hits and how often\n-- they choose to guard instead -- and those three numbers are enough to make a brawler\n-- and a scrapper want opposite play out of the identical control set. A player who has\n-- learned to sidestep a brawler will get hit doing it to a scrapper, and that is the\n-- knowledge the system is built to accumulate.\n--\n-- Each one carries its own body rather than a cast id. The people you fight are not\n-- drawn from the population you befriend, so pointing at content/Cast.luau would mean\n-- a street tough who might also be somebody's mother.\nexport type FighterDef = {\n	id: string,\n	-- The style, shown to the player during the fight. Worth naming for the same\n	-- reason the tell is worth drawing: you cannot learn a matchup you cannot identify.\n	name: string,\n	-- What to do about them, in a sentence. Shown on the square-up panel, so the first\n	-- one the player ever meets is not a guessing game, and printed by the debug\n	-- command. The activity law asks for a tutorial that is always there and free to\n	-- ignore; on a fight lasting twenty seconds this is the whole of it.\n	blurb: string,\n	body: CastMember,\n	ageYears: number,\n	-- Multiplier on the base footing pool. Above 1 is somebody who takes longer to put\n	-- down, which is not the same as somebody who hits harder and should not be used\n	-- as though it were.\n	-- Safe range: 0.8 .. 1.4.\n	footingScale: number,\n	-- How long their wind-up telegraphs before it lands. THE most important number in\n	-- the file: it is the reaction window, and every archetype is really a statement\n	-- about how much time the player gets to choose an answer.\n	-- Safe range: 0.45 .. 1.6.\n	windSeconds: number,\n	-- What their strike takes off the player's footing when it lands clean.\n	-- Safe range: 6 .. 22.\n	strikeFooting: number,\n	-- Their lockout after striking. This is the punish window the player is playing\n	-- for, and it is why the heaviest hitter has to be the slowest to recover.\n	-- Safe range: 0.3 .. 1.0.\n	recoverSeconds: number,\n	-- How often they answer with a guard instead of a wind-up, 0-1. A fighter who\n	-- guards is a fighter the player has to overcharge against, which is the only way\n	-- the overcharge risk becomes mandatory rather than optional.\n	-- Safe range: 0 .. 0.6.\n	guardChance: number,\n	-- How long they hold that guard before dropping it.\n	-- Safe range: 0.6 .. 2.0.\n	guardSeconds: number,\n	-- The beat between finishing one action and starting the next. Low is relentless.\n	-- Safe range: 0.15 .. 0.9.\n	restSeconds: number,\n	-- Set only on a rival gang enforcer; nil for the three plain street-tough archetypes.\n	-- Tags which gang's colors to tint the body with and which gang takes the standing\n	-- hit when this fighter loses.\n	gangId: string?,\n}\n\n-- One thing you can do with somebody: one row on the panel their dots open.\n--\n-- Shaped after EventChoice on purpose, because it is the same idea seen from the other\n-- end: a choice is the world asking you something, an offer is a person doing it. The\n-- fields that differ are the ones that only make sense when there is somebody there --\n-- what it does to the bond, and what they say back.\nexport type PersonOffer = {\n	id: string,\n	-- Written as the thing you are about to do, not as a question. You are picking it\n	-- off a short list while standing in front of the person it is about, so it reads\n	-- as the sentence you would say to them.\n	label: string,\n	-- The years this is on offer. What you do with your father at eight and at forty are\n	-- not the same thing, and a person whose offers never changed would be a person the\n	-- game had stopped writing.\n	minAge: number,\n	maxAge: number,\n	-- The bond this needs before it appears at all, and the whole reason a bond exists.\n	--\n	-- This is what makes a relationship visible without a number: the pads in front of\n	-- somebody who barely knows you are small talk, and the ones in front of somebody\n	-- who does are money, comfort and favours. The player never reads a stat -- they\n	-- watch the floor get more generous.\n	minBond: number,\n	-- What doing it does to how they feel about you. Usually positive, because turning\n	-- up is the point -- but not always, and an offer that costs you something with\n	-- somebody is the most interesting kind there is.\n	bond: number,\n	-- What it does to you, if anything. Nil for the many offers that are only about the\n	-- other person.\n	stats: StatDelta?,\n	-- Money they hand you. Nil rather than zero when none does, so \"no money involved\"\n	-- and \"gave you nothing\" are not the same value in the table.\n	--\n	-- Only ever positive, and the content file refuses anything else. Nobody you know\n	-- charges you for talking to them, and an offer that did would need a price and a\n	-- greyed-out row, neither of which a conversation should have.\n	money: number?,\n	-- What they say once it is done. Their voice, not the game's -- this is the only\n	-- writing in AGES that is a person talking to the player rather than the world\n	-- narrating at them, and it should sound like it.\n	line: string,\n	-- Whether this is a favour rather than a moment, and so whether it can be turned\n	-- down. Nil and false both mean it cannot.\n	--\n	-- Authored rather than derived from what the offer gives, because \"is this a thing\n	-- you are asking of somebody\" is a judgement about the sentence and not about its\n	-- payout. Asking your mother to sit with you is an ask; her telling you about her\n	-- day is not, and no rule about money or bond separates those two.\n	--\n	-- The odds themselves are not written here. They come off the gap between the\n	-- bond and this offer's own minBond -- see Config.People.RefuseAtFloor -- so an\n	-- ask is riskiest the year it first appears and safe once somebody has warmed to\n	-- you, without an author having to keep a second set of numbers in step.\n	ask: boolean?,\n	-- What they say when they say no. Required on an ask and refused on anything else,\n	-- because a refusal in the game's own voice would break the one rule `line` holds:\n	-- the words a person says are theirs. \"Not this month, love\" is a character; \"the\n	-- offer was declined\" is a system.\n	refusedLine: string?,\n	-- What must and must not be true of the life for this to be on the floor. Ids from\n	-- content/Flags.luau; unknown ones are refused at load.\n	--\n	-- The finer-grained half of gating a person: somebody who is in every life, but who\n	-- has something to say to you that they have to no one else, because of something\n	-- you did. A shared history is mostly this rather than a whole extra person.\n	requires: { string }?,\n	forbids: { string }?,\n	-- What doing this makes permanently true about the life. Same field, same ids and\n	-- same rules as on EventChoice, because it is the same idea: a decision the player\n	-- made, remembered.\n	--\n	-- The reason it exists here at all is that without it an offer could move a bond and\n	-- hand money over and still leave nothing about the life different -- so there was no\n	-- way to write a person whose later years know what you did with them in the earlier\n	-- ones. Setting and clearing the same flag in one offer is refused at load.\n	--\n	-- Only ever applied on a yes. An ask that was turned down did not happen, and a\n	-- refusal that quietly wrote a flag would be the game recording something the player\n	-- watched not occur.\n	sets: { string }?,\n	clears: { string }?,\n	-- What this person becomes to you: a tie id from content/Ties.luau, refused at load\n	-- if unknown.\n	--\n	-- The other half of the same gap, and it is its own field rather than a flag because\n	-- a flag is a fact about the *life* and this is a fact about the two of you. Most of\n	-- the people in AGES are generated -- the town is thirty ids nobody typed -- so \"you\n	-- are close to this one\" cannot be a declared flag id without declaring thirty of\n	-- them, and the moment Config.Town.Count moved it would need thirty-one.\n	--\n	-- Nil on the great majority of offers. Becoming somebody's friend should be a handful\n	-- of rungs in a life, not something that happens on every row of every panel.\n	gives: string?,\n	-- What they have to already be to you for this to be on the panel. Satisfied by that\n	-- tie or any closer one, so an offer written for a friend is not hidden from a best\n	-- friend -- rungs, not slots.\n	--\n	-- This is what makes a friendship worth having rather than a word on a nameplate:\n	-- there are things people will only do for somebody they are actually close to, and\n	-- this is where that gets said.\n	needsTie: string?,\n	-- The most the offer appears at, as an upper bound on the bond. The inverse of\n	-- minBond and the second half of the gate: minBond says \"you need to be at least\n	-- this close\" and maxBond says \"and no closer than this either\". Nil means no\n	-- ceiling, which is every friendly offer there is.\n	--\n	-- Its only use is the offers for when a relationship has gone cold -- the snub,\n	-- the argument, the cold shoulder -- that would read as bugs if they appeared\n	-- while somebody still liked you. They gate on being low, and the repair offer\n	-- gates on being low too, so a relationship can be actively damaged and then\n	-- actively mended on the same floor.\n	maxBond: number?,\n	-- What this doing is, when the answer is a walk rather than a talk.\n	--\n	-- `walksTo` is the id of a place the two of you go to together -- see\n	-- Config.Places.Walkable for which ids are legal -- and setting it changes what\n	-- accepting does: the person sets off with you, walks behind you along your path,\n	-- and says `arrivalLine` when the place is reached. The walk is the content, so a\n	-- companion offer carries no stats or money.\n	walksTo: string?,\n	arrivalLine: string?,\n}\n\n-- A kind of relationship somebody can be to you: content, like a flag.\n--\n-- Kept small on purpose. These are the words a life uses about people, and a game with\n-- eleven grades of friendship has replaced a relationship with a progress bar -- which is\n-- the exact thing bonds are hidden for.\nexport type TieDef = {\n	id: string,\n	-- What goes on their nameplate, lowercase, as you would say it: \"friend\".\n	label: string,\n	-- How close this is. Higher is closer, and a tie is only ever replaced by a closer\n	-- one -- there is no offer anywhere that walks somebody back down, because the way a\n	-- friendship ends in this game is that you stop turning up and the bond decays.\n	rank: number,\n	-- How many people can be this to you at once, or nil for no limit.\n	--\n	-- The whole reason a top rung is worth reaching. Without a limit, \"best friend\" is\n	-- something you collect from everybody who ever hit the bond for it, and the word\n	-- stops meaning anything. Counted against people *currently in your life*, so a best\n	-- friend at school whose years have passed does not hold the slot shut against one\n	-- at work.\n	limit: number?,\n}\n\n-- One rung of the gang ladder.\n--\n-- Shaped like TieDef above and for the same reasons -- an id, a label you would say out\n-- loud, and a threshold -- but the threshold here means something narrower than it looks.\n-- `standing` is what the rung costs to be *offered*, never what awards it. The rung\n-- itself is handed over by a person, off a panel, in a moment the player chose to walk\n-- into. See the header of Config.Gangs for why that distinction is load-bearing.\nexport type GangRankDef = {\n	id: string,\n	-- What goes under your name, lowercase, as somebody would say it: \"who calls it\".\n	label: string,\n	-- Standing at which the boss will offer this rung. Ascending across the ladder, and\n	-- the first rung is 0 because joining is itself the thing that earned it.\n	standing: number,\n	-- Whether holding this rung anywhere bars you from holding it elsewhere. Only the top\n	-- rung sets it, and it is the same device as TieDef.limit: a rung nobody has to choose\n	-- between is a rung that costs nothing to reach.\n	oneGangOnly: boolean?,\n}\n\n-- One of the four gangs. Content: who they are, what color they wear, and where to find\n-- the person who can let you in.\nexport type GangDef = {\n	id: string,\n	-- What players call them. Shown on nameplates and in the panel, so it has to survive\n	-- being read at a glance across a street.\n	name: string,\n	-- The band on every member's head, and the single most important field here. It has to\n	-- be identifiable at fifty studs against asphalt, grass and brick, which is why all\n	-- four are saturated and none of them are close to each other on the wheel.\n	color: Color3,\n	-- Which side of the city they hold. Not read by anything yet -- territory is deferred\n	-- until the map expansion -- but written now because inventing it later would mean\n	-- re-deciding four gangs' identities against streets that already exist.\n	side: string,\n	-- The place point where the person who runs them stands, and the castId of that\n	-- person. Split the same way Person splits placeId from castId, so moving a boss is a\n	-- content edit and not a rebuild.\n	bossPlaceId: string,\n	bossCastId: string,\n	-- One line, in their own voice, shown on the panel that offers to let you in. This is\n	-- the only characterisation four gangs get in part one, so it has to do the work of\n	-- telling them apart beyond the color.\n	pitch: string,\n}\n\n-- One thing worth drawing on the map. `u` and `v` are already normalized to 0..1\n-- across the map's bounds by the server, so the client never has to hold the world's\n-- coordinates or know how big the world is -- it draws into a unit square.\nexport type MapIcon = {\n	id: string,\n	label: string,\n	u: number,\n	v: number,\n}\n\n-- A gang's side, as the map needs it: the color to wash it in and where its boss\n-- stands. The region has no outline because it has no polygon -- a side is the ground\n-- nearest this point, so the client samples rather than traces. See Shared/WorldMap.\nexport type MapRegion = {\n	id: string,\n	name: string,\n	color: Color3,\n	u: number,\n	v: number,\n}\n\n-- Everything static about the map, sent once on join. None of it changes while the\n-- server is up, so it is deliberately not on the tick that sends TerritoryState.\nexport type MapData = {\n	minX: number,\n	maxX: number,\n	minZ: number,\n	maxZ: number,\n	icons: { MapIcon },\n	regions: { MapRegion },\n}\n\n-- Where the player is standing, in gang terms. `depthStuds` is distance in from the\n-- nearest border, not distance from the boss: it is what says whether you are deep in\n-- somebody's side or loitering on the line between two.\nexport type TerritoryState = {\n	regionId: string?,\n	depthStuds: number,\n	-- Whether a trip into a rival side is currently open, and the deepest it has got.\n	-- The award is computed from the deepest point and never from elapsed time, so this\n	-- is the number the HUD should show rising -- it is the only one that pays.\n	onIncursion: boolean,\n	deepestStuds: number,\n}\n\n-- One discipline, as the menu draws it. Everything here is resolved server-side --\n-- the level, its name, and where the next rung sits -- because the client having its\n-- own copy of the ladder is how a bar ends up disagreeing with the number beside it.\nexport type SkillState = {\n	id: string,\n	label: string,\n	earnedBy: string,\n	color: Color3,\n	level: number,\n	levelName: string,\n	xp: number,\n	-- Where this level started and where the next one begins, so the bar can be drawn\n	-- as a fraction without the client knowing the curve. Nil at the cap, which is\n	-- what tells the panel to draw a full bar and no \"next\" caption rather than\n	-- dividing by a threshold that does not exist.\n	bandFloorXp: number,\n	nextLevelXp: number?,\n}\n\n-- Every discipline, in Config order, pushed whole. Small enough that a delta would\n-- cost more to reason about than it saves: six rows of six numbers.\nexport type SkillsState = {\n	skills: { SkillState },\n}\n\n-- One preference, as the settings pane draws it. The label and both captions come down\n-- from the server rather than being written into the pane, for the same reason the skill\n-- ladder does: the server is the end that decides what a setting *is*, and a client with\n-- its own copy of the wording is a client that can disagree with the save about what the\n-- player just turned on.\nexport type SettingState = {\n	id: string,\n	label: string,\n	-- What is true right now, in the player's words. One caption per state rather than one\n	-- caption plus an \"On\"/\"Off\" figure, because \"Money popups: Off\" tells a player what the\n	-- switch is called and nothing about what turning it back on would do for them.\n	caption: string,\n	on: boolean,\n}\n\n-- Every preference, in Config order, pushed whole and pushed by the server even for the\n-- ones only the client acts on.\n--\n-- Server-authoritative on purpose, and it is worth saying why for a screen full of things\n-- that are visibly client-side. A setting has to survive a rejoin, and the only thing in\n-- this game that survives a rejoin is the profile. Once the profile owns it, the client\n-- holding an optimistic copy buys nothing and costs a class of bug -- a toggle that looks\n-- flipped, does not save, and comes back the other way an hour later with no event in\n-- between to blame. So the client draws what it was pushed and never what it clicked.\nexport type SettingsState = {\n	settings: { SettingState },\n}\n\n-- One code this account has already used. Kept and shown rather than merely counted: the\n-- pane is the only record a player has of what a code gave them, and a redeemed-codes list\n-- that says \"3 redeemed\" is a receipt with the amount torn off.\nexport type RedeemedCode = {\n	id: string,\n	code: string,\n	label: string,\n	-- What it paid, already written out -- \"$500\", \"2 spins\". Composed server-side because\n	-- the reward shapes live in content, and a client that formatted them would have to be\n	-- taught every new shape before a code using one could ship.\n	reward: string,\n}\n\nexport type CodesState = {\n	redeemed: { RedeemedCode },\n}\n\n-- The answer to one attempt at the box. Always sent, including for a code that worked,\n-- because a text box that says nothing back on success is a text box the player types\n-- into twice.\nexport type CodeResult = {\n	ok: boolean,\n	message: string,\n}\n\n-- One person who runs with you. Nothing here says what they do on a job: a role is\n-- something a crew member is sent to hold for the length of one robbery (BankService's\n-- `Room.crewHelperCrewId`), not a fact about them, so it is not a field on this type --\n-- the same \"goes in beside `nerve` the day something assigns one\" reasoning still\n-- applies to anything that *would* be a lasting fact about a member, like a specialty.\nexport type GangCrewMember = {\n	-- Unique for the life of this crew slot, not for the life of the account -- a\n	-- dismissed member's id is never reissued, so a client holding a stale reference\n	-- from the push before a dismissal cannot address somebody who is now a stranger.\n	id: string,\n	name: string,\n	-- 0-100, and it only ever rises. See Config.Gangs.Crew.NerveGainPerPoint: the same\n	-- \"positives ratchet, nothing decays\" rule Ties.luau and the bond ladder already\n	-- keep, applied to a crew instead of a friendship. A member who has never worked\n	-- with you starts low and gets steadier the more you pull together, and nothing\n	-- about a quiet week ever costs them ground they already made.\n	nerve: number,\n}\n\n-- What the client draws about the gang you are in, or nil when you are in none.\nexport type GangState = {\n	gangId: string,\n	name: string,\n	color: Color3,\n	-- The rung you hold, and the one above it, already resolved to labels so the panel\n	-- never has to know the ladder. `nextLabel` is nil at the top.\n	rankId: string,\n	rankLabel: string,\n	nextLabel: string?,\n	-- Standing you have, and what the next rung is offered at. Both raw so the panel can\n	-- draw a bar without a second opinion about what full means. `nextStanding` is nil at\n	-- the top, which is how the panel knows to draw the bar as done rather than as empty.\n	standing: number,\n	nextStanding: number?,\n	-- Whether the boss would hand you the next rung right now. Not the same as\n	-- `standing >= nextStanding`: the top rung also asks that you hold it nowhere else.\n	-- The panel says \"go and see them\", so this has to be the server's whole answer.\n	promotable: boolean,\n	-- Whether the colors are currently on your head. False after you take them off, which\n	-- is a thing you would do on purpose and which the panel must not quietly hide.\n	wearing: boolean,\n	-- Who runs with you, and how many of them there could be at your current rung. Empty\n	-- and zero for the two lower rungs on purpose: \"hanger-on\" and \"hand\" are the rungs\n	-- where somebody else's plan has a slot with *your* name in it, not the other way\n	-- round, so a crew section would be promising a feature those two rungs do not have.\n	crew: { GangCrewMember },\n	crewSlots: number,\n	-- One line of feedback, cleared after it has been shown. Same device as the notices on\n	-- TheftState and BankState.\n	notice: string?,\n}\n\n-- What the boss standing in front of you is saying, and what you can say back.\n--\n-- Deliberately shaped like the person-chat payload rather than like GangState: this is a\n-- conversation, it lasts as long as you stand there, and it is nil the moment you walk\n-- away. `offers` reuses OfferedChoice so the client draws it with the panel it already\n-- has -- a gang boss is a person with a list, and inventing a second list widget for one\n-- would be two widgets to keep in step.\nexport type GangPanel = {\n	gangId: string,\n	name: string,\n	color: Color3,\n	-- Who is talking, so the panel has a name at the top like every other conversation.\n	bossName: string,\n	-- What they say right now: the pitch if you are a stranger, something about your\n	-- standing if you are theirs, something short if you are a rival's.\n	reply: string,\n	-- Whether that line is good news, for the same reason a person's chat carries it: the\n	-- panel tints on it, and having the client guess from the wording would mean the tint\n	-- disagreed with the sentence the first time somebody rewrote a line.\n	replyGood: boolean,\n	offers: { OfferedChoice },\n}\n\n-- Somebody who exists in your life. Content, like a job: who they are, where they\n-- stand, when they are around, and what they are willing to do for you.\n--\n-- `castId` points into content/Cast.luau rather than repeating a body here, so the\n-- neighbor you visit at nine is built from the same description as the neighbor who\n-- knocks at forty and is recognisably the same man.\nexport type Person = {\n	id: string,\n	castId: string,\n	-- Which place point they stand at. Deliberately reuses the ids the world already\n	-- needs -- home, school, store -- because every new id is a part somebody has to\n	-- remember to tag in Studio, and a person who silently does not exist is worse than\n	-- a person who shares a room.\n	placeId: string,\n	-- The years they are in your life at all. Outside these they are not spawned, they\n	-- are not decayed against, and they are not in the listing: a friend you meet at six\n	-- is not somebody you were neglecting at four.\n	minAge: number,\n	maxAge: number,\n	-- How many years older than the player they are. Their age, written as the one thing\n	-- about it that never changes.\n	--\n	-- Stored this way rather than as a number of years because there is no clock in this\n	-- game except the player's birthdays -- a life is the only thing time happens to --\n	-- so an absolute age would be a figure that had to be nudged forward by hand every\n	-- year and would be wrong the moment anything forgot to. A gap between two birth\n	-- years is simply true forever, and it says the interesting thing directly: your\n	-- mother is twenty-eight years older than you at every age either of you ever is.\n	--\n	-- Negative for anybody younger. Zero is somebody your own age, which is what a\n	-- schoolfriend is.\n	ageOffset: number,\n	-- Where the bond starts the first time anything moves it. A parent does not begin\n	-- indifferent; a neighbor does.\n	startingBond: number,\n	-- How they turn you away once they have given you their time this year. Their own\n	-- sentence rather than a shared one, because \"Not now, love, I'm cooking\" and \"Some\n	-- other time\" are the same rule said by two different people, and the rule is the\n	-- least interesting thing about it.\n	busyLine: string,\n	-- What must and must not be true of the life for this person to be in it. Ids from\n	-- content/Flags.luau; unknown ones are refused at load.\n	--\n	-- The answer to \"if I make a decision for a friend then there should be a friend\n	-- for me at school\". A gated person is not spawned, not decayed against and not\n	-- listed, exactly as if their years had not come round yet -- so a life that never\n	-- earned them is not a life that is missing them, it is a life they were never in.\n	--\n	-- Use it sparingly and never on family. A mother who exists conditionally is not a\n	-- branch, she is a bug that looks like one.\n	requires: { string }?,\n	forbids: { string }?,\n	offers: { PersonOffer },\n	-- Contextual dialogue lines keyed by situation. Picked when the person is near\n	-- the player and none of the offer panel is open. Nil means no extra lines.\n	contextualLines: { [string]: { string } }?,\n	-- How this person leads into a memory, in their own voice -- \"You remember,\n	-- love --\" for a mother, \"I still think about --\" for a father. Combined with\n	-- the strongest thing they have ever said to the player (LifeData.definingMoment)\n	-- to make the hidden 5+1 interaction buffer visible on the same line contextualLines\n	-- already uses, rather than adding a second row nobody but a debug command reads.\n	-- Nil means this person never calls a memory back, which is the honest default for\n	-- a stranger the game only just generated.\n	memoryIntro: string?,\n}\n\n-- The person in front of the player, pushed to the HUD. Nil means nobody is, which is\n-- most of a life.\n--\n-- Carries what they have to offer, for the same reason a lesson carries its answers:\n-- the panel that opens when the player clicks the dots over their head is built from\n-- this, so it opens the instant it is asked for rather than after a round trip.\nexport type PersonState = {\n	-- Which person this is, so an answer coming back can be checked against who the\n	-- player is actually standing next to. Never trusted on its own.\n	id: string,\n	-- Their name as it is written over their head, so the row and the body agree.\n	name: string,\n	-- What the bond is called, from People.Bands. A phrase and never the number: the\n	-- player should know their father is close to them without being shown a score for\n	-- it, which would turn a relationship into a progress bar.\n	band: string,\n	-- What this person is to you beyond the bond ladder: a tie id label from Ties,\n	-- or nil when they are just somebody you know. Shown on the row alongside the\n	-- name so the player can tell at a glance whether the person standing next to\n	-- them is a friend, a rival, or a stranger.\n	tie: string?,\n	-- Set for the beat after an offer is taken, holding what they said back. Nil the\n	-- rest of the time, when the row is only announcing who you are standing next to.\n	reply: string?,\n	-- Whether that reply was a good one, for the colour of it. Meaningless while `reply`\n	-- is nil. A refusal at the door -- somebody who has no time this year -- comes\n	-- through as a reply that is not good, which is the honest reading of it.\n	replyGood: boolean,\n	-- What is on the panel when the player clicks them. Empty for somebody who has\n	-- already given you their time this year, and that emptiness is what quiets the\n	-- dots over their head: still worth walking up to, nothing left to take.\n	offers: { OfferedChoice },\n	-- Whether this is a phone call rather than standing next to them. A phone call\n	-- opens the same panel in the PhoneCall voice, and the row saying who you are\n	-- standing next to does not appear for one, because you are not next to them.\n	contact: boolean,\n	-- A contextual line picked from the person's archetype, shown when no offer\n	-- panel is open. Nil when there is no contextual line for the current situation.\n	contextualLine: string?,\n}\n\n-- The people the player has met, as a list the HUD can render as a tappable roster\n-- without querying the server. Sent whole on every change (birthday, flag move, offer\n-- taken) for the same reason LobbySlotsUpdated is: a per-row push could land out of\n-- order and leave a stale row. The player never types into this list -- they only tap\n-- a row -- so there is nothing on this wire worth forging.\nexport type PersonRosterEntry = {\n	id: string,\n	name: string,\n	-- The bond's name, from People.Bands, the same phrase the in-person row uses.\n	band: string,\n	-- What this person is to you beyond the bond ladder: a tie id label from Ties,\n	-- or nil when they are just somebody you know. Shown alongside the name so the\n	-- player can tell at a glance which row is their mentor, which is their rival.\n	tie: string?,\n	-- Whether calling is worth it this year: a visit not spent and something left to\n	-- offer. What the dot next to a row means.\n	available: boolean,\n}\n\n-- How many times one person has been visited, and which year those visits belong to.\n--\n-- One record rather than a `visitsThisYear` and a separate `lastSeen`, because the two\n-- are always written in the same breath and two independent fields holding halves of one\n-- fact eventually disagree. The year is carried alongside the count instead of the count\n-- being cleared on every birthday: a person nobody went to see never needs touching, so\n-- an old year simply reads as nought visits when it is next looked at.\nexport type PersonVisits = {\n	-- The age the player was when these visits happened.\n	age: number,\n	-- How many of them, against Config.People.VisitsPerYear.\n	count: number,\n}\n\n-- A named somewhere in the world, resolved from the part that marks it rather\n-- than from a table of coordinates. `part` is the marker, so `part.Position` is\n-- the floor at that spot and is correct however far the building has been moved\n-- since the id was written down.\n--\n-- `label` is the sentence a listing prints (\"the shop floor\"), and is separate\n-- from the id for the same reason an event's title is separate from its id: one\n-- of them is shown to a person and one of them is matched against.\nexport type Place = {\n	id: string,\n	label: string,\n	part: BasePart,\n}\n\n-- What putting the subject in the room actually produced: the animal itself, or nil\n-- when nothing was staged.\n--\n-- It used to also carry the point the animal would come to rest on, because floor\n-- markers had to be laid out around a spot before the animal reached it. The dots\n-- ride the model instead, so what a caller needs is the thing rather than the place\n-- -- and the thing stays true continuously, while the place was only ever true at\n-- the moment the prompt opened.\nexport type StagedSubject = Model\n\n-- What the thing the event is about does once the choice has been made, before it\n-- leaves. Only meaningful for an event with a subject in the room.\n--\n--   approach  comes to the player and stands with them\n--   withdraw  turns away and goes, without a last look\n--   settle    lies down where it is\n--\n-- The outcome line is the reason this exists. \"It shoved its whole head under your\n-- palm\" and \"you held still until it lost interest\" are two different things\n-- happening in the room, and until now they were the same thing happening on a\n-- banner over an animal that stood there either way. A choice whose consequence\n-- can be watched should be watched.\n--\n-- A relationship rather than a clip name: content says what happened and SceneService\n-- decides what that looks like. It is also what keeps a bought model a drop-in --\n-- \"approach\" is a route either way, and \"settle\" is a folded pose here or a Rest clip\n-- there.\n--\n-- Nil is the ordinary answer and means what it always meant: the animal holds\n-- where it is while the outcome is read, and then leaves the way it came.\nexport type ChoiceReaction = \"approach\" | \"withdraw\" | \"settle\"\n\n-- A teacher gesture on a right answer, overriding the default bow. \"settle\" is a\n-- calm nod for questions that are merely correct; \"approach\" is a step toward the\n-- player for the ones that were genuinely earned. Wrong answers always step back\n-- regardless.\nexport type LessonReaction = \"settle\" | \"approach\"\n\nexport type EventChoice = {\n	id: string,\n	label: string,\n	-- Shown after the choice is made. Second person, past tense.\n	outcome: string,\n	effects: StatDelta,\n	-- All or nothing across an event's choices, enforced at content load: three\n	-- answers where one makes the dog do something and the other two leave it\n	-- standing reads as two answers that failed rather than as one that was special.\n	reaction: ChoiceReaction?,\n	-- What taking this answer costs, in whole currency units. Nil means free, which\n	-- is true of nearly every choice in the game.\n	--\n	-- A separate field from `effects` rather than a fifth stat, because money does\n	-- not behave like one: a stat is clamped to 0-100 and decays on its own, and\n	-- money is unbounded, exact, and only ever moves because something happened. A\n	-- choice with a cost the player cannot meet is offered but refused -- see\n	-- OfferedChoice.locked -- so a price is a gate as well as a number.\n	cost: number?,\n	-- What taking it pays. Withheld from the client until the choice is made, unlike\n	-- cost, and the asymmetry is deliberate: you cannot decide whether to spend\n	-- without being told the price, but being told in advance which answer pays best\n	-- turns a life decision into an arithmetic one. Same reason the outcome line and\n	-- the stat effects are withheld.\n	payout: number?,\n	-- What taking this answer does to your record at the job you are working. Whole\n	-- units, either direction, and zero is a legal and useful value: an answer your\n	-- employer would have no opinion about is a real kind of answer.\n	--\n	-- All or nothing across an event's choices, and required on every Shift event,\n	-- both enforced at content load. Required because a record is the whole reason a\n	-- shift has moments in it -- a work event whose answers left no trace would be a\n	-- moment your job did not notice, which is exactly what these replaced.\n	--\n	-- Withheld from the client alongside the outcome and the effects. Being told\n	-- which answer your manager would prefer, before you choose, is the same\n	-- arithmetic problem as being told which one pays best.\n	performance: number?,\n	-- What taking this answer makes permanently true about the life, and what it\n	-- makes untrue again. Ids from content/Flags.luau; unknown ones are refused at\n	-- load.\n	--\n	-- This and PersonOffer.sets are the only two ways a flag is ever earned, and they\n	-- are the same way seen from two ends: an answer the player gave. Deliberately no\n	-- third -- a flag written by a service somewhere would be a fact about the player\n	-- that no decision of theirs is responsible for, and the whole value of the system\n	-- is that every one of them can be traced back to a moment they remember.\n	--\n	-- `clears` exists for the pairs that are genuinely exclusive -- you cannot both\n	-- have been frightened of the dog and not have been -- rather than as a general\n	-- undo. Setting and clearing the same flag in one choice is refused at load.\n	sets: { string }?,\n	clears: { string }?,\n	-- The thing you physically do to give this answer, instead of clicking a row.\n	-- Nil means this choice is a row on a panel, which is still true of most of the\n	-- game. All or nothing across an event's choices, enforced at content load: two\n	-- answers you perform and one you click reads as a bug in the two, not as a\n	-- third option.\n	act: ChoiceAct?,\n}\n\n-- How a choice is performed, when performing it is the point.\n--\n-- Five verbs, and the list is short on purpose. They were not invented and then\n-- looked for -- they were read off the sixty-six childhood answers that already\n-- existed, and these are what those answers turned out to be. A sixth would mean\n-- a new kind of thing a body can do, which is a real addition; a sixth that only\n-- one event uses is a bespoke minigame wearing the costume of a system.\n--\n--   Go     -- get yourself there. Into the puddle, up the stairs, through the gap.\n--   Take   -- put your hands on it, and that is the answer. The spoon, the cookie.\n--   Carry  -- Take, and then bring it somewhere. Grabbing commits you to nothing;\n--            arriving is the answer, so you can pick the cookie up and still be\n--            deciding who gets it. The only verb with two halves, and the reason\n--            is that changing your mind halfway is a thing children do.\n--   Push   -- put your body against it and move it. The rug.\n--   Stay   -- be still and let it happen. The one answer that is not an action,\n--            which is why it needs a verb of its own: without one it would be\n--            indistinguishable from a player who has not decided yet.\nexport type PropVerb = \"Go\" | \"Take\" | \"Carry\" | \"Push\" | \"Stay\"\n\n-- One prop and where it goes, measured from the player at the moment the event\n-- opens: how far away, and how far round from the direction the set was laid out in.\n--\n-- Authored rather than scattered, because distance is meaning here. The rug in\n-- \"across the rug\" has to be between the child and the bright thing, and it is\n-- between them because it was written at seven studs and the toy at sixteen on the\n-- same bearing. A placement that fanned them at random would be the same three\n-- objects and a different event.\n--\n-- Both numbers are wishes and the room has the veto. A spot inside a wall slides\n-- round the arc until it isn't one, and a set that cannot fit at all gives up and\n-- becomes a panel. See PropService.\nexport type PropPlacement = {\n	-- An id from content/Props.luau. Unknown ones are refused at load.\n	prop: string,\n	distance: number?,\n	offsetDegrees: number?,\n}\n\nexport type ChoiceAct = {\n	verb: PropVerb,\n	-- The thing this answer is given on: the rug you push, the toy you crawl to, the\n	-- cookie you pick up. Nil is legal only for Stay, whose answer is given where the\n	-- player already is -- so its label floats over their own head instead of over an\n	-- object.\n	--\n	-- Two acts in one event may name the same prop here only when both are Carry,\n	-- because a Carry is the one verb whose answer is not given by touching this. Any\n	-- other overlap is refused at load: two answers triggered by the same touch means\n	-- the event resolves as whichever the loop happened to check first.\n	at: PropPlacement?,\n	-- Carry only, and required for it: where this one has to be brought. Refused at\n	-- load on any other verb, because a destination for something you were never\n	-- going to pick up is a line nobody will read again.\n	to: PropPlacement?,\n}\n\n-- What a prop looks like, in the same spirit as SceneSubject and for the same\n-- reason: plain dimensions and two colors, no asset ids, so the rug is a rug on\n-- the day it is written rather than on the day somebody models one.\n--\n-- Deliberately not merged with SceneSubject even though the fields rhyme. A\n-- subject walks in, holds a stance and reacts to what you decided; a prop is\n-- furniture you do something to. Sharing a type would have given the cookie a\n-- walk speed.\n-- Figure is the one that is not a primitive: a body and a head, in the two colors,\n-- at whatever size the prop declares. It exists because \"give the cookie to the\n-- other child\" is an instruction that means nothing when it is pointed at a cube,\n-- and because a child in a sandbox is not worth the avatar machinery a CastMember\n-- brings with it -- nobody talks to them, they have no name over their head, and\n-- they are gone when the year is.\nexport type PropShape = \"Block\" | \"Ball\" | \"Cylinder\" | \"Figure\"\n\nexport type PropKind = {\n	id: string,\n	-- Never shown. What the warnings and the Studio harness call it.\n	name: string,\n	shape: PropShape,\n	size: Vector3,\n	color: Color3,\n	accentColor: Color3,\n	-- How close counts as having reached it. Bigger than it looks for anything a\n	-- body is meant to end up *on* rather than next to -- a puddle you are standing\n	-- in the middle of, a rug you are halfway across.\n	reachStuds: number,\n	-- How high above the floor it sits, in studs, measured to its underside. Zero\n	-- for anything lying on the ground. Nonzero for a thing at hand height, which is\n	-- the difference between a cookie on a plate and a cookie on the carpet.\n	liftStuds: number,\n}\n\nexport type LifeEvent = {\n	id: string,\n	minAge: number,\n	maxAge: number,\n	delivery: EventDelivery,\n	prompt: string,\n	choices: { EventChoice },\n	-- How the player answers. Nil means \"Panel\", so an event written before\n	-- enactment existed keeps behaving exactly as it did.\n	resolution: EventResolution?,\n	-- Relative selection weight among eligible events. Defaults to 1.\n	weight: number?,\n	-- For NPCApproach events, which member of the cast turns up. Ignored by every\n	-- other delivery. Nil is allowed and falls back to the first cast member, so\n	-- writing a visitor event is never blocked on casting it -- but an id that\n	-- doesn't exist is a content error and throws at start.\n	cast: string?,\n	-- What the prompt is about, if it is about something you can see. Independent\n	-- of delivery and of resolution: the dog turns up whether the event reached you\n	-- on a birthday or off a doormat, and whether you answer it on a panel or by\n	-- walking. Nil means the event is about nothing in particular, which is true of\n	-- most of them -- there is no prop for \"you have learned a word that stops\n	-- adults where they stand\".\n	--\n	-- Like Enacted, this is always a *request*. A room with nowhere to put the\n	-- subject simply doesn't get one, and the event plays exactly as it did before\n	-- subjects existed. It must never be the reason a prompt cannot be answered.\n	subject: string?,\n	-- What is written over the thing the player walks to, for a Wander event. Read\n	-- from across the room and from behind, so it is the reason to go rather than\n	-- the prompt: \"Something is moving under the table\", not \"A cat has got in\".\n	--\n	-- Ignored by every other delivery, because nothing else puts a nameless object\n	-- on the floor -- a letter is a letter and says so by being one.\n	--\n	-- Nil falls back to a generic line rather than an empty label. An unauthored\n	-- lure should read as plain, never as a blank pad the player cannot tell is\n	-- interactive at all.\n	lure: string?,\n	-- Whether this event may be lived more than once in a life. Nil means no, which\n	-- is right for nearly everything: the day you were offered a dog happened once.\n	--\n	-- It exists for work. A career is hundreds of shifts and there will never be\n	-- hundreds of authored moments, so without this every shift past the last unseen\n	-- event is silent forever -- and a job that stopped having anything happen in it\n	-- is a job that went back to being a timer. Selection always prefers something\n	-- unseen and only falls back to these once nothing new is left, so a repeatable\n	-- event never crowds out a fresh one.\n	--\n	-- Author it on texture, not on milestones. A quiet hour with nobody in the shop\n	-- happens a hundred times in a working life; being handed your first set of keys\n	-- happens once.\n	repeatable: boolean?,\n	-- What must and must not already be true of the life for this to be offered at\n	-- all. Ids from content/Flags.luau; unknown ones are refused at load.\n	--\n	-- This is branching. An event that requires a flag is a piece of the game that\n	-- only some lives contain, and the reason a life contains it is a decision its\n	-- owner made and can name. Age already gates *when* something can happen; this\n	-- gates *whether*, which is the difference between a life with a shape and a\n	-- life with a schedule.\n	--\n	-- Requires is all of them, never any. Two ids together are one condition with two\n	-- halves; alternatives are written as two events, which is also how they get to\n	-- have two different sets of words.\n	requires: { string }?,\n	forbids: { string }?,\n	-- For Shift events only: WorkService's moment picker is the one thing that\n	-- reads these. `minStanding` is a floor on the player's standing at the job\n	-- they are working, so a moment can be the thing the ladder unlocks rather\n	-- than a label the ladder wears; `jobs` is the list of jobs the moment may\n	-- fire on, nil meaning any. Both are ignored by every other delivery, and a\n	-- gate that cannot be met just means the event never fires.\n	minStanding: number?,\n	jobs: { string }?,\n\n	-- Loose category tags, for picking pools (\"a rival is reading me\" — vs.\n	-- \"the room I'm in has gotten too small\"). Strings, not enums, because the\n	-- tag set grows as content grows and a closed enum turns every new tag into\n	-- a release. Unknown tags are allowed at load: they cannot fail, because\n	-- nobody reads them except the picker, which is the only place that asks\n	-- what tags exist.\n	tags: { string }?,\n\n	-- Real seconds between *deliveries*, not between *fires*. A cooldown is on\n	-- the delivery path: a wandering event with cooldown 60 will not put a lure\n	-- down twice within a minute of itself, so the room is never littered with\n	-- copies of the same lure. Nil means 0. Per-life, not global: a second\n	-- player is on their own clock.\n	cooldown: number?,\n\n	-- The id of the follow-up that comes from this one, if anything. The chain\n	-- is read by the picker, not by content: a chained event fires *because*\n	-- the prior one was answered, so the player can trace the thread. Nil means\n	-- \"nothing follows\". An escalatesTo that does not exist as an event id is a\n	-- load error -- a chain to nothing is the worst kind of dead writing.\n	escalatesTo: string?,\n\n	-- What the event writes to, in plain words. The mandatory-stat-or-it-does-\n	-- not-ship rule from the design. Authored as the list of things the event\n	-- actually changes (stat names, flag ids, ribbon conditions, tie names) so\n	-- a missing one is caught at load, not at runtime. The list is also the\n	-- picker hint for \"this event leaves a mark\": chained events read it to\n	-- know what the prior event left behind.\n	writesBack: { string }?,\n}\n\n-- One choice as the client is allowed to see it: the words, the price, and the\n-- server's verdict on whether it may be taken.\n--\n-- `locked` is sent rather than worked out on the client, even though the client\n-- knows both the price and the balance and could subtract them itself. Two reasons.\n-- The rule about who may spend what belongs on the server, and a client that\n-- derives it locally is a second implementation of that rule that can disagree.\n-- And a choice locked for some reason other than money -- there will be others --\n-- then needs no new field and no new client arithmetic.\nexport type OfferedChoice = {\n	id: string,\n	label: string,\n	-- What taking it costs, for display. Nil for the overwhelming majority.\n	cost: number?,\n	-- A short phrase in the same right-hand column a price uses, for a row that has\n	-- something to say about itself that is not a figure -- today, the odds on an ask\n	-- being refused, in words. Nil for almost every row, and never set together with\n	-- `cost`: one column, one thing in it.\n	--\n	-- Words rather than a number on purpose. The player is deciding whether to spend\n	-- their one visit this year on a maybe, and that is a judgement about somebody\n	-- they know rather than a sum.\n	note: string?,\n	-- Presentation only. The server checks affordability again when the answer\n	-- arrives, so a client that ignores this gets refused rather than obeyed.\n	locked: boolean,\n}\n\n-- What the client is told about an offered event. Effects and outcome lines are\n-- withheld until a choice is made, so the answer can't be read off the payload.\nexport type OfferedEvent = {\n	id: string,\n	delivery: EventDelivery,\n	prompt: string,\n	choices: { OfferedChoice },\n	-- What the *server actually did*, not what the content asked for. An event\n	-- authored Enacted arrives here as \"Panel\" whenever there was nothing in the room\n	-- to hang the dots on, so the client renders what exists rather than what was\n	-- intended and a fallback needs no second message to announce itself.\n	resolution: EventResolution,\n}\n\n-- Who the player decided to be, before the life started running.\n--\n-- Identity only. What the setup menu spent on *stats* is deliberately not in here:\n-- those points were added to `stats` the moment the life began and that is where they\n-- live, so a copy of them here would be a second answer to a question `stats` already\n-- answers -- and the two would drift the first time anything else moved a stat, which\n-- is on the very first birthday.\n--\n-- Gender is likewise not in here even though the menu picks it, because `ProfileData`\n-- already has a `gender` field that everything else reads. One fact, one field.\nexport type LifeSetup = {\n	firstName: string,\n	lastName: string,\n	-- Ids from content/Countries.luau and Config.Setup.Eras. Stored rather than the\n	-- display names, so renaming a country in content does not leave old saves showing\n	-- a name that no longer exists anywhere.\n	countryId: string,\n	eraId: string,\n}\n\n-- One country a life can begin in.\n--\n-- What it does today is supply the names -- a life begun in Lagos is named from Lagos --\n-- and nothing else. That is a deliberate floor rather than a placeholder: a country that\n-- handed out stat bonuses would be this game telling the player that people from one\n-- place are born smarter than people from another, which it is not going to do. What it\n-- is *for* later is content -- the places, the schools, the jobs, the money -- and every\n-- one of those is a fact about a society rather than about a person.\nexport type Country = {\n	id: string,\n	name: string,\n	-- Drawn from by the shuffle button and by \"Surprise Me\". Split by gender for the same\n	-- reason the town's lists are: a name is picked from the matching list by construction,\n	-- so there is no later check that could pass or fail.\n	firstNamesMale: { string },\n	firstNamesFemale: { string },\n	lastNames: { string },\n}\n\n-- One era, which today means \"one era and three signposts\".\n--\n-- The unavailable ones are real entries rather than text on a wall, because a row the\n-- player can see, read and press -- and be told it is not ready yet -- is a promise the\n-- game has made and can be held to. A hard-coded \"coming soon\" label is decoration.\nexport type Era = {\n	id: string,\n	name: string,\n	-- Shown under the name. On a locked era this is what it *will* be, which is the only\n	-- reason a locked row is worth drawing at all.\n	blurb: string,\n	available: boolean,\n}\n\n-- How rare a perk is to roll. Purely a weighting bucket -- rarer is not stronger, per the\n-- settled spin design, so this never gates power, only how often a perk comes up.\nexport type PerkRarity = \"common\" | \"uncommon\" | \"rare\" | \"legendary\"\n\n-- What kind of thing a perk actually changes. A union rather than a single authored kind,\n-- because only one kind exists today (`birthCircumstance`) and the spin system is built to\n-- outlive it -- a money-boost multiplier is the next one, and it must not require reshaping\n-- this type when it arrives. Every reader of `Perk.effect` is written as a kind-by-kind\n-- branch for exactly this reason: adding a case is additive, not a rewrite.\nexport type PerkKind = \"birthCircumstance\" | \"moneyBoost\"\n\n-- One perk effect. Only the fields for the perk's own `kind` are meaningful; the others are\n-- absent. A flat table with every field optional rather than one union type per kind, because\n-- Luau's `--!strict` cannot narrow a tagged union by string comparison inside `content/\n-- Perks.luau` the way it would in a language with real pattern matching -- this shape reads\n-- the same either way and keeps `Perks.luau` free of `:: any` casts.\nexport type PerkEffect = {\n	-- birthCircumstance: added to the starting stats the same way a player's own spent\n	-- points are, then clamped by the same rule -- so a perk can never hand out a stat\n	-- outside the range a player could have chosen themselves.\n	statDeltas: { [string]: number }?,\n	-- birthCircumstance: whole currency units the life begins with, on top of the usual\n	-- zero. Life's `money` field is never negative, so this is never negative either.\n	startingMoney: number?,\n	-- moneyBoost: a multiplier applied wherever a life's money changes. Unused until\n	-- MoneyService is taught to read it -- present now only so the type does not have to\n	-- move the day it is.\n	moneyMultiplier: number?,\n}\n\n-- One perk a spin can land on, and that a player can carry into a new life.\n--\n-- Content, not Config -- like `Country` and `Era` above, a perk is a fact with a name and a\n-- blurb, not a tunable number, so it lives in `content/Perks.luau` the same way countries\n-- live in `content/Countries.luau`. Only defined for the lobby: nothing in the game place\n-- ever reads a `Perk`, because a perk is spent the moment a life is created and from then on\n-- it is just stats and money like any other life's.\nexport type Perk = {\n	id: string,\n	name: string,\n	-- Shown on the card and in the odds list, so the player knows what they are buying\n	-- before they spin and what they are choosing before they spend it.\n	blurb: string,\n	rarity: PerkRarity,\n	kind: PerkKind,\n	effect: PerkEffect,\n}\n\n-- A perk this player actually owns, and how many. The wire shape of one entry in\n-- `ProfileData.perks`, which is a count keyed by id -- this is the same fact spelled out as a\n-- row a picker can iterate, the same relationship `SlotSummary` has to `LifeData`.\nexport type OwnedPerk = {\n	id: string,\n	count: number,\n}\n\n-- One perk as the spin page draws it: everything `content/Perks.luau` knows about it, plus\n-- the one number that file computes rather than authors -- its individual odds. Sent rather\n-- than left for the client to divide a rarity's weight by a count itself, on the rule every\n-- menu in this codebase follows: the numbers on screen are the numbers the server already\n-- computed, not a second copy of the same arithmetic that could drift from it.\nexport type PerkOffer = {\n	id: string,\n	name: string,\n	blurb: string,\n	rarity: PerkRarity,\n	-- Out of 1. `content/Perks.luau`'s `Odds` divides a tier's weight by how many perks\n	-- share it, which is what Roblox requires disclosed before a paid random purchase.\n	odds: number,\n}\n\n-- One Robux bundle the buy page can offer, mirroring `Config.Spins.Products`. Sent rather\n-- than read from Config directly for the same reason `SetupOptions` is: `productId` is what\n-- the server is about to check a purchase prompt against, so the page can never dangle a\n-- button that opens a prompt for a product that does not exist.\nexport type SpinProduct = {\n	id: string,\n	name: string,\n	spins: number,\n	robuxPrice: number,\n	-- 0 until published, exactly like `Config.Lobby.GamePlaceId` -- refused by name rather\n	-- than by a failed Robux call.\n	productId: number,\n}\n\n-- Everything the spins page needs, pushed whenever any of it changes and once on join.\n--\n-- The catalog and the products ride along on every push rather than arriving on a separate\n-- remote the way `LobbySetupOptions` does, and that is a deliberate difference and not an\n-- oversight: `SetupOptions` was split off to avoid resending a country list -- dozens of\n-- countries, each carrying three name arrays -- on every slot delete. Ten short perk records\n-- and three products are close enough to free that a second remote would be ceremony bought\n-- with nothing.\nexport type SpinsState = {\n	spinsAvailable: number,\n	perksOwned: { OwnedPerk },\n	catalog: { PerkOffer },\n	products: { SpinProduct },\n}\n\n-- Everything the setup menu needs to draw itself, sent once when the menu is called for.\n--\n-- Sent rather than read from Config by the client, even though the client could require\n-- Config directly. The numbers here are the ones the server is about to *validate*\n-- against, so shipping them from the same place that enforces them means a menu can\n-- never offer a spend the server will then refuse.\nexport type SetupOptions = {\n	-- Which life this is -- 1 for a player's first ever. Purely so the menu can say so.\n	lifeNumber: number,\n	statPoints: number,\n	minPerStat: number,\n	maxPerStat: number,\n	maxNameLength: number,\n	startingStats: Stats,\n	countries: { Country },\n	-- Which country the card opens on. Sent rather than left as \"whichever is first\",\n	-- because the list is sorted alphabetically for the player's benefit and opening every\n	-- menu in the game on whichever nation happens to sort first would be an accident that\n	-- reads as a decision. Not a restriction of any kind: the stepper reaches all of them.\n	defaultCountryId: string,\n	eras: { Era },\n}\n\n-- What the client asks for. Every field is checked server-side against the same\n-- content and Config the options were built from, so this is a request and not an\n-- instruction: a client that sends a country that does not exist, an era that is not\n-- ready, or eleven points of stats is refused with a reason rather than obeyed.\nexport type SetupRequest = {\n	gender: Gender,\n	firstName: string,\n	lastName: string,\n	countryId: string,\n	eraId: string,\n	-- Added to the starting stats. May be negative -- taking looks to buy smarts is the\n	-- whole of the mechanic, and a menu that only ever gave points away would be a\n	-- reward screen rather than a decision.\n	statDeltas: { [string]: number },\n}\n\n-- One life: everything that is true of the person currently being played, and nothing\n-- that is true of the player.\n--\n-- The split from `ProfileData` below is what makes save slots possible. The test for which\n-- side a field belongs on is not \"does it feel permanent\" but **does it die when the person\n-- does** -- money, bonds, the job and the education are all facts about a human being and\n-- go here; how many lives the player has lived is a fact about the player and does not.\n--\n-- Structurally identical to what `ProfileData` was before slots existed, minus `livesLived`.\n-- That is deliberate: every service that reads a life reads exactly the fields it always\n-- did, so the slot refactor changed where a life is *found* and nothing about what one *is*.\nexport type LifeData = {\n	ageMonths: number,\n	stage: LifeStageId,\n	alive: boolean,\n	stats: Stats,\n	-- Whole currency units held right now. Never negative and never fractional --\n	-- MoneyService is the only thing that writes it and guarantees both.\n	--\n	-- Per life, not per player: it is reset when a new life begins, for the same\n	-- reason the seen list is. Money that survived death would be the one thing a\n	-- player carried between lives, which turns dying into a setback in a game where\n	-- it is meant to be an ending.\n	money: number,\n	-- Pocket money counted at a birthday but not yet in the player's hands. Its own\n	-- field rather than being added straight to `money`, because the two answer\n	-- different questions: this is what the player is owed, and money is what they\n	-- have.\n	--\n	-- Non-zero for as long as it takes a parent to cross a room, which is the reason\n	-- it is a field at all: a handover nobody could be reached for comes out as money\n	-- delayed rather than money lost, and this is the whole difference between the\n	-- two. It survives leaving the server for the same reason -- a player who logs\n	-- off mid-walk is owed it when they come back. Never destroyed except by death.\n	pocketMoneyOwed: number,\n	-- The last birthday whose pocket money has been counted into the field above.\n	--\n	-- This is what makes the grant idempotent: a birthday that somehow runs twice\n	-- finds this already at the current age and adds nothing. It also makes a life\n	-- that jumps several years at once pay for each of them rather than only the\n	-- last, which is exactly what a skipped childhood is.\n	--\n	-- Clamped up to the player's real age when a profile loads, which is what stops a\n	-- save written before pocket money existed from back-paying an entire childhood\n	-- on its owner's next birthday.\n	pocketMoneyPaidThroughAge: number,\n	-- Active in-server seconds banked since the last age-up. Persisted so a\n	-- player who leaves mid-year resumes their progress instead of restarting it.\n	secondsSinceAgeUp: number,\n	-- Events already answered in the *current* life, so a year can't repeat one.\n	-- Cleared on respawn: living the same moment again in a new life is fine.\n	seenEventIds: { [string]: boolean },\n	-- What this life has done, mapped to the age it did it at. Written only by\n	-- answering an event, read by events, people and what people offer.\n	--\n	-- Cleared with the seen list for the same reason and at the same moment: the\n	-- friend you made is that child's friend, and a new life that began already\n	-- knowing them would be a life that had inherited somebody else's history.\n	flags: FlagSet,\n	-- The event offered but not yet answered. Persisted so it survives a rejoin,\n	-- and so re-joining can't be used to reroll an unwanted prompt.\n	pendingEventId: string?,\n	-- The event picked and physically placed in the world but not yet reached:\n	-- a letter on the mat, a phone ringing in the hall. Deliberately a separate\n	-- field from pendingEventId rather than a flag on it, because the two mean\n	-- different things to every check that reads them -- \"there is something to\n	-- find\" versus \"there is a question open\". Persisted, so the letter is still\n	-- on the mat after a rejoin instead of vanishing with the session that\n	-- staged it.\n	deliveringEventId: string?,\n	-- Real seconds until the ambient scheduler next tries to stage something.\n	-- Counts down only while the player is in a server, so logging out neither\n	-- banks quiet time nor resets it. Reset to a fresh random gap after each\n	-- staging, which is what keeps ambient events from arriving on a metronome.\n	deliveryCountdown: number,\n	-- Ambient deliveries staged in the current year, against Ambient.MaxPerYear.\n	-- Without this a player who lingers in one year would be buried in mail.\n	deliveriesThisYear: number,\n	-- The job held right now, or nil for the whole of childhood. Per life like\n	-- money is: a career does not survive the person who had it.\n	jobId: string?,\n	-- Game hours worked in the current year, against ShiftsPerYear * ShiftGameHours.\n	--\n	-- Hours rather than shifts, and that is the whole design of the cap. Counting\n	-- completed shifts would let a player work seven hours, walk out before the\n	-- eighth, and come back to a fresh shift forever -- paid without ever spending\n	-- one. An hour worked is an hour spent, so there is no length of shift that\n	-- games it, and working the full five earns exactly the authored salary.\n	--\n	-- Persisted, because the year it belongs to outlives the session.\n	workGameHoursThisYear: number,\n	-- What each job you have ever worked thinks of you, keyed by job id. Built up by\n	-- turning up, worked out by walking out, and moved most by how you answer the\n	-- things that happen mid-shift.\n	--\n	-- Kept per job rather than as one number, because it is the ladder: the office\n	-- asks what the shop floor made of you, and a single figure would let a good\n	-- record anywhere stand in for a good record *there*. It also means a career\n	-- change starts you at nothing again, which is true of career changes.\n	--\n	-- Per life, like the job and the money. Absent keys read as zero, so a job you\n	-- have never worked and a job that has no opinion of you yet are the same thing,\n	-- which they are.\n	jobStanding: { [string]: number },\n	-- XP earned this life at the current job, toward the next standing band.\n	-- Reset when the job changes or the life dies. Read as a raw number; the\n	-- HUD turns it into a fraction of the distance to the next band threshold.\n	workXp: number,\n	-- Jobs that have let you go this year, keyed by job id. Set when standing hits\n	-- Config.Work.Standing.FireAt; blocks re-hire at that one employer until the next\n	-- birthday clears it. A cooldown rather than a permanent ban -- being sacked costs\n	-- you the rest of the year there, not the job forever -- and per job, because the\n	-- shop letting you go says nothing about whether the office will have you. Absent\n	-- keys read as false: never fired and fired-then-a-year-passed are the same thing.\n	firedFrom: { [string]: boolean },\n	-- Workouts completed per machine kind in the current year, against\n	-- Config.Gym.WorkoutsPerYear. Keyed by machine kind (\"treadmill\", \"bench\",\n	-- etc.) rather than a single count, so using the treadmill does not spend the\n	-- bench. Nil-safe: absent keys read as zero.\n	--\n	-- Per life, like lessonsThisYear and for the same reason: a new body has not\n	-- worked out anywhere yet.\n	workoutsThisYear: { [string]: number },\n	-- Cumulative XP per skill id, keyed by `Config.Skills.Definitions[n].id`. Absent\n	-- keys read as zero, so a discipline never practised and one that exists but has\n	-- not been touched are the same thing -- which they are.\n	--\n	-- Per life, deliberately. Skill is the most tempting thing in the game to carry\n	-- across deaths and the worst one to: a game where the ninth life starts as a\n	-- master is a game where the first eight were the tutorial.\n	skillXp: { [string]: number },\n	-- Lessons sat in the current year, against School.LessonsPerYear. The same cap as\n	-- workGameHoursThisYear and for the same reason: a player who lingers in one year\n	-- should not be able to grind a childhood's worth of smarts out of it.\n	--\n	-- Also the attendance record, and the only one there is: zero on the birthday that\n	-- ends a school year is what charges SmartsPerYearMissed. There is deliberately no\n	-- lifetime tally of questions asked and got right, because `smarts` already is one\n	-- -- it is the number school exists to move, and a second record of the same fact\n	-- would be a number nothing reads.\n	--\n	-- Per life, like the job and the money: nobody inherits an education.\n	lessonsThisYear: number,\n	-- How good this life has got at each subject's verb, keyed by subject id. Absent\n	-- keys read as level one, which is where everybody starts.\n	--\n	-- This is the one number in school that is not `smarts`, and the reason it exists\n	-- separately is that it does not measure the same thing. Smarts is what school was\n	-- *for* -- a stat other systems read, spent on being something other than a shop\n	-- assistant at sixteen. Mastery is what school is *like*: it buys how much of a\n	-- procedure the board shows you at once, which is a change to the activity rather\n	-- than to the character. A player at mastery five is not cleverer, they are walking\n	-- to the board less.\n	--\n	-- Keyed by subject rather than one figure, for the reason jobStanding is keyed by\n	-- job: being good at running a procedure says nothing about reading a passage, and\n	-- one number would let a term of Science pay for a term of Reading.\n	--\n	-- Per life, like everything else here. Nobody inherits an education.\n	subjectMastery: { [string]: number },\n	-- Passes banked toward the *next* mastery level in each subject, keyed the same way.\n	-- Reset to zero when a level is earned, so this only ever holds a partial run.\n	--\n	-- A separate field rather than a fractional mastery, because the two are read in\n	-- different places and a level is a thing the player is told about once. Absent keys\n	-- read as zero.\n	subjectPasses: { [string]: number },\n	-- The lessons sat so far in the year currently running, in the order they happened.\n	-- Emptied by every birthday, into the card that birthday stages.\n	--\n	-- Distinct from `lessonsThisYear`, which counts the same afternoons and is what the\n	-- yearly cap and the missed-year penalty read. A count cannot be reported on: it\n	-- cannot say which subject, or how it went, or that the year had two good lessons and\n	-- an empty slot rather than three mediocre ones. Both exist because both are read, and\n	-- the count is the one the rules run on precisely so a change to what a card shows can\n	-- never move what school charges.\n	schoolYear: { SchoolLessonRecord },\n	-- Nerve, 0..Config.Stats.Max. What the corridor has taught you about being stood in\n	-- front of, and the only thing that widens the release window in a stare-down.\n	--\n	-- Deliberately *not* a fifth entry in StatName. The four stats are a closed union read\n	-- by the stats HUD, the decay table, every job gate and every life event, and a fifth\n	-- would have to be threaded through all of them to be worth anything -- for a number\n	-- that only one system reads. Kept here for the same reason subjectMastery is kept\n	-- here rather than folded into smarts: being hard to push around is not a fact about\n	-- how clever you are.\n	--\n	-- Per life. Nobody inherits a spine either.\n	bullyNerve: number,\n	-- How many bullies this life has faced down, ever. Read only to pick the tier the\n	-- corridor is currently at -- see Config.School.Bully.Tiers -- so it is a count of\n	-- reputation rather than a score, and nothing pays out of it.\n	--\n	-- Never decremented. Backing down does not un-earn a corridor you already won, which\n	-- is the same soft-failure rule Mastery.Record states about subjects: a ladder you can\n	-- slide down turns the encounter before the top rung into a thing to be afraid of.\n	bullyStandUps: number,\n	-- Whether somebody has your homework. Set when a bully takes it, cleared by redoing it\n	-- at the library desk or by the birthday that ends the year.\n	--\n	-- A flag rather than a count because there is only ever one piece of it: this is the\n	-- consumable that makes the corridor generate its own pacing -- burst, forced walk,\n	-- burst -- and a stack of missing homework would just be a debt, which is a number,\n	-- which is the thing the activity law says not to reach for.\n	homeworkTaken: boolean,\n	-- Heat, 0..Config.Crime.MaxBounty. What the police are currently prepared to spend on\n	-- finding you, and the number every tier is read off.\n	--\n	-- Persisted, unlike almost everything else about a pursuit, and for one reason: it is\n	-- the only state a player could otherwise wipe by disconnecting. The officers are not\n	-- saved -- bodies are cheap and are rebuilt from this number on the way back in -- but\n	-- the number itself has to survive the session or leaving is a free escape, and a free\n	-- escape is the one thing that would make the rest of this system pointless.\n	bounty: number,\n	-- How many times this life has been convicted. A count rather than a flag because it\n	-- is the thing that is allowed to grow: one conviction raises the bar, and there is\n	-- room here for a second to raise it further without a new field.\n	--\n	-- Per life, like everything else. A record is a fact about a person, and the next\n	-- person is not them -- which is also the only clean slate this game offers, and it\n	-- costs exactly what starting again costs.\n	convictions: number,\n	-- Which gang this life runs with, and what rung it holds there. Both absent for the\n	-- overwhelming majority of lives, and the absence is the meaning: not in a gang is not\n	-- a rank called \"nobody\", it is the field not being there.\n	--\n	-- Two fields rather than one record because they are written at different moments by\n	-- different rules -- the gang is chosen by the player at a panel, the rung is conferred\n	-- by somebody else at a later one -- and a record would invite writing them together.\n	gangId: string?,\n	gangRankId: string?,\n	-- Standing with every gang that has an opinion of you, keyed by gang id. Shaped like\n	-- `jobStanding` and read the same way, and kept per gang rather than only for the one\n	-- you are in for the same reason `bonds` outlive a scene: leaving does not make the\n	-- work you did for them not have happened, and a gang you left at 900 should not\n	-- welcome you back as a stranger.\n	gangStanding: { [string]: number },\n	-- Who runs with this life right now, in the gang held in `gangId`. Wiped by `leave` and\n	-- by `GangService.ResetPlayer`, unlike `gangStanding`: a crew is people who chose to\n	-- run with *this* membership, and re-joining later, or joining somebody else, starts\n	-- from nobody rather than from whoever last stood beside you.\n	gangCrew: { GangCrewMember },\n	-- When this life last walked away from a gang, as a life-seconds stamp, or absent if it\n	-- never has. Read only to hold the rejoin window open; a life that has never been in\n	-- one has no window to be inside.\n	leftGangAt: number?,\n	-- Whether the colors are currently on. Persisted rather than session-held because\n	-- taking them off is a decision with a cost attached, and one that a player would\n	-- reasonably expect to survive a respawn -- rediscovering that the game re-dressed you\n	-- in a bright band while you were walking into a bank would be the game undoing a\n	-- choice you made on purpose.\n	wearingColors: boolean,\n	-- Every school year this life has finished, named. Twelve entries at most.\n	--\n	-- Written once a birthday and never rewritten, because a year that is over is over --\n	-- this is the only field in school that is a history rather than a state. Read today\n	-- by the card, which counts it into the record line, and it is what an end-of-life\n	-- verdict will have to read: a grade is reconstructible from nothing once the year has\n	-- passed, so a build that fails to write it as it happens can never recover it.\n	schoolGrades: { SchoolYearGrade },\n	-- A card that has been staged and not yet handed over, or absent when there is none.\n	--\n	-- Absent means \"nothing to collect\", on the same absent-means-something idiom as\n	-- `pendingEventId` -- which is why it is deliberately missing from Lives.New's table\n	-- rather than being written there as nil.\n	--\n	-- Durable rather than transient because the card is collected at the school, at a\n	-- moment of the player's choosing, which may be a week and two sessions after the\n	-- birthday that wrote it. A card held only in memory would be a year's verdict that\n	-- quietly evaporated if you logged off on your birthday.\n	pendingReport: SchoolYearRecord?,\n	-- How each person you know feels about you, keyed by person id, between\n	-- People.MinBond and People.MaxBond.\n	--\n	-- Deliberately shaped like jobStanding and for the same reason: a relationship is\n	-- an opinion held by somebody in particular, and one number covering everybody\n	-- would let being adored by your mother stand in for being known by your neighbor.\n	--\n	-- Absent keys do *not* read as zero here, which is the one place this differs from\n	-- jobStanding. A person is authored with a bond they start at -- a mother does not\n	-- begin a life indifferent to you -- so an absent key means \"has not been met yet\"\n	-- and the starting figure is what gets written the first time anything moves.\n	--\n	-- Per life. The hardest of these to accept and the most important: dying does not\n	-- carry your family over to the next child, because a relationship that survived\n	-- the person who had it would be the one thing in this game that death did not\n	-- cost, and everything else here is built on death costing everything.\n	bonds: { [string]: number },\n	-- Who has been visited, how often, and in which year -- keyed by person id.\n	--\n	-- Two jobs off one record. It is the yearly cap, because a person already seen\n	-- Config.People.VisitsPerYear times at the age you are now has no more time for you;\n	-- and it is the decay check, because a person whose record is for an older year than\n	-- the one just ending is somebody you did not go to see.\n	--\n	-- Per life, like the bonds it caps: a new child has been nowhere.\n	visits: { [string]: PersonVisits },\n	-- What each person you know actually *is* to you -- a tie id from content/Ties.luau\n	-- -- keyed by person id. Absent means nothing in particular, which is what almost\n	-- everybody is.\n	--\n	-- Separate from `bonds` rather than derived from it, and that is the whole design.\n	-- A bond is how somebody feels about you and it moves both ways on its own: it rises\n	-- by turning up and falls by not. A tie is something that was decided, once, by an\n	-- offer the player picked -- so it does not quietly appear the year a number crosses\n	-- a line, and it does not quietly vanish the year it slips back under. Deriving it\n	-- from the bond would make friendship a threshold, which is a thing that happens to\n	-- you rather than a thing you did.\n	--\n	-- Per life, like the bonds beside it, and for the same reason.\n	ties: { [string]: string },\n	-- Who this life was born as.\n	--\n	-- Optional, and the absence is load-bearing rather than laziness -- it is the same\n	-- device `jobId` and `pendingEventId` use in this type. There is no honest default:\n	-- every value biases somebody, and a template that said \"male\" would hand every\n	-- player's *first* life the same answer, because a fresh profile is filled in from\n	-- the template exactly like a stored one. Absent means \"not decided yet\", which is\n	-- true of a profile that has never started a life, and DataService rolls it the\n	-- moment one does.\n	--\n	-- Per life, like the bonds and the ties: a new life is a different person.\n	gender: Gender?,\n	-- Who the player chose to be this life, or absent if they have not chosen yet.\n	--\n	-- The absence is not just \"no name yet\" -- it is the *gate*. A profile with no setup\n	-- is a life that has not started, and the clock, the auto age-up and the first event\n	-- of the year all check it before they move. That is why this is one optional field\n	-- rather than a `setupDone` boolean beside a `setup` table: two fields can disagree\n	-- about whether a life is running, and exactly one of those disagreements is a life\n	-- that ages while the player is still choosing their name.\n	--\n	-- Per life, like everything above it. Cleared on death, which is what brings the menu\n	-- back for the next one.\n	setup: LifeSetup?,\n	-- House ownership per life. Each suburb house a life has purchased,\n	-- and the job linked to it for work-from-home purposes.\n	--\n	-- Stored on LifeData rather than ProfileData because it resets on death --\n	-- a new life inherits no property, just as it inherits no money.\n	--\n	-- `owned` is a set of house ids the life has bought; `homeJob` maps a house\n	-- id to the job id the life works from that house. Empty is the default,\n	-- which reads as \"no property, no home job\" -- true of a newborn, and the\n	-- right thing to hand an old save written before houses existed.\n	houses: {\n		owned: { [string]: boolean },\n		homeJob: { [string]: string },\n	},\n	-- Vehicle ownership per life. Reset on death, on the same terms as `houses`: a\n	-- new life inherits no garage, just as it inherits no property.\n	--\n	-- `owned` is a set of vehicle ids the life has bought. `active` is which one is\n	-- currently standing in the world -- nil means none is spawned, which is the\n	-- default the moment a car is bought and every time the player has not yet\n	-- pulled one out of the garage this session. Only one is ever spawned per life\n	-- at once; the rest sit in the garage exactly as an unspawned house does.\n	vehicles: {\n		owned: { [string]: boolean },\n		active: string?,\n	},\n	-- Bills tracking per life. Reset on death like money.\n	bills: {\n		debt: number,\n		lastBillMonth: number,\n		shiftsCompleted: number,\n	},\n	-- Savings account per life. Reset on death like money; a new life has no\n	-- bank history, just as it has no debt. Tied to the bill cycle so interest\n	-- compounds monthly alongside the debt it offsets.\n	savings: {\n		balance: number,\n	},\n	-- Milestones already achieved this life, keyed by milestone id. Reset on death.\n	milestones: { [string]: boolean },\n	-- Bond milestones already fired this life, keyed by \"personId_milestoneValue\".\n	-- Reset on death so each life gets its own relationship arc.\n	bondMilestones: { [string]: boolean },\n	-- The ribbon this life was judged to have earned, or nil if the life ended\n	-- before the minimum age or before the verdict system existed. Set by\n	-- VerdictService at death and never rewritten; the lobby reads the id to\n	-- display the life's archetype on the slot card.\n	verdict: Ribbon?,\n	-- The age, in months, at which the current chapter band began. Set to the\n	-- band boundary when a life crosses one, and never touched between. The reel\n	-- reads it as `sinceMonths` to ask \"what has happened since the last break?\",\n	-- and it is what lets the same query answer the reel and the verdict — the\n	-- verdict passes no window and the reel passes this number.\n	--\n	-- Zero for a newborn and for a save written before chapters existed, which is\n	-- the same thing as \"the current chapter started at birth\". Reconcile fills\n	-- it in as zero so an old save's first break lists the whole life — honest,\n	-- because that life genuinely has no smaller window to report.\n	lastChapterBreakMonths: number,\n\n	-- Per-chapter delivery counter, reset to 0 at every chapter break in\n	-- LifeService:EnterChapter. The picker refuses to deliver past\n	-- Config.Events.MaxPerChapter in a chapter, so a chapter never has more\n	-- than that many events staged. Shift events bypass the cap.\n	pendingEventCountInChapter: number,\n\n	-- Per-chapter counter for how many of those events came from the world\n	-- (Ambient, Wandered, Anchored) versus from a birthday or shift panel\n	-- (Immediate, Shift). Enforced by the picker: at least 70% of the\n	-- chapter's events must be world-spawned, so with a cap of 3 that\n	-- means at most 1 modal event per chapter. Reset at each chapter break.\n	worldEventsThisChapter: number,\n	modalEventsThisChapter: number,\n\n	-- Last time (os.clock()) each event id was delivered, keyed by id. Used\n	-- to enforce per-event cooldowns: an event with cooldown N will not be\n	-- staged again within N seconds of its previous delivery. Written by\n	-- DeliveryService at stage time, not at resolution.\n	cooldownTimers: { [string]: number },\n\n	-- Autonomy points the player has earned this chapter and has not yet spent\n	-- on an ambient event. Each point is bought by a real action -- a shift,\n	-- a lesson, a visit -- and spent the moment the picker stages something.\n	-- Resets to 0 at every chapter break; capped at Config.Autonomy.MaxPerChapter.\n	autonomyPoints: number,\n	-- NPC memory: 5 rolling interactions per person, plus 1 defining moment.\n	-- Reset on death so each life has its own social history.\n	interactions: { [string]: { { personId: string, age: number, line: string } } },\n	definingMoment: { [string]: { personId: string, age: number, line: string } },\n\n	-- How known this life is for fighting. Rises only on a win -- never taken away by a\n	-- loss, the same ratchet-only rule gang standing and crew nerve already use -- and it\n	-- is not a criminal record: BountyService.HasRecord answers a different question and\n	-- neither reads the other. v1 spends this on nothing but tracking and display; it is\n	-- the seed for scaling a rival gang's answer to you later, not a mechanic in itself yet.\n	notoriety: number,\n}\n\n-- The account: one player, several lives, and the few things that outlive all of them.\n--\n-- Everything here is deliberately *not* a fact about a person. If a field would be untrue\n-- the moment the player started a different life, it belongs in `LifeData` above.\nexport type ProfileData = {\n	-- Which shape this save is in, so a load can tell a save written by an older build from\n	-- one written by this one and migrate it rather than misreading it.\n	--\n	-- Its own field rather than sniffing for a missing key, because \"is `slots` absent?\"\n	-- stops being answerable the moment `Reconcile` fills it in -- which happens before any\n	-- migration could look. A version number is the only thing Reconcile cannot forge, since\n	-- a save written before this field existed reconciles to the template's value and the\n	-- migration reads that as \"old\", which is exactly right.\n	schema: number,\n	-- Every life this player has, empty or not. Always exactly `Config.Slots.Count` long,\n	-- and never sparse.\n	--\n	-- Fixed length with empty lives in it rather than a list that grows, because a nil hole\n	-- in a Luau array breaks `#` and `ipairs` in ways that are silent and intermittent --\n	-- and a \"deleted slot 2\" would be exactly such a hole. An empty slot is a real LifeData\n	-- with no `setup`, which is the same thing \"no life here\" already meant everywhere else\n	-- in this codebase (see Lives.HasBegun), so nothing had to learn a second way to say it.\n	slots: { LifeData },\n	-- Which slot is being played, 1..#slots. Always valid: clamped on load.\n	--\n	-- **This is how the lobby tells the game place which life to run.** Deliberately stored\n	-- on the profile rather than passed through TeleportData, because teleport payloads are\n	-- a channel the server has to treat as untrusted, and \"which of my saves am I opening\"\n	-- is exactly the kind of thing that must not be assertable by a client.\n	activeSlot: number,\n	-- How many lives this player has finished, across every slot. Account-level on purpose:\n	-- it is the measure of how much of this game the player has seen, which is what\n	-- `Config.SkipChildhoodMinLives` is really asking about -- somebody on their fourth life\n	-- has sat through childhood three times regardless of which slots they were in.\n	livesLived: number,\n	-- Unspent spins, bought with Robux and waiting to be pulled. Account-level like\n	-- `livesLived`, and for the same kind of reason: a spin is not a fact about any one\n	-- life, it is a fact about what the player is owed by this account.\n	spinsAvailable: number,\n	-- Perks this player owns but has not yet spent, keyed by perk id and counting how many\n	-- copies -- a dictionary rather than a growable array for two reasons at once: the\n	-- ProfileStore array-reconcile gap that `Lives.Reconcile` exists to work around only\n	-- bites arrays, so a dictionary sidesteps it outright, and \"how many of this perk\" is\n	-- the only question a perk picker ever asks, which a count answers directly and a list\n	-- of duplicate rows would not. A perk is consumed by decrementing its count, never by\n	-- removing the key, so \"owns none\" and \"has never owned\" read the same -- absent and\n	-- zero are both nothing to spend.\n	perks: { [string]: number },\n	-- Robux purchases already granted, keyed by `receiptInfo.PurchaseId`. What makes\n	-- `ProcessReceipt` idempotent: Roblox's own retry system can hand the same receipt to\n	-- this callback more than once, and a purchase already in this table is granted again\n	-- by name rather than by spins -- checked and recorded before anything is added to\n	-- `spinsAvailable`, never after.\n	processedReceipts: { [string]: boolean },\n	-- Preferences, keyed by the ids in `Config.Settings.Options`. Sparse on purpose: only\n	-- the ones the player has actually moved are written, and anything absent means \"still\n	-- whatever Config says the default is\".\n	--\n	-- Sparse rather than filled in on load, because a filled table freezes today's defaults\n	-- into every save that has ever loaded. Change `default` on a setting later and the\n	-- players who never touched it would keep the old value forever, having never made a\n	-- decision about it -- which is the opposite of what a default is for.\n	--\n	-- Account-level, next to `livesLived` and for the same reason: whether this person wants\n	-- money popups is a fact about the person holding the mouse, not about the character.\n	-- Starting a new life should not hand somebody back a screen they already turned off.\n	settings: { [string]: boolean },\n	-- Codes this account has redeemed, keyed by the *id* in `Codes.luau` rather than by the\n	-- typed string. The id is the thing that must never be reused; the string beside it is\n	-- editable content, and a code re-spelled to fix a typo must not become free money for\n	-- everybody who already had it.\n	--\n	-- Account-level, and this is the part that makes a code a code. Per-life would mean a\n	-- player could bank a code, delete the slot, and cash it again -- three times over, with\n	-- three slots -- which turns every code the game ever ships into an exploit with a\n	-- multiplier on it.\n	redeemedCodes: { [string]: boolean },\n}\n\n-- One slot as the lobby menu draws it: enough to fill a card, and nothing else.\n--\n-- **A summary rather than the LifeData itself, and that is a deliberate boundary.** Sending\n-- the whole life down would work today and would quietly make every per-life field part of\n-- the client contract -- so the day something private is added to a life (an event's\n-- pending id, a flag the player is not meant to see yet) it would already be on the wire.\n-- The card needs six facts, so six facts is what crosses.\n--\n-- `begun` is separate from having a `name` because an empty slot has neither, and a slot\n-- being empty is the single thing the card's whole layout branches on. Deriving it from\n-- `name == nil` would work and would be a rule written down in two places.\nexport type SlotSummary = {\n	index: number,\n	begun: boolean,\n	-- All five absent on an empty slot. Absence is the state here for the same reason it is\n	-- everywhere else in this codebase -- there is no honest \"no name\" string, and any\n	-- placeholder would be a value the card has to know to special-case.\n	name: string?,\n	country: string?,\n	gender: Gender?,\n	ageYears: number?,\n	alive: boolean?,\n}\n\n-- House ownership state, pushed whole whenever a life buys or sells a suburb home\n-- or changes the job linked to it. The client draws a property panel from this,\n-- so the full set of owned and available houses arrives each time.\nexport type HouseState = {\n	owned: { [string]: boolean },\n	homeJob: { [string]: string },\n	available: { [string]: number },\n}\n\n-- The dealership queue in progress. Pushed whenever the queue changes: a customer\n-- arrives, is served, or the player clocks on at the auto_dealer shift.\nexport type CarDealerState = {\n	waiting: number,\n	counter: Vector3?,\n	greeting: string?,\n	served: boolean,\n}\n\n-- One car as content declares it: what the dealership sells, and what the chassis\n-- is built and driven from. Sized and coloured rather than modelled, on the same\n-- reasoning Props.luau and Cast.luau give at length -- a car exists and drives\n-- correctly from the first run, and a real mesh dropped into the Studio folder\n-- under a matching name is a swap this file never has to know happened.\nexport type VehicleKind = {\n	id: string,\n	name: string,\n	-- What it costs at the dealership, in whole currency units. The only number a\n	-- player judges a car by before ever driving one, same reasoning as\n	-- Job.yearlySalary.\n	price: number,\n	-- The body, as a block: length (Z), width (X), height (Y). The wheelbase and\n	-- track width the chassis is built from are derived from this rather than\n	-- authored a second time, so a car's silhouette and its handling can never\n	-- quietly disagree about how big the car is.\n	size: Vector3,\n	color: Color3,\n	accentColor: Color3,\n	-- Studs per second, flat out. The number a player actually feels; everything\n	-- else about the chassis is tuned to get a car to this and hold it.\n	-- Safe range: 60-140.\n	topSpeedStuds: number,\n	-- How hard the drive force pushes per stud of body mass, roughly -- higher\n	-- reaches top speed sooner and pulls away harder off the line.\n	-- Safe range: 8-20.\n	acceleration: number,\n	-- Maximum steer angle in degrees, both ways. Wider turns sharper and spins\n	-- out sooner; narrower feels like a truck. See Config.Vehicles for the speed\n	-- curve every car steers less sharply along as it goes faster.\n	-- Safe range: 20-40.\n	steerDegrees: number,\n}\n\n-- What the client needs to draw the dealership's showroom floor and a life's own\n-- garage from one push: every car sold, what this life already owns, and which\n-- one -- if any -- is standing in the world right now.\nexport type VehicleState = {\n	catalog: { VehicleKind },\n	owned: { [string]: boolean },\n	active: string?,\n	-- Whether a build is in flight for the currently-requested action, so the\n	-- panel can grey its own button rather than let a second click queue a\n	-- second spawn behind the first.\n	busy: boolean,\n	notice: string?,\n}\n\n-- Monthly bill state, pushed whenever a bill is charged or debt changes.\nexport type BillState = {\n	totalThisMonth: number,\n	debt: number,\n	paid: boolean,\n	notice: string?,\n	inDebt: boolean,\n}\n\n-- Savings account state, pushed whenever the balance changes or on join.\nexport type SavingsState = {\n	balance: number,\n	maxBalance: number,\n	interestRate: number,\n}\n\n-- A milestone achievement, pushed once when a life crosses a threshold.\nexport type MilestoneEvent = {\n	milestone: string,\n	label: string,\n	bonus: number,\n}\n\n-- An NPC gossip event, pushed when a townsfolk shares news about the player.\nexport type GossipEvent = {\n	speaker: string,\n	topics: string,\n	effect: string,\n}\n\n-- A bond milestone was crossed with a specific person.\nexport type BondMilestoneEvent = {\n	person: string,\n	milestone: number,\n	label: string,\n}\n\n-- What the lobby knows about this player, pushed whole whenever any of it changes.\n--\n-- Carries `slotCount` rather than letting the client read `Config.Slots.Count`, on the same\n-- rule as SetupOptions: the client draws exactly what the server is prepared to accept, so\n-- a fourth card can never appear for a slot the server would refuse.\nexport type LobbyState = {\n	slots: { SlotSummary },\n	activeSlot: number,\n	slotCount: number,\n	livesLived: number,\n	-- The join code active for the player's current active slot, or nil when\n	-- no code has been generated. The client reads this to decide whether to\n	-- show the code on the card and whether the join input is live.\n	joinCode: string?,\n}\n\nreturn Types\n"
table.insert(AGES_MANIFEST, "src/shared/Types.luau")
AGES_SOURCES["src/shared/WorldMap.luau"] = "--!strict\n-- The geometry behind the map and behind whose side you are standing on. Pure\n-- functions over numbers: no services, no remotes, no Roblox state beyond Vector3.\n-- Server and client both require it, which is the point -- the overlay the player\n-- reads and the rule the server enforces have to be the same arithmetic, or the map\n-- is a decoration that lies.\n--\n-- Two ideas live here and they are the same idea twice:\n--\n-- 1. **The map's extent is measured, never written down.** Bounds come from the\n--    place points that exist, so a regenerated or expanded city redraws its own map\n--    with nothing edited. tools/world_plan.py holds the world's real numbers and this\n--    file deliberately does not transcribe them -- a second copy of 1024 is the defect\n--    this tree keeps producing. The box is squared on the way out, so that normalized\n--    space is a uniform scaling of the world rather than a stretched one -- see\n--    `BoundsOf` for why that is not a cosmetic choice.\n--\n-- 2. **A region is \"nearer this boss than any other boss\".** Four bosses, four sides,\n--    no authored rectangles. It partitions the whole plane with no gaps and no overlaps\n--    by construction, and it cannot disagree with where the bosses actually stand\n--    because it is computed from where they actually stand.\n--\n-- Everything is flat: X and Z, Y discarded. A player on a first floor is on the same\n-- side of the map as the pavement below them, and height has no opinion about turf.\n\nexport type Bounds = {\n	minX: number,\n	maxX: number,\n	minZ: number,\n	maxZ: number,\n}\n\n-- A named point the regions are grown from. In practice a gang boss's place point,\n-- but the maths does not care and the tests pass it plain tables.\nexport type Site = {\n	id: string,\n	x: number,\n	z: number,\n}\n\n-- Which side a position is on, and how far inside it. `depthStuds` is the distance to\n-- the nearest boundary with another side -- zero at the line, larger the deeper in.\n-- Nil id only when there are no sites at all.\nexport type Standing = {\n	id: string?,\n	depthStuds: number,\n}\n\nlocal WorldMap = {}\n\n-- Flat distance, squared. Squared because every comparison below is a comparison\n-- between two of these and the square root would change no answer.\nlocal function flatDistanceSquared(x1: number, z1: number, x2: number, z2: number): number\n	local dx, dz = x1 - x2, z1 - z2\n	return dx * dx + dz * dz\nend\n\n-- The box containing every point given, padded outward.\n--\n-- Padding is not decoration: place points sit *at* buildings, so an unpadded box\n-- clips the map exactly at the outermost doorway and the edge of the world reads as\n-- the edge of the paper. Returns nil for an empty list rather than a zero box, because\n-- a zero box would divide by zero in Normalize and the caller has to know it has no\n-- map rather than be handed a broken one.\nfunction WorldMap.BoundsOf(points: { Vector3 }, padStuds: number): Bounds?\n	if #points == 0 then\n		return nil\n	end\n\n	local minX, maxX = math.huge, -math.huge\n	local minZ, maxZ = math.huge, -math.huge\n	for _, point in points do\n		minX = math.min(minX, point.X)\n		maxX = math.max(maxX, point.X)\n		minZ = math.min(minZ, point.Z)\n		maxZ = math.max(maxZ, point.Z)\n	end\n\n	minX, maxX = minX - padStuds, maxX + padStuds\n	minZ, maxZ = minZ - padStuds, maxZ + padStuds\n\n	-- **The box is squared before it is returned, and every caller depends on that\n	-- without knowing it.** `Normalize` divides X by the box's width and Z by its depth,\n	-- so on an oblong box the two axes come out at different scales -- and everything\n	-- drawn from those numbers is then quietly stretched. A roundabout becomes an\n	-- ellipse. A road at forty-five degrees through the town arrives at some other angle\n	-- on the paper. Worse, the territory borders are straight lines whose angle has to be\n	-- computed somewhere, and on a stretched sheet the honest answer differs depending on\n	-- which space you compute it in -- which is exactly the kind of bug that looks like a\n	-- rendering glitch and is actually arithmetic.\n	--\n	-- Squaring here fixes all of it in one place: normalized space becomes a plain\n	-- uniform scaling of the world, so angles, circles and ratios survive the trip. The\n	-- price is empty paper along the shorter axis, which is the truth -- the world is not\n	-- square and a map that filled the sheet would be lying about its shape.\n	local width, depth = maxX - minX, maxZ - minZ\n	local side = math.max(width, depth)\n	local centerX, centerZ = (minX + maxX) / 2, (minZ + maxZ) / 2\n\n	return {\n		minX = centerX - side / 2,\n		maxX = centerX + side / 2,\n		minZ = centerZ - side / 2,\n		maxZ = centerZ + side / 2,\n	}\nend\n\n-- World X/Z to 0..1 across the bounds. Y is not a parameter because the map has no\n-- opinion about height.\n--\n-- Returned unclamped on purpose. A caller drawing an icon wants to know the thing is\n-- off the map so it can drop it or pin it to the rim, and clamping here would silently\n-- stack everything outside the world onto the border instead.\n--\n-- Z maps straight through rather than being flipped. Roblox's +Z runs *south* on the\n-- compass GeographyService uses, and a map is drawn with north at the top, so the\n-- caller that draws it flips Y once at the point of drawing. Doing it here would put\n-- the flip somewhere the maths cannot explain it.\nfunction WorldMap.Normalize(bounds: Bounds, x: number, z: number): (number, number)\n	local width = bounds.maxX - bounds.minX\n	local depth = bounds.maxZ - bounds.minZ\n	if width <= 0 or depth <= 0 then\n		return 0.5, 0.5\n	end\n	return (x - bounds.minX) / width, (z - bounds.minZ) / depth\nend\n\n-- The reverse, for a click on the map becoming a place in the world.\nfunction WorldMap.Denormalize(bounds: Bounds, u: number, v: number): (number, number)\n	return bounds.minX + u * (bounds.maxX - bounds.minX), bounds.minZ + v * (bounds.maxZ - bounds.minZ)\nend\n\n-- The perpendicular distance from a point to the line equidistant between two sites.\n--\n-- Not (|PB| - |PA|) / 2, which is the tempting version and is wrong -- that quantity\n-- is only proportional to the true distance when the point lies on the segment joining\n-- the two sites. The identity that actually holds is\n--\n--     distance to bisector = (|PB|^2 - |PA|^2) / (2 * |AB|)\n--\n-- which falls out of expanding both squared distances: the |P|^2 terms cancel and what\n-- is left is linear in P. Positive when P is on A's side. Exact, and three multiplies.\nlocal function distanceToBisector(x: number, z: number, a: Site, b: Site): number\n	local separation = math.sqrt(flatDistanceSquared(a.x, a.z, b.x, b.z))\n	if separation <= 0 then\n		-- Two bosses in the same spot have no bisector to be a distance from. Infinite\n		-- rather than zero: there is no boundary here, so nothing should ever pick this\n		-- pair as the nearest one.\n		return math.huge\n	end\n	local toA = flatDistanceSquared(x, z, a.x, a.z)\n	local toB = flatDistanceSquared(x, z, b.x, b.z)\n	return (toB - toA) / (2 * separation)\nend\n\n-- Which site owns this ground, and how far in from the nearest border it is.\n--\n-- The border of a region is the nearest of its bisectors with every other site, so\n-- depth is a minimum over the rivals rather than a distance to any single line. With\n-- four sites that is three comparisons and no reason to be cleverer.\n--\n-- Depth is what the incursion award is measured in, and it is a property of *where you\n-- are* rather than of how long you have been there -- which is the whole reason the\n-- reward cannot be farmed by standing still.\nfunction WorldMap.StandingAt(sites: { Site }, x: number, z: number): Standing\n	if #sites == 0 then\n		return { id = nil, depthStuds = 0 }\n	end\n	if #sites == 1 then\n		-- One side owns everything and has no border to be deep inside of. Infinite\n		-- depth would be truthful and useless; zero says \"there is no line here\", which\n		-- is what every caller actually wants to hear.\n		return { id = sites[1].id, depthStuds = 0 }\n	end\n\n	local nearest = sites[1]\n	local nearestDistance = flatDistanceSquared(x, z, nearest.x, nearest.z)\n	for index = 2, #sites do\n		local site = sites[index]\n		local distance = flatDistanceSquared(x, z, site.x, site.z)\n		if distance < nearestDistance then\n			nearest, nearestDistance = site, distance\n		end\n	end\n\n	local depth = math.huge\n	for _, site in sites do\n		if site.id ~= nearest.id then\n			depth = math.min(depth, distanceToBisector(x, z, nearest, site))\n		end\n	end\n	if depth == math.huge then\n		depth = 0\n	end\n\n	return { id = nearest.id, depthStuds = math.max(depth, 0) }\nend\n\n-- Convenience for the common call, which has a Vector3 and wants only the name.\nfunction WorldMap.RegionAt(sites: { Site }, position: Vector3): string?\n	return WorldMap.StandingAt(sites, position.X, position.Z).id\nend\n\nreturn WorldMap\n"
