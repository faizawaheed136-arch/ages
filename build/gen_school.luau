lks walk from here toward home.\n		id = \"car_buyer\",\n		placeId = \"auto_dealer\",\n		minAge = 16,\n		maxAge = 999,\n		minAgeOffset = -2,\n		maxAgeOffset = 20,\n		minHeight = 0.94,\n		maxHeight = 1.07,\n		startingBond = 0,\n		busyLines = {\n			\"Just finishing up here. Talk to you tomorrow?\",\n			\"The manager's calling. I'll find you later.\",\n			\"Test drive schedule's full. Come back after lunch?\",\n		},\n		offers = {\n			{\n				id = \"small_talk\",\n				label = \"Talk about nothing in particular\",\n				minAge = 5,\n				maxAge = 999,\n				minBond = ALWAYS,\n				bond = 1,\n				stats = { happiness = 2 },\n				lines = {\n					\"Nice car, huh? I've been looking at this model all week.\",\n					\"Not much to do while waiting. You here often?\",\n					\"This place is bigger than it looks. Want to take a look around?\",\n				},\n			},\n			{\n				id = \"snub\",\n				label = \"Snub them\",\n				minAge = 10,\n				maxAge = 999,\n				minBond = ALWAYS,\n				maxBond = -5,\n				bond = -5,\n				lines = {\n					\"Okay. I'll just go back to the desk.\",\n					\"Right. Suit yourself.\",\n				},\n			},\n			{\n				id = \"cold_shoulder\",\n				label = \"Give them the cold shoulder\",\n				minAge = 10,\n				maxAge = 999,\n				minBond = ALWAYS,\n				maxBond = -5,\n				bond = -7,\n				lines = {\n					\"I'll pretend I didn't see that.\",\n					\"Fine. I was going to ask you anyway.\",\n				},\n			},\n			{\n				id = \"make_right\",\n				label = \"Try to make it right\",\n				minAge = 10,\n				maxAge = 999,\n				minBond = ALWAYS,\n				maxBond = -1,\n				bond = 8,\n				ask = true,\n				lines = {\n					\"Thanks. I was going to pretend it didn't happen, but -- thank you.\",\n				},\n				refusedLines = {\n					\"I need a bit. Just -- tomorrow?\",\n					\"Not today. I'm still working through it.\",\n				},\n			},\n			{\n				id = \"walk_suburb\",\n				label = \"Walk toward the suburbs with them\",\n				minAge = 16,\n				maxAge = 999,\n				minBond = 25,\n				bond = 4,\n				ask = true,\n				walksTo = \"suburb_1\",\n				lines = {\n					\"I live out that way. Walk with me for a bit?\",\n					\"Heading home. Want some company?\",\n					\"The suburbs are nicer this time of day. Come on.\",\n				},\n				refusedLines = {\n					\"Alright. Another time then.\",\n					\"Suit yourself. I'll save you a seat.\",\n				},\n				arrivalLines = {\n					\"Here we are. Nice area, isn't it?\",\n					\"Made it. This is my street. You live around here?\",\n					\"This part of town is quiet. Glad I could show you.\",\n				},\n			},\n			{\n				id = \"know_worker\",\n				label = \"Learn their name\",\n				minAge = 12,\n				maxAge = 999,\n				minBond = 10,\n				bond = 3,\n				stats = { happiness = 1 },\n				gives = \"known\",\n				lines = {\n					\"Oh, we've never done that, have we?\",\n					\"I've been here two years and you just noticed.\",\n					\"Right. Now we're officially acquainted.\",\n				},\n			},\n			{\n				id = \"break_friend\",\n				label = \"Take breaks with them properly\",\n				minAge = 14,\n				maxAge = 999,\n				minBond = 30,\n				bond = 6,\n				stats = { happiness = 3 },\n				needsTie = \"known\",\n				gives = \"friend\",\n				lines = {\n					\"Same time tomorrow? Good. I was hoping you'd say yes.\",\n					\"You're the only reason I look forward to breaks.\",\n					\"Nobody else here gets it. That's why it's us.\",\n				},\n			},\n			{\n				id = \"closest_worker\",\n				label = \"Tell them something you haven't told anyone\",\n				minAge = 18,\n				maxAge = 999,\n				minBond = 65,\n				bond = 8,\n				stats = { happiness = 4 },\n				needsTie = \"friend\",\n				gives = \"closest\",\n				lines = {\n					\"Nobody else knows this. That means something, right?\",\n					\"Thanks for not... you know. Thanks for listening.\",\n					\"This stays between us. Obviously.\",\n				},\n			},\n		},\n	},\n	{\n		-- Dealership sales staff. They staff the counter and show around — distinct\n		-- from the car_buyer archetype, which is the customer side of the same room.\n		id = \"car_salesperson\",\n		placeId = \"auto_dealer\",\n		minAge = 18,\n		maxAge = 999,\n		minAgeOffset = -2,\n		maxAgeOffset = 15,\n		minHeight = 0.94,\n		maxHeight = 1.07,\n		startingBond = 0,\n		busyLines = {\n			\"Just showing someone a sedan. One sec?\",\n			\"The finance team is on the phone. Give me a moment.\",\n			\"I'm between customers. Talk to you in a bit?\",\n		},\n		offers = {\n			{\n				id = \"small_talk\",\n				label = \"Talk about nothing in particular\",\n				minAge = 5,\n				maxAge = 999,\n				minBond = ALWAYS,\n				bond = 1,\n				stats = { happiness = 2 },\n				lines = {\n					\"Another quiet day at the lot. Want to see the new arrivals?\",\n					\"I've been at this counter since eight. You're not the only one up early.\",\n					\"Cars are great, I suppose. I just prefer the people side.\",\n				},\n			},\n			{\n				id = \"snub\",\n				label = \"Snub them\",\n				minAge = 10,\n				maxAge = 999,\n				minBond = ALWAYS,\n				maxBond = -5,\n				bond = -5,\n				lines = {\n					\"Okay. I'll just go back to the desk.\",\n					\"Right. Suit yourself.\",\n				},\n			},\n			{\n				id = \"cold_shoulder\",\n				label = \"Give them the cold shoulder\",\n				minAge = 10,\n				maxAge = 999,\n				minBond = ALWAYS,\n				maxBond = -5,\n				bond = -7,\n				lines = {\n					\"I'll pretend I didn't see that.\",\n					\"Fine. I was going to ask you anyway.\",\n				},\n			},\n			{\n				id = \"make_right\",\n				label = \"Try to make it right\",\n				minAge = 10,\n				maxAge = 999,\n				minBond = ALWAYS,\n				maxBond = -1,\n				bond = 8,\n				ask = true,\n				lines = {\n					\"Thanks. I was going to pretend it didn't happen, but -- thank you.\",\n				},\n				refusedLines = {\n					\"I need a bit. Just -- tomorrow?\",\n					\"Not today. I'm still working through it.\",\n				},\n			},\n			{\n				id = \"walk_suburb\",\n				label = \"Walk toward the suburbs with them\",\n				minAge = 16,\n				maxAge = 999,\n				minBond = 25,\n				bond = 4,\n				ask = true,\n				walksTo = \"suburb_1\",\n				lines = {\n					\"I live out that way. Walk with me for a bit?\",\n					\"Clocking off early. Want some company?\",\n					\"The suburbs are nicer this time of day. Come on.\",\n				},\n				refusedLines = {\n					\"Alright. Another time then.\",\n					\"Suit yourself. I'll save you a seat.\",\n				},\n				arrivalLines = {\n					\"Here we are. Nice area, isn't it?\",\n					\"Made it. This is my street. You live around here?\",\n					\"This part of town is quiet. Glad I could show you.\",\n				},\n			},\n			{\n				id = \"know_worker\",\n				label = \"Learn their name\",\n				minAge = 12,\n				maxAge = 999,\n				minBond = 10,\n				bond = 3,\n				stats = { happiness = 1 },\n				gives = \"known\",\n				lines = {\n					\"Oh, we've never done that, have we?\",\n					\"I've been here two years and you just noticed.\",\n					\"Right. Now we're officially acquainted.\",\n				},\n			},\n			{\n				id = \"break_friend\",\n				label = \"Take breaks with them properly\",\n				minAge = 14,\n				maxAge = 999,\n				minBond = 30,\n				bond = 6,\n				stats = { happiness = 3 },\n				needsTie = \"known\",\n				gives = \"friend\",\n				lines = {\n					\"Same time tomorrow? Good. I was hoping you'd say yes.\",\n					\"You're the only reason I look forward to breaks.\",\n					\"Nobody else here gets it. That's why it's us.\",\n				},\n			},\n			{\n				id = \"closest_worker\",\n				label = \"Tell them something you haven't told anyone\",\n				minAge = 18,\n				maxAge = 999,\n				minBond = 65,\n				bond = 8,\n				stats = { happiness = 4 },\n				needsTie = \"friend\",\n				gives = \"closest\",\n				lines = {\n					\"Nobody else knows this. That means something, right?\",\n					\"Thanks for not... you know. Thanks for listening.\",\n					\"This stays between us. Obviously.\",\n				},\n			},\n			{\n				id = \"learn_from\",\n				label = \"Ask them to teach you something\",\n				minAge = 16,\n				maxAge = 999,\n				minBond = 75,\n				bond = 5,\n				stats = { smarts = 2, happiness = 2 },\n				needsTie = \"friend\",\n				gives = \"mentor\",\n				lines = {\n					\"I've been at this counter long enough to know the tricks. Want me to show you?\",\n					\"Alright. But I won't go easy on you -- that's not teaching.\",\n					\"First lesson: nobody owes you anything. Now let's get to work.\",\n				},\n			},\n			{\n				-- A rival is not the absence of a relationship. It is a relationship that\n				-- turned sharp: somebody you pushed past, outdid, or crossed, and who\n				-- respects you enough to chase you for it. Capped at one because a life\n				-- only has room for one person who means this much in this direction.\n				--\n				-- Gated on the negative territory carved by `snub` and `cold_shoulder`\n				-- rather than on any tie -- you do not need to be known to become somebody's\n				-- rival, and requiring one would make the row invisible to the player who\n				-- sour their first encounter. The maxBond = -1 ensures it vanishes as soon\n				-- as the bond climbs back past a grudging truce.\n				id = \"become_rivals\",\n				label = \"Make them your rival\",\n				minAge = 12,\n				maxAge = 999,\n				minBond = ALWAYS,\n				maxBond = -1,\n				bond = 5,\n				stats = { happiness = -2 },\n				gives = \"rival\",\n				lines = {\n					\"Fine. You want it this way? I'm not letting you forget it.\",\n					\"You think you're better than me? Prove it. Every time.\",\n					\"Done. Next time we meet, I'm not going easy on you.\",\n				},\n			},\n			{\n				-- A rival is not the absence of a relationship. It is a relationship that\n				-- turned sharp, and the only way back is through it. This row is gated on\n				-- the rival tie specifically so it does not appear for somebody you have\n				-- merely slighted -- only when the rivalry is already set in stone.\n				id = \"repair_rival\",\n				label = \"Tell them you owe them an apology\",\n				minAge = 12,\n				maxAge = 999,\n				minBond = ALWAYS,\n				maxBond = -1,\n				bond = 10,\n				ask = true,\n				needsTie = \"rival\",\n				lines = {\n					\"You were right. I was wrong. I shouldn't have done that.\",\n					\"I've been thinking about it. I crossed a line and I'm sorry.\",\n					\"This doesn't have to be how it is. I want to fix it.\",\n				},\n				refusedLines = {\n					\"Sorry doesn't undo it. Show me you mean it.\",\n					\"You think words fix this? They don't.\",\n					\"Save it. I'm not ready to hear it.\",\n				},\n			},\n			{\n				-- An enemy is not the absence of a relationship. It is the relationship\n				-- that remains when the ladder has been burned: somebody you betrayed,\n				-- destroyed, or crossed so deeply that respect is gone and only the\n				-- memory of what was lost remains. Capped at one because a life only has\n				-- room for one person who means this much in this direction. Gated on\n				-- the deepest negative bond (MinBond = -20) so it only appears when the\n				-- relationship has been actively destroyed, not merely cooled. It gives\n				-- no bond gain -- making an enemy is a choice that costs you the\n				-- relationship entirely, and the bond stays at the floor.\n				id = \"become_enemies\",\n				label = \"Make them your enemy\",\n				minAge = 14,\n				maxAge = 999,\n				minBond = ALWAYS,\n				maxBond = -20,\n				bond = 0,\n				stats = { happiness = -10 },\n				gives = \"enemy\",\n				ask = true,\n				lines = {\n					\"You think this is over? It isn't. I will remember this forever.\",\n					\"We are done. Not rivals -- enemies. There is no coming back.\",\n					\"Go. But know that every time our paths cross, I will be there.\",\n				},\n				refusedLines = {\n					\"You're not worth it. Get out of my sight.\",\n					\"Fine. Stay. It changes nothing.\",\n					\"I don't need your permission to hate you.\",\n				},\n			},\n			{\n				-- A sibling is chosen, not given. Offered at the very top of the ladder\n				-- when the bond is past closest and the player is old enough to mean it.\n				id = \"chosen_sibling\",\n				label = \"Make them your sibling\",\n				minAge = 16,\n				maxAge = 999,\n				minBond = 85,\n				bond = 6,\n				stats = { happiness = 5 },\n				needsTie = \"closest\",\n				gives = \"sibling\",\n				lines = {\n					\"We don't have to be related to be family. I choose you.\",\n					\"Blood doesn't make this. Showing up does. I'm showing up.\",\n					\"Then it's settled. You're stuck with me now.\",\n				},\n			},\n		},\n	},\n\n}\n\n-- Which archetype townsperson N is, as a fixed repeating pattern rather than a weighted\n-- draw. Two reasons, and both matter more than the tidiness of a weight table would.\n--\n-- It is stable against `Config.Town.Count`: raising the population adds people to the\n-- end and disturbs nobody already saved against. A weighted draw would re-deal the whole\n-- town every time the number moved.\n--\n-- And it is stable against the *order* of the list above: townsperson 7 is a classmate\n-- because this pattern says so at position 7, not because a random number landed in a\n-- range whose size depends on how many archetypes there happen to be.\n--\n-- The mix is what a life actually has in it, which is not an even six ways: school and\n-- the street are where a childhood's people come from and there are more of both.\n--\n-- **The length of this list must stay odd.** Gender is alternated by index rather than\n-- rolled (see the build loop below for why), and a slot recurs every #PATTERN people --\n-- so an odd length lands each slot's two people on opposite parities and every archetype\n-- comes out exactly half and half. An even length would give each archetype a single\n-- gender throughout. `assertPatternParity` refuses that at load rather than leaving it to\n-- be discovered by counting heads.\n--\n-- One `classmate` gave way to make room for `peer` rather than the list simply growing:\n-- eight classmates was already the largest group in a school-years population that also\n-- has six street kids, and adult life needed the slot more than one more desk did.\n--\n-- Two `city_worker` and `city_athlete` slots were added to seed the new districts with\n-- people -- the city was going to be beautiful and empty without them.\nlocal PATTERN: { string } = {\n	\"street\",\n	\"classmate\",\n	\"regular\",\n	\"local\",\n	\"classmate\",\n	\"coworker\",\n	\"peer\",\n	\"street\",\n	\"local\",\n	\"classmate\",\n	\"regular\",\n	\"coworker\",\n	\"peer\",\n	\"street\",\n	\"local\",\n	\"coworker\",\n	\"city_worker\",\n	\"peer\",\n	\"city_athlete\",\n	\"fade_worker\",\n	\"north_worker\",\n	\"car_buyer\",\n	\"car_salesperson\",\n}\n\nlocal archetypeById: { [string]: Archetype } = {}\nfor _, archetype in ARCHETYPES do\n	if archetypeById[archetype.id] ~= nil then\n		error(`[AGES content] two townsfolk archetypes share the id \"{archetype.id}\"`)\n	end\n	archetypeById[archetype.id] = archetype\nend\n\nfor index, id in PATTERN do\n	if archetypeById[id] == nil then\n		error(\n			`[AGES content] the townsfolk pattern asks for \"{id}\" at position {index}, `\n				.. `which is not an archetype -- fix the name or add the archetype`\n		)\n	end\nend\n\n-- The gender split, checked rather than trusted.\n--\n-- Genders alternate by index and archetypes repeat every #PATTERN, so the two interleave\n-- correctly only while that length is odd -- and the failure when it is not is completely\n-- silent. Nothing errors, nothing looks wrong in a diff, and every classmate in the game\n-- is simply a boy. Somebody would eventually notice by playing a whole school year and\n-- wondering; that is far too late and far too expensive a way to find out that a list got\n-- one entry longer.\n--\n-- Counted honestly rather than asserted from the parity rule, so this keeps working if\n-- either half of the arrangement is ever replaced by something cleverer.\ndo\n	local male: { [string]: number } = {}\n	local female: { [string]: number } = {}\n	for index = 1, TOWN.Count do\n		local id = PATTERN[((index - 1) % #PATTERN) + 1]\n		if index % 2 == 0 then\n			female[id] = (female[id] or 0) + 1\n		else\n			male[id] = (male[id] or 0) + 1\n		end\n	end\n	for _, archetype in ARCHETYPES do\n		local men = male[archetype.id] or 0\n		local women = female[archetype.id] or 0\n		if men + women == 0 then\n			-- Not fatal on its own -- an archetype can legitimately sit unused while it is\n			-- being written -- but it is worth saying out loud, because the usual cause is\n			-- a name typed into ARCHETYPES and forgotten in PATTERN, and the symptom is a\n			-- population that silently never contains that kind of person.\n			warn(`[AGES content] archetype \"{archetype.id}\" is never used by the townsfolk pattern`)\n			continue\n		end\n		if math.abs(men - women) > 1 then\n			error(\n				`[AGES content] archetype \"{archetype.id}\" generates {men} men and {women} women. `\n					.. `Genders alternate by index, so #PATTERN ({#PATTERN}) must be odd and `\n					.. `Config.Town.Count ({TOWN.Count}) should be a whole number of patterns -- `\n					.. `otherwise a whole archetype comes out one gender and nothing else says so`\n			)\n		end\n	end\nend\n\n-- Everything about an archetype that can be wrong by reading it, checked here rather\n-- than left to People.luau's validator. Both would catch most of this, but the message\n-- there names \"town14\" -- and the fix is never in town14, it is in the archetype fourteen\n-- happens to be built from.\nlocal function validateArchetype(archetype: Archetype)\n	if archetype.minAge > archetype.maxAge then\n		error(`[AGES content] archetype \"{archetype.id}\" is around from {archetype.minAge} to {archetype.maxAge}`)\n	end\n	if archetype.minAgeOffset > archetype.maxAgeOffset then\n		error(\n			`[AGES content] archetype \"{archetype.id}\" draws an age offset from `\n				.. `{archetype.minAgeOffset}..{archetype.maxAgeOffset}, which is backwards`\n		)\n	end\n	if archetype.minHeight > archetype.maxHeight or archetype.minHeight <= 0 then\n		error(`[AGES content] archetype \"{archetype.id}\" draws a height from {archetype.minHeight}..{archetype.maxHeight}`)\n	end\n	if #archetype.busyLines == 0 then\n		error(`[AGES content] archetype \"{archetype.id}\" has no way of saying it is busy`)\n	end\n	if #archetype.offers == 0 then\n		error(`[AGES content] archetype \"{archetype.id}\" offers nothing, so walking up to one does nothing`)\n	end\n\n	local seen: { [string]: boolean } = {}\n	local labels: { [string]: string } = {}\n	-- Which template hands out each rung, so two of them handing out the same one can be\n	-- caught, and so the reachability pass below has something to ask.\n	local ladder: { [string]: string } = {}\n	for _, template in archetype.offers do\n		local where = `archetype \"{archetype.id}\" offer \"{template.id}\"`\n		if seen[template.id] then\n			error(`[AGES content] {where} is written twice`)\n		end\n		seen[template.id] = true\n\n		-- Two identical labels on one panel is unreadable, and unlike People.luau this can\n		-- be settled without walking the ages: every generated copy shares these labels.\n		local clash = labels[template.label]\n		if clash ~= nil then\n			error(`[AGES content] {where} and \"{clash}\" both read \"{template.label}\"`)\n		end\n		labels[template.label] = template.id\n\n		if #template.lines == 0 then\n			error(`[AGES content] {where} has nothing said back, which is the point of it`)\n		end\n		-- Both directions, matching PersonOffer's own rule. A missing refusal line shows a\n		-- blank row on the one beat the player most needs a person in front of them.\n		if template.ask then\n			local refused = template.refusedLines\n			if refused == nil or #refused == 0 then\n				error(`[AGES content] {where} is an ask but has no refusedLines -- write what they say when they say no`)\n			end\n		elseif template.refusedLines ~= nil then\n			error(`[AGES content] {where} has refusedLines but is not an ask, so they could never be said`)\n		end\n		local walksTo = template.walksTo\n		if walksTo ~= nil then\n			local walkable = false\n			for _, place in Config.Places.Walkable do\n				if place == walksTo then\n					walkable = true\n					break\n				end\n			end\n			if not walkable then\n				error(`[AGES content] {where} walks to \"{walksTo}\", which is not a place a walk can end at`)\n			end\n			if template.arrivalLines == nil or #template.arrivalLines == 0 then\n				error(`[AGES content] {where} is a walk but has no arrivalLines -- what do they say when you get there?`)\n			end\n			-- The walk is the walking. See the note on PersonOffer.walksTo: a companion\n			-- offer carries no stats or money, and a walk that paid out would be the one\n			-- content mistake in this file with no sentence attached to it.\n			if template.stats ~= nil or template.money ~= nil then\n				error(`[AGES content] {where} walks somewhere but also hands out stats or money; a walk is the walking`)\n			end\n		elseif template.arrivalLines ~= nil then\n			error(`[AGES content] {where} has arrivalLines but walks nowhere; set walksTo or drop them`)\n		end\n		local maxBond = template.maxBond\n		if maxBond ~= nil and maxBond < template.minBond then\n			error(\n				`[AGES content] {where} needs {template.minBond} and is gone above {maxBond}; `\n					.. `a maxBond below its minBond is an offer nothing could ever be at`\n			)\n		end\n\n		Ties.AssertKnown(template.gives, where)\n		Ties.AssertKnown(template.needsTie, where)\n		local gives = template.gives\n		if gives ~= nil then\n			-- \"Does the tie this row already requires get you what the row hands out?\" -- and\n			-- if so the row can never appear, because `gives` hides it once you have it.\n			--\n			-- Asked through `Ties.Meets` rather than as `RankOf(gives) <= RankOf(needsTie)`.\n			-- The rank comparison is only meaningful on the ladder, and rank 0 is shared by\n			-- \"off the ladder\" and \"no tie at all\" -- so an offer giving \"enemy\" from no tie\n			-- read as 0 <= 0 and was rejected as a rung that fails to climb. Excluding the id\n			-- \"enemy\" by name fixes that one row and leaves the next off-ladder tie to\n			-- rediscover the same failure; asking the question the check actually means does\n			-- not.\n			if Ties.Meets(template.needsTie, gives) then\n				error(\n					`[AGES content] {where} gives \"{gives}\" but already needs `\n						.. `\"{template.needsTie}\", which already satisfies it -- the row could `\n						.. `never appear`\n				)\n			end\n			-- Rungs only. A rung that could be refused would make becoming somebody's friend\n			-- a coin toss, which is the whole reason climbing is not an ask. Off the ladder\n			-- it is the opposite: \"make them your enemy\" is done *to* somebody, and them\n			-- refusing -- \"you're not worth it\" -- is the content, not a hole in it.\n			if template.ask and Ties.IsRung(gives) then\n				error(\n					`[AGES content] {where} gives \"{gives}\" and is an ask; a rung that can be refused `\n						.. `would make becoming somebody's friend a coin toss`\n				)\n			end\n			if ladder[gives] ~= nil then\n				error(\n					`[AGES content] archetype \"{archetype.id}\" reaches \"{gives}\" from both `\n						.. `\"{ladder[gives]}\" and \"{template.id}\"; a rung is one row, or the player `\n						.. `is shown two ways to become the same thing`\n				)\n			end\n			ladder[gives] = template.id\n		end\n	end\n\n	-- A rung nobody can stand on. `needsTie` is satisfied by that tie or anything closer,\n	-- so an offer needing \"friend\" is dead unless something in this archetype hands out\n	-- \"friend\" or better -- and dead content here is dead across every copy generated\n	-- from it, with no runtime symptom at all beyond a row that never appears.\n	--\n	-- Only checked within the archetype because that is the only place it is knowable:\n	-- a tie earned from a classmate is a tie with *that classmate*, so a coworker's\n	-- friend-only offer is not reachable through them.\n	for _, template in archetype.offers do\n		local needed = template.needsTie\n		if needed == nil then\n			continue\n		end\n		local reachable = false\n		for tieId, _ in ladder do\n			-- Same question as the gate that hides the row at runtime, asked with the same\n			-- function. Written as a rank comparison it said \"reachable\" for a row needing\n			-- an off-ladder tie the moment the archetype handed out *anything*, because\n			-- every rank is >= 0 -- so the one check that exists to find dead content would\n			-- have certified it.\n			if Ties.Meets(tieId, needed) then\n				reachable = true\n				break\n			end\n		end\n		if not reachable then\n			error(\n				`[AGES content] archetype \"{archetype.id}\" offer \"{template.id}\" needs \"{needed}\" but `\n					.. `nothing this archetype offers ever reaches it, so the row can never appear`\n			)\n		end\n	end\n\n	-- The check that earns its keep, and the reason it is here rather than only in\n	-- People.luau: an archetype with a gap in its floor produces however many townsfolk\n	-- the pattern asks for, and every one of them errors at load with the same fix.\n	--\n	-- Nothing generated here is flag-gated, but the rungs are tie-gated in both\n	-- directions -- `needsTie` hides a row until you have climbed and `gives` hides it\n	-- once you have -- so they are discounted here exactly as People.luau discounts them.\n	-- An archetype whose floor rested on a rung would empty out for the one player who\n	-- took it, which is the opposite of what a floor is.\n	for age = archetype.minAge, archetype.maxAge do\n		local floor = 0\n		for _, template in archetype.offers do\n			local minAge = math.max(template.minAge, archetype.minAge)\n			local maxAge = math.min(template.maxAge, archetype.maxAge)\n			local unconditional = template.gives == nil and template.needsTie == nil\n			if age >= minAge and age <= maxAge and template.minBond <= ALWAYS and unconditional then\n				floor += 1\n			end\n		end\n		if floor == 0 then\n			error(\n				`[AGES content] archetype \"{archetype.id}\" has nothing at age {age} that somebody at the `\n					.. `bottom of the bond range could take; widen an offer or write one at minBond = MinBond`\n			)\n		end\n	end\nend\n\nfor _, archetype in ARCHETYPES do\n	validateArchetype(archetype)\nend\n\nlocal function pick<T>(rng: Random, list: { T }): T\n	return list[rng:NextInteger(1, #list)]\nend\n\nlocal function round2(value: number): number\n	return math.round(value * 100) / 100\nend\n\nlocal bodies: { CastMember } = {}\nlocal people: { Person } = {}\nlocal isTown: { [string]: boolean } = {}\nlocal archetypeOf: { [string]: string } = {}\nlocal takenNames: { [string]: boolean } = {}\n\n-- Takes the gender rather than rolling one, so a person is named from the list that\n-- matches them by construction and there is no later check that could pass or fail.\nlocal function nameFor(index: number, gender: Gender): string\n	local firstNames = if gender == \"male\" then MALE_FIRST_NAMES else FEMALE_FIRST_NAMES\n	for attempt = 0, NAME_ATTEMPTS do\n		local rng = Random.new(TOWN.Seed + index * SEED_STRIDE + NAME_STREAM + attempt)\n		local name = `{pick(rng, firstNames)} {pick(rng, LAST_NAMES)}`\n		if not takenNames[name] then\n			takenNames[name] = true\n			return name\n		end\n	end\n	error(\n		`[AGES content] could not find an unused name for townsperson {index} in {NAME_ATTEMPTS} tries; `\n			.. `the name pools are too small for Config.Town.Count`\n	)\nend\n\nfor index = 1, TOWN.Count do\n	local id = string.format(\"town%02d\", index)\n	local archetype = archetypeById[PATTERN[((index - 1) % #PATTERN) + 1]]\n	local rng = Random.new(TOWN.Seed + index * SEED_STRIDE)\n\n	-- Alternated, not rolled, and this is the one attribute in this loop that is not\n	-- random. A fair coin flipped thirty-four times against a *fixed* seed does not give\n	-- a town that is roughly half and half -- it gives whatever that one seed happens to\n	-- say, forever, identically for every player. Twenty-two of one and twelve of the\n	-- other is an ordinary outcome for a coin and a bad outcome for a world, and because\n	-- the seed never changes there would be no second sample to correct it.\n	--\n	-- Alternating makes the split exact, and the interaction with PATTERN is the reason\n	-- its length must stay **odd**: a slot recurs every #PATTERN people, so with an odd\n	-- length the two people in each slot land on opposite parities and every archetype\n	-- comes out exactly half and half. Make it even and each archetype collapses to a\n	-- single gender -- every classmate a boy, every coworker a girl -- which is the sort\n	-- of failure that looks like a content mistake for a week before anybody counts.\n	-- assertPatternParity below refuses that rather than leaving it to be noticed.\n	local gender: Gender = if index % 2 == 0 then \"female\" else \"male\"\n\n	local body: CastMember = {\n		id = id,\n		name = nameFor(index, gender),\n		gender = gender,\n		skinColor = pick(rng, SKIN_TONES),\n		heightScale = round2(rng:NextNumber(archetype.minHeight, archetype.maxHeight)),\n		widthScale = round2(rng:NextNumber(0.88, 1.12)),\n		headScale = round2(rng:NextNumber(0.96, 1.06)),\n		proportionScale = round2(rng:NextNumber(0, 1)),\n		bodyTypeScale = round2(rng:NextNumber(0.45, 0.9)),\n		-- Nothing bought or uploaded, exactly as the authored four are. A town that\n		-- needed a shopping trip before it existed would not exist.\n		shirtAssetId = 0,\n		pantsAssetId = 0,\n		hairAssetId = 0,\n	}\n	table.insert(bodies, body)\n\n	local offers: { PersonOffer } = {}\n	for _, template in archetype.offers do\n		-- Clamped rather than trusted, so a template can say the years its sentence makes\n		-- sense in and be shared by two archetypes with different windows. People.luau\n		-- refuses an offer written outside its person's years, and this is what keeps\n		-- that from being an authoring trap.\n		local minAge = math.max(template.minAge, archetype.minAge)\n		local maxAge = math.min(template.maxAge, archetype.maxAge)\n		if minAge > maxAge then\n			continue\n		end\n\n		local offer: PersonOffer = {\n			id = `{id}_{template.id}`,\n			label = template.label,\n			minAge = minAge,\n			maxAge = maxAge,\n			minBond = template.minBond,\n			maxBond = template.maxBond,\n			bond = template.bond,\n			stats = template.stats,\n			money = template.money,\n			line = pick(rng, template.lines),\n			ask = template.ask,\n			-- Checked above, so an ask always has some. Read through a local rather than\n			-- indexed twice so the type checker can see it is not nil here.\n			refusedLine = nil,\n			gives = template.gives,\n			needsTie = template.needsTie,\n			walksTo = template.walksTo,\n			arrivalLine = nil,\n		}\n		local refusedLines = template.refusedLines\n		if template.ask and refusedLines ~= nil then\n			offer.refusedLine = pick(rng, refusedLines)\n		end\n		local arrivalLines = template.arrivalLines\n		if template.walksTo ~= nil and arrivalLines ~= nil and #arrivalLines > 0 then\n			offer.arrivalLine = pick(rng, arrivalLines)\n		end\n		table.insert(offers, offer)\n	end\n\n	local person: Person = {\n		id = id,\n		castId = id,\n		placeId = archetype.placeId,\n		minAge = archetype.minAge,\n		maxAge = archetype.maxAge,\n		ageOffset = rng:NextInteger(archetype.minAgeOffset, archetype.maxAgeOffset),\n		startingBond = archetype.startingBond,\n		busyLine = pick(rng, archetype.busyLines),\n		offers = offers,\n		contextualLines = archetype.contextualLines,\n	}\n	table.insert(people, person)\n	isTown[id] = true\n	archetypeOf[id] = archetype.id\nend\n\nreturn {\n	-- The bodies, for Cast.luau to merge. Separate from the people because a body is what\n	-- NPCService builds and a person is what PeopleService stands somewhere, and those\n	-- two files have never had to know about each other.\n	Bodies = bodies,\n	People = people,\n	-- Whether an id belongs to the town rather than to the cast. Read by PeopleService,\n	-- which bodies these on approach and the authored four always -- your mother is not\n	-- somebody the world should be streaming in.\n	IsTown = isTown,\n	-- Which kind of person each of them is. Only the harness reads it: the game never\n	-- needs to know, because everything an archetype decides has already been baked into\n	-- the person by the time anything asks.\n	ArchetypeOf = archetypeOf,\n}\n"
table.insert(AGES_MANIFEST, "src/server/content/Townsfolk.luau")
AGES_SOURCES["src/server/content/Vaults.luau"] = "--!strict\n-- Which places in town have a vault, and where the furniture is inside them.\n--\n-- Content, and a list of one today. It is a list rather than a constant for the reason\n-- Tills is: the brief for this system has always said \"and other stores added later\", and\n-- a second bank should cost a table row rather than a refactor of the file that robs it.\n--\n-- **The offsets are the whole point of this file.** Everything the bank activity needs is\n-- a floor plan -- how far the vault is from the door, where the alarm panel is, where the\n-- guard walks -- and all of it is written here as studs from the place point rather than\n-- read off the generated room. That is the same argument PlaceService's header makes and\n-- Till repeats: the town is generated, the generator already puts a box named `Vault` and\n-- a box named `Teller` in this room, and hanging the game off those names would mean the\n-- day somebody renames a box is the day the bank silently stops working. A place point is\n-- the town's own promise about where the door is. Measured against the generated bank as\n-- it stands, so the numbers are true today and are *checkable* -- if the room moves, this\n-- file is the one place that has to change.\n--\n-- The distance from the alarm panel to the vault is the difficulty of this activity, and\n-- it is set in studs on this page rather than as a multiplier in Config. That is\n-- deliberate: escalation in this project is by changing the space, and the space is here.\n-- Config.Crime.Bank.RearmSeconds is tuned *against* these numbers -- roughly six seconds\n-- of running for a round trip -- so the two have to be read together.\n\nlocal Vaults = {}\n\n-- A spot on the floor of the room, from the place point.\n--\n-- `forward` is into the room, along the way the place point faces. `side` is to the right\n-- of somebody standing on the point looking in, and negative is to their left. Two numbers\n-- rather than a Vector3 because the third one is always the floor: nothing in a bank is\n-- placed by height, only the parts that hang off these are.\nexport type Offset = {\n	forward: number,\n	side: number,\n}\n\n-- One robbable bank.\nexport type Bank = {\n	-- The place id, which has to be a place point in the built world -- the same ids\n	-- PlaceService indexes.\n	place: string,\n	-- What the player calls it. The place point's own label is a sentence about where to\n	-- stand; a heat notice needs a name.\n	name: string,\n\n	-- How far from the place point still counts as being inside, flat.\n	--\n	-- This is what the session is held by: a bank robbery does not end when you step away\n	-- from the vault -- you are *meant* to walk away from the vault, that is the activity --\n	-- it ends when you leave the building. A circle over a rectangular room, which spills a\n	-- little past the front door, and that is the right way for it to be wrong: you are not\n	-- out until you are properly out.\n	-- Safe range: enough to cover the far corner of the room plus a couple of studs.\n	roomStuds: number,\n\n	-- The vault door.\n	vault: Offset,\n	-- The alarm panel. By the entrance on purpose, which is what makes silencing the alarm\n	-- cost the walk away from the money.\n	alarm: Offset,\n	-- Where the guard walks, in order, returning to the first. At least two, or he is not\n	-- patrolling, he is standing somewhere.\n	patrol: { Offset },\n\n	-- What the vault is worth, as a share of Config.Crime.Bank.VaultFloat. The one\n	-- difficulty dial here, and as in Tills it is set against how exposed the building is\n	-- rather than against what it holds.\n	-- Safe range: 0.6-1.4.\n	richness: number,\n}\n\nlocal Banks: { Bank } = {\n	-- The generated bank on the civic row. Measured: the room runs x 683..733 and\n	-- z 968..1012, the place point is the door at (708, 970) facing north into it, and the\n	-- vault sits in the far corner at (729.5, 1007.5) -- 43 studs from the door.\n	--\n	-- The alarm panel goes on the wall to the left of the entrance, twelve studs in, which\n	-- puts it 48 studs from the vault: three seconds of running each way at an ordinary\n	-- walk. That number is the metronome the whole activity is played against and it is not\n	-- an accident of the floor plan -- it was chosen and the room was measured to hold it.\n	--\n	-- The patrol crosses the room diagonally rather than running along one wall, so the\n	-- guard is never at a fixed distance from either the vault or the panel, and so the\n	-- moment he can no longer see the vault is a moment the player can watch arrive. From\n	-- the door end of his walk the vault is 40 studs away, which is outside his sight: that\n	-- gap is the window, and it is geometry rather than a timer.\n	{\n		place = \"bank\",\n		name = \"First National\",\n		roomStuds = 52,\n		vault = { forward = 37.5, side = 21.5 },\n		alarm = { forward = 3, side = -12 },\n		patrol = {\n			{ forward = 32, side = 14 },\n			{ forward = 8, side = -6 },\n		},\n		richness = 1,\n	},\n}\n\n-- Loud at require time rather than at the moment somebody walks into the lobby, which is\n-- the standing rule for content in this tree.\nlocal seen: { [string]: boolean } = {}\nfor index, bank in Banks do\n	if bank.place == \"\" then\n		error(`[AGES content] Vaults[{index}] has no place id. Every bank must name a place point.`)\n	end\n	if seen[bank.place] then\n		error(\n			`[AGES content] two banks claim the place \"{bank.place}\". `\n				.. `A place point can only hold one vault -- remove one of them from Vaults.luau.`\n		)\n	end\n	seen[bank.place] = true\n\n	if bank.richness <= 0 then\n		error(\n			`[AGES content] bank \"{bank.place}\" has richness {bank.richness}. `\n				.. `A vault worth nothing is a room the player opens once and never returns to; `\n				.. `remove it from Vaults.luau instead.`\n		)\n	end\n\n	if #bank.patrol < 2 then\n		error(\n			`[AGES content] bank \"{bank.place}\" has {#bank.patrol} patrol spot(s). `\n				.. `A guard with fewer than two stands still, and a guard who stands still is a `\n				.. `fixed obstacle rather than a rhythm to read -- give him somewhere to walk to.`\n		)\n	end\n\n	-- The one relationship in this file that can be wrong without looking wrong. A panel\n	-- next to the vault would leave the whole activity intact and completely free, because\n	-- silencing the alarm would cost nothing at all -- and nothing else in the tree would\n	-- have anything to say about it.\n	local apart = math.sqrt(\n		(bank.vault.forward - bank.alarm.forward) ^ 2 + (bank.vault.side - bank.alarm.side) ^ 2\n	)\n	if apart < 20 then\n		error(\n			`[AGES content] bank \"{bank.place}\" has its alarm panel {string.format(\"%.1f\", apart)} studs `\n				.. `from its vault. The walk between them is the entire cost of silencing the alarm, so a `\n				.. `panel this close makes the robbery free. Move one of them in Vaults.luau.`\n		)\n	end\n\n	-- Everything has to be inside the room the session is held by, or the player would be\n	-- dropped out of their own robbery by walking to the thing the robbery is about.\n	local function within(what: string, spot: Offset)\n		local reach = math.sqrt(spot.forward ^ 2 + spot.side ^ 2)\n		if reach > bank.roomStuds then\n			error(\n				`[AGES content] bank \"{bank.place}\" puts its {what} {string.format(\"%.1f\", reach)} studs `\n					.. `from the place point but only counts {bank.roomStuds} as inside. Walking to it would `\n					.. `end the robbery. Raise roomStuds or move it in Vaults.luau.`\n			)\n		end\n	end\n	within(\"vault\", bank.vault)\n	within(\"alarm panel\", bank.alarm)\n	for spotIndex, spot in bank.patrol do\n		within(`patrol spot {spotIndex}`, spot)\n	end\nend\n\nVaults.Banks = Banks\n\n-- Nil for a place with no vault in it, which is every place in town but one. Every caller\n-- handles that rather than being handed a default.\nfunction Vaults.Get(place: string): Bank?\n	for _, bank in Banks do\n		if bank.place == place then\n			return bank\n		end\n	end\n	return nil\nend\n\nreturn Vaults\n"
table.insert(AGES_MANIFEST, "src/server/content/Vaults.luau")
AGES_SOURCES["src/server/content/Vehicles.luau"] = "--!strict\n-- The cars the dealership sells. Content data, not system code: the numbers here\n-- are what a car *is*, and adding a sixth one to the lot should be a table entry\n-- rather than a new build in Studio.\n--\n-- Sized and coloured rather than modelled, on the same reasoning Props.luau gives\n-- at length: a car built from a block and two cylinders per wheel needs nothing\n-- bought or uploaded, so the showroom exists and drives correctly on the day this\n-- file is written rather than on the day somebody finishes five car meshes. A real\n-- model dropped into the Studio folder under a matching name takes over -- see\n-- world/VehicleChassis.luau -- and nothing here changes when it does.\n--\n-- Five cars, priced as a ladder against the same jobs a life is actually earning\n-- from -- see content/Jobs.luau for the salaries this is read against. A beater a\n-- sixteen-year-old can save toward from a first job's wage, up through a car that\n-- means the manager's desk paid off, to one that is a statement rather than a\n-- commute. Performance climbs with price, and it is the only thing that does:\n-- there is no car here that is simply worse for the same money than another one\n-- on the lot, because a strictly-dominated row is a row nobody would ever choose\n-- and a showroom is not supposed to have those.\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Config = require(ReplicatedStorage:WaitForChild(\"Config\"))\nlocal Types = require(ReplicatedStorage:WaitForChild(\"Types\"))\n\ntype VehicleKind = Types.VehicleKind\n\nlocal SOURCE: { VehicleKind } = {\n	{\n		id = \"runabout\",\n		name = \"Corner Runabout\",\n		-- Priced against a first job's wage the way Jobs.luau prices itself: a\n		-- season of shifts at the shop floor, not a single paycheque.\n		price = 2200,\n		size = Vector3.new(6.4, 2.6, 14.5),\n		color = Color3.fromRGB(212, 96, 70),\n		accentColor = Color3.fromRGB(40, 38, 36),\n		topSpeedStuds = 66,\n		acceleration = 9,\n		steerDegrees = 34,\n	},\n	{\n		id = \"sedan\",\n		name = \"Fairline Sedan\",\n		-- The car most lives actually own: nothing about it is the best on the\n		-- lot, and nothing about it is the worst.\n		price = 6400,\n		size = Vector3.new(7.0, 2.8, 16.5),\n		color = Color3.fromRGB(96, 110, 128),\n		accentColor = Color3.fromRGB(24, 24, 26),\n		topSpeedStuds = 80,\n		acceleration = 11,\n		steerDegrees = 30,\n	},\n	{\n		id = \"wagon\",\n		name = \"Elmhurst Wagon\",\n		-- The longest body on the lot and the widest turning circle to go with\n		-- it -- a family car should feel like one to drive, not just look like\n		-- one parked.\n		price = 8800,\n		size = Vector3.new(7.2, 2.9, 18.5),\n		color = Color3.fromRGB(150, 138, 108),\n		accentColor = Color3.fromRGB(58, 52, 40),\n		-- 81, not 76: the dominance check a few lines down refuses a car that\n		-- costs more than a cheaper one without beating it on top speed or\n		-- acceleration, and at 76 this lost to the $6400 sedan's 80 on both\n		-- axes -- a strictly worse car nobody would ever buy, which threw at\n		-- require time and took the whole server down with it (nothing after\n		-- VehicleService in init.server.luau's boot order ever ran). One stud\n		-- over the sedan is enough to clear the check without pretending a\n		-- wagon this size outruns a coupe.\n		topSpeedStuds = 81,\n		acceleration = 10,\n		steerDegrees = 26,\n	},\n	{\n		id = \"coupe\",\n		name = \"Vantage Coupe\",\n		-- The manager's-desk car. Priced to want the second job's rung, not the\n		-- first one, and the numbers say so before the colour does.\n		price = 15500,\n		size = Vector3.new(6.8, 2.3, 15.5),\n		color = Color3.fromRGB(224, 200, 60),\n		accentColor = Color3.fromRGB(30, 28, 24),\n		topSpeedStuds = 100,\n		acceleration = 15,\n		steerDegrees = 36,\n	},\n	{\n		id = \"roadster\",\n		name = \"Solari Roadster\",\n		-- The statement, and the top of the ladder deliberately: low, narrow,\n		-- and the only car here whose steer rating is as sharp as the cheapest\n		-- one on the lot at a third again the top speed. Nothing subtle about\n		-- what this one is for.\n		price = 28000,\n		size = Vector3.new(6.6, 2.0, 14.8),\n		color = Color3.fromRGB(200, 32, 44),\n		accentColor = Color3.fromRGB(18, 18, 20),\n		topSpeedStuds = 126,\n		acceleration = 19,\n		steerDegrees = 34,\n	},\n}\n\n-- Loud at require time rather than at the moment somebody walks into the showroom,\n-- which is the standing rule for content in this tree.\nlocal byId: { [string]: VehicleKind } = {}\nfor _, vehicle in SOURCE do\n	if byId[vehicle.id] ~= nil then\n		error(`[AGES content] duplicate vehicle id \"{vehicle.id}\"`)\n	end\n	if vehicle.price <= 0 then\n		error(`[AGES content] vehicle \"{vehicle.id}\" has a price of {vehicle.price}; a free car is not a sale`)\n	end\n	if vehicle.size.X <= 0 or vehicle.size.Y <= 0 or vehicle.size.Z <= 0 then\n		error(`[AGES content] vehicle \"{vehicle.id}\" has a zero or negative size`)\n	end\n	if vehicle.topSpeedStuds <= 0 then\n		error(`[AGES content] vehicle \"{vehicle.id}\" has a topSpeedStuds of {vehicle.topSpeedStuds}; it would never move`)\n	end\n	if vehicle.acceleration <= 0 then\n		error(`[AGES content] vehicle \"{vehicle.id}\" has an acceleration of {vehicle.acceleration}; it would never reach its top speed`)\n	end\n	if vehicle.steerDegrees <= 0 or vehicle.steerDegrees > 60 then\n		error(\n			`[AGES content] vehicle \"{vehicle.id}\" has steerDegrees {vehicle.steerDegrees}, outside 0-60. `\n				.. `Above 60 a chassis this length starts folding into itself on a full lock.`\n		)\n	end\n	byId[vehicle.id] = vehicle\nend\n\n-- No two cars may cost the same and be strictly worse on both of the numbers a\n-- player can actually feel -- see the header. Caught here rather than left to be\n-- noticed in the showroom, because a dominated row is the one kind of content bug\n-- that looks like a design choice until somebody buys the better car and never\n-- looks back at the worse one.\nfor _, cheaper in SOURCE do\n	for _, pricier in SOURCE do\n		if pricier.price <= cheaper.price then\n			continue\n		end\n		if pricier.topSpeedStuds <= cheaper.topSpeedStuds and pricier.acceleration <= cheaper.acceleration then\n			error(\n				`[AGES content] vehicle \"{pricier.id}\" costs more than \"{cheaper.id}\" but is not faster and does`\n					.. ` not accelerate harder -- nobody would ever buy it. Raise one of its numbers in`\n					.. ` content/Vehicles.luau or drop the price.`\n			)\n		end\n	end\nend\n\nif #SOURCE == 0 then\n	error(\"[AGES content] there are no vehicles, so the dealership has nothing to sell\")\nend\n\nif #SOURCE > Config.Vehicles.MaxOwned * 3 then\n	-- Not a hard rule, just a sanity check: a garage cap of two on a lot of fifteen\n	-- cars would mean most of the lot can never be tried by anyone who already\n	-- owns something, which is a worse showroom than a smaller one.\n	warn(\n		`[AGES content] {#SOURCE} vehicles on the lot against a garage cap of {Config.Vehicles.MaxOwned}; `\n			.. `most of it will go untried by anyone who already owns two cars`\n	)\nend\n\nlocal Vehicles = {}\n\nVehicles.All = SOURCE\nVehicles.ById = byId\n\n-- Nil for an id nothing sells any more. Every caller handles that rather than\n-- being handed a default -- a saved life can own a car this build no longer\n-- lists, and erroring here would lock that life out of the garage entirely.\nfunction Vehicles.Get(id: string): VehicleKind?\n	return byId[id]\nend\n\nreturn Vehicles\n"
table.insert(AGES_MANIFEST, "src/server/content/Vehicles.luau")
AGES_SOURCES["src/server/content/Words.luau"] = "--!strict\n-- The words Reading asks you to finish.\n--\n-- Content, and a flat table rather than code for the reason Lessons gives about its own\n-- bank: a lesson is six words and a childhood is thirty-six lessons, so the thing that has\n-- to stay cheap is writing another one. A word is one line here and never touches the loop\n-- that puts it on the board.\n--\n-- Which letters are missing is **not** authored. Only how many are, and the service picks\n-- the positions when it deals the board. That split is deliberate and it is what stops this\n-- file being three times the size: authoring the gaps would mean deciding, for every word,\n-- which letters a child can infer -- which is a judgement the age band already makes, and\n-- making it twice would let the two disagree.\n--\n-- What is deliberately *not* here:\n--\n--   No definitions and no clues. The subject is finishing a word you can already half see,\n--   not knowing what it means -- a clue would turn this into a quiz with tiles, which is\n--   precisely the shape Curriculum spent a paragraph explaining the way out of.\n--\n--   No proper nouns, no names, nothing regional. A word whose spelling you either happen to\n--   have met or have not is a coin toss, and it is the same objection Lessons raises to\n--   trivia. Every word below is one a reader of that age has seen in print.\n--\n--   Nothing an eight-year-old at a keyboard would need an adult for. School is the part of\n--   this game most likely to be read over a shoulder.\n--\n-- US English, like everything else in the tree -- NEIGHBOR and PRACTICE are spelled the way\n-- the rest of the game spells them.\n--\n-- The age bands overlap heavily and on purpose. Eleven is a perfectly good age to still be\n-- handed WINTER, and a hard boundary would make a birthday feel like a different subject.\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Config = require(ReplicatedStorage:WaitForChild(\"Config\"))\n\nlocal Words = {}\n\n-- One word as content declares it. Local rather than exported to Types because nothing\n-- outside this file and its service ever holds one -- what leaves here is a dealt board,\n-- and that shape is in Types where the client can see it.\nexport type Word = {\n	id: string,\n	word: string,\n	-- How many letters are taken out. The positions are chosen when the board is dealt.\n	gaps: number,\n	minAge: number,\n	maxAge: number,\n}\n\nlocal SCHOOL_START = Config.School.StartAge\nlocal SCHOOL_END = Config.School.EndAge\nlocal READING = Config.School.Reading\n\nlocal SOURCE: { Word } = {\n	{ id = \"bread\", word = \"BREAD\", minAge = 6, maxAge = 9, gaps = 1 },\n	{ id = \"chair\", word = \"CHAIR\", minAge = 6, maxAge = 9, gaps = 1 },\n	{ id = \"river\", word = \"RIVER\", minAge = 6, maxAge = 10, gaps = 1 },\n	{ id = \"green\", word = \"GREEN\", minAge = 6, maxAge = 9, gaps = 1 },\n	{ id = \"stone\", word = \"STONE\", minAge = 6, maxAge = 10, gaps = 1 },\n	{ id = \"cloud\", word = \"CLOUD\", minAge = 6, maxAge = 10, gaps = 1 },\n	{ id = \"horse\", word = \"HORSE\", minAge = 6, maxAge = 10, gaps = 1 },\n	{ id = \"light\", word = \"LIGHT\", minAge = 6, maxAge = 11, gaps = 1 },\n	{ id = \"water\", word = \"WATER\", minAge = 6, maxAge = 10, gaps = 1 },\n	{ id = \"apple\", word = \"APPLE\", minAge = 6, maxAge = 9, gaps = 1 },\n	{ id = \"night\", word = \"NIGHT\", minAge = 6, maxAge = 11, gaps = 1 },\n	{ id = \"field\", word = \"FIELD\", minAge = 6, maxAge = 11, gaps = 1 },\n	{ id = \"garden\", word = \"GARDEN\", minAge = 8, maxAge = 13, gaps = 2 },\n	{ id = \"winter\", word = \"WINTER\", minAge = 8, maxAge = 13, gaps = 2 },\n	{ id = \"market\", word = \"MARKET\", minAge = 8, maxAge = 13, gaps = 2 },\n	{ id = \"silver\", word = \"SILVER\", minAge = 8, maxAge = 13, gaps = 2 },\n	{ id = \"bridge\", word = \"BRIDGE\", minAge = 8, maxAge = 13, gaps = 2 },\n	{ id = \"pocket\", word = \"POCKET\", minAge = 8, maxAge = 12, gaps = 2 },\n	{ id = \"kitchen\", word = \"KITCHEN\", minAge = 9, maxAge = 14, gaps = 2 },\n	{ id = \"morning\", word = \"MORNING\", minAge = 9, maxAge = 14, gaps = 2 },\n	{ id = \"harbour\", word = \"HARBOUR\", minAge = 9, maxAge = 14, gaps = 2 },\n	{ id = \"teacher\", word = \"TEACHER\", minAge = 9, maxAge = 14, gaps = 2 },\n	{ id = \"weather\", word = \"WEATHER\", minAge = 9, maxAge = 14, gaps = 2 },\n	{ id = \"station\", word = \"STATION\", minAge = 9, maxAge = 15, gaps = 2 },\n	{ id = \"blanket\", word = \"BLANKET\", minAge = 9, maxAge = 14, gaps = 2 },\n	{ id = \"machine\", word = \"MACHINE\", minAge = 10, maxAge = 15, gaps = 2 },\n	{ id = \"journey\", word = \"JOURNEY\", minAge = 10, maxAge = 15, gaps = 2 },\n	{ id = \"cabinet\", word = \"CABINET\", minAge = 10, maxAge = 15, gaps = 2 },\n	{ id = \"distance\", word = \"DISTANCE\", minAge = 11, maxAge = 17, gaps = 3 },\n	{ id = \"evidence\", word = \"EVIDENCE\", minAge = 12, maxAge = 17, gaps = 3 },\n	{ id = \"argument\", word = \"ARGUMENT\", minAge = 12, maxAge = 17, gaps = 3 },\n	{ id = \"pressure\", word = \"PRESSURE\", minAge = 12, maxAge = 17, gaps = 3 },\n	{ id = \"interest\", word = \"INTEREST\", minAge = 12, maxAge = 17, gaps = 3 },\n	{ id = \"practice\", word = \"PRACTICE\", minAge = 11, maxAge = 17, gaps = 3 },\n	{ id = \"neighbor\", word = \"NEIGHBOR\", minAge = 11, maxAge = 17, gaps = 3 },\n	{ id = \"stubborn\", word = \"STUBBORN\", minAge = 12, maxAge = 17, gaps = 3 },\n	{ id = \"hospital\", word = \"HOSPITAL\", minAge = 11, maxAge = 17, gaps = 3 },\n	{ id = \"remember\", word = \"REMEMBER\", minAge = 11, maxAge = 17, gaps = 3 },\n	{ id = \"sentence\", word = \"SENTENCE\", minAge = 11, maxAge = 17, gaps = 3 },\n	{ id = \"question\", word = \"QUESTION\", minAge = 11, maxAge = 17, gaps = 3 },\n	{ id = \"daughter\", word = \"DAUGHTER\", minAge = 11, maxAge = 17, gaps = 3 },\n	{ id = \"engineer\", word = \"ENGINEER\", minAge = 13, maxAge = 17, gaps = 3 },\n	{ id = \"laughter\", word = \"LAUGHTER\", minAge = 11, maxAge = 17, gaps = 3 },\n	{ id = \"thousand\", word = \"THOUSAND\", minAge = 11, maxAge = 17, gaps = 3 },\n	{ id = \"attention\", word = \"ATTENTION\", minAge = 13, maxAge = 17, gaps = 3 },\n	{ id = \"difficult\", word = \"DIFFICULT\", minAge = 13, maxAge = 17, gaps = 3 },\n	{ id = \"furniture\", word = \"FURNITURE\", minAge = 13, maxAge = 17, gaps = 3 },\n	{ id = \"important\", word = \"IMPORTANT\", minAge = 13, maxAge = 17, gaps = 3 },\n	{ id = \"carpenter\", word = \"CARPENTER\", minAge = 13, maxAge = 17, gaps = 3 },\n	{ id = \"orchestra\", word = \"ORCHESTRA\", minAge = 13, maxAge = 17, gaps = 3 },\n}\n\n-- Validated at require time rather than found in play, and loudly, for the reason\n-- Curriculum and Bullies both state: a word with a broken band does not error, it silently\n-- never appears, and a bank that quietly stopped covering the early years would present as\n-- a lesson that refuses at the door for no reason.\nlocal byId: { [string]: Word } = {}\nfor _, entry in SOURCE do\n	if byId[entry.id] ~= nil then\n		error(`[AGES content] duplicate word id \"{entry.id}\"`)\n	end\n	if entry.word ~= string.upper(entry.word) then\n		error(\n			`[AGES content] word \"{entry.id}\" is written \"{entry.word}\" -- the board draws these as`\n				.. ` given, and a lower-case tile beside upper-case ones reads as a different alphabet.`\n				.. ` Write it in capitals.`\n		)\n	end\n	if string.match(entry.word, \"^%u+$\") == nil then\n		error(\n			`[AGES content] word \"{entry.id}\" is \"{entry.word}\", which has something in it that is not`\n				.. ` a letter. A tile can only carry a letter.`\n		)\n	end\n	if entry.gaps < 1 then\n		error(`[AGES content] word \"{entry.id}\" has {entry.gaps} gaps, so there is nothing to build.`)\n	end\n	if entry.gaps >= #entry.word then\n		error(\n			`[AGES content] word \"{entry.id}\" is {#entry.word} letters with {entry.gaps} gaps, which`\n				.. ` leaves nothing standing. A word with every letter missing is not a word, it is a`\n				.. ` row of empty squares -- leave at least one.`\n		)\n	end\n	if entry.minAge > entry.maxAge then\n		error(\n			`[AGES content] word \"{entry.id}\" has minAge {entry.minAge} above maxAge {entry.maxAge}`\n				.. ` -- it would never be dealt. Swap them.`\n		)\n	end\n	if entry.maxAge < SCHOOL_START or entry.minAge > SCHOOL_END then\n		error(\n			`[AGES content] word \"{entry.id}\" is taught between {entry.minAge} and {entry.maxAge},`\n				.. ` entirely outside the school years {SCHOOL_START}-{SCHOOL_END} -- it would never be`\n				.. ` dealt. Widen the band.`\n		)\n	end\n	byId[entry.id] = entry\nend\n\n-- Every school year needs enough words to fill a whole lesson without repeating one.\n-- Checked here rather than discovered at the desk, because the failure mode is the same\n-- word arriving twice in one lesson, which reads as a bug in the dealer rather than as a\n-- thin bank.\nlocal NEEDED = READING.WordsPerLesson + READING.TargetsAtOnce\nfor age = SCHOOL_START, SCHOOL_END do\n	local count = 0\n	for _, entry in SOURCE do\n		if age >= entry.minAge and age <= entry.maxAge then\n			count += 1\n		end\n	end\n	if count < NEEDED then\n		error(\n			`[AGES content] age {age} has only {count} words but a lesson needs {NEEDED}`\n				.. ` (WordsPerLesson plus the {READING.TargetsAtOnce} standing on the board at the end).`\n				.. ` Write more words for that age in content/Words.luau or widen a band.`\n		)\n	end\nend\n\n-- The longest gap count anywhere in the bank, against the tray. A tray that cannot cover\n-- two full boards is a lesson that can deadlock with tiles in hand and nowhere to put them,\n-- and that is a content fault rather than a player mistake -- so it is refused here.\nlocal widest = 0\nfor _, entry in SOURCE do\n	if entry.gaps > widest then\n		widest = entry.gaps\n	end\nend\nif READING.Tray.Size - READING.Tray.Decoys < widest * READING.TargetsAtOnce then\n	error(\n		`[AGES config] the tray deals {READING.Tray.Size} tiles of which {READING.Tray.Decoys} are`\n			.. ` decoys, leaving {READING.Tray.Size - READING.Tray.Decoys} useful ones -- but`\n			.. ` {READING.TargetsAtOnce} words of up to {widest} gaps each can need`\n			.. ` {widest * READING.TargetsAtOnce}. Raise Tray.Size, lower Tray.Decoys, or lower the`\n			.. ` gap count on the widest word.`\n	)\nend\n\n-- The words this age can be dealt, in declaration order. Never empty inside the school\n-- years by the check above.\nfunction Words.ForAge(age: number): { Word }\n	local out: { Word } = {}\n	for _, entry in SOURCE do\n		if age >= entry.minAge and age <= entry.maxAge then\n			table.insert(out, entry)\n		end\n	end\n	return out\nend\n\n-- Nil for an id that is not in the bank. Callers holding one from a live board must handle\n-- that: a word removed from content is a word a running lesson may still have on the board.\nfunction Words.Get(id: string): Word?\n	return byId[id]\nend\n\nWords.All = SOURCE\n\nreturn Words\n"
table.insert(AGES_MANIFEST, "src/server/content/Words.luau")
AGES_SOURCES["src/server/content/Zones.luau"] = "--!strict\n-- Named zones in the world. A zone is a named region of the house — the gym,\n-- the backyard, the school lab — and this table is the index that maps a\n-- string id to the zone record so the proximity layer can report \"you are in\n-- the gym\" rather than \"you are standing near a tagged part\".\n--\n-- Zones are authoring-time objects: they are populated in Studio by tagging\n-- parts and reading the AgesZoneId attribute, not built at runtime. The table\n-- lives here so the rest of the server has one place to ask \"what zone is\n-- this id?\" without re-deriving the name from the geometry.\n--\n-- Empty at baseline. The first zones ship with the gym floor and the school\n-- lab; everything else is filled in when the corresponding building exists.\n\n--!strict\n-- Named zones in the world. A zone is a named region of the house -- the gym,\n-- the backyard, the school lab -- and this table is the index that maps a\n-- string id to the zone record so the proximity layer can report \"you are in\n-- the gym\" rather than \"you are standing near a tagged part\".\n--\n-- Zones are authoring-time objects: they are populated in Studio by tagging\n-- parts and reading the AgesZoneId attribute, not built at runtime. The table\n-- lives here so the rest of the server has one place to ask \"what zone is\n-- this id?\" without re-deriving the name from the geometry.\n--\n-- Empty at baseline. The first zones ship with the gym floor and the school\n-- lab; everything else is filled in when the corresponding building exists.\n\nlocal Zones: { [string]: { tag: string } } = {}\n\nreturn Zones\n"
table.insert(AGES_MANIFEST, "src/server/content/Zones.luau")
AGES_SOURCES["src/server/init.server.luau"] = "--!strict\n-- Server bootstrap. Requires every service and drives the Init() / Start()\n-- lifecycle in dependency order: data must be loadable before stats can be\n-- read, money must be pushable before an event can charge for a choice, pocket\n-- money must have caught up a loaded profile's ledger before that profile can have\n-- a birthday and be paid off it, stats\n-- must exist before aging can decay or kill them, events must be\n-- listening before a birthday can offer one, enactment must have registered its\n-- handler before the first event is offered or that one silently arrives as a\n-- panel, scenes must likewise have registered before the first event or the dog\n-- the prompt is about never turns up, the body must be watching for spawns before\n-- a birthday resizes it, and the world can only offer events once there is an\n-- engine to ask. Places must be indexed before anything can be sent to one --\n-- it depends on nothing itself, being only an index of what is already built,\n-- so it sits as early as the first thing that will want to name a room.\n-- Visitors must\n-- be sweepable before anything can send one, and deliveries come last of the real\n-- services because they register a handler on the world and restore whatever\n-- players left standing in it. Work comes after both, because clocking on needs\n-- somewhere to clock on at and a shift can raise an event on the same terms as\n-- anything else. School sits beside work and after it, needing the same three\n-- things -- a place to be, a profile to read and stats to move -- and wiring up to\n-- nothing, which is why it is the one service here with no Init to call.\n-- People sit after both and last of the real services, because putting somebody in\n-- the world needs everything the two before it needed plus a visitor to build --\n-- a place to stand at, a profile to read an age and a bond off, stats and money to\n-- pay an offer out into, and NPCService swept clean so a Rojo sync mid-session does\n-- not leave a second mother behind. It wires up to nothing, so like school it has no\n-- Init to call. CompanionService has no order of its own -- it is a mechanic, and\n-- PeopleService is the only thing that calls into it -- but it wires its PlayerRemoving\n-- hook with an Init like the others, and its Start is a no-op kept for symmetry.\n-- DebugService is last of all because it drives the others, and no-ops outside\n-- Studio.\n\nlocal services = script.services\n\nlocal DataService = require(services.DataService)\nlocal StatService = require(services.StatService)\nlocal MoneyService = require(services.MoneyService)\nlocal PocketMoneyService = require(services.PocketMoneyService)\nlocal EventService = require(services.EventService)\nlocal EnactService = require(services.EnactService)\nlocal PropService = require(services.PropService)\nlocal SceneService = require(services.SceneService)\nlocal BodyService = require(services.BodyService)\nlocal LifeService = require(services.LifeService)\nlocal WorldEventService = require(services.WorldEventService)\nlocal PlaceService = require(services.PlaceService)\nlocal NPCService = require(services.NPCService)\nlocal StadiumCrowdService = require(services.StadiumCrowdService)\nlocal StadiumEntranceService = require(services.StadiumEntranceService)\nlocal CompanionService = require(services.CompanionService)\nlocal DeliveryService = require(services.DeliveryService)\nlocal WorkService = require(services.WorkService)\nlocal SchoolService = require(services.SchoolService)\nlocal ScienceService = require(services.ScienceService)\nlocal GeographyService = require(services.GeographyService)\nlocal ArtService = require(services.ArtService)\nlocal BullyService = require(services.BullyService)\nlocal ReadingService = require(services.ReadingService)\nlocal MusicService = require(services.MusicService)\nlocal PEService = require(services.PEService)\nlocal SchoolCrowdService = require(services.SchoolCrowdService)\nlocal FixtureService = require(services.FixtureService)\nlocal BountyService = require(services.BountyService)\nlocal PoliceService = require(services.PoliceService)\nlocal TheftService = require(services.TheftService)\nlocal BankService = require(services.BankService)\nlocal GangService = require(services.GangService)\nlocal TerritoryService = require(services.TerritoryService)\nlocal SkillService = require(services.SkillService)\nlocal SettingsService = require(services.SettingsService)\nlocal CodeService = require(services.CodeService)\nlocal WitnessService = require(services.WitnessService)\nlocal DisguiseService = require(services.DisguiseService)\nlocal GymService = require(services.GymService)\nlocal FightService = require(services.FightService)\nlocal PeopleService = require(services.PeopleService)\nlocal ChildhoodService = require(services.ChildhoodService)\nlocal SetupService = require(services.SetupService)\nlocal ReturnService = require(services.ReturnService)\nlocal DebugService = require(services.DebugService)\nlocal HouseService = require(services.HouseService)\nlocal CarDealerService = require(services.CarDealerService)\nlocal VehicleService = require(services.VehicleService)\nlocal BillService = require(services.BillService)\nlocal SavingsService = require(services.SavingsService)\nlocal MilestoneService = require(services.MilestoneService)\nlocal GossipService = require(services.GossipService)\nlocal CrimeService = require(services.CrimeService)\nlocal ApartmentDoorService = require(services.ApartmentDoorService)\n\nDataService:Init()\nSchoolCrowdService:Init()\nStatService:Init()\nMoneyService:Init()\nPocketMoneyService:Init()\nEventService:Init()\nEnactService:Init()\nPropService:Init()\nSceneService:Init()\nBodyService:Init()\n-- Before LifeService, which hands it the function that starts a life. Only the Init\n-- order is cosmetic here -- every Init runs before every Start -- but reading it in the\n-- other order invites somebody to \"fix\" the Start order below, which is not cosmetic.\nSetupService:Init()\nLifeService:Init()\nWorldEventService:Init()\nPlaceService:Init()\nNPCService:Init()\n-- After NPCService, whose Spawn it calls, and after PlaceService only incidentally --\n-- it reads its anchors from CollectionService tags gen_city.py salted into the bowl,\n-- not from a place point.\nStadiumCrowdService:Init()\n-- Same tag-reading shape as StadiumCrowdService immediately above, and the\n-- same reason it sits here: after NPCService, whose Spawn the fan beat calls.\nStadiumEntranceService:Init()\nCompanionService:Init()\nDeliveryService:Init()\nWorkService:Init()\nTheftService:Init()\nBankService:Init()\nGangService:Init()\nTerritoryService:Init()\n-- No ordering to honour: it reads DataService and nothing else, and every service that\n-- awards into it does so from a handler that runs long after boot.\nSkillService:Init()\n-- Both connect a PlayerAdded that pushes a pane, so both have to be wired before the\n-- first player can arrive -- which is what Init is for, and why neither is left to Start.\nSettingsService:Init()\nCodeService:Init()\nReturnService:Init()\nDebugService:Init()\n\nDataService:Start()\nStatService:Start()\nMoneyService:Start()\nPocketMoneyService:Start()\nEventService:Start()\nEnactService:Start()\nPropService:Start()\nSceneService:Start()\n-- ReturnService must start before BodyService: its onPlayerAdded hook calls\n-- SetupService.Skip to create a fresh child life, and that has to happen\n-- before BodyService's watch applies the (then-adult) size to the character.\nReturnService:Start()\nBodyService:Start()\nLifeService:Start()\nWorldEventService:Start()\nPlaceService:Start()\nNPCService:Start()\nStadiumCrowdService:Start()\nStadiumEntranceService:Start()\nCompanionService:Start()\nDeliveryService:Start()\nWorkService:Start()\nApartmentDoorService:Init()\nApartmentDoorService:Start()\nHouseService:Init()\nCarDealerService:Init()\n-- Beside CarDealerService: same building, same two dependencies already up by\n-- this point -- PlaceService to find the counter, MoneyService to charge for a\n-- car. Owns nothing CarDealerService reads and is read by nothing of its own,\n-- so the two can sit in either order; grouped here because they are the same\n-- showroom floor.\nVehicleService:Init()\nBillService:Init()\nSavingsService:Init()\nMilestoneService:Init()\nGossipService:Init()\nCrimeService:Init()\nHouseService:Start()\nCarDealerService:Start()\nVehicleService:Start()\nBillService:Start()\nSavingsService:Start()\nMilestoneService:Start()\nGossipService:Start()\nCrimeService:Start()\n-- Before SchoolService, which hands a Science, Geography, Art, Reading or Music lesson\n-- straight to whichever of these owns the verb. Cosmetic like every other line in this list\n-- -- all six are running before the first player finishes loading -- but reading it in this\n-- order is the truth about which owns which.\nScienceService:Start()\nGeographyService:Start()\nArtService:Start()\nReadingService:Start()\nMusicService:Start()\nPEService:Start()\nSchoolCrowdService:Start()\nFixtureService:Start()\nSchoolService:Start()\n-- After the lessons, and it does not matter, which is worth saying because it looks as\n-- though it should. The corridor holds no verb of its own and hands nothing to anybody --\n-- it lays a room around the same school place point the lessons use and then waits for\n-- somebody to walk down it. Nothing in school reads it and it reads nothing in school.\nBullyService:Start()\n-- Heat before the officers, because the officers are a function of it: PoliceService's\n-- first tick asks BountyService how many bodies the street should have, and a police force\n-- that started answering before there was a number to answer from would spend its opening\n-- pass reading zero. Cosmetic in practice -- both are running long before anybody commits\n-- a crime -- but the dependency runs this way and only this way, and the list should say so.\nBountyService:Start()\nPoliceService:Start()\n-- After both, and it has to be: standing up a till reads the place index, and the first\n-- thing a robbery does is hand heat to BountyService and a sighting with it. It also has\n-- an Init, unlike the two above -- the drawer is held with a button and the button is a\n-- remote, so there is a handler to register before anybody can be standing at a counter.\nTheftService:Start()\n-- The bank, next to the till because they are the same half of the same system read from\n-- opposite ends, and after it for the same two reasons: standing up a vault reads the place\n-- index, and the first thing a trip does is hand heat to BountyService. It also spawns a\n-- guard, which is an NPCService rig -- and NPCService is already up, several lines above.\nBankService:Start()\n-- The gang, after every system that pays it. Standing a boss up reads the place index and\n-- spawns an NPCService rig, so both of those have to be up -- but the ordering that actually\n-- matters is against BountyService: a gang tick reads the player's live bounty to decide\n-- whether an escape happened, and a tick that ran before the manhunt existed would read a\n-- zero and quietly award nothing for the best thing the player did all life.\nGangService:Start()\n-- After GangService, and the order is load-bearing in one direction only: a crossing\n-- reads who you run with and whether the band is on, both of which are GangService's\n-- answers, and it charges standing through it. Nothing in GangService ever asks where\n-- anybody is standing, so the dependency does not come back the other way.\n--\n-- Also after PlaceService is up, because the four sides are grown from the four bosses'\n-- place points -- though that one is not an ordering problem: the sites are re-read\n-- until all four resolve, precisely so a boss that has not streamed in yet cannot pin\n-- an empty map for the life of the server.\nTerritoryService:Start()\nSkillService:Start()\nSettingsService:Start()\nCodeService:Start()\n-- The escape, after the heat it undoes. Standing up a mark reads the place index, and the\n-- first thing a completed change does is delete a belief BountyService owns.\nDisguiseService:Start()\nGymService:Start()\n-- The fight, after NPCService because squaring somebody up spawns a rig, and after\n-- StatService because the pool a player has to spend is read off their health the moment a\n-- bout opens. Both are up well above this, and so is BountyService: FightService cannot\n-- require it back without closing the LifeService -> FightService -> BountyService cycle\n-- (see the comment on FightService.SetWitnessedHandler), so the wiring happens here\n-- instead, the same way CrimeService wires BountyService.SetArrestedHandler.\nFightService:Start()\nFightService.SetWitnessedHandler(function(player: Player, points: number, reason: string, at: Vector3)\n	BountyService.Seen(player, points, reason, at)\nend)\nPeopleService:Start()\n-- Dead last of the crime services, and after PeopleService rather than before it. The crowd\n-- is the only part of this that reads bodies somebody else put in the street: a witness pass\n-- that ran before there was anybody standing in the town would spend its first ticks\n-- reporting an empty street, and the whole system would look broken for exactly as long as\n-- it took the first person to spawn.\nWitnessService:Start()\nChildhoodService:Start()\n-- ReturnService already started above, before BodyService, so the child life is in place\n-- before the body is sized. DebugService still runs last because it drives the other\n-- services and no-ops outside Studio.\nDebugService:Start()\n\n-- **The new school's interactive layer.**\n--\n-- Last, and outside the Init/Start pairs above, because it is not a service: it takes no\n-- players, holds no state and answers no remotes. It walks Workspace.ProperSchool once and\n-- hangs prompts, seats, lights and doors on what is already there.\n--\n-- Wrapped in a pcall on purpose. The whole of it depends on a baked asset being mounted, and\n-- an asset that has not synced yet is a missing-model warning rather than a reason the rest of\n-- the server should fail to boot. It says so and the game carries on.\nlocal okSchool, schoolErr = pcall(function()\n	require(script.world.ProperSchool.Interactive).Build()\nend)\nif not okSchool then\n	warn(`[ProperSchool] interactive layer did not build: {schoolErr}`)\nend\n\n-- The same for the editable copy of v1, in its own pcall. Two sandboxes that must not be able\n-- to break each other or the game: whichever model is missing, the other still wires up.\nlocal okCopy, copyErr = pcall(function()\n	require(script.world.SchoolCopyInteractive).Build()\nend)\nif not okCopy then\n	warn(`[SchoolV1Copy] interactive layer did not build: {copyErr}`)\nend\n\nprint(\"[AGES] Server started\")\n"
table.insert(AGES_MANIFEST, "src/server/init.server.luau")
AGES_SOURCES["src/server/services/ApartmentDoorService.luau"] = "--!strict\n-- Apartment entrance doors. Each door is a tagged part in the generated world;\n-- this service attaches an interaction prompt so the player can open/close it.\n\nlocal CollectionService = game:GetService(\"CollectionService\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Config = require(ReplicatedStorage:WaitForChild(\"Config\"))\nlocal Interact = require(ReplicatedStorage:WaitForChild(\"world\"):WaitForChild(\"Interact\"))\nlocal Remotes = require(ReplicatedStorage:WaitForChild(\"Remotes\"))\n\nlocal ApartmentDoorService = {}\n\n-- Remote to toggle the door state (open/closed)\nlocal REQUEST_TOGGLE_DOOR = Remotes.Get(\"RequestToggleApartmentDoor\")\n\n-- Track door state: doorPart -> {hinge, isOpen}\nlocal doorStates: { [BasePart]: { hinge: CFrame, isOpen: boolean } } = {}\n\n-- Initialize by finding all tagged apartment doors\nfunction ApartmentDoorService:Init()\n	local tag = \"ApartmentDoor\"\n	local instances = CollectionService:GetTagged(tag)\n\n	for _, instance in instances do\n		if instance:IsA(\"BasePart\") then\n			self:setupDoor(instance :: BasePart)\n		else\n			warn(`[AGES] ApartmentDoor tagged instance \"{instance:GetFullName()}\" is not a BasePart`)\n		end\n	end\n\n	-- Listen for new doors being tagged (e.g., during Studio editing)\n	CollectionService:GetInstanceAddedSignal(tag):Connect(function(instance: Instance)\n		if instance:IsA(\"BasePart\") then\n			self:setupDoor(instance :: BasePart)\n		end\n	end)\n\n	CollectionService:GetInstanceRemovedSignal(tag):Connect(function(instance: Instance)\n		if instance:IsA(\"BasePart\") then\n			doorStates[instance :: BasePart] = nil\n		end\n	end)\nend\n\nfunction ApartmentDoorService:Start()\n	-- Handle toggle requests from clients\n	REQUEST_TOGGLE_DOOR.OnServerEvent:Connect(function(player: Player, blockName: string)\n		local doorPart = self:findDoorByBlockName(blockName)\n		if doorPart then\n			self:toggleDoor(player, doorPart)\n		end\n	end)\nend\n\nfunction ApartmentDoorService:findDoorByBlockName(blockName: string): BasePart?\n	for doorPart, _ in doorStates do\n		local attr = doorPart:GetAttribute(\"ApartmentBlock\")\n		if attr == blockName then\n			return doorPart\n		end\n	end\n	return nil\nend\n\n-- Set up a single door part with interaction and initial state\nfunction ApartmentDoorService:setupDoor(doorPart: BasePart)\n	-- Calculate hinge position (left edge of door)\n	local size = doorPart.Size\n	local hinge = doorPart.CFrame * CFrame.new(-size.X / 2, 0, 0)\n\n	doorStates[doorPart] = {\n		hinge = hinge,\n		isOpen = false,\n	}\n\n	-- Get the apartment block name from the attribute\n	local blockName = doorPart:GetAttribute(\"ApartmentBlock\") or \"Apartment\"\n\n	-- Attach interaction prompt\n	Interact.Attach(doorPart, {\n		kind = \"Apartment\",\n		id = blockName,\n		actionText = \"Open\",\n		objectText = \"Apartment Door\",\n	})\n\n	-- Ensure door starts closed\n	doorPart.CFrame = hinge * CFrame.new(size.X / 2, 0, 0)\nend\n\n-- Toggle door open/closed\nfunction ApartmentDoorService:toggleDoor(player: Player, doorPart: BasePart)\n	local state = doorStates[doorPart]\n	if not state then\n		return\n	end\n\n	-- Check distance\n	local character = player.Character\n	if not character then\n		return\n	end\n	local pivot = character:GetPivot()\n	if (pivot.Position - doorPart.Position).Magnitude > Config.Interact.ReachStuds * 2 then\n		return\n	end\n\n	state.isOpen = not state.isOpen\n	local size = doorPart.Size\n	local swing = Config.ApartmentDoor.SwingDegrees\n	local targetCFrame = state.hinge * CFrame.Angles(0, math.rad(state.isOpen and -swing or 0), 0) * CFrame.new(size.X / 2, 0, 0)\n\n	-- Animate the door\n	local tweenInfo = TweenInfo.new(Config.ApartmentDoor.AnimationSeconds, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)\n	local tween = game:GetService(\"TweenService\"):Create(doorPart, tweenInfo, { CFrame = targetCFrame })\n	tween:Play()\n\n	-- Update interaction text\n	local prompt = doorPart:FindFirstChild(\"AgesInteract\")\n	if prompt and prompt:IsA(\"ProximityPrompt\") then\n		prompt.ActionText = state.isOpen and \"Close\" or \"Open\"\n	end\nend\n\nreturn ApartmentDoorService"
table.insert(AGES_MANIFEST, "src/server/services/ApartmentDoorService.luau")
AGES_SOURCES["src/server/services/ArtService.luau"] = "--!strict\n-- Art: the study. A small picture is pinned to the wall of the room and you copy it, cell\n-- by cell, onto a canvas.\n--\n-- The one line this file exists to protect:\n--\n--   **Science hides the board and asks you to remember. Art shows you everything and\n--   asks you to notice.**\n--\n-- The wall is always in the room. The canvas is always on screen. Neither is ever\n-- annotated -- nothing in this file or the panel it pushes to ever marks a cell as wrong,\n-- and the day something does, this subject stops existing and becomes a checklist with\n-- paint on it. `stale` is a count and there is deliberately no list next to it: being told\n-- you owe three cells and having to *find* them is the verb.\n--\n-- The rest of the loop, in the order it matters:\n--\n--   The picture moves. Part of every study is marked as free to shift -- the light turns,\n--   somebody nudges the fruit -- and cells you have already painted quietly stop being\n--   right. That single rule is where the second queue comes from: at any moment there is\n--   something unpainted to paint and something painted to repair, they compete for the\n--   same seconds, and neither is ever the obviously correct one.\n--\n--   Signing is a real commit, unlike the lab's. Your score is the canvas at the moment\n--   you sign it, and the canvas rots while you hold it, so finishing early is a genuine\n--   trade -- more coverage against keeping what you have. A player who paints twelve good\n--   cells and signs beats one who paints sixteen and lets four go stale.\n--\n--   Paint runs out and the cupboard is behind you. What that trip costs is not the\n--   seconds. It is sight of the wall -- see Studio for why the cupboard is where it is --\n--   so the shift that happens while you are fetching is the one you have no idea about.\n--\n--   Mastery hands you tubes, not numbers. Rung one gives you the two colours the picture\n--   is mostly made of; the rungs above give you the ones it is barely made of, which are\n--   exactly the sail, the hull and the highlight. At two tubes a perfect copy only just\n--   clears a pass; at the top there is slack in it for a corner you never reached. That\n--   is progression widening the player's own tolerance inside the verb, and it is checked\n--   against the content at require time below rather than hoped for.\n--\n-- What this file is deliberately not:\n--\n--   It is not a second school. The door, the yearly cap, the smarts payout and the\n--   verdict shares are School's, read from Config.School through Report, and a lesson\n--   that happens to be Art still spends one of the three lessons in the year.\n--\n--   It does not build the room, for the reason ScienceService does not build the lab.\n--\n--   It does not own the picture either, and that is the one structural difference from\n--   Science worth stating up front: the study is *the wall's*, not the session's. A wall\n--   can only hold one picture, so everybody painting at the same time is copying the same\n--   thing and living with the same shifts. See `wall` below.\n\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Config = require(ReplicatedStorage:WaitForChild(\"Config\"))\nlocal Remotes = require(ReplicatedStorage:WaitForChild(\"Remotes\"))\nlocal Types = require(ReplicatedStorage:WaitForChild(\"Types\"))\nlocal Lives = require(ReplicatedStorage:WaitForChild(\"Lives\"))\nlocal Pigments = require(ReplicatedStorage:WaitForChild(\"world\"):WaitForChild(\"Pigments\"))\nlocal Mastery = require(ReplicatedStorage:WaitForChild(\"school\"):WaitForChild(\"Mastery\"))\nlocal Report = require(ReplicatedStorage:WaitForChild(\"school\"):WaitForChild(\"Report\"))\n\nlocal DataService = require(script.Parent.DataService)\nlocal EventService = require(script.Parent.EventService)\nlocal StatService = require(script.Parent.StatService)\nlocal SkillService = require(script.Parent.SkillService)\nlocal Ground = require(script.Parent.Parent.world.Ground)\nlocal Studio = require(script.Parent.Parent.world.Studio)\nlocal Studies = require(script.Parent.Parent.content.Studies)\n\ntype LifeData = Types.LifeData\ntype ArtState = Types.ArtState\ntype PaletteSwatch = Types.PaletteSwatch\ntype Pigment = Pigments.Pigment\ntype Study = Studies.Study\n\nlocal ArtService = {}\n\nlocal ArtUpdatedRemote = Remotes.Get(\"ArtUpdated\")\nlocal RequestArtPaintRemote = Remotes.Get(\"RequestArtPaint\")\nlocal RequestArtSignRemote = Remotes.Get(\"RequestArtSign\")\n\nlocal SCHOOL = Config.School\nlocal ART = SCHOOL.Art\nlocal SKILL_AWARDS = Config.Skills.Awards\n\n-- The subject id this service answers to. A constant rather than a parameter because\n-- there is exactly one copying subject; the day there is a second, this becomes an\n-- argument and nothing else here changes.\nlocal SUBJECT_ID = \"art\"\n\nlocal CELLS = Studies.CellCount\n\n-- The two ladders have to be the same length, and this is the only place that can notice.\n-- A sixth rung on one and not the other is a promotion the verb has no answer for -- the\n-- player is told they levelled up and the palette does not change -- which is the\n-- numbers-only progression this whole rebuild exists to remove, arriving by accident.\nif #ART.PaletteByLevel ~= Mastery.Levels then\n	error(\n		`[AGES config] School.Art.PaletteByLevel has {#ART.PaletteByLevel} entries but School.Mastery.Levels`\n			.. ` is {Mastery.Levels}. Every mastery rung has to say how many tubes it hands over, so the list`\n			.. ` needs exactly one number per level. Add or remove one.`\n	)\nend\n\nfor level = 2, #ART.PaletteByLevel do\n	if ART.PaletteByLevel[level] < ART.PaletteByLevel[level - 1] then\n		error(\n			`[AGES config] School.Art.PaletteByLevel goes from {ART.PaletteByLevel[level - 1]} tubes at level`\n				.. ` {level - 1} down to {ART.PaletteByLevel[level]} at level {level}. Levelling up must never`\n				.. ` take paint away -- a rung that makes the picture worse is a punishment for playing well.`\n		)\n	end\nend\n\nif ART.PaletteByLevel[1] < 2 then\n	error(\n		`[AGES config] School.Art.PaletteByLevel starts at {ART.PaletteByLevel[1]} tube(s). With fewer than`\n			.. ` two there is nothing to choose between and painting is one button pressed sixteen times.`\n	)\nend\n\n-- How many tubes this rung hands over, clamped to the ladder. Off the top of the list\n-- rather than off the bottom, because a level above the ladder is a data problem and the\n-- right thing to do with it is give the player everything rather than nothing.\nlocal function tubeCountFor(level: number): number\n	local rung = math.clamp(math.floor(level), 1, #ART.PaletteByLevel)\n	return ART.PaletteByLevel[rung]\nend\n\n-- The tubes a study hands out at a given rung: its own colours, most-used first, cut to\n-- the rung's count. Truncated to what the picture actually contains, so a topped-out\n-- palette is \"every colour in this study\" rather than a row with three dead swatches on\n-- the end of it.\nlocal function paletteFor(study: Study, level: number): { Pigment }\n	local want = math.min(tubeCountFor(level), #study.byUse)\n	local out: { Pigment } = {}\n	for index = 1, want do\n		table.insert(out, study.byUse[index])\n	end\n	return out\nend\n\n-- The nearest tube in a palette to a colour on the wall. This is the best the player can\n-- possibly do for that cell, which makes it two things at once: the ceiling the require\n-- time check below measures, and the definition of a cell having gone stale.\n--\n-- Ties go to the earlier tube, which is the more-used one. Deterministic rather than\n-- arbitrary because \"which cells are stale\" has to mean the same thing on two consecutive\n-- ticks -- a tiebreak that wobbled would make the count flicker and send the player\n-- hunting for a difference that was never there.\nlocal function nearestTube(palette: { Pigment }, target: Pigment): (Pigment?, number)\n	local best: Pigment? = nil\n	local bestCloseness = -1\n	for _, tube in palette do\n		local closeness = Pigments.Closeness(tube, target)\n		if closeness > bestCloseness then\n			best = tube\n			bestCloseness = closeness\n		end\n	end\n	return best, math.max(bestCloseness, 0)\nend\n\n-- The best score a perfect painting could get at a given rung. Every cell painted with\n-- the nearest tube available, and nothing missed.\nlocal function ceilingFor(study: Study, level: number): number\n	local palette = paletteFor(study, level)\n	local total = 0\n	for _, target in study.cells do\n		local _, closeness = nearestTube(palette, target)\n		total += closeness\n	end\n	return total / CELLS\nend\n\n-- Checked against the actual content at require time, and this is the guard the whole\n-- ladder rests on. A first rung whose ceiling falls under GoodShare is a subject nobody\n-- can ever pass their way out of: you need good lessons to climb, and you cannot have a\n-- good lesson, and nothing in the game would say so -- the player would simply find that\n-- Art never rewards them and conclude the game is broken, which it would be.\n--\n-- Loud rather than clamped for the reason Science's is: clamping hides it. The lesson\n-- would run, the ladder would not, and no line anywhere would mention it.\nfor _, study in Studies.All do\n	local ceiling = ceilingFor(study, 1)\n	if ceiling < SCHOOL.GoodShare then\n		error(\n			`[AGES content] study \"{study.id}\" tops out at {string.format(\"%.3f\", ceiling)} on the first`\n				.. ` mastery rung, under School.GoodShare of {SCHOOL.GoodShare} -- a perfect copy of it could`\n				.. ` not pass, so nobody starting Art could ever climb out of level one. Either give the`\n				.. ` picture fewer or closer colours, or raise School.Art.PaletteByLevel[1].`\n		)\n	end\nend\n\n-- The picture currently on the wall.\n--\n-- Module state rather than session state, and it is the one place this verb's shape\n-- differs structurally from the lab's. A wall holds one picture. Two players painting at\n-- the same time are in one art class copying one still life and watching the same light\n-- move, which is both the honest thing and the only thing the physical room can express.\n--\n-- `truth` drifts away from `study.cells` as the study shifts, and it is what everything is\n-- scored against. `study.cells` stays as authored, which is what the palette is cut from:\n-- the paint you were handed at the start does not change when the light does.\ntype Wall = {\n	study: Study,\n	truth: { Pigment },\n	secondsToShift: number,\n}\n\nlocal wall: Wall? = nil\n\n-- One player's canvas.\ntype Session = {\n	-- Held so the palette and the score survive the wall being restudied out from under a\n	-- session -- which cannot currently happen, and would be a silent regrade if it ever\n	-- started to.\n	study: Study,\n	-- What the player has put down, one slot per cell. Sparse: nil is bare canvas.\n	painted: { [number]: Pigment },\n	palette: { Pigment },\n	-- Index into `palette`, or nil before the first tube is picked up.\n	held: number?,\n	strokes: number,\n	secondsLeft: number,\n	level: number,\n	passes: number,\n	levelAtStart: number,\n	atEasel: boolean,\n	atCupboard: boolean,\n	summary: string?,\n	verdictLeft: number,\n	notice: string?,\n	noticeLeft: number,\n}\n\nlocal sessions: { [Player]: Session } = {}\nlocal pushed: { [Player]: string } = {}\n\n-- Off by default is wrong for a subject and off by command is right for a harness. Same\n-- switch every other verb carries, and the reason it exists is that a broken activity\n-- should be turn-off-able in a live session without a rebuild.\nlocal enabled = true\n\nlocal function levelOf(data: LifeData): number\n	return Mastery.LevelOf(data, SUBJECT_ID)\nend\n\nlocal function passesOf(data: LifeData): number\n	return Mastery.PassesOf(data, SUBJECT_ID)\nend\n\n-- Where the player's body is, or nil while there is not one. Nil is a real state -- a\n-- respawning character has no root part for a few frames -- and every caller here treats\n-- it as \"do not know\" rather than as \"somewhere else\".\nlocal function characterPosition(player: Player): Vector3?\n	local character = player.Character\n	local root = if character ~= nil then character:FindFirstChild(\"HumanoidRootPart\") else nil\n	if root == nil or not root:IsA(\"BasePart\") then\n		return nil\n	end\n	return root.Position\nend\n\n-- How close a painted cell is to the wall right now, 0-1. Unpainted is zero, which is the\n-- whole reason coverage matters: an untouched cell is not a neutral cell, it is a wrong\n-- one, and a canvas half-finished is a canvas half-right at best.\nlocal function cellScore(session: Session, truth: { Pigment }, index: number): number\n	local put = session.painted[index]\n	if put == nil then\n		return 0\n	end\n	local target = truth[index]\n	if target == nil then\n		return 0\n	end\n	return Pigments.Closeness(put, target)\nend\n\nlocal function canvasShare(session: Session, truth: { Pigment }): number\n	local total = 0\n	for index = 1, CELLS do\n		total += cellScore(session, truth, index)\n	end\n	return math.clamp(total / CELLS, 0, 1)\nend\n\n-- How many painted cells are no longer the best this palette could do, and how many have\n-- any paint on them at all.\n--\n-- \"Stale\" is defined against the palette rather than against the wall on purpose. A\n-- player at two tubes who painted a red apple in ochre has done the best thing available\n-- to them, and calling that cell stale would send them back to repaint it with the same\n-- tube forever. What counts as owing work is *a cell where a better choice now exists*,\n-- which is exactly what a shift creates.\nlocal function tally(session: Session, truth: { Pigment }): (number, number)\n	local stale = 0\n	local filled = 0\n	for index = 1, CELLS do\n		local put = session.painted[index]\n		if put == nil then\n			continue\n		end\n		filled += 1\n		local target = truth[index]\n		if target == nil then\n			continue\n		end\n		local best = nearestTube(session.palette, target)\n		if best ~= nil and best.id ~= put.id then\n			stale += 1\n		end\n	end\n	return stale, filled\nend\n\n-- The truth to score against. The wall's if there is one, and the study as authored if\n-- the wall has somehow gone -- which cannot happen while a session is live, and would\n-- otherwise mean scoring a painting against nothing.\nlocal function truthFor(session: Session): { Pigment }\n	local current = wall\n	if current ~= nil then\n		return current.truth\n	end\n	return session.study.cells\nend\n\nlocal function stateFor(player: Player): ArtState?\n	local session = sessions[player]\n	if session == nil then\n		return nil\n	end\n\n	local truth = truthFor(session)\n	local stale, filled = tally(session, truth)\n\n	local painted: { Color3? } = {}\n	for index = 1, CELLS do\n		local put = session.painted[index]\n		painted[index] = if put ~= nil then put.color else nil\n	end\n\n	local palette: { PaletteSwatch } = {}\n	for _, tube in session.palette do\n		table.insert(palette, { id = tube.id, name = tube.name, color = tube.color })\n	end\n\n	return {\n		columns = ART.Columns,\n		rows = ART.Rows,\n		painted = painted,\n		title = session.study.name,\n		palette = palette,\n		held = session.held,\n		strokes = session.strokes,\n		strokesMax = ART.StrokesPerRefill,\n		stale = stale,\n		filled = filled,\n		secondsLeft = math.max(0, session.secondsLeft),\n		atEasel = session.atEasel,\n		atCupboard = session.atCupboard,\n		level = session.level,\n		levelMax = Mastery.Levels,\n		passes = session.passes,\n		passesPerLevel = Mastery.PassesPerLevel,\n		summary = session.summary,\n		notice = session.notice,\n	}\nend\n\nlocal function push(player: Player)\n	local state = stateFor(player)\n	-- A digest rather than a deep compare, and it has to name every field that is drawn.\n	--\n	-- The canvas goes in cell by cell rather than as some cheaper summary, because a\n	-- repaint that swaps one cell's colour for another moves nothing else in this payload:\n	-- not the filled count, not the stale count when both tubes were equally wrong, and\n	-- not the paint left when the correction was free. A digest that missed that case\n	-- would leave the panel showing the colour the player just painted over.\n	--\n	-- Like the hunt's, it saves nothing while the clock is running -- the clock is in here\n	-- at the tick's own resolution, so that term moves on every pass by construction. What\n	-- it saves is the beats where the clock is deliberately stopped: the closing line, and\n	-- the frames where the character has no position and the canvas is frozen mid-respawn.\n	-- Both hold for seconds, and both would otherwise re-send an identical sixteen-cell\n	-- snapshot four times a second for the whole of it.\n	local digest: string\n	if state == nil then\n		digest = \"none\"\n	else\n		local cells: { string } = {}\n		for index = 1, CELLS do\n			local color = state.painted[index]\n			cells[index] = if color == nil\n				then \"-\"\n				else `{math.floor(color.R * 255)},{math.floor(color.G * 255)},{math.floor(color.B * 255)}`\n		end\n		digest = `{table.concat(cells, \"|\")}#{#state.palette}/{tostring(state.held)}/{state.strokes}/`\n			.. `{state.stale}/{state.filled}/{math.floor(state.secondsLeft * 4)}/`\n			.. `{tostring(state.atEasel)}/{tostring(state.atCupboard)}/{state.level}/{state.passes}/`\n			.. `{tostring(state.summary)}/{tostring(state.notice)}`\n	end\n\n	if pushed[player] == digest then\n		return\n	end\n	pushed[player] = digest\n	ArtUpdatedRemote:FireClient(player, state)\nend\n\n-- Says no out loud. A refusal is a reply to a click and never a state to sit in, so it\n-- carries its own short clock and clears itself.\nlocal function refuse(player: Player, session: Session, reason: string)\n	session.notice = reason\n	session.noticeLeft = SCHOOL.VerdictSeconds\n	push(player)\nend\n\nlocal function forget(player: Player)\n	sessions[player] = nil\n	pushed[player] = nil\nend\n\n-- Takes the study down when the last painter has gone. Called from every path that ends a\n-- session, because a picture left hanging is the next lesson's answer already on the wall\n-- for anybody who walked past the room -- and because an art room with nobody in it should\n-- look like an art room with nobody in it.\nlocal function releaseWallIfEmpty()\n	if wall == nil then\n		return\n	end\n	for _, session in sessions do\n		if session.summary == nil then\n			return\n		end\n	end\n	wall = nil\n	Studio.Clear()\nend\n\n-- Puts a picture up, or joins the one already there. New only when the wall is free: two\n-- players in the room copy the same study, because the wall is a physical object and can\n-- only hold one.\nlocal function claimWall(): Wall?\n	local current = wall\n	if current ~= nil then\n		return current\n	end\n	if #Studies.All == 0 then\n		return nil\n	end\n\n	local study = Studies.All[math.random(1, #Studies.All)]\n	local truth: { Pigment } = table.clone(study.cells)\n	local made: Wall = {\n		study = study,\n		truth = truth,\n		secondsToShift = ART.ShiftSeconds,\n	}\n	wall = made\n	Studio.Show(study.name, truth)\n	return made\nend\n\n-- One square of the study changes. The whole of what a shift looks like from the world's\n-- side: a part changes colour and nothing announces it -- see Studio.SetCell for why there\n-- is no sound and no flash on this.\n--\n-- The replacement is drawn from the study's own colours rather than from the whole shelf,\n-- so a harbour stays a harbour. A picture that could shift to any of eight pigments would\n-- stop being a picture within a minute, and the player would be copying noise.\nlocal function shiftOne(current: Wall)\n	local movable = current.study.movable\n	if #movable == 0 then\n		return\n	end\n	local index = movable[math.random(1, #movable)]\n	local was = current.truth[index]\n\n	local choices: { Pigment } = {}\n	for _, pigment in current.study.byUse do\n		if was == nil or pigment.id ~= was.id then\n			table.insert(choices, pigment)\n		end\n	end\n	if #choices == 0 then\n		-- Impossible: Studies refuses a study with fewer than two pigments in it at require\n		-- time, so there is always something else to become. Guarded anyway rather than\n		-- indexing an empty list, because the alternative failure is a whole tick loop\n		-- dying on a picture nobody will think to look at.\n		return\n	end\n\n	local now = choices[math.random(1, #choices)]\n	current.truth[index] = now\n	Studio.SetCell(index, now)\nend\n\n-- Ends the canvas and pays for it. `reason` changes the sentence and never the arithmetic:\n-- a canvas walked away from is graded exactly as one that ran out of time, because leaving\n-- early is a way of not having painted it.\nlocal function finish(player: Player, data: LifeData, session: Session, reason: string)\n	-- Decided before anything is written, which is the idempotency rule this codebase runs\n	-- on: work the outcome out, then record it.\n	local truth = truthFor(session)\n	local share = canvasShare(session, truth)\n	local _, filled = tally(session, truth)\n\n	local band = Report.BandFor(share)\n	local gained = Report.SmartsFor(band)\n\n	if gained ~= 0 then\n		StatService.AddStat(player, \"smarts\", gained)\n	end\n\n	-- Banked once on the whole canvas rather than per cell, for the reason Geography banks\n	-- once on the whole errand: a canvas is one painting. Paying the ladder sixteen times\n	-- would make Art climb at sixteen times every other subject's rate and top out inside a\n	-- single afternoon.\n	Mastery.Record(data, SUBJECT_ID, share)\n	session.level = levelOf(data)\n	session.passes = passesOf(data)\n\n	-- Art, scaled by how much of the study actually came back. Once per canvas for the\n	-- reason mastery is banked once per canvas, and on the share rather than on the cell\n	-- count, so sixteen cells filled with the wrong colour pays what it is worth.\n	local earned = math.floor(SKILL_AWARDS.ArtCanvas * share)\n	if earned > 0 then\n		SkillService.Award(player, \"art\", earned, \"finished a canvas\")\n	end\n\n	-- Counted however it ended, including walked away from, for the reason a lesson is:\n	-- otherwise a player could start, leave, and start again until the wall showed a study\n	-- they liked the look of.\n	data.lessonsThisYear += 1\n	EventService.AwardAutonomy(player, 1)\n\n	local level = levelOf(data)\n	Report.RecordLesson(data, SUBJECT_ID, band, gained, if level > session.levelAtStart then level else nil)\n\n	local percent = math.floor(share * 100 + 0.5)\n	local reward = if gained > 0 then `. +{gained} smarts.` else \".\"\n	local opening = if reason == \"signed\"\n		then \"Signed.\"\n		elseif reason == \"left\" then \"You walked away from it.\"\n		else \"Time -- brushes down.\"\n	session.summary = `{opening} {filled} of {CELLS} cells painted, {percent}% of the study{reward}`\n	session.verdictLeft = ART.VerdictSeconds\n	session.notice = nil\n	session.noticeLeft = 0\n	push(player)\nend\n\n-- Why this player cannot paint right now, or nil if they can. Only the things Art itself\n-- refuses -- the age, the yearly cap and the door are School's, checked before this is\n-- ever called.\nlocal function refusalFor(): string?\n	if not enabled then\n		return \"The art room is closed.\"\n	end\n	if Studio.Room() == nil then\n		return \"The art room has not been built.\"\n	end\n	if #Studies.All == 0 then\n		return \"There is nothing up on the wall today.\"\n	end\n	return nil\nend\n\n-- Starts a canvas. Returns false with a reason worth saying out loud.\n--\n-- Takes no position, exactly as ScienceService.Begin does not: the wall and the cupboard\n-- are real furniture in one place, and a session centred anywhere else would start with\n-- the picture already outside the room the player is held in.\nfunction ArtService.Begin(player: Player, data: LifeData): (boolean, string?)\n	if sessions[player] ~= nil then\n		return false, \"You are already at the easel.\"\n	end\n	local refusal = refusalFor()\n	if refusal ~= nil then\n		return false, refusal\n	end\n\n	local current = claimWall()\n	if current == nil then\n		return false, \"There is nothing up on the wall today.\"\n	end\n\n	local level = levelOf(data)\n	local session: Session = {\n		study = current.study,\n		painted = {},\n		palette = paletteFor(current.study, level),\n		held = nil,\n		strokes = ART.StrokesPerRefill,\n		secondsLeft = ART.SecondsPerCanvas,\n		level = level,\n		passes = passesOf(data),\n		levelAtStart = level,\n		atEasel = false,\n		atCupboard = false,\n		summary = nil,\n		verdictLeft = 0,\n		notice = nil,\n		noticeLeft = 0,\n	}\n\n	sessions[player] = session\n	push(player)\n	return true, nil\nend\n\n-- A cell painted. Everything about it is re-checked here rather than trusted, because the\n-- client knows the palette, the pot and the easel radius and could lie about all three.\nlocal function onPaintRequested(player: Player, cellIndex: unknown, pigmentId: unknown)\n	if type(cellIndex) ~= \"number\" or type(pigmentId) ~= \"string\" then\n		return\n	end\n	local session = sessions[player]\n	if session == nil or session.summary ~= nil then\n		return\n	end\n\n	local index = math.floor(cellIndex)\n	if index < 1 or index > CELLS then\n		-- A cell that is not on the canvas. Dropped silently rather than refused out loud:\n		-- there is no way for a player to do this, so a message would be a message about a\n		-- client bug shown to somebody who cannot act on it.\n		return\n	end\n\n	-- The tube has to be one this rung was actually handed. Checked against the session's\n	-- own palette rather than against the shelf, because the palette *is* the mastery\n	-- reward -- a client that could name any pigment would hand itself the top rung.\n	local tube: Pigment? = nil\n	local slot: number? = nil\n	for position, candidate in session.palette do\n		if candidate.id == pigmentId then\n			tube = candidate\n			slot = position\n			break\n		end\n	end\n	if tube == nil or slot == nil then\n		return\n	end\n\n	if not session.atEasel then\n		refuse(player, session, \"Go back to the easel.\")\n		return\n	end\n\n	-- Picking the tube up is free and always allowed, even with an empty pot. Which colour\n	-- is in your hand is not a move, and a player who cannot even change brushes while\n	-- walking to the cupboard is being charged for the walk twice.\n	session.held = slot\n\n	local already = session.painted[index]\n	if already ~= nil and already.id == tube.id then\n		-- The same paint on the same cell. A no-op that costs nothing, because a double\n		-- click and a cell the player has forgotten they already did are the same input,\n		-- and charging a stroke for it would make the pot a test of memory rather than a\n		-- reason to walk.\n		push(player)\n		return\n	end\n\n	if session.strokes <= 0 then\n		refuse(player, session, \"Out of paint. The cupboard is behind you.\")\n		return\n	end\n\n	session.painted[index] = tube\n	session.strokes -= 1\n	session.notice = nil\n	session.noticeLeft = 0\n	push(player)\nend\n\n-- Signed. The commit, and the only irreversible act in the verb.\nlocal function onSignRequested(player: Player)\n	local session = sessions[player]\n	if session == nil or session.summary ~= nil then\n		return\n	end\n	if not session.atEasel then\n		refuse(player, session, \"You have to be at the easel to sign it.\")\n		return\n	end\n\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return\n	end\n	finish(player, Lives.Active(profile.Data), session, \"signed\")\n	releaseWallIfEmpty()\nend\n\n-- Reads where the player is standing onto the session. Everything the click handlers\n-- allow or refuse is decided from these two, worked out once a tick in one place rather\n-- than re-probed per click.\nlocal function readPosition(session: Session, position: Vector3)\n	local room = Studio.Room()\n	if room == nil then\n		session.atEasel = false\n		session.atCupboard = false\n		return\n	end\n	session.atEasel = Ground.FlatDistance(position, room.easel) <= ART.EaselRadiusStuds\n	session.atCupboard = Ground.FlatDistance(position, room.cupboard) <= ART.CupboardRadiusStuds\nend\n\nlocal function tickPlayer(player: Player, elapsed: number)\n	local session = sessions[player]\n	if session == nil then\n		return\n	end\n\n	-- The closing line, held, and then the canvas is gone. First because everything below\n	-- it is about a lesson that is still running, and this one is not.\n	if session.summary ~= nil then\n		session.verdictLeft -= elapsed\n		if session.verdictLeft <= 0 then\n			forget(player)\n			ArtUpdatedRemote:FireClient(player, nil)\n			releaseWallIfEmpty()\n		end\n		return\n	end\n\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return\n	end\n	local data = Lives.Active(profile.Data)\n\n	if not data.alive or not enabled then\n		finish(player, data, session, \"left\")\n		return\n	end\n\n	local position = characterPosition(player)\n	if position == nil then\n		-- No body, so no clock. A character mid-respawn cannot paint and cannot walk to the\n		-- cupboard, and running the canvas down through those frames would be charging the\n		-- player for the engine. Death is caught by the branch above, so this cannot be\n		-- held open on purpose.\n		return\n	end\n\n	readPosition(session, position)\n\n	local room = Studio.Room()\n	if room ~= nil and Ground.FlatDistance(position, room.center) > ART.RoomRadiusStuds then\n		finish(player, data, session, \"left\")\n		return\n	end\n\n	-- Filling the pot is instant on arrival rather than held, which is the one place this\n	-- deliberately parts company with the lab's cupboard. There a refill is a spot you\n	-- stand in for two seconds; here the cost is already paid in full by the walk itself --\n	-- the wall is behind you the whole way -- and charging a dwell on top would be pricing\n	-- the same interruption twice.\n	if session.atCupboard and session.strokes < ART.StrokesPerRefill then\n		session.strokes = ART.StrokesPerRefill\n		session.notice = nil\n		session.noticeLeft = 0\n	end\n\n	if session.noticeLeft > 0 then\n		session.noticeLeft -= elapsed\n		if session.noticeLeft <= 0 then\n			session.notice = nil\n			session.noticeLeft = 0\n		end\n	end\n\n	session.secondsLeft -= elapsed\n	if session.secondsLeft <= 0 then\n		session.secondsLeft = 0\n		finish(player, data, session, \"time\")\n		return\n	end\n\n	push(player)\nend\n\n-- The wall's own clock, run once per tick rather than once per player. The study is shared\n-- furniture, so a shift is one event that everybody in the room sees -- ticking it per\n-- session would shift the picture once per painter and make a class of three rot three\n-- times as fast as a class of one.\nlocal function tickWall(elapsed: number)\n	local current = wall\n	if current == nil then\n		return\n	end\n\n	local painting = false\n	for _, session in sessions do\n		if session.summary == nil then\n			painting = true\n			break\n		end\n	end\n	if not painting then\n		-- The light does not move in an empty room. Not an optimisation: without this a\n		-- study left up between lessons would drift into something nobody authored, and the\n		-- first player through the door would be copying six minutes of random walk.\n		return\n	end\n\n	current.secondsToShift -= elapsed\n	if current.secondsToShift > 0 then\n		return\n	end\n	current.secondsToShift = ART.ShiftSeconds\n	for _ = 1, ART.ShiftCells do\n		shiftOne(current)\n	end\nend\n\nfunction ArtService.IsRunning(player: Player): boolean\n	return sessions[player] ~= nil\nend\n\n-- A new life. Nobody inherits an education, and the mastery ladder is per life for the\n-- same reason bonds and money are.\nfunction ArtService.ResetForNewLife(player: Player)\n	forget(player)\n	local profile = DataService.GetProfile(player)\n	if profile ~= nil then\n		Mastery.Clear(Lives.Active(profile.Data), SUBJECT_ID)\n	end\n	releaseWallIfEmpty()\n	ArtUpdatedRemote:FireClient(player, nil)\nend\n\n-- Studio harness: opens a canvas wherever the player is standing, skipping the walk to\n-- school but nothing else. The room is still the built one, so the wall and the cupboard\n-- are where they actually are -- a harness that also moved the furniture would be testing\n-- a room that does not exist.\nfunction ArtService.ForceStart(player: Player): (boolean, string?)\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return false, \"no profile loaded\"\n	end\n	return ArtService.Begin(player, Lives.Active(profile.Data))\nend\n\n-- Studio harness: signs the canvas from wherever the player is. Skips the easel check that\n-- the real remote enforces, because the thing being tested is the scoring and not the\n-- radius.\nfunction ArtService.ForceSign(player: Player): boolean\n	local session = sessions[player]\n	if session == nil or session.summary ~= nil then\n		return false\n	end\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return false\n	end\n	finish(player, Lives.Active(profile.Data), session, \"signed\")\n	releaseWallIfEmpty()\n	return true\nend\n\n-- Studio harness: moves the study now rather than waiting out the timer. The single most\n-- useful command in this file -- the shift is the mechanic, and a tester who has to stand\n-- around for eighteen seconds to see one will only ever see two of them.\nfunction ArtService.ForceShift(): boolean\n	local current = wall\n	if current == nil then\n		return false\n	end\n	shiftOne(current)\n	for player in sessions do\n		push(player)\n	end\n	return true\nend\n\n-- Studio harness: fills the pot without the walk. The trip is the point, so this exists to\n-- take it *out* of the way while something else is being tested, not to make it optional.\nfunction ArtService.Refill(player: Player): boolean\n	local session = sessions[player]\n	if session == nil or session.summary ~= nil then\n		return false\n	end\n	session.strokes = ART.StrokesPerRefill\n	push(player)\n	return true\nend\n\nfunction ArtService.ForceEnd(player: Player): boolean\n	local session = sessions[player]\n	if session == nil then\n		return false\n	end\n	local profile = DataService.GetProfile(player)\n	if profile ~= nil and session.summary == nil then\n		finish(player, Lives.Active(profile.Data), session, \"left\")\n	end\n	forget(player)\n	ArtUpdatedRemote:FireClient(player, nil)\n	releaseWallIfEmpty()\n	return true\nend\n\n-- Studio harness: sets the rung directly. The whole ladder in two commands, which is the\n-- only practical way to judge whether the palette reward reads as a reward -- and a live\n-- session's palette is re-cut on the spot rather than at the next lesson, because a tester\n-- who has to start a new canvas to see the change is comparing two different pictures.\nfunction ArtService.SetLevel(player: Player, level: number): boolean\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return false\n	end\n	local data = Lives.Active(profile.Data)\n	Mastery.Set(data, SUBJECT_ID, level)\n\n	local session = sessions[player]\n	if session ~= nil then\n		session.level = levelOf(data)\n		session.passes = passesOf(data)\n		session.palette = paletteFor(session.study, session.level)\n		-- The tube in hand may have just been taken away by a level going down. Dropped\n		-- rather than clamped: a held index that silently means a different colour is how a\n		-- player ends up painting with something they did not choose.\n		session.held = nil\n		push(player)\n	end\n	return true\nend\n\nfunction ArtService.SetEnabled(value: boolean)\n	enabled = value\nend\n\nfunction ArtService.IsEnabled(): boolean\n	return enabled\nend\n\n-- One line of truth for the debug command, and it says the things that are otherwise\n-- invisible: what is on the wall, how long until it moves, and how much of the canvas is\n-- stale -- which is precisely the number the player is never shown a list for.\nfunction ArtService.Describe(player: Player): string\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return \"art: no profile loaded\"\n	end\n	local data = Lives.Active(profile.Data)\n	local level = levelOf(data)\n\n	local onWall = \"nothing\"\n	local current = wall\n	if current ~= nil then\n		onWall = `\"{current.study.name}\" ({current.study.id}), {#current.study.movable} cells can move,`\n			.. ` next shift in {string.format(\"%.1f\", math.max(0, current.secondsToShift))}s`\n	end\n\n	local running = \"no canvas\"\n	local session = sessions[player]\n	if session ~= nil then\n		local truth = truthFor(session)\n		local stale, filled = tally(session, truth)\n		local tubes: { string } = {}\n		for _, tube in session.palette do\n			table.insert(tubes, tube.id)\n		end\n		running = `canvas {string.format(\"%.0f\", canvasShare(session, truth) * 100)}%,`\n			.. ` {filled}/{CELLS} filled, {stale} stale, {session.strokes}/{ART.StrokesPerRefill} strokes,`\n			.. ` {string.format(\"%.1f\", math.max(0, session.secondsLeft))}s left,`\n			.. ` palette [{table.concat(tubes, \" \")}]`\n			.. if session.summary ~= nil then \", closing\" else \"\"\n	end\n\n	return string.format(\n		\"art: %s | wall: %s | mastery level %d/%d, %d/%d passes%s, ceiling %.3f | %s\",\n		if enabled then \"enabled\" else \"DISABLED\",\n		onWall,\n		level,\n		Mastery.Levels,\n		passesOf(data),\n		Mastery.PassesPerLevel,\n		if Mastery.IsTopped(data, SUBJECT_ID) then \" (topped out -- can skip)\" else \"\",\n		if session ~= nil then ceilingFor(session.study, level) else 0,\n		running\n	)\nend\n\nfunction ArtService:Start()\n	Players.PlayerRemoving:Connect(function(player: Player)\n		forget(player)\n		releaseWallIfEmpty()\n	end)\n\n	RequestArtPaintRemote.OnServerEvent:Connect(function(player: Player, cellIndex: unknown, pigmentId: unknown)\n		local ok, err = pcall(onPaintRequested, player, cellIndex, pigmentId)\n		if not ok then\n			warn(`[AGES] art paint failed for {player.Name}: {err}`)\n		end\n	end)\n\n	RequestArtSignRemote.OnServerEvent:Connect(function(player: Player)\n		local ok, err = pcall(onSignRequested, player)\n		if not ok then\n			warn(`[AGES] art sign failed for {player.Name}: {err}`)\n		end\n	end)\n\n	task.spawn(function()\n		while true do\n			local elapsed = task.wait(ART.TickSeconds)\n			-- The wall first, then the painters. Order matters by exactly one tick: a shift\n			-- landing before the pushes means the stale count a player is shown already\n			-- includes it, rather than arriving a quarter of a second after the square on\n			-- the wall visibly changed.\n			local ok, err = pcall(tickWall, elapsed)\n			if not ok then\n				warn(`[AGES] art wall tick failed: {err}`)\n			end\n			for _, player in Players:GetPlayers() do\n				local fine, problem = pcall(tickPlayer, player, elapsed)\n				if not fine then\n					warn(`[AGES] art tick failed for {player.Name}: {problem}`)\n				end\n			end\n		end\n	end)\nend\n\nreturn ArtService\n"
table.insert(AGES_MANIFEST, "src/server/services/ArtService.luau")
AGES_SOURCES["src/server/services/BankService.luau"] = "--!strict\n-- The bank. One verb -- hold -- and a room built so that holding it in two different\n-- places means two opposite things.\n--\n-- **This is the till's question inverted, on purpose.** A shop till asks you not to be\n-- seen: you read a clerk and a camera and you take money in the gap between them, and\n-- being spotted is the failure. A bank takes being seen as given. The alarm goes the\n-- instant you touch the door, before a penny has moved, and everything after that is one\n-- question asked over and over: how much longer are you willing to stay? Nothing in this\n-- file is a stealth check. It is a clock the player is choosing to run down.\n--\n-- Three things are happening at once and the third one is the floor plan:\n--\n--   the vault    pays out while you hold it, and only while you hold it.\n--   the alarm    rings, and every second of ringing is heat *and a live fix on where you\n--                actually are* -- not a last-known guess. Officers converge on you rather\n--                than on a corner you left.\n--   the room     puts the panel that silences the alarm forty-eight studs from the money.\n--\n-- So silencing the alarm costs the money you are not taking while you walk, and taking the\n-- money costs the alarm you are not silencing. That is the whole activity, and it is made\n-- of geometry rather than of a cooldown -- see the activity law on escalating by changing\n-- the space. It is also why a second player matters and is never required: two people\n-- never have to run, one person always does.\n--\n-- **The most useful thing the alarm does is freeze.** The live fix stops the moment it is\n-- silenced, which means the police's picture of you sticks at wherever you were standing\n-- when you silenced it -- the panel, by the entrance. Silence the alarm and you have\n-- bought quiet at the vault by sending the search to your own way out. Nobody wrote that\n-- rule; it falls out of the fix being continuous and then stopping, which is the kind of\n-- consequence this system is supposed to produce.\n--\n-- Nothing is broadcast. There is no server message, no map ping and no announcement that a\n-- bank is being robbed, which is the one thing The Wild West got right by removing it: a\n-- global notification turns every robbery into the same event and hands the whole server a\n-- free waypoint. What tells the town is heat, which is already built and already visible\n-- as officers and as a crowd that recognises you.\n--\n-- What this file does not do: decide where the vault is (Vault, and content/Vaults), decide\n-- what heat buys (BountyService), or put officers in the street (PoliceService). It opens a\n-- door, rings a bell, and tells the bounty where somebody is standing.\n\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Config = require(ReplicatedStorage:WaitForChild(\"Config\"))\nlocal Remotes = require(ReplicatedStorage:WaitForChild(\"Remotes\"))\nlocal Types = require(ReplicatedStorage:WaitForChild(\"Types\"))\n\nlocal BountyService = require(script.Parent.BountyService)\nlocal DataService = require(script.Parent.DataService)\nlocal GangService = require(script.Parent.GangService)\nlocal MoneyService = require(script.Parent.MoneyService)\nlocal NPCService = require(script.Parent.NPCService)\nlocal PlaceService = require(script.Parent.PlaceService)\n\nlocal Colors = require(script.Parent.Parent.world.Colors)\nlocal Ground = require(script.Parent.Parent.world.Ground)\nlocal Public = require(script.Parent.Parent.content.Public)\nlocal Vault = require(script.Parent.Parent.world.Vault)\nlocal Vaults = require(script.Parent.Parent.content.Vaults)\n\ntype LifeData = Types.LifeData\ntype BankState = Types.BankState\ntype Visitor = NPCService.Visitor\ntype GangCrewMember = Types.GangCrewMember\n\nlocal BankService = {}\n\nlocal BANK = Config.Crime.Bank\n\nlocal BankUpdatedRemote = Remotes.Get(\"BankUpdated\")\nlocal RequestBankOpenRemote = Remotes.Get(\"RequestBankOpen\")\nlocal RequestBankHoldRemote = Remotes.Get(\"RequestBankHold\")\nlocal RequestBankCallCrewRemote = Remotes.Get(\"RequestBankCallCrew\")\n\n-- One bank, as a shared fact rather than a per-player one.\n--\n-- This is the single most important structural decision in the file and it is the whole of\n-- what makes two players in one bank interesting. The vault a partner empties is empty for\n-- you. The alarm a partner silences is silent for you. Neither of them has to know the\n-- other is there and neither of them is handed a special co-op mode: they are simply both\n-- reading the same room, which is what a shared world means and what the till already does\n-- with its drawer.\ntype Room = {\n	place: string,\n	name: string,\n	left: number,\n	full: number,\n	-- When it is worth robbing again, on the same clock everything else here uses. A moment\n	-- rather than a countdown, so a bank nobody is standing in costs nothing.\n	refillAt: number,\n\n	-- Whether anybody has committed this visit. Cleared when the last person leaves the\n	-- building, which is the only way out of it: once tripped, this room is against you\n	-- until it is empty of robbers.\n	tripped: boolean,\n	-- Who opened it. Held for one reason only: the gang ladder pays standing for heat you\n	-- took that was not yours, so the person whose robbery it is has to be excluded from\n	-- that award -- their heat is theirs. Cleared with `tripped` when the room settles.\n	--\n	-- A Player rather than a name, and therefore a strong reference held only for as long\n	-- as the room stays tripped. A player who leaves mid-robbery is dropped from the game\n	-- but not from here until the last person walks out, which is at most one robbery's\n	-- worth of a table entry and is not worth a weak table to avoid.\n	trippedBy: Player?,\n	ringing: boolean,\n	-- When a silenced alarm arms itself again. 0 while ringing or untripped.\n	rearmAt: number,\n	ringingSince: number,\n\n	guard: Visitor?,\n	-- Set while a guard rig is being built, which yields. Without it a player who walks in,\n	-- out and back in inside two seconds gets two guards on one floor.\n	spawningGuard: boolean,\n	-- Which patrol spot he is walking to. An index into the room's spot list, walked in a\n	-- loop, so a bank with four spots patrols four rather than needing new code.\n	leg: number,\n	legUntil: number,\n	-- When he stops staring at whoever he just caught and goes back to walking.\n	noticeUntil: number,\n	-- Whether his last look found somebody. Only for the panel to draw; the alarm it\n	-- caused has already been rung by the time this is read.\n	onSomebody: boolean,\n\n	-- Part 3: somebody's crew, sent to hold the alarm instead of them. One seat, same as\n	-- the guard is one body -- two robbers cannot each bring their own, because there is\n	-- only one alarm panel to stand at.\n	crewHelper: Visitor?,\n	spawningCrewHelper: boolean,\n	-- Whose crew this is, so a swap or a departure can find them again, and so nobody but\n	-- the player who sent them can send somebody else in their place.\n	crewHelperOwner: Player?,\n	crewHelperCrewId: string?,\n	crewHelperName: string?,\n	-- Rolled once, when they were called, from the nerve they had *then* -- see\n	-- Config.Gangs.Jobs. Not re-rolled per ring: nerve is about who you decided to send,\n	-- not a fresh coin flip the player has no way to have weighed.\n	crewHelperFailChance: number,\n	-- Whether this ring is one they are actually going for. Decided in `ring`, the instant\n	-- the alarm goes, from crewHelperFailChance -- so the read is available the moment the\n	-- bell starts, same as everything else a player has to react to here.\n	crewHelperCommitted: boolean,\n	crewHelperSilencingFor: number,\n}\n\n-- One player, inside one bank.\ntype Session = {\n	place: string,\n	-- Whether the client says their hands are on something. Never trusted on its own: every\n	-- tick re-checks which control they are actually within reach of, and being at neither\n	-- takes their hands off regardless of what the client last said.\n	holding: boolean,\n	taken: number,\n	-- How long they have held the alarm panel. Counted up rather than down because it\n	-- resets to zero the instant they let go or step away, which is much harder to get\n	-- wrong in this direction -- the same argument the till's watch window makes.\n	silencingFor: number,\n	notice: string?,\n	noticeLeft: number,\n}\n\nlocal rooms: { [string]: Room } = {}\nlocal sessions: { [Player]: Session } = {}\nlocal pushed: { [Player]: string } = {}\nlocal enabled = true\n\nlocal function dataFor(player: Player): LifeData?\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return nil\n	end\n	return DataService.CurrentLife(profile)\nend\n\nlocal function characterPosition(player: Player): Vector3?\n	local character = player.Character\n	if character == nil then\n		return nil\n	end\n	local root = character:FindFirstChild(\"HumanoidRootPart\")\n	if root == nil then\n		return nil\n	end\n	return (root :: BasePart).Position\nend\n\n-- The shared state for one bank, created on first use and then ticked for the rest of the\n-- session. Refilling deliberately does not happen here: it is in tickRoom, so a vault comes\n-- back on its own clock and its door closes with it, rather than staying open until the next\n-- person happens to ask -- which for a bank could be twenty minutes of the town wearing a\n-- sign saying this has already been done.\nlocal function roomFor(place: string): Room?\n	local existing = rooms[place]\n	if existing ~= nil then\n		return existing\n	end\n\n	local bank = Vaults.Get(place)\n	if bank == nil then\n		return nil\n	end\n	local full = BANK.VaultFloat * bank.richness\n	local made: Room = {\n		place = place,\n		name = bank.name,\n		left = full,\n		full = full,\n		refillAt = 0,\n		tripped = false,\n		trippedBy = nil,\n		ringing = false,\n		rearmAt = 0,\n		ringingSince = 0,\n		guard = nil,\n		spawningGuard = false,\n		leg = 1,\n		legUntil = 0,\n		noticeUntil = 0,\n		onSomebody = false,\n		crewHelper = nil,\n		spawningCrewHelper = false,\n		crewHelperOwner = nil,\n		crewHelperCrewId = nil,\n		crewHelperName = nil,\n		crewHelperFailChance = 0,\n		crewHelperCommitted = false,\n		crewHelperSilencingFor = 0,\n	}\n	rooms[place] = made\n	return made\nend\n\nlocal function noticeFor(session: Session, text: string)\n	session.notice = text\n	session.noticeLeft = 4\nend\n\n-- Everybody currently inside one bank. Walked rather than indexed because there is one\n-- bank and at most a handful of people in it -- an index keyed by place would be a second\n-- copy of the session table to keep honest for no measurable gain.\nlocal function othersIn(place: string): { Player }\n	local found: { Player } = {}\n	for player, session in sessions do\n		if session.place == place then\n			table.insert(found, player)\n		end\n	end\n	return found\nend\n\n-- Which of the room's two controls the player is standing at.\nlocal function controlAt(place: string, at: Vector3): \"vault\" | \"alarm\" | \"between\"\n	if Vault.AtVault(place, at) then\n		return \"vault\"\n	end\n	if Vault.AtAlarm(place, at) then\n		return \"alarm\"\n	end\n	return \"between\"\nend\n\nlocal function stateFor(player: Player): BankState?\n	local session = sessions[player]\n	if session == nil then\n		return nil\n	end\n	local now = os.clock()\n	local room = roomFor(session.place)\n	if room == nil then\n		return nil\n	end\n	local at = characterPosition(player)\n\n	local alarm: \"quiet\" | \"ringing\" | \"silenced\"\n	if not room.tripped then\n		alarm = \"quiet\"\n	elseif room.ringing then\n		alarm = \"ringing\"\n	else\n		alarm = \"silenced\"\n	end\n\n	local guard: (\"away\" | \"near\" | \"onYou\")? = nil\n	local body = room.guard\n	if body ~= nil and not body.gone() then\n		if room.onSomebody then\n			guard = \"onYou\"\n		elseif at ~= nil and Ground.FlatDistance(body.at(), at) <= BANK.GuardSeeStuds then\n			guard = \"near\"\n		else\n			guard = \"away\"\n		end\n	end\n\n	-- Part 3. Empty unless this player both has crew to send and the one alarm seat is\n	-- either open or already theirs -- someone else's helper is someone else's, the same\n	-- way the guard is nobody's to command.\n	local crewCallable: { GangCrewMember } = {}\n	local crew = GangService.CrewFor(player)\n	if #crew > 0 and (room.crewHelper == nil or room.crewHelperOwner == player) then\n		crewCallable = crew\n	end\n\n	return {\n		place = room.name,\n		vaultLeft = room.left,\n		vaultFull = room.full,\n		taken = session.taken,\n		at = if at ~= nil then controlAt(session.place, at) else \"between\",\n		holding = session.holding,\n		silencing = math.clamp(session.silencingFor / BANK.SilenceSeconds, 0, 1),\n		alarm = alarm,\n		rearmIn = if alarm == \"silenced\" then math.max(room.rearmAt - now, 0) else 0,\n		ringingFor = if alarm == \"ringing\" then now - room.ringingSince else 0,\n		guard = guard,\n		crewCallable = crewCallable,\n		crewOnAlarm = if room.crewHelper ~= nil then room.crewHelperName else nil,\n		notice = session.notice,\n	}\nend\n\nlocal function push(player: Player)\n	local state = stateFor(player)\n	local digest: string\n	if state == nil then\n		digest = \"none\"\n	else\n		-- Money to the whole unit and the two clocks to a tenth of a second, because both\n		-- drain continuously and a panel redrawn every tick for a digit nobody can read at\n		-- that precision would be a packet every 200ms of every robbery. Crew by id and\n		-- nerve, not name, for the same reason the crew HUD digest is -- two members can\n		-- share a name and must never share a digest entry.\n		local crewBits = {}\n		for _, member in state.crewCallable do\n			table.insert(crewBits, `{member.id}:{math.floor(member.nerve)}`)\n		end\n		digest = `{state.place}/{math.floor(state.vaultLeft)}/{math.floor(state.taken)}/`\n			.. `{state.at}/{tostring(state.holding)}/{math.floor(state.silencing * 20)}/`\n			.. `{state.alarm}/{math.floor(state.rearmIn * 10)}/{math.floor(state.ringingFor * 10)}/`\n			.. `{tostring(state.guard)}/{table.concat(crewBits, \",\")}/{tostring(state.crewOnAlarm)}/`\n			.. `{tostring(state.notice)}`\n	end\n\n	if pushed[player] == digest then\n		return\n	end\n	pushed[player] = digest\n	BankUpdatedRemote:FireClient(player, state)\nend\n\nlocal function pushRoom(place: string)\n	for _, player in othersIn(place) do\n		push(player)\n	end\nend\n\n-- A word for whoever sent their crew here, specifically -- not the room. The room already\n-- has `notice` per session for everything else; this exists because \"your guy flinched\" is\n-- a sentence about one player's choice, not about the alarm, and the two must not collide.\nlocal function noticeOwner(room: Room, text: string)\n	local owner = room.crewHelperOwner\n	if owner == nil then\n		return\n	end\n	local session = sessions[owner]\n	if session == nil then\n		return\n	end\n	noticeFor(session, text)\n	push(owner)\nend\n\n-- The alarm goes. Idempotent, because three different things ring it -- the first hold on\n-- the vault, the re-arm timer running out, and the guard looking up -- and two of them can\n-- land on the same tick.\n--\n-- This is also the one moment a called crew member's whole visit turns on. Nerve was\n-- already spent choosing who to send; what it buys is decided here, once, for this ring --\n-- see Config.Gangs.Jobs and the note on `crewHelperCommitted`.\nlocal function ring(room: Room, now: number)\n	if room.ringing then\n		return\n	end\n	room.ringing = true\n	room.ringingSince = now\n	room.rearmAt = 0\n\n	if room.crewHelper ~= nil then\n		room.crewHelperSilencingFor = 0\n		room.crewHelperCommitted = math.random() >= room.crewHelperFailChance\n		if room.crewHelperCommitted then\n			noticeOwner(room, `{room.crewHelperName} is on the alarm.`)\n		else\n			noticeOwner(room, `{room.crewHelperName} isn't going for it. Nerve.`)\n		end\n	end\nend\n\n-- Back to nothing happening in this building. Only ever reached by the room emptying of\n-- people: there is no \"cancel\", because the exit from this activity is the front door,\n-- which is the same exit the player is going to want thirty seconds later anyway.\nlocal function settle(room: Room)\n	room.tripped = false\n	room.trippedBy = nil\n	room.ringing = false\n	room.rearmAt = 0\n	room.ringingSince = 0\n	room.onSomebody = false\nend\n\nlocal function despawnGuard(room: Room)\n	local guard = room.guard\n	if guard ~= nil then\n		room.guard = nil\n		if not guard.gone() then\n			guard.destroy()\n		end\n	end\nend\n\n-- Somebody on the floor, built once the first player is in the room.\n--\n-- Spawned per *room* rather than per player, unlike the shop clerk, and that is the point:\n-- two robbers in one bank are watched by one man and have to solve him together. A guard\n-- each would be two private games in one building.\n--\n-- Lazy for the reason the clerk is -- staffing a room nobody is in is a rig built for\n-- nobody -- and the cost of that is a player who walks past an open door seeing an empty\n-- lobby. The honest fix for that is the ambient population work rather than a permanent\n-- rig here. What matters for the activity is that he exists *before* anything is\n-- committed: clicking the vault door opens the room and trips nothing, so the seconds\n-- spent watching him walk are free, and they are the only read this activity gives you.\nlocal function spawnGuard(player: Player, room: Room)\n	if room.guard ~= nil or room.spawningGuard then\n		return\n	end\n	local built = Vault.Get(room.place)\n	if built == nil or #built.patrol < 2 then\n		-- Nowhere standable to walk. The bank runs on its alarm alone, which is easier and\n		-- is allowed to be: a robbery that refused to start because the floor was tight\n		-- would be a door that does nothing for reasons nobody can see.\n		return\n	end\n\n	room.spawningGuard = true\n	task.spawn(function()\n		local member = Public.Someone()\n		local start = built.patrol[1]\n		local visitor = NPCService.Spawn(player, member, CFrame.new(start, built.vault), BANK.GuardAgeYears)\n		room.spawningGuard = false\n		-- Everything below the spawn is re-checked, because Spawn yields on a web call and\n		-- the room may have emptied, or a second player's tick may have built one already.\n		if visitor == nil then\n			return\n		end\n		if room.guard ~= nil or #othersIn(room.place) == 0 then\n			visitor.destroy()\n			return\n		end\n		-- His pace is derived from the patrol he was given rather than set as a number, so\n		-- a bank whose spots are further apart does not silently get a faster guard: the\n		-- loop takes GuardPatrolSeconds in every building, which is what the config note\n		-- about not being a multiple of RearmSeconds is actually promising.\n		local walked = 0\n		for index, spot in built.patrol do\n			local nextSpot = built.patrol[if index < #built.patrol then index + 1 else 1]\n			walked += Ground.FlatDistance(spot, nextSpot)\n		end\n		visitor.setSpeed(math.max(walked / BANK.GuardPatrolSeconds, 1))\n		room.guard = visitor\n		room.leg = 1\n		room.legUntil = 0\n	end)\nend\n\n-- Walks the guard, and looks up.\n--\n-- His one action is re-arming the alarm, and he only ever takes it while the room is\n-- already tripped: before that he is a man at work and a player standing at a vault is a\n-- customer. That is what makes the read before committing worth anything -- commit while\n-- he is at the door end and your first silence runs its full twelve seconds, commit while\n-- he is at the vault end and it does not.\nlocal function tickGuard(room: Room, now: number)\n	local guard = room.guard\n	if guard == nil then\n		return\n	end\n	if guard.gone() then\n		room.guard = nil\n		return\n	end\n	local built = Vault.Get(room.place)\n	if built == nil or #built.patrol < 2 then\n		return\n	end\n\n	-- Looking first, because a man who has just caught somebody should stop where he is\n	-- rather than take one more step and then react.\n	if room.tripped and now >= room.noticeUntil then\n		local ignore = Ground.IgnoreList()\n		local from = guard.at()\n		local caught: Vector3? = nil\n		for _, player in othersIn(room.place) do\n			local at = characterPosition(player)\n			if at == nil then\n				continue\n			end\n			-- Cast from him to them rather than the other way around, which is not\n			-- symmetric: the origin is what the engine forgives for being inside a body,\n			-- and the destination is what the ignore list has to cover. Same note as\n			-- WitnessService, and the same trap.\n			if Ground.FlatDistance(from, at) <= BANK.GuardSeeStuds and Ground.Reachable(from, at, 0, ignore) then\n				caught = at\n				break\n			end\n		end\n\n		if caught ~= nil then\n			room.onSomebody = true\n			room.noticeUntil = now + BANK.GuardNoticeSeconds\n			guard.halt()\n			guard.face(caught)\n			ring(room, now)\n			return\n		end\n		room.onSomebody = false\n	end\n\n	if now < room.noticeUntil then\n		return\n	end\n\n	-- Back to walking. `face(nil)` first because a body being held at an angle cannot also\n	-- be steering itself -- see Visitor.face, which is emphatic about this.\n	if room.onSomebody then\n		room.onSomebody = false\n		guard.face(nil)\n		room.legUntil = 0\n	end\n\n	if now >= room.legUntil then\n		room.leg = if room.leg < #built.patrol then room.leg + 1 else 1\n		room.legUntil = now + BANK.GuardPatrolSeconds / #built.patrol\n	end\n	-- Re-aimed every tick rather than walked once, because a humanoid that was knocked off\n	-- its destination by a player standing in the doorway would otherwise stop there and\n	-- the patrol would end without anything reporting that it had.\n	guard.moveTo(built.patrol[room.leg])\nend\n\n-- Sends a body home. Called both when the owner leaves and when the crew member they sent\n-- is no longer theirs to send -- dismissed off the gang panel while out on the job, say --\n-- so the seat never sits occupied by somebody who is not actually there anymore.\nlocal function despawnCrewHelper(room: Room)\n	local helper = room.crewHelper\n	if helper ~= nil then\n		room.crewHelper = nil\n		if not helper.gone() then\n			helper.destroy()\n		end\n	end\n	room.crewHelperOwner = nil\n	room.crewHelperCrewId = nil\n	room.crewHelperName = nil\n	room.crewHelperFailChance = 0\n	room.crewHelperCommitted = false\n	room.crewHelperSilencingFor = 0\nend\n\n-- How reliably a nerve rating covers the alarm. Linear between the two config ends rather\n-- than a curve, because the whole point of the number is that a player can read it off the\n-- crew panel and know roughly what they are sending in -- a hidden curve would make nerve a\n-- suggestion instead of the promise Config.Gangs.Crew's own header makes it.\nlocal function alarmFailChanceFor(nerve: number): number\n	local jobs = Config.Gangs.Jobs\n	local share = math.clamp(nerve / Config.Gangs.Crew.NerveMax, 0, 1)\n	return jobs.AlarmFailChanceAtZeroNerve + (jobs.AlarmFailChanceAtMaxNerve - jobs.AlarmFailChanceAtZeroNerve) * share\nend\n\n-- Sends one of the player's own crew to hold the alarm. The one seat this room has to\n-- give -- see the Room type's own note -- so this both spawns the body and claims it in\n-- the same breath once the web call is back, rather than leaving a window where two calls\n-- in flight could both believe they will land.\nlocal function spawnCrewHelper(player: Player, room: Room, crew: GangCrewMember)\n	if room.spawningCrewHelper then\n		return\n	end\n	room.spawningCrewHelper = true\n	task.spawn(function()\n		local built = Vault.Get(room.place)\n		local visitor = if built ~= nil\n			then NPCService.Spawn(player, GangService.CastMemberFor(crew), CFrame.new(built.door, built.alarm), nil)\n			else nil\n		room.spawningCrewHelper = false\n		-- Re-checked, same as the guard: Spawn yields on a web call, and by the time it\n		-- returns the seat may already be somebody's, or the caller may have walked out.\n		if visitor == nil then\n			return\n		end\n		local session = sessions[player]\n		if room.crewHelper ~= nil or session == nil or session.place ~= room.place then\n			visitor.destroy()\n			return\n		end\n		room.crewHelper = visitor\n		room.crewHelperOwner = player\n		room.crewHelperCrewId = crew.id\n		room.crewHelperName = crew.name\n		room.crewHelperFailChance = alarmFailChanceFor(crew.nerve)\n		room.crewHelperCommitted = false\n		room.crewHelperSilencingFor = 0\n		local color = GangService.ColorOf(player)\n		if color ~= nil and not Colors.Apply(visitor.model, color) then\n			warn(`[AGES] could not band {crew.name} -- they will look like anybody else`)\n		end\n		pushRoom(room.place)\n	end)\nend\n\n-- Walks the crew helper to the alarm and, once there, runs exactly the read `ring` already\n-- decided: committed means the same silence-hold a player would do with their own hands,\n-- uncommitted means standing there while the bell keeps going. Nothing here re-rolls\n-- mid-ring -- see `ring`'s own note.\nlocal function tickCrewHelper(room: Room, now: number, elapsed: number)\n	local helper = room.crewHelper\n	if helper == nil then\n		return\n	end\n	local owner = room.crewHelperOwner\n	local crewId = room.crewHelperCrewId\n	if helper.gone() or owner == nil or crewId == nil then\n		despawnCrewHelper(room)\n		return\n	end\n\n	-- Dismissed off the gang panel while they were out on this job. Checked every tick\n	-- rather than only on call, because that panel has nothing to do with this room and\n	-- must not have to know it exists.\n	local stillCrew = false\n	for _, member in GangService.CrewFor(owner) do\n		if member.id == crewId then\n			stillCrew = true\n			break\n		end\n	end\n	if not stillCrew then\n		local name = room.crewHelperName\n		despawnCrewHelper(room)\n		local session = sessions[owner]\n		if session ~= nil then\n			noticeFor(session, `{name} isn't running with you anymore, and heads off.`)\n			push(owner)\n		end\n		return\n	end\n\n	local built = Vault.Get(room.place)\n	if built == nil then\n		return\n	end\n\n	if not Vault.AtAlarm(room.place, helper.at()) then\n		helper.moveTo(built.alarm)\n		return\n	end\n\n	if not room.ringing then\n		room.crewHelperSilencingFor = 0\n		return\n	end\n	if not room.crewHelperCommitted then\n		return\n	end\n\n	room.crewHelperSilencingFor += elapsed\n	if room.crewHelperSilencingFor >= BANK.SilenceSeconds then\n		room.crewHelperSilencingFor = 0\n		room.ringing = false\n		room.rearmAt = now + BANK.RearmSeconds\n		noticeOwner(room, `{room.crewHelperName} silenced it. Quiet for now.`)\n		pushRoom(room.place)\n	end\nend\n\n-- The room itself, once per tick, whether or not anybody is holding anything. Split from\n-- the per-player tick because everything in it is shared: two robbers must not each be\n-- able to advance one alarm clock.\nlocal function tickRoom(room: Room, now: number, elapsed: number)\n	-- Refilled and drawn before anything else, and for every room whether or not anybody is\n	-- inside. The open door is how a bank tells the street it has already been done, so one\n	-- that stayed open through its own refill -- because nobody had walked in to ask --\n	-- would be the town wearing a sign that had stopped being true.\n	if room.left <= 0 and now >= room.refillAt then\n		room.left = room.full\n	end\n	Vault.ShowDoor(room.place, if room.full > 0 then 1 - room.left / room.full else 0)\n\n	local here = othersIn(room.place)\n	if #here == 0 then\n		if room.tripped then\n			settle(room)\n		end\n		despawnGuard(room)\n		despawnCrewHelper(room)\n		Vault.ShowAlarm(room.place, \"quiet\")\n		return\n	end\n\n	if room.tripped and not room.ringing and now >= room.rearmAt then\n		ring(room, now)\n	end\n\n	tickGuard(room, now)\n	tickCrewHelper(room, now, elapsed)\n\n	if room.ringing then\n		-- The live fix, and this is the part that actually hurts. Re-reported every tick\n		-- for every person in the building, because right now the police know exactly where\n		-- each of them is -- which makes this and the till's \"hands in the drawer\" the only\n		-- two moments in the game where their belief is continuously correct. Seen rather\n		-- than Add is also what makes a second conviction cost more than the first, and\n		-- this file does not have to know that.\n		for _, player in here do\n			local at = characterPosition(player)\n			if at ~= nil then\n				BountyService.Seen(player, BANK.HeatPerSecondRinging * elapsed, `The {room.name} alarm`, at)\n			end\n			-- Everybody in the room except whoever opened the vault.\n			--\n			-- This is the line that makes a second person worth having. The heat above is\n			-- charged to the whole building rather than to the person holding the money, so\n			-- standing on the panel while a gang-mate empties the vault means eating heat\n			-- that was never yours -- and that is exactly the work a gang should be paying\n			-- for. Excluding the tripper is what stops it being farmable: a lone robber\n			-- would otherwise be paid twice for the same alarm, once in money and once in\n			-- standing, for doing nothing but standing next to their own crime.\n			if player ~= room.trippedBy then\n				GangService.Credit(\n					player,\n					Config.Gangs.Earn.PerSecondSharedHeat * elapsed,\n					`took heat at the {room.name}`\n				)\n			end\n		end\n	end\n\n	Vault.ShowAlarm(room.place, if not room.tripped then \"quiet\" elseif room.ringing then \"ringing\" else \"silenced\")\nend\n\nlocal function endSession(player: Player)\n	local session = sessions[player]\n	if session == nil then\n		return\n	end\n	sessions[player] = nil\n	push(player)\n\n	local room = rooms[session.place]\n	local remaining = othersIn(session.place)\n\n	-- Walking out on somebody.\n	--\n	-- Charged only when all three are true at once: the alarm is live, this player is not\n	-- the one who opened it, and there is still somebody in there. That last clause is what\n	-- keeps it honest -- leaving a room you are alone in is not a betrayal, it is escaping,\n	-- which is a thing this game pays for elsewhere and must not punish here.\n	--\n	-- Read before `settle` below, because settle clears `trippedBy` and would make every\n	-- departure look like the tripper's own.\n	if room ~= nil and room.ringing and player ~= room.trippedBy and #remaining > 0 then\n		GangService.OnBailed(player)\n	end\n\n	-- Your crew came in with you, not with the building -- unlike the guard, who stays\n	-- however many robbers remain. Despawned by ownership rather than folded into the\n	-- `#remaining == 0` branch below, so it leaves the instant its owner does even while\n	-- somebody else is still working the vault.\n	if room ~= nil and room.crewHelperOwner == player then\n		despawnCrewHelper(room)\n		pushRoom(session.place)\n	end\n\n	-- After the session is gone, so a room emptied by the last person leaving settles on\n	-- this call rather than a fifth of a second later. Walking out of a bank should stop\n	-- the alarm you can hear through the door.\n	if room ~= nil and #remaining == 0 then\n		settle(room)\n		despawnGuard(room)\n		Vault.ShowAlarm(session.place, \"quiet\")\n	end\nend\n\nlocal function tickPlayer(player: Player, elapsed: number)\n	local session = sessions[player]\n	if session == nil then\n		return\n	end\n\n	local data = dataFor(player)\n	if data == nil or not data.alive or not enabled then\n		endSession(player)\n		return\n	end\n\n	if session.noticeLeft > 0 then\n		session.noticeLeft -= elapsed\n		if session.noticeLeft <= 0 then\n			session.notice = nil\n			session.noticeLeft = 0\n		end\n	end\n\n	local now = os.clock()\n	local at = characterPosition(player)\n	if at == nil or not Vault.InRoom(session.place, at) then\n		-- Leaving the building is how you leave. Not leaving the vault -- walking away from\n		-- the vault is half the activity, and a session that ended at the drawer's reach\n		-- would drop the player out of their own robbery the moment they went to silence\n		-- the alarm.\n		endSession(player)\n		return\n	end\n\n	local room = roomFor(session.place)\n	if room == nil then\n		endSession(player)\n		return\n	end\n\n	local control = controlAt(session.place, at)\n\n	-- Hands off the moment there is nothing to put them on. Being caught holding an empty\n	-- vault is the one flavour of unfair this activity can produce on its own.\n	if session.holding and control == \"between\" then\n		session.holding = false\n		session.silencingFor = 0\n	end\n	if session.holding and control == \"vault\" and room.left <= 0 then\n		session.holding = false\n		noticeFor(session, \"The vault is empty.\")\n	end\n\n	if not session.holding or control ~= \"alarm\" then\n		session.silencingFor = 0\n	end\n\n	if session.holding and control == \"vault\" and room.left > 0 then\n		if not room.tripped then\n			-- The commitment, and it is the first hold rather than the click that opened\n			-- the panel. Straight past the first tier: two officers are dispatched by the\n			-- act of starting, before a penny has moved, which is the promise this room\n			-- makes up front and the reason none of what follows is a stealth check.\n			room.tripped = true\n			room.trippedBy = player\n			ring(room, now)\n			BountyService.Seen(player, BANK.HeatOnTrip, `Opened the {room.name} vault`, at)\n			-- The set piece, paid flat and once. A vault is the event this whole tree\n			-- builds toward and it should read as one on the ladder too, rather than\n			-- arriving as a slightly faster trickle of the per-dollar rate below.\n			GangService.Credit(player, Config.Gangs.Earn.VaultOpened, `opened the {room.name} vault`)\n			noticeFor(session, \"The alarm is going.\")\n			pushRoom(session.place)\n		end\n\n		local amount = math.min(BANK.TakePerSecond * elapsed, room.left)\n		room.left -= amount\n		session.taken += amount\n		MoneyService.Add(player, amount, `Taken from the {room.name}`)\n		-- The same per-dollar rate the till pays, on top of the flat award for opening the\n		-- door. A vault is worth more than a drawer here because it *holds* more, not\n		-- because it is scored differently -- one rate across every theft in the game means\n		-- a player can reason about what a job is worth without being told.\n		GangService.Credit(player, amount * Config.Gangs.Earn.PerMoneyStolen, `emptied the {room.name}`)\n		if room.left <= 0 then\n			room.refillAt = now + BANK.RefillSeconds\n		end\n	end\n\n	if session.holding and control == \"alarm\" then\n		if not room.tripped then\n			-- Nothing to silence. Refused with a sentence rather than left to count against\n			-- a clock that is not running, which would look exactly like the panel being\n			-- broken.\n			session.holding = false\n			noticeFor(session, \"Nothing to silence yet.\")\n		else\n			session.silencingFor += elapsed\n			if session.silencingFor >= BANK.SilenceSeconds then\n				session.silencingFor = 0\n				session.holding = false\n				room.ringing = false\n				room.rearmAt = now + BANK.RearmSeconds\n				-- Deliberately not a sighting, and deliberately not a clearing of one\n				-- either. The live fix simply stops, which leaves the police believing the\n				-- last thing they were told -- that somebody is at this panel, by the front\n				-- door. Silencing the alarm buys quiet at the vault by pointing the search\n				-- at your own way out, and nobody had to write that down.\n				noticeFor(session, \"Quiet. It will arm itself again.\")\n				pushRoom(session.place)\n			end\n		end\n	end\n\n	push(player)\nend\n\n-- Clicking the dots on the vault door. Puts the player in the room's activity; it does not\n-- open anything and does not trip anything.\nfunction BankService.Open(player: Player, place: string): (boolean, string?)\n	if not enabled then\n		return false, \"The bank is closed.\"\n	end\n	local data = dataFor(player)\n	if data == nil or not data.alive then\n		return false, \"There is nobody to do it.\"\n	end\n	local bank = Vaults.Get(place)\n	if bank == nil then\n		return false, \"There is no vault here.\"\n	end\n	local at = characterPosition(player)\n	if at == nil or not Vault.InRoom(place, at) then\n		return false, \"You are not inside the bank.\"\n	end\n	local room = roomFor(place)\n	if room == nil then\n		return false, \"There is no vault here.\"\n	end\n\n	local existing = sessions[player]\n	if existing ~= nil then\n		if existing.place == place then\n			return true, nil\n		end\n		-- Two banks at once is not a state this has, and the newer one wins: the player is\n		-- standing in this one. Unreachable with one bank in town and written anyway,\n		-- because the day a second is added is not the day to discover this.\n		endSession(player)\n	end\n\n	sessions[player] = {\n		place = place,\n		holding = false,\n		taken = 0,\n		silencingFor = 0,\n		notice = nil,\n		noticeLeft = 0,\n	}\n	spawnGuard(player, room)\n	push(player)\n	return true, nil\nend\n\n-- Hands on, hands off. Which control it means is decided here from where the player is\n-- standing, never from anything the client said -- a client that could name the control\n-- could silence the alarm from the vault, which would delete the activity.\nfunction BankService.SetHolding(player: Player, holding: boolean): boolean\n	local session = sessions[player]\n	if session == nil then\n		return false\n	end\n	if holding then\n		local at = characterPosition(player)\n		if at == nil or controlAt(session.place, at) == \"between\" then\n			-- Refused rather than quietly ignored, because a hold that did nothing would\n			-- look exactly like the button being broken from thirty studs away.\n			return false\n		end\n	end\n	session.holding = holding\n	if not holding then\n		session.silencingFor = 0\n	end\n	push(player)\n	return true\nend\n\n-- Sends one of your own crew to hold the alarm. Part 3's first slice: the rank that could\n-- name its own role finally has one to hand out, and the alarm is the one control in this\n-- room that was already a shared seat rather than a private one -- see the Room type's own\n-- note on `crewHelper`. Calling again with a different id swaps who is standing there;\n-- calling with the one already out is a no-op success rather than a second body.\nfunction BankService.CallCrew(player: Player, place: string, crewId: string): (boolean, string?)\n	local session = sessions[player]\n	if session == nil or session.place ~= place then\n		return false, \"You are not inside the bank.\"\n	end\n	local room = roomFor(place)\n	if room == nil then\n		return false, \"There is no vault here.\"\n	end\n	if room.crewHelper ~= nil and room.crewHelperOwner ~= player then\n		return false, \"The alarm is already covered.\"\n	end\n	if room.crewHelper ~= nil and room.crewHelperCrewId == crewId then\n		return true, nil\n	end\n\n	local chosen: GangCrewMember? = nil\n	for _, member in GangService.CrewFor(player) do\n		if member.id == crewId then\n			chosen = member\n			break\n		end\n	end\n	if chosen == nil then\n		return false, \"That's not your crew.\"\n	end\n\n	if room.crewHelper ~= nil then\n		despawnCrewHelper(room)\n	end\n	spawnCrewHelper(player, room, chosen)\n	return true, nil\nend\n\n-- Which bank a player is currently standing in, for callers outside this file that need\n-- to name it -- the debug command, mainly, which otherwise has no way to call a bank\n-- action against \"wherever the player already is\" without duplicating `controlAt`'s reach\n-- check itself.\nfunction BankService.PlaceOf(player: Player): string?\n	local session = sessions[player]\n	return if session ~= nil then session.place else nil\nend\n\n-- Stands up every bank in the content list, once, and says which ones could not be built.\n--\n-- At startup rather than on arrival, so a missing place point is a line in the log on a\n-- developer's first boot rather than a door that does nothing on a player's fiftieth\n-- minute. It is also cheap: one room's worth of parts.\nlocal function buildBanks()\n	for _, bank in Vaults.Banks do\n		local place = PlaceService.Find(bank.place)\n		if place == nil then\n			warn(\n				`[AGES] bank \"{bank.place}\" has no place point in the built world, so it cannot be robbed. `\n					.. `Either the town no longer has that room or the id in content/Vaults.luau is wrong.`\n			)\n			continue\n		end\n		-- The plan is copied field by field rather than the content row being passed whole.\n		-- A Bank happens to carry everything a Plan needs and three things besides -- an id,\n		-- a name and a richness -- and handing the world builder a row it could read the\n		-- money off would be an invitation for it to start caring about what a vault is\n		-- worth. Vault.luau builds a room out of numbers and is not told which room.\n		local built = Vault.Build(bank.place, place.part.CFrame, bank.name, {\n			roomStuds = bank.roomStuds,\n			vault = bank.vault,\n			alarm = bank.alarm,\n			patrol = bank.patrol,\n		})\n		if built == nil then\n			warn(`[AGES] could not stand up a vault at \"{bank.place}\"; its place point has no heading.`)\n			continue\n		end\n		if #built.patrol < 2 then\n			-- Not fatal and worth saying out loud: the bank still works, it is simply a\n			-- clean twelve-second metronome with nothing interfering with it, which is a\n			-- much easier room than the one that was designed.\n			warn(\n				`[AGES] bank \"{bank.place}\" has nowhere standable for a guard to patrol, so it will run `\n					.. `on its alarm alone. Check the patrol offsets in content/Vaults.luau against the room.`\n			)\n		end\n	end\nend\n\n-- Every vault back to full and every alarm quiet, right now. The harness only.\n--\n-- Exists because the refill is fifteen minutes and testing the take is the one thing a\n-- developer does twenty times in a row. Settling the alarm as well as the money, because\n-- the two halves of a test are \"can I open it\" and \"can I shut it up\", and being handed a\n-- full vault behind a ringing bell would only ever let you retry one of them.\nfunction BankService.ResetAll()\n	for place, room in rooms do\n		room.left = room.full\n		room.refillAt = 0\n		settle(room)\n		Vault.ShowAlarm(place, \"quiet\")\n		Vault.ShowDoor(place, 0)\n	end\n	for player in sessions do\n		push(player)\n	end\nend\n\nfunction BankService.SetEnabled(value: boolean)\n	enabled = value\n	if not value then\n		for player in sessions do\n			endSession(player)\n		end\n	end\nend\n\n-- For the harness, and phrased as the questions a broken bank raises: is the room built,\n-- what is the alarm doing, and where is the guard.\nfunction BankService.Describe(player: Player): string\n	local now = os.clock()\n	local session = sessions[player]\n\n	local lines = { if enabled then \"bank on\" else \"bank OFF\" }\n	for _, bank in Vaults.Banks do\n		local built = Vault.Get(bank.place)\n		local room = rooms[bank.place]\n		if built == nil then\n			table.insert(lines, `{bank.place}: NOT BUILT`)\n			continue\n		end\n		local guard = \"none\"\n		if room ~= nil and room.guard ~= nil then\n			guard = if room.onSomebody then \"ON SOMEBODY\" else `walking to spot {room.leg}`\n		end\n		local crewHelper = \"none\"\n		if room ~= nil and room.crewHelper ~= nil then\n			crewHelper = string.format(\n				\"%s (owner %s, fail %.0f%%, %s)\",\n				room.crewHelperName or \"?\",\n				if room.crewHelperOwner ~= nil then room.crewHelperOwner.Name else \"?\",\n				room.crewHelperFailChance * 100,\n				if not room.ringing then \"idle\" elseif room.crewHelperCommitted then \"working\" else \"flinched\"\n			)\n		end\n		table.insert(\n			lines,\n			string.format(\n				\"%s: built, %d patrol spot(s), %.0f/%.0f left, alarm %s%s, %d inside, guard %s, crew %s\",\n				bank.place,\n				#built.patrol,\n				if room ~= nil then room.left else BANK.VaultFloat * bank.richness,\n				if room ~= nil then room.full else BANK.VaultFloat * bank.richness,\n				if room == nil or not room.tripped then \"quiet\" elseif room.ringing then \"RINGING\" else \"silenced\",\n				if room ~= nil and room.tripped and not room.ringing\n					then string.format(\" (%.1fs)\", math.max(room.rearmAt - now, 0))\n					else \"\",\n				#othersIn(bank.place),\n				guard,\n				crewHelper\n			)\n		)\n	end\n\n	if session == nil then\n		table.insert(lines, \"not in a bank\")\n		return table.concat(lines, \"\\n\")\n	end\n\n	local at = characterPosition(player)\n	table.insert(\n		lines,\n		string.format(\n			\"in %s · at %s · %s · taken %.0f · silencing %.2f/%.2f\",\n			session.place,\n			if at ~= nil then controlAt(session.place, at) else \"nowhere\",\n			if session.holding then \"HOLDING\" else \"hands off\",\n			session.taken,\n			session.silencingFor,\n			BANK.SilenceSeconds\n		)\n	)\n	return table.concat(lines, \"\\n\")\nend\n\nfunction BankService:Init()\n	RequestBankOpenRemote.OnServerEvent:Connect(function(player: Player, place: any)\n		-- The id the dots were built with, checked against the content list rather than\n		-- used: a client that sent \"pharmacy\" would be asking to open a vault in a room\n		-- that has none, and Open answers that by name.\n		if typeof(place) ~= \"string\" then\n			return\n		end\n		BankService.Open(player, place)\n	end)\n\n	RequestBankHoldRemote.OnServerEvent:Connect(function(player: Player, holding: any)\n		-- The one thing the client is allowed to say, and it is a boolean. Anything else is\n		-- dropped rather than coerced.\n		if typeof(holding) ~= \"boolean\" then\n			return\n		end\n		BankService.SetHolding(player, holding)\n	end)\n\n	RequestBankCallCrewRemote.OnServerEvent:Connect(function(player: Player, place: any, crewId: any)\n		if typeof(place) ~= \"string\" or typeof(crewId) ~= \"string\" then\n			return\n		end\n		BankService.CallCrew(player, place, crewId)\n	end)\n\n	Players.PlayerRemoving:Connect(function(player: Player)\n		endSession(player)\n		pushed[player] = nil\n	end)\nend\n\nfunction BankService:Start()\n	buildBanks()\n\n	task.spawn(function()\n		while true do\n			local elapsed = task.wait(BANK.TickSeconds)\n			if enabled then\n				local now = os.clock()\n				-- Rooms before players, so the alarm a player is about to be judged against\n				-- has already been armed or rung on this tick rather than on the last one.\n				for _, room in rooms do\n					local fine, problem = pcall(tickRoom, room, now, elapsed)\n					if not fine then\n						warn(`[AGES] bank room tick failed for {room.place}: {problem}`)\n					end\n				end\n				for player in sessions do\n					local fine, problem = pcall(tickPlayer, player, elapsed)\n					if not fine then\n						warn(`[AGES] bank tick failed for {player.Name}: {problem}`)\n					end\n				end\n			end\n		end\n	end)\nend\n\nreturn BankService\n"
table.insert(AGES_MANIFEST, "src/server/services/BankService.luau")
AGES_SOURCES["src/server/services/BillService.luau"] = "--!strict\n-- Monthly bills. A life pays every game month it has been alive, and the cost\n-- scales with what it owns. Houses add a fixed amount; accumulated wealth\n-- pushes the base up. Unpaid bills become debt that grows interest, and debt\n-- is the one thing in the game that compounds against the player rather than\n-- for them -- the inverse of a bank account, and deliberately so.\n--\n-- Nothing here is a remote. The client is told what it owes and when it is due;\n-- it does not ask to be billed. Billing is driven by the age-up path so a life\n-- that skips years pays for each one it skips.\n--\n-- Debt consequences live in StatService: the flag is the contract there, and\n-- BillService only sets and clears it. This file never touches stats.\n\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Config = require(ReplicatedStorage:WaitForChild(\"Config\"))\nlocal Remotes = require(ReplicatedStorage:WaitForChild(\"Remotes\"))\nlocal Types = require(ReplicatedStorage:WaitForChild(\"Types\"))\n\nlocal DataService = require(script.Parent.DataService)\nlocal Lives = require(ReplicatedStorage:WaitForChild(\"Lives\"))\nlocal MoneyService = require(script.Parent.MoneyService)\n\ntype LifeData = Types.LifeData\ntype Player = Players.Player\n\nlocal BillService = {}\n\nlocal BILLS = Config.Bills\nlocal BILL_DUE = Remotes.Get(\"BillDue\")\n\n-- Whether this life is old enough to be billed at all. A child is somebody else's\n-- dependent, and the game says so by not sending them a bill rather than by sending\n-- them one for nothing -- see Config.Bills.MinAge for why the boundary is Adulthood.\n--\n-- Asked in all three places a bill can reach the player: the charge, the state the\n-- HUD reads, and the push on join. Gating only the charge would have left a child\n-- looking at a bill they were never actually charged, which is the same bug wearing\n-- a different face.\nlocal function oldEnoughToBill(life: LifeData): boolean\n	return life.ageMonths // Config.Time.MonthsPerYear >= BILLS.MinAge\nend\n\n-- Get the life data for a player, nil if no profile or no active life.\nlocal function lifeDataFor(player: Player): LifeData?\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return nil\n	end\n	return Lives.Active(profile.Data)\nend\n\n-- Count how many suburb houses a life owns.\nlocal function houseCount(life: LifeData): number\n	local count = 0\n	for _ in life.houses.owned do\n		count = count + 1\n	end\n	return count\nend\n\n-- Compute this life's monthly bill total.\nlocal function computeBill(life: LifeData): number\n	local base = BILLS.BaseMonthly\n	local houses = houseCount(life) * BILLS.HouseMonthly\n\n	if life.money >= BILLS.LuxuryThreshold then\n		base = math.floor(base * BILLS.LuxuryMultiplier)\n	end\n\n	return base + houses\nend\n\n-- Charge a bill for a life. Called from LifeService on age-up.\n-- Returns the amount deducted (may be less than the bill if money was insufficient).\nfunction BillService.Charge(player: Player): number\n	local life = lifeDataFor(player)\n	if life == nil then\n		return 0\n	end\n\n	-- Before adulthood there is nothing to charge and nothing to record. Deliberately\n	-- leaves lastBillMonth alone rather than advancing it through childhood: the first\n	-- adult birthday then charges exactly one bill, which is the right answer. Advancing\n	-- it would work too, but it would mean eighteen writes to say nothing happened.\n	--\n	-- Still pushes, with nil, rather than returning in silence. The HUD's bill row is\n	-- only ever changed by this remote, so a path that swaps the active life without\n	-- rebuilding the client -- /slots switch does exactly that -- would otherwise leave\n	-- an adult's debt sitting over a child's head until their eighteenth birthday. One\n	-- cleared row per birthday is a cheaper contract than reasoning about which paths\n	-- can reach a stale one.\n	if not oldEnoughToBill(life) then\n		BILL_DUE:FireClient(player, nil)\n		return 0\n	end\n\n	local bill = computeBill(life)\n	local ageYears = life.ageMonths // Config.Time.MonthsPerYear\n	local billMonth = (ageYears * Config.Time.MonthsPerYear) :: number\n\n	-- Skip if this billing cycle has already been processed.\n	if life.bills.lastBillMonth >= billMonth then\n		return 0\n	end\n\n	life.bills.lastBillMonth = billMonth\n\n	-- Apply interest to existing debt first.\n	if life.bills.debt > 0 then\n		local interest = math.floor(life.bills.debt * BILLS.DebtInterestRate)\n		life.bills.debt += interest\n		if life.bills.debt > BILLS.MaxDebt then\n			life.bills.debt = BILLS.MaxDebt\n		end\n	end\n\n	-- Debt state changes are flags, not stats. They open content doors — loan sharks,\n	-- counselling, family help — so the number in bills.debt is not the only thing that\n	-- matters when a life is in the red. The flag is set the moment debt appears and\n	-- cleared the moment it vanishes; a life that dips into debt and pays it back in the\n	-- same billing cycle still gets the events that flag carries.\n	local wasInDebt = life.bills.debt > 0\n\n	local totalOwed = bill + life.bills.debt\n	local paid = MoneyService.Spend(player, totalOwed, \"monthly bill\")\n\n	if paid then\n		life.bills.debt = 0\n		if wasInDebt then\n			life.flags[\"in_debt\"] = nil\n		end\n		BILL_DUE:FireClient(player, {\n			totalThisMonth = bill,\n			debt = 0,\n			paid = true,\n			notice = \"Bill paid: \" .. tostring(bill) .. \" this month.\",\n		})\n		return totalOwed\n	else\n		-- Could not pay in full. Whatever was there goes to the bill, the rest becomes debt.\n		local remaining = totalOwed - life.money\n		if remaining < 0 then\n			remaining = 0\n		end\n		life.bills.debt = math.min(remaining, BILLS.MaxDebt)\n		if life.bills.debt > 0 then\n			life.flags[\"in_debt\"] = ageYears\n		elseif wasInDebt then\n			life.flags[\"in_debt\"] = nil\n		end\n		BILL_DUE:FireClient(player, {\n			totalThisMonth = bill,\n			debt = life.bills.debt,\n			paid = false,\n			notice = \"Could not pay the full bill. \" .. tostring(life.bills.debt) .. \" added to debt.\",\n		})\n		return life.money\n	end\nend\n\n-- Get the current bill state for a player's client.\nfunction BillService.GetState(player: Player): Types.BillState?\n	local life = lifeDataFor(player)\n	if life == nil then\n		return nil\n	end\n	-- Same nil a player with no life gets. The HUD already knows how to show nothing\n	-- for that, so a child gets no bill panel rather than an empty one -- the absence\n	-- is the message.\n	if not oldEnoughToBill(life) then\n		return nil\n	end\n	return {\n		totalThisMonth = computeBill(life),\n		debt = life.bills.debt,\n		paid = life.bills.lastBillMonth >= (life.ageMonths // Config.Time.MonthsPerYear) * Config.Time.MonthsPerYear,\n		notice = nil,\n		inDebt = life.bills.debt > 0,\n	}\nend\n\nfunction BillService:Init()\n	-- No remotes to register. Billing is driven by LifeService on age-up.\n	Players.PlayerAdded:Connect(function(player: Player)\n		-- Push current state on join.\n		local state = BillService.GetState(player)\n		if state ~= nil then\n			BILL_DUE:FireClient(player, state)\n		end\n	end)\nend\n\nfunction BillService:Start()\n	-- No background tick needed. Bills are charged on age-up.\nend\n\nreturn BillService\n"
table.insert(AGES_MANIFEST, "src/server/services/BillService.luau")
AGES_SOURCES["src/server/services/BodyService.luau"] = "--!strict\n-- The body a life is currently living in. Through the toddler years the player's\n-- capability *is* the progression: a crawler is slow, tiny and cannot jump, and\n-- five years later the same house is crossable in seconds. Nothing about the\n-- world changes to make that happen, so this service is the whole mechanism.\n--\n-- Server-authoritative on purpose. WalkSpeed and JumpPower are the difference\n-- between a room being reachable and not, so a client that could set its own\n-- would walk out of childhood early.\n\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n-- `ensureR15` parents the rebuilt character here. Every other file in this tree binds the\n-- service this way; this one read a bare `Workspace` instead, which is not a Luau global --\n-- so the R6 rebuild path threw on the assignment, and an R6 player was left standing in a\n-- destroyed-then-not-replaced character. Only R6 avatars ever reached that line, which is\n-- why it survived: on an R15 account the function returns two lines earlier.\nlocal Workspace = game:GetService(\"Workspace\")\n\nlocal Config = require(ReplicatedStorage:WaitForChild(\"Config\"))\nlocal Types = require(ReplicatedStorage:WaitForChild(\"Types\"))\nlocal Lives = require(ReplicatedStorage:WaitForChild(\"Lives\"))\n\nlocal DataService = require(script.Parent.DataService)\n\ntype ChildhoodBand = Types.ChildhoodBand\ntype AnimationSet = Types.AnimationSet\n\nlocal warnedAboutRig = false\nlocal warnedAboutAnimate = false\n\n-- The slots Roblox's own Animate script exposes as StringValue children. Checked\n-- against rather than trusted, because a mistyped slot -- \"wlak\" -- would set an\n-- animation on nothing at all and look exactly like an animation that failed to\n-- load, which is the wrong thing to go and investigate.\nlocal ANIMATION_SLOTS: { [string]: boolean } = {\n	idle = true,\n	walk = true,\n	run = true,\n	jump = true,\n	fall = true,\n	climb = true,\n	swim = true,\n	swimidle = true,\n	sit = true,\n}\n\n-- Bands are matched by id, so an entry under a band that does not exist is a\n-- typo that would otherwise be a body that never changes how it moves.\nlocal function bandExists(id: string): boolean\n	for _, band in Config.Childhood.Bands do\n		if band.id == id then\n			return true\n		end\n	end\n	return false\nend\n\n-- \"rbxassetid://507777826\" and 507777826 both mean the same thing to a person\n-- and only one of them means anything to an Animation, so both are accepted and\n-- exactly one form leaves here.\nlocal function normalizeAssetId(raw: string | number, where: string): string\n	if type(raw) == \"number\" then\n		if raw <= 0 or raw % 1 ~= 0 then\n			error(`[AGES config] {where} is {raw}; an animation asset id is a positive whole number`)\n		end\n		return `rbxassetid://{raw}`\n	end\n	local digits = string.match(raw, \"^rbxassetid://(%d+)$\") or string.match(raw, \"^(%d+)$\")\n	if digits == nil then\n		error(`[AGES config] {where} is \"{raw}\"; expected a number or \"rbxassetid://<number>\"`)\n	end\n	return `rbxassetid://{digits}`\nend\n\n-- Read once, at load, so a bad id is a server that refuses to start rather than\n-- a toddler who stands up in one specific room.\nlocal ANIMATIONS: { [string]: AnimationSet } = {}\nfor bandId, set in Config.Childhood.Animations do\n	if not bandExists(bandId) then\n		error(`[AGES config] Childhood.Animations has an entry for band \"{bandId}\", which is not in Childhood.Bands`)\n	end\n	local resolved: AnimationSet = {}\n	for slot, raw in set do\n		if not ANIMATION_SLOTS[slot] then\n			error(`[AGES config] Childhood.Animations.{bandId} has slot \"{slot}\", which the Animate script has no place for`)\n		end\n		resolved[slot] = normalizeAssetId(raw, `Childhood.Animations.{bandId}.{slot}`)\n	end\n	ANIMATIONS[bandId] = resolved\nend\n\n-- What each Animation held before we first touched it, so a band with no\n-- override for a slot puts Roblox's own back rather than leaving the last band's\n-- animation on a body that has outgrown it. Weak-keyed: a character that has\n-- been destroyed should not be kept alive by our memory of how it used to move.\nlocal originals: { [Instance]: string } = setmetatable({}, { __mode = \"k\" }) :: any\n\n-- How long to wait on a spawning character for the parts this service needs.\n-- Generous because both are waits on Roblox's own spawn sequence rather than on\n-- anything here: exceeding either means something is wrong with the rig, which\n-- is worth a warning rather than a longer wait.\nlocal HUMANOID_TIMEOUT = 10\nlocal SCALE_VALUE_TIMEOUT = 5\n\n-- Rebuild an R6 character as R15, from the player's own appearance.\n--\n-- The size ladder is written onto R15 scale values, which an R6 rig does not have --\n-- so an R6 avatar loads normal-sized and the baby body silently does not show, which\n-- reads as a broken mechanic rather than a wrong avatar setting. Rather than warn and\n-- leave it, swap in an R15 version of the same person: `GetHumanoidDescriptionFromUserId`\n-- reads their exact appearance and `CreateHumanoidModelFromDescription` rebuilds it as\n-- R15, so nobody sees a different avatar, only the same one at the same spot that can\n-- now shrink. Reassigning `player.Character` fires CharacterAdded again, so the rebuilt\n-- character takes the ordinary path below and this call stops here.\n--\n-- Returns true when the character can keep going (it is R15, or the rebuild failed and\n-- the fallback warning applies), false when the hand-off is done and the caller must\n-- return. BodyService is the only CharacterAdded listener in this place, so the second\n-- event is observed here and nowhere else.\nlocal function ensureR15(player: Player, character: Model, humanoid: Humanoid): boolean\n	if humanoid.RigType == Enum.HumanoidRigType.R15 then\n		return true\n	end\n	local ok, description = pcall(function()\n		return Players:GetHumanoidDescriptionFromUserId(player.UserId)\n	end)\n	local rebuilt: Model? = nil\n	if ok and description ~= nil then\n		rebuilt = Players:CreateHumanoidModelFromDescription(description, Enum.HumanoidRigType.R15)\n	end\n	if rebuilt == nil then\n		warn(`[AGES] {player.Name} loaded an R6 character and it could not be rebuilt as R15; the size ladder will not show`)\n		return true\n	end\n	rebuilt.Parent = Workspace\n	rebuilt:PivotTo(character:GetPivot())\n	player.Character = rebuilt\n	character:Destroy()\n	return false\nend\n\nlocal BodyService = {}\n\nfunction BodyService.BandForAge(ageYears: number): ChildhoodBand\n	for _, band in Config.Childhood.Bands do\n		if ageYears <= band.maxAge then\n			return band\n		end\n	end\n	-- Unreachable: the final band is unbounded. Returning it keeps the function\n	-- total rather than making every caller handle a nil that cannot occur.\n	return Config.Childhood.Bands[#Config.Childhood.Bands]\nend\n\nlocal function applyToHumanoid(humanoid: Humanoid, band: ChildhoodBand, ageYears: number)\n	humanoid.WalkSpeed = band.walkSpeed\n	-- Newer rigs default to JumpHeight; forcing JumpPower makes the configured\n	-- number the one that counts, including jumpPower = 0 meaning \"cannot jump\".\n	humanoid.UseJumpPower = true\n	humanoid.JumpPower = band.jumpPower\n	humanoid.CameraOffset = Vector3.new(0, band.cameraOffsetY, 0)\n\n	-- R15 exposes body proportions as NumberValues parented to the Humanoid. R6\n	-- has no equivalent, so on an R6 rig the size ladder would silently not\n	-- happen — hence the warning rather than a quiet no-op. Head stays large\n	-- relative to the body, which is most of what reads as \"young\".\n	--\n	-- Read off the age rather than off the band, so growing up is continuous and\n	-- goes on past the last band: the bands stop at five because that is where\n	-- jumping and running stop changing, but a twelve-year-old is not adult-sized\n	-- and used to be. Same curve every townsperson is built from, which is what\n	-- makes a classmate your own age actually your own height.\n	local body, head = Config.Growth.At(ageYears)\n	local scales: { [string]: number } = {\n		BodyHeightScale = body,\n		BodyWidthScale = body,\n		BodyDepthScale = body,\n		HeadScale = head,\n	}\n\n	local scaled = true\n	for valueName, target in scales do\n		local value = humanoid:FindFirstChild(valueName)\n		if value ~= nil and value:IsA(\"NumberValue\") then\n			value.Value = target\n		else\n			scaled = false\n		end\n	end\n\n	if not scaled and not warnedAboutRig then\n		warnedAboutRig = true\n		warn(\"[AGES] character rig has no R15 scale values; the childhood size ladder will not show. Set the avatar rig type to R15.\")\n	end\nend\n\n-- The Animate script reads its ids once and caches them, so writing new ones is\n-- only half the job -- it has to be made to look again. Disabling and re-enabling\n-- is the whole reload: it drops the running track and rebuilds the set from what\n-- the children say now.\n--\n-- Deferred rather than waited on, because Apply runs on the aging-up path and a\n-- yield there would put a frame between the new body and the new speed.\nlocal function reloadAnimate(animate: BaseScript)\n	animate.Disabled = true\n	task.defer(function()\n		-- The character can be gone by the next frame -- a death on the same tick\n		-- as a birthday -- and re-enabling a script that has been reparented out\n		-- of a destroyed model achieves nothing except a confusing warning.\n		if animate.Parent ~= nil then\n			animate.Disabled = false\n		end\n	end)\nend\n\n-- Swaps the character's animation set to the one this band moves with, and puts\n-- Roblox's defaults back for every slot the band does not name.\nlocal function applyAnimations(character: Model, band: ChildhoodBand)\n	local set = ANIMATIONS[band.id]\n\n	local animate = character:FindFirstChild(\"Animate\")\n	if animate == nil or not animate:IsA(\"BaseScript\") then\n		-- Silent when there is nothing to apply: a rig with no Animate script and\n		-- no overrides configured is just Roblox's default behaviour, which is\n		-- not a fault. Only worth saying when we had something to say and no\n		-- surface to say it on.\n		if set ~= nil and not warnedAboutAnimate then\n			warnedAboutAnimate = true\n			warn(`[AGES] {character.Name} has no Animate script; band \"{band.id}\" will move like a default rig`)\n		end\n		return\n	end\n\n	local changed = false\n	for _, slot in animate:GetChildren() do\n		if not slot:IsA(\"StringValue\") then\n			continue\n		end\n		local override = if set ~= nil then set[slot.Name] else nil\n\n		-- Every Animation under the slot, not the first: idle ships as two\n		-- variants the script alternates between, and swapping one of them is a\n		-- body that crawls half the time.\n		for _, animation in slot:GetChildren() do\n			if not animation:IsA(\"Animation\") then\n				continue\n			end\n			if originals[animation] == nil then\n				originals[animation] = animation.AnimationId\n			end\n			local target = override or originals[animation]\n			if animation.AnimationId ~= target then\n				animation.AnimationId = target\n				changed = true\n			end\n		end\n	end\n\n	-- Reloading unconditionally would restart the walk cycle on every birthday\n	-- and every respawn, including the ones where nothing about the set moved.\n	if changed then\n		reloadAnimate(animate)\n	end\nend\n\n-- What a band actually moves with, for the debug command. Says which slots are\n-- overridden and which are Roblox's, because \"the crawl is not playing\" has two\n-- very different causes and they are told apart here.\nfunction BodyService.DescribeAnimations(bandId: string): string\n	local set = ANIMATIONS[bandId]\n	if set == nil then\n		return `{bandId}: default rig animations, nothing overridden`\n	end\n	local slots: { string } = {}\n	for slot, id in set do\n		table.insert(slots, `{slot}={id}`)\n	end\n	table.sort(slots)\n	return `{bandId}: {table.concat(slots, \", \")}`\nend\n\n-- Applies the band for a player's current age to their current character.\n--\n-- Does nothing without a profile or a character, which is correct for the\n-- callers that re-apply a band to a life already underway -- aging up, dying --\n-- since both of those hold one already. It is *not* a safe way to size a body\n-- for the first time: the spawn path above waits for both rather than calling\n-- this and hoping, because a miss there is a player who stays adult-sized for\n-- their whole childhood.\nfunction BodyService.Apply(player: Player)\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return\n	end\n\n	local character = player.Character\n	if character == nil then\n		return\n	end\n\n	local humanoid = character:FindFirstChildOfClass(\"Humanoid\")\n	if humanoid == nil then\n		return\n	end\n\n	local ageYears = Lives.Active(profile.Data).ageMonths // Config.Time.MonthsPerYear\n	local band = BodyService.BandForAge(ageYears)\n	applyToHumanoid(humanoid, band, ageYears)\n	applyAnimations(character, band)\nend\n\nlocal function onCharacterAdded(player: Player, character: Model)\n	local humanoid = character:WaitForChild(\"Humanoid\", HUMANOID_TIMEOUT)\n	if humanoid == nil or not humanoid:IsA(\"Humanoid\") then\n		warn(`[AGES] {player.Name} spawned without a Humanoid; body band not applied`)\n		return\n	end\n\n	-- Before the scale-value wait, so an R6 character is never read for the values it\n	-- cannot have. On an R6 avatar this rebuilds the character and returns false; the\n	-- CharacterAdded event the rebuild fires then runs this same path against the R15.\n	if not ensureR15(player, character, humanoid) then\n		return\n	end\n\n	-- The scale values are created when the avatar's description is applied,\n	-- which lands after the Humanoid itself does. Reading them on the frame the\n	-- character appears therefore finds nothing on a perfectly good R15 rig, and\n	-- the code below reports that as \"this rig is R6\" -- a wrong diagnosis that\n	-- sends whoever reads it to change a setting that was never the problem.\n	--\n	-- Waiting on one is enough: they are created together, so if the first is\n	-- there the rest are, and if it never comes the rig really has none.\n	humanoid:WaitForChild(\"BodyHeightScale\", SCALE_VALUE_TIMEOUT)\n\n	-- Roblox parents the Animate script after the Humanoid too, and a band whose\n	-- animations are applied before it arrives is a toddler who walks upright for\n	-- their whole first life -- the same class of miss as the scale values above,\n	-- with the same fix.\n	character:WaitForChild(\"Animate\", SCALE_VALUE_TIMEOUT)\n\n	-- The profile is what says how old this body is, and on a fresh join it is\n	-- still loading from ProfileStore when the character spawns. Without this the\n	-- player spawns adult-sized and stays that way for the whole first life,\n	-- because nothing spawns them again to put it right -- which is exactly the\n	-- silent no-op the old comment here mistook for a safe one.\n	-- Bound, not discarded. This call used to be written as a bare `... == nil` test and the\n	-- profile it returned was thrown away, while the `Lives.Active(profile.Data)` forty lines\n	-- down read `profile` as a *global* -- nil -- and threw on the index. Every spawn died\n	-- there, one line above the `BodyService.Apply` that is the entire point of this function,\n	-- so every player stood up adult-sized no matter how correct the rest of the path was.\n	local profile = DataService.WaitForProfile(player)\n	if profile == nil then\n		warn(`[AGES] {player.Name} spawned before their profile loaded; body band not applied`)\n		return\n	end\n\n	-- Both waits above yield, and a life can end or a player leave inside them.\n	-- Applying a band to a character that has since been replaced would size the\n	-- wrong body, or resurrect a stale one.\n	if player.Character ~= character then\n		return\n	end\n\n	-- An unbegun slot has no setup yet, so its age is still zero and its body has\n	-- no band. Applying one here would size the character adult on the first frame,\n	-- before ReturnService has had a chance to begin a child life and put the right\n	-- scales on. Wait for the life to be begun, then apply.\n	local data = Lives.Active(profile.Data)\n	if not Lives.HasBegun(data) then\n		return\n	end\n\n	BodyService.Apply(player)\nend\n\nlocal function watch(player: Player)\n	player.CharacterAdded:Connect(function(character: Model)\n		onCharacterAdded(player, character)\n	end)\n	if player.Character ~= nil then\n		onCharacterAdded(player, player.Character)\n	end\nend\n\nfunction BodyService:Init()\n	Players.PlayerAdded:Connect(watch)\nend\n\nfunction BodyService:Start()\n	for _, player in Players:GetPlayers() do\n		watch(player)\n	end\nend\n\nreturn BodyService\n"
table.insert(AGES_MANIFEST, "src/server/services/BodyService.luau")
AGES_SOURCES["src/server/services/BountyService.luau"] = "--!strict\n-- Heat: the number the police are working from, and what it costs when they win.\n--\n-- Split from PoliceService for the reason Lab is split from ScienceService and Studio\n-- from ArtService: how much trouble you are in and who is currently walking toward you\n-- are different questions, and re-tuning a pursuit must never be able to touch what a\n-- conviction does to a life. The dependency runs one way and only one way -- PoliceService\n-- reads this file, this file has never heard of it. That is what lets an arrest be\n-- implemented here as \"set the number to zero\" and lets the officers notice on their own\n-- tick that there is no longer anybody to chase.\n--\n-- The two ideas worth reading before changing anything:\n--\n-- **The police do not know where you are.** They know where you were last *seen*, and\n-- everything else is inference. This file owns that sighting -- when it happened, where,\n-- and how stale it has got -- and it is the only thing in the system that does. An\n-- officer asking \"where do I go\" is asking this file, and the honest answer is usually\n-- wrong, which is the entire game.\n--\n-- **Heat is spent, not suffered.** A crime buys trouble at a price it sets itself. That\n-- makes taking more a decision rather than a preference, and it is why the number is\n-- public and continuous rather than a wanted flag: three quarters of a manhunt has to\n-- feel different from all of one, or there is nothing to weigh.\n--\n-- Nothing here spawns a body, draws anything, or knows what a crime is. This is the\n-- number.\n\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Config = require(ReplicatedStorage:WaitForChild(\"Config\"))\nlocal Remotes = require(ReplicatedStorage:WaitForChild(\"Remotes\"))\nlocal Types = require(ReplicatedStorage:WaitForChild(\"Types\"))\nlocal Lives = require(ReplicatedStorage:WaitForChild(\"Lives\"))\n\nlocal DataService = require(script.Parent.DataService)\nlocal GangService = require(script.Parent.GangService)\nlocal LifeService = require(script.Parent.LifeService)\nlocal MoneyService = require(script.Parent.MoneyService)\n\nlocal Spotting = require(script.Parent.Parent.world.Spotting)\n\ntype LifeData = Types.LifeData\ntype BountyState = Types.BountyState\n\n-- ArrestedHandler fires the instant a life is convicted — before custody ages\n-- them forward, so the flag can be read on the very next tick. Registered by\n-- CrimeService; nobody else needs to know it exists.\ntype ArrestedHandler = (player: Player) -> ()\nlocal arrestedHandler: ArrestedHandler? = nil\n\nlocal BountyService = {}\n\n-- Below the table, not above it. This function was written four lines *before*\n-- `local BountyService = {}` existed, so it indexed a nil global and threw while the\n-- module body was still running -- and `init.server.luau` requires this file at the top,\n-- before a single Init is called, so the throw took the whole bootstrap with it. That is\n-- the worst version of this bug in the tree: not a service that fails, a server that\n-- never starts. `check_decl_order` did not see it because it looks for *calls* to a name\n-- used too early, and this is a *definition* written too early.\nfunction BountyService.SetArrestedHandler(handler: ArrestedHandler)\n	arrestedHandler = handler\nend\n\nlocal CRIME = Config.Crime\nlocal SPOT = CRIME.Spotting\n\nlocal BountyUpdatedRemote = Remotes.Get(\"BountyUpdated\")\n\n-- One tier, as authored in Config.Crime.Tiers.\ntype Tier = {\n	atLeast: number,\n	name: string,\n	officers: number,\n	sightStuds: number,\n	searchRadiusStuds: number,\n}\n\n-- What the police currently believe, per player. Session state rather than saved state,\n-- and the split is exact: the *number* survives a disconnect because otherwise leaving is\n-- a free escape, and everything in here does not, because a belief about where somebody\n-- was standing four minutes ago in a session that has ended is not a belief worth keeping.\ntype Watch = {\n	-- Where the police think you are. Nil means genuinely no idea, which is the state a\n	-- player with heat on them is playing to reach.\n	lastKnown: Vector3?,\n	-- Seconds since that sighting. What turns a converge into a spread -- see\n	-- Config.Crime.SightingHoldSeconds -- because officers who walk to a spot and stand on\n	-- it read as broken rather than as searching.\n	sightingAge: number,\n	-- Seconds since anybody last had eyes on the player, and the thing the decay waits on.\n	-- Starts at a number large enough to mean \"not recently\" rather than at zero, because\n	-- zero would mean *just now* and would freeze the heat of somebody nobody has ever\n	-- seen.\n	unseenFor: number,\n	-- Whether anybody had eyes on the player on the most recent tick. Held rather than\n	-- recomputed because two different readers want it in the same tick and the answer is\n	-- expensive enough to be worth asking once.\n	seen: boolean,\n	-- Whether anybody could say what you look like. Set by every sighting and destroyed\n	-- by a change of clothes, and it is what ordinary people on the street read: a town\n	-- can only recognise a face it has been given.\n	--\n	-- Separate from the heat on purpose. Heat is what you did; a description is what they\n	-- know about who did it, and the whole of the disguise verb lives in the gap between\n	-- those two. A player who has been reported but never actually seen -- which is not\n	-- currently reachable, but will be the moment an alarm or a tip-off exists -- is\n	-- wanted by a police force with nothing to go on, and that should mean something.\n	described: boolean,\n	notice: string?,\n	noticeLeft: number,\n}\n\nlocal watches: { [Player]: Watch } = {}\nlocal pushed: { [Player]: string } = {}\nlocal enabled = true\n\n-- Long enough to read as \"nobody has seen you in a while\" on the first tick of a life.\n-- Any value past CoolStartSeconds does the same job; this one is obviously past it.\nlocal NEVER_SEEN = 3600\n\n-- The tiers, checked once at require time rather than trusted.\n--\n-- Every number in this system is read off this ladder, so a ladder that is out of order\n-- or does not start at zero produces a game that is subtly wrong everywhere at once and\n-- obviously wrong nowhere -- an officer count that goes down as heat goes up, or a player\n-- at three points with nothing to look up. Both are one typo away and neither would throw.\nlocal TIERS: { Tier } = CRIME.Tiers\n\ndo\n	if #TIERS == 0 then\n		error(\"[AGES config] Config.Crime.Tiers is empty, so no bounty could ever mean anything.\")\n	end\n	if TIERS[1].atLeast ~= 0 then\n		error(\n			`[AGES config] Config.Crime.Tiers starts at {TIERS[1].atLeast} rather than 0, so a player`\n				.. ` with no heat on them has no tier to be in. The first rung must be the clean one.`\n		)\n	end\n	for index = 2, #TIERS do\n		local under = TIERS[index - 1]\n		local over = TIERS[index]\n		if over.atLeast <= under.atLeast then\n			error(\n				`[AGES config] Config.Crime.Tiers is out of order: \"{over.name}\" starts at {over.atLeast},`\n					.. ` which is not above \"{under.name}\" at {under.atLeast}. Tiers must climb.`\n			)\n		end\n		if over.officers < under.officers then\n			error(\n				`[AGES config] Config.Crime.Tiers has \"{over.name}\" sending {over.officers} officers`\n					.. ` where \"{under.name}\" below it sends {under.officers}. More heat must never mean`\n					.. ` fewer police -- that is a difficulty curve that goes backwards.`\n			)\n		end\n	end\n	if TIERS[#TIERS].atLeast >= CRIME.MaxBounty then\n		error(\n			`[AGES config] the top tier \"{TIERS[#TIERS].name}\" starts at {TIERS[#TIERS].atLeast}, at or`\n				.. ` above Config.Crime.MaxBounty of {CRIME.MaxBounty}, so it can never be reached.`\n		)\n	end\nend\n\n-- Deliberately no character-position helper in this file, unlike every other service that\n-- ticks. Nothing here ever asks where the player actually is -- it could not do its job\n-- honestly if it did. A sighting arrives with the position it was made from, because a\n-- camera sees you where the camera is pointed and a witness reports the corner they saw\n-- you on rather than wherever you got to afterwards.\nlocal function watchFor(player: Player): Watch\n	local existing = watches[player]\n	if existing ~= nil then\n		return existing\n	end\n	local made: Watch = {\n		lastKnown = nil,\n		sightingAge = 0,\n		unseenFor = NEVER_SEEN,\n		seen = false,\n		described = false,\n		notice = nil,\n		noticeLeft = 0,\n	}\n	watches[player] = made\n	return made\nend\n\n-- Everything the police believe about you, dropped: where you were, that they can see you,\n-- and what you look like.\n--\n-- Not the heat. That is a number about what you *did* and it survives every one of the four\n-- things that call this -- a change of clothes, an arrest, a debug wipe, and the moment the\n-- number itself reaches zero. Keeping the two apart is what makes a disguise an escape\n-- rather than an undo.\nlocal function loseTrack(watch: Watch)\n	watch.lastKnown = nil\n	watch.seen = false\n	watch.unseenFor = NEVER_SEEN\n	watch.described = false\nend\n\nlocal function dataFor(player: Player): LifeData?\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return nil\n	end\n	return Lives.Active(profile.Data)\nend\n\n-- Which rung a number sits on. Walks down rather than up so the *highest* matching tier\n-- wins, which is the one the player is actually in.\nlocal function tierFor(bounty: number): Tier\n	for index = #TIERS, 1, -1 do\n		local tier = TIERS[index]\n		if bounty >= tier.atLeast then\n			return tier\n		end\n	end\n	return TIERS[1]\nend\n\n-- Which rung index, for the custody table, which is written against the same ladder.\nlocal function tierIndexFor(bounty: number): number\n	for index = #TIERS, 1, -1 do\n		if bounty >= TIERS[index].atLeast then\n			return index\n		end\n	end\n	return 1\nend\n\nlocal function noticeFor(player: Player, text: string)\n	local watch = watchFor(player)\n	watch.notice = text\n	watch.noticeLeft = 4\nend\n\nlocal function stateFor(player: Player): BountyState?\n	local data = dataFor(player)\n	if data == nil or not data.alive then\n		return nil\n	end\n	local bounty = data.bounty\n	local watch = watches[player]\n	-- No heat and nothing being said about it is not a state worth a panel. Returning nil\n	-- rather than a zeroed snapshot is what takes the HUD off screen entirely, which is\n	-- right: a heat bar sitting at zero for the forty years somebody spends not committing\n	-- crimes is furniture.\n	if bounty <= 0 and (watch == nil or watch.notice == nil) then\n		return nil\n	end\n\n	local tier = tierFor(bounty)\n	local seen = watch ~= nil and watch.seen\n	return {\n		share = math.clamp(bounty / CRIME.MaxBounty, 0, 1),\n		tier = tier.name,\n		officers = tier.officers,\n		seen = seen,\n		cooling = not seen and watch ~= nil and watch.unseenFor >= CRIME.CoolStartSeconds and bounty > 0,\n		lastKnown = if watch ~= nil then watch.lastKnown else nil,\n		searchRadiusStuds = tier.searchRadiusStuds,\n		hasRecord = data.convictions > 0,\n		notice = if watch ~= nil then watch.notice else nil,\n	}\nend\n\nlocal function push(player: Player)\n	local state = stateFor(player)\n	-- A digest rather than a deep compare, and it has to name every field that is drawn.\n	--\n	-- The last known position is quantised to whole studs on purpose. It is a Vector3 that\n	-- moves every time an officer blinks at a walking player, and at full precision this\n	-- would push a packet on every tick of every pursuit for a marker the player cannot\n	-- see move by a tenth of a stud.\n	local digest: string\n	if state == nil then\n		digest = \"none\"\n	else\n		local known = state.lastKnown\n		digest = `{math.floor(state.share * 200)}/{state.tier}/{state.officers}/`\n			.. `{tostring(state.seen)}/{tostring(state.cooling)}/`\n			.. `{if known ~= nil then `{math.floor(known.X)},{math.floor(known.Z)}` else \"-\"}/`\n			.. `{math.floor(state.searchRadiusStuds)}/{tostring(state.hasRecord)}/{tostring(state.notice)}`\n	end\n\n	if pushed[player] == digest then\n		return\n	end\n	pushed[player] = digest\n	BountyUpdatedRemote:FireClient(player, state)\nend\n\nlocal function forget(player: Player)\n	watches[player] = nil\n	pushed[player] = nil\nend\n\n-- One player's heat, for one tick. Everything in here is about the *number*; where the\n-- officers are standing is PoliceService's tick and runs separately.\nlocal function tickPlayer(player: Player, elapsed: number)\n	local watch = watches[player]\n	if watch == nil then\n		return\n	end\n\n	if watch.noticeLeft > 0 then\n		watch.noticeLeft -= elapsed\n		if watch.noticeLeft <= 0 then\n			watch.notice = nil\n			watch.noticeLeft = 0\n		end\n	end\n\n	local data = dataFor(player)\n	if data == nil or not data.alive then\n		push(player)\n		return\n	end\n\n	watch.unseenFor += elapsed\n	watch.sightingAge += elapsed\n	-- Cleared here rather than by whoever set it, because \"seen\" is a claim about the tick\n	-- that just happened and the only thing that knows a tick ended is this loop. An\n	-- officer that still has eyes on the player will set it again before the next pass.\n	watch.seen = false\n\n	if data.bounty <= 0 then\n		-- Heat gone means the belief goes with it. Without this an officer sent out by the\n		-- next crime would start from a sighting that belonged to the last one, which reads\n		-- as the police having remembered something they were never told. The description\n		-- goes with it for the same reason: a town that kept recognising somebody nobody\n		-- is looking for would be a spree's first crime following it for the rest of a life.\n		loseTrack(watch)\n		push(player)\n		return\n	end\n\n	if not enabled then\n		push(player)\n		return\n	end\n\n	-- The freeze. Heat does not fall at all while somebody has eyes on you, and does not\n	-- start falling the instant they lose them -- an officer who has just turned a corner\n	-- has not given up looking, and a number that resumed cooling in the same frame would\n	-- be telling the player that they had.\n	if watch.unseenFor >= CRIME.CoolStartSeconds then\n		data.bounty = math.max(0, data.bounty - CRIME.DecayPerSecond * elapsed)\n		if data.bounty <= 0 then\n			data.bounty = 0\n			watch.lastKnown = nil\n			noticeFor(player, \"You are not being looked for any more.\")\n		end\n	end\n\n	push(player)\nend\n\n-- Raises the heat. The only way it ever goes up, and every caller has to say why -- the\n-- reason is not decoration, it is what the notice on screen says, and a player who cannot\n-- tell which of the things they just did was the expensive one cannot learn to do it\n-- differently.\nfunction BountyService.Add(player: Player, points: number, reason: string): number\n	local data = dataFor(player)\n	if data == nil or not data.alive or points <= 0 then\n		return if data ~= nil then data.bounty else 0\n	end\n\n	local before = data.bounty\n	data.bounty = math.clamp(before + points, 0, CRIME.MaxBounty)\n\n	-- Only worth saying when it moves you between rungs. A running commentary on every\n	-- point would be noise over the top of a chase, and the tier is what actually changed\n	-- about the player's afternoon.\n	local wasTier = tierFor(before)\n	local nowTier = tierFor(data.bounty)\n	if nowTier.name ~= wasTier.name then\n		noticeFor(player, `{reason}. You are {nowTier.name}.`)\n	end\n\n	push(player)\n	return data.bounty\nend\n\n-- Somebody has eyes on the player, right now, and this is where they are. Called by\n-- PoliceService for an officer with line of sight, and later by a camera or a witness --\n-- which is exactly why it takes a position rather than reading one: a camera sees you\n-- where the camera is pointed, and a witness reports the corner they saw you on rather\n-- than wherever you got to afterwards.\nfunction BountyService.Sighted(player: Player, at: Vector3)\n	local watch = watchFor(player)\n	watch.lastKnown = at\n	watch.sightingAge = 0\n	watch.unseenFor = 0\n	watch.seen = true\n	-- Every sighting is also a description. Set here rather than at each call site so a\n	-- disguise can never be defeated by one and not another: whatever saw you -- officer,\n	-- camera, clerk, passer-by -- got a look at what you are wearing, and the one that\n	-- forgot to say so would be a hole the player could find and nobody could explain.\n	watch.described = true\nend\n\n-- Nobody can say what you look like any more.\n--\n-- The one thing in this system that moves a number *down* other than time, and it is\n-- deliberately not the heat: what you did still stands, and there are still the same\n-- officers out. What goes is where they think you are and who they are looking for --\n-- so a converge becomes a search of somewhere you are not, and the street stops turning\n-- to look at you. `seen` and `unseenFor` are reset with it because leaving them would\n-- have the decay still frozen for a player nobody can identify.\n--\n-- Idempotent, and the caller is told whether it actually did anything: changing clothes\n-- while already unrecognised should not be sold to the player as an escape.\nfunction BountyService.LoseDescription(player: Player): boolean\n	local watch = watches[player]\n	if watch == nil or not watch.described then\n		return false\n	end\n	loseTrack(watch)\n	noticeFor(player, \"Different clothes. They have lost you.\")\n	push(player)\n	return true\nend\n\n-- Whether the police have anything to go on. Read by the crowd, which will not recognise\n-- a face nobody has described to it.\nfunction BountyService.Described(player: Player): boolean\n	local watch = watches[player]\n	return watch ~= nil and watch.described\nend\n\n-- Whether anybody had eyes on the player as of the last tick.\n--\n-- Already on the wire for the HUD; exported for the disguise, which needs the same fact on\n-- the server and must not be given the pushed state to read it out of. It is a claim about\n-- one tick and nothing longer -- see the note where the tick clears it -- which is exactly\n-- what \"not while they can see you\" means.\nfunction BountyService.IsSeen(player: Player): boolean\n	local watch = watches[player]\n	return watch ~= nil and watch.seen\nend\n\n-- Somebody saw the player do something, and it cost them. The sighting and the heat in one\n-- call, because they are one event.\n--\n-- This is where a record has its teeth, and it is one function rather than a multiplier\n-- sprinkled through every activity for the reason the comment on SuspicionMultiplier\n-- already gives: a branch written in one place and forgotten in another is how a\n-- consequence quietly stops applying to three of the four things that can trigger it. A\n-- till, a camera, a witness and a bank guard all end up here, so all four recognise a known\n-- face faster without any of them knowing that records exist.\n--\n-- Kept separate from Add rather than folded into it because Add is the ledger and has to\n-- mean what it says: `/bounty 20` awarding 32 to a player with a conviction would be a\n-- debug command that lies, and a flat penalty that has nothing to do with being observed\n-- would pick up a multiplier that is explicitly about being observed.\nfunction BountyService.Seen(player: Player, points: number, reason: string, at: Vector3): number\n	local total = BountyService.Add(player, points * BountyService.SuspicionMultiplier(player), reason)\n	BountyService.Sighted(player, at)\n	return total\nend\n\n-- Where the police should be looking, and how wide. Nil means nobody has any idea, which\n-- is a real answer and the caller has to have a plan for it.\n--\n-- The second return is how stale the belief is, and it is the thing that turns a converge\n-- into a spread: officers all walking to one exact spot is what a fresh sighting looks\n-- like, and officers fanning out from a spot nobody has confirmed in ten seconds is what\n-- a search looks like. Same data, and the age is the whole difference.\nfunction BountyService.LastKnown(player: Player): (Vector3?, number)\n	local watch = watches[player]\n	if watch == nil then\n		return nil, 0\n	end\n	return watch.lastKnown, watch.sightingAge\nend\n\n-- The heat, and zero for a life that is over.\n--\n-- Death reading as zero here rather than as the stored number is what takes the officers\n-- off the street when a player dies, and it is deliberately done in this one function\n-- rather than as a death check inside the pursuit. PoliceService already has exactly one\n-- line that removes a body -- \"the tier says nobody should be out\" -- and routing death\n-- through it means dying, cooling off, being arrested and switching the system off all\n-- leave by the same door. A second exit is a second thing to forget.\n--\n-- The stored number is left alone, not cleared. A life that ended wanted stays wanted in\n-- the save; it is simply not being pursued any more, because there is nobody to pursue.\nfunction BountyService.Get(player: Player): number\n	local data = dataFor(player)\n	if data == nil or not data.alive then\n		return 0\n	end\n	return data.bounty\nend\n\n-- The tier a player is currently in. PoliceService reads this every tick to decide how\n-- many bodies should be in the world and how far they can see.\nfunction BountyService.TierOf(player: Player): Tier\n	return tierFor(BountyService.Get(player))\nend\n\n-- How much this player stands out, right now, to anybody who happens to look.\n--\n-- Lives here because two of the three things that make somebody conspicuous are already\n-- owned by this file -- the bounty itself and whether they are wearing colors -- and the\n-- third is read straight off the body. Putting it anywhere else would mean a second module\n-- that needs the heat, the colors and a profile lookup, which is this one with a different\n-- name on it. Both observers that use it, the police and the crowd, already require this\n-- service, so it also costs no new edge in the require graph.\n--\n-- A player with no profile, or a dead one, reads as nil here and 0 to callers: nobody\n-- notices a person who is not there. Every caller is mid-tick doing something else and none\n-- of them has a sensible branch for \"we do not know yet\", which is the same reasoning\n-- HasRecord gives below.\nlocal function spottingFactors(player: Player): Spotting.Factors?\n	local data = dataFor(player)\n	if data == nil or not data.alive then\n		return nil\n	end\n	return {\n		heatShare = math.clamp(data.bounty / CRIME.MaxBounty, 0, 1),\n		speedStuds = Spotting.SpeedOf(player.Character),\n		wearingColors = Lives.WearingColors(data),\n	}\nend\n\nfunction BountyService.Conspicuousness(player: Player): number\n	local factors = spottingFactors(player)\n	if factors == nil then\n		return 0\n	end\n	return Spotting.Conspicuousness(factors)\nend\n\n-- The same number with its working shown, for the harness.\n--\n-- Worth its own function rather than a print at the call site, because the whole complaint\n-- this system was built to answer is that a player could not tell why they were being\n-- found. The first person who needs to see the three terms separately is whoever is tuning\n-- them, and the second is whoever wonders why standing still did not help -- and if the\n-- answer is \"you are wearing colors and carrying half the cap in heat\", that is a sentence\n-- somebody should be able to read rather than infer.\nfunction BountyService.DescribeConspicuousness(player: Player): string\n	local factors = spottingFactors(player)\n	if factors == nil then\n		return \"not in a life — nothing to notice\"\n	end\n	return string.format(\n		\"conspicuousness %.2f = base %.2f + heat %.2f (%d%% of cap) + movement %.2f (%.1f studs/s) + colors %.2f\",\n		Spotting.Conspicuousness(factors),\n		SPOT.Base,\n		SPOT.HeatShare * factors.heatShare,\n		math.floor(factors.heatShare * 100 + 0.5),\n		SPOT.MovementShare * math.clamp(factors.speedStuds / SPOT.RunSpeedStuds, 0, 1),\n		factors.speedStuds,\n		if factors.wearingColors then SPOT.ColorsBonus else 0\n	)\nend\n\n-- The record, for callers holding a Player rather than a life.\n--\n-- Thin on purpose. What a conviction *means* is three functions in Lives, which requires\n-- nothing but Config and Types precisely so that hiring -- on the far side of a require\n-- cycle from here -- can ask the same question and get the same answer. These three are a\n-- profile lookup and a forward, and the day they grow a rule of their own is the day the\n-- record has two definitions again.\n--\n-- A player with no profile loaded reads as clean rather than as an error, because every\n-- caller is in the middle of doing something else -- aiming a camera, refusing a job -- and\n-- none of them has a sensible branch for \"we do not know yet\".\nfunction BountyService.HasRecord(player: Player): boolean\n	local data = dataFor(player)\n	return data ~= nil and Lives.HasRecord(data)\nend\n\n-- Both multipliers at once, because every caller wants the product and none of them wants\n-- to remember there are two. A record makes you quicker to recognise; a bright band on your\n-- head makes you quicker to describe; a life with both is charged for both.\nfunction BountyService.SuspicionMultiplier(player: Player): number\n	local data = dataFor(player)\n	if data == nil then\n		return 1\n	end\n	return Lives.SuspicionMultiplier(data) * Lives.ColorsMultiplier(data)\nend\n\nfunction BountyService.HiringBarMultiplier(player: Player): number\n	local data = dataFor(player)\n	if data == nil then\n		return 1\n	end\n	return Lives.HiringBarMultiplier(data)\nend\n\n-- Caught.\n--\n-- Deliberately not a death and deliberately not a wait. The player loses years, not\n-- minutes: the sentence runs through the ordinary per-year path so those years decay\n-- stats and cross stage boundaries exactly as if they had been lived -- because they\n-- were -- and the player is never asked to sit in a room while it happens. A jail you\n-- wait out is the purest form of the idle-time bug this project keeps designing away.\n--\n-- What is actually being charged here is the record. The years are the headline and the\n-- record is the sentence: from now on this life is recognised faster and hired harder,\n-- on every job and every crime, until it ends.\nfunction BountyService.Arrest(player: Player): boolean\n	local data = dataFor(player)\n	if data == nil or not data.alive or data.bounty <= 0 then\n		return false\n	end\n\n	-- Decided before anything is written, so a second arrest arriving behind this one --\n	-- two officers making contact on the same tick -- finds the bounty already at zero and\n	-- refuses at the door above rather than sentencing the player twice for one bust.\n	local tierIndex = tierIndexFor(data.bounty)\n	local years = CRIME.CustodyYearsByTier[tierIndex] or 0\n	local carried = data.money\n\n	data.bounty = 0\n	data.convictions += 1\n\n	loseTrack(watchFor(player))\n\n	-- Before the sentence rather than after it, and that ordering matters for one specific\n	-- reason: AgeUp below can end the life, and a life that ended in custody must still\n	-- have had its standing charged. It also clears the escape peak, which has to happen\n	-- while the bounty being zeroed is still fresh -- otherwise GangService's next tick\n	-- reads a bounty that fell from high to nothing and pays out the escape award for an\n	-- arrest, which would be the largest number in that table going to the worst possible\n	-- event.\n	GangService.OnArrest(player)\n\n	if arrestedHandler ~= nil then\n		arrestedHandler(player)\n	end\n\n	-- The haul, such as it is. Everything on you rather than a fixed fine, because a fine\n	-- is a number and confiscation is the job not having happened -- which is the thing\n	-- being said. Nothing to take is a perfectly good outcome and is not an error.\n	if carried > 0 then\n		MoneyService.Spend(player, carried, \"confiscated on arrest\")\n	end\n\n	-- Bounded by construction: one pass per year of the sentence, and the table it is read\n	-- from is capped in Config. AgeUp refuses on its own once a life is over, so a sentence\n	-- that outlives its owner stops rather than ageing a corpse.\n	for _ = 1, years do\n		if not data.alive then\n			break\n		end\n		LifeService.AgeUp(player, \"Custody\")\n	end\n\n	local sentence = if years == 1 then \"a year\" else `{years} years`\n	if years <= 0 then\n		noticeFor(player, \"Picked up and let go with a caution. It is on your record.\")\n	else\n		noticeFor(player, `Convicted. {sentence} gone, and a record that does not go.`)\n	end\n	push(player)\n	return true\nend\n\n-- Drops the heat without a conviction. For the debug harness and for the day something\n-- legitimate forgives a bounty; not reachable by playing.\nfunction BountyService.Clear(player: Player)\n	local data = dataFor(player)\n	if data ~= nil then\n		data.bounty = 0\n	end\n	loseTrack(watchFor(player))\n	push(player)\nend\n\n-- No ResetForNewLife, deliberately, and this is the one service LifeService does not have\n-- to remember on a rebirth.\n--\n-- It could not have one anyway: this file spends years through LifeService, so a call the\n-- other way would close a require cycle. But it also does not need one. Both fields this\n-- system owns live on LifeData, and a new life is a new Lives.New() with `bounty` and\n-- `convictions` already at zero -- so a newborn is clean by construction rather than by\n-- being cleaned. The session state above is keyed by player rather than by life, and the\n-- tick clears the stale belief within one pass of the number reading zero.\n--\n-- The record going is the only clean slate this game offers, and it costs exactly what\n-- starting again costs, which is the right price for it.\n\nfunction BountyService.SetEnabled(value: boolean)\n	enabled = value\nend\n\nfunction BountyService.IsEnabled(): boolean\n	return enabled\nend\n\n-- What the harness prints. Every number the pursuit is running on, in one line, because\n-- the whole system is invisible by construction: heat, a belief and a search radius all\n-- look identical from inside the game, which is a player standing in a street.\nfunction BountyService.Describe(player: Player): string\n	local data = dataFor(player)\n	if data == nil then\n		return \"no profile loaded yet\"\n	end\n	local watch = watches[player]\n	local tier = tierFor(data.bounty)\n	local known = if watch ~= nil then watch.lastKnown else nil\n	return string.format(\n		\"bounty %.1f/%d (%s, %d officers, sight %d, search %d) · convictions %d (suspicion x%.2f, hiring bar x%.2f) · colors x%.2f · %s · last known %s (%.1fs old) · %s\",\n		data.bounty,\n		CRIME.MaxBounty,\n		tier.name,\n		tier.officers,\n		tier.sightStuds,\n		tier.searchRadiusStuds,\n		data.convictions,\n		-- The record's two teeth, spelled out rather than left to be inferred from the\n		-- conviction count. They are applied a long way from here -- one in a shop, one at\n		-- a hiring desk -- and a tester who has to multiply in their head to check whether\n		-- a record is working is a tester who will not check.\n		Lives.SuspicionMultiplier(data),\n		Lives.HiringBarMultiplier(data),\n		-- Separately from the record's own multiplier above, because the two stack and a\n		-- single combined figure would leave a tester unable to tell which of the two is\n		-- responsible for a number that looks too high.\n		Lives.ColorsMultiplier(data),\n		if watch ~= nil and watch.seen then \"IN SIGHT\" else string.format(\"unseen %.1fs\", if watch ~= nil then watch.unseenFor else 0),\n		if known ~= nil then string.format(\"%d,%d\", known.X, known.Z) else \"nowhere\",\n		if watch ~= nil then watch.sightingAge else 0,\n		if enabled then \"on\" else \"off\"\n	)\nend\n\nfunction BountyService:Start()\n	Players.PlayerRemoving:Connect(forget)\n\n	task.spawn(function()\n		while true do\n			local elapsed = task.wait(CRIME.TickSeconds)\n			for _, player in Players:GetPlayers() do\n				local fine, problem = pcall(tickPlayer, player, elapsed)\n				if not fine then\n					warn(`[AGES] bounty tick failed for {player.Name}: {problem}`)\n				end\n			end\n		end\n	end)\nend\n\nreturn BountyService\n"
table.insert(AGES_MANIFEST, "src/server/services/BountyService.luau")
AGES_SOURCES["src/server/services/BullyService.luau"] = "--!strict\n-- The corridor between lessons, and holding your nerve in it.\n--\n-- The walk from the school door to the desk used to be zero studs long. You stepped on a\n-- pad and a lesson happened, so there was nowhere for anything to be *between* lessons,\n-- and twelve years of school were twelve years of arriving. This is what is in the way.\n--\n-- The loop:\n--\n--   Somebody steps across you in the corridor and says what they want. Two bars appear:\n--   yours, rising while you hold the key, and theirs, falling on its own. Let go while\n--   yours is in the band just above theirs and you have faced them down. Let go below it\n--   and you backed off, and they take the toll. Hold past the band and you overcommitted,\n--   which is worse than backing off, because now everybody is watching.\n--\n-- One key, and the release *value* is what scores it -- so the whole verb survives a\n-- phone and survives 200ms of ping. Nothing here is a reflex test: the bars move slowly\n-- enough to read, and what a player learns over thirty corridors is not faster fingers\n-- but which of these three people is lying to them.\n--\n-- What makes it a decision rather than a button is that there are two clocks at the tiers\n-- where the corridor sends people in pairs. The first bar says when the window opens; the\n-- backup walking toward you says when it shrinks. Two queues at half load each, which is\n-- the shape the activity law asks for -- and it is why the top tier is a second person\n-- rather than a bigger number on the first.\n--\n-- Everything the player can lose here is upside. Backing down costs the toll and a point\n-- of happiness; it never costs the lesson, never costs a rung of anything already earned,\n-- and there is no state you can be put into that you have to wait your way out of. The\n-- one thing that is *taken* is your homework, and that is a walk to the library rather\n-- than a penalty -- burst, forced traversal, burst, which is the corridor generating its\n-- own pacing out of the one consumable it has.\n--\n-- 13+ throughout, and by construction rather than by moderation. Nothing here is said\n-- about the player: every line in content/Bullies.luau is about the toll or about who\n-- moves first. There is no gore and no injury. The only door into contact at all is\n-- overholding against somebody you have already faced down -- see Config.TipsIntoFight --\n-- and what is on the other side of that door is FightService, which is already a contest\n-- with a winner that ends with everybody back on their feet.\n--\n-- Split three ways for the reason the other school subjects are: Corridor lays the floor,\n-- content/Bullies.luau says who stands on it, and this file is the only thing that knows\n-- how a stare-down is scored. Re-laying the corridor must never be able to touch the\n-- scoring, and writing a fourth bully must never require reading this file.\n\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Config = require(ReplicatedStorage:WaitForChild(\"Config\"))\nlocal Lives = require(ReplicatedStorage:WaitForChild(\"Lives\"))\nlocal Remotes = require(ReplicatedStorage:WaitForChild(\"Remotes\"))\nlocal Types = require(ReplicatedStorage:WaitForChild(\"Types\"))\n\nlocal DataService = require(script.Parent.DataService)\nlocal FightService = require(script.Parent.FightService)\nlocal MoneyService = require(script.Parent.MoneyService)\nlocal NPCService = require(script.Parent.NPCService)\nlocal PlaceService = require(script.Parent.PlaceService)\nlocal SkillService = require(script.Parent.SkillService)\nlocal StatService = require(script.Parent.StatService)\nlocal Corridor = require(script.Parent.Parent.world.Corridor)\nlocal School = require(script.Parent.Parent.world.School)\nlocal Bullies = require(script.Parent.Parent.content.Bullies)\n\ntype LifeData = Types.LifeData\ntype NerveState = Types.NerveState\ntype BullyArchetype = Types.BullyArchetype\ntype Visitor = NPCService.Visitor\n\nlocal BullyService = {}\n\nlocal NerveUpdatedRemote = Remotes.Get(\"NerveUpdated\")\nlocal RequestNerveHoldRemote = Remotes.Get(\"RequestNerveHold\")\n\nlocal BULLY = Config.School.Bully\nlocal NERVE = BULLY.Nerve\nlocal DRAIN = BULLY.Drain\nlocal TOLL = BULLY.Toll\nlocal HOMEWORK = BULLY.Homework\n\n-- The place id the corridor answers to. The same one SchoolService uses, because the\n-- corridor is a room in that building and not a second location -- if these ever\n-- disagreed the corridor would be laid around a school nobody attends.\nlocal PLACE_ID = \"school\"\n\n-- The ceiling nerve is measured against, borrowed from the stat scale rather than given a\n-- number of its own. bullyNerve is not a stat, but it is written and read on the same\n-- 0..100 scale as one, and a second ceiling here would be a second thing to keep in step.\nlocal NERVE_MAX = Config.Stats.Max\n\n-- One stare-down in progress. Only ever one per player: you cannot be stood in front of\n-- by two people in two places, and the paired tiers are one encounter with a second body\n-- walking into it rather than two encounters at once.\ntype Encounter = {\n	archetype: BullyArchetype,\n	visitor: Visitor,\n	-- Both shares of the same bar, which is why neither carries a unit. Nerve starts where\n	-- this life's nerve puts it and climbs while held; patience starts full and falls on\n	-- its own, in the shape the archetype's drain names.\n	nerve: number,\n	patience: number,\n	-- How wide the band above patience is. Fixed at engage rather than recomputed per tick,\n	-- because it is what this life's nerve *buys* and a window that moved under the player\n	-- mid-hold would make the same release score differently twice.\n	windowWidth: number,\n	holding: boolean,\n	-- The bluffer lies exactly once. Recorded here rather than derived from the bar, since\n	-- the bar passes through the trigger point twice once the jump has happened.\n	bluffed: boolean,\n	-- Seconds until a second bully arrives and the window closes to its narrowest, or nil\n	-- at the tiers that do not send one.\n	backupIn: number?,\n	backup: Visitor?,\n	-- Set the moment an outcome is decided, so a tick that lands during the closing beat\n	-- cannot score the same encounter twice. Every write here is decided before it is\n	-- recorded, which is the atomicity rule stated about one small thing.\n	resolved: boolean,\n}\n\nlocal encounters: { [Player]: Encounter } = {}\n\n-- When each bully last stepped across each player, so the same person does not work the\n-- same corridor twice in a lesson. Keyed by player and then by archetype id.\nlocal cooldowns: { [Player]: { [string]: number } } = {}\n\n-- The closing line, and how long is left of it. Held apart from the encounter precisely\n-- because it outlives one: what they say on the way out has to stay up for a beat after\n-- everything else about the stare-down is gone.\nlocal notices: { [Player]: { text: string, until_: number } } = {}\n\n-- The last state pushed to each player, so an unchanged corridor is not re-sent ten times\n-- a second. Same reason SchoolService keeps one: the bars are redrawn on receipt.\nlocal pushed: { [Player]: string } = {}\n\n-- Seconds a player has been stood at the library desk with taken homework. Cleared the\n-- moment they walk off it, because a redo you can do in ten separate seconds spread over\n-- an afternoon is not a walk, it is a formality.\nlocal redoing: { [Player]: number } = {}\n\nlocal enabled = BULLY.Enabled\nlocal corridorBuilt = false\n\n-- Where this player is, or nil if they have no body this instant. Every yield in this\n-- file is a place a character can be torn down under it.\nlocal function characterPosition(player: Player): Vector3?\n	local character = player.Character\n	if character == nil then\n		return nil\n	end\n	local root = character:FindFirstChild(\"HumanoidRootPart\") :: BasePart?\n	if root == nil then\n		return nil\n	end\n	return root.Position\nend\n\nlocal function ageYearsOf(data: LifeData): number\n	return math.floor(data.ageMonths / Config.Time.MonthsPerYear)\nend\n\n-- Lays the corridor once the school building has streamed in. Retried rather than given\n-- up on, for the reason SchoolService retries its own room: the building may still be\n-- arriving, and a corridor that gave up on the first tick would never appear at all.\nlocal function ensureCorridor(): boolean\n	if corridorBuilt then\n		return Corridor.Room() ~= nil\n	end\n	local place = PlaceService.Find(PLACE_ID)\n	if place == nil then\n		return false\n	end\n	corridorBuilt = true\n	School.Build(place.part.Position)\n\n	-- With the building up the hallway already exists, so the corridor lays no props of its\n	-- own -- it only works out where people stand along it. Homework is redone in the actual\n	-- library rather than at a desk invented at the end of the run, which is the whole reason\n	-- that walk is worth making.\n	local line = School.RoomAt(\"corridor\")\n	if line ~= nil then\n		return Corridor.Build(line, false, School.RoomAt(\"library\")) ~= nil\n	end\n	return Corridor.Build(place.part.Position, true, nil) ~= nil\nend\n\n-- Which tier this life is at, by how many corridors it has won. Walks the list rather\n-- than indexing it so the tiers can be re-ordered in Config without this going wrong, and\n-- returns the last one whose threshold is met.\nlocal function tierFor(data: LifeData)\n	local current = BULLY.Tiers[1]\n	for _, tier in BULLY.Tiers do\n		if data.bullyStandUps >= tier.standUps then\n			current = tier\n		end\n	end\n	return current\nend\n\n-- How wide the band above their patience is, for this life. The whole of what nerve buys,\n-- and it is deliberately the *visible* thing rather than a hidden multiplier: the player\n-- watches the green band grow as they get harder to push around, which is requirement six\n-- of the activity law done the way Stardew does it rather than the way a wage does.\nlocal function windowFor(data: LifeData): number\n	local share = math.clamp(data.bullyNerve / NERVE_MAX, 0, 1)\n	return NERVE.WindowMinShare + (NERVE.WindowMaxShare - NERVE.WindowMinShare) * share\nend\n\n-- Where nerve starts. Never zero -- a child who has never stood up to anybody still has\n-- some, and a floor start would make the first corridor unwinnable rather than hard.\nlocal function startingNerve(data: LifeData): number\n	local share = math.clamp(data.bullyNerve / NERVE_MAX, 0, 1)\n	return NERVE.BaseShare + NERVE.StatShare * share\nend\n\nlocal function notice(player: Player, text: string)\n	notices[player] = { text = text, until_ = os.clock() + Config.UI.NoticeSeconds }\nend\n\n-- What the client is shown. Built fresh each tick and compared as a string before being\n-- sent, which is cheaper than diffing the table and is the same trick SchoolService uses.\nlocal function stateFor(player: Player): NerveState\n	local encounter = encounters[player]\n	if encounter == nil then\n		local held = notices[player]\n		local line = \"\"\n		if held ~= nil and os.clock() < held.until_ then\n			line = held.text\n		else\n			notices[player] = nil\n		end\n		return {\n			active = false,\n			bullyName = \"\",\n			line = line,\n			nerve = 0,\n			patience = 0,\n			windowLow = 0,\n			windowHigh = 0,\n			holding = false,\n			secondsToBackup = nil,\n		}\n	end\n\n	return {\n		active = true,\n		bullyName = encounter.archetype.body.name,\n		line = encounter.archetype.openingLine,\n		nerve = encounter.nerve,\n		patience = encounter.patience,\n		windowLow = encounter.patience,\n		windowHigh = encounter.patience + encounter.windowWidth,\n		holding = encounter.holding,\n		secondsToBackup = encounter.backupIn,\n	}\nend\n\nlocal function push(player: Player)\n	local state = stateFor(player)\n	-- Rounded before it is compared, or a bar drifting in the sixth decimal counts as a\n	-- change every tick and the throttle does nothing at all.\n	local signature = `{state.active}|{state.bullyName}|{state.line}|{math.floor(state.nerve * 100)}`\n		.. `|{math.floor(state.patience * 100)}|{math.floor(state.windowHigh * 100)}|{state.holding}`\n		.. `|{if state.secondsToBackup ~= nil then math.floor(state.secondsToBackup * 10) else -1}`\n	if pushed[player] == signature then\n		return\n	end\n	pushed[player] = signature\n	NerveUpdatedRemote:FireClient(player, state)\nend\n\n-- Takes the bully out of the world and forgets the encounter. Safe to call twice: every\n-- path out of a stare-down comes through here, including the ones that arrive from a\n-- player leaving mid-hold.\nlocal function clearEncounter(player: Player)\n	local encounter = encounters[player]\n	if encounter == nil then\n		return\n	end\n	encounters[player] = nil\n	if not encounter.visitor.gone() then\n		encounter.visitor.destroy()\n	end\n	local backup = encounter.backup\n	if backup ~= nil and not backup.gone() then\n		backup.destroy()\n	end\nend\n\n-- Records the outcome and pays for it. The one place any of this is written down, and it\n-- decides everything before it writes anything -- so a retry cannot half-apply a result.\nlocal function resolve(player: Player, data: LifeData, outcome: string)\n	local encounter = encounters[player]\n	if encounter == nil or encounter.resolved then\n		return\n	end\n	encounter.resolved = true\n\n	local archetype = encounter.archetype\n	cooldowns[player] = cooldowns[player] or {}\n	cooldowns[player][archetype.id] = os.clock() + BULLY.CooldownSeconds\n\n	if outcome == \"stood\" then\n		data.bullyStandUps += 1\n		data.bullyNerve = math.clamp(data.bullyNerve + TOLL.NerveOnStandUp, 0, NERVE_MAX)\n		StatService.AddStat(player, \"happiness\", TOLL.HappinessOnStandUp)\n		-- The same nerve discipline getting away from the police pays into, deliberately\n		-- rather than a school ladder of its own -- see Config.Skills.Awards.StoodUp. It is\n		-- also the only progression here the player can see in a panel: bullyNerve widens the\n		-- window and is felt rather than read, and this is the half that is read.\n		SkillService.Award(player, \"nerve\", Config.Skills.Awards.StoodUp, \"stood your ground\")\n		notice(player, archetype.standUpLine)\n	elseif outcome == \"backed\" then\n		data.bullyNerve = math.clamp(data.bullyNerve + TOLL.NerveOnBackDown, 0, NERVE_MAX)\n		StatService.AddStat(player, \"happiness\", TOLL.HappinessOnBackDown)\n		if archetype.demand == \"money\" then\n			-- Spend rather than Add with a negative, so a life with nothing on them simply\n			-- has nothing taken instead of being driven below zero. Somebody who cannot pay\n			-- the toll has already lost the thing this was about.\n			MoneyService.Spend(player, TOLL.Money, \"bully toll\")\n		elseif archetype.demand == \"homework\" then\n			data.homeworkTaken = true\n		end\n		notice(player, archetype.backDownLine)\n	else\n		-- Overheld. Worse than backing off, and the only outcome with a door out of the\n		-- corridor in it: against somebody already faced down at least once, a scene turns\n		-- into a contest. Everything else about it costs exactly what backing off costs.\n		StatService.AddStat(player, \"happiness\", TOLL.HappinessOnBackDown)\n		if archetype.demand == \"money\" then\n			MoneyService.Spend(player, TOLL.Money, \"bully toll\")\n		elseif archetype.demand == \"homework\" then\n			data.homeworkTaken = true\n		end\n\n		local tipped = false\n		if BULLY.TipsIntoFight and data.bullyStandUps > 0 then\n			-- Nil rather than a fighter id: a bully is not in content/Fighters.luau, and\n			-- FightService picking its own opponent is the honest reading of \"this turned\n			-- into a fight\" without inventing a fighter that has no other reason to exist.\n			local started = FightService.Challenge(player, nil)\n			tipped = started\n		end\n		if tipped then\n			notice(player, \"You went too far, and now it is a fight.\")\n		else\n			notice(player, \"You held it too long. Everybody saw.\")\n		end\n	end\n\n	clearEncounter(player)\n	push(player)\nend\n\n-- Steps a running stare-down forward. Everything that can end one is decided here rather\n-- than in the release handler, so an encounter cannot outlive the corridor it is in.\nlocal function tickEncounter(player: Player, data: LifeData, encounter: Encounter, dt: number)\n	if encounter.resolved then\n		return\n	end\n\n	local archetype = encounter.archetype\n	local fall = dt / archetype.patienceSeconds\n\n	if archetype.drain == \"steady\" then\n		encounter.patience -= fall\n	elseif archetype.drain == \"bluffer\" then\n		encounter.patience -= fall * DRAIN.BlufferRate\n		if not encounter.bluffed and encounter.patience <= DRAIN.BlufferJumpAt then\n			encounter.patience += DRAIN.BlufferJumpBy\n			encounter.bluffed = true\n		end\n	else\n		-- Mirror. Falls only against your own rise, so a player who does not hold is stood\n		-- in front of by somebody who will wait all afternoon -- and one who leans hard\n		-- brings the window forward faster than they are climbing toward it.\n		if encounter.holding then\n			encounter.patience -= NERVE.RisePerSecond * dt * DRAIN.MirrorFactor\n		end\n	end\n	encounter.patience = math.max(encounter.patience, 0)\n\n	if encounter.holding then\n		encounter.nerve += NERVE.RisePerSecond * dt\n	end\n\n	local backupIn = encounter.backupIn\n	if backupIn ~= nil then\n		backupIn -= dt\n		if backupIn <= 0 then\n			-- They have arrived. The window closes to its narrowest whatever this life's\n			-- nerve is, which is the second clock landing -- and the countdown is cleared so\n			-- the client stops drawing a number that has stopped meaning anything.\n			encounter.windowWidth = NERVE.WindowMinShare\n			encounter.backupIn = nil\n		else\n			encounter.backupIn = backupIn\n		end\n	end\n\n	-- Held all the way to the ceiling without ever letting go. Resolved as an overhold\n	-- rather than left running, because a bar with nowhere left to go and no decision in it\n	-- is exactly the dead time this system exists to remove.\n	if encounter.nerve >= NERVE.OverholdCeilingShare then\n		resolve(player, data, \"overheld\")\n	end\nend\n\n-- Whether this player could be stepped across right now. Every reason not to is checked\n-- here rather than spread across the tick, so adding one is a line in one place.\nlocal function eligible(player: Player, data: LifeData): boolean\n	if not enabled or not BULLY.Enabled then\n		return false\n	end\n	if not Lives.HasBegun(data) then\n		return false\n	end\n	local age = ageYearsOf(data)\n	if age < BULLY.MinAge or age > BULLY.MaxAge then\n		return false\n	end\n	return true\nend\n\n-- Picks somebody to step across this player, or nil if nobody is free. Walks the age band\n-- and skips anyone still on cooldown; returns nil rather than erroring when everyone is,\n-- because \"the corridor is quiet right now\" is a normal state and not a content fault.\nlocal function pickArchetype(player: Player, age: number): BullyArchetype?\n	local now = os.clock()\n	local held = cooldowns[player]\n	local available: { BullyArchetype } = {}\n	for _, archetype in Bullies.ForAge(age) do\n		local until_ = if held ~= nil then held[archetype.id] else nil\n		if until_ == nil or now >= until_ then\n			table.insert(available, archetype)\n		end\n	end\n	if #available == 0 then\n		return nil\n	end\n	return available[math.random(1, #available)]\nend\n\n-- Starts a stare-down. Returns whether one began, so the debug path can say why not.\n-- `standing` is the loiterer already at this station, when there is one. Passing it rather\n-- than spawning is what removes the pop-in: the person you walk up to is the same body that\n-- turns to face you, so the encounter starts by somebody *reacting* rather than by somebody\n-- appearing. Nil falls back to spawning, which is what /bully forces and what happens if the\n-- loiterer was lost to a stream-out between ticks.\nlocal function engage(player: Player, data: LifeData, archetype: BullyArchetype, station: Vector3, standing: Visitor?): boolean\n	if encounters[player] ~= nil then\n		return false\n	end\n	local age = ageYearsOf(data)\n	local visitor = standing\n	if visitor == nil or visitor.gone() then\n		visitor = NPCService.Spawn(player, archetype.body, CFrame.new(station), age + (archetype.body.ageOffset or 0))\n	end\n	if visitor == nil then\n		-- The rig could not be built, which every caller of Spawn has to treat as \"this did\n		-- not happen\". Silent on purpose: NPCService has already warned, and a second\n		-- warning per tick would bury it.\n		return false\n	end\n\n	local tier = tierFor(data)\n	local room = Corridor.Room()\n	local backup: Visitor? = nil\n	local backupIn: number? = nil\n	if tier.paired and room ~= nil then\n		-- The second body starts at the far end and walks. Spawned as a real person rather\n		-- than faked with a timer because the countdown has to be something the player can\n		-- look at down the corridor and read without the HUD -- the world is the menu.\n		local second = pickArchetype(player, age)\n		if second ~= nil and second.id ~= archetype.id then\n			backup = NPCService.Spawn(player, second.body, CFrame.new(room.finish), age + (second.body.ageOffset or 0))\n			if backup ~= nil then\n				backup.moveTo(station)\n				backupIn = BULLY.BackupSeconds\n			end\n		end\n	end\n\n	visitor.face(characterPosition(player))\n	visitor.talk()\n\n	encounters[player] = {\n		archetype = archetype,\n		visitor = visitor,\n		nerve = startingNerve(data),\n		patience = 1,\n		windowWidth = windowFor(data),\n		holding = false,\n		bluffed = false,\n		backupIn = backupIn,\n		backup = backup,\n		resolved = false,\n	}\n	push(player)\n	return true\nend\n\n-- The release, and the only commit in the system. Everything before it is free: a player\n-- who has not let go can still walk away, which is the undo window the activity law asks\n-- for -- mistakes are decisions here rather than gotchas.\nlocal function onHoldRequested(player: Player, holding: unknown)\n	if typeof(holding) ~= \"boolean\" then\n		return\n	end\n	local encounter = encounters[player]\n	if encounter == nil or encounter.resolved then\n		return\n	end\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return\n	end\n	local data = Lives.Active(profile.Data)\n\n	if holding then\n		encounter.holding = true\n		push(player)\n		return\n	end\n	if not encounter.holding then\n		-- A release with no hold behind it. Ignored rather than scored: a client that fires\n		-- the up edge on its own would otherwise be scoring an encounter the player never\n		-- took part in.\n		return\n	end\n\n	encounter.holding = false\n	if encounter.nerve < encounter.patience then\n		resolve(player, data, \"backed\")\n	elseif encounter.nerve <= encounter.patience + encounter.windowWidth then\n		resolve(player, data, \"stood\")\n	else\n		resolve(player, data, \"overheld\")\n	end\nend\n\n-- The library desk, which is the whole of what a taken homework costs. Standing still for\n-- a few seconds rather than a panel, because the walk down the corridor is the mechanic\n-- and a button at the end of it would be a walk with a formality attached.\nlocal function tickRedo(player: Player, data: LifeData, position: Vector3, dt: number)\n	if not data.homeworkTaken then\n		redoing[player] = nil\n		return\n	end\n	local room = Corridor.Room()\n	if room == nil then\n		return\n	end\n	if (position - room.library).Magnitude > BULLY.EngageRadiusStuds then\n		redoing[player] = nil\n		return\n	end\n\n	local held = (redoing[player] or 0) + dt\n	if held < HOMEWORK.RedoSeconds then\n		redoing[player] = held\n		return\n	end\n	redoing[player] = nil\n	data.homeworkTaken = false\n	notice(player, \"You redid it. Nobody has to know.\")\n	push(player)\nend\n\n-- ---------------------------------------------------------------------------------------\n-- Loiterers: the people standing in the corridor before anything has happened.\n-- ---------------------------------------------------------------------------------------\n\n-- One body per live station, standing there for as long as the player is in the building.\n--\n-- Keyed by player and then by station index, because a station is only live for the tier the\n-- player has reached -- two players at different tiers are looking at different corridors, and\n-- a shared pool would have to pick one of them to be wrong.\ntype Loiter = { visitor: Visitor, archetype: BullyArchetype }\nlocal loiterers: { [Player]: { [number]: Loiter } } = {}\nlocal loiterSpawning: { [Player]: { [number]: boolean } } = {}\n\nlocal function clearLoiterers(player: Player)\n	local mine = loiterers[player]\n	if mine ~= nil then\n		for _, entry in mine do\n			if not entry.visitor.gone() then\n				entry.visitor.destroy()\n			end\n		end\n	end\n	loiterers[player] = nil\n	loiterSpawning[player] = nil\nend\n\n-- Takes the loiterer off the pool without destroying it, because it is about to become the\n-- encounter. The encounter owns the body from here and clearEncounter is what ends it.\nlocal function takeLoiterer(player: Player, index: number): Loiter?\n	local mine = loiterers[player]\n	if mine == nil then\n		return nil\n	end\n	local entry = mine[index]\n	mine[index] = nil\n	return entry\nend\n\nlocal function tickLoiterers(player: Player, data: LifeData, position: Vector3)\n	-- Nobody loiters for a player who cannot be bullied -- too young, too old, already in an\n	-- encounter, or with the system off. The corridor being empty is then true rather than a\n	-- rendering decision.\n	if encounters[player] ~= nil or not eligible(player, data) then\n		clearLoiterers(player)\n		return\n	end\n\n	local room = Corridor.Room()\n	if room == nil then\n		clearLoiterers(player)\n		return\n	end\n\n	-- Out of range: torn down, for the reason the school crowd is. A cohort of rigs standing in\n	-- a corridor on the other side of the map is pure cost.\n	if (position - room.start).Magnitude > BULLY.LoiterNearStuds then\n		clearLoiterers(player)\n		return\n	end\n\n	local tier = tierFor(data)\n	local live = math.min(tier.stations, #room.stations)\n\n	local mine = loiterers[player]\n	if mine == nil then\n		mine = {}\n		loiterers[player] = mine\n	end\n	local spawning = loiterSpawning[player]\n	if spawning == nil then\n		spawning = {}\n		loiterSpawning[player] = spawning\n	end\n\n	-- Stations that have stopped being live -- the tier dropped on a new life -- give their\n	-- bodies back.\n	for index, entry in mine do\n		if index > live or entry.visitor.gone() then\n			if not entry.visitor.gone() then\n				entry.visitor.destroy()\n			end\n			mine[index] = nil\n		end\n	end\n\n	local age = ageYearsOf(data)\n	for index = 1, live do\n		if mine[index] == nil and not spawning[index] then\n			local archetype = pickArchetype(player, age)\n			if archetype ~= nil then\n				local station = room.stations[index]\n				spawning[index] = true\n				task.spawn(function()\n					local visitor = NPCService.Spawn(player, archetype.body, CFrame.new(station), age + (archetype.body.ageOffset or 0))\n					spawning[index] = false\n					if visitor == nil then\n						return\n					end\n					-- The pool may have been torn down while the web call was in flight -- the\n					-- player walked out, died, or an encounter started with somebody else.\n					local current = loiterers[player]\n					if current == nil or current[index] ~= nil or encounters[player] ~= nil then\n						visitor.destroy()\n						return\n					end\n					current[index] = { visitor = visitor, archetype = archetype }\n				end)\n			end\n		end\n	end\nend\n\nlocal function tickPlayer(player: Player, dt: number)\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return\n	end\n	local data = Lives.Active(profile.Data)\n	local position = characterPosition(player)\n	if position == nil then\n		return\n	end\n\n	tickRedo(player, data, position, dt)\n	tickLoiterers(player, data, position)\n\n	local encounter = encounters[player]\n	if encounter ~= nil then\n		-- Walking away. The undo window, and it costs nothing at all: nobody took anything\n		-- and nobody learned anything, which is the honest outcome of a stare-down that did\n		-- not happen. Deliberately a wider radius than the one that started it, so leaving\n		-- is not a coin balanced on the edge of the distance you arrived through.\n		if (position - encounter.visitor.at()).Magnitude > BULLY.ReleaseRadiusStuds then\n			clearEncounter(player)\n			push(player)\n			return\n		end\n		encounter.visitor.face(position)\n		tickEncounter(player, data, encounter, dt)\n		push(player)\n		return\n	end\n\n	if not eligible(player, data) then\n		push(player)\n		return\n	end\n\n	local room = Corridor.Room()\n	if room == nil then\n		push(player)\n		return\n	end\n\n	-- Which stations are occupied is the whole of the escalation: at the bottom tier only\n	-- the first is live and it is in the open where it can be seen from the door; higher up\n	-- the later ones are too, and those are further in. The space changes, not the numbers.\n	local tier = tierFor(data)\n	local live = math.min(tier.stations, #room.stations)\n	for index = 1, live do\n		local station = room.stations[index]\n		if (position - station).Magnitude <= BULLY.EngageRadiusStuds then\n			-- The person already standing here, if there is one. Their archetype comes with them:\n			-- the player has been looking at this body from down the corridor, and re-rolling who\n			-- it is at the moment they arrive would make that look a lie.\n			local standing = takeLoiterer(player, index)\n			local archetype = if standing ~= nil then standing.archetype else pickArchetype(player, ageYearsOf(data))\n			if archetype ~= nil then\n				local body = if standing ~= nil then standing.visitor else nil\n				if not engage(player, data, archetype, station, body) and body ~= nil then\n					-- Refused -- already in an encounter. The body would otherwise be orphaned,\n					-- since it is off the pool and was never handed to one.\n					body.destroy()\n				end\n				break\n			end\n		end\n	end\n	push(player)\nend\n\nlocal function forget(player: Player)\n	clearLoiterers(player)\n	clearEncounter(player)\n	cooldowns[player] = nil\n	notices[player] = nil\n	pushed[player] = nil\n	redoing[player] = nil\nend\n\n-- Wipes the corridor for a life that has just ended. The bodies go with it: a bully is a\n-- person this life met, and the next one has not met them.\nfunction BullyService.ResetForNewLife(player: Player)\n	forget(player)\n	push(player)\nend\n\n-- Debug: put somebody in front of this player now, ignoring cooldowns and distance.\nfunction BullyService.ForceEngage(player: Player, bullyId: string?): (boolean, string?)\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return false, \"no profile loaded\"\n	end\n	local data = Lives.Active(profile.Data)\n	if encounters[player] ~= nil then\n		return false, \"already in a stare-down -- /nerve end first\"\n	end\n	if not ensureCorridor() then\n		return false, `no place point tagged \"{PLACE_ID}\" yet, so there is no corridor to stand in`\n	end\n	local room = Corridor.Room()\n	if room == nil then\n		return false, \"the corridor could not be laid\"\n	end\n\n	local archetype: BullyArchetype? = nil\n	if bullyId ~= nil then\n		archetype = Bullies.Get(bullyId)\n		if archetype == nil then\n			return false, `no bully \"{bullyId}\" -- see /nerve list`\n		end\n	else\n		archetype = pickArchetype(player, ageYearsOf(data))\n		if archetype == nil then\n			return false, \"everybody is on cooldown\"\n		end\n	end\n\n	local position = characterPosition(player)\n	if position == nil then\n		return false, \"no character to stand in front of\"\n	end\n	-- In front of the player rather than at a station, because the point of forcing one is\n	-- to see it without walking to the corridor first.\n	local at = position + (room.axis * BULLY.EngageRadiusStuds * 0.4)\n	if not engage(player, data, archetype :: BullyArchetype, at) then\n		return false, \"the rig could not be built\"\n	end\n	return true\nend\n\n-- Debug: end a running stare-down with a named outcome, so every branch can be seen\n-- without having to land the release by hand.\nfunction BullyService.ForceResolve(player: Player, outcome: string): (boolean, string?)\n	if outcome ~= \"stood\" and outcome ~= \"backed\" and outcome ~= \"overheld\" then\n		return false, `outcome must be stood, backed or overheld -- got \"{outcome}\"`\n	end\n	if encounters[player] == nil then\n		return false, \"not in a stare-down\"\n	end\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return false, \"no profile loaded\"\n	end\n	resolve(player, Lives.Active(profile.Data), outcome)\n	return true\nend\n\n-- Debug: end a stare-down with no outcome at all, the way walking away does.\nfunction BullyService.ForceEnd(player: Player): boolean\n	if encounters[player] == nil then\n		return false\n	end\n	clearEncounter(player)\n	push(player)\n	return true\nend\n\n-- Debug: set this life's nerve outright, which is the only way to see the window widen\n-- without playing thirty corridors first.\nfunction BullyService.SetNerve(player: Player, value: number): (boolean, string?)\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return false, \"no profile loaded\"\n	end\n	local data = Lives.Active(profile.Data)\n	data.bullyNerve = math.clamp(math.floor(value), 0, NERVE_MAX)\n	return true\nend\n\n-- Debug: hand the player their homework back, or take it.\nfunction BullyService.SetHomeworkTaken(player: Player, taken: boolean): boolean\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return false\n	end\n	Lives.Active(profile.Data).homeworkTaken = taken\n	push(player)\n	return true\nend\n\nfunction BullyService.SetEnabled(value: boolean)\n	enabled = value\n	if not value then\n		for player in encounters do\n			clearEncounter(player)\n			push(player)\n		end\n		-- And the people standing about waiting to start one. Without this, turning the system\n		-- off left the corridor full of bullies who could no longer do anything -- which reads\n		-- as broken rather than as disabled.\n		for player in loiterers do\n			clearLoiterers(player)\n		end\n	end\nend\n\nfunction BullyService.IsEnabled(): boolean\n	return enabled and BULLY.Enabled\nend\n\n-- What the corridor looks like right now, for the debug path. Reads state and never\n-- builds any, so describing the corridor cannot be the thing that creates it.\nfunction BullyService.Describe(player: Player): string\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return \"no profile loaded\"\n	end\n	local data = Lives.Active(profile.Data)\n	local tier = tierFor(data)\n	local room = Corridor.Room()\n	local lines = {\n		`enabled: {BullyService.IsEnabled()}`,\n		`age: {ageYearsOf(data)} (corridor runs {BULLY.MinAge}-{BULLY.MaxAge})`,\n		`nerve: {data.bullyNerve}/{NERVE_MAX}  window: {string.format(\"%.3f\", windowFor(data))}`,\n		`stood up: {data.bullyStandUps}  tier: {tier.label} ({tier.stations} station(s), paired={tier.paired})`,\n		`homework taken: {data.homeworkTaken}`,\n		`corridor: {if room ~= nil then `laid, {#room.stations} station(s)` else \"not laid yet\"}`,\n	}\n	local encounter = encounters[player]\n	if encounter == nil then\n		table.insert(lines, \"no stare-down running\")\n	else\n		table.insert(\n			lines,\n			`vs {encounter.archetype.body.name} ({encounter.archetype.drain}/{encounter.archetype.demand})`\n				.. `  nerve {string.format(\"%.2f\", encounter.nerve)}`\n				.. `  patience {string.format(\"%.2f\", encounter.patience)}`\n				.. `  window {string.format(\"%.2f\", encounter.patience)}..{string.format(\"%.2f\", encounter.patience + encounter.windowWidth)}`\n				.. `  holding={encounter.holding}`\n		)\n	end\n	return table.concat(lines, \"\\n\")\nend\n\nfunction BullyService:Start()\n	Players.PlayerRemoving:Connect(forget)\n\n	RequestNerveHoldRemote.OnServerEvent:Connect(function(player: Player, holding: unknown)\n		local ok, err = pcall(onHoldRequested, player, holding)\n		if not ok then\n			warn(`[AGES] nerve hold failed for {player.Name}: {err}`)\n		end\n	end)\n\n	task.spawn(function()\n		while true do\n			local elapsed = task.wait(BULLY.TickSeconds)\n			-- The corridor first, then the people in it. A station that has not been laid yet\n			-- is a station nobody can be stood at, and checking it per player would ask the\n			-- same question once for everybody in the server.\n			ensureCorridor()\n			for _, player in Players:GetPlayers() do\n				local ok, err = pcall(tickPlayer, player, elapsed)\n				if not ok then\n					warn(`[AGES] corridor tick failed for {player.Name}: {err}`)\n				end\n			end\n		end\n	end)\nend\n\nreturn BullyService\n"
table.insert(AGES_MANIFEST, "src/server/services/BullyService.luau")
AGES_SOURCES["src/server/services/CarDealerService.luau"] = "--!strict\n-- The car dealership queue. Customers line up at the showroom counter and the player\n-- serves them whether they are working a shift there or just walking past.\n--\n-- This runs alongside WorkService's shift queue at auto_dealer. When a car_salesperson\n-- shift is active, that queue takes priority and the walk-in queue pauses. When no\n-- shift is running, the walk-in queue keeps the place feeling alive.\n--\n-- The queue uses Customers.Queue and WorkSpots.Line from the existing work system —\n-- same arrival stagger, same spacing math, same thanks-on-depart. What changes is\n-- the dialogue (car-buying lines instead of shop lines) and the trigger (distance to\n-- the counter rather than a task mark).\n\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Config = require(ReplicatedStorage:WaitForChild(\"Config\"))\nlocal Lives = require(ReplicatedStorage:WaitForChild(\"Lives\"))\nlocal Remotes = require(ReplicatedStorage:WaitForChild(\"Remotes\"))\nlocal Types = require(ReplicatedStorage:WaitForChild(\"Types\"))\n\n-- There are two `world` folders and they are not interchangeable. `ReplicatedStorage.world`\n-- is `src/shared/world` -- five modules the client also needs. Customers and Ground are in\n-- `src/server/world`, which is server-only and reached the way WorkService reaches them,\n-- through script.Parent.\n--\n-- Asking ReplicatedStorage for them did not error, which is what made this so expensive:\n-- `WaitForChild` with no timeout yields *forever* for a child that is never coming. This\n-- runs at module scope, so the bootstrap thread parked here permanently and every service\n-- after CarDealerService in init.server.luau never started. No error, no stack, nothing in\n-- the output but one \"Infinite yield possible\" warning -- the game simply loaded and sat\n-- there. A missing require that throws is a much cheaper bug than one that waits.\nlocal Customers = require(script.Parent.Parent.world.Customers)\nlocal Ground = require(script.Parent.Parent.world.Ground)\n-- Hoisted from inside isWorkingAtDealer, which is called on every tick. It read\n-- `ReplicatedStorage:WaitForChild(\"DataService\")` -- DataService is a sibling service, not a\n-- shared module, so that call would have yielded forever the first time a customer was\n-- served. Every other service in this folder requires it here, at the top, by sibling path.\nlocal DataService = require(script.Parent.DataService)\nlocal MoneyService = require(script.Parent.MoneyService)\nlocal PlaceService = require(script.Parent.PlaceService)\nlocal WorkService = require(script.Parent.WorkService)\n-- For the counter's own job: what it pays an hour, and how old it hires. Both are\n-- authored in content and read back out here rather than restated, which is the same\n-- contract Config.Work describes for every other rate in the game.\nlocal Jobs = require(script.Parent.Parent.content.Jobs)\n\ntype LifeData = Types.LifeData\ntype Customer = Customers.Customer\ntype Visitor = Types.Visitor\n\nlocal CarDealer = {}\n\nlocal CAR_DEALER = Config.CarDealer\nlocal carDealerUpdated = Remotes.Get(\"CarDealerUpdated\")\nlocal requestCarDealerServe = Remotes.Get(\"RequestCarDealerServe\")\n\n-- The place point this whole service is about. Was written out at each of the three\n-- PlaceService.Find calls; named once so the job lookup below cannot drift from them.\nlocal DEALER_PLACE_ID = \"auto_dealer\"\n\n-- The counter's own job, found by where it is rather than by its id, so renaming\n-- car_salesperson in content does not silently unhook the walk-in queue from the wage\n-- and age it is supposed to follow.\nlocal function jobAtCounter(): Types.Job\n	local found: Types.Job? = nil\n	for _, job in Jobs.All do\n		if job.placeId == DEALER_PLACE_ID then\n			-- Lowest age wins if the counter ever has a ladder on it: the question this\n			-- answers is \"could anybody be employed here at this age\", not \"could they\n			-- be employed at the top of it\".\n			if found == nil or job.minAge < found.minAge then\n				found = job\n			end\n		end\n	end\n	if found == nil then\n		-- Not a warning. Every number below is divided out of this job, so without it\n		-- the service would have to invent an age and a price -- which is the thing it\n		-- exists to stop doing.\n		error(`[AGES content] no job at \"{DEALER_PLACE_ID}\", so the walk-in counter has no wage or age to follow`)\n	end\n	return found\nend\n\nlocal COUNTER_JOB = jobAtCounter()\n\n-- How old you must be to serve at the counter: exactly old enough to be employed at\n-- it. A walk-in is the no-commitment version of the job, not a way around its terms.\nlocal MIN_AGE = COUNTER_JOB.minAge\n\n-- What one walk-in customer tips, divided out of the counter's authored salary. A game\n-- hour is RealSecondsPerGameHour long and a customer arrives every CustomerGapSeconds,\n-- so this many of them fit in the hour the job is paid by -- and the tip is that hour's\n-- wage split between them, then taken down to a tip's share of it.\nlocal CUSTOMERS_PER_GAME_HOUR = Config.Time.RealSecondsPerGameHour / CAR_DEALER.CustomerGapSeconds\nlocal SERVE_TIP = math.floor((Jobs.HourlyRate(COUNTER_JOB) / CUSTOMERS_PER_GAME_HOUR) * CAR_DEALER.WalkInTipShare)\n\n-- Which customer is at the front of the line right now. Kept so the service can\n-- answer questions about the queue without rebuilding it from scratch.\ntype QueueMember = {\n	customer: Customer,\n	slots: { Vector3 },\n	from: Vector3?,\n	counter: Vector3,\n	line: string,\n}\n\n-- Per-player queue state. A player can only interact with one dealership at a time\n-- (there is only one anyway), so this is keyed by player.\ntype DealerState = {\n	queue: QueueMember?,\n	lastArrival: number,\n}\n\nlocal states: { [Player]: DealerState } = {}\n\n-- What a waiting customer says when they step up to the counter. Drawn from a pool\n-- so the same face does not repeat the same line twice in a row.\nlocal GREETINGS = {\n	\"I've been waiting. Got the new models yet?\",\n	\"My wife said I should look at something reliable.\",\n	\"I'm ready to buy if the price is right.\",\n	\"Do you have anything in blue? My daughter loves blue.\",\n	\"I test-drove one last week. Want to see if it still runs.\",\n	\"My friend said this place is the best in town. Let's see.\",\n	\"I need something for the commute. Nothing fancy.\",\n	\"Is this the place where you help people pick cars?\",\n}\n\nlocal THANKS = {\n	\"Looks great, thanks for the help!\",\n	\"I'll be back with my wife to pick it up!\",\n	\"Thanks — she's gonna love this one.\",\n	\"Appreciate it. Drive safe, everybody.\",\n	\"Nice work. See you next time.\",\n}\n\nlocal function randomFrom(t: { string }): string\n	return t[math.random(#t)]\nend\n\nlocal function stateFor(player: Player): DealerState\n	local mine = states[player]\n	if mine == nil then\n		mine = { queue = nil, lastArrival = 0 }\n		states[player] = mine\n	end\n	return mine\nend\n\n-- Whether the player is currently working a shift at the auto_dealer. If so, the\n-- shift queue owns the counter and the walk-in queue should not interfere.\nlocal function isWorkingAtDealer(player: Player): boolean\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return false\n	end\n	local data = Lives.Active(profile.Data)\n	if not data.alive then\n		return false\n	end\n	return WorkService.IsWorkingAt(player, DEALER_PLACE_ID)\nend\n\n-- Whether this player may work the walk-in counter at all: alive, and old enough to\n-- be employed here.\n--\n-- This did not exist, and its absence is why a one-year-old had a job at the\n-- dealership. The queue was built for every player from PlayerAdded and refreshed on\n-- a two-second tick with nothing asked about the life inside them, so a toddler stood\n-- at the counter, customers lined up for them, and each one paid out.\nlocal function mayServe(player: Player): boolean\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return false\n	end\n	local data = Lives.Active(profile.Data)\n	if not data.alive then\n		return false\n	end\n	return data.ageMonths // Config.Time.MonthsPerYear >= MIN_AGE\nend\n\n-- Where the player actually is, per the server. The client asks to serve and the\n-- server has to answer from something it owns; this is that something.\nlocal function characterPosition(player: Player): Vector3?\n	local character = player.Character\n	if character == nil then\n		return nil\n	end\n	local root = character:FindFirstChild(\"HumanoidRootPart\")\n	if root == nil then\n		return nil\n	end\n	return (root :: BasePart).Position\nend\n\n-- Tear down whatever queue this player has, if any. Four call sites did this inline\n-- and a fifth was about to; the tick runs it for every player twice a second, so the\n-- one that forgets a line is the one that leaks a customer.\nlocal function clearQueue(player: Player, mine: DealerState, tellClient: boolean)\n	if mine.queue == nil then\n		return\n	end\n	mine.queue.customer.destroy()\n	mine.queue = nil\n	if tellClient then\n		carDealerUpdated:FireClient(player, { waiting = 0, counter = nil, greeting = nil, served = false })\n	end\nend\n\n-- Whether the player is close enough to the showroom for its queue to be their\n-- business at all. Missing this was the whole bug: every player old enough to work\n-- the counter got a queue built for them from PlayerAdded onward and refreshed on\n-- every tick with no question asked about where they actually were, so a player who\n-- had never been near the dealership still had customers lining up and the HUD row\n-- reading \"AutoPia: serving customer\" -- indistinguishable from being on shift there\n-- without ever having taken the job. Same radius the shift itself uses to decide the\n-- shop floor is under your feet, so a walk-in and an employee agree on what \"at the\n-- dealership\" means.\nlocal function nearCounter(player: Player, station: Vector3): boolean\n	local position = characterPosition(player)\n	if position == nil then\n		return false\n	end\n	return Ground.FlatDistance(position, station) <= Config.Work.StationRadiusStuds\nend\n\n-- Find or refresh the queue for this player. Called on every tick and when the\n-- player enters the area. Rebuilds the spots from the place point each time so\n-- a rebuilt city does not leave stale queue positions.\nlocal function ensureQueue(player: Player)\n	local mine = stateFor(player)\n	-- Too young to work this counter, or not alive to work it. No queue, and the panel\n	-- is told so rather than left holding the last one -- a child who walks past the\n	-- showroom should see a showroom, not a shift.\n	if not mayServe(player) then\n		clearQueue(player, mine, true)\n		return\n	end\n	-- Shift queue owns the counter; clear any walk-in queue while working.\n	if isWorkingAtDealer(player) then\n		clearQueue(player, mine, true)\n		return\n	end\n	local place = PlaceService.Find(DEALER_PLACE_ID)\n	if place == nil then\n		clearQueue(player, mine, false)\n		return\n	end\n\n	local station = place.part.Position\n	if not nearCounter(player, station) then\n		clearQueue(player, mine, true)\n		return\n	end\n	-- The counter is the first spot across the mark from the station. We find it\n	-- by fanning out from the station and taking the first reachable spot, then\n	-- placing the queue behind it.\n	local ignore = Ground.IgnoreList()\n	local radius = Config.NPC.BodyRadius\n	local height = Config.NPC.BodyHeight\n\n	-- Find a counter position: a few studs beyond the station, on the side the\n	-- player would approach from (south, since the dealership faces the street).\n	local counter: Vector3? = nil\n	for _, bearing in Ground.Bearings(180, 8) do\n		local direction = CFrame.Angles(0, math.rad(bearing), 0) * Vector3.new(0, 0, -1)\n		local candidate = station + direction * 5\n		local floor = Ground.SpotAt(candidate, radius, height, ignore, station)\n		if floor ~= nil then\n			counter = floor\n			break\n		end\n	end\n\n	if counter == nil then\n		clearQueue(player, mine, false)\n		return\n	end\n\n	-- Build the queue slots behind the counter.\n	local count = math.min(CAR_DEALER.MaxQueue, 3)\n	local slots: { Vector3 } = {}\n	local away = Vector3.new(counter.X - station.X, 0, counter.Z - station.Z)\n	local outward = away.Magnitude > 0.1 and away.Unit or Vector3.new(0, 0, -1)\n\n	-- Front slot: across the counter from the station.\n	local frontFloor = Ground.SpotAt(counter + outward * Config.Work.Customers.StandOffStuds, radius, height, ignore, counter)\n	if frontFloor == nil then\n		clearQueue(player, mine, false)\n		return\n	end\n	table.insert(slots, frontFloor)\n\n	-- Behind slots.\n	for index = 2, count do\n		local behind = frontFloor + outward * (Config.Work.Customers.QueueSpacingStuds * (index - 1))\n		local floor = Ground.SpotAt(behind, radius, height, ignore, slots[index - 1])\n		if floor == nil then\n			break\n		end\n		table.insert(slots, floor)\n	end\n\n	if #slots == 0 then\n		clearQueue(player, mine, false)\n		return\n	end\n\n	-- Find where they walk in from.\n	local last = slots[#slots]\n	local fromFloor = Ground.SpotAt(last + outward * Config.Work.Customers.ArriveFromStuds, radius, height, ignore, last)\n\n	-- Preserve the existing queue if it is still valid; otherwise replace it.\n	local line = randomFrom(GREETINGS)\n	if mine.queue ~= nil then\n		local existing = mine.queue\n		-- If the counter moved significantly, tear down and rebuild.\n		if Ground.FlatDistance(existing.counter, counter) > 5 then\n			existing.customer.destroy()\n			mine.queue = nil\n		end\n	end\n\n	if mine.queue == nil then\n		local customer = Customers.Queue(player, slots, fromFloor, counter, line)\n		mine.queue = {\n			customer = customer,\n			slots = slots,\n			from = fromFloor,\n			counter = counter,\n			line = line,\n		}\n		mine.lastArrival = os.clock()\n	else\n		-- Update positions if the counter shifted.\n		local existing = mine.queue\n		if Ground.FlatDistance(existing.counter, counter) > 2 then\n			existing.customer.destroy()\n			local customer = Customers.Queue(player, slots, fromFloor, counter, line)\n			existing.customer = customer\n			existing.slots = slots\n			existing.from = fromFloor\n			existing.counter = counter\n			existing.line = line\n			mine.lastArrival = os.clock()\n		end\n	end\n\n	-- Push the current state to the client.\n	carDealerUpdated:FireClient(player, {\n		waiting = mine.queue.customer.waiting(),\n		counter = mine.queue.counter,\n		greeting = mine.queue.line,\n		served = false,\n	})\nend\n\n-- Serve the front customer. Called when the player reaches the counter.\nlocal function serveFront(player: Player)\n	local mine = stateFor(player)\n	if mine.queue == nil then\n		return\n	end\n\n	-- Everything below this line is money, so everything above it has to be the\n	-- server's own answer. This handler used to be reached straight off the remote\n	-- with no check of any kind: not age, not distance, not whether the life was\n	-- alive. The client asked and it paid.\n	if not mayServe(player) then\n		return\n	end\n\n	-- Standing at the counter is the whole of the work, so it is the one thing worth\n	-- verifying. Measured server-side against the counter the server placed, at the\n	-- radius clocking on uses -- serving a customer is working the counter, so it\n	-- answers to the same distance as working the counter.\n	local position = characterPosition(player)\n	if position == nil then\n		return\n	end\n	if Ground.FlatDistance(position, mine.queue.counter) > Config.Work.ClockInRadiusStuds then\n		return\n	end\n\n	local customer = mine.queue.customer\n	local waiting = customer.waiting()\n	if waiting == 0 then\n		return\n	end\n\n	customer.serve()\n\n	-- Pay a tip for the walk-in service. SERVE_TIP is divided out of this counter's own\n	-- salary rather than named here -- see Config.CarDealer.WalkInTipShare.\n	MoneyService.Add(player, SERVE_TIP, \"car dealership tip\")\n\n	-- Say thanks.\n	local thanks = randomFrom(THANKS)\n	mine.queue.line = thanks\n\n	-- Push update.\n	carDealerUpdated:FireClient(player, {\n		waiting = customer.waiting(),\n		counter = mine.queue.counter,\n		greeting = mine.queue.line,\n		served = true,\n	})\nend\n\n-- Schedule the next customer arrival if the queue has room.\nlocal function maybeArrive(player: Player)\n	local mine = stateFor(player)\n	-- Asked here as well as in ensureQueue, and not as belt-and-braces: this runs on\n	-- the same tick and builds a queue of its own, so a gate on only the other one\n	-- would have let the customers arrive anyway a beat later.\n	if not mayServe(player) then\n		return\n	end\n	local now = os.clock()\n	if now - mine.lastArrival < CAR_DEALER.CustomerGapSeconds then\n		return\n	end\n\n	local place = PlaceService.Find(DEALER_PLACE_ID)\n	if place == nil then\n		return\n	end\n\n	local station = place.part.Position\n	-- Same gate as ensureQueue, and needed independently rather than assumed: this\n	-- function builds its own queue from scratch and runs on the same tick, so a\n	-- player ensureQueue had already turned away would otherwise get a fresh customer\n	-- here a moment later.\n	if not nearCounter(player, station) then\n		return\n	end\n	local ignore = Ground.IgnoreList()\n	local radius = Config.NPC.BodyRadius\n	local height = Config.NPC.BodyHeight\n\n	local away = Vector3.new(station.X, 0, station.Z)\n	local outward = Vector3.new(0, 0, -1) -- face south, toward the street\n\n	-- Find counter.\n	local counter: Vector3? = nil\n	for _, bearing in Ground.Bearings(180, 8) do\n		local direction = CFrame.Angles(0, math.rad(bearing), 0) * Vector3.new(0, 0, -1)\n		local candidate = station + direction * 5\n		local floor = Ground.SpotAt(candidate, radius, height, ignore, station)\n		if floor ~= nil then\n			counter = floor\n			break\n		end\n	end\n\n	if counter == nil then\n		return\n	end\n\n	local slots: { Vector3 } = {}\n	local frontFloor = Ground.SpotAt(counter + outward * Config.Work.Customers.StandOffStuds, radius, height, ignore, counter)\n	if frontFloor ~= nil then\n		table.insert(slots, frontFloor)\n		for index = 2, CAR_DEALER.MaxQueue do\n			local behind = frontFloor + outward * (Config.Work.Customers.QueueSpacingStuds * (index - 1))\n			local floor = Ground.SpotAt(behind, radius, height, ignore, slots[index - 1])\n			if floor == nil then\n				break\n			end\n			table.insert(slots, floor)\n		end\n	end\n\n	if #slots == 0 then\n		return\n	end\n\n	local last = slots[#slots]\n	local fromFloor = Ground.SpotAt(last + outward * Config.Work.Customers.ArriveFromStuds, radius, height, ignore, last)\n\n	local line = randomFrom(GREETINGS)\n	local customer = Customers.Queue(player, slots, fromFloor, counter, line)\n\n	mine.queue = {\n		customer = customer,\n		slots = slots,\n		from = fromFloor,\n		counter = counter,\n		line = line,\n	}\n	mine.lastArrival = now\n\n	carDealerUpdated:FireClient(player, {\n		waiting = customer.waiting(),\n		counter = counter,\n		greeting = line,\n		served = false,\n	})\nend\n\nfunction CarDealer:Init()\n	requestCarDealerServe.OnServerEvent:Connect(function(player: Player)\n		local ok, err = pcall(serveFront, player)\n		if not ok then\n			warn(`[AGES] car dealer serve failed for {player.Name}: {err}`)\n		end\n	end)\n\n	Players.PlayerAdded:Connect(function(player: Player)\n		task.spawn(function()\n			ensureQueue(player)\n		end)\n	end)\n\n	Players.PlayerRemoving:Connect(function(player: Player)\n		local mine = states[player]\n		if mine ~= nil and mine.queue ~= nil then\n			mine.queue.customer.destroy()\n		end\n		states[player] = nil\n	end)\nend\n\nfunction CarDealer:Start()\n	for _, player in Players:GetPlayers() do\n		task.spawn(function()\n			ensureQueue(player)\n		end)\n	end\n\n	task.spawn(function()\n		while true do\n			task.wait(CAR_DEALER.TickSeconds)\n			for _, player in Players:GetPlayers() do\n				local ok, err = pcall(function()\n					-- Refresh queue spots in case the city was rebuilt.\n					ensureQueue(player)\n					-- Check for new arrivals.\n					maybeArrive(player)\n				end)\n				if not ok then\n					warn(`[AGES] car dealer tick failed for {player.Name}: {err}`)\n				end\n			end\n		end\n	end)\nend\n\nreturn CarDealer\n"
table.insert(AGES_MANIFEST, "src/server/services/CarDealerService.luau")
AGES_SOURCES["src/server/services/ChildhoodService.luau"] = "--!strict\n-- The first five years, as something you do rather than something you are told.\n--\n-- Every other age in AGES has a verb. You walk to the shop and clock on, you sit in a\n-- lesson and answer, you cross a room to your mother and she says something back. Nought\n-- to five had none: the events were authored `Memory`, which means they were handed over\n-- the instant the birthday landed, answered on a panel from a standstill, and then\n-- nothing happened for fifteen seconds until the next one was handed over too. A small body in an empty room, reading. That is a montage with\n-- a walk speed, and it was the first thing a new player ever saw.\n--\n-- What this does instead, and it is one sentence: the event is put across the room and\n-- you have to get there.\n--\n--   Something appears on the floor some way off, with a few words over it and a line\n--   pointing at it. You crawl to it. When you arrive it opens -- the dog walks in with\n--   three dots over its head -- and answering it makes you a year older. Then the next\n--   thing appears, and it is already there by the time the last one has finished.\n--\n-- Almost none of that is new machinery, which is the reason to do it this way. The scene,\n-- the pads, the line, the year advancing on an answer -- all of it already worked and was\n-- simply never reached, because the event never had anywhere to be. This gives it\n-- somewhere to be.\n--\n-- Three things it is careful about:\n--\n--   The floor is found, not authored. A `Wander` event needs no tagged prop, which is what\n--   separates it from `Interact` and is the entire reason it exists: a childhood that\n--   required twenty-two hand-placed objects would be a childhood that does not work until\n--   somebody dresses the house, and the opening five minutes of the game cannot be the\n--   part that is waiting on art.\n--\n--   The distance does the growing up. The same twelve-to-twenty-eight studs is a long haul\n--   at the Crawl band's speed of 4 and a short one at Run's 13, so the world gets smaller\n--   as the body gets better without a single number being shown to anyone.\n--\n--   There is never nothing. The next thing is staged off the last one clearing rather than\n--   off a timer, so the only quiet in childhood is the four seconds an outcome takes to\n--   read. Idle time inside an activity is the bug this file was written to fix, and\n--   re-introducing it as a \"pacing beat\" would be the same bug with a better name.\n--\n-- The guide line is shared with WorkService, which points a jobless sixteen-year-old at\n-- the shop. They cannot both be talking: this only runs to Config.Childhood.EndAge and\n-- that only starts at the minimum working age. If a third claimant ever appears the line\n-- needs an owner rather than a third writer.\n\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Config = require(ReplicatedStorage:WaitForChild(\"Config\"))\nlocal Remotes = require(ReplicatedStorage:WaitForChild(\"Remotes\"))\nlocal Types = require(ReplicatedStorage:WaitForChild(\"Types\"))\nlocal ChoiceMarkers = require(ReplicatedStorage:WaitForChild(\"world\"):WaitForChild(\"ChoiceMarkers\"))\nlocal Lives = require(ReplicatedStorage:WaitForChild(\"Lives\"))\n\nlocal DataService = require(script.Parent.DataService)\nlocal EventService = require(script.Parent.EventService)\nlocal Ground = require(script.Parent.Parent.world.Ground)\n\ntype LifeData = Types.LifeData\ntype LifeEvent = Types.LifeEvent\ntype ChoiceMarker = ChoiceMarkers.ChoiceMarker\n\nlocal ChildhoodService = {}\n\nlocal GuideUpdatedRemote = Remotes.Get(\"GuideUpdated\")\n\nlocal WANDER = Config.Childhood.Wander\n\n-- What is standing in the room for one player, waiting to be reached.\ntype Lure = {\n	eventId: string,\n	label: string,\n	at: Vector3,\n	marker: ChoiceMarker,\n}\n\nlocal lures: { [Player]: Lure } = {}\n\n-- When the next one may be staged. Set the moment a prompt closes rather than the moment\n-- one opens, so a player who takes a minute over an answer does not also serve the beat.\nlocal readyAt: { [Player]: number } = {}\n\n-- Whether a prompt was open last tick, which is the only way to notice one closing without\n-- EventService having to announce it. Polled rather than pushed on purpose: the profile\n-- field is the truth either way, and a callback would be a second thing to keep in step.\nlocal wasPending: { [Player]: boolean } = {}\n\n-- What the guide is currently pointing at, so an unchanged line is not re-sent four times\n-- a second. Same reason WorkService keeps one.\nlocal guided: { [Player]: string? } = {}\n\n-- Studio harness switch. Off leaves the toddler in an empty house, which is how a body or\n-- a places bug is told apart from a childhood one.\nlocal enabled = true\n\nlocal function ageYearsOf(data: LifeData): number\n	return data.ageMonths // Config.Time.MonthsPerYear\nend\n\n\n-- Everything childhood puts on the floor lives in one folder, so a Studio session can see\n-- what is out there and clear the lot if a test left something behind.\nlocal function lureFolder(): Folder\n	local existing = workspace:FindFirstChild(\"ChildhoodLures\")\n	if existing ~= nil and existing:IsA(\"Folder\") then\n		return existing\n	end\n	local folder = Instance.new(\"Folder\")\n	folder.Name = \"ChildhoodLures\"\n	folder.Parent = workspace\n	return folder\nend\n\nlocal function setGuide(player: Player, lure: Lure?)\n	local id = if lure ~= nil then lure.eventId else nil\n	if guided[player] == id then\n		return\n	end\n	guided[player] = id\n\n	if lure == nil then\n		GuideUpdatedRemote:FireClient(player, { target = nil, label = nil })\n		return\n	end\n	GuideUpdatedRemote:FireClient(player, { target = lure.at, label = lure.label })\nend\n\n-- Takes down whatever is standing in the room and stops pointing at it. Safe to call on a\n-- player who has nothing out, which is most of them most of the time.\nlocal function clearLure(player: Player)\n	local lure = lures[player]\n	if lure ~= nil then\n		lure.marker.destroy()\n		lures[player] = nil\n	end\n	setGuide(player, nil)\nend\n\n-- A piece of floor the player could actually get to, or nil if this room has none.\n--\n-- Swept as rings rather than as a single circle because the far ring in a small bedroom is\n-- entirely inside the walls, and a toddler's world is small rooms. Distance is preferred\n-- over closeness -- the crawl is the mechanic, and a lure placed at arm's length is the old\n-- behaviour wearing a pad -- but direction is picked at random within whichever ring is\n-- reached, because \"the furthest spot in the room\" is the same corner every time and a\n-- childhood spent crawling into one corner is not a childhood.\n--\n-- Nil is genuinely possible and genuinely rare: a closet with the door shut. Every room\n-- larger than the player gets a spot, because after the rings comes FallbackStuds.\nlocal function spotFor(character: Model, from: Vector3): Vector3?\n	local ignore = Ground.IgnoreList({ character })\n	local radius = Ground.BodyRadius(character)\n	local height = Ground.BodyHeight(character)\n\n	local bearings = Ground.Bearings(360, WANDER.Bearings)\n\n	-- Every spot at one distance that the player could actually get to.\n	local function ringAt(distance: number): { Vector3 }\n		local found: { Vector3 } = {}\n		for _, bearing in bearings do\n			local direction = CFrame.fromAxisAngle(Vector3.yAxis, math.rad(-bearing)) * Vector3.new(0, 0, -1)\n			-- Reachability from where the toddler is, and it is the check that matters\n			-- most here of the three: a thing behind a wall with a line pointing through\n			-- the wall is worse than no thing at all. The player follows the line into\n			-- plaster and concludes the game is broken, which on that evidence is a\n			-- reasonable conclusion.\n			local floor = Ground.SpotAt(from + direction * distance, radius, height, ignore, from)\n			if floor ~= nil then\n				table.insert(found, floor)\n			end\n		end\n		return found\n	end\n\n	-- Outermost ring first, so distance is preferred, and a coin toss between the\n	-- bearings that ring found, so direction is not.\n	local span = WANDER.FarStuds - WANDER.NearStuds\n	for ring = WANDER.Rings, 1, -1 do\n		-- Rings-1 in the divisor so the last ring lands exactly on FarStuds rather\n		-- than short of it, and a single ring is simply the near one.\n		local share = if WANDER.Rings <= 1 then 0 else (ring - 1) / (WANDER.Rings - 1)\n		local found = ringAt(WANDER.NearStuds + span * share)\n		if #found > 0 then\n			return found[math.random(#found)]\n		end\n	end\n\n	-- Only now, and only because the alternative is an empty room forever.\n	local close = ringAt(WANDER.FallbackStuds)\n	if #close > 0 then\n		return close[math.random(#close)]\n	end\n	return nil\nend\n\nlocal function characterOf(player: Player): (Model?, Vector3?)\n	local character = player.Character\n	if character == nil then\n		return nil, nil\n	end\n	local root = character:FindFirstChild(\"HumanoidRootPart\")\n	if root == nil or not root:IsA(\"BasePart\") then\n		return nil, nil\n	end\n	return character, root.Position\nend\n\n-- Puts the next thing in the room. Returns false when there was nothing to stage or\n-- nowhere to stage it, and the caller simply tries again next tick -- both are ordinary\n-- and neither is worth a warning four times a second.\nlocal function stage(player: Player, data: LifeData): boolean\n	local character, position = characterOf(player)\n	if character == nil or position == nil then\n		return false\n	end\n\n	local event = EventService.PickStageable(player, \"Wandered\")\n	if event == nil then\n		return false\n	end\n\n	local spot = spotFor(character, position)\n	if spot == nil then\n		return false\n	end\n\n	-- Claimed in the profile before anything is built, so a rejoin mid-childhood finds the\n	-- same event waiting rather than rolling a fresh one -- and so DeliveryService, which\n	-- reads the same field, does not stage a letter on top of it.\n	data.deliveringEventId = event.id\n\n	local label = event.lure or WANDER.DefaultLure\n	local marker = ChoiceMarkers.Build(lureFolder(), spot, WANDER.ReachStuds, {\n		label = label,\n		-- Never locked. Nothing here is refused: the pad is somewhere to crawl to.\n		locked = false,\n	})\n\n	local lure: Lure = { eventId = event.id, label = label, at = spot, marker = marker }\n	lures[player] = lure\n	setGuide(player, lure)\n	return true\nend\n\n-- Reached. Opens the prompt exactly the way a tagged object in the world does, which is\n-- what keeps a wandered event and an anchored one the same kind of thing.\nlocal function reach(player: Player, data: LifeData, lure: Lure)\n	clearLure(player)\n\n	-- Spawned rather than called: offering builds the scene, which yields, and this runs\n	-- inside the loop that ticks every player. One toddler waiting on a model to assemble\n	-- must not be every toddler on the server waiting with them.\n	--\n	-- Safe to leave the loop running underneath it because the lure is already down and the\n	-- claim is still set, so the next tick returns at the pending-or-claimed guard and\n	-- cannot stage a second thing or offer this one twice.\n	task.spawn(function()\n		if EventService.OfferIfEligible(player, lure.eventId) then\n			return\n		end\n		-- Every ordinary reason -- aged past it since it was staged, already lived, a\n		-- prompt open -- and none of them is a fault. The claim is dropped so the next\n		-- tick can stage something the player can actually have.\n		if data.deliveringEventId == lure.eventId then\n			data.deliveringEventId = nil\n		end\n	end)\nend\n\nlocal function tickPlayer(player: Player, now: number)\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return\n	end\n	local data = Lives.Active(profile.Data)\n\n	-- Noticed before anything else, because a prompt closing is what starts the beat and\n	-- it can close on a tick where the player is also dying or growing out of childhood.\n	local pending = data.pendingEventId ~= nil\n	if wasPending[player] and not pending then\n		readyAt[player] = now + WANDER.NextSeconds\n	end\n	wasPending[player] = pending\n\n	if not enabled or not data.alive or ageYearsOf(data) > Config.Childhood.EndAge then\n		clearLure(player)\n		return\n	end\n\n	local lure = lures[player]\n	if lure ~= nil then\n		-- The prompt opened some other way -- forced from the harness, or another lure\n		-- reached on the way over. Whatever is out there is now the answer to\n		-- a question that is already being asked, so it comes down.\n		if pending or data.deliveringEventId ~= lure.eventId then\n			clearLure(player)\n			return\n		end\n\n		local _, position = characterOf(player)\n		if position == nil then\n			return\n		end\n		if Ground.FlatDistance(position, lure.at) <= WANDER.ReachStuds then\n			reach(player, data, lure)\n		end\n		return\n	end\n\n	if pending or data.deliveringEventId ~= nil then\n		return\n	end\n	if now < (readyAt[player] or 0) then\n		return\n	end\n\n	stage(player, data)\nend\n\nlocal function forget(player: Player)\n	clearLure(player)\n	readyAt[player] = nil\n	wasPending[player] = nil\n	guided[player] = nil\nend\n\n-- A new life, or the end of one. Called by LifeService at both ends for the same reason\n-- PeopleService is: a thing on the floor inviting a dead child across the room is the\n-- worst frame this system could draw.\nfunction ChildhoodService.ResetForNewLife(player: Player)\n	clearLure(player)\n	readyAt[player] = nil\n	wasPending[player] = nil\nend\n\n-- Studio harness: puts the next thing out now, without waiting for the beat.\nfunction ChildhoodService.ForceStage(player: Player): boolean\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return false\n	end\n	clearLure(player)\n	readyAt[player] = 0\n	return stage(player, Lives.Active(profile.Data))\nend\n\nfunction ChildhoodService.SetEnabled(value: boolean)\n	enabled = value\n	for _, player in Players:GetPlayers() do\n		if not value then\n			clearLure(player)\n		end\n	end\nend\n\nfunction ChildhoodService.IsEnabled(): boolean\n	return enabled\nend\n\n-- What the harness prints. The one question this system generates is \"why is there nothing\n-- in the room\", and there are exactly four answers: too old for it, a prompt is already\n-- open, nothing is left unlived at this age, or there is nowhere in this room to put one.\n-- All four are said out loud here rather than left to be inferred from an empty floor.\nfunction ChildhoodService.Describe(player: Player): string\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return \"childhood: no profile loaded\"\n	end\n	local data = Lives.Active(profile.Data)\n	local age = ageYearsOf(data)\n\n	local out = \"nothing out\"\n	local lure = lures[player]\n	if lure ~= nil then\n		local _, position = characterOf(player)\n		local away = if position ~= nil then string.format(\"%.1f studs away\", Ground.FlatDistance(position, lure.at)) else \"nowhere to measure from\"\n		out = `\"{lure.eventId}\" out, {away} (reach {WANDER.ReachStuds})`\n	end\n\n	local why = \"\"\n	if lure == nil then\n		if age > Config.Childhood.EndAge then\n			why = `; age {age} is past {Config.Childhood.EndAge}, so childhood is over`\n		elseif data.pendingEventId ~= nil then\n			why = `; \"{data.pendingEventId}\" is already being asked`\n		elseif data.deliveringEventId ~= nil then\n			why = `; \"{data.deliveringEventId}\" is claimed but not on the floor`\n		elseif os.clock() < (readyAt[player] or 0) then\n			why = `; {string.format(\"%.1f\", (readyAt[player] or 0) - os.clock())}s of beat left`\n		elseif EventService.PickStageable(player, \"Wandered\") == nil then\n			why = `; nothing unlived is written for age {age}`\n		else\n			why = \"; nowhere in this room to put one\"\n		end\n	end\n\n	return string.format(\n		\"childhood: %s | age %d | %s%s\",\n		if enabled then \"enabled\" else \"DISABLED\",\n		age,\n		out,\n		why\n	)\nend\n\nfunction ChildhoodService:Start()\n	Players.PlayerRemoving:Connect(forget)\n\n	task.spawn(function()\n		while true do\n			task.wait(WANDER.TickSeconds)\n			local now = os.clock()\n			for _, player in Players:GetPlayers() do\n				-- One player's empty room must not stop the next player's, so a fault\n				-- here is reported and stepped over rather than taking the loop down.\n				local ok, err = pcall(tickPlayer, player, now)\n				if not ok then\n					warn(`[AGES] childhood tick failed for {player.Name}: {err}`)\n				end\n			end\n		end\n	end)\nend\n\nreturn ChildhoodService\n"
table.insert(AGES_MANIFEST, "src/server/services/ChildhoodService.luau")
AGES_SOURCES["src/server/services/CodeService.luau"] = "--!strict\n-- The redeem box. One string in, one sentence back, and a reward that is decided entirely\n-- from `content/Codes.luau` and never from anything the client sent.\n--\n-- **This is the only free-text input the game place has**, and everything unusual about\n-- this file follows from that. The lobby's name field is the other one, and it was put in\n-- the lobby precisely so that the place with a world running in it would have none. This\n-- one has to be here -- a code is something you redeem while playing -- so it is handled\n-- the way a free-text field from a client has to be: length-capped before it is looked at,\n-- rate-limited per player, matched against a fixed table, and answered with the same\n-- sentence whether the code was wrong or never existed.\n--\n-- **Order of operations, and it is the whole correctness argument.** Decide the outcome,\n-- record the redemption, *then* pay. Paying first and recording after leaves a window in\n-- which a second attempt lands between the two and pays twice; there is no lock here and\n-- there does not need to be, because the record is written before anything is granted and\n-- the second attempt reads it and refuses.\n--\n-- **A code is account-level.** It is written to `ProfileData.redeemedCodes`, not to the\n-- life, so a player cannot bank a code, delete the slot and cash it again -- three times\n-- over, with three slots, on every code the game ever ships.\n\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Config = require(ReplicatedStorage:WaitForChild(\"Config\"))\nlocal Remotes = require(ReplicatedStorage:WaitForChild(\"Remotes\"))\nlocal Types = require(ReplicatedStorage:WaitForChild(\"Types\"))\n\nlocal Codes = require(script.Parent.Parent.content.Codes)\nlocal DataService = require(script.Parent.DataService)\nlocal MoneyService = require(script.Parent.MoneyService)\n\ntype Player = Players.Player\ntype CodeEntry = Codes.CodeEntry\ntype RedeemedCode = Types.RedeemedCode\n\nlocal CodeService = {}\n\nlocal CODES = Config.Codes\nlocal CODES_UPDATED = Remotes.Get(\"CodesUpdated\")\nlocal CODE_RESULT = Remotes.Get(\"CodeResult\")\nlocal REQUEST_REDEEM = Remotes.Get(\"RequestRedeemCode\")\n\n-- When each player last tried. Cleared on leave rather than left to grow, because this is\n-- keyed by Player instance and a stale key would pin the object.\nlocal lastAttempt: { [Player]: number } = {}\n\n-- The same sentence for \"that is not a code\" and \"that code is retired\", on purpose. Two\n-- different refusals would turn the box into an oracle that answers \"does this code exist\"\n-- for free, which is exactly what somebody enumerating strings wants from it.\nlocal UNKNOWN = \"That code isn't one we recognise. Check the spelling and try again.\"\n\nlocal function reply(player: Player, ok: boolean, message: string)\n	CODE_RESULT:FireClient(player, { ok = ok, message = message } :: Types.CodeResult)\nend\n\n-- Everything this account has used, newest content order, each with what it paid.\n--\n-- Built by walking the content list rather than the save, so the pane lists redemptions in\n-- a stable order and an id in the save with no entry behind it is skipped rather than\n-- drawn as a blank row. That gap should not happen -- `Codes.luau` says never to delete a\n-- row -- but a receipt is the wrong place to find out that somebody did.\nlocal function stateFor(player: Player): { RedeemedCode }\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return {}\n	end\n\n	local redeemed: { RedeemedCode } = {}\n	for _, entry in Codes.Entries do\n		if profile.Data.redeemedCodes[entry.id] then\n			table.insert(redeemed, {\n				id = entry.id,\n				code = entry.code,\n				label = entry.label,\n				reward = Codes.Describe(entry),\n			})\n		end\n	end\n	return redeemed\nend\n\nfunction CodeService.Push(player: Player)\n	if DataService.GetProfile(player) == nil then\n		return\n	end\n	CODES_UPDATED:FireClient(player, { redeemed = stateFor(player) } :: Types.CodesState)\nend\n\n-- Hand over what one entry pays. Called only after the redemption is already recorded, so\n-- a failure to pay costs the player a reward and never lets them have it twice -- which is\n-- the right way round for a mistake to go wrong.\nlocal function grant(player: Player, entry: CodeEntry): string\n	local paid: { string } = {}\n\n	local money = entry.money or 0\n	if money > 0 then\n		MoneyService.Add(player, money, `code {entry.id}`)\n		table.insert(paid, \"it's in your pocket\")\n	end\n\n	local spins = entry.spins or 0\n	if spins > 0 then\n		local profile = DataService.GetProfile(player)\n		if profile ~= nil then\n			profile.Data.spinsAvailable += spins\n			-- Said out loud because a spin is spent in the lobby and this is the game place.\n			-- A player who redeems a spin code here and sees nothing change on screen has\n			-- been given something they have no way of knowing about.\n			table.insert(paid, \"your spins are waiting in the menu\")\n		end\n	end\n\n	return table.concat(paid, \", and \")\nend\n\n-- The whole redemption, from a typed string to a sentence. Returns the sentence so that\n-- the remote handler and the debug command are the same code path rather than two.\nlocal function redeem(player: Player, typed: string): (boolean, string)\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return false, \"Your save isn't loaded yet. Give it a moment.\"\n	end\n\n	if #typed > CODES.MaxLength then\n		-- Checked on the raw string, before normalizing, because normalizing allocates and\n		-- a length check is what stops a client sending a megabyte to be uppercased.\n		return false, UNKNOWN\n	end\n\n	local entry = Codes.Find(typed)\n	if entry == nil or not entry.active then\n		return false, UNKNOWN\n	end\n\n	if profile.Data.redeemedCodes[entry.id] then\n		-- The one refusal that names the code rather than hiding behind `UNKNOWN`, and it is\n		-- safe to: the player has already proved they know this one, so there is nothing left\n		-- to leak. It is also the refusal most likely to be a real player double-clicking.\n		return false, `You've already redeemed {entry.code}.`\n	end\n\n	local count = 0\n	for _ in profile.Data.redeemedCodes do\n		count += 1\n	end\n	if count >= CODES.MaxRedeemed then\n		-- Unreachable while the content list is shorter than the cap, which it is by a wide\n		-- margin. It is here because `redeemedCodes` is an unbounded dictionary written to a\n		-- save, and every unbounded thing in this tree has a ceiling with a sentence on it.\n		return false, \"You've redeemed as many codes as an account can hold.\"\n	end\n\n	-- Recorded before anything is paid. See the header: this is what makes a double-fire\n	-- cost the player a duplicate refusal rather than paying them twice.\n	profile.Data.redeemedCodes[entry.id] = true\n\n	local where = grant(player, entry)\n	CodeService.Push(player)\n\n	local reward = Codes.Describe(entry)\n	if where == \"\" then\n		return true, `{entry.code} redeemed: {reward}.`\n	end\n	return true, `{entry.code} redeemed: {reward} — {where}.`\nend\n\nfunction CodeService:Init()\n	REQUEST_REDEEM.OnServerEvent:Connect(function(player: Player, typed: unknown)\n		if type(typed) ~= \"string\" then\n			return\n		end\n\n		local now = os.clock()\n		local previous = lastAttempt[player]\n		if previous ~= nil and now - previous < CODES.AttemptCooldownSeconds then\n			-- Answered rather than dropped. A silently ignored attempt looks to a player\n			-- exactly like a box that does not work, and the one thing this field must never\n			-- do is leave somebody unsure whether it heard them.\n			reply(player, false, \"Slow down a moment, then try again.\")\n			return\n		end\n		lastAttempt[player] = now\n\n		local ok, message = redeem(player, typed)\n		reply(player, ok, message)\n	end)\n\n	Players.PlayerAdded:Connect(function(player: Player)\n		CodeService.Push(player)\n	end)\n\n	Players.PlayerRemoving:Connect(function(player: Player)\n		lastAttempt[player] = nil\n	end)\nend\n\nfunction CodeService:Start()\n	-- Nothing to run. A code is redeemed when somebody types one, and never otherwise.\nend\n\n-- What this account has used, on one line, for `/code`.\nfunction CodeService.Describe(player: Player): string\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return \"no profile\"\n	end\n\n	local used: { string } = {}\n	for _, entry in stateFor(player) do\n		table.insert(used, `{entry.code} ({entry.reward})`)\n	end\n	if #used == 0 then\n		return `none redeemed of {#Codes.Entries} in the list`\n	end\n	return `{#used} of {#Codes.Entries}: {table.concat(used, \", \")}`\nend\n\n-- Redeem from a debug command, through the same path a typed one takes -- including the\n-- already-redeemed refusal, which is the case `/code` exists to test.\nfunction CodeService.Force(player: Player, typed: string): string\n	local _, message = redeem(player, typed)\n	return message\nend\n\n-- Un-redeem everything, so the same code can be tested twice without a fresh account.\n-- Deliberately the only way back: nothing in the game removes a redemption, because a code\n-- that can be given back is a code that can be redeemed twice.\nfunction CodeService.Clear(player: Player): number\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return 0\n	end\n\n	local cleared = 0\n	for id in profile.Data.redeemedCodes do\n		profile.Data.redeemedCodes[id] = nil\n		cleared += 1\n	end\n	CodeService.Push(player)\n	return cleared\nend\n\nreturn CodeService\n"
