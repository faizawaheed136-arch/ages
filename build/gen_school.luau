inAge = 12,\n		maxAge = 999,\n		minAgeOffset = -3,\n		maxAgeOffset = 5,\n		minHeight = 0.92,\n		maxHeight = 1.07,\n		startingBond = 0,\n		busyLines = {\n			\"Training's starting. I'll catch you after.\",\n			\"Not now -- we're in the middle of a game.\",\n			\"Give me five minutes. I'm about to go on.\",\n		},\n		offers = {\n			{\n				id = \"small_talk\",\n				label = \"Talk about nothing in particular\",\n				minAge = 5,\n				maxAge = 999,\n				minBond = ALWAYS,\n				bond = 1,\n				stats = { happiness = 2 },\n				lines = {\n					\"Waiting for the rest of the team. You here often?\",\n					\"Not much happening. Want to just... sit for a bit?\",\n					\"Good day for it. The field's in great shape.\",\n				},\n			},\n			{\n				id = \"snub\",\n				label = \"Snub them\",\n				minAge = 10,\n				maxAge = 999,\n				minBond = ALWAYS,\n				maxBond = -5,\n				bond = -5,\n				lines = {\n					\"Right. I'll just go find someone else.\",\n					\"Whatever. I wasn't trying to talk.\",\n				},\n			},\n			{\n				id = \"cold_shoulder\",\n				label = \"Give them the cold shoulder\",\n				minAge = 10,\n				maxAge = 999,\n				minBond = ALWAYS,\n				maxBond = -5,\n				bond = -7,\n				lines = {\n					\"I see you. Don't pretend you didn't.\",\n					\"Fine. I'll take my ball elsewhere.\",\n				},\n			},\n			{\n				id = \"make_right\",\n				label = \"Try to make it right\",\n				minAge = 10,\n				maxAge = 999,\n				minBond = ALWAYS,\n				maxBond = -1,\n				bond = 8,\n				ask = true,\n				lines = {\n					\"Look, I didn't mean it like that. Sorry.\",\n				},\n				refusedLines = {\n					\"I need a minute. Don't make it worse.\",\n					\"Not now. Ask me later when I've cooled off.\",\n				},\n			},\n			{\n				id = \"watch_game\",\n				label = \"Watch the game with them\",\n				minAge = 10,\n				maxAge = 999,\n				minBond = ALWAYS,\n				bond = 3,\n				stats = { happiness = 3, health = 1 },\n				lines = {\n					\"Come on, sit here. This match is going to be good.\",\n					\"Watch this -- he always scores from this angle.\",\n					\"We haven't missed a game all season. You're part of the team now.\",\n				},\n			},\n			{\n				id = \"join_practice\",\n				label = \"Join practice with them\",\n				minAge = 10,\n				maxAge = 999,\n				minBond = 0,\n				bond = 4,\n				stats = { happiness = 2, health = 2 },\n				lines = {\n					\"We could use one more. Don't be shy.\",\n					\"Just keep up. You'll get the hang of it.\",\n					\"This is the warm-up. Ready for the real stuff?\",\n				},\n			},\n			{\n				id = \"walk_basketball\",\n				label = \"Walk to the basketball court with them\",\n				minAge = 12,\n				maxAge = 999,\n				minBond = 20,\n				bond = 4,\n				ask = true,\n				walksTo = \"basketball_court\",\n				lines = {\n					\"Field's empty now. Let's go shoot some hoops.\",\n					\"I need to work on my free throws. Come watch.\",\n					\"Same court every day. You in?\",\n				},\n				refusedLines = {\n					\"Alright. I'll save your spot.\",\n					\"Another time. I'm waiting for the others.\",\n				},\n				arrivalLines = {\n					\"Here we are. First to five wins, loser buys drinks.\",\n					\"Made it. Your turn to shoot -- don't choke.\",\n					\"This court's ours. No one else showing up today.\",\n				},\n			},\n			{\n				id = \"walk_playground\",\n				label = \"Walk to the playground with them\",\n				minAge = 8,\n				maxAge = 999,\n				minBond = 15,\n				bond = 3,\n				ask = true,\n				walksTo = \"playground\",\n				lines = {\n					\"I'm heading to the playground. Want to come?\",\n					\"The swings are free. Come on, before someone takes them.\",\n					\"It's quiet over there. Good for talking.\",\n				},\n				refusedLines = {\n					\"Okay. I'll be there later if you change your mind.\",\n					\"Suit yourself. I'm going anyway.\",\n				},\n				arrivalLines = {\n					\"Here. The good swing's free. Take it.\",\n					\"We're here. Nobody's around -- it's all ours.\",\n					\"Playground's quiet today. Perfect.\",\n				},\n			},\n			{\n				id = \"know_athlete\",\n				label = \"Learn their name\",\n				minAge = 8,\n				maxAge = 999,\n				minBond = 10,\n				bond = 3,\n				stats = { happiness = 1 },\n				gives = \"known\",\n				lines = {\n					\"We see each other here all the time. I don't know your name?\",\n					\"Oh, right. We should fix that.\",\n					\"Nice to meet you. Properly, this time.\",\n				},\n			},\n			{\n				id = \"practice_friend\",\n				label = \"Always practice together\",\n				minAge = 10,\n				maxAge = 999,\n				minBond = 30,\n				bond = 6,\n				stats = { happiness = 3, health = 1 },\n				needsTie = \"known\",\n				gives = \"friend\",\n				lines = {\n					\"Same time tomorrow? Good. I'll save you a spot.\",\n					\"You're the only person I practice with. Don't flake on me.\",\n					\"We should get matching shirts. Just saying.\",\n				},\n			},\n			{\n				id = \"closest_athlete\",\n				label = \"Tell them the thing you're most proud of\",\n				minAge = 14,\n				maxAge = 999,\n				minBond = 60,\n				bond = 8,\n				stats = { happiness = 4 },\n				needsTie = \"friend\",\n				gives = \"closest\",\n				lines = {\n					\"No one else knows this. That's why I'm telling you.\",\n					\"Thanks for not making it weird. I meant it.\",\n					\"This is ours. Whatever happens, this stays between us.\",\n				},\n			},\n			{\n				-- A rival is not the absence of a relationship. It is a relationship that\n				-- turned sharp: somebody you pushed past, outdid, or crossed, and who\n				-- respects you enough to chase you for it. Capped at one because a life\n				-- only has room for one person who means this much in this direction.\n				--\n				-- Gated on the negative territory carved by `snub` and `cold_shoulder`\n				-- rather than on any tie — you do not need to be known to become somebody's\n				-- rival, and requiring one would make the row invisible to the player who\n				-- sour their first encounter. The maxBond = -1 ensures it vanishes as soon\n				-- as the bond climbs back past a grudging truce.\n				id = \"become_rivals\",\n				label = \"Make them your rival\",\n				minAge = 12,\n				maxAge = 999,\n				minBond = ALWAYS,\n				maxBond = -1,\n				bond = 5,\n				stats = { happiness = -2 },\n				gives = \"rival\",\n				lines = {\n					\"Fine. You want it this way? I'm not letting you forget it.\",\n					\"You think you're better than me? Prove it. Every time.\",\n					\"Done. Next time we meet, I'm not going easy on you.\",\n				},\n			},\n			{\n				-- An enemy is not the absence of a relationship. It is the relationship\n				-- that remains when the ladder has been burned: somebody you betrayed,\n				-- destroyed, or crossed so deeply that respect is gone and only the\n				-- memory of what was lost remains. Capped at one because a life only has\n				-- room for one person who means this much in this direction. Gated on\n				-- the deepest negative bond (MinBond = -20) so it only appears when the\n				-- relationship has been actively destroyed, not merely cooled. It gives\n				-- no bond gain -- making an enemy is a choice that costs you the\n				-- relationship entirely, and the bond stays at the floor.\n				id = \"become_enemies\",\n				label = \"Make them your enemy\",\n				minAge = 14,\n				maxAge = 999,\n				minBond = ALWAYS,\n				maxBond = -20,\n				bond = 0,\n				stats = { happiness = -10 },\n				gives = \"enemy\",\n				ask = true,\n				lines = {\n					\"You think this is over? It isn't. I will remember this forever.\",\n					\"We are done. Not rivals -- enemies. There is no coming back.\",\n					\"Go. But know that every time our paths cross, I will be there.\",\n				},\n				refusedLines = {\n					\"You're not worth it. Get out of my sight.\",\n					\"Fine. Stay. It changes nothing.\",\n					\"I don't need your permission to hate you.\",\n				},\n			},\n			{\n				-- A rival is not the absence of a relationship. It is a relationship that\n				-- turned sharp, and the only way back is through it. This row is gated on\n				-- the rival tie specifically so it does not appear for somebody you have\n				-- merely slighted -- only when the rivalry is already set in stone.\n				id = \"repair_rival\",\n				label = \"Tell them you owe them an apology\",\n				minAge = 12,\n				maxAge = 999,\n				minBond = ALWAYS,\n				maxBond = -1,\n				bond = 10,\n				ask = true,\n				needsTie = \"rival\",\n				lines = {\n					\"You were right. I was wrong. I shouldn't have done that.\",\n					\"I've been thinking about it. I crossed a line and I'm sorry.\",\n					\"This doesn't have to be how it is. I want to fix it.\",\n				},\n				refusedLines = {\n					\"Sorry doesn't undo it. Show me you mean it.\",\n					\"You think words fix this? They don't.\",\n					\"Save it. I'm not ready to hear it.\",\n				},\n			},\n			{\n				-- A sibling is chosen, not given. Offered at the very top of the ladder\n				-- when the bond is past closest and the player is old enough to mean it.\n				-- The tie is the last rung in this archetype: after this there is nothing\n				-- higher to offer and the relationship stands on what it is rather than\n				-- what it could become.\n				id = \"chosen_sibling\",\n				label = \"Make them your sibling\",\n				minAge = 16,\n				maxAge = 999,\n				minBond = 85,\n				bond = 6,\n				stats = { happiness = 5 },\n				needsTie = \"closest\",\n				gives = \"sibling\",\n				lines = {\n					\"We don't have to be related to be family. I choose you.\",\n					\"Blood doesn't make this. Showing up does. I'm showing up.\",\n					\"Then it's settled. You're stuck with me now.\",\n				},\n			},\n		},\n	},\n\n	{\n		-- People at the fade offices between downtown and the residential grid.\n		-- Mid-level workers who take the longer commute and hang out near the entrance.\n		id = \"fade_worker\",\n		placeId = \"fade_1\",\n		minAge = 16,\n		maxAge = 999,\n		minAgeOffset = -2,\n		maxAgeOffset = 18,\n		minHeight = 0.94,\n		maxHeight = 1.07,\n		startingBond = 0,\n		busyLines = {\n			\"Clocking out in ten. Walk with me?\",\n			\"In a meeting. I'll find you tomorr