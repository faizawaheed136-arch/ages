AGES_SOURCES["src/server/content/LifeEvents/init.luau"] = "--!strict\n-- Merges the event content modules into one table and validates them at server\n-- start. A content mistake is an authoring bug, not a runtime condition, so\n-- these throw immediately and loudly rather than quietly dropping an entry that\n-- would then never fire and never be missed.\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal Types = require(ReplicatedStorage:WaitForChild(\"Types\"))\nlocal Config = require(ReplicatedStorage:WaitForChild(\"Config\"))\nlocal Delivery = require(ReplicatedStorage:WaitForChild(\"Delivery\"))\n\nlocal Cast = require(script.Parent.Cast)\nlocal Flags = require(script.Parent.Flags)\nlocal Jobs = require(script.Parent.Jobs)\nlocal Props = require(script.Parent.Props)\nlocal Ribbons = require(script.Parent.Ribbons)\nlocal Subjects = require(script.Parent.Subjects)\nlocal Ties = require(script.Parent.Ties)\n\ntype LifeEvent = Types.LifeEvent\ntype PropPlacement = Types.PropPlacement\n\nlocal SOURCES: { { LifeEvent } } = {\n	require(script.Childhood),\n	require(script.School),\n	require(script.Teen),\n	require(script.Adult),\n	require(script.Gym),\n	require(script.Park),\n	require(script.Ambient),\n	require(script.Work),\n	require(script.Debt),\n	require(script.CareerBranch),\n	require(script.Ties),\n	require(script.Crime),\n}\n\n-- One option is not a choice.\nlocal MIN_CHOICES = 2\n\nlocal all: { LifeEvent } = {}\nlocal byId: { [string]: LifeEvent } = {}\n\nlocal function validate(event: LifeEvent)\n	if byId[event.id] ~= nil then\n		error(`[AGES content] duplicate event id \"{event.id}\"`)\n	end\n	if event.minAge > event.maxAge then\n		error(`[AGES content] event \"{event.id}\" has minAge above maxAge`)\n	end\n\n	-- Cooldowns are real seconds; a negative or fractional value is the same\n	-- kind of unit mistake a float below zero would be, and the upper bound\n	-- catches a number authored in game minutes before it ever reaches the\n	-- picker. Nil means 0 — the default is the same as today.\n	local cooldown = event.cooldown\n	if cooldown ~= nil then\n		if cooldown < 1 or cooldown ~= math.floor(cooldown) or cooldown > Config.Events.MaxCooldownSeconds then\n			error(\n				`[AGES content] event \"{event.id}\" has cooldown {cooldown}; `\n					.. `it must be a whole number between 1 and {Config.Events.MaxCooldownSeconds}`\n			)\n		end\n	end\n\n	if #event.choices < MIN_CHOICES then\n		error(`[AGES content] event \"{event.id}\" needs at least {MIN_CHOICES} choices`)\n	end\n\n	-- Casting only means anything for a visitor, so an id on anything else is a\n	-- copy-paste that would silently do nothing.\n	if event.cast ~= nil then\n		if event.delivery ~= \"NPCApproach\" then\n			error(`[AGES content] event \"{event.id}\" casts \"{event.cast}\" but is delivered by {event.delivery}`)\n		end\n		if Cast.ById[event.cast] == nil then\n			error(`[AGES content] event \"{event.id}\" casts \"{event.cast}\", who is not in the cast`)\n		end\n	end\n\n	-- Deliberately the *only* check on a subject. Unlike cast, it is legal against\n	-- every delivery and every resolution -- the dog turns up whether the event\n	-- arrived on a birthday or off a doormat -- so a misspelled id is the one thing\n	-- that could be wrong here, and it is the one thing a runtime warning would let\n	-- ship as an event that quietly stopped being about anything.\n	if event.subject ~= nil and Subjects.ById[event.subject] == nil then\n		error(`[AGES content] event \"{event.id}\" is about \"{event.subject}\", which is not a subject`)\n	end\n\n	-- Escalations chain events: a follow-up fires when the prior one resolves,\n	-- so the player can trace the thread. A chain to nothing is dead writing.\n	-- A chain to the same id loops forever. A chain to an earlier age is a\n	-- self-contradiction that the picker cannot resolve in order.\n	local escalatesTo = event.escalatesTo\n	if escalatesTo ~= nil then\n		if escalatesTo == event.id then\n			error(\n				`[AGES content] event \"{event.id}\" escalates to itself; `\n					.. `a chain must point at a different event`\n			)\n		elseif byId[escalatesTo] == nil then\n			error(\n				`[AGES content] event \"{event.id}\" escalates to \"{escalatesTo}\", `\n					.. `which is not a declared event`\n			)\n		elseif byId[escalatesTo].minAge < event.minAge then\n			error(\n				`[AGES content] event \"{event.id}\" escalates to \"{escalatesTo}\", `\n					.. `which starts at age {byId[escalatesTo].minAge}, below this event's {event.minAge}; `\n					.. `a follow-up cannot precede its cause`\n			)\n		end\n	end\n\n	-- A lure is the words on the thing the player walks to, so it means something on\n	-- exactly one route and nothing anywhere else. Both directions are refused: a\n	-- wandered event without one is a blank pad in a room the player is meant to cross\n	-- for it, and a lure on a letter is a line of writing that goes nowhere and reads,\n	-- to whoever wrote it, as though it had been used.\n	local wandered = Delivery.RouteOf(event.delivery) == \"Wandered\"\n	if wandered and event.lure == nil then\n		error(`[AGES content] wandered event \"{event.id}\" has no lure; there would be nothing written on it`)\n	end\n	if not wandered and event.lure ~= nil then\n		error(\n			`[AGES content] event \"{event.id}\" has a lure but is delivered \"{event.delivery}\", `\n				.. `which puts nothing on the floor for it to be written on`\n		)\n	end\n\n	-- Tags are opaque to the validator: they are picked up by the picker and\n	-- the routing layer, not checked against a fixed registry. Unknown tags\n	-- are ignored rather than refused, because a new tag that has no reader\n	-- yet is content, not a fault. Empty lists are normalised to nil so the\n	-- picker never has to think about the empty-list case.\n	if event.tags ~= nil then\n		if #event.tags == 0 then\n			event.tags = nil\n		else\n			for _, tag in event.tags do\n				if tag == \"\" then\n					error(\n						`[AGES content] event \"{event.id}\" has an empty tag; `\n							.. `non-empty strings only`\n					)\n				end\n			end\n		end\n	end\n\n	-- An ambient event below this age could never fire, because the scheduler\n	-- will not stage one there -- and it must not, since resolving an event at\n	-- that age advances the year. Caught here rather than at runtime, where it\n	-- would look like an event that simply never came up.\n	if Delivery.RouteOf(event.delivery) == \"Ambient\" and event.minAge < Config.Ambient.MinAge then\n		error(\n			`[AGES content] ambient event \"{event.id}\" starts at age {event.minAge}, `\n				.. `below Ambient.MinAge ({Config.Ambient.MinAge}); it could never be staged`\n		)\n	end\n\n	-- A shift event below the youngest working age could never fire, because there\n	-- is no job that would have you at that age and so no shift for it to fire\n	-- during. The same shape of check as the ambient one above, and caught for the\n	-- same reason: at runtime the symptom is an event that simply never comes up,\n	-- which is indistinguishable from bad luck.\n	local onShift = Delivery.RouteOf(event.delivery) == \"Shift\"\n	if onShift then\n		local workingAge = Jobs.MinimumWorkingAge()\n		if event.minAge < workingAge then\n			error(\n				`[AGES content] shift event \"{event.id}\" starts at age {event.minAge}, `\n					.. `below the youngest age any job can be held ({workingAge}); it could never fire`\n			)\n		end\n	end\n\n	-- Performance is all or nothing across an event's choices, on the same reasoning\n	-- as stances and reactions: an event where two answers move your record and the\n	-- third does not is indistinguishable, from the player's side, from one where the\n	-- third answer was simply judged neutral -- and those are different sentences.\n	-- Zero is how you say neutral, and saying it is the point.\n	--\n	-- Required on shift events, because a moment at work your job did not notice is\n	-- exactly the thing having a record replaced. Refused everywhere else, because a\n	-- performance weight off the clock has nothing to be recorded against and would\n	-- be a copy-paste that silently does nothing.\n	local scored = 0\n	for _, choice in event.choices do\n		if choice.performance ~= nil then\n			scored += 1\n		end\n	end\n	if onShift then\n		if scored < #event.choices then\n			error(\n				`[AGES content] shift event \"{event.id}\" scores {scored} of its {#event.choices} `\n					.. `choices; every answer at work must say what it does to your record, `\n					.. `and 0 is how you say \"nothing\"`\n			)\n		end\n	elseif scored > 0 then\n		error(\n			`[AGES content] event \"{event.id}\" scores its choices but is delivered by `\n				.. `{event.delivery}, so there is no job to have an opinion`\n		)\n	end\n\n	for _, choice in event.choices do\n		-- Whole units, and inside the range a record can actually hold. A fractional\n		-- weight would land the player on a standing no band boundary is written\n		-- against; one larger than the whole scale would move them from the floor to\n		-- the ceiling in a single answer, which no single answer should do.\n		local performance = choice.performance\n		if performance ~= nil then\n			local span = Config.Work.Standing.Max - Config.Work.Standing.Min\n			if performance ~= math.floor(performance) or math.abs(performance) > span then\n				error(\n					`[AGES content] event \"{event.id}\" choice \"{choice.id}\" scores {performance}; `\n						.. `it must be a whole number no further from zero than the {span}-point record scale`\n				)\n			end\n		end\n	end\n\n	-- Both limits apply to every event now, not only enacted ones, because every event\n	-- ends up on the same panel: an enacted one is a banner plus a walk plus that panel.\n	-- They used to be enacted-only because the choices used to become discs on the\n	-- floor, and a room fits fewer of those than a list does.\n	--\n	-- What they mean now. Past MaxChoices a question stops being a decision and becomes\n	-- a menu -- four things is the most a player will actually weigh against each other\n	-- before picking whichever they read first. Past MaxLabelLength a row wraps to three\n	-- lines and the list stops being readable at a glance, which is the one thing it has\n	-- to be.\n	--\n	-- Caught here rather than at runtime, where the symptom would be an event that\n	-- merely feels bad rather than one that is wrong -- exactly the kind of fault that\n	-- ships.\n	if #event.choices > Config.Enact.MaxChoices then\n		error(\n			`[AGES content] event \"{event.id}\" has {#event.choices} choices; more than `\n				.. `{Config.Enact.MaxChoices} is a menu rather than a decision`\n		)\n	end\n	for _, choice in event.choices do\n		if #choice.label > Config.Enact.MaxLabelLength then\n			error(\n				`[AGES content] choice \"{choice.id}\" in event \"{event.id}\" has a `\n					.. `{#choice.label}-character label; a panel row carries {Config.Enact.MaxLabelLength}`\n			)\n		end\n	end\n\n	-- Acts are all or nothing across an event's choices, and this is the strictest\n	-- version of that rule in the file rather than the same one again. A performance\n	-- or a reaction that only some answers carry is a writing mistake; an act that\n	-- only some answers carry is an answer the player cannot reach at all, because a\n	-- Handled event never opens a panel for the others to be rows on.\n	local acted = 0\n	for _, choice in event.choices do\n		if choice.act ~= nil then\n			acted += 1\n		end\n	end\n	if acted > 0 and acted < #event.choices then\n		error(\n			`[AGES content] event \"{event.id}\" gives {acted} of its {#event.choices} choices `\n				.. `something to do; acts are all or nothing, because the answers without one `\n				.. `would have no panel left to appear on`\n		)\n	end\n	if acted > 0 and event.resolution ~= \"Handled\" then\n		error(\n			`[AGES content] event \"{event.id}\" has acts but resolves \"{event.resolution or \"Panel\"}\"; `\n				.. `answers made of objects are only reachable as \"Handled\"`\n		)\n	end\n	if event.resolution == \"Handled\" and acted == 0 then\n		error(\n			`[AGES content] event \"{event.id}\" resolves \"Handled\" but no choice says what to do; `\n				.. `it would fall back to a panel every time it fired`\n		)\n	end\n\n	if acted > 0 then\n		-- One prop id, one place in the room. The carried object of a Carry is declared\n		-- by every answer that uses it, so repeats are expected and only have to agree:\n		-- two spellings of where the cookie starts would place it at whichever the\n		-- staging loop reached first, which is a bug that moves between events.\n		local placedAt: { [string]: PropPlacement } = {}\n		-- What touching each prop answers. A prop may be the trigger for exactly one\n		-- choice, or the event resolves as whichever watch the tick happened to check\n		-- first -- a coin flip the player cannot see, let alone influence.\n		local triggers: { [string]: string } = {}\n		local carried: { [string]: boolean } = {}\n		-- The key for \"answered where you already are\", which is what a Stay with no\n		-- prop is. Not a legal prop id, so it cannot collide with one.\n		local HERE = \"\\0here\"\n\n		local function place(where: string, placement: PropPlacement)\n			if Props.ById[placement.prop] == nil then\n				error(`[AGES content] {where} names prop \"{placement.prop}\", which is not in Props`)\n			end\n			local first = placedAt[placement.prop]\n			if first == nil then\n				placedAt[placement.prop] = placement\n				return\n			end\n			if first.distance ~= placement.distance or first.offsetDegrees ~= placement.offsetDegrees then\n				error(\n					`[AGES content] {where} puts \"{placement.prop}\" somewhere other than another answer `\n						.. `in the same event does; one object cannot stand in two places`\n				)\n			end\n		end\n\n		for _, choice in event.choices do\n			local act = choice.act\n			if act == nil then\n				continue\n			end\n			local where = `event \"{event.id}\" choice \"{choice.id}\"`\n\n			-- Shorter than a panel row, because it is not one. It floats over an object\n			-- a few studs away and has to be read while the player is moving.\n			if #choice.label > Config.Props.MaxLabelLength then\n				error(\n					`[AGES content] {where} has a {#choice.label}-character label, and it is `\n						.. `written over an object in the room rather than on a row; `\n						.. `{Config.Props.MaxLabelLength} is what fits`\n				)\n			end\n\n			if act.verb == \"Carry\" then\n				if act.at == nil or act.to == nil then\n					error(\n						`[AGES content] {where} carries something, so it needs both the thing to `\n							.. `pick up and somewhere to take it`\n					)\n				end\n			else\n				if act.to ~= nil then\n					error(`[AGES content] {where} is a {act.verb} with a destination; only Carry goes somewhere`)\n				end\n				-- Stay is the one verb whose answer can be \"here\", with nothing in the\n				-- room at all. Every other verb is a thing done to a thing.\n				if act.at == nil and act.verb ~= \"Stay\" then\n					error(`[AGES content] {where} is a {act.verb} with nothing to do it to`)\n				end\n			end\n\n			local at = act.at\n			local to = act.to\n			if at ~= nil then\n				place(where, at)\n			end\n			if to ~= nil then\n				place(where, to)\n			end\n			if at ~= nil and to ~= nil and at.prop == to.prop then\n				error(`[AGES content] {where} carries \"{at.prop}\" to itself, which is already where it is`)\n			end\n\n			-- Picking a thing up is not an answer, so a Carry is answered at its\n			-- destination. Every other verb is answered at the thing itself.\n			local trigger = if to ~= nil then to.prop elseif at ~= nil then at.prop else HERE\n			local clash = triggers[trigger]\n			if clash ~= nil then\n				if trigger == HERE then\n					error(\n						`[AGES content] event \"{event.id}\" choices \"{clash}\" and \"{choice.id}\" are both `\n							.. `answered by standing still where you already are, which is one answer`\n					)\n				end\n				error(\n					`[AGES content] event \"{event.id}\" choices \"{clash}\" and \"{choice.id}\" are both `\n						.. `answered at \"{trigger}\"; whichever the tick reached first would win`\n				)\n			end\n			triggers[trigger] = choice.id\n\n			if at ~= nil and to ~= nil then\n				carried[at.prop] = true\n			end\n		end\n\n		-- Two Stays where one of them is given \"here\" is the trigger clash again, wearing\n		-- a disguise the trigger check cannot see through. Their triggers really are\n		-- different props, so nothing above catches it -- but a Stay with no prop is\n		-- satisfied *wherever* the player is standing, including inside the other one's\n		-- reach. A player holding still at the lamp is holding still at the lamp and\n		-- holding still in general, both accumulate, and both finish on the same tick.\n		local stayHere: string? = nil\n		local stayAt: string? = nil\n		for _, choice in event.choices do\n			local act = choice.act\n			if act == nil or act.verb ~= \"Stay\" then\n				continue\n			end\n			if act.at == nil then\n				stayHere = choice.id\n			else\n				stayAt = choice.id\n			end\n		end\n		if stayHere ~= nil and stayAt ~= nil then\n			error(\n				`[AGES content] event \"{event.id}\" answers \"{stayHere}\" by holding still anywhere `\n					.. `and \"{stayAt}\" by holding still at a prop; standing at that prop does both, `\n					.. `and whichever the tick reached first would win`\n			)\n		end\n\n		-- The carried object is the one prop the player touches without answering\n		-- anything. If some other choice is answered by touching it, picking it up to\n		-- take it somewhere would take that other answer instead, and the player would\n		-- never get as far as choosing where.\n		for propId in carried do\n			local clash = triggers[propId]\n			if clash ~= nil then\n				error(\n					`[AGES content] event \"{event.id}\" answers choice \"{clash}\" by reaching \"{propId}\", `\n						.. `which another answer picks up and carries; picking it up would take the wrong answer`\n				)\n			end\n		end\n	end\n\n	-- Reactions are all or nothing, and need a subject -- but deliberately *not*\n	-- enactment. Watching the dog come to you is worth exactly as much when you\n	-- answered on a panel, and tying the two together would mean an event silently\n	-- lost half its ending every time the dots could not be hung.\n	local reacting = 0\n	for _, choice in event.choices do\n		if choice.reaction ~= nil then\n			reacting += 1\n		end\n	end\n	if reacting > 0 then\n		if reacting < #event.choices then\n			error(\n				`[AGES content] event \"{event.id}\" gives a reaction to {reacting} of its `\n					.. `{#event.choices} choices; reactions are all or nothing`\n			)\n		end\n		if event.subject == nil then\n			error(`[AGES content] event \"{event.id}\" reacts to its choices but is not about anything`)\n		end\n	end\n\n	-- At least one answer must be free. A priced choice the player cannot afford is\n	-- refused -- on the panel and on the floor alike -- so an event whose every answer\n	-- had a price would be unanswerable to a player who could not meet the cheapest\n	-- of them, and the prompt would sit open forever with no way to clear it. Not a\n	-- balance rule but a liveness one: there has to be a way to walk away.\n	local priced = 0\n	for _, choice in event.choices do\n		if choice.cost ~= nil then\n			priced += 1\n		end\n	end\n	if priced > 0 and priced == #event.choices then\n		error(\n			`[AGES content] event \"{event.id}\" puts a price on all {priced} of its choices; `\n				.. `at least one answer must be free, or a player with nothing cannot answer at all`\n		)\n	end\n\n	-- Flags are the one field here whose mistakes have no runtime symptom at all. A\n	-- misspelled subject spawns nothing and somebody notices; a misspelled `requires`\n	-- produces an event that is simply never selected, which is indistinguishable from\n	-- an event nobody has rolled yet. So every id is checked against the registry and\n	-- an unsatisfiable pair is refused outright.\n	Flags.AssertKnown(event.requires, `event \"{event.id}\"`)\n	Flags.AssertKnown(event.forbids, `event \"{event.id}\"`)\n	Flags.AssertSatisfiable(event.requires, event.forbids, `event \"{event.id}\"`)\n\n	-- The standing and job gates exist so a shift event can name its own unlock.\n	-- Only WorkService's moment picker reads them, so on any other delivery a gate\n	-- is writing that silently never closes -- the same dead writing as a lure on\n	-- a letter, and refused the same way. A gate that can never be met is refused\n	-- too: a floor no standing reaches means the event never fires, which at\n	-- runtime looks exactly like content nobody has rolled yet.\n	local minStanding = event.minStanding\n	if minStanding ~= nil then\n		if event.delivery ~= \"Shift\" then\n			error(\n				`[AGES content] event \"{event.id}\" gates on standing but is delivered by `\n					.. `{event.delivery}; only Shift events are ever gated`\n			)\n		end\n		local standing = Config.Work.Standing\n		if minStanding <= 0 or minStanding > standing.Max then\n			error(\n				`[AGES content] event \"{event.id}\" asks for standing {minStanding}; it must be `\n					.. `above 0 and no more than the ceiling of {standing.Max}`\n			)\n		end\n	end\n	local jobs = event.jobs\n	if jobs ~= nil then\n		if event.delivery ~= \"Shift\" then\n			error(\n				`[AGES content] event \"{event.id}\" is gated to jobs but is delivered by `\n					.. `{event.delivery}; only Shift events are ever gated`\n			)\n		end\n		for _, jobId in jobs do\n			if Jobs.ById[jobId] == nil then\n				error(`[AGES content] event \"{event.id}\" is gated to \"{jobId}\", which is not a job`)\n			end\n		end\n	end\n\n	-- writesBack is mandatory. An event that does not alter durable state is\n	-- a cutscene, and the design's named trap for this is \"Events that change\n	-- nothing\". The list names what the event actually writes: stats, flags,\n	-- ties, ribbons, standing, or money. Each name is checked against its\n	-- registry; a misspelling is a content error caught at load, not a\n	-- runtime no-op. Empty list is refused outright -- the event must write\n	-- something.\n	local writesBack = event.writesBack\n	if writesBack == nil or #writesBack == 0 then\n		error(\n			`[AGES content] event \"{event.id}\" has no writesBack; `\n				.. `every event must write at least one thing (stat, flag, tie, ribbon, standing, or money)`\n		)\n	end\n	for _, entry in writesBack do\n		-- Split \"prefix:id\" or bare \"money\".\n		local colon = string.find(entry, \":\", 1, true)\n		if colon == nil then\n			-- Bare name: only \"money\" is legal.\n			if entry ~= \"money\" then\n				error(\n					`[AGES content] event \"{event.id}\" writesBack entry \"{entry}\" `\n						.. `must be prefixed with \"stat:\", \"flag:\", \"tie:\", \"ribbon:\", or \"standing:\"`\n				)\n			end\n			continue\n		end\n		local prefix = string.sub(entry, 1, colon - 1)\n		local id = string.sub(entry, colon + 1)\n		if id == \"\" then\n			error(\n				`[AGES content] event \"{event.id}\" writesBack entry \"{entry}\" `\n					.. `has an empty id after the colon`\n			)\n		end\n		if prefix == \"stat\" then\n			-- StatName: \"health\", \"happiness\", \"smarts\", \"looks\".\n			if entry ~= \"stat:health\" and entry ~= \"stat:happiness\"\n				and entry ~= \"stat:smarts\" and entry ~= \"stat:looks\" then\n				error(\n					`[AGES content] event \"{event.id}\" writesBack stat \"{id}\", `\n						.. `which is not one of health, happiness, smarts, looks`\n				)\n			end\n		elseif prefix == \"flag\" then\n			-- Wrapped in a table because these two lines take different shapes and always\n			-- have: `Ties.AssertKnown` below checks one id, `Flags.AssertKnown` checks a\n			-- list. Passing the bare string got past `--!strict` (the parameter is an\n			-- optional table and `id` came out of `string.sub` as an `any`-shaped local)\n			-- and past the empty-list guard inside it, because `#` on a string is its\n			-- length, not zero. It died on the `for ... in`, at require time, on the boot\n			-- path -- so one mistyped argument here took the whole server down with it.\n			Flags.AssertKnown({ id }, `event \"{event.id}\" writesBack flag`)\n		elseif prefix == \"tie\" then\n			Ties.AssertKnown(id, `event \"{event.id}\" writesBack tie`)\n		elseif prefix == \"ribbon\" then\n			-- Ribbons is a flat array, not keyed. Linear scan is fine -- there\n			-- are roughly 40 entries, and this check runs once at server start.\n			local found = false\n			for _, ribbon in Ribbons do\n				if ribbon.id == id then\n					found = true\n					break\n				end\n			end\n			if not found then\n				error(\n					`[AGES content] event \"{event.id}\" writesBack ribbon \"{id}\", `\n						.. `which is not a declared ribbon`\n				)\n			end\n		elseif prefix == \"standing\" then\n			if Jobs.ById[id] == nil then\n				error(\n					`[AGES content] event \"{event.id}\" writesBack standing \"{id}\", `\n						.. `which is not a job`\n				)\n			end\n		else\n			error(\n				`[AGES content] event \"{event.id}\" writesBack entry \"{entry}\" `\n					.. `has an unknown prefix \"{prefix}\"; use stat:, flag:, tie:, ribbon:, standing:, or money`\n			)\n		end\n	end\n\n	local seenChoiceIds: { [string]: boolean } = {}\n	for _, choice in event.choices do\n		if seenChoiceIds[choice.id] then\n			error(`[AGES content] event \"{event.id}\" repeats choice id \"{choice.id}\"`)\n		end\n		seenChoiceIds[choice.id] = true\n\n		-- Whole units above zero, both directions. Zero is rejected rather than\n		-- treated as free because nil already means free and two spellings of the\n		-- same thing is how a display ends up reading \"$0\". Fractions are rejected\n		-- here rather than rounded downstream, so a price that was authored as 12.50\n		-- is a load-time error instead of a silent 12 that nobody notices.\n		local cost = choice.cost\n		if cost ~= nil and (cost <= 0 or cost ~= math.floor(cost)) then\n			error(\n				`[AGES content] event \"{event.id}\" choice \"{choice.id}\" costs {cost}; `\n					.. `a price must be a whole number above zero`\n			)\n		end\n		local payout = choice.payout\n		if payout ~= nil and (payout <= 0 or payout ~= math.floor(payout)) then\n			error(\n				`[AGES content] event \"{event.id}\" choice \"{choice.id}\" pays {payout}; `\n					.. `a payout must be a whole number above zero`\n			)\n		end\n		-- Both at once is refused rather than netted off, because only one of the two\n		-- is shown before the answer is taken: a choice that costs 50 and pays 30 would\n		-- advertise a price of 50 and be locked at a balance of 40, when what it really\n		-- asks for is 20. Author the net figure and the label can say the rest.\n		if cost ~= nil and payout ~= nil then\n			error(\n				`[AGES content] event \"{event.id}\" choice \"{choice.id}\" both costs and pays; `\n					.. `author the net figure`\n			)\n		end\n\n		-- Per the design spec: a choice that doesn't move a stat should be cut,\n		-- because it gives the player nothing to weigh. Money counts as movement --\n		-- paying for something you wanted, or being paid for an afternoon, is a real\n		-- consequence even when no stat shifts, and a purchase with a price and no\n		-- stat effect is a perfectly good choice to have to weigh.\n		-- A record counts as movement too, on the same reasoning as money: an answer\n		-- that changes nothing about you but changes what your employer thinks of you\n		-- is a real consequence and a real thing to weigh. A performance of zero\n		-- explicitly is not -- that is the spelling of \"no opinion\".\n		local movesSomething = cost ~= nil or payout ~= nil or (choice.performance ~= nil and choice.performance ~= 0)\n		if not movesSomething then\n			for _, delta in choice.effects do\n				if delta ~= 0 then\n					movesSomething = true\n					break\n				end\n			end\n		end\n		if not movesSomething then\n			error(`[AGES content] choice \"{choice.id}\" in event \"{event.id}\" moves no stat and no money`)\n		end\n\n		local where = `event \"{event.id}\" choice \"{choice.id}\"`\n		Flags.AssertKnown(choice.sets, where)\n		Flags.AssertKnown(choice.clears, where)\n		Flags.AssertNotBoth(choice.sets, choice.clears, where)\n\n		-- An event that requires a flag and whose answer sets it again could only ever\n		-- be reached by a life that already had it, so the set is dead writing -- and\n		-- dead writing in a content file reads as an intention that was carried out.\n		if choice.sets ~= nil and event.requires ~= nil then\n			for _, setId in choice.sets do\n				for _, requiredId in event.requires do\n					if setId == requiredId then\n						error(\n							`[AGES content] {where} sets flag \"{setId}\", which its own event `\n								.. `already requires; nothing could reach it without holding that flag`\n						)\n					end\n				end\n			end\n		end\n	end\nend\n\nfor _, source in SOURCES do\n	for _, event in source do\n		validate(event)\n		byId[event.id] = event\n		table.insert(all, event)\n	end\nend\n\nlocal LifeEvents = {\n	All = all,\n	ById = byId,\n}\n\nreturn LifeEvents\n"
table.insert(AGES_MANIFEST, "src/server/content/LifeEvents/init.luau")
AGES_SOURCES["src/server/content/LifeSetup.luau"] = "--!strict\n-- The rules of choosing a life: what a menu may offer, and what an answer must look like.\n--\n-- **Why this file exists at all.** The menu that picks a life moved out of the game place\n-- and into the lobby, where it belongs -- you choose who you are about to be *before* you\n-- load into a world, not on a card drawn over one already running. But three things still\n-- need these rules in the game place: the debug harness's `/setup skip`, which starts a life\n-- without a lobby, and `NameOf`/`CountryOf`, which every sentence naming a life goes through.\n-- Two copies of \"what is a valid name\" is exactly the kind of thing that drifts, so there is\n-- one copy and both places require it.\n--\n-- **Why it is here, next to Countries, rather than in `src/shared`.** It needs the country\n-- list, and that list is server-side in both places -- the client never requires it, it\n-- receives the countries it may pick inside `SetupOptions`. `Countries.luau` is mapped into\n-- the lobby by path (see `lobby.project.json`), and this file is mapped alongside it, so\n-- `script.Parent.Countries` resolves in the game place and in the lobby both. Moving either\n-- file without the other breaks that, which is why they are siblings on purpose.\n--\n-- **Everything here is checked twice on purpose.** The options payload is built from the\n-- same Config and content the validator reads, so a well-behaved menu cannot offer a spend\n-- that will then be refused -- and a badly-behaved one is refused with a reason rather than\n-- obeyed. The client is a convenience; this file is the rule.\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal TextService = game:GetService(\"TextService\")\n\nlocal Config = require(ReplicatedStorage:WaitForChild(\"Config\"))\nlocal Types = require(ReplicatedStorage:WaitForChild(\"Types\"))\n\nlocal Countries = require(script.Parent.Countries)\n\ntype Gender = Types.Gender\ntype Country = Types.Country\ntype Era = Types.Era\ntype LifeData = Types.LifeData\ntype LifeSetupData = Types.LifeSetup\ntype SetupOptions = Types.SetupOptions\ntype SetupRequest = Types.SetupRequest\ntype StatName = Types.StatName\n\nlocal SETUP = Config.Setup\n\n-- The four stats, in the order the menu draws them, written down once. `Config.Stats.\n-- Starting` is a map and map order is whatever the hash says, so a menu built by\n-- iterating it would reorder its own rows between runs.\nlocal STAT_ORDER: { StatName } = { \"health\", \"happiness\", \"smarts\", \"looks\" }\n\nlocal LifeSetup = {}\n\nLifeSetup.StatOrder = STAT_ORDER\n\n-- Every era the menu is allowed to show, including the ones it is not allowed to pick.\n-- Read straight off Config: a second list here is a second thing to keep in step.\nlocal function eras(): { Era }\n	return SETUP.Eras :: { Era }\nend\n\nlocal function eraById(id: string): Era?\n	for _, era in eras() do\n		if era.id == id then\n			return era\n		end\n	end\n	return nil\nend\n\n-- The era a menu opens on. The first *available* one rather than the first one, so that\n-- putting an unreleased era at the top of the Config list -- which is where a shiny new\n-- one wants to go -- cannot open every player's menu on a row they cannot use.\nfunction LifeSetup.DefaultEraId(): string?\n	for _, era in eras() do\n		if era.available then\n			return era.id\n		end\n	end\n	return nil\nend\n\n-- Everything the menu needs to draw itself and nothing it does not.\n--\n-- Rebuilt per call rather than cached, because it carries `lifeNumber`, which changes\n-- every death -- and a cache whose only volatile field is the one the player reads first\n-- is a cache that will be wrong in exactly the visible place.\n--\n-- Takes the account counter rather than reading it off the life, because `lifeNumber` is\n-- the one field here that is a fact about the *player* -- lives finished across every save\n-- slot -- and a life cannot know it.\nfunction LifeSetup.Options(livesLived: number): SetupOptions\n	return {\n		lifeNumber = livesLived + 1,\n		statPoints = SETUP.StatPoints,\n		minPerStat = SETUP.MinPerStat,\n		maxPerStat = SETUP.MaxPerStat,\n		maxNameLength = SETUP.MaxNameLength,\n		startingStats = Config.Stats.Starting,\n		countries = Countries.All,\n		defaultCountryId = Countries.DefaultId,\n		eras = eras(),\n	}\nend\n\n-- Trim, collapse runs of whitespace, and reject anything that is not a plain name.\n--\n-- Runs *before* TextService, because a web call per keystroke-length string of punctuation\n-- is a web call spent on something that was never going to be accepted, and because the\n-- filter's job is profanity rather than shape. Letters, spaces, apostrophes and hyphens:\n-- enough for O'Brien and Anne-Marie, and not enough for a name made of brackets.\nlocal function cleanName(raw: string): string?\n	local trimmed = string.gsub(raw, \"^%s+\", \"\")\n	trimmed = string.gsub(trimmed, \"%s+$\", \"\")\n	trimmed = string.gsub(trimmed, \"%s+\", \" \")\n	if trimmed == \"\" then\n		return nil\n	end\n	if utf8.len(trimmed) == nil then\n		-- Not valid UTF-8 at all, which no keyboard produces and every hand-rolled\n		-- packet eventually does.\n		return nil\n	end\n	local length = utf8.len(trimmed) :: number\n	if length > SETUP.MaxNameLength then\n		return nil\n	end\n	if string.match(trimmed, \"^[%a][%a%s'%-]*$\") == nil then\n		return nil\n	end\n	return trimmed\nend\n\n-- Roblox's filter, applied to a name that will be shown to other players.\n--\n-- Returns nil rather than the unfiltered text on any failure, and the caller refuses.\n-- That is the whole point: `FilterStringAsync` is a yielding web call that throws when\n-- the service is unreachable, and the tempting `pcall(...) or raw` fallback would mean an\n-- outage is also the moment the filter stops running. A player told to try again is a\n-- much smaller problem than an unfiltered name on a nameplate.\nfunction LifeSetup.FilterName(player: Player, name: string): string?\n	local ok, result = pcall(function()\n		local filtered = TextService:FilterStringAsync(name, player.UserId, Enum.TextFilterContext.PublicChat)\n		return filtered:GetNonChatStringForBroadcastAsync()\n	end)\n	if not ok or typeof(result) ~= \"string\" or result == \"\" then\n		return nil\n	end\n	return result\nend\n\n-- Read one stat delta out of whatever the client sent. Deliberately tolerant of an absent\n-- key -- a menu that left a stat alone has nothing to say about it -- and deliberately\n-- intolerant of everything else.\nlocal function readDelta(raw: any, statName: StatName): number?\n	if raw == nil then\n		return 0\n	end\n	if typeof(raw) ~= \"table\" then\n		return nil\n	end\n	local value = (raw :: { [string]: any })[statName]\n	if value == nil then\n		return 0\n	end\n	if typeof(value) ~= \"number\" or value ~= value or value % 1 ~= 0 then\n		-- NaN fails the equality test; a fraction fails the modulo. Both would otherwise\n		-- sail through a bounds check and land in a stat.\n		return nil\n	end\n	return value\nend\n\n-- Turn the payload into a request, or say in one sentence why it is not one.\n--\n-- Returns the reason as a *player-facing* string rather than a code, because the only\n-- consumer is a line of text under the Create button. A hostile client gets a sentence it\n-- has no use for, which is the correct amount of information to give it.\n--\n-- Pure: no player, no profile, no yielding. That is what lets it run in the lobby without\n-- either place needing to know the other exists.\nfunction LifeSetup.Parse(payload: any): (SetupRequest?, string?)\n	if typeof(payload) ~= \"table\" then\n		return nil, \"Something went wrong reading that. Try again.\"\n	end\n	local fields = payload :: { [string]: any }\n\n	local gender = fields.gender\n	if gender ~= \"male\" and gender ~= \"female\" then\n		return nil, \"Pick a gender to continue.\"\n	end\n\n	local countryId = fields.countryId\n	if typeof(countryId) ~= \"string\" or Countries.ById[countryId] == nil then\n		return nil, \"That country isn't one of the options.\"\n	end\n\n	local eraId = fields.eraId\n	if typeof(eraId) ~= \"string\" then\n		return nil, \"Pick an era to continue.\"\n	end\n	local era = eraById(eraId)\n	if era == nil then\n		return nil, \"That era isn't one of the options.\"\n	end\n	-- The reason locked eras are entries rather than decoration: the greying-out is the\n	-- menu being polite, and this is the game actually refusing.\n	if not era.available then\n		return nil, `{era.name} isn't ready to play yet.`\n	end\n\n	if typeof(fields.firstName) ~= \"string\" or typeof(fields.lastName) ~= \"string\" then\n		return nil, \"Enter a first and last name.\"\n	end\n	local firstName = cleanName(fields.firstName)\n	local lastName = cleanName(fields.lastName)\n	if firstName == nil or lastName == nil then\n		return nil, `Names need to be letters, up to {SETUP.MaxNameLength} characters. Try again or press Shuffle.`\n	end\n\n	local deltas: { [string]: number } = {}\n	local spent = 0\n	for _, statName in STAT_ORDER do\n		local delta = readDelta(fields.statDeltas, statName)\n		if delta == nil then\n			return nil, \"Something went wrong reading your stats. Try again.\"\n		end\n		if delta > SETUP.MaxPerStat or delta < SETUP.MinPerStat then\n			return nil, `No stat can move more than +{SETUP.MaxPerStat} or {SETUP.MinPerStat}.`\n		end\n		deltas[statName] = delta\n		spent += delta\n	end\n	-- Summed rather than counted per stat, so that taking points out of one stat really\n	-- does pay for another. Under budget is allowed and over is not: leaving points\n	-- unspent is the player's business, and the menu says how many are left.\n	if spent > SETUP.StatPoints then\n		return nil, `That spends {spent} points and you have {SETUP.StatPoints}.`\n	end\n\n	return {\n		gender = gender :: Gender,\n		firstName = firstName,\n		lastName = lastName,\n		countryId = countryId,\n		eraId = eraId,\n		statDeltas = deltas,\n	},\n		nil\nend\n\n-- A whole valid setup, rolled. Used by the debug harness to skip the menu, and by the\n-- create page's Shuffle button by way of the names it was sent.\nfunction LifeSetup.Roll(gender: Gender): LifeSetupData\n	local country = Countries.ById[Countries.DefaultId]\n	local firstName, lastName = Countries.RollName(country, gender)\n	return {\n		firstName = firstName,\n		lastName = lastName,\n		countryId = country.id,\n		eraId = LifeSetup.DefaultEraId() or \"modern\",\n	}\nend\n\n-- What the game calls this life, for anywhere a life needs naming. Falls back to the\n-- player's Roblox name rather than to an empty string, because every caller of this is\n-- putting it in a sentence.\nfunction LifeSetup.NameOf(data: LifeData, fallback: string): string\n	local setup = data.setup\n	if setup == nil then\n		return fallback\n	end\n	return `{setup.firstName} {setup.lastName}`\nend\n\n-- The country this life began in, or nil if it has not begun. Public because the debug\n-- harness and anything later that wants to vary content by country should ask for the\n-- record rather than re-look-up an id off the profile.\nfunction LifeSetup.CountryOf(data: LifeData): Country?\n	local setup = data.setup\n	if setup == nil then\n		return nil\n	end\n	return Countries.ById[setup.countryId]\nend\n\n-- The starting stats a life begins with, plus whatever the menu spent, clamped.\n--\n-- Here rather than in the service that commits, because both places commit: the lobby when\n-- a player fills a card, and the game place when `/setup skip` rolls one. The clamp is the\n-- same one StatService applies on every later change -- a menu is not allowed to put a\n-- number on a profile that the rest of the game would consider impossible.\nfunction LifeSetup.StartingStats(deltas: { [string]: number }?): Types.Stats\n	local stats: Types.Stats = table.clone(Config.Stats.Starting)\n	if deltas == nil then\n		return stats\n	end\n	for _, statName in STAT_ORDER do\n		local delta = deltas[statName]\n		if delta ~= nil and delta ~= 0 then\n			local value = stats[statName] + delta\n			stats[statName] = math.clamp(value, Config.Stats.Min, Config.Stats.Max)\n		end\n	end\n	return stats\nend\n\n-- Checked at boot rather than discovered when the first player presses Create on a card\n-- with no pickable row on it. Called by whichever service owns setup in this place.\nfunction LifeSetup.AssertPlayable()\n	if LifeSetup.DefaultEraId() == nil then\n		error(\"[AGES content] no era in Config.Setup.Eras is available, so no life could ever be started\")\n	end\nend\n\nreturn LifeSetup\n"
table.insert(AGES_MANIFEST, "src/server/content/LifeSetup.luau")
AGES_SOURCES["src/server/content/People.luau"] = "--!strict\n-- The people in a life, and what each of them is willing to do for you.\n--\n-- Four, and deliberately the four who were already in the game. These are the same ids\n-- Cast.luau has been handing to visitor events since the beginning -- the neighbor who\n-- knocks when you are nine really is the neighbor who knocks when you are forty -- and\n-- this file is what finally gives that continuity somewhere to be recorded.\n--\n-- Where they stand is chosen to spread a life across the world rather than to be tidy.\n-- Two parents at home, because home is where parents are. Mr. Alderman at the shop,\n-- because a neighbor you only ever meet at your own front door is a doorbell rather\n-- than a person -- and because the shop is where the job ladder starts, which is what\n-- makes twenty years of being decent to him worth something at the end. Rae at school,\n-- because that is where you meet the friend of a childhood.\n--\n-- Every place id here is one the world already needed. Nothing in this file asks\n-- anybody to go and tag another part in Studio, which is a deliberate constraint: a\n-- person who silently does not exist because a part was never tagged is the worst\n-- possible failure this system could have, and the cheapest way to not have it is to\n-- never ask for a part that is not already there.\n--\n-- What is deliberately not here: anybody dying. Parents run to the end of a life,\n-- which is not true and is knowingly not true. Modelling it properly needs a death of\n-- their own, an event to carry it and something to happen to the bond afterwards, and\n-- half of that would be worse than none -- a mother who quietly stopped being spawned\n-- at some threshold age is not grief, it is a bug that looks like grief.\n--\n-- What is also not here is Rae after seventeen. That one *is* a rough edge: they age\n-- out with the school years and the game says nothing about it, which reads as losing\n-- touch only if the player is feeling generous. It wants a line at the end of the last\n-- school year and does not have one yet.\n--\n-- Four is no longer everybody, though. The town -- content/Townsfolk.luau -- generates a\n-- population of strangers and they are appended to this list at the bottom of the file,\n-- through the same validator. That is deliberate and it is the cheap part of having a\n-- town at all: a generated person is a Person, so bonds, decay, the once-a-year cap, the\n-- offer fan and the odds on an ask are all already written for them. Nothing below this\n-- line knows the difference, and the only thing anywhere that does is PeopleService,\n-- which gives the town bodies on approach and the four bodies always.\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal Config = require(ReplicatedStorage:WaitForChild(\"Config\"))\nlocal Types = require(ReplicatedStorage:WaitForChild(\"Types\"))\n\nlocal Cast = require(script.Parent.Cast)\nlocal Flags = require(script.Parent.Flags)\nlocal Ties = require(script.Parent.Ties)\nlocal Townsfolk = require(script.Parent.Townsfolk)\n\ntype Person = Types.Person\ntype PersonOffer = Types.PersonOffer\ntype StatName = Types.StatName\ntype FlagSet = Types.FlagSet\n\nlocal PEOPLE = Config.People\n-- The bond an offer must ask for to count as always available. Named rather than\n-- written out at each use, because the coverage check below turns on it: an offer at\n-- this level is one nobody can ever be too estranged to be given.\nlocal ALWAYS = PEOPLE.MinBond\n\nlocal VALID_STATS: { [string]: boolean } = {\n	health = true,\n	happiness = true,\n	smarts = true,\n	looks = true,\n}\n\nlocal SOURCE: { Person } = {\n	{\n		id = \"mom\",\n		castId = \"mom\",\n		placeId = \"home\",\n		minAge = 0,\n		maxAge = 999,\n		-- Late twenties when you were born, which is the most ordinary answer there is and\n		-- therefore the right one for the person the game has said the least about.\n		ageOffset = 28,\n		-- Starts warmest of the four. A mother is not somebody a life has to get to know,\n		-- and opening at nothing would have the game's first minute quietly claiming that\n		-- she is a stranger. High enough that \"friendly\" is where a life begins and the\n		-- first band above it is within a few visits, low enough that the top of the\n		-- range is still most of a childhood away.\n		startingBond = 35,\n		busyLine = \"Not now, love -- I've got my hands full. Come and find me another day.\",\n		offers = {\n			{\n				-- The universal small talk. Written first of every person's offers because\n				-- the panel sorts by what an offer asks of the bond and throws the tail away:\n				-- at the bottom of the range, where nothing else is left, this is the row\n				-- somebody still has -- the quiet year, the person who keeps showing up.\n				id = \"small_talk\",\n				label = \"Talk about nothing in particular\",\n				minAge = 5,\n				maxAge = 999,\n				minBond = ALWAYS,\n				bond = 1,\n				stats = { happiness = 2 },\n				line = \"Oh, nothing needs saying to me. I like the quiet company.\",\n			},\n			{\n				id = \"snub\",\n				label = \"Snub them\",\n				minAge = 10,\n				maxAge = 999,\n				minBond = ALWAYS,\n				maxBond = -5,\n				bond = -5,\n				line = \"...I see. We'll leave it there, then.\",\n			},\n			{\n				id = \"cold_shoulder\",\n				label = \"Give them the cold shoulder\",\n				minAge = 10,\n				maxAge = 999,\n				minBond = ALWAYS,\n				maxBond = -5,\n				bond = -7,\n				line = \"Right. Well. I won't keep you.\",\n			},\n			{\n				-- The apology, and the whole reason enemies are not a dead end. An ask,\n				-- because at the bottom of the range the refusal odds genuinely read as a\n				-- long shot -- which is exactly what an apology to somebody you have spent\n				-- years souring should feel like. At maxBond = -1 it is on the floor the\n				-- whole way the relationship is negative, not only at sworn-enemy depth.\n				id = \"make_right\",\n				label = \"Try to make it right\",\n				minAge = 10,\n				maxAge = 999,\n				minBond = ALWAYS,\n				maxBond = -1,\n				bond = 8,\n				ask = true,\n				line = \"That's all I wanted to hear. Come here, then.\",\n				refusedLine = \"Love, I don't think sorry covers it yet. Give it time.\",\n			},\n			{\n				-- The companion walk. The walk is the content, so nothing else rides on it\n				-- -- no stats, no money, just a little bond for the company. An ask, because\n				-- asking somebody to come with you is exactly the kind of thing that can be\n				-- turned down.\n				id = \"walks_shop\",\n				label = \"Come to the shop with me\",\n				minAge = 16,\n				maxAge = 999,\n				minBond = 25,\n				bond = 3,\n				ask = true,\n				line = \"That'd be nice. Let me get my coat.\",\n				refusedLine = \"Not today, love. I've got your father's tea on.\",\n				walksTo = \"store\",\n				arrivalLine = \"Well, here we are then. A lovely bit of company for the walk.\",\n			},\n			{\n				id = \"walks_school\",\n				label = \"Walk me to school\",\n				minAge = 5,\n				maxAge = 11,\n				minBond = 20,\n				bond = 3,\n				ask = true,\n				line = \"Of course. Coat on -- it'll be nippy by the gate.\",\n				refusedLine = \"Not this morning, love. You'll be fine on your own.\",\n				walksTo = \"school\",\n				arrivalLine = \"Here we are. In you go -- make it count.\",\n			},\n			{\n				id = \"mom_held\",\n				label = \"Put your arms up\",\n				minAge = 0,\n				maxAge = 4,\n				minBond = ALWAYS,\n				bond = 4,\n				stats = { happiness = 3 },\n				line = \"Come here, you. Up we go.\",\n			},\n			{\n				id = \"mom_hug\",\n				label = \"Give her a hug\",\n				minAge = 3,\n				maxAge = 12,\n				minBond = ALWAYS,\n				bond = 3,\n				stats = { happiness = 2 },\n				line = \"Oh, that's the best thing that's happened all day.\",\n			},\n			{\n				id = \"mom_hello\",\n				label = \"Say hello\",\n				minAge = 13,\n				maxAge = 999,\n				minBond = ALWAYS,\n				bond = 2,\n				stats = { happiness = 1 },\n				line = \"Hello, you. Sit down, you look worn out.\",\n			},\n			{\n				id = \"mom_show\",\n				label = \"Show her what you found\",\n				minAge = 2,\n				maxAge = 9,\n				minBond = ALWAYS,\n				bond = 3,\n				stats = { happiness = 2 },\n				line = \"Well, would you look at that. We'd better put it somewhere safe.\",\n			},\n			{\n				-- The first offer in the game that costs the player something they want in\n				-- exchange for something a person wants. Doing the washing up is not fun and\n				-- the happiness figure says so; it buys more bond than anything else at this\n				-- age, and that trade is the whole system in one pad.\n				id = \"mom_dishes\",\n				label = \"Help with the washing up\",\n				minAge = 7,\n				maxAge = 17,\n				minBond = ALWAYS,\n				bond = 5,\n				stats = { happiness = -1 },\n				line = \"You didn't have to do that. Thank you, sweetheart.\",\n			},\n			{\n				id = \"mom_school\",\n				label = \"Tell her about school\",\n				minAge = 6,\n				maxAge = 17,\n				minBond = 0,\n				bond = 4,\n				stats = { happiness = 1, smarts = 1 },\n				line = \"Is that right? And what did you say back?\",\n			},\n			{\n				-- Venting genuinely does feel better, so it genuinely pays happiness -- and\n				-- it costs more bond than any other single pad in the file. A negative offer\n				-- that bought nothing would be a trap rather than a choice, and no pad in\n				-- this game is allowed to be a trap.\n				id = \"mom_argue\",\n				label = \"Argue about nothing\",\n				minAge = 12,\n				maxAge = 19,\n				minBond = ALWAYS,\n				bond = -6,\n				stats = { happiness = 2 },\n				line = \"Fine. Fine! Go on up to your room, then.\",\n			},\n			{\n				id = \"mom_advice\",\n				label = \"Ask her what she would do\",\n				minAge = 16,\n				maxAge = 999,\n				minBond = 20,\n				bond = 3,\n				stats = { smarts = 2 },\n				line = \"I'd sleep on it. Things look different in the morning, they really do.\",\n			},\n			{\n				id = \"mom_loan\",\n				label = \"Ask her for money\",\n				minAge = 16,\n				maxAge = 999,\n				minBond = 45,\n				bond = -2,\n				money = 300,\n				line = \"Don't tell your father. Pay me back when you've got it.\",\n				ask = true,\n				refusedLine = \"Not this month, love. I'm sorry. Ask me again after payday.\",\n			},\n			{\n				-- Requires something that happened at a different door. The neighbor made\n				-- the call; she is the one who wants to hear about it, and she cannot want\n				-- to hear about it until it happened. This is the shape the whole flag\n				-- system exists for -- one person's answer changing what another person has\n				-- to say -- and it is here in the smallest possible form, so the shape is\n				-- exercised by the game rather than only described by a type.\n				id = \"mom_the_word\",\n				label = \"Tell her about the phone call\",\n				minAge = 15,\n				maxAge = 999,\n				minBond = 20,\n				bond = 4,\n				stats = { happiness = 3 },\n				requires = { \"had_a_word_put_in\" },\n				line = \"He did that for you? Oh, that's -- that's a good man, that is.\",\n			},\n			{\n				id = \"mom_sit\",\n				label = \"Sit with her a while\",\n				minAge = 25,\n				maxAge = 999,\n				minBond = 45,\n				bond = 5,\n				stats = { happiness = 3 },\n				line = \"You don't have to say anything. It's nice just having you here.\",\n			},\n			-- Only while she knows you're poorly. The sick flag is set by events and\n			-- cleared at the next birthday, so this row is the game noticing a state it\n			-- set itself -- a mother who fusses, and only then. Even a child who has let\n			-- the bond rot is still somebody's child when they're ill.\n			{\n				id = \"mom_look_after\",\n				label = \"Let her fuss over you\",\n				minAge = 13,\n				maxAge = 999,\n				minBond = ALWAYS,\n				bond = 3,\n				stats = { happiness = 3, health = 2 },\n				requires = { \"sick\" },\n				line = \"Sit down, sit down. I've got the honey out. You look dreadful.\",\n			},\n			-- The first years away from home, in one tight window: too old to live here\n			-- and too new to where they are to have stopped reaching back. A phone call\n			-- that makes the distance stop mattering for an hour.\n			{\n				id = \"mom_empty_nest\",\n				label = \"Ring her from the new place\",\n				minAge = 18,\n				maxAge = 24,\n				minBond = 35,\n				bond = 4,\n				stats = { happiness = 3 },\n				line = \"Oh, it's you! I was just thinking about you. Tell me everything -- no, wait. The food first.\",\n			},\n			-- The other half of the flag pair. Owning up to breaking something buys her\n			-- pride in you; hiding it buys her quiet disappointment -- a row that is only\n			-- ever on the floor because the player chose the hiding answer, which is the\n			-- flag system doing what it is for.\n			{\n				id = \"mom_broke_hid\",\n				label = \"Show her the thing you hid\",\n				minAge = 6,\n				maxAge = 12,\n				minBond = ALWAYS,\n				bond = -2,\n				stats = { happiness = -1 },\n				requires = { \"broke_it_hid_it\" },\n				line = \"Oh, love. I know. I've known since Tuesday. Let's just... put it right, shall we?\",\n			},\n		},\n		-- Mom is never on the tie ladder -- she doesn't need it, she's family before the\n		-- game ever asks -- so her contextual lines never key off a tie, only off where\n		-- the player's life actually is: still at school, working, or just walking in.\n		contextualLines = {\n			unemployed = {\n				\"You're still my baby, whatever they say about you at school.\",\n				\"No rush finding your feet. I didn't either, at your age.\",\n			},\n			onShift = {\n				\"Working hard? Don't forget to eat something today.\",\n				\"I don't ask what they pay you. I just hope they're kind about it.\",\n			},\n			morning = {\n				\"There you are. Come here a second.\",\n				\"You look like yourself again today. Good.\",\n				\"I was just thinking about you, funny that.\",\n			},\n			atHome = {\n				\"This house is quieter with you in it, you know.\",\n				\"Kettle's on, if you want it.\",\n			},\n		},\n		memoryIntro = \"You remember, don't you, love --\",\n	},\n	{\n		id = \"dad\",\n		castId = \"dad\",\n		placeId = \"home\",\n		minAge = 0,\n		maxAge = 999,\n		-- Three years on your mother, which is nothing anybody will ever notice and is\n		-- there because two parents born in the same year is the kind of tidiness a\n		-- generated world has and a real one does not.\n		ageOffset = 31,\n		startingBond = 30,\n		busyLine = \"Not just now -- I'm in the middle of something. Catch me another time.\",\n		offers = {\n			{\n				id = \"small_talk\",\n				label = \"Talk about nothing in particular\",\n				minAge = 5,\n				maxAge = 999,\n				minBond = ALWAYS,\n				bond = 1,\n				stats = { happiness = 2 },\n				line = \"Sometimes it's nice to just sit and say nowt.\",\n			},\n			{\n				id = \"snub\",\n				label = \"Snub them\",\n				minAge = 10,\n				maxAge = 999,\n				minBond = ALWAYS,\n				maxBond = -5,\n				bond = -5,\n				line = \"...Fine. I can take a hint.\",\n			},\n			{\n				id = \"cold_shoulder\",\n				label = \"Give them the cold shoulder\",\n				minAge = 10,\n				maxAge = 999,\n				minBond = ALWAYS,\n				maxBond = -5,\n				bond = -7,\n				line = \"Right. Well. Enjoy your walk.\",\n			},\n			{\n				id = \"make_right\",\n				label = \"Try to make it right\",\n				minAge = 10,\n				maxAge = 999,\n				minBond = ALWAYS,\n				maxBond = -1,\n				bond = 8,\n				ask = true,\n				line = \"That's my boy. Water under the bridge.\",\n				refusedLine = \"Not yet, son. You hurt me there, and I mean that.\",\n			},\n			{\n				id = \"walks_shop\",\n				label = \"Come to the shop with me\",\n				minAge = 16,\n				maxAge = 999,\n				minBond = 25,\n				bond = 3,\n				ask = true,\n				line = \"Aye, alright. Let me grab my coat.\",\n				refusedLine = \"I'm mid-fix on this. Rain check?\",\n				walksTo = \"store\",\n				arrivalLine = \"There we are, then. Good walk that was.\",\n			},\n			{\n				id = \"walks_crossing\",\n				label = \"Walk me to the crossing\",\n				minAge = 5,\n				maxAge = 12,\n				minBond = 20,\n				bond = 3,\n				ask = true,\n				line = \"Aye, come on then. Hold on tight at the lights.\",\n				refusedLine = \"Not now, love -- I'm right in the middle of this.\",\n				walksTo = \"crossing\",\n				arrivalLine = \"There's the lights. Straight across and mind the gap.\",\n			},\n			{\n				id = \"dad_carry\",\n				label = \"Get carried around\",\n				minAge = 0,\n				maxAge = 4,\n				minBond = ALWAYS,\n				bond = 4,\n				stats = { happiness = 3 },\n				line = \"Right then. One lap of the house and that's your lot.\",\n			},\n			{\n				id = \"dad_climb\",\n				label = \"Climb on him\",\n				minAge = 3,\n				maxAge = 9,\n				minBond = ALWAYS,\n				bond = 4,\n				stats = { happiness = 3 },\n				line = \"Oof. You're getting heavy, you know that?\",\n			},\n			{\n				id = \"dad_hello\",\n				label = \"Say hello\",\n				minAge = 10,\n				maxAge = 999,\n				minBond = ALWAYS,\n				bond = 2,\n				stats = { happiness = 1 },\n				line = \"There you are. Pull up a chair, I'm not doing anything important.\",\n			},\n			{\n				id = \"dad_how\",\n				label = \"Ask him how something works\",\n				minAge = 5,\n				maxAge = 14,\n				minBond = ALWAYS,\n				bond = 3,\n				stats = { smarts = 2 },\n				line = \"Right. So. You see this bit here -- that's the bit that does the work.\",\n			},\n			{\n				id = \"dad_car\",\n				label = \"Help him fix the car\",\n				minAge = 10,\n				maxAge = 17,\n				minBond = 20,\n				bond = 5,\n				stats = { smarts = 1, happiness = -1 },\n				line = \"Pass me the ten mil. No, the -- that's the one. Good.\",\n			},\n			{\n				id = \"dad_day\",\n				label = \"Ask about his day\",\n				minAge = 12,\n				maxAge = 999,\n				minBond = 0,\n				bond = 4,\n				stats = { happiness = 1 },\n				line = \"Same as every day. Long. Ask me again tomorrow, it'll be the same.\",\n			},\n			{\n				id = \"dad_loan\",\n				label = \"Ask him for money\",\n				minAge = 16,\n				maxAge = 999,\n				minBond = 45,\n				bond = -2,\n				money = 300,\n				line = \"Here. Don't make a habit of it, and don't tell your mother.\",\n				ask = true,\n				refusedLine = \"I haven't got it. I'd give it you if I had it, but I haven't.\",\n			},\n			{\n				id = \"dad_pint\",\n				label = \"Sit and put the world right\",\n				minAge = 21,\n				maxAge = 999,\n				minBond = 45,\n				bond = 5,\n				stats = { happiness = 3 },\n				line = \"See, that's what I've been saying for years. Nobody listens.\",\n			},\n			-- Owning up to breaking something is the one childhood choice this game\n			-- outright rewards, and here is the reward arriving through a person instead\n			-- of through a stat: the version of your father who knows you told the truth.\n			{\n				id = \"dad_broke_up\",\n				label = \"Tell him you owned up\",\n				minAge = 6,\n				maxAge = 14,\n				minBond = 20,\n				bond = 4,\n				stats = { smarts = 1 },\n				requires = { \"broke_it_owned_up\" },\n				line = \"Good. That's the hard part, and you did it. I'm proud of you -- put it on the shelf, we'll fix it Saturday.\",\n			},\n			-- The narrow years when you're old enough to ask and still young enough that\n			-- the answer is yes. Driving lessons cost money; a father costs nothing but\n			-- patience, and he has some left.\n			{\n				id = \"dad_drive\",\n				label = \"Ask him to teach you to drive\",\n				minAge = 17,\n				maxAge = 19,\n				minBond = 30,\n				bond = 3,\n				stats = { smarts = 2 },\n				line = \"Right then. Clutch down -- gently, gently. That's the one. No, that was the brake. We'll go again.\",\n			},\n			-- The dog event set one of two flags; this is the one that made him proud.\n			-- A small deed carried by a father: the player knelt to a strange dog at six\n			-- and his dad is still quietly pleased about it years later.\n			{\n				id = \"dad_the_dog\",\n				label = \"Tell him about the dog\",\n				minAge = 6,\n				maxAge = 14,\n				minBond = 20,\n				bond = 4,\n				stats = { happiness = 2 },\n				requires = { \"dog_loved\" },\n				line = \"You know what I'd have done at your age? I'd have run a mile. You didn't. That's the difference between us and there's nothing wrong with that.\",\n			},\n		},\n		-- Dad's whole voice is understatement -- everything he means lands sideways, in\n		-- half a sentence about the shed or the car, never straight at the thing itself.\n		-- Also never on the tie ladder, for the same reason mom isn't.\n		contextualLines = {\n			unemployed = {\n				\"No hurry. Nobody's handed me a manual either, and I'm forty-odd.\",\n				\"You'll land on something. You usually do, once you stop overthinking it.\",\n			},\n			onShift = {\n				\"Good, is it? The work.\",\n				\"Long day, that. Don't let them work you past sense.\",\n			},\n			morning = {\n				\"Alright.\",\n				\"You're up. Good. Wanted a word, actually -- nothing, forget it, later.\",\n				\"Kettle's just gone. Sit down a minute.\",\n			},\n			atHome = {\n				\"Roof's not leaking, car's not broken, you're home. Good day, that.\",\n				\"Don't mind me, I'm just pottering.\",\n			},\n		},\n		memoryIntro = \"I still think about that, you know --\",\n	},\n	{\n		id = \"neighbor\",\n		castId = \"neighbor\",\n		placeId = \"store\",\n		-- Six rather than nought, because this is somebody a life meets rather than is\n		-- born to, and a toddler does not have a relationship with a man at the shop.\n		minAge = 6,\n		maxAge = 999,\n		-- Old enough when you meet him to already have had the forty years at the shop he\n		-- talks about, which is the one fact his whole voice rests on. Also the person\n		-- Config.Town.OldestShownAge exists for: a life that runs long enough eventually\n		-- stands next to a man the arithmetic says is a hundred and twenty, because\n		-- nothing in AGES dies of old age yet.\n		ageOffset = 45,\n		-- Nothing. He is the only person in the file you start out not knowing, which is\n		-- what makes him the one whose bond is unarguably yours: everything it ever\n		-- reaches was put there by turning up.\n		startingBond = 0,\n		busyLine = \"Another time -- I'm on my way somewhere. Good to see you though.\",\n		offers = {\n			{\n				id = \"small_talk\",\n				label = \"Talk about nothing in particular\",\n				minAge = 6,\n				maxAge = 999,\n				minBond = ALWAYS,\n				bond = 1,\n				stats = { happiness = 2 },\n				line = \"And how's the world treating you, eh?\",\n			},\n			{\n				id = \"snub\",\n				label = \"Snub them\",\n				minAge = 10,\n				maxAge = 999,\n				minBond = ALWAYS,\n				maxBond = -5,\n				bond = -5,\n				line = \"...Right. I'll not take any more of your time.\",\n			},\n			{\n				id = \"cold_shoulder\",\n				label = \"Give them the cold shoulder\",\n				minAge = 10,\n				maxAge = 999,\n				minBond = ALWAYS,\n				maxBond = -5,\n				bond = -7,\n				line = \"Suit yourself. I've got a shop to mind.\",\n			},\n			{\n				id = \"make_right\",\n				label = \"Try to make it right\",\n				minAge = 10,\n				maxAge = 999,\n				minBond = ALWAYS,\n				maxBond = -1,\n				bond = 8,\n				ask = true,\n				line = \"We all say things. Water under the bridge, eh?\",\n				refusedLine = \"Well. That one's going to take a bit more than an apology, I think.\",\n			},\n			{\n				id = \"walks_shop\",\n				label = \"Come to the shop with me\",\n				minAge = 16,\n				maxAge = 999,\n				minBond = 25,\n				bond = 3,\n				ask = true,\n				line = \"Happy to walk you over. I was heading that way anyway.\",\n				refusedLine = \"Can't today -- stock's in. Another time.\",\n				walksTo = \"store\",\n				arrivalLine = \"Here we are. I'll tell the lad you're a regular.\",\n			},\n			{\n				id = \"walks_gate\",\n				label = \"Walk me to the gate\",\n				minAge = 6,\n				maxAge = 999,\n				minBond = 20,\n				bond = 3,\n				ask = true,\n				line = \"Course I will. I was going that way anyhow.\",\n				refusedLine = \"Not today -- I've got a pot on and the door's unlocked.\",\n				walksTo = \"gate\",\n				arrivalLine = \"There's your gate. I'll not come further in case the dog's out.\",\n			},\n			{\n				id = \"nb_hello\",\n				label = \"Say hello\",\n				minAge = 6,\n				maxAge = 999,\n				minBond = ALWAYS,\n				bond = 2,\n				stats = { happiness = 1 },\n				line = \"Hello there. Keeping out of trouble, are we?\",\n			},\n			{\n				id = \"nb_bags\",\n				label = \"Carry his bags out\",\n				minAge = 8,\n				maxAge = 999,\n				minBond = ALWAYS,\n				bond = 5,\n				stats = { happiness = -1 },\n				line = \"That's very good of you. Very good of you indeed.\",\n			},\n			{\n				id = \"nb_story\",\n				label = \"Listen to one of his stories\",\n				minAge = 6,\n				maxAge = 999,\n				minBond = 0,\n				bond = 4,\n				stats = { smarts = 1, happiness = 1 },\n				line = \"-- and that, I can tell you, was the last time I ever went near a horse.\",\n			},\n			{\n				id = \"nb_shop\",\n				label = \"Ask him about the shop\",\n				minAge = 14,\n				maxAge = 999,\n				minBond = 20,\n				bond = 3,\n				stats = { smarts = 1 },\n				line = \"Forty years I've been coming here. I know everyone worth knowing.\",\n			},\n			{\n				-- The rung, and the only one he has. A neighbor is not going to become your\n				-- closest friend and it would cheapen the word if he could -- what he can\n				-- become is somebody who knows you, which is the entire currency of the\n				-- offer below.\n				id = \"nb_known\",\n				label = \"Tell him who you are\",\n				minAge = 6,\n				maxAge = 999,\n				minBond = 15,\n				bond = 4,\n				stats = { happiness = 1 },\n				gives = \"known\",\n				line = \"I know the house. I never knew the face went with it. Well, now I do.\",\n			},\n			{\n				-- The pad that tells the player what the last twenty years were for. It does\n				-- nothing on its own -- no money, no stat, barely any bond -- because the\n				-- thing it is about has already happened: the office reads the bond itself.\n				-- This is him saying so out loud, once, so the payoff is not a door that\n				-- silently stopped being locked.\n				--\n				-- Gated on the rung as well as the bond, because his refusal line has been\n				-- saying exactly this since before there was a system for it: he will not\n				-- put his name to somebody he does not know. A man who would make that call\n				-- for a stranger with a high bond is not a reference, he is a lever.\n				id = \"nb_word\",\n				label = \"Ask if he knows anyone\",\n				minAge = 15,\n				maxAge = 999,\n				minBond = 45,\n				bond = 1,\n				needsTie = \"known\",\n				-- Set on the yes only, which is the whole reason the favour is worth\n				-- asking for rather than worth having: a call that was not made is not a\n				-- call, and the flag is the record of one that was.\n				sets = { \"had_a_word_put_in\" },\n				line = \"For you? I'll make a call. They know me up at that office.\",\n				ask = true,\n				refusedLine = \"I'd have to know you a bit better before I put my name to it.\",\n			},\n			-- The nervous side of the bond range, at the positive end. Below \"friendly\"\n			-- he is a man you nod at rather than talk to, and the moment the bond crosses\n			-- 19 this row is gone -- the arc is written into the gate itself. A player who\n			-- only ever waves never learns the man.\n			{\n				id = \"nb_wave\",\n				label = \"Give him a small wave across the shop\",\n				minAge = 6,\n				maxAge = 999,\n				minBond = ALWAYS,\n				maxBond = 19,\n				bond = 1,\n				line = \"He looks up, nods, and goes back to the till. You both know the score.\",\n			},\n			-- Trust enough to be let behind the counter. The shop closes and the man\n			-- who never learned your name is handing you the till float -- which is what\n			-- twenty years of turning up actually bought.\n			{\n				id = \"nb_close_up\",\n				label = \"Stay and help him close up\",\n				minAge = 16,\n				maxAge = 999,\n				minBond = 35,\n				bond = 4,\n				stats = { smarts = 1, happiness = -1 },\n				line = \"You're a good 'un, you are. Right -- tills, floor, float, and I'll see you Wednesday.\",\n			},\n		},\n		-- Alderman is the one member of the four with a tie to earn -- he starts at zero\n		-- and the \"known\" key is what a shopkeeper sounds like once forty years of turning\n		-- up has actually landed on him. Before that he is warm in the generic, professional\n		-- way a good shopkeeper is warm to everyone, which is why the situational lines below\n		-- read a little more distant than mom's or dad's.\n		contextualLines = {\n			known = {\n				\"Forty years behind that counter and you still turn up. Says something, that.\",\n				\"You're one of mine now, you know. Don't tell the others.\",\n			},\n			unemployed = {\n				\"Plenty of time yet. I didn't know what I was at your age either.\",\n				\"School's the job for now. Rest of it can wait.\",\n			},\n			onShift = {\n				\"Keeping busy, are you? Good. Idle hands and all that.\",\n				\"Whoever's got you working, tell them Alderman says be decent about it.\",\n			},\n			morning = {\n				\"Morning to you. Mind the step, they've only just mopped it.\",\n				\"And how's the world treating you, eh?\",\n				\"Just the one today, or are you stopping to talk my ear off?\",\n			},\n			atHome = {\n				\"Give my best to the house, won't you.\",\n			},\n		},\n		memoryIntro = \"Ah, now -- I remember it well --\",\n	},\n	{\n		id = \"friend\",\n		castId = \"friend\",\n		placeId = \"school\",\n		minAge = 6,\n		maxAge = 17,\n		-- Your age exactly, which is what a schoolfriend is and the only reason the two of\n		-- you were ever put in the same room.\n		ageOffset = 0,\n		-- A little warmth to begin with, because you are six and so are they and that is\n		-- all it takes.\n		startingBond = 10,\n		busyLine = \"Can't right now! Later, yeah?\",\n		offers = {\n			{\n				id = \"small_talk\",\n				label = \"Talk about nothing in particular\",\n				minAge = 6,\n				maxAge = 17,\n				minBond = ALWAYS,\n				bond = 1,\n				stats = { happiness = 2 },\n				line = \"Just us again, like always.\",\n			},\n			{\n				id = \"snub\",\n				label = \"Snub them\",\n				minAge = 10,\n				maxAge = 17,\n				minBond = ALWAYS,\n				maxBond = -5,\n				bond = -5,\n				line = \"...Wow. Okay.\",\n			},\n			{\n				id = \"cold_shoulder\",\n				label = \"Give them the cold shoulder\",\n				minAge = 10,\n				maxAge = 17,\n				minBond = ALWAYS,\n				maxBond = -5,\n				bond = -7,\n				line = \"Oh. I thought we were... yeah. Fine.\",\n			},\n			{\n				id = \"make_right\",\n				label = \"Try to make it right\",\n				minAge = 10,\n				maxAge = 17,\n				minBond = ALWAYS,\n				maxBond = -1,\n				bond = 8,\n				ask = true,\n				line = \"I was hoping you'd say that. Forgiven.\",\n				refusedLine = \"I don't know, man. That really hurt.\",\n			},\n			{\n				id = \"walks_shop\",\n				label = \"Come to the shop with me\",\n				minAge = 16,\n				maxAge = 17,\n				minBond = 25,\n				bond = 3,\n				ask = true,\n				line = \"Yeah! Let's go. I'll race you.\",\n				refusedLine = \"Can't -- detention. Talk at lunch, yeah?\",\n				walksTo = \"store\",\n				arrivalLine = \"Made it! See, that wasn't so hard.\",\n			},\n			{\n				id = \"walks_crossing\",\n				label = \"Walk to the crossing with me\",\n				minAge = 6,\n				maxAge = 12,\n				minBond = 20,\n				bond = 3,\n				ask = true,\n				line = \"Yeah! Last one to the crossing buys the sweets.\",\n				refusedLine = \"Can't -- my mum said straight home today.\",\n				walksTo = \"crossing\",\n				arrivalLine = \"Beat you! Right, cross on the green.\",\n			},\n			{\n				id = \"rae_hi\",\n				label = \"Say hi\",\n				minAge = 6,\n				maxAge = 17,\n				minBond = ALWAYS,\n				bond = 2,\n				stats = { happiness = 1 },\n				line = \"Hey! Sit here, I saved you a spot.\",\n			},\n			{\n				id = \"rae_lunch\",\n				label = \"Share your lunch\",\n				minAge = 6,\n				maxAge = 13,\n				minBond = ALWAYS,\n				bond = 5,\n				stats = { happiness = 1 },\n				line = \"You're the best. I forgot mine again.\",\n			},\n			{\n				-- The one pad in the file with a long fuse on it. Smarts is what the office\n				-- job asks for at eighteen, so an afternoon of messing about is genuinely\n				-- fun, genuinely free, and genuinely costs you something you will not find\n				-- out about for a decade. That is the most honest thing this game says\n				-- about being fourteen.\n				id = \"rae_mess\",\n				label = \"Mess about instead of working\",\n				minAge = 8,\n				maxAge = 17,\n				minBond = ALWAYS,\n				bond = 4,\n				stats = { happiness = 3, smarts = -2 },\n				line = \"We are going to get in so much trouble. Worth it though.\",\n			},\n			{\n				id = \"rae_study\",\n				label = \"Study together\",\n				minAge = 10,\n				maxAge = 17,\n				minBond = 20,\n				bond = 3,\n				stats = { smarts = 3 },\n				line = \"Okay, but you're explaining the last one to me. Properly this time.\",\n			},\n			-- The ladder, and Rae is the one person in the game it was written backwards\n			-- from: \"the friend of a childhood\" was always the description, and until ties\n			-- existed there was nothing anywhere that could make it true rather than\n			-- implied. A schoolfriend the game never once called your friend is a\n			-- classmate with better dialogue.\n			--\n			-- No `known` rung. Rae opens at a bond of ten and says \"sit here, I saved you\n			-- a spot\" the first time you ever speak to them -- somebody who does that\n			-- already knows you, and a row offering to introduce yourself would be the\n			-- game contradicting its own first line.\n			{\n				id = \"rae_always\",\n				label = \"Make it the two of you, every day\",\n				minAge = 8,\n				maxAge = 17,\n				minBond = 35,\n				bond = 6,\n				stats = { happiness = 3 },\n				gives = \"friend\",\n				line = \"Well, obviously. Who else was it going to be?\",\n			},\n			{\n				id = \"rae_secret\",\n				label = \"Tell them something you've told nobody\",\n				minAge = 13,\n				maxAge = 17,\n				minBond = 45,\n				bond = 7,\n				stats = { happiness = 3 },\n				needsTie = \"friend\",\n				line = \"Okay. That stays with me. Obviously it does.\",\n			},\n			{\n				-- The top rung, and deliberately at the very end of the school years --\n				-- the last thing Rae has to offer, in the last year they are in the life\n				-- at all. That it lands the year before they age out is the point: this\n				-- is a promise made at exactly the moment it stops being easy to keep.\n				id = \"rae_whatever_happens\",\n				label = \"Promise it survives this place\",\n				minAge = 16,\n				maxAge = 17,\n				minBond = 70,\n				bond = 9,\n				stats = { happiness = 5 },\n				needsTie = \"friend\",\n				gives = \"closest\",\n				line = \"Then that's that. Wherever we both end up -- that's that.\",\n			},\n			{\n				-- The first pad in the game that is on the floor because of something the\n				-- player did rather than something they are old enough for, and the\n				-- clearest statement of what the flag system is for: a friendship where\n				-- one of you knows a thing about the other is a different friendship, and\n				-- this is what that looks like from the outside -- one extra option, in\n				-- front of one person, that most lives never see.\n				--\n				-- Never a floor offer. Somebody's whole visit must never depend on a flag,\n				-- or a life that did not earn it walks up to an empty patch of ground; the\n				-- content check below counts on this and refuses a floor offer that is\n				-- gated.\n				id = \"rae_show_the_gap\",\n				label = \"Show them the way out of the field\",\n				minAge = 8,\n				maxAge = 17,\n				minBond = 15,\n				bond = 8,\n				stats = { happiness = 4, smarts = -1 },\n				requires = { \"wandered_off\" },\n				line = \"How long have you known about this? How long have you KNOWN about this?\",\n			},\n			{\n				id = \"rae_the_dog\",\n				label = \"Take them to see the dog outside the shop\",\n				minAge = 8,\n				maxAge = 15,\n				minBond = 15,\n				bond = 6,\n				stats = { happiness = 3 },\n				requires = { \"dog_loved\" },\n				line = \"Okay, you were right about it. I'm still not putting my hand near it though.\",\n			},\n			-- The nervous early friendship, gone the moment it stops being necessary.\n			-- Bond shapes it: below \"friendly\" you don't yet know what to say to each\n			-- other, and the row vanishes at the top of the range -- the arc is in the\n			-- gate, not in any writing.\n			{\n				id = \"rae_quiet\",\n				label = \"Sit next to them without saying anything\",\n				minAge = 6,\n				maxAge = 12,\n				minBond = ALWAYS,\n				maxBond = 19,\n				bond = 2,\n				line = \"Neither of you says anything for a while. Then they pass you half their crisps without looking up.\",\n			},\n			-- The last school year, and the line the file's header says was missing:\n			-- Rae ages out at seventeen and the game used to let that happen without a\n			-- word. This is the word -- a row that appears exactly in the year it stops\n			-- being possible to put the question off.\n			{\n				id = \"rae_last_year\",\n				label = \"Ask what happens after school\",\n				minAge = 16,\n				maxAge = 17,\n				minBond = 25,\n				bond = 4,\n				stats = { happiness = 1, smarts = 1 },\n				line = \"Dunno. We'll figure it out. That's kind of the whole thing -- we'll figure it out together.\",\n			},\n			-- The dog event's other half. Rae shields you -- but only because you are\n			-- the one who was ever frightened, which is a flag only a frightened life\n			-- carries. The row is the game remembering a fear it set itself.\n			{\n				id = \"rae_dog_feared\",\n				label = \"Get them to stand between you and the dog\",\n				minAge = 6,\n				maxAge = 15,\n				minBond = 10,\n				bond = 6,\n				stats = { happiness = 2 },\n				requires = { \"dog_feared\" },\n				line = \"Yeah, of course. It won't come near you -- I've got it. See? All good.\",\n			},\n		},\n		-- The only one of the four who climbs the tie ladder, so the only one whose\n		-- contextual lines change shape as the relationship does -- a stranger-to-friend\n		-- schoolyard voice at \"friend\", something that sounds like it's said this before\n		-- at \"closest\". Both keyed directly off the tie id, same as any townsfolk archetype.\n		contextualLines = {\n			friend = {\n				\"Okay but did you hear what happened in class--\",\n				\"You're literally the only person I actually like here.\",\n				\"Wait, wait, come here, you have to see this.\",\n			},\n			closest = {\n				\"I don't even have to explain it to you, that's the whole point.\",\n				\"Whatever happens, this one's not going anywhere. You know that, right?\",\n			},\n			unemployed = {\n				\"School's so boring without you around at lunch.\",\n				\"Same time tomorrow? Actually don't answer that, obviously same time tomorrow.\",\n			},\n			onShift = {\n				\"Ugh, you're working again? Tell me everything after.\",\n				\"Wish you were here instead of there, ngl.\",\n			},\n			morning = {\n				\"Oh my god, finally. Where were you.\",\n				\"Okay so I saved you a seat, don't make it weird.\",\n				\"Hi! Hi. Okay, hi.\",\n			},\n			atHome = {\n				\"Wish I was there instead of home, ngl.\",\n			},\n		},\n		memoryIntro = \"Remember when --\",\n	},\n}\n\nlocal all: { Person } = {}\nlocal byId: { [string]: Person } = {}\nlocal byPlace: { [string]: { Person } } = {}\n\n-- Content mistakes are authoring bugs, not runtime conditions, so these throw at start\n-- rather than producing somebody who stands in a room with an empty floor in front of\n-- them and no way to say why.\nlocal function validateOffer(person: Person, offer: PersonOffer, seen: { [string]: boolean })\n	if seen[offer.id] then\n		error(`[AGES content] person \"{person.id}\" has two offers with id \"{offer.id}\"`)\n	end\n	seen[offer.id] = true\n\n	if offer.label == \"\" then\n		error(`[AGES content] offer \"{offer.id}\" has no label, so its pad would be blank`)\n	end\n	if #offer.label > PEOPLE.MaxLabelLength then\n		error(\n			`[AGES content] offer \"{offer.id}\" has a {#offer.label}-character label; a pad holds `\n				.. `{PEOPLE.MaxLabelLength}`\n		)\n	end\n	if offer.line == \"\" then\n		error(`[AGES content] offer \"{offer.id}\" has nothing said back, which is the point of it`)\n	end\n\n	-- Both directions, because both mistakes are silent at runtime. An ask with no\n	-- refusal line shows a blank row on the one beat the player most needs a person in\n	-- front of them; a refusal line on something that can never be refused is dead\n	-- writing that reads, to the next author, as proof this offer can be turned down.\n	local refusedLine = offer.refusedLine\n	if offer.ask then\n		if refusedLine == nil or refusedLine == \"\" then\n			error(\n				`[AGES content] offer \"{offer.id}\" is an ask, so it can be turned down, but has no `\n					.. `refusedLine -- write what they say when they say no`\n			)\n		end\n	elseif refusedLine ~= nil then\n		error(\n			`[AGES content] offer \"{offer.id}\" has a refusedLine but is not an ask, so it can never `\n				.. `be refused; set ask = true or drop the line`\n		)\n	end\n\n	if offer.minAge > offer.maxAge then\n		error(`[AGES content] offer \"{offer.id}\" starts at {offer.minAge} and ends at {offer.maxAge}`)\n	end\n	-- Inside the person's own window, or the offer is written for years they are not\n	-- there for -- which is invisible by reading either table on its own.\n	if offer.minAge < person.minAge or offer.maxAge > person.maxAge then\n		error(\n			`[AGES content] offer \"{offer.id}\" runs {offer.minAge}-{offer.maxAge} but \"{person.id}\" `\n				.. `is only around {person.minAge}-{person.maxAge}`\n		)\n	end\n\n	if offer.minBond < PEOPLE.MinBond or offer.minBond > PEOPLE.MaxBond then\n		error(\n			`[AGES content] offer \"{offer.id}\" needs a bond of {offer.minBond}, outside the range `\n				.. `{PEOPLE.MinBond}..{PEOPLE.MaxBond}, so it could never appear`\n		)\n	end\n\n	-- The upper gate, the mirror of minBond. Two ends of one window, so a pair that\n	-- reads as an empty window is caught here rather than by a panel that never fills.\n	local maxBond = offer.maxBond\n	if maxBond ~= nil then\n		if maxBond < PEOPLE.MinBond or maxBond > PEOPLE.MaxBond then\n			error(\n				`[AGES content] offer \"{offer.id}\" is gone above a bond of {maxBond}, outside the `\n					.. `range {PEOPLE.MinBond}..{PEOPLE.MaxBond}`\n			)\n		end\n		if maxBond < offer.minBond then\n			error(\n				`[AGES content] offer \"{offer.id}\" needs {offer.minBond} and is gone above {maxBond}; `\n					.. `a maxBond below its minBond is an offer nothing could ever be at`\n			)\n		end\n	end\n\n	-- A walk offer has to name a place the world can actually get to. The list it is\n	-- checked against is deliberately small and lives in Config, separate from the\n	-- world's parts -- the parts are built by the Street, and this is where a typo in\n	-- content is caught at load rather than as an offer that starts a walk to nowhere.\n	local walksTo = offer.walksTo\n	if walksTo ~= nil then\n		local known = false\n		for _, id in Config.Places.Walkable do\n			if id == walksTo then\n				known = true\n				break\n			end\n		end\n		if not known then\n			error(\n				`[AGES content] offer \"{offer.id}\" walks to \"{walksTo}\", which is not in `\n					.. `Config.Places.Walkable -- add the id there or fix the offer`\n			)\n		end\n		if offer.arrivalLine == nil or offer.arrivalLine == \"\" then\n			error(\n				`[AGES content] offer \"{offer.id}\" walks to \"{walksTo}\" but has no arrivalLine -- `\n					.. `say what they say when the place is reached`\n			)\n		end\n	elseif offer.arrivalLine ~= nil then\n		error(\n			`[AGES content] offer \"{offer.id}\" has an arrivalLine but nothing to walk to; set `\n				.. `walksTo or drop the line`\n		)\n	end\n\n	local money = offer.money\n	if money ~= nil then\n		if money ~= math.floor(money) then\n			error(`[AGES content] offer \"{offer.id}\" moves {money}; money is whole units only`)\n		end\n		-- Given, never taken, and this is a real restriction rather than a coincidence of\n		-- what happens to be written today. The panel itself is willing -- it draws a price\n		-- column and greys a row the player cannot pay for -- but PeopleService hands every\n		-- offer over with no cost and no lock, and takes one without ever reading a wallet.\n		-- So a negative figure here would not present as a price refused, it would present\n		-- as an offer that silently empties a pocket it could not reach. Charging means\n		-- pricing and gating in PeopleService first; this is where that gets said out loud.\n		if money <= 0 then\n			error(\n				`[AGES content] offer \"{offer.id}\" moves {money}; an offer can only hand money over, `\n					.. `because nothing on the people side checks the player can pay`\n			)\n		end\n		if money > PEOPLE.MaxGift then\n			error(\n				`[AGES content] offer \"{offer.id}\" gives {money}, over the {PEOPLE.MaxGift} ceiling -- `\n					.. `check for a stray zero`\n			)\n		end\n	end\n\n	local stats = offer.stats\n	if stats ~= nil then\n		for name in stats do\n			if not VALID_STATS[name] then\n				error(`[AGES content] offer \"{offer.id}\" moves \"{name}\", which is not a stat`)\n			end\n		end\n	end\n\n	local where = `person \"{person.id}\" offer \"{offer.id}\"`\n	Flags.AssertKnown(offer.requires, where)\n	Flags.AssertKnown(offer.forbids, where)\n	Flags.AssertSatisfiable(offer.requires, offer.forbids, where)\n	Flags.AssertKnown(offer.sets, where)\n	Flags.AssertKnown(offer.clears, where)\n	Flags.AssertNotBoth(offer.sets, offer.clears, where)\n\n	Ties.AssertKnown(offer.gives, where)\n	Ties.AssertKnown(offer.needsTie, where)\n\n	-- A rung has to climb. `gives` at or below what `needsTie` already guarantees is an\n	-- offer that is either invisible or does nothing, and which of the two it is depends\n	-- on a rank comparison in another file -- so it is far better refused here than\n	-- found by wondering why a panel row never appears.\n	local gives = offer.gives\n	-- \"Does the tie this row already requires get you what the row hands out?\" -- and if so\n	-- the row can never appear. Asked through `Ties.Meets` rather than as a rank comparison,\n	-- because rank 0 is shared by \"off the ladder\" and \"no tie at all\", so an offer giving\n	-- \"enemy\" from no tie read as 0 <= 0 and was rejected as a rung that fails to climb. See\n	-- `Ties.IsRung` for why naming the id \"enemy\" here instead was the wrong repair.\n	if gives ~= nil and Ties.Meets(offer.needsTie, gives) then\n		error(\n			`[AGES content] offer \"{offer.id}\" gives \"{gives}\" but already needs `\n				.. `\"{offer.needsTie}\", which already satisfies it -- the row could never appear`\n		)\n	end\n\n	-- An ask that confers a *rung* would let a refusal be the thing standing between a\n	-- player and the one relationship rung the game caps. Refused rather than resolved,\n	-- because both resolutions are bad: paying it out on a no makes the refusal cosmetic,\n	-- and withholding it makes a coin flip the gate on the scarcest thing here.\n	--\n	-- None of that is true off the ladder. \"Make them your enemy\" is done *to* somebody, and\n	-- them refusing it is the content rather than a hole in it.\n	if gives ~= nil and offer.ask and Ties.IsRung(gives) then\n		error(\n			`[AGES content] offer \"{offer.id}\" gives \"{gives}\" and is an ask; a rung that can be `\n				.. `refused would make becoming somebody's friend a coin toss`\n		)\n	end\nend\n\nlocal function validate(person: Person)\n	if byId[person.id] ~= nil then\n		error(`[AGES content] duplicate person id \"{person.id}\"`)\n	end\n	if Cast.ById[person.castId] == nil then\n		error(`[AGES content] person \"{person.id}\" is cast as \"{person.castId}\", who is not in the cast`)\n	end\n	if person.placeId == \"\" then\n		error(`[AGES content] person \"{person.id}\" names no place, so there is nowhere for them to be`)\n	end\n	if person.busyLine == \"\" then\n		error(`[AGES content] person \"{person.id}\" has no way of saying they are busy`)\n	end\n	if person.minAge > person.maxAge or person.minAge < 0 then\n		error(`[AGES content] person \"{person.id}\" is around from {person.minAge} to {person.maxAge}`)\n	end\n	if person.ageOffset ~= math.floor(person.ageOffset) then\n		error(`[AGES content] person \"{person.id}\" is {person.ageOffset} years older than you; ages are whole years`)\n	end\n	-- The one way an age offset can be wrong that reading it does not show: a person is\n	-- only ever seen from inside their own age window, so an offset is fine or not fine\n	-- relative to the youngest the player can be when they meet them. Get it wrong and\n	-- the nameplate over somebody's head says they are minus two.\n	if person.minAge + person.ageOffset < 0 then\n		error(\n			`[AGES content] person \"{person.id}\" is {person.ageOffset} years older than you and around `\n				.. `from age {person.minAge}, so they would be {person.minAge + person.ageOffset} when you meet them`\n		)\n	end\n	if person.startingBond < PEOPLE.MinBond or person.startingBond > PEOPLE.MaxBond then\n		error(\n			`[AGES content] person \"{person.id}\" starts at {person.startingBond}, outside `\n				.. `{PEOPLE.MinBond}..{PEOPLE.MaxBond}`\n		)\n	end\n	if #person.offers == 0 then\n		error(`[AGES content] person \"{person.id}\" offers nothing, so walking up to them does nothing`)\n	end\n\n	Flags.AssertKnown(person.requires, `person \"{person.id}\"`)\n	Flags.AssertKnown(person.forbids, `person \"{person.id}\"`)\n	Flags.AssertSatisfiable(person.requires, person.forbids, `person \"{person.id}\"`)\n\n	local seen: { [string]: boolean } = {}\n	-- Which offer hands out each rung, so two of them handing out the same one is caught\n	-- and so a rung nothing reaches can be.\n	local ladder: { [string]: string } = {}\n	for _, offer in person.offers do\n		validateOffer(person, offer, seen)\n		local gives = offer.gives\n		if gives ~= nil then\n			local clash = ladder[gives]\n			if clash ~= nil then\n				error(\n					`[AGES content] person \"{person.id}\" reaches \"{gives}\" from both \"{clash}\" and `\n						.. `\"{offer.id}\"; a rung is one row, or the player is shown two ways to `\n						.. `become the same thing`\n				)\n			end\n			ladder[gives] = offer.id\n		end\n	end\n\n	-- A rung nobody can stand on. `needsTie` is satisfied by that tie or anything closer,\n	-- and a tie is always a tie with one particular person -- so an offer needing \"friend\"\n	-- is dead unless *this* person is somebody you can become a friend of. Dead in the\n	-- silent way, too: a row that never appears looks exactly like a row you have not\n	-- earned yet.\n	for _, offer in person.offers do\n		local needed = offer.needsTie\n		if needed == nil then\n			continue\n		end\n		local reachable = false\n		for tieId in ladder do\n			-- The same question the runtime gate asks, asked with the same function. As a\n			-- rank comparison it called a row needing an off-ladder tie \"reachable\" the\n			-- moment this person offered *anything*, because every rank is >= 0 -- so the\n			-- one check that exists to find dead content would have certified it.\n			if Ties.Meets(tieId, needed) then\n				reachable = true\n				break\n			end\n		end\n		if not reachable then\n			error(\n				`[AGES content] person \"{person.id}\" offer \"{offer.id}\" needs \"{needed}\" but nothing `\n					.. `they offer ever reaches it, so the row can never appear`\n			)\n		end\n	end\n\n	-- The check that earns its keep. Somebody standing in a room with nothing on the\n	-- floor in front of them is the one failure of this system that looks exactly like a\n	-- bug in the pad placement, and it is only ever caused here -- by an age with no\n	-- offer written that anybody could take at any bond.\n	for age = person.minAge, person.maxAge do\n		local floor = 0\n		local labels: { [string]: string } = {}\n		for _, offer in person.offers do\n			if age < offer.minAge or age > offer.maxAge then\n				continue\n			end\n			-- Two identical labels on one floor is unreadable and cannot be seen by reading\n			-- either offer on its own, only by reading the pair at an age they share.\n			local clash = labels[offer.label]\n			if clash ~= nil then\n				error(\n					`[AGES content] person \"{person.id}\" offers \"{offer.label}\" twice at age {age} `\n						.. `(\"{clash}\" and \"{offer.id}\")`\n				)\n			end\n			labels[offer.label] = offer.id\n			-- A conditional offer does not count toward the floor however low its bond\n			-- is, because the floor's whole job is to be there for everybody and a life\n			-- that never earned the condition would find the room empty. The check would\n			-- otherwise pass on content that is broken for most players, which is worse\n			-- than no check.\n			--\n			-- A rung is conditional in both directions, and the second one is the easy\n			-- mistake to make: `needsTie` hides the row until you have climbed, and\n			-- `gives` hides it again the moment you have -- so an offer that hands out a\n			-- tie is the one kind that can be on the floor today and gone tomorrow with\n			-- nothing about the life having got worse. It must never be what somebody's\n			-- floor rests on.\n			local unconditional = offer.requires == nil\n				and offer.forbids == nil\n				and offer.gives == nil\n				and offer.needsTie == nil\n			if offer.minBond <= PEOPLE.MinBond and unconditional then\n				floor += 1\n			end\n		end\n		if floor == 0 then\n			error(\n				`[AGES content] person \"{person.id}\" has nothing at age {age} that somebody at the `\n					.. `bottom of the bond range could take; write one at minBond = MinBond`\n			)\n		end\n	end\nend\n\n-- The town, folded in behind the four. They are the same shape and they go through the\n-- same validator, which is most of why generating them is affordable at all: the floor\n-- check, the age windows, the label clashes and the gift ceiling all apply to a stranger\n-- at the shop exactly as they do to your mother, so a generator bug surfaces at server\n-- start naming the person it made rather than as an empty patch of pavement.\nfor _, person in Townsfolk.People do\n	table.insert(SOURCE, person)\nend\n\nfor _, person in SOURCE do\n	validate(person)\n	byId[person.id] = person\n	table.insert(all, person)\n	local here = byPlace[person.placeId]\n	if here == nil then\n		here = {}\n		byPlace[person.placeId] = here\n	end\n	table.insert(here, person)\nend\n\nlocal People = {}\n\nPeople.All = all\nPeople.ById = byId\n\n-- Everybody who lives at a place, whatever age they are around for. Never nil, so a\n-- caller can loop it without asking first.\nfunction People.At(placeId: string): { Person }\n	return byPlace[placeId] or {}\nend\n\n-- Whether this person is in the player's life at this age at all. The one question that\n-- decides whether they are spawned, decayed against, or listed.\n-- Flags are taken alongside age because the two say the same kind of thing -- whether\n-- this person is in your life yet -- and separating them would let one caller ask about\n-- years and another about history, which is how somebody ends up spawned in the world\n-- and absent from the listing that explains who is spawned.\nfunction People.IsAround(person: Person, age: number, flags: FlagSet): boolean\n	if age < person.minAge or age > person.maxAge then\n		return false\n	end\n	return Flags.Meets(flags, person.requires, person.forbids)\nend\n\n-- What somebody thinks of a profile, with the authored starting point already applied.\n-- Nil for a person who is not written, which the caller has to treat as \"no opinion\" --\n-- never as zero, because zero is a real bond somebody can be at.\n--\n-- Here rather than in PeopleService because the missing half of the answer is content:\n-- an absent key means nothing has ever moved this relationship, and only this file knows\n-- where a relationship opens. Takes the bonds table rather than the profile so the two\n-- systems a bond pays into -- an allowance and a job reference -- can ask without either\n-- of them having to know what a profile is.\nfunction People.BondIn(bonds: { [string]: number }, personId: string): number?\n	local person = byId[personId]\n	if person == nil then\n		return nil\n	end\n	local held = bonds[personId]\n	if held == nil then\n		return person.startingBond\n	end\n	return held\nend\n\n-- Which capped ties have no room left, given who is currently in the life.\n--\n-- The counting rule is the interesting part. A tie held by somebody whose years have\n-- passed does not hold the slot: a closest friend from school who is no longer in your\n-- life must not be the reason nobody at work can ever be one. Otherwise the single\n-- scarcest thing in the game would be spent, permanently, by an eleven-year-old -- and\n-- the player would have no way at all to find out why the row stopped appearing.\n--\n-- The tie itself is left alone either way. They are still on the record as what they\n-- were, which is the truth about a friendship you had; the slot simply reopens.\nfunction People.TieRoom(\n	ties: { [string]: string },\n	age: number,\n	flags: FlagSet\n): { [string]: boolean }\n	local held: { [string]: number } = {}\n	for personId, tieId in ties do\n		local person = byId[personId]\n		if person == nil or not People.IsAround(person, age, flags) then\n			continue\n		end\n		held[tieId] = (held[tieId] or 0) + 1\n	end\n\n	local full: { [string]: boolean } = {}\n	for _, def in Ties.All do\n		local limit = def.limit\n		if limit ~= nil and (held[def.id] or 0) >= limit then\n			full[def.id] = true\n		end\n	end\n	return full\nend\n\n-- Whether this id belongs to the generated town rather than to the four.\n--\n-- The one thing outside this file that has to be able to tell them apart, and it is not\n-- about who they are -- it is about cost. Your mother is spawned the moment you have a\n-- profile and stays; a stranger at the shop is given a body when you are near enough to\n-- see them and takes it away again when you are not. Doing that to a parent would mean a\n-- house that empties out when you walk to the far end of it.\nfunction People.IsTown(personId: string): boolean\n	return Townsfolk.IsTown[personId] == true\nend\n\n-- Which kind of townsperson somebody is, for the harness only. Nil for the four, who are\n-- not a kind of anything.\nfunction People.ArchetypeOf(personId: string): string?\n	return Townsfolk.ArchetypeOf[personId]\nend\n\n-- How old somebody is, to write over their head. Nil past Config.Town.OldestShownAge,\n-- and the nil is deliberate rather than a clamp.\n--\n-- Nobody in AGES dies of old age yet, so a life that runs to eighty stands next to a\n-- neighbor the arithmetic says is a hundred and twenty-five. A clamped number would be a\n-- lie the game had decided to tell; no number at all is the game declining to claim\n-- something it does not model. `/town` counts how many people are past it, so the hole\n-- stays visible until NPC mortality closes it properly.\nfunction People.ShownAge(person: Person, playerAge: number): number?\n	local age = playerAge + person.ageOffset\n	if age > Config.Town.OldestShownAge then\n		return nil\n	end\n	return math.max(age, 0)\nend\n\n-- What goes on the panel when somebody is clicked, best first.\n--\n-- Sorted by what the offer asks of the bond rather than shuffled, and that ordering is\n-- the mechanic rather than a tidiness choice. There are more offers written than there\n-- are rows to put them on, so the ones that need the most are the ones that get shown --\n-- which means a rising bond visibly pushes the small talk off the list and replaces it\n-- with money, comfort and favours. The player never reads a number; they watch what\n-- somebody is willing to offer them get more generous.\n--\n-- Deterministic, so the same visit shows the same panel. A once-a-year decision that\n-- reshuffled itself would be a slot machine.\n--\n-- Everything about the life that can hide or reveal a row, gathered into one argument\n-- rather than four. Assembled by PeopleService, because two of these are facts about the\n-- whole roster rather than about this person, and the content layer has no roster.\nexport type OfferContext = {\n	age: number,\n	bond: number,\n	flags: FlagSet,\n	-- What this person already is to the player, or nil.\n	tie: string?,\n	-- Tie ids that have no room left -- Ties with a `limit` already spoken for by\n	-- somebody still in the player's life. An offer that would confer one of these is\n	-- not shown, which is how \"you get one closest friend\" is enforced without ever\n	-- taking one away from the person who has it.\n	tieFull: { [string]: boolean },\n}\n\nfunction People.OffersFor(person: Person, context: OfferContext): { PersonOffer }\n	local eligible: { PersonOffer } = {}\n	for _, offer in person.offers do\n		if context.age < offer.minAge or context.age > offer.maxAge or context.bond < offer.minBond then\n			continue\n		end\n		-- The upper gate: a hostile offer is only on the floor while the relationship is\n		-- actually cold, and the apology is only on the floor while it has something to\n		-- fix. Both vanish as the bond climbs back past their maxBond, which is what makes\n		-- the damage range-shaped rather than permanent.\n		if offer.maxBond ~= nil and context.bond > offer.maxBond then\n			continue\n		end\n		if not Flags.Meets(context.flags, offer.requires, offer.forbids) then\n			continue\n		end\n		if not Ties.Meets(context.tie, offer.needsTie) then\n			continue\n		end\n		local gives = offer.gives\n		if gives ~= nil then\n			-- Something already held, with this person or with anybody. Hidden rather than\n			-- shown-and-refused, because a row offering to make somebody your friend when\n			-- they already are reads as a bug in the game rather than as a rule.\n			--\n			-- `Ties.Meets` is what \"already held\" means, and it means two different things\n			-- on purpose. On the ladder it is \"at this rung or above\", so climbing past\n			-- friend retires the friend row. Off the ladder it is \"is exactly this\", because\n			-- a fall is not a height: burning the ladder stays available from *any* rung --\n			-- closest, mentor, rival, sibling -- and is held off by bond instead\n			-- (minBond = ALWAYS, maxBond = -20), so it only surfaces once the relationship\n			-- has already been destroyed. The one thing it does retire is itself: there is\n			-- no offer to make an enemy of somebody who is already your enemy.\n			if Ties.Meets(context.tie, gives) or context.tieFull[gives] then\n				continue\n			end\n		end\n		table.insert(eligible, offer)\n	end\n\n	-- Written order, so the sort can fall back on it: two offers asking the same bond come\n	-- out in the order they were authored, which keeps the list stable between visits.\n	local order: { [string]: number } = {}\n	for index, offer in person.offers do\n		order[offer.id] = index\n	end\n	table.sort(eligible, function(a: PersonOffer, b: PersonOffer): boolean\n		-- A rung outranks everything, and this is not a tidiness choice either. There are\n		-- more offers eligible than there are rows, so the tail of the list is thrown\n		-- away -- and the one row that must never be the one thrown away is the one that\n		-- changes what two people are to each other. It happens a handful of times in a\n		-- whole life and it is the only row that cannot be had again next year.\n		local aGives = a.gives ~= nil\n		local bGives = b.gives ~= nil\n		if aGives ~= bGives then\n			return aGives\n		end\n		if a.minBond ~= b.minBond then\n			return a.minBond > b.minBond\n		end\n		return order[a.id] < order[b.id]\n	end)\n\n	local picked: { PersonOffer } = {}\n	for index = 1, math.min(PEOPLE.MaxOffers, #eligible) do\n		table.insert(picked, eligible[index])\n	end\n	return picked\nend\n\nreturn People\n"
table.insert(AGES_MANIFEST, "src/server/content/People.luau")
AGES_SOURCES["src/server/content/Police.luau"] = "--!strict\n-- The police, as bodies.\n--\n-- Deliberately not in Cast.luau, and this is the whole reason the file exists rather\n-- than five more rows over there. Cast is merged into one list that visitor events draw\n-- from -- the neighbor who knocks, the friend who calls round -- and an officer in that\n-- pool would eventually turn up at the door to offer somebody a lift to the park. They\n-- are also not Townsfolk: a townsperson is somebody you can build a bond with over forty\n-- years, and the entire point of a police officer in this game is that there is no\n-- relationship on the other end of them.\n--\n-- So they are a third kind of person, and the difference is worth naming: the cast are\n-- people you know, the town are people you could know, and these are a *function the\n-- world performs on you*. Nobody here has a history, nobody remembers the last time, and\n-- nothing you do to one of them is remembered by the next.\n--\n-- Which is why they all display the same name. Five bodies so that a manhunt is not four\n-- copies of one man walking in step, one word over every head so that no player ever\n-- starts thinking of a particular officer as a character. The variation is in the\n-- shoulders and nowhere else, because a uniform is the thing you actually see when\n-- somebody in one is coming toward you.\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Types = require(ReplicatedStorage:WaitForChild(\"Types\"))\n\ntype CastMember = Types.CastMember\n\n-- What is written over every one of them. A rank rather than a name, because a name is\n-- the first half of a relationship and there is not going to be one.\nlocal DISPLAY_NAME = \"Officer\"\n\n-- The uniform. One shirt and one pair of trousers across every body here, so that what\n-- reads at fifty studs is the uniform rather than the person in it -- which is both the\n-- honest thing and the useful one, since recognising the uniform at distance is the\n-- skill this system is actually asking for.\n--\n-- Zero until the assets exist, matching every other body in the game today. When they\n-- are made, these two numbers are the only edit: the bodies below do not change.\nlocal UNIFORM_SHIRT = 0\nlocal UNIFORM_PANTS = 0\n\n-- Five, and the number matters slightly. The top tier puts six officers in the world at\n-- once, so at five bodies a full citywide response has exactly one repeat in it -- enough\n-- variety that the street does not look cloned, not so much that anybody starts telling\n-- them apart. Adding a sixth would be fine. Adding twenty would be writing characters.\nlocal Bodies: { CastMember } = {\n	{\n		id = \"officer_a\",\n		name = DISPLAY_NAME,\n		gender = \"male\",\n		skinColor = Color3.fromRGB(224, 178, 145),\n		heightScale = 1.04,\n		widthScale = 1.06,\n		headScale = 1,\n		proportionScale = 1,\n		bodyTypeScale = 0.75,\n		shirtAssetId = UNIFORM_SHIRT,\n		pantsAssetId = UNIFORM_PANTS,\n		hairAssetId = 0,\n	},\n	{\n		id = \"officer_b\",\n		name = DISPLAY_NAME,\n		gender = \"female\",\n		skinColor = Color3.fromRGB(168, 122, 92),\n		heightScale = 0.99,\n		widthScale = 0.97,\n		headScale = 1,\n		proportionScale = 1,\n		bodyTypeScale = 0.8,\n		shirtAssetId = UNIFORM_SHIRT,\n		pantsAssetId = UNIFORM_PANTS,\n		hairAssetId = 0,\n	},\n	{\n		id = \"officer_c\",\n		name = DISPLAY_NAME,\n		gender = \"male\",\n		skinColor = Color3.fromRGB(122, 86, 62),\n		heightScale = 1.08,\n		widthScale = 1.02,\n		headScale = 1,\n		proportionScale = 1,\n		bodyTypeScale = 0.7,\n		shirtAssetId = UNIFORM_SHIRT,\n		pantsAssetId = UNIFORM_PANTS,\n		hairAssetId = 0,\n	},\n	{\n		id = \"officer_d\",\n		name = DISPLAY_NAME,\n		gender = \"female\",\n		skinColor = Color3.fromRGB(238, 205, 178),\n		heightScale = 1.01,\n		widthScale = 1.04,\n		headScale = 1,\n		proportionScale = 1,\n		bodyTypeScale = 0.85,\n		shirtAssetId = UNIFORM_SHIRT,\n		pantsAssetId = UNIFORM_PANTS,\n		hairAssetId = 0,\n	},\n	{\n		id = \"officer_e\",\n		name = DISPLAY_NAME,\n		gender = \"male\",\n		skinColor = Color3.fromRGB(196, 150, 116),\n		heightScale = 0.97,\n		widthScale = 1.09,\n		headScale = 1,\n		proportionScale = 1,\n		bodyTypeScale = 0.72,\n		shirtAssetId = UNIFORM_SHIRT,\n		pantsAssetId = UNIFORM_PANTS,\n		hairAssetId = 0,\n	},\n}\n\nif #Bodies == 0 then\n	error(\"[AGES content] there are no police bodies, so no bounty could ever be answered. Add one in content/Police.\")\nend\n\nlocal byId: { [string]: CastMember } = {}\nfor _, member in Bodies do\n	if byId[member.id] ~= nil then\n		error(`[AGES content] duplicate police body id \"{member.id}\"`)\n	end\n	-- Every one of these has to be an adult. `ageOffset` is what re-sizes a peer to the\n	-- player's own age, so an officer that carried one would be a six-year-old policeman\n	-- attending a six-year-old's burglary -- which is funny exactly once and is also the\n	-- kind of thing that ships.\n	if member.ageOffset ~= nil then\n		error(\n			`[AGES content] police body \"{member.id}\" has an ageOffset, which would size it against`\n				.. ` the player's own age. Officers are adults regardless of who they are arresting.`\n		)\n	end\n	byId[member.id] = member\nend\n\nlocal Police = {}\n\nPolice.Bodies = Bodies\n\n-- One body, by index, wrapping round the list. Index rather than a random draw because\n-- the caller is filling numbered posts in a response and wants them to differ from each\n-- other -- and a random pick of five, taken six times, collides about as often as not.\nfunction Police.Body(index: number): CastMember\n	return Bodies[(index - 1) % #Bodies + 1]\nend\n\n-- Nil for an id nothing authors any more, the same contract Curriculum.Get and\n-- Studies.Get offer, and for the same reason.\nfunction Police.Get(id: string): CastMember?\n	return byId[id]\nend\n\nreturn Police\n"
table.insert(AGES_MANIFEST, "src/server/content/Police.luau")
AGES_SOURCES["src/server/content/Procedures.luau"] = "--!strict\n-- What Science actually asks you to do.\n--\n-- The procedures that send you round the lab. The stations themselves are furniture\n-- rather than content and live in `shared/world/Stations.luau`, because the client has\n-- to be able to name and colour one; this file is the list of *errands*, and it is\n-- content in the same sense Lessons.luau is.\n--\n-- A table rather than code for the reason Lessons.luau gives -- the thing that has to\n-- stay cheap is writing another one. A procedure is six lines here and never touches\n-- the loop that runs it.\n--\n-- A procedure is an *ordered* list of stations, and the order is the entire test. That\n-- is what makes this a different activity from a quiz rather than a quiz you walk: a\n-- question has one right answer and you either have it or you do not, where a procedure\n-- has a right answer you can be half-way to. Wash before you weigh and you have made a\n-- specific, nameable mistake with a specific cost, and the score says which one.\n--\n-- Rules the content follows, all of them for mechanical reasons rather than scientific\n-- ones:\n--\n--   No station twice in a row. Two identical clicks in a row is a step the player takes\n--   without moving, and a step you can take without moving is not a step -- it is the\n--   idle-payout-pad anti-pattern hiding inside a good mechanic. The same station may\n--   appear twice in a procedure, just never adjacently: coming *back* to the balance is\n--   a real trip and a real thing to forget.\n--\n--   Every procedure is doable in any order without being *right* in any order. There\n--   are no steps that physically cannot be done out of sequence, because a step the\n--   game refuses to let you take wrong is a step with no decision in it. Getting it\n--   wrong has to be possible and has to cost something short of a fail.\n--\n--   The science is real enough to be worth knowing and never the difficulty. A player\n--   who has never held a pipette should be able to read the board and do it; the\n--   challenge is the room, the clock and the other bench, not domain knowledge. School\n--   here teaches by having you do a correct thing, not by testing whether you already\n--   knew it -- same principle as a question's `because` line.\n--\n--   Nothing here involves fire, blades, or anything a child should not copy -- and\n--   nothing here ever names a real dangerous chemical combination; every station and\n--   every procedure stays the same abstract furniture language it always has, on\n--   purpose, so there is nothing here to try at home. A result that goes bang is now\n--   allowed in exactly one narrow shape: a procedure may flag one step `volatile`, and\n--   reaching that station before the station in front of it in the order is scored\n--   exactly like any other mis-order plus one thing more -- ScienceService sets off a\n--   small, cosmetic-only explosion at the bench (Config.School.Science's\n--   ExplosionBlastRadiusStuds comment has the no-damage, no-knockback details). This is\n--   by direct owner instruction, narrowing the rule rather than breaking it: \"if ur\n--   options are to mix 2 things and it says could cause an explosion, a small explosion\n--   should happen.\" Thirteen-plus is still the hard ceiling everything else in this file\n--   was written against -- the bang is small, harmless, and never taught as chemistry.\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Config = require(ReplicatedStorage:WaitForChild(\"Config\"))\nlocal Types = require(ReplicatedStorage:WaitForChild(\"Types\"))\nlocal Stations = require(ReplicatedStorage:WaitForChild(\"world\"):WaitForChild(\"Stations\"))\n\ntype Procedure = Types.Procedure\n\nlocal Procedures = {}\n\n-- Authoring limits, from Config rather than restated so the limit the author writes\n-- against and the limit the lab enforces can never drift.\nlocal MAX_STEPS = Config.School.Science.MaxSteps\nlocal MIN_STEPS = Config.School.Science.StepsMin\nlocal MAX_LABEL = Config.School.Science.MaxStepLabelLength\n\n-- Written as an instruction to somebody standing in the room, because that is what it\n-- is: one line, present tense, and short enough to read off a board without stopping.\nlocal SOURCE: { Procedure } = {\n	-- The first one a nine-year-old sees. Four steps, no station repeated, and an order\n	-- with an obvious reason behind it -- you cannot record a mass you have not measured\n	-- -- so the first procedure teaches that order is the point without having to say so.\n	{\n		id = \"measure_salt\",\n		name = \"Measure out a spoon of salt\",\n		steps = {\n			{ station = \"scale_paper\", label = \"Take a square of paper\" },\n			{ station = \"balance\", label = \"Zero the balance\" },\n			{ station = \"beaker\", label = \"Spoon salt from the jar\" },\n			{ station = \"notebook\", label = \"Write the mass down\" },\n		},\n		minAge = 9,\n		maxAge = 12,\n	},\n	-- Five steps and the first repeats: the sink at both ends and the notebook either\n	-- side of the microscope. A player who reads three steps at a time meets the second\n	-- wash without remembering the first, which is the exact moment mastery starts being\n	-- worth something.\n	--\n	-- Looking down the microscope is deliberately *one* step rather than a set-it-down\n	-- and a focus-it. Two microscope steps back to back read as two things to do and are\n	-- one place to stand, which is the no-station-twice-in-a-row rule in the header: the\n	-- second click would be a step taken without moving.\n	{\n		id = \"clean_slide\",\n		name = \"Prepare a clean slide\",\n		steps = {\n			{ station = \"sink\", label = \"Rinse the slide\" },\n			{ station = \"notebook\", label = \"Label it with the date\" },\n			{ station = \"microscope\", label = \"Set it on the stage\" },\n			{ station = \"notebook\", label = \"Sketch what you can see\" },\n			{ station = \"sink\", label = \"Rinse your hands after\" },\n		},\n		minAge = 9,\n		maxAge = 13,\n	},\n	{\n		id = \"dissolve_sugar\",\n		name = \"Find out how fast sugar dissolves\",\n		steps = {\n			{ station = \"beaker\", label = \"Half fill the beaker\" },\n			{ station = \"balance\", label = \"Weigh out the sugar\" },\n			{ station = \"beaker\", label = \"Tip the sugar in\" },\n			{ station = \"stirrer\", label = \"Stir at a steady count\" },\n			{ station = \"notebook\", label = \"Record how long it took\" },\n		},\n		minAge = 10,\n		maxAge = 14,\n	},\n	-- Six steps, and the first where an out-of-order run is a *nameable* mistake rather\n	-- than just a wrong one: heat before you have measured and the number you write down\n	-- is not the number you meant to take. The verdict line says so.\n	{\n		id = \"warm_water\",\n		name = \"Warm water and watch the thermometer\",\n		steps = {\n			{ station = \"beaker\", label = \"Fill the beaker halfway\" },\n			{ station = \"notebook\", label = \"Note the temperature\" },\n			{ station = \"burner\", label = \"Set it on the hot plate\" },\n			{ station = \"stirrer\", label = \"Stir it while it warms\" },\n			{ station = \"notebook\", label = \"Note the temperature again\" },\n			{ station = \"sink\", label = \"Cool it under the tap\" },\n		},\n		minAge = 11,\n		maxAge = 15,\n	},\n	{\n		id = \"grow_crystal\",\n		name = \"Start a salt crystal growing\",\n		steps = {\n			{ station = \"scale_paper\", label = \"Take a square of paper\" },\n			{ station = \"balance\", label = \"Weigh out the salt\" },\n			{ station = \"beaker\", label = \"Add warm water\" },\n			{ station = \"stirrer\", label = \"Stir until it clears\" },\n			{ station = \"notebook\", label = \"Date the jar\" },\n			{ station = \"microscope\", label = \"Look at a seed grain\" },\n		},\n		minAge = 12,\n		maxAge = 17,\n	},\n	-- Seven and eight steps. These only appear late, and by design they are unreadable\n	-- three-at-a-time: at mastery one this procedure is four trips to the board, and at\n	-- mastery five it is one. That gap is the whole progression, and it is why the long\n	-- procedures exist at all.\n	{\n		id = \"filter_mixture\",\n		name = \"Separate sand from salty water\",\n		steps = {\n			{ station = \"beaker\", label = \"Stir the mixture up\" },\n			{ station = \"stirrer\", label = \"Let the sand settle\" },\n			{ station = \"sink\", label = \"Pour the water off\" },\n			{ station = \"balance\", label = \"Weigh what is left\" },\n			{ station = \"burner\", label = \"Dry the sand off gently\" },\n			{ station = \"balance\", label = \"Weigh it dry\" },\n			{ station = \"notebook\", label = \"Write both masses down\" },\n		},\n		minAge = 13,\n		maxAge = 17,\n	},\n	-- The one procedure with a `volatile` step -- see the header. Five steps, and the\n	-- order has a reason a player can work out just from reading the board: you steady\n	-- the first solution before you add the second, the same \"you cannot record a mass\n	-- you have not measured\" logic `measure_salt` teaches, except this time skipping\n	-- ahead does not just cost the step. Reaching the beaker a second time before ever\n	-- reaching the stirrer is exactly \"mixed the second thing in before the first was\n	-- ready\", and ScienceService answers that with a small bang at the bench rather than\n	-- only a lower score.\n	{\n		id = \"mix_reactive\",\n		name = \"Mix two volatile solutions\",\n		steps = {\n			{ station = \"beaker\", label = \"Pour in the first mix\" },\n			{ station = \"stirrer\", label = \"Stir it steady\" },\n			{ station = \"beaker\", label = \"Add the second mix\", volatile = true },\n			{ station = \"sink\", label = \"Rinse the beaker out\" },\n			{ station = \"notebook\", label = \"Note what happened\" },\n		},\n		minAge = 12,\n		maxAge = 17,\n	},\n	{\n		id = \"compare_samples\",\n		name = \"Compare two soil samples\",\n		steps = {\n			{ station = \"scale_paper\", label = \"Two squares of paper\" },\n			{ station = \"balance\", label = \"Weigh the first sample\" },\n			{ station = \"microscope\", label = \"Look at the first\" },\n			{ station = \"notebook\", label = \"Write what you saw\" },\n			{ station = \"balance\", label = \"Weigh the second\" },\n			{ station = \"microscope\", label = \"Look at the second\" },\n			{ station = \"notebook\", label = \"Write the difference\" },\n			{ station = \"sink\", label = \"Wash the trays\" },\n		},\n		minAge = 14,\n		maxAge = 17,\n	},\n}\n\n-- Everything below runs at require time and errors by name. A procedure that names a\n-- missing station, or repeats one adjacently, is not a thing to discover in a playtest:\n-- the first is a step the player can never take and the second is a step they take\n-- without moving, and both look like the lab is broken rather than the content is.\nlocal byId: { [string]: Procedure } = {}\nfor _, procedure in SOURCE do\n	if byId[procedure.id] ~= nil then\n		error(`[AGES content] duplicate procedure id \"{procedure.id}\"`)\n	end\n	local count = #procedure.steps\n	if count < MIN_STEPS or count > MAX_STEPS then\n		error(\n			`[AGES content] procedure \"{procedure.id}\" has {count} steps, outside {MIN_STEPS}-{MAX_STEPS}.`\n				.. ` Change the steps or Config.School.Science.StepsMin/MaxSteps.`\n		)\n	end\n	if procedure.minAge > procedure.maxAge then\n		error(\n			`[AGES content] procedure \"{procedure.id}\" has minAge {procedure.minAge} above maxAge`\n				.. ` {procedure.maxAge} -- it would never be offered. Swap them.`\n		)\n	end\n	local previous: string? = nil\n	for index, step in procedure.steps do\n		if Stations.Get(step.station) == nil then\n			error(\n				`[AGES content] procedure \"{procedure.id}\" step {index} names station \"{step.station}\",`\n					.. ` which is not in shared/world/Stations.luau. Add the station or fix the name.`\n			)\n		end\n		if step.station == previous then\n			error(\n				`[AGES content] procedure \"{procedure.id}\" uses station \"{step.station}\" twice in a row at`\n					.. ` step {index}. That is a step the player takes without moving. Put another station`\n					.. ` between them or merge the two labels.`\n			)\n		end\n		if #step.label > MAX_LABEL then\n			error(\n				`[AGES content] procedure \"{procedure.id}\" step {index} label is {#step.label} characters,`\n					.. ` over Config.School.Science.MaxStepLabelLength ({MAX_LABEL}). It is one row of a list`\n					.. ` read across a room -- shorten it.`\n			)\n		end\n		previous = step.station\n	end\n	byId[procedure.id] = procedure\nend\n\n-- Every procedure must be reachable in some school year, or it is content nobody will\n-- ever see -- which is the same defect as a question written outside the age bands, and\n-- just as invisible.\nfor _, procedure in SOURCE do\n	if procedure.maxAge < Config.School.StartAge or procedure.minAge > Config.School.EndAge then\n		error(\n			`[AGES content] procedure \"{procedure.id}\" is offered between {procedure.minAge} and`\n				.. ` {procedure.maxAge}, entirely outside the school years. It would never be run.`\n		)\n	end\nend\n\n-- The procedures a life of this age can be given. Never empty inside the ages Science\n-- is taught over -- Curriculum's band for science is 9 to EndAge, and the entries above\n-- cover it -- but the caller still handles empty, because content edits are exactly how\n-- that stops being true.\nfunction Procedures.ForAge(age: number): { Procedure }\n	local out: { Procedure } = {}\n	for _, procedure in SOURCE do\n		if age >= procedure.minAge and age <= procedure.maxAge then\n			table.insert(out, procedure)\n		end\n	end\n	return out\nend\n\n-- Nil for an id that is no longer authored. Callers holding an id from a saved profile\n-- must handle that -- a procedure deleted from content is one a live life may be\n-- part-way through, and erroring here would lock that life out of the lab.\nfunction Procedures.Get(id: string): Procedure?\n	return byId[id]\nend\n\nProcedures.All = SOURCE\n\nreturn Procedures\n"
table.insert(AGES_MANIFEST, "src/server/content/Procedures.luau")
AGES_SOURCES["src/server/content/Props.luau"] = "--!strict\n-- The things childhood is made of.\n--\n-- Content data in the same sense as Subjects.luau and Cast.luau: authored\n-- descriptions, no code, and adding a rug needs nothing but an entry. What makes\n-- this file different from those two is that a prop is not scenery -- it is an\n-- answer. An event's choices are these objects, laid out in the room, and the\n-- player answers by doing something to one. See Types.ChoiceAct.\n--\n-- Sized against the childhood body ladder, the way subjects are. At\n-- Config.Childhood.Bands a two-year-old is roughly 2.3 studs and a five-year-old\n-- roughly 3.4, so a rug seven studs across really is one that \"has never seemed so\n-- wide\" and a cookie at 0.7 really does need both hands. Sizing these against an\n-- adult would produce a set of objects that are all technically present and all\n-- read as doll's furniture.\n--\n-- Two colors each and no asset ids, for the reason SubjectModels gives at length:\n-- an object that is the right size, in the right place, at the right moment is\n-- already most of the event. Being made of oak is the part that can wait. Every one\n-- of these is replaceable by a real model later without a line of this file moving\n-- -- PropModels adopts anything dropped into the ServerStorage folder under a\n-- matching name, exactly as SubjectModels does for the dog.\n--\n-- `reachStuds` is the one number here that is a game-feel decision rather than a\n-- description, and it is authored per prop rather than shared because the right\n-- answer genuinely differs: a rug is reached by being partway across it and a\n-- cookie is reached by being close enough to have picked it up. Too generous and\n-- the player answers by walking past; too tight and they orbit the thing they are\n-- plainly trying to touch, which is the worse of the two failures and the one that\n-- reads as the game being broken.\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal Types = require(ReplicatedStorage:WaitForChild(\"Types\"))\n\ntype PropKind = Types.PropKind\n\nlocal list: { PropKind } = {\n	-- childhood_across_the_rug ------------------------------------------------\n\n	{\n		id = \"bright_toy\",\n		name = \"the bright thing\",\n		shape = \"Ball\",\n		-- Small enough to be a toy and big enough to be visible from the far side of\n		-- a room at a toddler's eye height, which is about two studs off the floor.\n		size = Vector3.new(0.9, 0.9, 0.9),\n		color = Color3.fromRGB(240, 176, 44),\n		accentColor = Color3.fromRGB(232, 88, 62),\n		reachStuds = 3,\n		-- Sat on the floor. Everything in a toddler's world is on the floor.\n		liftStuds = 0,\n	},\n	{\n		id = \"rug\",\n		name = \"the rug\",\n		shape = \"Block\",\n		-- The number the prompt is about. Seven studs is three body lengths for the\n		-- child crossing it, which is what \"a rug that has never seemed so wide\"\n		-- has to mean for the sentence to survive contact with the room.\n		size = Vector3.new(7, 0.08, 5),\n		color = Color3.fromRGB(150, 76, 68),\n		accentColor = Color3.fromRGB(196, 154, 118),\n		-- Reached from well inside it, because pushing a rug is done from on top of\n		-- it. A reach that required standing on the edge would make shoving it a\n		-- matter of finding one exact stud.\n		reachStuds = 5,\n		liftStuds = 0,\n	},\n\n	-- childhood_last_cookie ---------------------------------------------------\n\n	{\n		id = \"cookie\",\n		name = \"the last cookie\",\n		shape = \"Cylinder\",\n		size = Vector3.new(0.7, 0.18, 0.7),\n		color = Color3.fromRGB(198, 152, 96),\n		accentColor = Color3.fromRGB(96, 62, 38),\n		reachStuds = 3,\n		-- Off the floor, at the height of the low table it is implicitly on. A\n		-- cookie on the carpet is a different and much less tempting object.\n		liftStuds = 1.4,\n	},\n	{\n		id = \"plate\",\n		name = \"the plate\",\n		shape = \"Cylinder\",\n		size = Vector3.new(1.7, 0.12, 1.7),\n		color = Color3.fromRGB(236, 232, 224),\n		accentColor = Color3.fromRGB(180, 176, 168),\n		reachStuds = 4,\n		liftStuds = 1.4,\n	},\n	{\n		id = \"cushion\",\n		name = \"the cushion in the corner\",\n		shape = \"Block\",\n		size = Vector3.new(1.9, 0.5, 1.9),\n		color = Color3.fromRGB(86, 106, 132),\n		accentColor = Color3.fromRGB(60, 74, 94),\n		reachStuds = 4,\n		liftStuds = 0,\n	},\n	{\n		id = \"other_child\",\n		name = \"the other child\",\n		shape = \"Figure\",\n		-- Deliberately the same height as the player is at the ages this can fire.\n		-- The event is about two people with an equal claim, and a child you look\n		-- down at is a child you would simply take it from.\n		size = Vector3.new(1.1, 2.4, 0.7),\n		color = Color3.fromRGB(108, 140, 196),\n		accentColor = Color3.fromRGB(226, 188, 160),\n		reachStuds = 4,\n		liftStuds = 0,\n	},\n\n	-- childhood_same_story ----------------------------------------------------\n\n	{\n		id = \"book_worn\",\n		name = \"the one you always have\",\n		shape = \"Block\",\n		size = Vector3.new(0.9, 0.2, 1.2),\n		-- Faded, and the accent is the only bright thing left on it. This is the\n		-- book that has been read four hundred times and it should look it.\n		color = Color3.fromRGB(178, 158, 132),\n		accentColor = Color3.fromRGB(206, 118, 92),\n		reachStuds = 3,\n		liftStuds = 0,\n	},\n	{\n		id = \"book_thick\",\n		name = \"the longest one\",\n		shape = \"Block\",\n		-- The only thing that distinguishes it in the prompt is that it is the\n		-- biggest, so it has to actually be the biggest object in the set.\n		size = Vector3.new(1.1, 0.55, 1.4),\n		color = Color3.fromRGB(58, 78, 120),\n		accentColor = Color3.fromRGB(212, 186, 108),\n		reachStuds = 3,\n		liftStuds = 0,\n	},\n	{\n		id = \"shelf\",\n		name = \"the shelf\",\n		shape = \"Block\",\n		size = Vector3.new(3.4, 0.3, 0.9),\n		color = Color3.fromRGB(122, 96, 70),\n		accentColor = Color3.fromRGB(88, 68, 50),\n		reachStuds = 4,\n		liftStuds = 0,\n	},\n\n	-- People ------------------------------------------------------------------\n	--\n	-- Not subjects. A subject is what an event is *about* and gets a rig, a gait and\n	-- a reaction to how it was answered; these are furniture that happens to be\n	-- person-shaped, and they are here because half of childhood is answered by\n	-- choosing which person to walk to. Sharing one grown-up across six events is\n	-- deliberate: it is the same adult, in the same house, and giving each event its\n	-- own would be six subtly different people for no reason a player could ever see.\n\n	{\n		id = \"grown_up\",\n		name = \"the grown-up\",\n		shape = \"Figure\",\n		-- Adult height against a childhood ladder that tops out at 3.4. The gap is\n		-- the point: every event that offers this as an answer is offering the option\n		-- of being carried, fetched or rescued by something much bigger than you.\n		size = Vector3.new(1.6, 5, 0.9),\n		color = Color3.fromRGB(96, 112, 104),\n		accentColor = Color3.fromRGB(226, 188, 160),\n		reachStuds = 4,\n		liftStuds = 0,\n	},\n	{\n		id = \"stranger\",\n		name = \"the face you don't know\",\n		shape = \"Figure\",\n		size = Vector3.new(1.6, 5, 0.9),\n		-- Same size as the grown-up and a different color, which is the whole of what\n		-- a one-year-old is working with: this is a person exactly like the one holding\n		-- you, except that it is not them.\n		color = Color3.fromRGB(140, 108, 132),\n		accentColor = Color3.fromRGB(226, 188, 160),\n		reachStuds = 4,\n		liftStuds = 0,\n	},\n\n	-- childhood_first_steps ---------------------------------------------------\n\n	{\n		id = \"couch\",\n		name = \"the couch\",\n		shape = \"Block\",\n		-- Long, because the answer that uses it is edging along its whole length. A\n		-- couch you could cross in two steps would make the careful answer the fast one.\n		size = Vector3.new(6, 1.6, 2.4),\n		color = Color3.fromRGB(132, 118, 100),\n		accentColor = Color3.fromRGB(98, 86, 72),\n		reachStuds = 4,\n		liftStuds = 0,\n	},\n\n	-- childhood_naming_things -------------------------------------------------\n\n	{\n		id = \"toy_box\",\n		name = \"the box of everything\",\n		shape = \"Block\",\n		size = Vector3.new(2.4, 1.4, 1.8),\n		color = Color3.fromRGB(206, 118, 92),\n		accentColor = Color3.fromRGB(240, 176, 44),\n		reachStuds = 4,\n		liftStuds = 0,\n	},\n	{\n		id = \"lamp\",\n		name = \"the light\",\n		shape = \"Block\",\n		-- Tall and thin so it reads from across the room, and so that standing under it\n		-- and pointing up is a thing the player can see themselves doing.\n		size = Vector3.new(0.6, 5.5, 0.6),\n		color = Color3.fromRGB(210, 204, 190),\n		accentColor = Color3.fromRGB(248, 226, 150),\n		reachStuds = 4,\n		liftStuds = 0,\n	},\n	{\n		id = \"stuffed_dog\",\n		name = \"the stuffed dog\",\n		shape = \"Figure\",\n		size = Vector3.new(0.8, 1.2, 0.5),\n		color = Color3.fromRGB(168, 140, 108),\n		accentColor = Color3.fromRGB(120, 96, 74),\n		reachStuds = 3,\n		liftStuds = 0,\n	},\n\n	-- childhood_sandbox -------------------------------------------------------\n\n	{\n		id = \"sand_pit\",\n		name = \"the sandbox\",\n		shape = \"Block\",\n		size = Vector3.new(7, 0.4, 7),\n		color = Color3.fromRGB(224, 202, 154),\n		accentColor = Color3.fromRGB(150, 122, 84),\n		-- Generous, because the answer is digging *in* it rather than touching it. A\n		-- tight reach would have the player hunting for the one stud that counts as\n		-- being in a sandbox seven studs across.\n		reachStuds = 5,\n		liftStuds = 0,\n	},\n	{\n		id = \"low_wall\",\n		name = \"the low wall\",\n		shape = \"Block\",\n		-- Somewhere to be that is not the sandbox. The answer it carries is watching\n		-- rather than joining, and that only reads as a decision if there is a second\n		-- place in the yard to make it from.\n		size = Vector3.new(5, 1.2, 0.8),\n		color = Color3.fromRGB(164, 156, 144),\n		accentColor = Color3.fromRGB(124, 118, 108),\n		reachStuds = 3,\n		liftStuds = 0,\n	},\n\n	-- childhood_end_of_yard ---------------------------------------------------\n\n	{\n		id = \"hedge_gap\",\n		name = \"the gap in the hedge\",\n		shape = \"Block\",\n		-- Child-sized, which is the entire reason the gap is interesting: it is the one\n		-- door in the yard that was not built for the people who tell you where to go.\n		size = Vector3.new(2.2, 3, 0.8),\n		color = Color3.fromRGB(74, 104, 68),\n		accentColor = Color3.fromRGB(46, 68, 44),\n		reachStuds = 4,\n		liftStuds = 0,\n	},\n\n	-- childhood_storm ---------------------------------------------------------\n\n	{\n		id = \"window\",\n		name = \"the window\",\n		shape = \"Block\",\n		size = Vector3.new(3.2, 4, 0.3),\n		color = Color3.fromRGB(122, 140, 164),\n		accentColor = Color3.fromRGB(228, 234, 242),\n		reachStuds = 4,\n		liftStuds = 0,\n	},\n	{\n		id = \"bed\",\n		name = \"the bed\",\n		shape = \"Block\",\n		size = Vector3.new(4, 1.4, 6),\n		color = Color3.fromRGB(198, 190, 178),\n		accentColor = Color3.fromRGB(146, 136, 122),\n		reachStuds = 4,\n		liftStuds = 0,\n	},\n\n	-- childhood_dropped_spoon -------------------------------------------------\n\n	{\n		id = \"spoon\",\n		name = \"the spoon\",\n		shape = \"Block\",\n		size = Vector3.new(0.25, 0.12, 1.2),\n		color = Color3.fromRGB(206, 208, 212),\n		accentColor = Color3.fromRGB(150, 154, 160),\n		reachStuds = 3,\n		liftStuds = 0,\n	},\n	{\n		id = \"bowl\",\n		name = \"the bowl\",\n		shape = \"Cylinder\",\n		size = Vector3.new(1.4, 0.7, 1.4),\n		color = Color3.fromRGB(238, 214, 168),\n		accentColor = Color3.fromRGB(180, 148, 96),\n		reachStuds = 3,\n		liftStuds = 1.4,\n	},\n\n	-- childhood_stairs --------------------------------------------------------\n\n	{\n		id = \"stairs\",\n		name = \"the stairs\",\n		shape = \"Block\",\n		size = Vector3.new(4.5, 3, 6),\n		color = Color3.fromRGB(146, 124, 100),\n		accentColor = Color3.fromRGB(108, 90, 72),\n		reachStuds = 4,\n		liftStuds = 0,\n	},\n	{\n		id = \"stair_rail\",\n		name = \"the rail\",\n		shape = \"Block\",\n		size = Vector3.new(0.35, 3.2, 5),\n		color = Color3.fromRGB(122, 96, 70),\n		accentColor = Color3.fromRGB(88, 68, 50),\n		-- Tight on purpose. Holding a rail means being against it, and the answer that\n		-- uses it is the careful one -- it should have to be done carefully.\n		reachStuds = 3,\n		liftStuds = 0,\n	},\n\n	-- childhood_one_toy -------------------------------------------------------\n\n	{\n		id = \"worn_toy\",\n		name = \"the one you keep\",\n		shape = \"Figure\",\n		size = Vector3.new(0.9, 1.4, 0.6),\n		-- Drab, and the accent is barely there. The prompt says it is not the newest or\n		-- the nicest, so it must not be the brightest thing on the floor either.\n		color = Color3.fromRGB(158, 146, 130),\n		accentColor = Color3.fromRGB(184, 160, 128),\n		reachStuds = 3,\n		liftStuds = 0,\n	},\n	{\n		id = \"front_door\",\n		name = \"the front door\",\n		shape = \"Block\",\n		size = Vector3.new(3.4, 6.4, 0.4),\n		color = Color3.fromRGB(84, 92, 108),\n		accentColor = Color3.fromRGB(196, 176, 120),\n		reachStuds = 4,\n		liftStuds = 0,\n	},\n\n	-- childhood_hiding --------------------------------------------------------\n\n	{\n		id = \"curtain\",\n		name = \"the curtain\",\n		shape = \"Block\",\n		size = Vector3.new(2.6, 5.6, 0.3),\n		color = Color3.fromRGB(148, 108, 116),\n		accentColor = Color3.fromRGB(108, 76, 84),\n		reachStuds = 3,\n		liftStuds = 0,\n	},\n	{\n		id = \"cupboard\",\n		name = \"the cupboard\",\n		shape = \"Block\",\n		size = Vector3.new(2.6, 3.6, 1.6),\n		color = Color3.fromRGB(112, 92, 78),\n		accentColor = Color3.fromRGB(78, 64, 54),\n		reachStuds = 4,\n		liftStuds = 0,\n	},\n\n	-- childhood_puddle --------------------------------------------------------\n\n	{\n		id = \"puddle\",\n		name = \"the puddle\",\n		shape = \"Block\",\n		-- Wide enough that going around it is a genuine detour rather than a sidestep,\n		-- which is the only thing that makes the careful answer cost anything.\n		size = Vector3.new(6, 0.06, 5),\n		color = Color3.fromRGB(108, 128, 142),\n		accentColor = Color3.fromRGB(150, 172, 186),\n		reachStuds = 4,\n		liftStuds = 0,\n	},\n	{\n		id = \"dry_path\",\n		name = \"the dry side\",\n		shape = \"Block\",\n		size = Vector3.new(3.2, 0.1, 3.2),\n		color = Color3.fromRGB(178, 170, 156),\n		accentColor = Color3.fromRGB(140, 132, 120),\n		reachStuds = 3,\n		liftStuds = 0,\n	},\n\n	-- childhood_broke_it ------------------------------------------------------\n\n	{\n		id = \"broken_half\",\n		name = \"the broken half\",\n		shape = \"Block\",\n		size = Vector3.new(0.9, 0.7, 0.7),\n		color = Color3.fromRGB(232, 226, 214),\n		accentColor = Color3.fromRGB(164, 156, 142),\n		reachStuds = 3,\n		liftStuds = 0,\n	},\n\n	-- childhood_mirror --------------------------------------------------------\n\n	{\n		id = \"mirror\",\n		name = \"the other baby\",\n		shape = \"Block\",\n		-- Named for what is in it rather than for what it is, because at one year old\n		-- those are not the same object and the event is entirely about the difference.\n		size = Vector3.new(2.6, 4.4, 0.3),\n		color = Color3.fromRGB(206, 220, 228),\n		accentColor = Color3.fromRGB(140, 118, 92),\n		reachStuds = 4,\n		liftStuds = 0,\n	},\n	{\n		id = \"other_side\",\n		name = \"the other side\",\n		shape = \"Block\",\n		-- The answer to \"where is the baby actually standing\", crawled to and found to\n		-- be nothing. It has to be a real place across the room rather than a face of\n		-- the mirror: two answers on one object is a coin flip, and more to the point a\n		-- child who thinks there is somebody in there goes looking for the room they\n		-- are in, not for the back of a pane of glass.\n		size = Vector3.new(4, 6, 0.5),\n		color = Color3.fromRGB(188, 180, 168),\n		accentColor = Color3.fromRGB(148, 140, 130),\n		reachStuds = 3,\n		liftStuds = 0,\n	},\n\n	-- childhood_helping -------------------------------------------------------\n\n	{\n		id = \"flashlight\",\n		name = \"the flashlight\",\n		shape = \"Block\",\n		size = Vector3.new(0.4, 0.4, 1.5),\n		color = Color3.fromRGB(66, 72, 80),\n		accentColor = Color3.fromRGB(248, 232, 168),\n		reachStuds = 3,\n		liftStuds = 0,\n	},\n	{\n		id = \"workbench\",\n		name = \"what they are working on\",\n		shape = \"Block\",\n		size = Vector3.new(4.2, 2.6, 1.8),\n		color = Color3.fromRGB(134, 106, 78),\n		accentColor = Color3.fromRGB(96, 78, 58),\n		reachStuds = 4,\n		liftStuds = 0,\n	},\n	{\n		id = \"washer\",\n		name = \"the small metal one\",\n		shape = \"Cylinder\",\n		-- The smallest thing in this file, and that is the joke: the answer that ends\n		-- with \"you still know what a washer is\" should be the player picking up the\n		-- one object on the floor they could not possibly name.\n		size = Vector3.new(0.35, 0.1, 0.35),\n		color = Color3.fromRGB(178, 182, 188),\n		accentColor = Color3.fromRGB(126, 130, 136),\n		reachStuds = 3,\n		liftStuds = 0,\n	},\n}\n\nlocal byId: { [string]: PropKind } = {}\nfor _, prop in list do\n	if byId[prop.id] ~= nil then\n		error(`[AGES content] duplicate prop id \"{prop.id}\"`)\n	end\n	-- A prop with no size is invisible and unreachable, and the symptom is an event\n	-- with one fewer answer than it was written with -- which looks like the event\n	-- being wrong rather than like this line being missing.\n	if prop.size.X <= 0 or prop.size.Y <= 0 or prop.size.Z <= 0 then\n		error(`[AGES content] prop \"{prop.id}\" has a zero or negative size`)\n	end\n	if prop.reachStuds <= 0 then\n		error(`[AGES content] prop \"{prop.id}\" has a reachStuds of {prop.reachStuds}, so it could never be reached`)\n	end\n	byId[prop.id] = prop\nend\n\nreturn {\n	All = list,\n	ById = byId,\n}\n"
