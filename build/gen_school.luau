AGES_SOURCES["src/server/services/DisguiseService.luau"] = "--!strict\n-- Changing your clothes, which is the one thing a wanted player can do about being wanted.\n--\n-- Everything else in this system happens *to* you. Heat climbs, officers arrive, the town\n-- turns to look. This is the answer, and it is deliberately powerful: it does not reduce the\n-- heat by a point. It deletes what the police know. Officers converging on a corner become\n-- officers searching a place you are not, the crowd stops recognising you, and the whole\n-- apparatus keeps running against a description nobody has any more.\n--\n-- What it costs is the only currency a chase has, which is time spent not running. You have\n-- to be on one of four marks -- see content/Hideouts -- standing still, unwatched, for five\n-- seconds, while the search ring drifts toward you. Getting there is the traversal the\n-- activity needed; standing there is the commit; stepping off is the undo. Being seen\n-- part-way through does not fail you, it just stops the count where it is, which is the soft\n-- failure this project asks of everything.\n--\n-- Nothing is clicked. There is no panel, no remote and no client half at all -- the mark\n-- counts when you stand on it and the sign above it says what is happening. That is not\n-- minimalism, it is the same signposting argument the shop camera makes: during these five\n-- seconds the player is looking at the spot they are standing on and the street beyond it,\n-- and a HUD panel would be off to the side of the only thing on screen that matters.\n--\n-- Split from BountyService, which owns what the police believe, and from WitnessService,\n-- which owns the crowd that reads it. This file owns the verb and nothing else.\n\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Config = require(ReplicatedStorage:WaitForChild(\"Config\"))\nlocal Money = require(ReplicatedStorage:WaitForChild(\"Money\"))\n\nlocal BountyService = require(script.Parent.BountyService)\nlocal MoneyService = require(script.Parent.MoneyService)\nlocal PlaceService = require(script.Parent.PlaceService)\n\nlocal Hideouts = require(script.Parent.Parent.content.Hideouts)\nlocal Wardrobe = require(script.Parent.Parent.world.Wardrobe)\n\nlocal DisguiseService = {}\n\nlocal DISGUISE = Config.Crime.Disguise\n\n-- One player, part-way through changing.\ntype Change = {\n	place: string,\n	-- Seconds banked so far. Held rather than an end time, because being watched pauses the\n	-- count where it is instead of restarting it: an escape you had almost finished should\n	-- be worth something when the officer walks past, or nobody will ever start one with\n	-- anybody nearby, which is every interesting time to start one.\n	heldFor: number,\n	-- How long to keep the finished sign up before the mark goes quiet again. Purely so the\n	-- player gets to see it land -- five seconds of standing still that ended with the sign\n	-- blinking straight back to \"Change\" would read as a failure.\n	doneFor: number,\n}\n\nlocal changes: { [Player]: Change } = {}\nlocal enabled = true\n\nlocal function characterPosition(player: Player): Vector3?\n	local character = player.Character\n	if character == nil then\n		return nil\n	end\n	local root = character:FindFirstChild(\"HumanoidRootPart\")\n	if root == nil then\n		return nil\n	end\n	return (root :: BasePart).Position\nend\n\nlocal function labelFor(place: string): string\n	local spot = Hideouts.Get(place)\n	return if spot ~= nil then spot.label else \"Change\"\nend\n\n-- Off the mark, for whatever reason. The sign is released here rather than left to time out,\n-- because a mark still owned by somebody who walked away is a mark the next player cannot\n-- use -- the worst possible failure for a thing whose entire job is being available in an\n-- emergency.\nlocal function leave(player: Player)\n	local change = changes[player]\n	if change == nil then\n		return\n	end\n	changes[player] = nil\n	Wardrobe.Rest(change.place, player, labelFor(change.place))\nend\n\n-- The mark this player is standing on, or nil. Nearest wins -- see Wardrobe.DistanceTo for\n-- why that is worth the extra line.\nlocal function markUnder(at: Vector3): string?\n	local best: string? = nil\n	local bestDistance = math.huge\n	for _, spot in Hideouts.Spots do\n		local distance = Wardrobe.DistanceTo(spot.place, at)\n		if distance ~= nil and distance <= DISGUISE.ReachStuds and distance < bestDistance then\n			best = spot.place\n			bestDistance = distance\n		end\n	end\n	return best\nend\n\n-- Why this player cannot change right now, as a sentence for the sign over their head, or\n-- nil if they can.\n--\n-- Ordered by what is most useful to read at a run. Being watched first because it is the one\n-- that changes second to second and the one they can do something about by waiting; the\n-- money last because it is a fact about the afternoon rather than about this moment.\nlocal function blockedBecause(player: Player): string?\n	-- Right now, not recently. Deliberately not a check on how stale the last sighting is:\n	-- making the player wait out a sighting *and then* stand still for five seconds would\n	-- double a cost that is already the whole point of the verb, and would mean the escape\n	-- is unavailable during exactly the seconds it is worth having.\n	if BountyService.IsSeen(player) then\n		return \"Not while they can see you\"\n	end\n	if not MoneyService.CanAfford(player, DISGUISE.Cost) then\n		return `{Money.Format(DISGUISE.Cost)} for clothes`\n	end\n	return nil\nend\n\nlocal function tickPlayer(player: Player, elapsed: number)\n	local at = characterPosition(player)\n	if at == nil then\n		leave(player)\n		return\n	end\n\n	local place = markUnder(at)\n	if place == nil then\n		leave(player)\n		return\n	end\n\n	-- Nothing to hide from, so the mark stays quiet. This is not a refusal and must not read\n	-- as one: home is on the hideout list, a player walks across their own kitchen a hundred\n	-- times a life, and a floor that went red and told them off every time would turn the one\n	-- thing they need to recognise instantly under pressure into wallpaper they have learned\n	-- to ignore. The mark only ever speaks when it has something to offer.\n	if not BountyService.Described(player) then\n		leave(player)\n		return\n	end\n\n	local change = changes[player]\n	if change ~= nil and change.place ~= place then\n		-- Walked from one mark straight onto another, which is only reachable by a debug\n		-- teleport today. The banked seconds do not travel: they were spent standing in a\n		-- particular room, and carrying them would make a chain of marks a way of doing this\n		-- in installments from anywhere.\n		leave(player)\n		change = nil\n	end\n\n	if change == nil then\n		if not Wardrobe.Claim(place, player) then\n			return\n		end\n		change = { place = place, heldFor = 0, doneFor = 0 }\n		changes[player] = change\n	end\n\n	local held = change :: Change\n\n	-- The moment after. Held on screen rather than cleared, so five seconds of standing\n	-- perfectly still visibly ends in something.\n	if held.doneFor > 0 then\n		held.doneFor -= elapsed\n		Wardrobe.Show(place, player, \"Changed\", 1, \"done\")\n		if held.doneFor <= 0 then\n			leave(player)\n		end\n		return\n	end\n\n	local blocked = blockedBecause(player)\n	if blocked ~= nil then\n		-- Paused, not reset. See Change.heldFor: an escape you had almost finished has to be\n		-- worth something when somebody walks past, or nobody will ever start one at the only\n		-- times it is interesting to.\n		Wardrobe.Show(place, player, blocked, held.heldFor / DISGUISE.ChangeSeconds, \"blocked\")\n		return\n	end\n\n	held.heldFor += elapsed\n	if held.heldFor < DISGUISE.ChangeSeconds then\n		Wardrobe.Show(\n			place,\n			player,\n			`Changing… {math.ceil(DISGUISE.ChangeSeconds - held.heldFor)}s`,\n			held.heldFor / DISGUISE.ChangeSeconds,\n			\"busy\"\n		)\n		return\n	end\n\n	-- Decided before anything is written, then recorded, which is this project's standing\n	-- rule for anything a retry could reach. The money goes first: a spend that failed after\n	-- the description was already gone would be a free escape, and there is no unpicking a\n	-- belief you have already deleted.\n	if not MoneyService.Spend(player, DISGUISE.Cost, \"a change of clothes\") then\n		held.heldFor = 0\n		Wardrobe.Show(place, player, `{Money.Format(DISGUISE.Cost)} for clothes`, 0, \"blocked\")\n		return\n	end\n\n	BountyService.LoseDescription(player)\n	held.heldFor = 0\n	held.doneFor = 1.5\nend\n\n-- Stands up every mark in the content list, once, and says which ones could not be built.\n--\n-- At startup rather than on arrival, so a missing place point is a line in the log on a\n-- developer's first boot rather than a corner of the map a player sprints to under pressure\n-- and finds empty.\nlocal function buildMarks()\n	for _, spot in Hideouts.Spots do\n		local place = PlaceService.Find(spot.place)\n		if place == nil then\n			warn(\n				`[AGES] hideout \"{spot.place}\" has no place point in the built world, so there is `\n					.. `nowhere to change there. Either the town no longer has that room or the id in `\n					.. `content/Hideouts.luau is wrong.`\n			)\n			continue\n		end\n		if Wardrobe.Build(spot.place, place.part.CFrame, spot.label) == nil then\n			warn(`[AGES] could not stand up a hideout at \"{spot.place}\"; its place point has no heading.`)\n		end\n	end\nend\n\n-- Off leaves the marks standing but dead, which is the useful state for telling a disguise\n-- bug apart from a pursuit one: with this off, a chase that never ends is the pursuit's\n-- fault and a chase that ends anyway is not.\nfunction DisguiseService.SetEnabled(value: boolean)\n	enabled = value\n	if not value then\n		for player in changes do\n			leave(player)\n		end\n	end\nend\n\nfunction DisguiseService.IsEnabled(): boolean\n	return enabled\nend\n\n-- For the harness, and phrased as the two questions a broken escape raises: is there a mark\n-- under me, and if I am not counting, why not.\nfunction DisguiseService.Describe(player: Player): string\n	local at = characterPosition(player)\n	local lines = { if enabled then \"disguise on\" else \"disguise OFF\" }\n\n	local built = 0\n	for _, spot in Hideouts.Spots do\n		if Wardrobe.Get(spot.place) ~= nil then\n			built += 1\n		end\n	end\n	table.insert(lines, `{built}/{#Hideouts.Spots} marks built`)\n\n	if at == nil then\n		table.insert(lines, \"no body in the world\")\n		return table.concat(lines, \" · \")\n	end\n\n	local place = markUnder(at)\n	if place == nil then\n		table.insert(lines, \"not on a mark\")\n	else\n		local change = changes[player]\n		local held = if change ~= nil then change.heldFor else 0\n		table.insert(lines, `on \"{place}\" at {string.format(\"%.1f\", held)}/{DISGUISE.ChangeSeconds}s`)\n		table.insert(lines, blockedBecause(player) or \"counting\")\n	end\n	return table.concat(lines, \" · \")\nend\n\nfunction DisguiseService:Start()\n	buildMarks()\n\n	Players.PlayerRemoving:Connect(leave)\n\n	task.spawn(function()\n		while true do\n			local elapsed = task.wait(DISGUISE.TickSeconds)\n			if enabled then\n				for _, player in Players:GetPlayers() do\n					local fine, problem = pcall(tickPlayer, player, elapsed)\n					if not fine then\n						warn(`[AGES] disguise tick failed for {player.Name}: {problem}`)\n					end\n				end\n			end\n		end\n	end)\nend\n\nreturn DisguiseService\n"
table.insert(AGES_MANIFEST, "src/server/services/DisguiseService.luau")
AGES_SOURCES["src/server/services/EnactService.luau"] = "--!strict\n-- Answering an event by going to the thing it is about.\n--\n-- An event authored Enacted is one whose question has something standing in the\n-- room behind it -- a dog, and later a vehicle or a machine. This puts three dots\n-- over that thing and waits. The player walks across to it, clicks them, and the\n-- choices come up. Nothing is answered by being anywhere; what walking buys is the\n-- right to be asked.\n--\n-- That is a smaller job than it sounds and it is deliberately smaller than what was\n-- here before. The previous version fanned each choice onto its own patch of floor\n-- at its own bearing off the animal, so that walking to \"Stand completely still\" was\n-- physically stepping aside from the dog. It was the most carefully built thing in\n-- the game and it was the wrong shape: a Roblox player expects to walk up to a thing\n-- and press it, not to read four discs on the carpet and stand in one. The walk to\n-- the animal survived the change. The floor did not.\n--\n-- The division of labour is untouched, and it is the reason the change was cheap.\n-- EventService alone decides which event fires and alone validates an answer. This\n-- decides only that there is something worth walking to, and hangs an invitation on\n-- it. Every answer still arrives through EventService.ResolveChoice, the same\n-- function the panel's remote lands in, so there is exactly one place a choice can\n-- be paid out and enactment has never been a second way to cheat one.\n--\n-- Nothing here talks to the client. The dots are a world object -- the client sees\n-- them because they are in the workspace, not because they were told -- and the\n-- panel they open was already pushed as the event offer. So an enacted event costs\n-- one remote message, the same one a panel event costs, and clicking the dots costs\n-- none at all.\n--\n-- Best-effort by design, unchanged in spirit and much rarer in practice. An event\n-- with no subject has nothing to hang dots on and is a panel; so is one whose\n-- subject could not be built. The timeout below is the last line: an animal that\n-- wandered somewhere unreachable, or a player who simply does not want to walk,\n-- gets the panel instead. Enactment may never be the reason an event cannot be\n-- answered.\n\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Config = require(ReplicatedStorage:WaitForChild(\"Config\"))\nlocal Types = require(ReplicatedStorage:WaitForChild(\"Types\"))\nlocal Interact = require(ReplicatedStorage:WaitForChild(\"world\"):WaitForChild(\"Interact\"))\nlocal Lives = require(ReplicatedStorage:WaitForChild(\"Lives\"))\n\nlocal DataService = require(script.Parent.DataService)\nlocal EventService = require(script.Parent.EventService)\n\ntype LifeEvent = Types.LifeEvent\n\nlocal EnactService = {}\n\n-- The verb over the thing. One word for every enacted event there will ever be,\n-- because the events are not alike -- a dog running at you and a stranger at the\n-- door want different verbs -- and a wrong specific word reads worse than a right\n-- vague one. Never drawn under the current style; see Interact.\nlocal ACTION_TEXT = \"Decide\"\n\ntype Active = {\n	eventId: string,\n	-- The thing the dots are on. Held so the tick can notice it leaving the world,\n	-- which is the one way an enactment becomes unanswerable without anybody being\n	-- told.\n	model: Model,\n	dots: Interact.InteractHandle,\n	-- os.clock() deadline, or nil when the fallback is switched off. In memory rather\n	-- than in the profile: an enactment does not survive a rejoin, so a deadline that\n	-- did would be counting down against nothing.\n	expiresAt: number?,\n}\n\nlocal active: { [Player]: Active } = {}\n\n-- Debug switch for the Studio harness, never touched in a live server. Off means\n-- every event resolves on a panel, which is also the state to put the game in\n-- while testing something that has nothing to do with enactment.\nlocal enabled = true\n\n-- Ends an enactment without answering it. Callers that also need the prompt dealt\n-- with do that themselves -- this only takes the invitation off the thing.\nlocal function stop(player: Player)\n	local current = active[player]\n	if current == nil then\n		return\n	end\n	active[player] = nil\n	current.dots.Destroy()\nend\n\n-- Called by EventService at the moment a prompt opens, and the answer decides what\n-- the client is told. Returns false for every ordinary reason there is nothing to\n-- walk to, so callers must not treat false as a fault: it means \"this one is a\n-- panel\", which is always a valid answer.\n--\n-- `subject` is the model the event is about, which is why this is called after the\n-- subject is placed rather than before -- the dots hang on it, so it has to exist\n-- before they can. Nil means there is nothing to hang them on, which is true of most\n-- events.\nlocal function begin(player: Player, event: LifeEvent, subject: Types.StagedSubject?): boolean\n	stop(player)\n\n	if not enabled then\n		return false\n	end\n	if subject == nil then\n		return false\n	end\n\n	local dots = Interact.Attach(subject, {\n		kind = \"Event\",\n		id = event.id,\n		actionText = ACTION_TEXT,\n		objectText = subject.Name,\n	})\n	if dots == nil then\n		-- Not warned about. Interact refuses when the rig has no part to adorn, which\n		-- here means the subject is still assembling -- an ordinary race, and the\n		-- panel is a complete answer to it.\n		return false\n	end\n\n	active[player] = {\n		eventId = event.id,\n		model = subject,\n		dots = dots,\n		-- 0 means the fallback is off, which is a testing state only -- see the safe\n		-- range on SecondsToChoose.\n		expiresAt = if Config.Enact.SecondsToChoose > 0\n			then os.clock() + Config.Enact.SecondsToChoose\n			else nil,\n	}\n	return true\nend\n\n-- Answering a childhood event ends the year, and the birthday that follows may\n-- offer -- and enact -- the next one immediately. Adding a key to `active` while it\n-- is being traversed is undefined in Lua, so the traversal decides and this list\n-- acts, strictly afterwards.\nlocal function tick()\n	if next(active) == nil then\n		return\n	end\n\n	local stranded: { { player: Player, eventId: string } } = {}\n\n	for player, current in active do\n		-- The prompt is the authority, not this table. An event answered on a panel, a\n		-- player who died, a life that ended, a profile that went away -- all of them\n		-- show up here as \"the pending id is no longer mine\", so there is one condition\n		-- to get right instead of a subscription to every service that could have ended\n		-- it. Clearing keys mid-traversal is safe; adding is what the list above exists\n		-- to avoid.\n		local profile = DataService.GetProfile(player)\n		if profile == nil or not Lives.Active(profile.Data).alive or Lives.Active(profile.Data).pendingEventId ~= current.eventId then\n			stop(player)\n			continue\n		end\n\n		-- The thing has left the world and taken the dots with it. Rare -- the scene\n		-- holds the subject for as long as the prompt is open -- and worth catching\n		-- anyway, because the symptom is a question with no visible way to answer it.\n		local gone = current.model.Parent == nil\n		local late = current.expiresAt ~= nil and os.clock() >= current.expiresAt\n		if gone or late then\n			-- The prompt stays open; only the way of answering it changes. The player has\n			-- not lost anything and is not told off for taking too long -- the panel simply\n			-- appears and the choices are still all there.\n			stop(player)\n			table.insert(stranded, { player = player, eventId = current.eventId })\n		end\n	end\n\n	for _, entry in stranded do\n		EventService.FallBackToPanel(entry.player, entry.eventId)\n	end\nend\n\n-- Answered, however it was answered. Takes the dots down on the same frame rather\n-- than leaving them for the tick to notice, because the outcome is on screen\n-- immediately and three dots still bobbing over the dog under it would be an\n-- invitation to answer a question that is already settled.\nlocal function onAnswered(player: Player, _event: LifeEvent, _choice: Types.EventChoice)\n	stop(player)\nend\n\n-- Studio harness: what is standing in the room right now.\nfunction EnactService.Describe(player: Player): string\n	local current = active[player]\n	if current == nil then\n		return `nothing enacted | enactment {if enabled then \"on\" else \"off\"}`\n	end\n\n	local remaining = if current.expiresAt ~= nil\n		then string.format(\"%.0fs left\", math.max(0, current.expiresAt - os.clock()))\n		else \"no timeout\"\n	-- Whether the thing is still there is the first question about an enactment that\n	-- feels broken, because a subject that left is the one failure that looks exactly\n	-- like the dots never having been attached.\n	local where = if current.model.Parent ~= nil then `dots on \"{current.model.Name}\"` else \"SUBJECT GONE\"\n	return `\"{current.eventId}\" | {where} | {remaining}`\nend\n\nfunction EnactService.SetEnabled(value: boolean)\n	enabled = value\n	if value then\n		return\n	end\n	-- Switching off mid-enactment leaves a prompt whose only way of being answered is\n	-- about to stop existing. Hand each one back to its panel rather than stranding\n	-- it. Collected first for the reason tick() collects: falling back must not run\n	-- inside the traversal.\n	local stranded: { { player: Player, eventId: string } } = {}\n	for player, current in active do\n		table.insert(stranded, { player = player, eventId = current.eventId })\n	end\n	for _, entry in stranded do\n		stop(entry.player)\n		EventService.FallBackToPanel(entry.player, entry.eventId)\n	end\nend\n\nfunction EnactService:Init()\n	-- Injected rather than required the other way around: EventService is what this\n	-- calls to resolve a choice, so it must not know about this file.\n	EventService.SetEnactHandler(begin)\nend\n\nfunction EnactService:Start()\n	EventService.OnAnswered(onAnswered)\n	Players.PlayerRemoving:Connect(stop)\n\n	task.spawn(function()\n		while true do\n			task.wait(Config.Enact.TickSeconds)\n			tick()\n		end\n	end)\nend\n\nreturn EnactService\n"
table.insert(AGES_MANIFEST, "src/server/services/EnactService.luau")
AGES_SOURCES["src/server/services/EventService.luau"] = "--!strict\n-- The event engine. It decides *which* life event fires and validates the\n-- answer; it deliberately does not decide *how* the event reaches the player.\n-- That belongs to the delivery layer on the client, keyed off the event's\n-- `delivery` field, so the world-based presentations arriving with step 3 are a\n-- new client handler rather than a change to anything in here.\n--\n-- One event may be outstanding at a time. It is stored in the profile, which\n-- means an unanswered prompt survives a rejoin and, just as importantly, that\n-- rejoining cannot be used to reroll one the player doesn't like.\n\nlocal Players = game:GetService(\"Players\")\nlocal CollectionService = game:GetService(\"CollectionService\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Config = require(ReplicatedStorage:WaitForChild(\"Config\"))\nlocal Types = require(ReplicatedStorage:WaitForChild(\"Types\"))\nlocal Remotes = require(ReplicatedStorage:WaitForChild(\"Remotes\"))\nlocal Delivery = require(ReplicatedStorage:WaitForChild(\"Delivery\"))\nlocal Lives = require(ReplicatedStorage:WaitForChild(\"Lives\"))\n\nlocal DataService = require(script.Parent.DataService)\nlocal StatService = require(script.Parent.StatService)\nlocal MoneyService = require(script.Parent.MoneyService)\nlocal LifeEvents = require(script.Parent.Parent.content.LifeEvents)\nlocal Flags = require(script.Parent.Parent.content.Flags)\nlocal NPCService = require(script.Parent.NPCService)\n\ntype LifeEvent = Types.LifeEvent\ntype EventChoice = Types.EventChoice\ntype StatName = Types.StatName\ntype OfferedEvent = Types.OfferedEvent\ntype OfferedChoice = Types.OfferedChoice\ntype LifeData = Types.LifeData\ntype EventResolution = Types.EventResolution\n\nlocal EventOfferedRemote = Remotes.Get(\"EventOffered\")\nlocal EventResolvedRemote = Remotes.Get(\"EventResolved\")\nlocal RequestEventChoiceRemote = Remotes.Get(\"RequestEventChoice\")\n\nlocal EventService = {}\n\n-- LifeService injects its AgeUp here at Init. Requiring it directly would be a\n-- cycle, since LifeService already requires this service to offer an event once\n-- a birthday has resolved.\ntype AgeUpHandler = (player: Player, cause: Types.AgeUpCause) -> ()\nlocal ageUpHandler: AgeUpHandler? = nil\n\nfunction EventService.SetAgeUpHandler(handler: AgeUpHandler)\n	ageUpHandler = handler\nend\n\n-- DeliveryService injects this at Init. It stages the follow-up event named by\n-- escalatesTo without EventService having to require DeliveryService back, which\n-- would be a cycle since DeliveryService requires this service at the top level.\ntype EscalationHandler = (player: Player, eventId: string) -> ()\nlocal escalationHandler: EscalationHandler? = nil\n\nfunction EventService.SetEscalationHandler(handler: EscalationHandler)\n	escalationHandler = handler\nend\n\n-- EnactService injects this at Init, for the same reason as above: it calls\n-- ResolveChoice below, so it must be the one that knows about this service and\n-- not the other way round.\n--\n-- Returning false is the *normal* answer, not a failure -- it means the room\n-- could not hold the choices, which is common and always recoverable. This\n-- service never learns why, only that the event is a panel after all.\n--\n-- `subject` is the thing the event is about, standing in the room, or nil when it\n-- is about nothing or nothing could be placed. Passed straight through from the\n-- scene handler and never read here: this service is a courier between the two,\n-- which is what keeps a subject and an enactment from having to know about each\n-- other. It only knows the order to call them in.\ntype EnactHandler = (player: Player, event: LifeEvent, subject: Types.StagedSubject?) -> boolean\nlocal enactHandler: EnactHandler? = nil\n\nfunction EventService.SetEnactHandler(handler: EnactHandler)\n	enactHandler = handler\nend\n\n-- PropService injects this at Init, and it is the third and last way an event can\n-- be answered. Same contract as the enact handler and for the same reason -- false\n-- means the room could not hold the arrangement and the event is a panel after all\n-- -- but what it stages is different in kind. Enactment puts dots on a subject and\n-- still opens a list; this puts the answers themselves in the room as objects, and\n-- there is no list at any point.\n--\n-- It is not passed the subject. A Handled event is about the things you handle, so\n-- the one standing thing an event is \"about\" is either one of those props or is not\n-- in the event at all -- and a handler that took a subject it could never place a\n-- prop on would be an argument nobody could use.\ntype ActHandler = (player: Player, event: LifeEvent) -> boolean\nlocal actHandler: ActHandler? = nil\n\nfunction EventService.SetActHandler(handler: ActHandler)\n	actHandler = handler\nend\n\n-- SceneService injects this at Init. Its return value is not for the client:\n-- a subject changes what is standing in the room, not how the prompt is answered,\n-- so an event whose animal could not be placed is byte-for-byte the same offer as\n-- one that never named a subject. It is for the enact handler, which hangs the dots\n-- on the animal.\ntype SceneHandler = (player: Player, event: LifeEvent) -> Types.StagedSubject?\nlocal sceneHandler: SceneHandler? = nil\n\nfunction EventService.SetSceneHandler(handler: SceneHandler)\n	sceneHandler = handler\nend\n\n-- SceneService injects this too, and it is the other half of the same idea: the\n-- scene handler above is told an event has opened, and this one is told how it\n-- was answered, so that the thing standing in the room can do what the outcome\n-- line says it did.\n--\n-- A handler rather than something read off the profile, because which choice was\n-- taken is not saved anywhere -- and should not be. It matters for the few seconds\n-- an animal is still in the room and never again, so persisting it would be\n-- writing a field to a DataStore to carry a value across four seconds.\n--\n-- Fired for every answer, however it was given. Watching the dog come to you is\n-- worth the same whether you crossed the room to click it or answered on a panel\n-- where you stood, and an ending that only arrived when there had been something to\n-- hang dots on would be a worse feature than no ending at all.\n-- A list rather than a single slot, unlike every other injection point above.\n-- Those are each one service's job -- there is one way to stage a scene and one\n-- way to enact a choice -- but \"an answer was given\" is news that more than one\n-- service legitimately wants: the scene reacts to it, and work records it against\n-- your job. A setter would have made the second one silently replace the first.\ntype AnsweredHandler = (player: Player, event: LifeEvent, choice: EventChoice) -> ()\nlocal answeredHandlers: { AnsweredHandler } = {}\n\nfunction EventService.OnAnswered(handler: AnsweredHandler)\n	table.insert(answeredHandlers, handler)\nend\n\n-- PeopleService injects this at Start. It returns the tie-context tags for a\n-- player as an iterator over strings, so EventService can build the full context\n-- set without requiring PeopleService back and stalling on the cycle.\ntype TieContextBuilder = (player: Player) -> { string }\nlocal tieContextBuilder: TieContextBuilder? = nil\n\nfunction EventService.SetTieContextBuilder(handler: TieContextBuilder)\n	tieContextBuilder = handler\nend\n\n-- Puts the thing the event is about in the room, if it is about anything and if\n-- there is anywhere to put it, and reports where it will come to rest.\n--\n-- Called *before* beginResolution at every site that opens a prompt, and the order\n-- is the whole reason enactment works: the dots hang on the subject, so the subject\n-- has to be in the room before there is anything to hang them on.\nlocal function beginScene(player: Player, event: LifeEvent): Types.StagedSubject?\n	if sceneHandler == nil then\n		return nil\n	end\n	return sceneHandler(player, event)\nend\n\n-- Outcome lines, stat effects, payouts and how your employer will take it are all\n-- withheld until a choice is made, so the best answer can't be read straight off\n-- the payload -- least of all the work moments, where the choice that is best for\n-- you and the one that is best for your record are deliberately not the same, and\n-- a visible performance number would collapse that into arithmetic. Note the shape\n-- rather than the omission does the work here: this builds each choice field by\n-- field, so anything added to EventChoice is server-only until someone says\n-- otherwise. Costs are the one thing\n-- that has to go the other way -- an unpriced purchase is not a decision -- and\n-- with them goes the server's verdict on whether the player can meet each one.\n--\n-- Takes the balance rather than the player because it is a pure translation, and\n-- every caller has the profile open already: reading it again in here would be a\n-- second lookup that could, in principle, see a different number than the one the\n-- caller is acting on.\nlocal function toOffered(event: LifeEvent, resolution: EventResolution, balance: number): OfferedEvent\n	local choices: { OfferedChoice } = {}\n	for _, choice in event.choices do\n		local cost = choice.cost\n		table.insert(choices, {\n			id = choice.id,\n			label = choice.label,\n			cost = cost,\n			locked = cost ~= nil and balance < cost,\n		})\n	end\n	return {\n		id = event.id,\n		delivery = event.delivery,\n		prompt = event.prompt,\n		choices = choices,\n		resolution = resolution,\n	}\nend\n\n-- Puts the choices in the room if the event asked for that and the room can hold\n-- them. Returns what the client should actually be told, which is the only thing\n-- any caller needs -- \"Panel\" covers both an event that never wanted enacting and\n-- one that wanted it and could not have it.\n--\n-- Deliberately called *before* the offer is sent rather than after. The dots are up\n-- by the time the banner appears, so there is no window in which the player is told\n-- to go and click something that is not yet clickable.\nlocal function beginResolution(\n	player: Player,\n	event: LifeEvent,\n	wanted: EventResolution?,\n	subject: Types.StagedSubject?\n): EventResolution\n	if wanted == \"Handled\" and actHandler ~= nil then\n		if actHandler(player, event) then\n			return \"Handled\"\n		end\n		-- Falls all the way back to a panel rather than trying enactment next. A\n		-- Handled event's answers are written to be done, not clicked at a distance,\n		-- so there is nothing sensible to hang dots on when the props would not fit.\n		return \"Panel\"\n	end\n	if wanted ~= \"Enacted\" or enactHandler == nil then\n		return \"Panel\"\n	end\n	return if enactHandler(player, event, subject) then \"Enacted\" else \"Panel\"\nend\n\n-- The single eligibility rule, so a world object offering an event by name and\n-- a birthday rolling for one can never disagree about what may fire.\n--\n-- A repeatable event stays eligible after it has been lived, which is the one\n-- exception to the seen list. It has to live *here* rather than only in the picker\n-- below: WorkService picks an event and then offers it by name through\n-- OfferIfEligible, so a rule the picker knew and this did not would show up as\n-- shifts whose moment was chosen and then silently refused on the way out.\nlocal function isEligible(data: LifeData, event: LifeEvent, ageYears: number): boolean\n	if ageYears < event.minAge or ageYears > event.maxAge then\n		return false\n	end\n	-- Checked alongside age rather than in the picker, for the same reason the seen\n	-- list is: a world object that offers an event by name comes through\n	-- OfferIfEligible, and a branch the picker respected and this did not would be a\n	-- lure the player crossed a room for and was then refused at.\n	if not Flags.Meets(data.flags, event.requires, event.forbids) then\n		return false\n	end\n	-- Cooldown is a delivery-rate limiter, not a one-time block. A missed call\n	-- should come back; the timer tracks \"don't send another of these too soon.\"\n	if event.cooldown ~= nil and event.cooldown > 0 then\n		local started = data.cooldownTimers[event.id]\n		if started ~= nil and os.clock() < started then\n			return false\n		end\n	end\n	return not data.seenEventIds[event.id] or event.repeatable == true\nend\n\nlocal function characterPosition(player: Player): Vector3?\n	local character = player.Character\n	if character == nil then\n		return nil\n	end\n	return character:GetPivot().Position\nend\n\n-- What the player's current world situation looks like, as a set of tags the\n-- picker can use to prefer events that belong here. Three sources: nearby\n-- NPCs emit \"npc:{cast}\", tagged floor parts emit \"zone:{id}\", and each flag\n-- listed in Config.Ambient.FlagContext emits \"flag:{id}\" when held.\n--\n-- An event with no tags fires anywhere. An event with tags fires here only\n-- when at least one of its tags appears in this set -- or when no tagged\n-- candidate exists, in which case the event still fires so the world is not\n-- starved for content. The set is rebuilt every tick, so it always reflects\n-- the player's current position and flags.\nfunction EventService.getContextTags(player: Player): { [string]: boolean }\n	local tags: { [string]: boolean } = {}\n	local function add(tag: string)\n		tags[tag] = true\n	end\n\n	local radius = Config.Ambient.NPCContextRadius\n	local playerPos = characterPosition(player)\n	if playerPos ~= nil then\n		for _, posInfo in NPCService.GetPositions() do\n			local distance = (playerPos - posInfo.position).Magnitude\n			if distance <= radius then\n				add(\"npc:\" .. posInfo.id)\n			end\n		end\n\n		-- Tie-context tags: when the player is near somebody they have a rival,\n		-- mentor, or sibling tie with, the picker can prefer events keyed to that\n		-- relationship. Set by PeopleService at Start to keep the dependency\n		-- one-way: PeopleService already requires EventService at the top level.\n		if tieContextBuilder ~= nil then\n			for _, tag in tieContextBuilder(player) do\n				add(tag)\n			end\n		end\n	end\n\n	for _, part in CollectionService:GetTagged(Config.World.ZoneTag) do\n		local zoneId = part:GetAttribute(Config.World.ZoneAttribute)\n		if zoneId ~= nil and typeof(zoneId) == \"string\" then\n			local partPos = (part :: BasePart).Position\n			if partPos ~= nil\n				and playerPos ~= nil\n				and (playerPos - partPos).Magnitude <= Config.World.ZoneContextRadius\n			then\n				add(\"zone:\" .. zoneId)\n			end\n		end\n	end\n\n	for flagId in Config.Ambient.FlagContext :: { string } do\n		add(\"flag:\" .. flagId)\n	end\n\n	return tags\nend\n\n-- Whether an event's tags match the current context, or the event has no tags\n-- (making it universal). Used by the picker to filter candidates against\n-- context without breaking when context is nil.\nlocal function tagsMatchContext(\n	event: LifeEvent,\n	contextTags: { [string]: boolean }?\n): boolean\n	if contextTags == nil or event.tags == nil or #event.tags == 0 then\n		return true\n	end\n	for _, tag in event.tags do\n		if contextTags[tag] == true then\n			return true\n		end\n	end\n	return false\nend\n\n-- Weighted pick among the events eligible right now whose delivery takes the\n-- given route. Routing by table rather than by name is what keeps a birthday\n-- from ever handing over a letter: a mode is only reachable from the one system\n-- that owns its route, and adding a mode without classifying it fails to compile\n-- in Delivery.luau rather than leaking into the wrong pool here.\nlocal function pickForRoute(\n	data: LifeData,\n	ageYears: number,\n	route: Delivery.Route,\n	filter: ((LifeEvent) -> boolean)?,\n	contextTags: { [string]: boolean }?\n): LifeEvent?\n	-- Two pools, and the first non-empty one wins. Something the player has never\n	-- lived always beats something they have, however heavily the repeat is\n	-- weighted -- so a repeatable event can never crowd out fresh content, and the\n	-- authored moments of a life are all spent before any of them comes round again.\n	--\n	-- Weights are only ever compared within a pool, which is what makes that\n	-- guarantee absolute rather than statistical.\n	--\n	-- contextTags is used to prefer events whose tags match the current world\n	-- situation. An event with no tags is always eligible; an event with tags\n	-- is eligible only when at least one of its tags is in the context set --\n	-- unless no tagged candidate exists, in which case all candidates qualify.\n	local function pickInto(allowUntagged: boolean): (boolean, { LifeEvent }, { number }, number, { LifeEvent }, { number }, number)\n		local fresh: { LifeEvent } = {}\n		local freshWeights: { number } = {}\n		local freshTotal = 0\n		local repeats: { LifeEvent } = {}\n		local repeatWeights: { number } = {}\n		local repeatTotal = 0\n		local hasTagged = false\n\n		for _, event in LifeEvents.All do\n			local presentable = filter == nil or filter(event)\n			if not (presentable\n				and Delivery.RouteOf(event.delivery) == route\n				and isEligible(data, event, ageYears))\n			then\n				continue\n			end\n\n			local hasTags = event.tags ~= nil and #event.tags > 0\n			if contextTags ~= nil and hasTags then\n				if not tagsMatchContext(event, contextTags) then\n					continue\n				end\n				hasTagged = true\n			elseif contextTags ~= nil and not hasTags and not allowUntagged then\n				continue\n			end\n\n			local weight = event.weight or 1\n			if data.seenEventIds[event.id] then\n				table.insert(repeats, event)\n				table.insert(repeatWeights, weight)\n				repeatTotal += weight\n			else\n				table.insert(fresh, event)\n				table.insert(freshWeights, weight)\n				freshTotal += weight\n			end\n		end\n\n		return hasTagged, fresh, freshWeights, freshTotal, repeats, repeatWeights, repeatTotal\n	end\n\n	local hasTagged, fresh, freshWeights, freshTotal, repeats, repeatWeights, repeatTotal = pickInto(false)\n\n	-- Second pass: if nothing tagged matched, allow untagged events through so the\n	-- world is not starved for content when no authored route exists for the\n	-- current context.\n	if not hasTagged and contextTags ~= nil then\n		hasTagged, fresh, freshWeights, freshTotal, repeats, repeatWeights, repeatTotal = pickInto(true)\n	end\n\n	local candidates = if freshTotal > 0 then fresh else repeats\n	local weights = if freshTotal > 0 then freshWeights else repeatWeights\n	local totalWeight = if freshTotal > 0 then freshTotal else repeatTotal\n\n	-- Nothing unlived is eligible and nothing lived may be lived again. Running dry\n	-- is a content gap, not an error: the year simply passes without one.\n	if totalWeight <= 0 then\n		return nil\n	end\n\n	local roll = math.random() * totalWeight\n	for index, event in candidates do\n		roll -= weights[index]\n		if roll <= 0 then\n			return event\n		end\n	end\n	return candidates[#candidates]\nend\n\n-- `resolution` overrides what the event asked for, and exists for the Studio\n-- harness: forcing an event to enact is how a new one is proof-read, and forcing\n-- it to a panel is how the fallback is tested without waiting out the clock.\n-- Returns whether the prompt actually went out, so `OfferIfEligible` can keep its promise\n-- that false means \"inert right now\" -- which a player still choosing a life is.\nlocal function offer(player: Player, data: LifeData, event: LifeEvent, resolution: EventResolution?): boolean\n	-- The choke point the setup menu really hangs on. Every route to a prompt -- a birthday,\n	-- an ambient delivery reached on foot, a shift, a lesson, the debug harness -- arrives\n	-- here, so one check makes \"a question asked of somebody who has not chosen a life yet\"\n	-- unrepresentable rather than merely unlikely. The alternative was a `paused` test in\n	-- each of six tick loops, which works exactly until the seventh loop is written.\n	--\n	-- Silent rather than a warn: this is a normal state, not a fault. The world behind the\n	-- menu is deliberately still alive -- the town walks, so the player can see what they\n	-- are about to be born into -- and it will occasionally decide something is due. It\n	-- simply does not get to interrupt.\n	if not Lives.HasBegun(data) then\n		return false\n	end\n\n	data.pendingEventId = event.id\n	data.pendingEventCountInChapter += 1\n	-- Track world vs modal for the 70/30 ratio. Shift events are excluded —\n	-- they are structurally different and managed by WorkService, not the life.\n	local route = Delivery.RouteOf(event.delivery)\n	if route == \"Immediate\" then\n		data.modalEventsThisChapter += 1\n	elseif route ~= \"Shift\" then\n		data.worldEventsThisChapter += 1\n	end\n	-- Whatever the world was holding has now been reached, so the world stops\n	-- holding it. Cleared here, at the moment the prompt opens, rather than by\n	-- the delivery layer afterwards: that makes \"a prompt is open while the\n	-- letter is still on the mat\" unrepresentable instead of merely unlikely.\n	if data.deliveringEventId == event.id then\n		data.deliveringEventId = nil\n	end\n	-- Written to the profile before anything goes near the room. Both the scene and\n	-- the enactment watch pendingEventId to know they are still wanted, so setting\n	-- it second would give either a tick in which it believed it had already been\n	-- superseded.\n	--\n	-- Subject first, then the choices around it: an answer given by walking should\n	-- be given by walking somewhere that means something, and there is nothing for\n	-- \"aside\" to be aside *of* -- nor anything for an \"at\" choice to be worn by --\n	-- until the thing the event is about is standing there.\n	local subject = beginScene(player, event)\n	local actual = beginResolution(player, event, resolution or event.resolution, subject)\n	EventOfferedRemote:FireClient(player, toOffered(event, actual, data.money))\n	return true\nend\n\n-- Re-sends a prompt that is already open, as a panel. This is the one way out of\n-- an enactment that was never completed -- a player who cannot find the animal,\n-- cannot reach it, or simply does not want to walk -- and it is deliberately\n-- not a cancellation: the same event, the same choices, nothing consumed, only a\n-- different way of answering.\n--\n-- Guarded on the id so a fallback that arrives late, after the player answered\n-- some other way, cannot reopen a question that is already settled.\nfunction EventService.FallBackToPanel(player: Player, eventId: string)\n	local profile = DataService.GetProfile(player)\n	if profile == nil or not Lives.Active(profile.Data).alive then\n		return\n	end\n	if Lives.Active(profile.Data).pendingEventId ~= eventId then\n		return\n	end\n\n	local event = LifeEvents.ById[eventId]\n	if event == nil then\n		warn(`[AGES] pending event \"{eventId}\" no longer exists; dropping it`)\n		Lives.Active(profile.Data).pendingEventId = nil\n		return\n	end\n\n	EventOfferedRemote:FireClient(player, toOffered(event, \"Panel\", Lives.Active(profile.Data).money))\nend\n\n-- Called by LifeService once a birthday has finished resolving.\nfunction EventService.OfferForAge(player: Player, ageYears: number)\n	local profile = DataService.GetProfile(player)\n	if profile == nil or not Lives.Active(profile.Data).alive then\n		return\n	end\n\n	local data = Lives.Active(profile.Data)\n	-- An unanswered prompt still stands. Stacking a second one on top would let\n	-- the first quietly disappear along with the choice it was asking for.\n	if data.pendingEventId ~= nil then\n		return\n	end\n\n	-- 70/30 ratio: a chapter should be mostly world-spawned. An Immediate event\n	-- counts as modal, so refuse it if the world has not earned its share yet.\n	-- With MaxPerChapter=3 this means at most one modal event per chapter.\n	if data.worldEventsThisChapter * 10 < data.modalEventsThisChapter * 3 then\n		return\n	end\n\n	-- Immediate only. A birthday hands over the events that have nowhere to be:\n	-- staging a letter here would announce mail the player never went to fetch.\n	-- Context tags are not passed: a birthday is age-gated, not location-gated.\n	local event = pickForRoute(data, ageYears, \"Immediate\", nil, nil)\n	if event ~= nil then\n		offer(player, data, event)\n	end\nend\n\n-- Picks something the world could stage right now *without* offering it, and\n-- without writing anything to the profile. The ambient scheduler has to know\n-- what it is staging before the player has reached it -- a letter and a ringing\n-- phone are different objects -- so selection and offering are two steps here in\n-- a way they never are for a birthday. The caller is responsible for the profile\n-- write, and OfferIfEligible re-checks everything when the player arrives.\n--\n-- The Ambient route consumes an autonomy point: the player has to earn each\n-- event by working, studying, or visiting, so the world is a response to what\n-- they do rather than a noise machine. Shift and Immediate routes bypass the\n-- gate -- a shift event is the reward for the shift itself, and a birthday is\n-- the chapter spine; neither should stall because the player has not visited\n-- enough people this chapter.\nfunction EventService.PickStageable(\n	player: Player,\n	route: Delivery.Route,\n	filter: ((LifeEvent) -> boolean)?,\n	contextTags: { [string]: boolean }?\n): LifeEvent?\n	local profile = DataService.GetProfile(player)\n	if profile == nil or not Lives.Active(profile.Data).alive then\n		return nil\n	end\n\n	local data = Lives.Active(profile.Data)\n	if data.pendingEventId ~= nil or data.deliveringEventId ~= nil then\n		return nil\n	end\n\n	local ageYears = data.ageMonths // Config.Time.MonthsPerYear\n	if data.pendingEventCountInChapter >= Config.Events.MaxPerChapter then\n		return nil\n	end\n	-- The autonomy gate. Only the Ambient path spends a point; everything\n	-- else is free.\n	if route == \"Ambient\" and data.autonomyPoints <= 0 then\n		return nil\n	end\n	return pickForRoute(data, ageYears, route, filter, contextTags)\nend\n\n-- Spend one autonomy point. Returns true when the player had a point to spend\n-- and false when they are out. Called after a successful ambient stage so the\n-- cost is only paid when the world actually put something on the mat.\nfunction EventService.SpendAutonomy(player: Player): boolean\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return false\n	end\n	local data = Lives.Active(profile.Data)\n	if data.autonomyPoints <= 0 then\n		return false\n	end\n	data.autonomyPoints -= 1\n	return true\nend\n\n-- Add autonomy points, capped at the chapter ceiling. Called by the services\n-- that generate them -- WorkService on shift finish, the lesson services on\n-- lesson end, PeopleService on first visit -- so the cap is the single place\n-- that keeps the counter from drifting above the event cap.\nfunction EventService.AwardAutonomy(player: Player, count: number)\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return\n	end\n	local data = Lives.Active(profile.Data)\n	local next = data.autonomyPoints + count\n	if next > Config.Autonomy.MaxPerChapter then\n		next = Config.Autonomy.MaxPerChapter\n	end\n	data.autonomyPoints = next\nend\n\n-- Picks an Ambient event weighted by the player's current context tags and\n-- placed at the nearest matching NPC. The picker prefers events whose tags\n-- match the live context; if none match, it falls back to untagged events.\n-- This is what the proximity path calls rather than the timer path.\nfunction EventService.PickNearby(player: Player): LifeEvent?\n	local profile = DataService.GetProfile(player)\n	if profile == nil or not Lives.Active(profile.Data).alive then\n		return nil\n	end\n\n	local data = Lives.Active(profile.Data)\n	if data.pendingEventId ~= nil or data.deliveringEventId ~= nil then\n		return nil\n	end\n\n	if data.pendingEventCountInChapter >= Config.Events.MaxPerChapter then\n		return nil\n	end\n\n	local ageYears = data.ageMonths // Config.Time.MonthsPerYear\n	local contextTags = EventService.getContextTags(player)\n	return pickForRoute(data, ageYears, \"Ambient\", nil, contextTags)\nend\n\n-- Public so the Studio harness can force a specific event without rolling for\n-- it. Returns false when the id doesn't exist, and also when there is no life to\n-- offer it to -- a profile still sitting in the setup menu -- so the caller can say\n-- so. `resolution` overrides how it is answered, which is how /enact proof-reads an\n-- event that is not authored Enacted.\nfunction EventService.ForceOffer(player: Player, eventId: string, resolution: EventResolution?): boolean\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return false\n	end\n	local event = LifeEvents.ById[eventId]\n	if event == nil then\n		return false\n	end\n	return offer(player, Lives.Active(profile.Data), event, resolution)\nend\n\n-- Offers a *named* event, but only if the engine would have allowed it anyway.\n-- This is what a tagged object in the world calls: the object says where the\n-- event lives, this decides whether the player may have it. Returns false for\n-- every ordinary reason an object is inert right now — wrong age, already\n-- lived, a prompt still open, dead — so callers must not treat false as a\n-- fault. A missing id is the one real error and warns on the caller's side.\nfunction EventService.OfferIfEligible(player: Player, eventId: string): boolean\n	local profile = DataService.GetProfile(player)\n	if profile == nil or not Lives.Active(profile.Data).alive then\n		return false\n	end\n\n	local data = Lives.Active(profile.Data)\n	if data.pendingEventId ~= nil then\n		return false\n	end\n\n	local event = LifeEvents.ById[eventId]\n	if event == nil then\n		return false\n	end\n\n	local ageYears = data.ageMonths // Config.Time.MonthsPerYear\n	if not isEligible(data, event, ageYears) then\n		return false\n	end\n\n	return offer(player, data, event)\nend\n\nfunction EventService.ClearPending(player: Player)\n	local profile = DataService.GetProfile(player)\n	if profile ~= nil then\n		Lives.Active(profile.Data).pendingEventId = nil\n	end\nend\n\n-- A new life may live the same moments again, so the seen list is per-life.\n-- deliveringEventId goes with it: a letter addressed to the person who just died\n-- is not still on the mat for the child who replaces them. The physical object\n-- is DeliveryService's to remove -- this clears the state that authorizes it.\nfunction EventService.ResetSeen(player: Player)\n	local profile = DataService.GetProfile(player)\n	if profile ~= nil then\n		Lives.Active(profile.Data).seenEventIds = {}\n		-- Goes with the seen list rather than persisting: flags are what *this* life\n		-- did, and a new one inheriting them would open branches for a child who has\n		-- no memory of earning them.\n		Lives.Active(profile.Data).flags = {}\n		Lives.Active(profile.Data).pendingEventId = nil\n		Lives.Active(profile.Data).deliveringEventId = nil\n	end\nend\n\nlocal function findChoice(event: LifeEvent, choiceId: string): EventChoice?\n	for _, choice in event.choices do\n		if choice.id == choiceId then\n			return choice\n		end\n	end\n	return nil\nend\n\n-- The one place a choice is ever applied. There is only one remote now -- the panel\n-- opens the same way whether the player clicked a row on a birthday card or three\n-- dots on a dog -- and this is where it lands. That is what keeps enactment from\n-- being a second way to pay out an event, and more to the point from being a second\n-- set of rules about when that is allowed.\n--\n-- Returns whether the answer was taken, so a caller that has just taken its dots\n-- down can tell a real answer from one that arrived too late.\nfunction EventService.ResolveChoice(player: Player, eventId: string, choiceId: string): boolean\n	local profile = DataService.GetProfile(player)\n	if profile == nil or not Lives.Active(profile.Data).alive then\n		return false\n	end\n\n	local data = Lives.Active(profile.Data)\n	if data.pendingEventId == nil or data.pendingEventId ~= eventId then\n		-- Already answered, never offered, or forged. A duplicate press lands\n		-- here too, which is what stops one prompt paying out twice.\n		return false\n	end\n\n	local event = LifeEvents.ById[eventId]\n	if event == nil then\n		-- The pending id survived in a profile but the content is gone.\n		warn(`[AGES] pending event \"{eventId}\" no longer exists; dropping it`)\n		data.pendingEventId = nil\n		return false\n	end\n\n	local choice = findChoice(event, choiceId)\n	if choice == nil then\n		return false\n	end\n\n	-- Affordability is a guard like every other one above, not a step in applying the\n	-- answer: a choice the player cannot pay for was never a legal answer. Checked\n	-- here even though the client was already told the choice was locked, because\n	-- that flag is a courtesy and this is the rule -- a forged remote and a panel left\n	-- open from a question that has already been settled both arrive at this line.\n	--\n	-- Before anything is consumed, so a refusal costs the player nothing. The prompt\n	-- is still open and every other answer is still available.\n	local cost = choice.cost\n	if cost ~= nil and not MoneyService.CanAfford(player, cost) then\n		return false\n	end\n\n	-- Consumed before any stat is written, so a retry arriving behind this one\n	-- fails the pending check above rather than applying the effects twice.\n	data.pendingEventId = nil\n	data.seenEventIds[event.id] = true\n\n	-- Flags go in with the seen mark, in the same block of straight-line code with\n	-- nothing between them that can yield or fail. What you did and the fact that you\n	-- did it are one write: a life that recorded the answer but not its consequence\n	-- would go on to be a life the branch never opened for, with nothing anywhere\n	-- saying why.\n	--\n	-- Cleared before set, so a choice that does both ends up holding what it sets.\n	-- That ordering is the only thing that makes exclusive pairs writable in one\n	-- answer, which is most of what `clears` is for.\n	local ageYears = data.ageMonths // Config.Time.MonthsPerYear\n	if choice.clears ~= nil then\n		for _, flagId in choice.clears do\n			data.flags[flagId] = nil\n		end\n	end\n	if choice.sets ~= nil then\n		for _, flagId in choice.sets do\n			-- Not overwritten if already held: the age on a flag is when the life\n			-- first did this, and a repeatable event re-earning it should not quietly\n			-- move a childhood memory to the present.\n			if data.flags[flagId] == nil then\n				data.flags[flagId] = ageYears\n			end\n		end\n	end\n\n	-- Money before stats, and both before the client is told anything. Affordability\n	-- was established a few lines up with no yield in between, so Spend cannot fail\n	-- here -- and says so loudly if it somehow does, rather than letting an event\n	-- hand out its effects for free.\n	if cost ~= nil then\n		MoneyService.Spend(player, cost, `{event.id}:{choice.id}`)\n	end\n	local payout = choice.payout\n	if payout ~= nil then\n		MoneyService.Add(player, payout, `{event.id}:{choice.id}`)\n	end\n\n	-- Iterating a keyed table widens the key back to string, so the cast puts\n	-- back what StatDelta already guarantees.\n	for statName, delta in choice.effects do\n		StatService.AddStat(player, statName :: StatName, delta)\n	end\n\n	-- No death check here on purpose. LifeService already tests health every\n	-- tick, so a choice that empties it is lethal within the second without\n	-- this service needing to reach into the life cycle.\n	EventResolvedRemote:FireClient(player, event.id, choice.outcome)\n\n	-- Told at the same moment as the client, so whatever is standing in the room\n	-- starts reacting on the frame the outcome appears rather than after it. Called\n	-- here rather than at the top of the function because a choice that failed any\n	-- guard above never happened, and nothing should react to it.\n	--\n	-- Each listener is isolated, because they are unrelated to each other and one\n	-- throwing must not cost the others their news -- an animal that failed to react\n	-- should not also mean the shift quietly forgot how you answered it. Loud, not\n	-- swallowed: the warning names the event so the fault is findable.\n	for _, handler in answeredHandlers do\n		local ok, err = pcall(handler, player, event, choice)\n		if not ok then\n			warn(`[AGES] an answered-handler failed for \"{event.id}\":\"{choice.id}\": {err}`)\n		end\n	end\n\n	-- In the toddler years answering an event *is* the year passing, so a child\n	-- grows by living rather than by waiting out a timer. Deliberately not true\n	-- above EndAge: from there a year holds many events, and advancing on each\n	-- would burn a whole life in minutes. The age-up offers the next year's\n	-- event in turn, which is what chains childhood together.\n	--\n	-- Still the age read at the top of this function, before any of the answer was\n	-- applied, which is the right one: nothing here moves the clock, and the flags\n	-- written above were earned at the age the player was when they answered.\n	if ageYears <= Config.Childhood.EndAge and ageUpHandler ~= nil then\n		ageUpHandler(player, \"Event\")\n	end\n\n	-- Escalation chain: if this event named a follow-up, stage it now. The\n	-- follow-up is a world delivery (Ambient route), not a modal panel -- it\n	-- arrives when the player reaches it, not as a surprise prompt. If the\n	-- follow-up is not stageable (age, flags, cooldown, etc.), the chain\n	-- simply stops; no warning, no error.\n	if event.escalatesTo ~= nil and escalationHandler ~= nil then\n		escalationHandler(player, event.escalatesTo)\n	end\n\n	return true\nend\n\n-- Both arguments arrive from the client and are therefore untrusted, including\n-- their types. Everything past the type check is the shared path above, so the\n-- remote adds no rule of its own -- it only proves it was handed two strings.\nlocal function onChoiceRequested(player: Player, eventId: any, choiceId: any)\n	if typeof(eventId) ~= \"string\" or typeof(choiceId) ~= \"string\" then\n		return\n	end\n	EventService.ResolveChoice(player, eventId, choiceId)\nend\n\n-- Re-offers whatever was left unanswered when the player last left.\nlocal function pushPending(player: Player)\n	local profile = DataService.WaitForProfile(player)\n	if profile == nil then\n		return\n	end\n\n	local data = Lives.Active(profile.Data)\n	local pendingId = data.pendingEventId\n	if pendingId == nil or not data.alive then\n		return\n	end\n\n	local event = LifeEvents.ById[pendingId]\n	if event == nil then\n		warn(`[AGES] pending event \"{pendingId}\" no longer exists; dropping it`)\n		data.pendingEventId = nil\n		return\n	end\n\n	-- Re-enacted rather than restored. The animal stood wherever the player was when\n	-- the prompt first opened, in a session that has since ended; putting it in the\n	-- room they are in *now* is both simpler and more correct than remembering where\n	-- it used to be.\n	--\n	-- If the character has not spawned yet this lands on the panel, which is the\n	-- honest outcome -- there is nothing to walk to and nobody to walk. The profile\n	-- has already been waited on above, which is a DataStore round trip, so in\n	-- practice the character is nearly always there.\n	--\n	-- Re-staged in the same order as a fresh offer, and for the same reason: the\n	-- animal stood wherever the player was when the prompt first opened, and that\n	-- was a different session, so it has to be placed again before the choices can\n	-- be arranged around it.\n	local subject = beginScene(player, event)\n	local actual = beginResolution(player, event, event.resolution, subject)\n	EventOfferedRemote:FireClient(player, toOffered(event, actual, data.money))\nend\n\nfunction EventService:Init()\n	RequestEventChoiceRemote.OnServerEvent:Connect(onChoiceRequested)\nend\n\nfunction EventService:Start()\n	Players.PlayerAdded:Connect(function(player: Player)\n		task.spawn(pushPending, player)\n	end)\n\n	for _, player in Players:GetPlayers() do\n		task.spawn(pushPending, player)\n	end\nend\n\nreturn EventService\n"
table.insert(AGES_MANIFEST, "src/server/services/EventService.luau")
AGES_SOURCES["src/server/services/FightService.luau"] = "--!strict\n-- Fighting: the contest for footing, and the only thing in AGES two people do to each\n-- other with their hands.\n--\n-- The loop:\n--\n--   Somebody is stood in the street with dots over their head. You take the square-up,\n--   and from then until one of you is on the floor there are three buttons. Hold Strike\n--   to wind up and let go to commit; hold Guard to turn their strike into a stamina\n--   problem instead of a footing one; tap Sidestep to make it miss entirely. Footing\n--   runs out, somebody goes down, and a few seconds later they get up again.\n--\n-- **Nobody is hurt here and there is nothing in this file that could hurt them.** There\n-- is no health on a fighter, no damage number, no injury and no death. What runs out is\n-- footing, and going down is a pose with a timer on it. That is not a rating decision\n-- applied on top of a combat system -- it is the combat system, which is why there is\n-- no switch anywhere to make it bloodier.\n--\n-- ## What makes it a fight and not a race\n--\n-- Three rules do all the work, and each exists to close a degenerate line:\n--\n--   **A strike never interrupts a wind-up.** Hit somebody who is mid-swing and you both\n--   land -- you trade. Without this the whole game is \"press Strike whenever they start\n--   winding\", and the brawler's enormous tell becomes the easiest thing in the file\n--   instead of the hardest. With it, trading is a real option that is good against a\n--   scrapper hitting for eight and terrible against a brawler hitting for twenty.\n--\n--   **Only a sidestep negates a strike outright**, and it puts the attacker into the\n--   longest recovery in the game. That is what makes the expensive button worth its\n--   stamina, and it is the answer the brawler is built to teach.\n--\n--   **Only a charge held past GuardBreakShare breaks a guard**, which is deep enough\n--   into the meter to be inside overcharge -- so breaking a boxer's guard and eating a\n--   near-second of recovery are the same decision. There is no safe answer to a guard,\n--   only a bet.\n--\n-- Take any one of those away and the other two stop mattering within an afternoon.\n--\n-- ## What this file owns and what it does not\n--\n-- It owns the bout: one per player, at most. It still does not own ties or records --\n-- fighting does not touch Ties.luau's ladder, on purpose, because Fighters.luau's own\n-- header explains why the population you fight cannot be the population you befriend.\n-- It does own two small consequences now, both deliberately soft, because combat is\n-- legal in AGES and a fight is a contest with a winner, not a crime:\n--\n--   **Heat, but only if caught.** A fight is not a crime, but a brawl loud enough for\n--   a stranger to watch the whole way through is still a disturbance -- so `decide`\n--   rolls the crowd once, at the end, rather than wiring in WitnessService's continuous\n--   fill. A bout is over in twenty seconds, too short for a look-then-fill gesture to\n--   read as anything but instant, so it is asked once and it is asked quietly: most\n--   fights cost nothing at all, which is the whole of \"unless caught\".\n--\n--   **Notoriety, on a win.** LifeData.notoriety, paid win-only and never taken back on\n--   a loss, same ratchet gang standing and crew nerve already use. It is a straight\n--   count of fights won and nothing spends it yet.\n--\n-- A rival gang's enforcer additionally moves gang standing on a win -- see\n-- FightService.ChallengeRival -- because that fight was never a street fight to begin\n-- with, it was TerritoryService's ladder wearing a body.\n--\n-- The other exception is the pair of stat outcomes at the bottom, and they are here\n-- because an activity whose outcomes do not differ is the anti-pattern this project has\n-- already shipped once. Losing costs health, health sets your footing pool, and a\n-- shorter bar is what a losing streak feels like from inside the mechanic.\n\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Config = require(ReplicatedStorage:WaitForChild(\"Config\"))\nlocal Lives = require(ReplicatedStorage:WaitForChild(\"Lives\"))\nlocal Remotes = require(ReplicatedStorage:WaitForChild(\"Remotes\"))\nlocal Types = require(ReplicatedStorage:WaitForChild(\"Types\"))\nlocal Interact = require(ReplicatedStorage:WaitForChild(\"world\"):WaitForChild(\"Interact\"))\n\nlocal DataService = require(script.Parent.DataService)\nlocal NPCService = require(script.Parent.NPCService)\nlocal StatService = require(script.Parent.StatService)\nlocal SkillService = require(script.Parent.SkillService)\nlocal GangService = require(script.Parent.GangService)\nlocal PeopleService = require(script.Parent.PeopleService)\nlocal TerritoryService = require(script.Parent.TerritoryService)\n\nlocal Fighters = require(script.Parent.Parent.content.Fighters)\nlocal Gangs = require(script.Parent.Parent.content.Gangs)\nlocal Colors = require(script.Parent.Parent.world.Colors)\nlocal Ground = require(script.Parent.Parent.world.Ground)\n\ntype FighterDef = Types.FighterDef\ntype FightState = Types.FightState\ntype Visitor = NPCService.Visitor\n\nlocal FightService = {}\n\nlocal FightUpdatedRemote = Remotes.Get(\"FightUpdated\")\nlocal RequestFightActionRemote = Remotes.Get(\"RequestFightAction\")\nlocal RequestFightSquareRemote = Remotes.Get(\"RequestFightSquare\")\nlocal NoticeRemote = Remotes.Get(\"Notice\")\n\nlocal FIGHT = Config.Fight\nlocal SKILL_AWARDS = Config.Skills.Awards\n\n-- Handed over rather than required, because BountyService requires LifeService, which\n-- requires this module -- requiring BountyService back would close that cycle. The same\n-- device SetupService uses for LifeService's own begin handler.\ntype WitnessedHandler = (player: Player, points: number, reason: string, at: Vector3) -> ()\nlocal witnessedHandler: WitnessedHandler? = nil\n\nfunction FightService.SetWitnessedHandler(handler: WitnessedHandler)\n	witnessedHandler = handler\nend\n\n-- The one relationship between two Config numbers that the whole triangle rests on, checked\n-- loudly at require time because it fails silently in play.\n--\n-- If a guard can be broken below the overcharge mark, then there is a charge that beats a\n-- guard *and* keeps the short recovery -- and the moment that exists it is the correct\n-- answer to every opponent in the game, every time, with no read involved. The fight would\n-- still run, nothing would error, and the symptom would be a combat system that felt\n-- shallow for reasons nobody could point at. That is exactly the kind of defect worth an\n-- error() rather than a comment.\nif FIGHT.GuardBreakShare <= FIGHT.OverchargeShare then\n	error(\n		`[AGES config] Fight.GuardBreakShare is {FIGHT.GuardBreakShare} and Fight.OverchargeShare is {FIGHT.OverchargeShare}.`\n			.. ` The guard break must sit above the overcharge, or breaking a guard costs nothing and there is one`\n			.. ` correct charge for every fight. Raise GuardBreakShare above OverchargeShare in shared/Config.luau.`\n	)\nend\n\n-- What the opponent is doing. Held as a string rather than recomputed because the wind\n-- share the client draws its tell from is a fraction of the *current* intent's clock,\n-- and a reader that recomputed the intent would have to recompute the clock with it.\ntype FoeIntent = \"wait\" | \"close\" | \"wind\" | \"guard\" | \"recover\" | \"down\"\n\n-- The joints the tell is drawn on, and the rest pose to compose onto. Captured once\n-- when the body is built rather than read per tick: `C0` is written every frame the\n-- opponent is winding up, so a reader that took \"rest\" from the live joint would be\n-- reading its own last frame and the arm would walk away from the shoulder.\ntype Pose = {\n	rightShoulder: Motor6D,\n	leftShoulder: Motor6D,\n	waist: Motor6D?,\n	restRight: CFrame,\n	restLeft: CFrame,\n	restWaist: CFrame,\n}\n\ntype Bout = {\n	def: FighterDef,\n	visitor: Visitor,\n	dots: Interact.InteractHandle?,\n	pose: Pose?,\n\n	phase: \"square\" | \"fight\" | \"down\" | \"over\",\n\n	-- The contest.\n	footing: number,\n	maxFooting: number,\n	foeFooting: number,\n	foeMaxFooting: number,\n	stamina: number,\n\n	-- The player's hands. `charge` only advances while `charging`, and it is the server\n	-- that advances it: the client draws a meter from this value and never reports one,\n	-- so the strongest thing a forged packet can say is that a button went down.\n	charging: boolean,\n	charge: number,\n	guarding: boolean,\n	sidestepLeft: number,\n	recoverLeft: number,\n\n	-- The opponent's. `windTotal` is kept beside `timer` so the 0-1 share the tell is\n	-- drawn from divides by the length this particular wind-up was started with,\n	-- rather than by the archetype's -- which matters the moment anything ever\n	-- shortens one.\n	intent: FoeIntent,\n	timer: number,\n	windTotal: number,\n\n	-- The last exchange, and how long it stays on screen.\n	beat: string?,\n	beatGood: boolean,\n	beatLeft: number,\n\n	-- Set once, when it is decided.\n	result: string?,\n	won: boolean,\n	overLeft: number,\n	downLeft: number,\n\n	-- Guard against a finish arriving twice, from the tick and from PlayerRemoving.\n	ending: boolean,\n}\n\nlocal bouts: { [Player]: Bout } = {}\n\n-- The client only redraws when the digest changes, the same as the gym. Named for\n-- every field the client actually draws.\nlocal pushed: { [Player]: string } = {}\n\n-- -------------------------------------------------------------------\n-- Harness switch.\n--\n-- Declared above every reader on purpose: a `local` declared *below* a function that\n-- names it is a plain global read inside that function, which is exactly how the gym's\n-- Describe came to report DISABLED forever while it was running fine.\n-- -------------------------------------------------------------------\n\nlocal enabled = true\n\n-- -------------------------------------------------------------------\n-- Small helpers.\n-- -------------------------------------------------------------------\n\nlocal function characterRoot(player: Player): BasePart?\n	local character = player.Character\n	if character == nil then\n		return nil\n	end\n	local root = character:FindFirstChild(\"HumanoidRootPart\")\n	if root == nil or not root:IsA(\"BasePart\") then\n		return nil\n	end\n	return root\nend\n\nlocal function humanoidOf(model: Model?): Humanoid?\n	if model == nil then\n		return nil\n	end\n	local humanoid = model:FindFirstChildOfClass(\"Humanoid\")\n	return humanoid\nend\n\n-- How much footing somebody with this health starts with.\n--\n-- Read live rather than cached at the start of the bout, and that is the same call the\n-- gym makes about its sweet zone: health lost *during* a fight should shorten the bar\n-- you are looking at, because the alternative is a player watching a number change with\n-- no effect until the next time they square up.\nlocal function footingFor(health: number): number\n	local fitness = math.clamp(health / Config.Stats.Max, 0, 1)\n	return FIGHT.BaseFooting * (1 + FIGHT.HealthFootingBonus * fitness)\nend\n\nlocal function healthOf(player: Player): number\n	local stats = StatService.GetStats(player)\n	return if stats ~= nil then stats.health else 0\nend\n\n-- Distance from the player to the opponent, flat. Returns nil when either body is gone,\n-- which every caller treats as \"the fight cannot continue\" rather than as zero.\nlocal function gapTo(player: Player, bout: Bout): number?\n	local root = characterRoot(player)\n	if root == nil or bout.visitor.gone() then\n		return nil\n	end\n	return Ground.FlatDistance(root.Position, bout.visitor.at())\nend\n\nlocal function say(bout: Bout, line: string, good: boolean)\n	bout.beat = line\n	bout.beatGood = good\n	bout.beatLeft = FIGHT.BeatSeconds\nend\n\n-- -------------------------------------------------------------------\n-- State push.\n-- -------------------------------------------------------------------\n\nlocal function stateFor(player: Player): FightState?\n	local bout = bouts[player]\n	if bout == nil then\n		return nil\n	end\n\n	local gap = gapTo(player, bout)\n	return {\n		phase = bout.phase,\n		foeName = bout.def.body.name,\n		foeStyle = bout.def.name,\n		foeBlurb = bout.def.blurb,\n		footing = bout.footing,\n		maxFooting = bout.maxFooting,\n		foeFooting = bout.foeFooting,\n		foeMaxFooting = bout.foeMaxFooting,\n		stamina = bout.stamina,\n		maxStamina = FIGHT.MaxStamina,\n		charge = bout.charge,\n		guarding = bout.guarding,\n		sidestepping = bout.sidestepLeft > 0,\n		recover = if bout.recoverLeft > 0 then bout.recoverLeft else 0,\n		foeIntent = bout.intent,\n		foeWind = if bout.intent == \"wind\" and bout.windTotal > 0\n			then math.clamp(1 - bout.timer / bout.windTotal, 0, 1)\n			else 0,\n		engaged = gap ~= nil and gap <= FIGHT.RangeStuds,\n		beat = if bout.beatLeft > 0 then bout.beat else nil,\n		beatGood = bout.beatGood,\n		jabShare = FIGHT.JabShare,\n		guardBreakShare = FIGHT.GuardBreakShare,\n		overchargeShare = FIGHT.OverchargeShare,\n		result = bout.result,\n		won = bout.won,\n	}\nend\n\nlocal function push(player: Player)\n	local state = stateFor(player)\n	-- The charge and the opponent's wind share are both in the digest at a coarse\n	-- resolution: they move every tick while anything is happening, and they are the two\n	-- things the player is actually reading, so a redraw they miss is a tell they miss.\n	local digest = if state == nil\n		then \"none\"\n		else `{state.phase}|{math.floor(state.footing)}/{math.floor(state.maxFooting)}`\n			.. `|{math.floor(state.foeFooting)}/{math.floor(state.foeMaxFooting)}`\n			.. `|{math.floor(state.stamina)}|{math.floor(state.charge * 50)}`\n			.. `|{tostring(state.guarding)}|{tostring(state.sidestepping)}`\n			.. `|{math.floor(state.recover * 20)}|{state.foeIntent}`\n			.. `|{math.floor(state.foeWind * 50)}|{tostring(state.engaged)}`\n			.. `|{tostring(state.beat)}|{tostring(state.result)}`\n	if pushed[player] == digest then\n		return\n	end\n	pushed[player] = digest\n	FightUpdatedRemote:FireClient(player, state)\nend\n\n-- -------------------------------------------------------------------\n-- Going down, and getting back up.\n--\n-- Both sides use the humanoid's own sit state. It costs no asset, no animation and no\n-- new rig, it reads exactly as \"on the floor\", and -- the part that matters -- it is\n-- trivially reversible, which is the whole requirement: whatever puts somebody down has\n-- to be able to put them back up a few seconds later without leaving a trace.\n-- -------------------------------------------------------------------\n\nlocal function setFloored(humanoid: Humanoid?, floored: boolean)\n	if humanoid == nil then\n		return\n	end\n	humanoid.Sit = floored\nend\n\n-- -------------------------------------------------------------------\n-- The tell, on the body.\n--\n-- Everything above this line was already replicated to the client and drawn as a bar in\n-- the bottom-centre panel. That bar is a good bar and it stays. The problem it cannot\n-- solve is that **the opponent was visually inert**: the whole skill of a fight is\n-- reading *when*, and until now the only place \"when\" existed was a rectangle at the\n-- bottom of the screen. A player who looked at the person hitting them learned nothing,\n-- which makes this a UI game with a 3D backdrop rather than a fight.\n--\n-- It also quietly cancelled the archetypes. Fighters.luau says the brawler's build\n-- should tell you \"across a street which question is about to be asked\" -- but a brawler,\n-- a scrapper and a boxer all stood in the identical rest pose and differed only in how\n-- fast a bar filled. Requirement 7 of the activity law, same input different opponent,\n-- was true in the numbers and invisible in the world.\n--\n-- **Server-side, because the opponent is in workspace.Visitors and everybody can see\n-- them.** A client-side pose would leave a bystander watching two people mime a fight at\n-- a statue.\n--\n-- **Driven from `intent` and `timer`, which are the same fields the bar is drawn from**,\n-- so the body and the panel cannot drift apart. Not a second clock -- there is no new\n-- state here at all, only a reading of state that already existed.\n-- -------------------------------------------------------------------\n\n-- The hardest hit anybody in the roster throws, so a wind-up's size can be a share of it\n-- rather than a number typed per archetype. This is the whole per-fighter difference in\n-- the pose: the brawler already hits for 20 and the scrapper for 8, and drawing the\n-- rear-back at that ratio means the tell is enormous or a flick *for the reason it\n-- should be* -- because of what is about to land -- instead of because a second table\n-- said so. Add a fighter and their tell sizes itself.\nlocal HARDEST_STRIKE = 0\nfor _, def in Fighters.All do\n	HARDEST_STRIKE = math.max(HARDEST_STRIKE, def.strikeFooting)\nend\nif HARDEST_STRIKE <= 0 then\n	error(\"[AGES] no fighter throws a strike worth more than zero footing, so no wind-up could be drawn\")\nend\n\n-- How far the smallest hitter still leans. Without a floor the scrapper's 8-of-20 would\n-- read as barely moving at all, and \"too fast to react to\" is the lesson she is meant to\n-- teach -- not \"invisible\".\nlocal TELL_FLOOR = 0.45\n\n-- Where a limb points, in the upper torso's own space: -Z is forward, +Y is up, +X is the\n-- fighter's right. Written as directions rather than as Euler angles on purpose -- the\n-- rotation is then built by `aimLimb` from the arm's rest axis, so none of this depends\n-- on knowing which way R15 happens to orient a shoulder's C0. Guessing that sign is how\n-- you ship a fighter who winds up by putting his arm through his own chest.\nlocal ARM_REST = Vector3.new(0, -1, 0)\nlocal ARM_WOUND = Vector3.new(0.45, 0.30, 0.85) -- back, out and up: the cocked arm\nlocal ARM_THROWN = Vector3.new(0.15, -0.25, -0.95) -- through the target, still extended\nlocal ARM_GUARD_R = Vector3.new(0.25, 0.55, -0.80) -- hands up in front of the face\nlocal ARM_GUARD_L = Vector3.new(-0.25, 0.55, -0.80)\nlocal ARM_COVER_L = Vector3.new(-0.25, 0.45, -0.85) -- the off hand, up while the other winds\n\n-- The shoulders turn with the punch. Yaw only, so this one *is* a plain angle: rotation\n-- about Y is unambiguous in any rig.\nlocal WAIST_WOUND_DEGREES = 22\nlocal WAIST_THROWN_DEGREES = -14\n\n-- The rotation that takes a limb's rest axis onto `dir`, both in the joint's own space.\n-- Axis-and-angle rather than composed Euler terms because the question being asked is\n-- \"point the arm there\", and that is one rotation with one answer.\nlocal function aimLimb(dir: Vector3): CFrame\n	local target = dir.Unit\n	local dot = math.clamp(ARM_REST:Dot(target), -1, 1)\n	if dot > 0.9999 then\n		return CFrame.identity\n	end\n	if dot < -0.9999 then\n		-- Straight up. The cross product is degenerate here, so pick an axis rather than\n		-- normalising a zero vector -- which returns NaN and silently deletes the arm.\n		return CFrame.fromAxisAngle(Vector3.new(1, 0, 0), math.pi)\n	end\n	return CFrame.fromAxisAngle(ARM_REST:Cross(target).Unit, math.acos(dot))\nend\n\nlocal function poseOf(model: Model?): Pose?\n	if model == nil then\n		return nil\n	end\n	local rightArm = model:FindFirstChild(\"RightUpperArm\")\n	local leftArm = model:FindFirstChild(\"LeftUpperArm\")\n	local torso = model:FindFirstChild(\"UpperTorso\")\n	if rightArm == nil or leftArm == nil then\n		return nil\n	end\n	local right = rightArm:FindFirstChild(\"RightShoulder\") :: Motor6D?\n	local left = leftArm:FindFirstChild(\"LeftShoulder\") :: Motor6D?\n	local waist = if torso ~= nil then torso:FindFirstChild(\"Waist\") :: Motor6D? else nil\n	if right == nil or left == nil then\n		return nil\n	end\n	return {\n		rightShoulder = right,\n		leftShoulder = left,\n		waist = waist,\n		restRight = right.C0,\n		restLeft = left.C0,\n		restWaist = if waist ~= nil then waist.C0 else CFrame.identity,\n	}\nend\n\n-- Back to standing. Called from teardown and from going down, so a bout that ends\n-- mid-wind-up does not leave a body frozen with its arm cocked.\nlocal function poseRest(pose: Pose?)\n	if pose == nil then\n		return\n	end\n	pose.rightShoulder.C0 = pose.restRight\n	pose.leftShoulder.C0 = pose.restLeft\n	local waist = pose.waist\n	if waist ~= nil then\n		waist.C0 = pose.restWaist\n	end\nend\n\nlocal function posedTo(pose: Pose, right: Vector3, left: Vector3, waistDegrees: number)\n	pose.rightShoulder.C0 = pose.restRight * aimLimb(right)\n	pose.leftShoulder.C0 = pose.restLeft * aimLimb(left)\n	local waist = pose.waist\n	if waist ~= nil then\n		waist.C0 = pose.restWaist * CFrame.Angles(0, math.rad(waistDegrees), 0)\n	end\nend\n\n-- The one reader. `share` runs 0 at the start of whatever the opponent is doing to 1 at\n-- the end of it, and the arm's position *is* the clock -- linear, deliberately, because\n-- an eased tell is a tell that lies about how much time is left.\nlocal function poseFoe(bout: Bout)\n	local pose = bout.pose\n	if pose == nil then\n		return\n	end\n	if bout.phase ~= \"fight\" then\n		poseRest(pose)\n		return\n	end\n\n	local reach = math.max(TELL_FLOOR, bout.def.strikeFooting / HARDEST_STRIKE)\n\n	if bout.intent == \"wind\" then\n		local total = math.max(bout.windTotal, 1e-3)\n		local share = math.clamp(1 - bout.timer / total, 0, 1)\n		posedTo(\n			pose,\n			ARM_REST:Lerp(ARM_WOUND, share * reach),\n			ARM_REST:Lerp(ARM_COVER_L, share),\n			WAIST_WOUND_DEGREES * share * reach\n		)\n	elseif bout.intent == \"recover\" then\n		-- The punish window, and the reason it is drawn at all: an opponent who has just\n		-- swung and missed should *look* open. The arm returns from thrown to rest over\n		-- the recovery, so how far it has come back is how much of the window is left.\n		local total = math.max(bout.def.recoverSeconds, 1e-3)\n		local left = math.clamp(bout.timer / total, 0, 1)\n		posedTo(\n			pose,\n			ARM_THROWN:Lerp(ARM_REST, 1 - left),\n			ARM_REST,\n			WAIST_THROWN_DEGREES * left * reach\n		)\n	elseif bout.intent == \"guard\" then\n		posedTo(pose, ARM_GUARD_R, ARM_GUARD_L, 0)\n	else\n		-- wait and close. Hands down; the fight is not happening this instant and the\n		-- body should say so, because \"nothing is coming\" is a read too.\n		poseRest(pose)\n	end\nend\n\n-- -------------------------------------------------------------------\n-- Teardown. One exit, and it does not know why it is being called -- the same shape\n-- PoliceService uses for officers, and for the same reason: every way a fight can end\n-- has to leave the world in the identical state, or the one path nobody tested is the\n-- one that leaves an NPC standing in the street forever.\n-- -------------------------------------------------------------------\n\nlocal function teardown(player: Player, bout: Bout)\n	-- Before the body goes, in case it is not going: ForceEnd and a new life both\n	-- come through here, and an opponent left standing with a cocked arm is worse\n	-- than one left standing.\n	poseRest(bout.pose)\n	local dots = bout.dots\n	if dots ~= nil then\n		dots.Destroy()\n		bout.dots = nil\n	end\n	setFloored(humanoidOf(player.Character), false)\n	if not bout.visitor.gone() then\n		bout.visitor.destroy()\n	end\n	bouts[player] = nil\nend\n\nlocal function finish(player: Player, bout: Bout, line: string?)\n	if bout.ending then\n		return\n	end\n	bout.ending = true\n	teardown(player, bout)\n	if line ~= nil then\n		NoticeRemote:FireClient(player, line)\n	end\n	push(player)\nend\n\n-- Whether anybody nearby caught the whole bout. One roll per bystander in range rather\n-- than WitnessService's continuous fill -- see the file header for why a twenty-second\n-- fight is too short for a look-then-fill gesture to read as anything but instant. A\n-- crowd is more likely to have caught it because more people are rolling, not because\n-- any one roll got easier.\nlocal function rollWitnessed(player: Player): boolean\n	local root = characterRoot(player)\n	if root == nil then\n		return false\n	end\n	for _, bystander in PeopleService.Bystanders(player) do\n		if Ground.FlatDistance(root.Position, bystander.position) > FIGHT.WitnessSeeStuds then\n			continue\n		end\n		if math.random() < FIGHT.WitnessCatchChance then\n			return true\n		end\n	end\n	return false\nend\n\n-- Somebody hit zero. Decides the outcome, pays it out, and hands over to the down beat.\n--\n-- The payout happens here rather than when the down beat expires, because the beat is\n-- three seconds during which the player can disconnect, die of old age or be arrested,\n-- and a result that is only banked at the end of it is a result a player can lose by\n-- walking away from their keyboard.\nlocal function decide(player: Player, bout: Bout, playerWon: boolean)\n	bout.phase = \"down\"\n	poseRest(bout.pose)\n	bout.downLeft = FIGHT.DownSeconds\n	bout.won = playerWon\n	bout.charging = false\n	bout.charge = 0\n	bout.guarding = false\n	bout.sidestepLeft = 0\n	bout.recoverLeft = 0\n	bout.intent = if playerWon then \"down\" else \"wait\"\n	bout.visitor.halt()\n\n	if playerWon then\n		bout.result = `{bout.def.body.name} went down.`\n		setFloored(humanoidOf(bout.visitor.model), true)\n		StatService.AddStat(player, \"happiness\", FIGHT.WinHappiness)\n		-- Fighting, on the bout and not on the punches. Paying per strike landed would\n		-- make the skill a measure of how long a fight ran, and the longest fights are\n		-- the ones against somebody who cannot hurt you.\n		SkillService.Award(player, \"fighting\", SKILL_AWARDS.FightWon, \"took a bout\")\n\n		local profile = DataService.GetProfile(player)\n		if profile ~= nil then\n			local life = Lives.Active(profile.Data)\n			life.notoriety += FIGHT.NotorietyPerWin\n		end\n\n		-- A rival gang's enforcer, not a street tough -- see Fighters.luau. Standing\n		-- moves the same way TerritoryService's incursion does: your own gang credits\n		-- the win, theirs charges the loss, and a debug or otherwise-untagged fighter\n		-- has no gangId and moves neither.\n		local gangId = bout.def.gangId\n		if gangId ~= nil then\n			local gang = Gangs.ById[gangId]\n			local gangName = if gang ~= nil then gang.name else gangId\n			GangService.Credit(player, FIGHT.RivalWinStanding, `beat a {gangName} enforcer`)\n			GangService.ChargeIn(player, gangId, FIGHT.RivalWinChargeRival, \"lost an enforcer in a fight\")\n		end\n	else\n		bout.result = \"You went down.\"\n		setFloored(humanoidOf(player.Character), true)\n		StatService.AddStat(player, \"health\", -FIGHT.LossHealth)\n	end\n\n	-- Getting caught, win or lose -- see the file header for why this is a fight's one\n	-- consequence beyond the mechanic itself, and why it is soft. No handler wired up\n	-- (fighting switched on before init.server.luau finishes, say) is a roll that never\n	-- costs anything, not an error -- softer than intended beats a hard failure here.\n	if witnessedHandler ~= nil and rollWitnessed(player) then\n		witnessedHandler(player, FIGHT.WitnessHeat, \"Seen fighting in the street\", bout.visitor.at())\n	end\n\n	push(player)\nend\n\n-- -------------------------------------------------------------------\n-- Resolving a strike.\n--\n-- Two functions, one per direction, and they are deliberately not shared. They look\n-- similar and they are not the same rules: only the player has a charge meter, and only\n-- the opponent can be caught in a guard the player chose to break. A single \"resolve\"\n-- taking a side flag would have to branch on it four times, which is the same code with\n-- the reader's job made harder.\n-- -------------------------------------------------------------------\n\n-- The opponent's wind-up has completed and lands on the player.\nlocal function foeStrikeLands(player: Player, bout: Bout)\n	local gap = gapTo(player, bout)\n	if gap == nil or gap > FIGHT.RangeStuds then\n		-- They swung at where you were. Out of range is its own answer and it costs\n		-- them the same long recovery a sidestep does, which is what makes backing off\n		-- mid-wind a real option rather than only a stamina decision.\n		bout.intent = \"recover\"\n		bout.timer = FIGHT.WhiffRecoverSeconds\n		say(bout, \"They missed\", true)\n		return\n	end\n\n	if bout.sidestepLeft > 0 then\n		bout.intent = \"recover\"\n		bout.timer = FIGHT.WhiffRecoverSeconds\n		say(bout, \"Dodged\", true)\n		return\n	end\n\n	local power = bout.def.strikeFooting\n	if bout.guarding then\n		bout.footing -= power * FIGHT.GuardedFootingShare\n		bout.stamina = math.max(0, bout.stamina - power * FIGHT.GuardedStaminaShare)\n		say(bout, \"Blocked\", true)\n	else\n		bout.footing -= power\n		say(bout, \"Hit\", false)\n	end\n\n	bout.intent = \"recover\"\n	bout.timer = bout.def.recoverSeconds\nend\n\n-- The player let go of Strike. `share` is how far the meter had filled.\nlocal function playerStrikeLands(player: Player, bout: Bout, share: number)\n	local gap = gapTo(player, bout)\n	local engaged = gap ~= nil and gap <= FIGHT.RangeStuds\n\n	-- A release below the jab mark is still a strike. There is no dead zone, because an\n	-- input that silently does nothing is the one thing a player cannot learn from.\n	local effective = math.max(share, FIGHT.JabShare)\n	local power = FIGHT.StrikeFootingMin\n		+ (FIGHT.StrikeFootingMax - FIGHT.StrikeFootingMin) * effective\n	local overcharged = share >= FIGHT.OverchargeShare\n	if overcharged then\n		power *= FIGHT.OverchargeFootingScale\n	end\n\n	if not engaged then\n		bout.recoverLeft = FIGHT.WhiffRecoverSeconds\n		say(bout, \"Whiffed\", false)\n		return\n	end\n\n	if bout.intent == \"guard\" then\n		if share >= FIGHT.GuardBreakShare then\n			bout.foeFooting -= power * FIGHT.GuardBreakFootingScale\n			bout.intent = \"recover\"\n			bout.timer = FIGHT.GuardBreakRecoverSeconds\n			say(bout, \"Broke guard\", true)\n		else\n			bout.foeFooting -= power * FIGHT.GuardedFootingShare\n			say(bout, \"They blocked\", false)\n		end\n	else\n		-- Lands, and does *not* interrupt. If they were mid-wind that swing is still\n		-- coming: this is the trade, and it is the rule the whole triangle rests on.\n		bout.foeFooting -= power\n		say(bout, if overcharged then \"Big hit\" else \"Clean hit\", true)\n	end\n\n	bout.recoverLeft = if overcharged\n		then FIGHT.OverchargeRecoverSeconds\n		else FIGHT.StrikeRecoverSeconds\nend\n\n-- -------------------------------------------------------------------\n-- The opponent's turn. One state machine, four states, no lookahead: it does not know\n-- what the player is holding and it must not, because an opponent that read the guard\n-- before choosing would never be punishable and the whole read would run backwards.\n-- -------------------------------------------------------------------\n\nlocal function tickFoe(player: Player, bout: Bout, elapsed: number)\n	local gap = gapTo(player, bout)\n	if gap == nil then\n		return\n	end\n\n	bout.timer -= elapsed\n\n	if bout.intent == \"close\" then\n		if gap <= FIGHT.RangeStuds then\n			bout.visitor.halt()\n			bout.intent = \"wait\"\n			bout.timer = bout.def.restSeconds\n		else\n			local root = characterRoot(player)\n			if root ~= nil then\n				bout.visitor.moveTo(root.Position)\n			end\n		end\n		return\n	end\n\n	-- Out of reach in any other state: go and close the distance. Checked before the\n	-- timer so that a wind-up started at range is abandoned rather than swung at nobody,\n	-- which otherwise reads as an opponent attacking thin air.\n	if gap > FIGHT.RangeStuds then\n		bout.intent = \"close\"\n		bout.timer = 0\n		return\n	end\n\n	local root = characterRoot(player)\n	if root ~= nil then\n		bout.visitor.face(root.Position)\n	end\n\n	if bout.timer > 0 then\n		return\n	end\n\n	if bout.intent == \"wind\" then\n		foeStrikeLands(player, bout)\n		return\n	end\n\n	-- Recovering ends into a pause, not straight into the next wind-up, and this is the\n	-- line that makes restSeconds load-bearing rather than decorative. Without it every\n	-- archetype runs wind-strike-recover-wind with no gap in it, which collapses the\n	-- brawler and the scrapper onto the same relentless rhythm and deletes the one\n	-- difference the player is supposed to feel between them -- the brawler's 0.7s gap is\n	-- the room you get for having read him, and the scrapper's 0.2s is why she is\n	-- answered with a guard instead of a punish.\n	if bout.intent == \"recover\" then\n		bout.intent = \"wait\"\n		bout.timer = bout.def.restSeconds\n		return\n	end\n\n	-- \"wait\" and \"guard\" both end the same way: pick the next thing.\n	if math.random() < bout.def.guardChance then\n		bout.intent = \"guard\"\n		bout.timer = bout.def.guardSeconds\n	else\n		bout.intent = \"wind\"\n		bout.timer = bout.def.windSeconds\n		bout.windTotal = bout.def.windSeconds\n	end\nend\n\n-- -------------------------------------------------------------------\n-- The tick.\n-- -------------------------------------------------------------------\n\nlocal function tickPlayer(player: Player, elapsed: number)\n	local bout = bouts[player]\n	if bout == nil then\n		return\n	end\n\n	-- Honoured here rather than around the loop so a fight already running when the\n	-- system is switched off is closed out and reported, instead of being abandoned with\n	-- an NPC left standing in the road.\n	if not enabled then\n		finish(player, bout, \"The fight broke up.\")\n		return\n	end\n\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return\n	end\n	if not Lives.Active(profile.Data).alive then\n		finish(player, bout, nil)\n		return\n	end\n\n	if bout.beatLeft > 0 then\n		bout.beatLeft -= elapsed\n	end\n\n	if bout.phase == \"over\" then\n		bout.overLeft -= elapsed\n		if bout.overLeft <= 0 then\n			finish(player, bout, nil)\n			return\n		end\n		push(player)\n		return\n	end\n\n	if bout.phase == \"down\" then\n		bout.downLeft -= elapsed\n		if bout.downLeft <= 0 then\n			-- Back up. The result stays on screen for the over beat, which is the part\n			-- the player reads; the getting up is what makes it a fight rather than an\n			-- injury, and it happens whether they won or lost.\n			setFloored(humanoidOf(player.Character), false)\n			setFloored(humanoidOf(bout.visitor.model), false)\n			bout.phase = \"over\"\n			bout.overLeft = FIGHT.OverSeconds\n		end\n		push(player)\n		return\n	end\n\n	local gap = gapTo(player, bout)\n	if gap == nil then\n		finish(player, bout, nil)\n		return\n	end\n\n	if bout.phase == \"square\" then\n		-- Waiting to be taken up on it. They stand and watch; walk far enough away and\n		-- the offer goes with them.\n		if gap > FIGHT.BreakStuds then\n			finish(player, bout, nil)\n			return\n		end\n		local root = characterRoot(player)\n		if root ~= nil then\n			bout.visitor.face(root.Position)\n		end\n		push(player)\n		return\n	end\n\n	-- From here the fight is live.\n	if gap > FIGHT.BreakStuds then\n		finish(player, bout, \"You walked away from it.\")\n		return\n	end\n\n	local engaged = gap <= FIGHT.RangeStuds\n\n	-- Stamina. The gap between these two rates is the entire pacing mechanism: it is\n	-- what turns a fight into exchange, break, exchange without a timer telling it to.\n	local recovery = if engaged then FIGHT.StaminaPerSecondEngaged else FIGHT.StaminaPerSecondClear\n	bout.stamina = math.min(FIGHT.MaxStamina, bout.stamina + recovery * elapsed)\n\n	if bout.recoverLeft > 0 then\n		bout.recoverLeft -= elapsed\n		-- A lockout drops everything. Holding guard through your own recovery would make\n		-- the punish window free, which is the one thing it must never be.\n		if bout.recoverLeft > 0 then\n			bout.charging = false\n			bout.charge = 0\n			bout.guarding = false\n		end\n	end\n\n	if bout.sidestepLeft > 0 then\n		bout.sidestepLeft -= elapsed\n	end\n\n	if bout.guarding then\n		bout.stamina = math.max(0, bout.stamina - FIGHT.GuardStaminaPerSecond * elapsed)\n		if bout.stamina <= 0 then\n			-- Guard collapses rather than being held for free at zero. Said out loud,\n			-- because a block that quietly stopped blocking is indistinguishable from a\n			-- bug from the other side of the screen.\n			bout.guarding = false\n			say(bout, \"Guard gave out\", false)\n		end\n	end\n\n	if bout.charging then\n		bout.charge = math.min(1, bout.charge + elapsed / FIGHT.ChargeSeconds)\n	end\n\n	tickFoe(player, bout, elapsed)\n\n	-- Checked after both sides have acted so a trade that puts both fighters down\n	-- resolves the same way every time: the player's own footing is read first, so\n	-- trading your last footing for theirs is a loss. Going out on your feet is not a\n	-- thing this game lets you do by accident.\n	if bout.footing <= 0 then\n		decide(player, bout, false)\n		return\n	end\n	if bout.foeFooting <= 0 then\n		decide(player, bout, true)\n		return\n	end\n\n	push(player)\nend\n\n-- -------------------------------------------------------------------\n-- Remote handlers.\n-- -------------------------------------------------------------------\n\nlocal function onSquareRequested(player: Player, id: unknown)\n	local bout = bouts[player]\n	if bout == nil or bout.phase ~= \"square\" then\n		return\n	end\n	if type(id) ~= \"string\" or id ~= bout.def.id then\n		-- The id is checked against the one actually stood in front of this player\n		-- rather than looked up in the content table, so a forged packet cannot pick\n		-- which opponent it is fighting.\n		return\n	end\n	bout.phase = \"fight\"\n	local dots = bout.dots\n	if dots ~= nil then\n		-- The dots go the moment it starts. Leaving them up would put a \"square up\"\n		-- prompt on somebody already swinging at you.\n		dots.Destroy()\n		bout.dots = nil\n	end\n	bout.intent = \"close\"\n	bout.timer = 0\n	bout.visitor.setSpeed(FIGHT.FoeWalkSpeed)\n	push(player)\nend\n\nlocal function onActionRequested(player: Player, action: unknown, held: unknown)\n	local bout = bouts[player]\n	if bout == nil or bout.phase ~= \"fight\" then\n		return\n	end\n	if type(action) ~= \"string\" then\n		return\n	end\n\n	-- Locked out. Refused rather than queued: an input that fires when the lockout ends\n	-- would let a player buffer through their own punish window, which is the window the\n	-- opponent just earned.\n	if bout.recoverLeft > 0 then\n		return\n	end\n\n	if action == \"strike\" then\n		if held == true then\n			if bout.stamina < FIGHT.StrikeStamina then\n				say(bout, \"Winded\", false)\n				push(player)\n				return\n			end\n			bout.guarding = false\n			bout.charging = true\n			bout.charge = 0\n		elseif bout.charging then\n			local share = bout.charge\n			bout.charging = false\n			bout.charge = 0\n			bout.stamina = math.max(0, bout.stamina - FIGHT.StrikeStamina)\n			playerStrikeLands(player, bout, share)\n		end\n	elseif action == \"guard\" then\n		if held == true then\n			if bout.stamina <= 0 then\n				say(bout, \"Winded\", false)\n				push(player)\n				return\n			end\n			-- Guarding cancels a wind-up rather than stacking with it. The two are\n			-- opposite answers and holding both would be holding neither.\n			bout.charging = false\n			bout.charge = 0\n			bout.guarding = true\n		else\n			bout.guarding = false\n		end\n	elseif action == \"sidestep\" then\n		if bout.stamina < FIGHT.SidestepStamina then\n			say(bout, \"Winded\", false)\n			push(player)\n			return\n		end\n		bout.stamina -= FIGHT.SidestepStamina\n		bout.charging = false\n		bout.charge = 0\n		bout.guarding = false\n		bout.sidestepLeft = FIGHT.SidestepSeconds\n		bout.recoverLeft = FIGHT.SidestepRecoverSeconds\n	else\n		return\n	end\n\n	push(player)\nend\n\n-- -------------------------------------------------------------------\n-- Cleanup.\n-- -------------------------------------------------------------------\n\nlocal function forget(player: Player)\n	local bout = bouts[player]\n	if bout ~= nil then\n		teardown(player, bout)\n	end\n	pushed[player] = nil\nend\n\n-- -------------------------------------------------------------------\n-- Public API.\n-- -------------------------------------------------------------------\n\n-- Stands somebody in front of the player, waiting to be squared up to.\n--\n-- Yields on a web call inside NPCService.Spawn, so everything after it is re-checked --\n-- the player can have walked off, died or picked up a different fight in the meantime.\nfunction FightService.Challenge(player: Player, fighterId: string?): (boolean, string?)\n	if not enabled then\n		return false, \"fighting is switched off\"\n	end\n	if bouts[player] ~= nil then\n		return false, \"already in a fight\"\n	end\n\n	local def = if fighterId ~= nil then Fighters.ById[fighterId] else Fighters.Default\n	if def == nil then\n		return false, `no fighter with id \"{fighterId}\"`\n	end\n\n	local root = characterRoot(player)\n	if root == nil then\n		return false, \"no character\"\n	end\n\n	-- In front of them, far enough back to be squared up to rather than stood on. Put\n	-- through the same ground probe every other spawned body uses, so a challenger\n	-- cannot appear inside a wall or off the edge of a pavement.\n	local ahead = root.Position + root.CFrame.LookVector * FIGHT.SquareUpStuds\n	local spot = Ground.SpotAt(ahead, Ground.BodyRadius(player.Character :: Model), Ground.BodyHeight(player.Character :: Model), Ground.IgnoreList(), root.Position)\n	if spot == nil then\n		return false, \"nowhere to stand them\"\n	end\n\n	local visitor = NPCService.Spawn(player, def.body, CFrame.lookAt(spot, root.Position), def.ageYears)\n	if visitor == nil then\n		return false, \"could not build the body\"\n	end\n	if bouts[player] ~= nil then\n		visitor.destroy()\n		return false, \"already in a fight\"\n	end\n\n	-- A rival enforcer, tinted in the gang's own color the same way GangService colors a\n	-- member -- see Fighters.luau. This is the only place an enforcer differs from a\n	-- plain street tough in the body itself; everything else about the fight is the\n	-- boxer's curve, unchanged.\n	if def.gangId ~= nil then\n		local gang = Gangs.ById[def.gangId]\n		if gang ~= nil then\n			Colors.Apply(visitor.model, gang.color)\n		end\n	end\n\n	local maxFooting = footingFor(healthOf(player))\n	local bout: Bout = {\n		def = def,\n		visitor = visitor,\n		dots = nil,\n		-- Nil is a supported answer, not a failure: a rig that arrives without the\n		-- joints still fights, it just fights without the body tell. Warned about\n		-- rather than errored on, because losing the tell should not lose the bout.\n		pose = poseOf(visitor.model),\n		phase = \"square\",\n		footing = maxFooting,\n		maxFooting = maxFooting,\n		foeFooting = FIGHT.BaseFooting * def.footingScale,\n		foeMaxFooting = FIGHT.BaseFooting * def.footingScale,\n		stamina = FIGHT.MaxStamina,\n		charging = false,\n		charge = 0,\n		guarding = false,\n		sidestepLeft = 0,\n		recoverLeft = 0,\n		intent = \"wait\",\n		timer = 0,\n		windTotal = def.windSeconds,\n		beat = nil,\n		beatGood = true,\n		beatLeft = 0,\n		result = nil,\n		won = false,\n		overLeft = 0,\n		downLeft = 0,\n		ending = false,\n	}\n	bouts[player] = bout\n\n	local dots = Interact.Attach(visitor.model, {\n		kind = \"Fight\",\n		id = def.id,\n		actionText = \"Square up\",\n		objectText = def.body.name,\n		nameplate = { name = def.body.name, age = def.ageYears },\n	})\n	if dots == nil then\n		-- Worth saying out loud because the symptom is silent and reads as content: a\n		-- stranger stood in the road who can be circled forever and never answered.\n		warn(`[AGES] could not put dots over the {def.name} -- they cannot be squared up to`)\n	end\n	bout.dots = dots\n	push(player)\n	return true, nil\nend\n\n-- Whoever is running the block, wherever the player is standing. TerritoryService.RegionOf\n-- decides who that is -- the same committed region the gang-standing ladder already reads\n-- -- and the enforcer for that side is always `enforcer_<regionId>`, one per gang, so there\n-- is no separate lookup table to keep in step with Gangs.luau.\n--\n-- Refused on your own side: sparring your own gang's enforcer is not a rival fight, and\n-- this file has no shape for it. Refused off anybody's territory for the same reason\n-- TerritoryService itself has nothing to say there -- there is no \"whose block is this\"\n-- to answer.\nfunction FightService.ChallengeRival(player: Player): (boolean, string?)\n	local region = TerritoryService.RegionOf(player)\n	if region == nil then\n		return false, \"not on anybody's turf here\"\n	end\n	if region == GangService.GangOf(player) then\n		return false, \"that's your own side\"\n	end\n\n	local fighterId = `enforcer_{region}`\n	if Fighters.ById[fighterId] == nil then\n		return false, `no enforcer defined for \"{region}\"`\n	end\n	return FightService.Challenge(player, fighterId)\nend\n\n-- A new life. Nobody inherits a fight.\nfunction FightService.ResetForNewLife(player: Player)\n	forget(player)\n	push(player)\nend\n\nfunction FightService.ForceEnd(player: Player): boolean\n	local bout = bouts[player]\n	if bout == nil then\n		return false\n	end\n	finish(player, bout, nil)\n	return true\nend\n\n-- Puts the fight straight to a result, for testing what follows one without having to\n-- win it first. Takes the same path a real decision does rather than a shortcut, which\n-- is the point: a debug command that skips the payout tests nothing.\nfunction FightService.ForceDecide(player: Player, playerWon: boolean): boolean\n	local bout = bouts[player]\n	if bout == nil or bout.phase ~= \"fight\" then\n		return false\n	end\n	decide(player, bout, playerWon)\n	return true\nend\n\nfunction FightService.Describe(player: Player): string\n	local bout = bouts[player]\n	local styles: { string } = {}\n	for _, def in Fighters.All do\n		table.insert(styles, `{def.id} (wind {def.windSeconds}s, hits {def.strikeFooting}, guards {math.floor(def.guardChance * 100)}%)`)\n	end\n\n	if bout == nil then\n		local profile = DataService.GetProfile(player)\n		local notoriety = if profile ~= nil then Lives.Active(profile.Data).notoriety else 0\n		return string.format(\n			\"fight: no fight | footing at this health would be %.0f | notoriety %d | %s | %s\",\n			footingFor(healthOf(player)),\n			notoriety,\n			table.concat(styles, \", \"),\n			if enabled then \"enabled\" else \"DISABLED\"\n		)\n	end\n\n	local gap = gapTo(player, bout)\n	return string.format(\n		\"fight: %s vs %s | phase %s | you %.0f/%.0f footing, %.0f stamina, charge %.2f%s%s | them %.0f/%.0f, %s %.2fs | gap %s | %s\",\n		bout.def.id,\n		bout.def.body.name,\n		bout.phase,\n		bout.footing,\n		bout.maxFooting,\n		bout.stamina,\n		bout.charge,\n		if bout.guarding then \", guarding\" else \"\",\n		if bout.recoverLeft > 0 then string.format(\", locked %.2fs\", bout.recoverLeft) else \"\",\n		bout.foeFooting,\n		bout.foeMaxFooting,\n		bout.intent,\n		bout.timer,\n		if gap ~= nil then string.format(\"%.1f\", gap) else \"gone\",\n		if enabled then \"enabled\" else \"DISABLED\"\n	)\nend\n\nfunction FightService.SetEnabled(value: boolean)\n	enabled = value\n	if value then\n		return\n	end\n	-- Switching off closes what is running. Left alone, a disabled system would keep a\n	-- half-finished fight on screen with an NPC frozen in the road and no tick coming to\n	-- clear either.\n	for player, bout in bouts do\n		finish(player, bout, \"The fight broke up.\")\n	end\nend\n\nfunction FightService.IsEnabled(): boolean\n	return enabled\nend\n\nfunction FightService.Styles(): { string }\n	local ids: { string } = {}\n	for _, def in Fighters.All do\n		table.insert(ids, def.id)\n	end\n	return ids\nend\n\n-- -------------------------------------------------------------------\n-- Start.\n-- -------------------------------------------------------------------\n\n-- No Init. There is nothing this needs to stand up before the other services exist -- the\n-- remotes are fetched at require time and the first opponent is spawned on demand -- and an\n-- empty Init registered in the boot sequence is a line that looks load-bearing and is not.\nfunction FightService:Start()\n	Players.PlayerRemoving:Connect(function(player: Player)\n		forget(player)\n	end)\n\n	RequestFightSquareRemote.OnServerEvent:Connect(function(player: Player, id: unknown)\n		local ok, err = pcall(onSquareRequested, player, id)\n		if not ok then\n			warn(`[AGES] fight square failed for {player.Name}: {err}`)\n		end\n	end)\n\n	RequestFightActionRemote.OnServerEvent:Connect(function(player: Player, action: unknown, held: unknown)\n		local ok, err = pcall(onActionRequested, player, action, held)\n		if not ok then\n			warn(`[AGES] fight action failed for {player.Name}: {err}`)\n		end\n	end)\n\n	task.spawn(function()\n		while true do\n			local elapsed = task.wait(FIGHT.TickSeconds)\n			for _, player in Players:GetPlayers() do\n				local ok, err = pcall(tickPlayer, player, elapsed)\n				if not ok then\n					warn(`[AGES] fight tick failed for {player.Name}: {err}`)\n				end\n			end\n		end\n	end)\n\n	-- The body tell runs on its own clock, faster than the bout does, and that split is\n	-- the whole reason it is a second loop rather than a line in the first one.\n	--\n	-- The bout ticks at Fight.TickSeconds = 0.1. A scrapper's wind-up is 0.55s, so a\n	-- pose driven off the bout tick would draw her entire tell in five steps -- and this\n	-- file already knows what that looks like, because NPCService measured it for the\n	-- head-turn and wrote the answer down: \"above ~0.2 the head visibly steps.\"\n	--\n	-- So the rate is NPC.LookTickSeconds, borrowed rather than added to Config. It is the\n	-- same measurement -- how often a joint on a visitor rig has to move to stop reading\n	-- as stepping -- and this project has been bitten enough times by two constants\n	-- describing one fact. If that number is ever retuned, this follows it, which is\n	-- correct: they would be retuning the thing this depends on.\n	--\n	-- Nothing here advances state. It only reads the bout the loop above owns and writes\n	-- C0, so the two cannot race in any way that matters: the worst case is one frame\n	-- posed from a timer 0.1s stale, which is a pose 6% along a wind-up it already knew\n	-- about.\n	task.spawn(function()\n		while true do\n			task.wait(Config.NPC.LookTickSeconds)\n			for _, bout in bouts do\n				local ok, err = pcall(poseFoe, bout)\n				if not ok then\n					warn(`[AGES] fight pose failed: {err}`)\n				end\n			end\n		end\n	end)\nend\n\nreturn FightService\n"
table.insert(AGES_MANIFEST, "src/server/services/FightService.luau")
AGES_SOURCES["src/server/services/FixtureService.luau"] = "--!strict\n-- The things in the school you can press E on.\n--\n-- Vending machines, the coffee machine, water fountains and the front doors. The building was\n-- full of objects that looked like they did something and did nothing, which is a specific\n-- kind of bad: a prop that invites a keypress and refuses it teaches the player that nothing\n-- in this building is real, and they stop trying doors everywhere.\n--\n-- **Found by name, not by tag, and that is forced rather than chosen.** `Config.School.Building.Baked`\n-- is true: the school is laid at runtime only to work out where its rooms are, and those parts\n-- are destroyed without ever reaching the world. What the player actually walks around is the\n-- baked `assets/School.rbxmx` mounted at `Workspace.School`. So tagging at build time -- which\n-- is what GymService does and what I would otherwise copy -- would put tags on parts that are\n-- thrown away a frame later. Names survive the bake; tags do not.\n--\n-- The cost of that is a name prefix being load-bearing. `PATTERNS` below is the whole contract\n-- between this file and `world/School.luau`, and renaming a machine there silently unhooks it\n-- here. It is written down in both places for that reason.\n\nlocal Players = game:GetService(\"Players\")\nlocal TweenService = game:GetService(\"TweenService\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Config = require(ReplicatedStorage:WaitForChild(\"Config\"))\nlocal Remotes = require(ReplicatedStorage:WaitForChild(\"Remotes\"))\nlocal Interact = require(ReplicatedStorage:WaitForChild(\"world\"):WaitForChild(\"Interact\"))\n\nlocal DataService = require(script.Parent.DataService)\nlocal StatService = require(script.Parent.StatService)\nlocal MoneyService = require(script.Parent.MoneyService)\n\nlocal FixtureService = {}\n\nlocal FIX = Config.Fixtures\nlocal NoticeRemote = Remotes.Get(\"Notice\")\nlocal RequestUseFixtureRemote = Remotes.Get(\"RequestUseFixture\")\n\n-- Which part names are which kind of fixture, most specific first.\n--\n-- Order matters: \"CorridorVendingCoffeeBody\" contains \"Vending\", so the coffee test has to run\n-- before any general vending test would. Keeping the list ordered rather than adding negative\n-- lookaheads is the readable version of the same rule.\nlocal PATTERNS: { { needle: string, kind: string } } = {\n	{ needle = \"CoffeeBody\", kind = \"coffee\" },\n	{ needle = \"SnacksBody\", kind = \"snack\" },\n	-- The basin, not the back panel or the spout: the prompt should sit on the thing you lean\n	-- over. `Fountain{floor}_{index}` is the basin's own name and the others all carry a\n	-- suffix, so an exact-prefix test would be wrong -- this matches the body specifically.\n	{ needle = \"FountainBasin\", kind = \"fountain\" },\n	{ needle = \"EntranceDoorLeaf\", kind = \"door\" },\n	-- Every room door, named `{roomId}DoorLeaf` in world/School.luau. This is the other half of\n	-- the naming contract in the header: rename it there and every classroom in the school\n	-- silently stops opening.\n	{ needle = \"DoorLeaf\", kind = \"door\" },\n}\n\nlocal function kindOf(name: string): string?\n	for _, entry in PATTERNS do\n		if string.find(name, entry.needle, 1, true) ~= nil then\n			return entry.kind\n		end\n	end\n	return nil\nend\n\n-- Per player, per kind: when they may use one again. Session-local on purpose -- see the\n-- Config header. These exist to stop somebody standing at a machine holding E, not to be an\n-- economy worth persisting.\nlocal nextUse: { [Player]: { [string]: number } } = {}\n\nlocal attached: { [BasePart]: true } = {}\n\nlocal function characterPosition(player: Player): Vector3?\n	local character = player.Character\n	if character == nil then\n		return nil\n	end\n	return character:GetPivot().Position\nend\n\nlocal function notice(player: Player, text: string)\n	if text ~= \"\" then\n		NoticeRemote:FireClient(player, text)\n	end\nend\n\n-- Swings both leaves, or shuts them.\n--\n-- Tweened rather than set, because a door that teleports open is a door that looks broken.\n--\n-- **State is per door, not global.** There used to be one `doorsOpen` flag for the whole\n-- building, which was defensible when the only doors were the two entrance leaves -- they are\n-- one opening and a pair that could disagree about being open is a bug. It stopped being\n-- defensible the moment every classroom got a door: pressing E at the science lab swung all\n-- twelve doors in the school, including the ones on the floor above.\n--\n-- The entrance keeps the paired behaviour by being asked for as a group. Everything else is\n-- keyed on the leaf itself.\nlocal doorOpen: { [BasePart]: boolean } = {}\nlocal doorRest: { [BasePart]: CFrame } = {}\n\n-- Which edge a leaf is hinged on, and therefore which way it swings.\n--\n-- The entrance is a pair either side of the building centreline, so the sign of the leaf's own\n-- X is which hand it is and the two open outward like gates. A room door is a single leaf and\n-- the rule is different and more important: **it swings into its room, never into the\n-- corridor.** A door that opens into circulation is one people get pinned by, which was the\n-- original reason these were left as holes in the wall.\nlocal function handOf(part: BasePart, rest: CFrame): number\n	if string.find(part.Name, \"EntranceDoorLeaf\", 1, true) ~= nil then\n		return if rest.Position.X >= 0 then -1 else 1\n	end\n	return 1\nend\n\nlocal function swingOne(part: BasePart, open: boolean)\n	local rest = doorRest[part]\n	if rest == nil then\n		rest = part.CFrame\n		doorRest[part] = rest\n	end\n	local hand = handOf(part, rest)\n	local hinge = rest * CFrame.new(hand * part.Size.X / 2, 0, 0)\n	local target = if open\n		then hinge * CFrame.Angles(0, math.rad(hand * -FIX.DoorSwingDegrees), 0) * CFrame.new(-hand * part.Size.X / 2, 0, 0)\n		else rest\n	doorOpen[part] = open\n	TweenService:Create(part, TweenInfo.new(FIX.DoorSwingSeconds, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { CFrame = target }):Play()\nend\n\n-- Swings the door the player is actually standing at. The entrance is the one exception: both\n-- of its leaves move together, because it is one opening.\nlocal function swingDoors(part: BasePart?)\n	if part == nil then\n		return\n	end\n	local leaf = part :: BasePart\n	local open = not (doorOpen[leaf] == true)\n\n	if string.find(leaf.Name, \"EntranceDoorLeaf\", 1, true) ~= nil then\n		for other in attached do\n			if other.Parent ~= nil and string.find(other.Name, \"EntranceDoorLeaf\", 1, true) ~= nil then\n				swingOne(other, open)\n			end\n		end\n		return\n	end\n	swingOne(leaf, open)\nend\n\n-- Uses a fixture. The id is the kind; the part is found by proximity rather than trusted from\n-- the client, which is the same rule every other interact in this game follows.\nlocal function use(player: Player, kind: string)\n	local spec = FIX.Kinds[kind]\n	if spec == nil then\n		return\n	end\n\n	local position = characterPosition(player)\n	if position == nil then\n		return\n	end\n\n	-- Standing near one of this kind. The client says which kind it clicked; the server checks\n	-- there is actually one of those within reach, so a forged message buys nothing.\n	-- Keeps the closest rather than the first: with a door on every room, \"one of this kind is\n	-- within reach\" is no longer the same question as \"which one did they mean\".\n	local nearest: BasePart? = nil\n	local nearestDistance = math.huge\n	for part in attached do\n		if part.Parent ~= nil and kindOf(part.Name) == kind then\n			local distance = (part.Position - position).Magnitude\n			if distance <= FIX.ReachStuds and distance < nearestDistance then\n				nearest = part\n				nearestDistance = distance\n			end\n		end\n	end\n	if nearest == nil then\n		-- Said out loud. Every silent `return` in this function presents to the player as a\n		-- prompt that does nothing, which is indistinguishable from a bug in the fixture.\n		warn(`[AGES] {player.Name} pressed a \"{kind}\" prompt with nothing of that kind inside {FIX.ReachStuds} studs`)\n		return\n	end\n\n	-- **Doors are answered here, before any of the checks below.**\n	--\n	-- The prompt was appearing and the keypress was doing nothing, and the reason is that a\n	-- door was being made to walk the whole fixture gauntlet -- profile loaded, cooldown, money\n	-- -- before it was allowed to swing. Two of those paths `return` without saying anything,\n	-- so any one of them failing looked identical to the door being broken.\n	--\n	-- A door is not an economy interaction. It has no cost, no cooldown and no stat, and the\n	-- reward for opening it is that it is open. It should not be able to fail because a profile\n	-- has not finished loading.\n	if kind == \"door\" then\n		swingDoors(nearest)\n		return\n	end\n\n	local now = os.clock()\n	local mine = nextUse[player]\n	if mine == nil then\n		mine = {}\n		nextUse[player] = mine\n	end\n	local ready = mine[kind]\n	if ready ~= nil and now < ready then\n		notice(player, FIX.TooSoon)\n		return\n	end\n\n	if DataService.GetProfile(player) == nil then\n		warn(`[AGES] {player.Name} used a \"{kind}\" with no profile loaded -- refused`)\n		return\n	end\n\n	if spec.cost > 0 then\n		-- Spend before the effect, and bail if it fails. The other order would hand out the\n		-- happiness and then discover there was no money, which is the shape of every\n		-- duplication bug ever written.\n		if not MoneyService.Spend(player, spec.cost, `fixture:{kind}`) then\n			notice(player, spec.broke)\n			return\n		end\n	end\n\n	if spec.happiness ~= 0 then\n		StatService.AddStat(player, \"happiness\", spec.happiness)\n	end\n	if spec.health ~= 0 then\n		StatService.AddStat(player, \"health\", spec.health)\n	end\n\n	mine[kind] = now + spec.cooldownSeconds\n	notice(player, spec.notice)\nend\n\n-- Hangs a prompt on one part.\nlocal function attach(part: BasePart)\n	if attached[part] then\n		return\n	end\n	local kind = kindOf(part.Name)\n	if kind == nil then\n		return\n	end\n	local spec = FIX.Kinds[kind]\n	if spec == nil then\n		return\n	end\n	local handle = Interact.Attach(part, {\n		kind = \"Fixture\",\n		id = kind,\n		actionText = spec.action,\n		objectText = spec.label,\n	})\n	if handle == nil then\n		return\n	end\n	handle.prompt.MaxActivationDistance = FIX.PromptDistanceStuds\n	attached[part] = true\nend\n\n-- Walks the school for anything that should have a prompt on it.\n--\n-- Run once at start and again whenever the model arrives, because the baked asset is mounted\n-- by the project file and may not exist on the first tick of a fresh server.\nlocal function sweep()\n	local school = workspace:FindFirstChild(\"School\")\n	if school == nil then\n		return false\n	end\n	for _, descendant in school:GetDescendants() do\n		if descendant:IsA(\"BasePart\") then\n			attach(descendant)\n		end\n	end\n	return true\nend\n\nfunction FixtureService.Describe(): string\n	local counts: { [string]: number } = {}\n	for part in attached do\n		local kind = kindOf(part.Name)\n		if kind ~= nil then\n			counts[kind] = (counts[kind] or 0) + 1\n		end\n	end\n	local parts = {}\n	for kind, count in counts do\n		table.insert(parts, `{kind}={count}`)\n	end\n	table.sort(parts)\n	if #parts == 0 then\n		return \"fixtures: none found\"\n	end\n	return \"fixtures: \" .. table.concat(parts, \"  \")\nend\n\nfunction FixtureService:Start()\n	if not sweep() then\n		-- The school has not streamed in. Retried rather than given up on, for the reason\n		-- every other builder in this codebase retries: an asset that arrives late would\n		-- otherwise be an asset nobody can ever interact with.\n		task.spawn(function()\n			for _ = 1, 30 do\n				task.wait(2)\n				if sweep() then\n					return\n				end\n			end\n			warn(\"[AGES] no School model found -- nothing in the school is interactable\")\n		end)\n	end\n\n	RequestUseFixtureRemote.OnServerEvent:Connect(function(player: Player, kind: unknown)\n		if typeof(kind) ~= \"string\" then\n			return\n		end\n		local ok, err = pcall(use, player, kind)\n		if not ok then\n			warn(`[AGES] fixture use failed for {player.Name}: {err}`)\n		end\n	end)\n\n	Players.PlayerRemoving:Connect(function(player: Player)\n		nextUse[player] = nil\n	end)\nend\n\nreturn FixtureService\n"
table.insert(AGES_MANIFEST, "src/server/services/FixtureService.luau")
AGES_SOURCES["src/server/services/GangService.luau"] = "--!strict\n-- Who you run with.\n--\n-- Everything in the crime tree below this is solitary. One player, one drawer, one alarm,\n-- one pursuit -- a second person in the room is at best a convenience. This is the layer\n-- that makes them matter, and the design problem it has to solve first is that the\n-- standard version of this feature is a name tag, a chat channel, and a number that goes\n-- up when you commit crimes. That is the idle payout pad wearing a jacket.\n--\n-- Two rules keep it from being that, and both are borrowed from elsewhere in this tree\n-- rather than invented here.\n--\n-- **Standing is earned; rank is given.** Ties.luau argues that friendship cannot be a bond\n-- threshold, because then \"everybody you were reliably nice to would become your friend on\n-- some birthday you were not paying attention on, and the game would be telling you about\n-- your own life after the fact\". A rank that auto-promotes at 400 points has exactly that\n-- defect. So standing accrues quietly from work you did, and the rung is only ever handed\n-- over by a person, off a panel, in a moment you walked across the city to be in. Reaching\n-- the number is necessary and never sufficient. That is the entire reason `promotable` is\n-- computed here and not on the client.\n--\n-- **The colors are worn, and they cut both ways.** Joining puts a bright band on your head.\n-- It is what makes a room of mixed players and NPCs legible at a glance -- and it is what a\n-- witness describes, so it multiplies every point of heat anything gives you while it is\n-- on. Wearing your colors into a bank is a decision, and taking them off to do it is\n-- another one. If the band were free, gangs would be a hat.\n--\n-- **What this file does not do.** It does not award standing for crimes; the crimes do\n-- that, by calling `Credit` on their way past, which is why nothing here requires\n-- TheftService or BankService. It does not decide heat (BountyService), and it deliberately\n-- does not require BountyService either -- it reads `data.bounty` straight off the profile,\n-- because BountyService needs to call *in* here on arrest and the two cannot both point at\n-- each other.\n--\n-- **Part 2, NPC crew, is built.** A rung that carries slots (`Config.Gangs.Crew.SlotsByRank`,\n-- absent below \"name\" on purpose) can bring somebody in off the boss's own panel, and\n-- that somebody is a persisted `GangCrewMember` with a nerve rating that only ever rises --\n-- see `creditStanding`, which is the one place both standing and nerve move together, on\n-- the same work, for the same reason.\n--\n-- **Part 3, calling a job, has its first slice: sending your crew to the bank's alarm.**\n-- `GangService.CrewFor`/`CastMemberFor` are the whole of this file's part in it --\n-- BankService owns the actual role table (one seat, the alarm) and the roll against\n-- nerve, because that room already was a shared, per-place thing rather than a per-player\n-- one, which is what let a second body stand in it without a new state machine. A role is\n-- still not a field on `GangCrewMember`: it is a fact about one robbery, held on\n-- BankService's own `Room`, not a fact about the person.\n--\n-- **Theft's crew role shipped too, and it is not Bank's shape reused.** The till has no\n-- second seat, only two independent attentions -- the clerk and the camera -- and\n-- TheftService's own header is explicit that reading them *is* the activity (\"this cannot\n-- be played by counting. It has to be watched.\"). A helper who could stand in for either\n-- would be a body that plays the mini-game for you, which is the thing Bank's crew helper\n-- was careful never to be -- it only ever covers a second *location*, not a second\n-- *attention*. So Theft's is a lookout instead: it never reads the clerk or the camera\n-- for you, it only softens what one mistake costs, once per robbery -- see\n-- TheftService's own `spawnLookout`/`tickLookout` and Config.Gangs.Jobs's\n-- `TillCoverFailChance` notes.\n--\n-- **Territory shipped -- see TerritoryService.** The gangs' sides of the city\n-- (content/Gangs.luau) are read now: crossing into a rival's on foot in your colors costs\n-- standing once, getting back out pays it once, scaled by depth. This file still has\n-- nothing to do with that directly -- TerritoryService reads `side` and calls back into\n-- `Credit`/`Debit` the same way the crime services do -- but the comment that used to\n-- live here calling territory unbuilt was wrong the day this line was written and is\n-- corrected rather than left to keep misleading the next read of this file.\n--\n-- **Still deferred, and still on purpose:** the rest of calling a job -- a gang-wide crew\n-- roster real players can join rather than each caller's own three recruits, a caller\n-- assigning roles to people who are not their own recruits, and the vault's *drawer* seat\n-- itself (Bank's crew helper only ever takes the alarm; nobody has asked a crew member to\n-- hold the vault open). Each of those is a real matchmaking or ownership question this\n-- file has deliberately not answered yet, not a gap nobody noticed.\n\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Config = require(ReplicatedStorage:WaitForChild(\"Config\"))\nlocal Lives = require(ReplicatedStorage:WaitForChild(\"Lives\"))\nlocal Remotes = require(ReplicatedStorage:WaitForChild(\"Remotes\"))\nlocal Types = require(ReplicatedStorage:WaitForChild(\"Types\"))\nlocal Interact = require(ReplicatedStorage:WaitForChild(\"world\"):WaitForChild(\"Interact\"))\n\nlocal DataService = require(script.Parent.DataService)\nlocal NPCService = require(script.Parent.NPCService)\nlocal PlaceService = require(script.Parent.PlaceService)\nlocal SkillService = require(script.Parent.SkillService)\n\nlocal Cast = require(script.Parent.Parent.content.Cast)\nlocal Colors = require(script.Parent.Parent.world.Colors)\nlocal Gangs = require(script.Parent.Parent.content.Gangs)\nlocal Public = require(script.Parent.Parent.content.Public)\n\ntype LifeData = Types.LifeData\ntype GangDef = Types.GangDef\ntype GangRankDef = Types.GangRankDef\ntype GangState = Types.GangState\ntype GangPanel = Types.GangPanel\ntype GangCrewMember = Types.GangCrewMember\ntype OfferedChoice = Types.OfferedChoice\ntype Visitor = NPCService.Visitor\ntype CastMember = Types.CastMember\n\nlocal GANGS = Config.Gangs\n\nlocal GangUpdatedRemote = Remotes.Get(\"GangUpdated\")\nlocal GangPanelUpdatedRemote = Remotes.Get(\"GangPanelUpdated\")\nlocal RequestGangOpenRemote = Remotes.Get(\"RequestGangOpen\")\nlocal RequestGangChoiceRemote = Remotes.Get(\"RequestGangChoice\")\nlocal RequestGangColorsRemote = Remotes.Get(\"RequestGangColors\")\n\n-- One boss standing at one place point, shared by everybody on the server.\n--\n-- Deliberately not per-player, unlike the family NPCs PeopleService spawns. A gang boss is\n-- a fixture of the town rather than a person in your life: two players walking into the\n-- same garage have to be looking at the same Marisol, or the moment one of them joins in\n-- front of the other the world stops agreeing with itself.\ntype Post = {\n	gangId: string,\n	visitor: Visitor?,\n	dots: Interact.InteractHandle?,\n	spawning: boolean,\n}\n\n-- Per-player bookkeeping that is not worth persisting.\ntype Watch = {\n	-- The highest bounty seen since the last time it was at zero. This is how an escape is\n	-- noticed: heat that climbed to something real and then came all the way down without\n	-- an arrest in between. Session-only, and safe to be -- `bounty` itself is persisted,\n	-- so a player who rejoins mid-chase has their peak seeded from where they actually are\n	-- rather than from nothing.\n	peakBounty: number,\n	-- Which boss they currently have a panel open with, or nil. Cleared when they walk out\n	-- of range, which is what makes the panel a conversation rather than a menu.\n	atGangId: string?,\n	notice: string?,\n}\n\nlocal posts: { [string]: Post } = {}\nlocal watches: { [Player]: Watch } = {}\nlocal pushed: { [Player]: string } = {}\nlocal pushedPanel: { [Player]: string } = {}\nlocal enabled = true\n\nlocal function dataFor(player: Player): LifeData?\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return nil\n	end\n	return Lives.Active(profile.Data)\nend\n\nlocal function watchFor(player: Player): Watch\n	local watch = watches[player]\n	if watch == nil then\n		watch = { peakBounty = 0, atGangId = nil, notice = nil }\n		watches[player] = watch\n	end\n	return watch\nend\n\nlocal function characterPosition(player: Player): Vector3?\n	local character = player.Character\n	if character == nil then\n		return nil\n	end\n	local root = character:FindFirstChild(\"HumanoidRootPart\")\n	return if root ~= nil and root:IsA(\"BasePart\") then root.Position else nil\nend\n\n-- The ladder, resolved.\n--\n-- Walks the config rungs in order and returns the last one the standing clears. Written as\n-- a scan rather than as a stored index because the ladder is content: inserting a rung\n-- between two existing ones must not silently renumber every player who already holds one.\nlocal function rankFor(standing: number): GangRankDef\n	local held = GANGS.Ranks[1]\n	for _, rung in GANGS.Ranks do\n		if standing >= rung.standing then\n			held = rung\n		end\n	end\n	return held\nend\n\nlocal function rankById(rankId: string?): GangRankDef?\n	if rankId == nil then\n		return nil\n	end\n	for _, rung in GANGS.Ranks do\n		if rung.id == rankId then\n			return rung\n		end\n	end\n	return nil\nend\n\n-- The rung above the one held, or nil at the top.\nlocal function nextRank(rankId: string?): GangRankDef?\n	local heldIndex = 0\n	for index, rung in GANGS.Ranks do\n		if rung.id == rankId then\n			heldIndex = index\n			break\n		end\n	end\n	return GANGS.Ranks[heldIndex + 1]\nend\n\nlocal function standingIn(data: LifeData, gangId: string): number\n	return data.gangStanding[gangId] or 0\nend\n\n-- How many crew slots the rung held in this gang carries, or zero for both a rung with\n-- no entry and for holding no rung at all -- `GANGS.Crew.SlotsByRank` omits the bottom\n-- two rungs for exactly that reason, see its own comment.\nlocal function crewSlotsFor(data: LifeData, gangId: string): number\n	if data.gangId ~= gangId then\n		return 0\n	end\n	return GANGS.Crew.SlotsByRank[data.gangRankId or \"\"] or 0\nend\n\n-- A crew id that is not already in use by this life's crew. Collision is vanishingly\n-- unlikely at three slots and six digits, but the loop is nearly free and turns \"a\n-- client keys a list on this\" from a hope into a guarantee.\nlocal function newCrewId(data: LifeData): string\n	while true do\n		local id = `crew_{math.random(100000, 999999)}`\n		local taken = false\n		for _, member in data.gangCrew do\n			if member.id == id then\n				taken = true\n				break\n			end\n		end\n		if not taken then\n			return id\n		end\n	end\nend\n\nlocal function crewIndexOf(data: LifeData, crewId: string): number?\n	for index, member in data.gangCrew do\n		if member.id == crewId then\n			return index\n		end\n	end\n	return nil\nend\n\n-- Whether the boss would hand over the next rung right now.\n--\n-- Three questions, not one, and the third is the reason this is a function rather than a\n-- comparison at the call site: the top rung asks that you hold it nowhere else, which is\n-- the same device Ties.luau uses to cap `closest` at one person. Since a life can only be\n-- in one gang at a time today, that check reads as trivially true -- it is written anyway,\n-- because the day a second gang can hold your standing is the day it stops being trivial\n-- and nobody will remember to come back here.\nlocal function promotableTo(data: LifeData, gangId: string): GangRankDef?\n	if data.gangId ~= gangId then\n		return nil\n	end\n	local upcoming = nextRank(data.gangRankId)\n	if upcoming == nil then\n		return nil\n	end\n	if standingIn(data, gangId) < upcoming.standing then\n		return nil\n	end\n	if upcoming.oneGangOnly and data.gangId ~= nil and data.gangId ~= gangId then\n		return nil\n	end\n	return upcoming\nend\n\nlocal function noticeFor(player: Player, text: string)\n	watchFor(player).notice = text\nend\n\n-- Forward declarations.\n--\n-- `creditStanding` is called by `checkEscape` and defined below it, because it needs\n-- `push`, which needs `stateFor`, which needs the ladder helpers above. Declared here\n-- rather than left to resolve at runtime: a name used with no `local` in scope compiles to\n-- a global read in Lua, so the version of this file that simply called it would have been\n-- legal Luau, would have built, and would have died with \"attempt to call a nil value\" the\n-- first time anybody got away from the police.\nlocal creditStanding: (player: Player, points: number, reason: string) -> number\nlocal push: (player: Player) -> ()\n\n-- How long until this life may join another gang, in seconds, or zero if it may now.\nlocal function rejoinWaitFor(data: LifeData): number\n	local leftAt = data.leftGangAt\n	if leftAt == nil then\n		return 0\n	end\n	local waited = data.secondsSinceAgeUp - leftAt\n	-- A birthday resets `secondsSinceAgeUp`, so a stamp taken before one reads as being in\n	-- the future. That is not corruption and must not be treated as a very long wait: the\n	-- window has plainly elapsed if a whole year turned over inside it.\n	if waited < 0 then\n		return 0\n	end\n	return math.max(GANGS.RejoinSeconds - waited, 0)\nend\n\nlocal function stateFor(player: Player): GangState?\n	local data = dataFor(player)\n	if data == nil then\n		return nil\n	end\n	local gangId = data.gangId\n	if gangId == nil then\n		return nil\n	end\n	local def = Gangs.ById[gangId]\n	if def == nil then\n		-- The gang was deleted from content while somebody was in it. Reads as not being in\n		-- one rather than erroring, because the alternative is a player who cannot load.\n		return nil\n	end\n	local held = rankById(data.gangRankId) or GANGS.Ranks[1]\n	local upcoming = nextRank(held.id)\n	local watch = watches[player]\n	return {\n		gangId = gangId,\n		name = def.name,\n		color = def.color,\n		rankId = held.id,\n		rankLabel = held.label,\n		nextLabel = if upcoming ~= nil then upcoming.label else nil,\n		standing = standingIn(data, gangId),\n		nextStanding = if upcoming ~= nil then upcoming.standing else nil,\n		promotable = promotableTo(data, gangId) ~= nil,\n		wearing = data.wearingColors,\n		crew = data.gangCrew,\n		crewSlots = crewSlotsFor(data, gangId),\n		notice = if watch ~= nil then watch.notice else nil,\n	}\nend\n\n-- The push-digest pattern, as everywhere else: name every drawn field, compare, fire only\n-- on change. Standing moves in bursts -- a vault pays forty-five points in an instant and\n-- then nothing for a minute -- so a fixed-rate push would spend most of its traffic\n-- resending a number that had not moved.\nfunction push(player: Player)\n	local state = stateFor(player)\n	local digest = \"none\"\n	if state ~= nil then\n		local crewBits: { string } = {}\n		for _, member in state.crew do\n			table.insert(crewBits, `{member.id}:{math.floor(member.nerve)}`)\n		end\n		digest = `{state.gangId}|{state.rankId}|{math.floor(state.standing)}|{tostring(state.promotable)}`\n			.. `|{tostring(state.wearing)}|{table.concat(crewBits, \",\")}|{tostring(state.notice)}`\n	end\n	if pushed[player] == digest then\n		return\n	end\n	pushed[player] = digest\n	GangUpdatedRemote:FireClient(player, state)\n	-- Cleared after it has been sent, not after it has been shown: a notice that stayed in\n	-- the digest would keep the panel redrawing the same line forever, and one that was\n	-- cleared before the push would never arrive at all.\n	local watch = watches[player]\n	if watch ~= nil then\n		watch.notice = nil\n	end\nend\n\n-- What the boss in front of you says, and the rows under it.\nlocal function panelFor(player: Player, gangId: string): GangPanel?\n	local data = dataFor(player)\n	if data == nil then\n		return nil\n	end\n	local def = Gangs.ById[gangId]\n	if def == nil then\n		return nil\n	end\n	local boss = Cast.ById[def.bossCastId]\n	local bossName = if boss ~= nil then boss.name else def.name\n\n	local offers: { OfferedChoice } = {}\n	local reply = def.pitch\n	local replyGood = true\n\n	if data.gangId == gangId then\n		local held = rankById(data.gangRankId) or GANGS.Ranks[1]\n		local upcoming = promotableTo(data, gangId)\n		if upcoming ~= nil then\n			reply = `You have done enough. You are {upcoming.label} now, if you want it.`\n			table.insert(offers, { id = `take_{upcoming.id}`, label = `Take \"{upcoming.label}\"`, cost = nil, note = nil, locked = false })\n		else\n			local ahead = nextRank(held.id)\n			if ahead == nil then\n				reply = `There is nothing above you here. The {def.name} is yours to call.`\n			else\n				-- The gap, said as a number. A boss who only ever says \"not yet\" is a boss\n				-- the player has no way to plan against, and the whole point of a rung\n				-- being conferred rather than crossed is that the player chose to come and\n				-- ask -- which is only a choice if the answer tells them something.\n				local short = math.max(ahead.standing - standingIn(data, gangId), 0)\n				reply = `You are {held.label}. {math.floor(short)} more and we will talk about \"{ahead.label}\".`\n				replyGood = false\n			end\n		end\n\n		-- Crew rows. Zero slots at the two lower rungs means this whole block draws\n		-- nothing for a hanger-on or a hand, which is the rung ladder saying it rather\n		-- than a comment saying it -- see GangState.crew's own note.\n		local slots = crewSlotsFor(data, gangId)\n		if slots > 0 then\n			for _, member in data.gangCrew do\n				table.insert(offers, {\n					id = `dismiss_{member.id}`,\n					label = `Let {member.name} go`,\n					cost = nil,\n					note = `nerve {math.floor(member.nerve)}`,\n					locked = false,\n				})\n			end\n			if #data.gangCrew < slots then\n				table.insert(offers, {\n					id = \"recruit\",\n					label = \"Bring somebody in\",\n					cost = nil,\n					note = `{#data.gangCrew}/{slots}`,\n					locked = false,\n				})\n			end\n		end\n\n		table.insert(offers, { id = \"leave\", label = \"Walk away from them\", cost = nil, note = \"keeps your standing\", locked = false })\n	elseif data.gangId ~= nil then\n		-- Somebody else's. Deliberately has no rows at all: a rival boss you can still do\n		-- business with is not a rival, and an offer to defect would make the choice of\n		-- gang reversible at the exact moment it is supposed to have cost something.\n		local mine = Gangs.ById[data.gangId]\n		reply = `You are wearing {if mine ~= nil then mine.name else \"somebody else's\"} colors. We have nothing for you.`\n		replyGood = false\n	else\n		local wait = rejoinWaitFor(data)\n		if wait > 0 then\n			reply = `You just walked away from a gang. Come back when you know what you want.`\n			replyGood = false\n			table.insert(offers, {\n				id = \"join\",\n				label = `Run with {def.name}`,\n				cost = nil,\n				note = `{math.ceil(wait)}s`,\n				locked = true,\n			})\n		else\n			table.insert(offers, { id = \"join\", label = `Run with {def.name}`, cost = nil, note = nil, locked = false })\n		end\n	end\n\n	return {\n		gangId = gangId,\n		name = def.name,\n		color = def.color,\n		bossName = bossName,\n		reply = reply,\n		replyGood = replyGood,\n		offers = offers,\n	}\nend\n\nlocal function pushPanel(player: Player)\n	local watch = watches[player]\n	local gangId = if watch ~= nil then watch.atGangId else nil\n	local panel = if gangId ~= nil then panelFor(player, gangId) else nil\n	local digest = \"none\"\n	if panel ~= nil then\n		local ids: { string } = {}\n		for _, offer in panel.offers do\n			-- `locked` is in the digest beside the id because a row that becomes takeable\n			-- while the player stands there -- the rejoin window elapsing -- reads\n			-- identically otherwise, and the panel must not keep drawing it greyed out.\n			table.insert(ids, `{offer.id}:{tostring(offer.locked)}:{tostring(offer.note)}`)\n		end\n		digest = `{panel.gangId}|{panel.reply}|{tostring(panel.replyGood)}|{table.concat(ids, \",\")}`\n	end\n	if pushedPanel[player] == digest then\n		return\n	end\n	pushedPanel[player] = digest\n	GangPanelUpdatedRemote:FireClient(player, panel)\nend\n\n-- Colors on the head, or off it.\n--\n-- Runs every tick for every player rather than only on the frames something changed, and\n-- that is the point: a character that died and respawned has no band on it, and the only\n-- thing that reliably knows a respawn happened is looking. `Colors.Apply` is idempotent\n-- and cheap on the common path -- two comparisons and a return -- so the cost of asking\n-- twice a second is far below the cost of a member who quietly lost their colors.\nlocal function applyColors(player: Player, data: LifeData)\n	local character = player.Character\n	if character == nil then\n		return\n	end\n	local gangId = data.gangId\n	if gangId == nil or not data.wearingColors then\n		Colors.Clear(character)\n		return\n	end\n	local def = Gangs.ById[gangId]\n	if def == nil then\n		Colors.Clear(character)\n		return\n	end\n	Colors.Apply(character, def.color)\nend\n\n-- Notices an escape.\n--\n-- An escape is heat that got real and then came all the way down with nobody arrested. The\n-- arrest half is handled by `OnArrest` clearing the peak before this can ever see it, which\n-- is why there is no \"were they arrested\" flag here: by the time the bounty reads zero\n-- after an arrest, the peak reads zero too and the condition below cannot fire.\nlocal function checkEscape(player: Player, data: LifeData, watch: Watch)\n	if data.bounty > watch.peakBounty then\n		watch.peakBounty = data.bounty\n		return\n	end\n	if data.bounty > 0 or watch.peakBounty <= 0 then\n		return\n	end\n	local peak = watch.peakBounty\n	watch.peakBounty = 0\n	if peak < GANGS.Earn.GotAwayNeedsBounty then\n		return\n	end\n\n	-- Nerve, before the gang check and deliberately outside it. The standing below is a\n	-- gang paying attention to one of its own; this is the player having got away with\n	-- something, which is true whether anyone was watching. Gating the only discipline\n	-- earned outside a room behind membership would make Nerve a members-only skill and\n	-- leave a player who never joined with a row that can never move.\n	SkillService.Award(player, \"nerve\", Config.Skills.Awards.GotAway, \"got away clean\")\n\n	if data.gangId == nil then\n		return\n	end\n	creditStanding(player, GANGS.Earn.GotAway, \"got away clean\")\nend\n\nlocal function tickPlayer(player: Player)\n	local data = dataFor(player)\n	if data == nil then\n		return\n	end\n	applyColors(player, data)\n\n	local watch = watchFor(player)\n	checkEscape(player, data, watch)\n\n	-- Standing in front of a boss is what keeps a panel open, and walking away is what\n	-- closes it. Checked here rather than left to the client so that a client which simply\n	-- never sends a close still loses the panel the moment it walks off.\n	local atGangId = watch.atGangId\n	if atGangId ~= nil then\n		local post = posts[atGangId]\n		local visitor = if post ~= nil then post.visitor else nil\n		local at = characterPosition(player)\n		if visitor == nil or visitor.gone() or at == nil then\n			watch.atGangId = nil\n		else\n			local away = (visitor.at() - at)\n			if math.sqrt(away.X * away.X + away.Z * away.Z) > Config.Interact.RangeStuds then\n				watch.atGangId = nil\n			end\n		end\n	end\n\n	push(player)\n	pushPanel(player)\nend\n\nlocal function despawnPost(post: Post)\n	if post.dots ~= nil then\n		post.dots.Destroy()\n		post.dots = nil\n	end\n	if post.visitor ~= nil then\n		post.visitor.destroy()\n		post.visitor = nil\n	end\nend\n\n-- Stands a boss up at their place point.\n--\n-- Yields on a web call inside NPCService.Spawn, so everything after it is re-checked. The\n-- `player` argument exists only for the peer-age rule NPCService applies to strangers, and\n-- passing an explicit age makes it irrelevant -- which is what lets a boss be a fixture of\n-- the town rather than somebody's personal NPC.\nlocal function spawnPost(player: Player, post: Post)\n	if post.visitor ~= nil or post.spawning then\n		return\n	end\n	local def = Gangs.ById[post.gangId]\n	if def == nil then\n		return\n	end\n	local member = Cast.ById[def.bossCastId]\n	local place = PlaceService.Find(def.bossPlaceId)\n	if member == nil or place == nil then\n		return\n	end\n\n	post.spawning = true\n	task.spawn(function()\n		local at = place.part.CFrame\n		local visitor = NPCService.Spawn(player, member, at, GANGS.BossAgeYears)\n		post.spawning = false\n		if visitor == nil then\n			return\n		end\n		if post.visitor ~= nil then\n			visitor.destroy()\n			return\n		end\n		post.visitor = visitor\n		-- The boss wears it too, and this is not decoration. The band is the whole answer to\n		-- \"which of the people in this room is the one I came for\", and a gang boss standing\n		-- bare-headed would be the one person in the system you have to walk up to and read a\n		-- nameplate to identify -- in a game whose stated rule is that gangs are legible from\n		-- across a street. Applied once here rather than on a tick because an NPC rig does not\n		-- respawn: if the model goes, the post goes with it and is rebuilt from scratch.\n		if not Colors.Apply(visitor.model, def.color) then\n			warn(`[AGES] could not band the {def.name} boss -- they will look like anybody else`)\n		end\n		local dots = Interact.Attach(visitor.model, {\n			kind = \"Boss\",\n			id = def.id,\n			actionText = \"Talk\",\n			objectText = member.name,\n			nameplate = { name = member.name, age = GANGS.BossAgeYears },\n		})\n		if dots == nil then\n			-- Worth saying out loud because the symptom is silent and looks like content: a\n			-- person standing in a garage who can be circled forever and never spoken to,\n			-- and therefore a gang that cannot be joined by anybody.\n			warn(`[AGES] could not put dots over the {def.name} boss at \"{def.bossPlaceId}\"`)\n		end\n		post.dots = dots\n	end)\nend\n\n-- Keeps the four standing.\n--\n-- Re-checked on a tick rather than spawned once at Start, because a boss can be lost --\n-- streaming, a rig that failed to build, a visitor destroyed by something else -- and a\n-- gang whose boss quietly vanished is a gang nobody can join with no error anywhere.\nlocal function tickPosts()\n	local anybody = Players:GetPlayers()[1]\n	if anybody == nil then\n		-- Nobody to build against. The bosses are torn down rather than left standing in an\n		-- empty server: NPCService.Spawn needs a player, so the next join rebuilds them\n		-- anyway, and leaving four rigs pathfinding around an empty town is pure cost.\n		for _, post in posts do\n			despawnPost(post)\n		end\n		return\n	end\n	for _, post in posts do\n		local visitor = post.visitor\n		if visitor ~= nil and visitor.gone() then\n			despawnPost(post)\n		end\n		spawnPost(anybody, post)\n	end\nend\n\n-- Award standing for something that helped.\n--\n-- The single seam every other system uses, and deliberately the only one: theft, the vault,\n-- shared heat and escapes all arrive here, so the ladder has one place that decides what\n-- work is worth and one place that clamps it. Callers pass what they did and how much of\n-- it, never a rung.\n--\n-- Silently does nothing for a player who is not in a gang, which is most players most of\n-- the time. That is not a failure worth reporting -- it is the ordinary case, and making\n-- every crime in the game branch on gang membership before calling would put the same\n-- three lines in five files.\nfunction creditStanding(player: Player, points: number, reason: string): number\n	if not enabled or points <= 0 then\n		return 0\n	end\n	local data = dataFor(player)\n	if data == nil then\n		return 0\n	end\n	local gangId = data.gangId\n	if gangId == nil then\n		return 0\n	end\n	local before = standingIn(data, gangId)\n	local after = before + points\n	data.gangStanding[gangId] = after\n\n	-- Steadier every time you pull work together, split across the crew rather than\n	-- multiplied by its size -- see Config.Gangs.Crew.NerveGainPerPoint. Never decays:\n	-- the same ratchet-only rule Ties.luau keeps for a bond, kept here for a crew.\n	if #data.gangCrew > 0 then\n		local gain = points * GANGS.Crew.NerveGainPerPoint\n		for _, member in data.gangCrew do\n			member.nerve = math.min(member.nerve + gain, GANGS.Crew.NerveMax)\n		end\n	end\n\n	-- Said only when it crosses a rung, and said as an invitation rather than as a\n	-- promotion. This is the moment the design turns on: the number is sufficient and the\n	-- rung still is not given, so the line has to send the player to a person.\n	--\n	-- The reason is named in it because the alternative -- \"your standing went up\" -- is a\n	-- progress bar talking, and the whole argument for conferring rungs face to face is\n	-- that the player should be able to see which thing they did was the thing that\n	-- counted.\n	local upcoming = nextRank(data.gangRankId)\n	if upcoming ~= nil and before < upcoming.standing and after >= upcoming.standing then\n		local def = Gangs.ById[gangId]\n		noticeFor(player, `They heard you {reason}. Go and see {if def ~= nil then def.name else \"them\"}.`)\n	end\n\n	push(player)\n	return after\nend\n\nlocal GangService = {}\n\nGangService.Credit = creditStanding\n\n-- Standing lost, floored. Never takes a rung away: a rung was conferred in a moment by a\n-- person, and deleting it later is the exact \"telling you about your own life after the\n-- fact\" that conferring it face to face exists to prevent.\nfunction GangService.Charge(player: Player, points: number, reason: string): number\n	if not enabled or points <= 0 then\n		return 0\n	end\n	local data = dataFor(player)\n	if data == nil then\n		return 0\n	end\n	local gangId = data.gangId\n	if gangId == nil then\n		return 0\n	end\n	local after = math.max(standingIn(data, gangId) - points, GANGS.Lose.Floor)\n	data.gangStanding[gangId] = after\n	noticeFor(player, `{reason}. Your standing took it.`)\n	push(player)\n	return after\nend\n\n-- Standing lost with a gang that is not yours.\n--\n-- Charge above can only ever reach the gang you run with, which was the right and only\n-- shape while every loss in the game was something your own side held against you. It\n-- cannot express the one TerritoryService needs: walking somebody else's side wearing\n-- another band costs you with *them*, and you may well not be in a gang they would ever\n-- speak to.\n--\n-- That standing is not idle. It is what a gang would ever offer you, so spending it is\n-- spending a door -- run the west line often enough in eastern colors and the west is a\n-- gang that will not take you. Deliberately has no rung logic and sends no notice about\n-- rungs: this can only lower a number, and a rung once conferred is never taken back.\nfunction GangService.ChargeIn(player: Player, gangId: string, points: number, reason: string): number\n	if not enabled or points <= 0 then\n		return 0\n	end\n	local data = dataFor(player)\n	if data == nil then\n		return 0\n	end\n	local after = math.max(standingIn(data, gangId) - points, GANGS.Lose.Floor)\n	data.gangStanding[gangId] = after\n	push(player)\n	return after\nend\n\n-- Called by BountyService on the way through an arrest.\n--\n-- Does two things that must happen together: charges the standing, and clears the escape\n-- peak so that the bounty dropping to zero as part of the arrest is not then read as\n-- having got away with it. Splitting them would make an arrest pay out the largest award\n-- in the table.\nfunction GangService.OnArrest(player: Player)\n	watchFor(player).peakBounty = 0\n	GangService.Charge(player, GANGS.Lose.OnArrest, \"Arrested\")\nend\n\n-- Called by BankService when somebody leaves a room with the alarm still ringing and\n-- somebody else still holding the vault. The one entry in the loss table that is about\n-- another person rather than about the police.\nfunction GangService.OnBailed(player: Player)\n	GangService.Charge(player, GANGS.Lose.OnBailing, \"You left them in there\")\nend\n\nfunction GangService.IsMember(player: Player): boolean\n	local data = dataFor(player)\n	return data ~= nil and data.gangId ~= nil\nend\n\n-- Which gang somebody runs with, for anything that needs to tell two people apart. Nil for\n-- most players.\nfunction GangService.GangOf(player: Player): string?\n	local data = dataFor(player)\n	return if data ~= nil then data.gangId else nil\nend\n\n-- The color a body sent by this player's crew should wear. Nil for a life not currently in\n-- a gang, which cannot happen for anyone who actually has crew to send -- crew is cleared\n-- the moment you leave, see `leave` -- but a caller checking a body it is about to band\n-- should not have to know that on faith.\nfunction GangService.ColorOf(player: Player): Color3?\n	local data = dataFor(player)\n	if data == nil or data.gangId == nil then\n		return nil\n	end\n	local def = Gangs.ById[data.gangId]\n	return if def ~= nil then def.color else nil\nend\n\n-- Whether the band is actually on their head right now, which is not the same question as\n-- whether they are in a gang: taking the colors off is a thing a member does on purpose.\n-- Asked through Lives rather than read off the profile here so that every caller gets the\n-- same two-part answer -- in a gang, and wearing it -- and none of them can forget the first\n-- half. See Lives.WearingColors, which is where BountyService reads it from too.\nfunction GangService.IsWearing(player: Player): boolean\n	local data = dataFor(player)\n	return data ~= nil and Lives.WearingColors(data)\nend\n\n-- Band on, band off.\n--\n-- The one piece of gang state a player changes with nobody present, and it is not a cosmetic\n-- toggle: the colors multiply every point of heat anything gives you while they are on, so\n-- this is the trade between being counted by your own side and being described by everybody\n-- else.\n--\n-- Public because the remote handler and the debug command both want it and there is exactly\n-- one correct sequence -- write, re-band the character, say so, push -- which is precisely\n-- the kind of thing that gets half-copied into a second caller.\nfunction GangService.SetColors(player: Player, want: boolean): boolean\n	local data = dataFor(player)\n	if data == nil or data.gangId == nil then\n		return false\n	end\n	if data.wearingColors == want then\n		return false\n	end\n	data.wearingColors = want\n	applyColors(player, data)\n	noticeFor(player, if want then \"Colors on.\" else \"Colors off. Nobody knows you.\")\n	push(player)\n	return true\nend\n\n-- Who this player could send on a job right now. Empty for a life with no gang, no rank\n-- that carries a slot, or nobody recruited into it -- almost everybody, almost always --\n-- so a caller can check length rather than asking three separate questions first.\nfunction GangService.CrewFor(player: Player): { GangCrewMember }\n	local data = dataFor(player)\n	if data == nil then\n		return {}\n	end\n	return data.gangCrew\nend\n\n-- Gives a crew member a body to send on a job. A crew member has no persistent look of\n-- their own, only a name and a nerve rating -- Part 2 deliberately stopped at that, see\n-- this file's own header -- so this borrows whichever stranger content/Public would have\n-- handed the bank's guard or the till's clerk and relabels it, the same anonymous-body\n-- pool the rest of the crime tree already draws from.\nfunction GangService.CastMemberFor(crew: GangCrewMember): CastMember\n	local base = Public.Someone()\n	return {\n		id = crew.id,\n		gender = base.gender,\n		name = crew.name,\n		skinColor = base.skinColor,\n		heightScale = base.heightScale,\n		widthScale = base.widthScale,\n		headScale = base.headScale,\n		proportionScale = base.proportionScale,\n		bodyTypeScale = base.bodyTypeScale,\n		shirtAssetId = base.shirtAssetId,\n		pantsAssetId = base.pantsAssetId,\n		hairAssetId = base.hairAssetId,\n	}\nend\n\nlocal function join(player: Player, data: LifeData, def: GangDef)\n	if data.gangId ~= nil then\n		return\n	end\n	if rejoinWaitFor(data) > 0 then\n		return\n	end\n	data.gangId = def.id\n	-- The bottom rung, always, whatever standing is banked from a previous run with them.\n	-- Standing is what they remember about you; the rung is what you currently are, and\n	-- walking back in at the top because you used to be there would make leaving free.\n	data.gangRankId = GANGS.Ranks[1].id\n	data.wearingColors = true\n	data.leftGangAt = nil\n	noticeFor(player, `You run with {def.name}. Wear it.`)\nend\n\nlocal function leave(player: Player, data: LifeData, def: GangDef)\n	if data.gangId ~= def.id then\n		return\n	end\n	data.gangId = nil\n	data.gangRankId = nil\n	data.wearingColors = false\n	-- Cleared, unlike gangStanding. A crew is people who chose to run with *this*\n	-- membership -- see GangCrewMember's own comment -- and carrying them across into\n	-- whatever is joined next would mean somebody else's boss inherited a crew they\n	-- never brought in.\n	data.gangCrew = {}\n	-- Stamped so the rejoin window has something to measure from. Standing is left exactly\n	-- where it was, on purpose: leaving does not make the work not have happened, and a\n	-- gang you left at nine hundred should not take you back as a stranger.\n	data.leftGangAt = data.secondsSinceAgeUp\n	noticeFor(player, `You are nobody's now.`)\n	local character = player.Character\n	if character ~= nil then\n		Colors.Clear(character)\n	end\nend\n\n-- Brings somebody in. The boss's act, not a purchase -- see Config.Gangs.Crew's own\n-- header -- so the only checks are the ones that make a slot real: you have to be in\n-- this gang, and you have to have room.\nlocal function recruit(player: Player, data: LifeData, def: GangDef)\n	if data.gangId ~= def.id then\n		return\n	end\n	local slots = crewSlotsFor(data, def.id)\n	if #data.gangCrew >= slots then\n		noticeFor(player, \"Nobody else to bring in. You are full up.\")\n		return\n	end\n	local name = Gangs.CrewNames[math.random(1, #Gangs.CrewNames)]\n	local member: GangCrewMember = { id = newCrewId(data), name = name, nerve = GANGS.Crew.NerveStart }\n	table.insert(data.gangCrew, member)\n	noticeFor(player, `{name} is running with you now.`)\nend\n\n-- Lets somebody go. Always available to the player who holds the crew, unlike\n-- recruiting -- bringing somebody in is the boss doing you a favour, but cutting them\n-- loose is your own call, and gating that behind a conversation would mean a slot\n-- could be stuck full of somebody the player no longer wanted between two visits to a\n-- garage.\nlocal function dismiss(player: Player, data: LifeData, def: GangDef, crewId: string)\n	if data.gangId ~= def.id then\n		return\n	end\n	local index = crewIndexOf(data, crewId)\n	if index == nil then\n		return\n	end\n	local member = table.remove(data.gangCrew, index)\n	if member ~= nil then\n		noticeFor(player, `{member.name} is not running with you anymore.`)\n	end\nend\n\nlocal function takeRank(player: Player, data: LifeData, def: GangDef, rankId: string)\n	local upcoming = promotableTo(data, def.id)\n	-- Re-checked against the server's own answer rather than trusted from the row that was\n	-- clicked. A client that could name its own rung would be a client that promotes\n	-- itself, and the id is compared as well as the eligibility so that a stale panel --\n	-- one drawn before somebody else's tick moved the standing -- cannot cash in a rung\n	-- that is no longer the next one.\n	if upcoming == nil or upcoming.id ~= rankId then\n		noticeFor(player, \"Not yet.\")\n		return\n	end\n	data.gangRankId = upcoming.id\n	noticeFor(player, `You are {upcoming.label} now.`)\nend\n\n-- Puts somebody in a gang without the walk and the conversation, so the ladder can be tested\n-- more than once in a life.\n--\n-- Goes through the same `join` the panel does rather than writing the two fields itself, and\n-- that is the whole point of it: it still refuses somebody already in a gang and it still\n-- honours the rejoin window, so what gets tested is the join that exists. A debug path that\n-- set `gangId` directly would be a second, easier join that only the developer ever sees.\nfunction GangService.ForceJoin(player: Player, gangId: string): boolean\n	local data = dataFor(player)\n	local def = Gangs.ById[gangId]\n	if data == nil or def == nil then\n		return false\n	end\n	join(player, data, def)\n	applyColors(player, data)\n	push(player)\n	pushPanel(player)\n	return data.gangId == def.id\nend\n\n-- Recruits without the walk, through the same `recruit` the panel's \"Bring somebody\n-- in\" row calls -- so what gets tested is the slot check that exists, not a second one\n-- written for the debug path. Returns the new member's id so `/gang crew` can print it\n-- straight back without a second lookup.\nfunction GangService.ForceRecruit(player: Player, gangId: string): string?\n	local data = dataFor(player)\n	local def = Gangs.ById[gangId]\n	if data == nil or def == nil then\n		return nil\n	end\n	local before = #data.gangCrew\n	recruit(player, data, def)\n	push(player)\n	pushPanel(player)\n	if #data.gangCrew <= before then\n		return nil\n	end\n	return data.gangCrew[#data.gangCrew].id\nend\n\n-- Dismisses without the walk, through the same `dismiss` the panel's \"Let X go\" row\n-- calls.\nfunction GangService.ForceDismiss(player: Player, crewId: string): boolean\n	local data = dataFor(player)\n	if data == nil or data.gangId == nil then\n		return false\n	end\n	local def = Gangs.ById[data.gangId]\n	if def == nil then\n		return false\n	end\n	local before = #data.gangCrew\n	dismiss(player, data, def, crewId)\n	push(player)\n	pushPanel(player)\n	return #data.gangCrew < before\nend\n\nlocal function onChoice(player: Player, gangIdRaw: unknown, choiceRaw: unknown)\n	if not enabled then\n		return\n	end\n	if type(gangIdRaw) ~= \"string\" or type(choiceRaw) ~= \"string\" then\n		return\n	end\n	local data = dataFor(player)\n	if data == nil then\n		return\n	end\n	local def = Gangs.ById[gangIdRaw]\n	if def == nil then\n		return\n	end\n	-- You have to be standing there. The panel is a conversation and the server is the end\n	-- that decides whether it is still happening, so a client replaying a choice from\n	-- across the city is answered by a person who is not there.\n	local watch = watchFor(player)\n	if watch.atGangId ~= def.id then\n		return\n	end\n\n	if choiceRaw == \"join\" then\n		join(player, data, def)\n	elseif choiceRaw == \"leave\" then\n		leave(player, data, def)\n	elseif choiceRaw == \"recruit\" then\n		recruit(player, data, def)\n	else\n		local rankId = string.match(choiceRaw, \"^take_(.+)$\")\n		if rankId ~= nil then\n			takeRank(player, data, def, rankId)\n		end\n		local crewId = string.match(choiceRaw, \"^dismiss_(.+)$\")\n		if crewId ~= nil then\n			dismiss(player, data, def, crewId)\n		end\n	end\n\n	push(player)\n	pushPanel(player)\nend\n\nlocal function onOpen(player: Player, gangIdRaw: unknown)\n	if not enabled then\n		return\n	end\n	if type(gangIdRaw) ~= \"string\" then\n		return\n	end\n	local def = Gangs.ById[gangIdRaw]\n	if def == nil then\n		return\n	end\n	local post = posts[def.id]\n	local visitor = if post ~= nil then post.visitor else nil\n	local at = characterPosition(player)\n	if visitor == nil or visitor.gone() or at == nil then\n		return\n	end\n	local away = (visitor.at() - at)\n	if math.sqrt(away.X * away.X + away.Z * away.Z) > Config.Interact.RangeStuds then\n		return\n	end\n	watchFor(player).atGangId = def.id\n	pushPanel(player)\nend\n\nlocal function onColors(player: Player, wantRaw: unknown)\n	if not enabled or type(wantRaw) ~= \"boolean\" then\n		return\n	end\n	GangService.SetColors(player, wantRaw)\nend\n\nfunction GangService.SetEnabled(value: boolean)\n	enabled = value\n	if not enabled then\n		for _, post in posts do\n			despawnPost(post)\n		end\n		for _, player in Players:GetPlayers() do\n			local character = player.Character\n			if character ~= nil then\n				Colors.Clear(character)\n			end\n		end\n	end\nend\n\nfunction GangService.IsEnabled(): boolean\n	return enabled\nend\n\n-- Wipes gang membership from the life in front of us, for testing the join flow more than\n-- once without starting a new life. Standing goes too, unlike leaving, because the point of\n-- a reset is a clean slate rather than a resignation.\nfunction GangService.ResetPlayer(player: Player)\n	local data = dataFor(player)\n	if data == nil then\n		return\n	end\n	data.gangId = nil\n	data.gangRankId = nil\n	data.gangStanding = {}\n	data.gangCrew = {}\n	data.leftGangAt = nil\n	data.wearingColors = false\n	watchFor(player).peakBounty = 0\n	local character = player.Character\n	if character ~= nil then\n		Colors.Clear(character)\n	end\n	push(player)\n	pushPanel(player)\nend\n\nfunction GangService.Describe(player: Player): string\n	local data = dataFor(player)\n	if data == nil then\n		return \"no profile loaded yet\"\n	end\n	local standings: { string } = {}\n	for _, def in Gangs.All do\n		local post = posts[def.id]\n		local up = post ~= nil and post.visitor ~= nil and not post.visitor.gone()\n		table.insert(\n			standings,\n			string.format(\"%s(%s) %d%s\", def.id, if up then \"boss up\" else \"no boss\", standingIn(data, def.id), if data.gangId == def.id then \"*\" else \"\")\n		)\n	end\n	local held = rankById(data.gangRankId)\n	local upcoming = promotableTo(data, data.gangId or \"\")\n	local crewBits: { string } = {}\n	for _, member in data.gangCrew do\n		table.insert(crewBits, `{member.name}(nerve {math.floor(member.nerve)})`)\n	end\n	local crewDescription = if #crewBits == 0\n		then `crew 0/{crewSlotsFor(data, data.gangId or \"\")}`\n		else `crew {#crewBits}/{crewSlotsFor(data, data.gangId or \"\")}: {table.concat(crewBits, \", \")}`\n	return string.format(\n		\"%s · rank %s · %s · colors %s · %s · rejoin in %.0fs · %s · %s\",\n		if data.gangId ~= nil then data.gangId else \"no gang\",\n		if held ~= nil then held.label else \"-\",\n		if upcoming ~= nil then `can take \"{upcoming.label}\"` else \"nothing to take\",\n		if data.wearingColors then \"on\" else \"off\",\n		crewDescription,\n		rejoinWaitFor(data),\n		table.concat(standings, \", \"),\n		if enabled then \"on\" else \"off\"\n	)\nend\n\nfunction GangService:Init()\n	for _, def in Gangs.All do\n		posts[def.id] = { gangId = def.id, visitor = nil, dots = nil, spawning = false }\n	end\n\n	RequestGangOpenRemote.OnServerEvent:Connect(function(player: Player, gangId: unknown)\n		local ok, err = pcall(onOpen, player, gangId)\n		if not ok then\n			warn(`[AGES] gang open failed for {player.Name}: {err}`)\n		end\n	end)\n	RequestGangChoiceRemote.OnServerEvent:Connect(function(player: Player, gangId: unknown, choice: unknown)\n		local ok, err = pcall(onChoice, player, gangId, choice)\n		if not ok then\n			warn(`[AGES] gang choice failed for {player.Name}: {err}`)\n		end\n	end)\n	RequestGangColorsRemote.OnServerEvent:Connect(function(player: Player, want: unknown)\n		local ok, err = pcall(onColors, player, want)\n		if not ok then\n			warn(`[AGES] gang colors failed for {player.Name}: {err}`)\n		end\n	end)\n\n	Players.PlayerRemoving:Connect(function(player: Player)\n		watches[player] = nil\n		pushed[player] = nil\n		pushedPanel[player] = nil\n	end)\nend\n\nfunction GangService:Start()\n	task.spawn(function()\n		while true do\n			task.wait(GANGS.TickSeconds)\n			if enabled then\n				local ok, err = pcall(tickPosts)\n				if not ok then\n					warn(`[AGES] gang posts tick failed: {err}`)\n				end\n			end\n			for _, player in Players:GetPlayers() do\n				local ok, err = pcall(tickPlayer, player)\n				if not ok then\n					warn(`[AGES] gang tick failed for {player.Name}: {err}`)\n				end\n			end\n		end\n	end)\nend\n\nreturn GangService\n"
table.insert(AGES_MANIFEST, "src/server/services/GangService.luau")
AGES_SOURCES["src/server/services/GeographyService.luau"] = "--!strict\n-- Geography: the errand, and the one lesson where the game stops telling you where\n-- things are.\n--\n-- The loop:\n--\n--   You are given a place's name -- \"the pages & press, by the counter\", \"number 5, on\n--   avenue 2\" -- and nothing else. No lit disc, no beam, no line on the floor, no\n--   distance counting down. You walk. When you get there the lesson says so and gives\n--   you the next name. Three of them, then it is over.\n--\n-- What makes it a mechanic rather than a fetch quest:\n--\n--   The absence *is* the verb. Every other destination in AGES arrives as a gold disc\n--   with a beam over it -- job pads, shift marks, event anchors, the toddler's lure --\n--   and that is right, because in every one of those systems finding the place is\n--   overhead in front of the activity. Here finding the place is the activity, and the\n--   moment a marker appears the subject has nothing left in it. This file therefore\n--   never touches GuideUpdated, and that is a design constraint rather than an omission.\n--\n--   Mastery buys back help, one rung at a time, and buys nothing else. Level one is the\n--   name alone. Level two adds roughly which end of town. Level three puts an arrow on\n--   the screen. Level four adds how far. Level five tops the subject out and buys the\n--   right to skip it, like every other subject's top rung. That is Bully's map markers:\n--   a level is felt as the town becoming legible, not as a number going up, which is the\n--   whole of what this rebuild is for.\n--\n--   Failure is soft and measured in the verb's own units. A stop the clock ran out on\n--   still pays for how much of the gap the player closed -- see Hunt.MissedCreditCap --\n--   so being lost near the bookstore is worth more than never leaving the school, and a\n--   missed stop moves the lesson on rather than ending it.\n--\n-- What this file is deliberately not:\n--\n--   It is not a second school. The door, the yearly cap, the smarts payout and the\n--   verdict shares are School's, read from Config.School, and a hunt still spends one of\n--   the three lessons in the year.\n--\n--   It does not own a list of places. Every destination is drawn from the live place\n--   graph at the moment the lesson starts, so there is no content file here to fall out\n--   of step with the world -- and a town that grows gets a richer subject for free,\n--   which is exactly what happened to be needed while the city was being rebuilt\n--   underneath it.\n\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Config = require(ReplicatedStorage:WaitForChild(\"Config\"))\nlocal Remotes = require(ReplicatedStorage:WaitForChild(\"Remotes\"))\nlocal Types = require(ReplicatedStorage:WaitForChild(\"Types\"))\nlocal Lives = require(ReplicatedStorage:WaitForChild(\"Lives\"))\nlocal Mastery = require(ReplicatedStorage:WaitForChild(\"school\"):WaitForChild(\"Mastery\"))\nlocal Report = require(ReplicatedStorage:WaitForChild(\"school\"):WaitForChild(\"Report\"))\n\nlocal DataService = require(script.Parent.DataService)\nlocal EventService = require(script.Parent.EventService)\nlocal PlaceService = require(script.Parent.PlaceService)\nlocal StatService = require(script.Parent.StatService)\nlocal Ground = require(script.Parent.Parent.world.Ground)\n\ntype LifeData = Types.LifeData\ntype HuntState = Types.HuntState\ntype Place = Types.Place\n\nlocal GeographyService = {}\n\nlocal HuntUpdatedRemote = Remotes.Get(\"HuntUpdated\")\n\nlocal SCHOOL = Config.School\nlocal HUNT = SCHOOL.Hunt\n\n-- The subject id this service answers to. A constant rather than a parameter because\n-- there is exactly one hunt subject; the day there is a second, this becomes an argument\n-- and nothing else here changes.\nlocal SUBJECT_ID = \"geography\"\n\n-- The eight points of the compass, in clockwise order from north. Not a tunable and not\n-- Config's: it is the compass. Eight rather than four because four cannot tell \"the north\n-- end of town\" from \"the far corner\", and rather than sixteen because \"north-north-east\"\n-- is precision a sector does not have and nobody says out loud anyway.\nlocal COMPASS = { \"north\", \"north-east\", \"east\", \"south-east\", \"south\", \"south-west\", \"west\", \"north-west\" }\n\n-- Degrees per compass sector, derived rather than written down so the two can never\n-- disagree about how many there are.\nlocal DEGREES_PER_SECTOR = 360 / #COMPASS\n\n-- The ladder of help, as ranks. Every rung shows everything the rungs below it showed, so\n-- a level is one number and the four questions below are all answered by comparing\n-- against it.\nlocal REVEAL_RANK: { [string]: number } = {\n	name = 1,\n	area = 2,\n	bearing = 3,\n	range = 4,\n}\n\n-- The two ladders have to be the same length, and this is the only place that can notice.\n-- School.Mastery.Levels says how many rungs there are; Hunt.RevealedByLevel says what each\n-- rung tells you. A sixth rung added to one and not the other is a promotion the verb has\n-- no answer for -- the player is told they levelled up and the town does not get any more\n-- legible -- which is the numbers-only progression this rebuild exists to remove,\n-- arriving by accident.\n--\n-- Loud at require time rather than clamped quietly, because clamping is what hides it: the\n-- level would work, the help would not, and nothing would ever say so. The same reasoning,\n-- and the same shape, as ScienceService's check on RevealedStepsByLevel.\nif #HUNT.RevealedByLevel ~= Mastery.Levels then\n	error(\n		`[AGES config] School.Hunt.RevealedByLevel has {#HUNT.RevealedByLevel} entries but School.Mastery.Levels`\n			.. ` is {Mastery.Levels}. Every mastery rung has to say what it tells you about a destination, so the`\n			.. ` list must have exactly one word per level. Add or remove one.`\n	)\nend\n\n-- Each rung must name a kind of help this file knows how to give, and must never tell you\n-- less than the rung below it. A ladder that goes back down is a promotion that takes the\n-- arrow away, which would read as a bug in the arrow rather than as a typo in Config.\ndo\n	local previous = 0\n	for level, word in HUNT.RevealedByLevel do\n		local rank = REVEAL_RANK[word]\n		if rank == nil then\n			error(\n				`[AGES config] School.Hunt.RevealedByLevel[{level}] is \"{word}\", which Geography has no answer for.`\n					.. ` It must be one of: name, area, bearing, range.`\n			)\n		end\n		if rank < previous then\n			error(\n				`[AGES config] School.Hunt.RevealedByLevel[{level}] is \"{word}\", which tells the player less than`\n					.. ` the rung below it. Levelling up must never take help away. Reorder the list.`\n			)\n		end\n		previous = rank\n	end\nend\n\n-- A leg has to have a band to land in.\nif HUNT.MinLegStuds >= HUNT.MaxLegStuds then\n	error(\n		`[AGES config] School.Hunt.MinLegStuds ({HUNT.MinLegStuds}) is not below MaxLegStuds ({HUNT.MaxLegStuds}),`\n			.. ` so no destination can ever be drawn in the band. Swap them.`\n	)\nend\n\n-- One destination, live or closed.\ntype Stop = {\n	index: number,\n	id: string,\n	label: string,\n	at: Vector3,\n	-- How far it was when it was given, and the nearest the player has been since. The\n	-- pair is what a missed stop is scored on: the share of the original gap closed.\n	startGap: number,\n	nearest: number,\n	secondsLeft: number,\n}\n\n-- One player's hunt. Only ever one -- you cannot be on two errands.\ntype Session = {\n	-- Where the lesson began, which is the school. The compass sector sits here rather\n	-- than on the player, because \"it is over in the east\" is a thing you are told once\n	-- with the name and not a needle that swings as you walk. The arrow is the live one.\n	origin: Vector3,\n	-- Every place this lesson may send the player to, worked out once at Begin.\n	--\n	-- Cached, unlike PlaceService's own reads: a place moved in Studio mid-lesson would\n	-- otherwise move the destination the player is currently walking to, which is a worse\n	-- failure than a ninety-second delay before an edit takes effect.\n	pool: { Place },\n	used: { [string]: boolean },\n	stops: number,\n	current: Stop?,\n	-- How many have been reached, which is what the player is shown, and the credit\n	-- earned, which includes part-marks for the ones that were not. The two are different\n	-- numbers on purpose -- \"1 of 3\" is a fact and 0.62 is a grade.\n	found: number,\n	credit: number,\n	closed: number,\n	-- The ladder, mirrored for the panel to draw. The profile is the single writer -- both\n	-- are re-read off it whenever they can have moved -- so these two can never drift from\n	-- what Mastery thinks.\n	level: number,\n	passes: number,\n	-- The rung this life was on when the lesson opened, kept so the report card line can\n	-- say whether this afternoon moved it.\n	levelAtStart: number,\n	-- The line about the stop just reached, held for a beat before the next name is given.\n	arrived: string?,\n	arrivedLeft: number,\n	summary: string?,\n	verdictLeft: number,\n}\n\nlocal sessions: { [Player]: Session } = {}\n\n-- The last thing pushed to each player, so an unchanged state is not re-sent four times a\n-- second. Same reason SchoolService and ScienceService keep one.\nlocal pushed: { [Player]: string } = {}\n\n-- Switched off by the harness. Same shape as School's, and checked in the same two places:\n-- at the door, and on every tick of a hunt already running.\nlocal enabled = true\n\nlocal function characterPosition(player: Player): Vector3?\n	local character = player.Character\n	if character == nil then\n		return nil\n	end\n	local root = character:FindFirstChild(\"HumanoidRootPart\")\n	if root == nil or not root:IsA(\"BasePart\") then\n		return nil\n	end\n	return root.Position\nend\n\nlocal function ageYearsOf(data: LifeData): number\n	return math.floor(data.ageMonths / 12)\nend\n\nlocal function levelOf(data: LifeData): number\n	return Mastery.LevelOf(data, SUBJECT_ID)\nend\n\n-- How much this level tells you, as a rank. Clamped rather than indexed blind: a stored\n-- level from a build with a longer ladder must not index off the end of a shorter one, and\n-- the honest reading of \"level 9 on a five-rung ladder\" is the top rung. The require-time\n-- check above makes that unreachable from Config; this covers the profile.\nlocal function revealRankFor(level: number): number\n	local ladder = HUNT.RevealedByLevel\n	local rung = math.clamp(math.floor(level), 1, #ladder)\n	return REVEAL_RANK[ladder[rung]] or 1\nend\n\n-- Degrees clockwise from north, where north is -Z -- the direction a Roblox character\n-- faces at rest, and the one the world generators lay their avenues along.\nlocal function bearingBetween(from: Vector3, to: Vector3): number\n	local delta = to - from\n	local degrees = math.deg(math.atan2(delta.X, -delta.Z))\n	return (degrees + 360) % 360\nend\n\nlocal function sectorFor(degrees: number): string\n	local index = math.floor(degrees / DEGREES_PER_SECTOR + 0.5) % #COMPASS\n	return COMPASS[index + 1]\nend\n\n-- Somewhere a child could actually be sent. Two rules, both read off the world rather\n-- than off a list of ids here:\n--\n--   A route node is not a destination. Roughly 174 of the city's 382 place points are\n--   crossings and avenue midpoints -- see World.PlaceWaypointPrefix -- and \"go to cross\n--   street 4\" names a road marking.\n--\n--   Upstairs is somebody's home. A verb that gives you a name and no marker can only be\n--   played by a player who can see the destination from the street; a first-floor\n--   apartment behind an unmarked door is not findable, it is already-known. See\n--   Hunt.MaxRiseStuds.\nlocal function eligiblePlaces(origin: Vector3): { Place }\n	local prefix = Config.World.PlaceWaypointPrefix\n	local out: { Place } = {}\n	for _, place in PlaceService.All() do\n		if string.sub(place.id, 1, #prefix) == prefix then\n			continue\n		end\n		if math.abs(place.part.Position.Y - origin.Y) > HUNT.MaxRiseStuds then\n			continue\n		end\n		table.insert(out, place)\n	end\n	return out\nend\n\n-- The next destination, drawn from `from` -- which is the school for the first stop and\n-- the last place reached for the rest, so a hunt walks a loop around a district rather\n-- than crossing the map and coming back.\n--\n-- Inside the band by preference, and the nearest thing to the band when the band is empty.\n-- Falling back rather than failing matters: a lesson that cannot draw its third stop would\n-- have to end early, and a lesson that ends early because of where the player happens to\n-- be standing is a lesson that scores them for the town's layout.\nlocal function drawStop(session: Session, from: Vector3): Place?\n	local inBand: { Place } = {}\n	local nearest: Place? = nil\n	local nearestMiss = math.huge\n\n	for _, place in session.pool do\n		if session.used[place.id] then\n			continue\n		end\n		local gap = Ground.FlatDistance(from, place.part.Position)\n		if gap >= HUNT.MinLegStuds and gap <= HUNT.MaxLegStuds then\n			table.insert(inBand, place)\n			continue\n		end\n		-- How far out of the band it is, so the fallback picks the least wrong leg rather\n		-- than simply the closest -- which on a crowded street would be the shop next door\n		-- every time.\n		local miss = if gap < HUNT.MinLegStuds then HUNT.MinLegStuds - gap else gap - HUNT.MaxLegStuds\n		if miss < nearestMiss then\n			nearestMiss = miss\n			nearest = place\n		end\n	end\n\n	if #inBand > 0 then\n		return inBand[math.random(#inBand)]\n	end\n	return nearest\nend\n\nlocal function stateFor(player: Player): HuntState?\n	local session = sessions[player]\n	if session == nil then\n		return nil\n	end\n\n	local stop = session.current\n	if stop == nil then\n		-- Between stops, or after the last one. The label of record is whatever the\n		-- closing line or the arrival line is talking about, so the panel does not blank\n		-- out mid-sentence.\n		return {\n			stop = math.min(session.closed + 1, session.stops),\n			stops = session.stops,\n			label = \"\",\n			area = nil,\n			bearing = nil,\n			rangeStuds = nil,\n			secondsLeft = 0,\n			found = session.found,\n			level = session.level,\n			levelMax = Mastery.Levels,\n			passes = session.passes,\n			passesPerLevel = Mastery.PassesPerLevel,\n			arrived = session.arrived,\n			summary = session.summary,\n		}\n	end\n\n	local rank = revealRankFor(session.level)\n\n	-- Measured live from where the player is standing, not from the origin: the arrow and\n	-- the range are the two pieces of help that are only worth having because they update\n	-- as you walk. The sector is not -- it is a fact about the town, given once with the\n	-- name, and it is measured from the school.\n	local position = characterPosition(player) or session.origin\n\n	return {\n		stop = stop.index,\n		stops = session.stops,\n		label = stop.label,\n		area = if rank >= REVEAL_RANK.area then sectorFor(bearingBetween(session.origin, stop.at)) else nil,\n		bearing = if rank >= REVEAL_RANK.bearing then bearingBetween(position, stop.at) else nil,\n		rangeStuds = if rank >= REVEAL_RANK.range then Ground.FlatDistance(position, stop.at) else nil,\n		secondsLeft = math.max(0, stop.secondsLeft),\n		found = session.found,\n		level = session.level,\n		levelMax = Mastery.Levels,\n		passes = session.passes,\n		passesPerLevel = Mastery.PassesPerLevel,\n		arrived = session.arrived,\n		summary = session.summary,\n	}\nend\n\nlocal function push(player: Player)\n	local state = stateFor(player)\n	-- A digest rather than a deep compare, and it has to name every field that is drawn.\n	-- The bearing and the range are quantised rather than compared exactly, because both\n	-- move on every floating-point wobble of a walking character.\n	--\n	-- It does not save anything while a stop is live -- the clock is in here and the tick\n	-- is a quarter second, so that term changes on every pass by construction. What it\n	-- saves is the two beats where nothing is moving: the arrival pause and the closing\n	-- line, both of which would otherwise re-send an identical snapshot four times a\n	-- second for as long as they hold.\n	local digest: string\n	if state == nil then\n		digest = \"none\"\n	else\n		digest = `{state.stop}/{state.stops}/{state.label}/{tostring(state.area)}/`\n			.. `{if state.bearing ~= nil then math.floor(state.bearing) else \"-\"}/`\n			.. `{if state.rangeStuds ~= nil then math.floor(state.rangeStuds) else \"-\"}/`\n			.. `{math.floor(state.secondsLeft * 4)}/{state.found}/{state.level}/{state.passes}/`\n			.. `{tostring(state.arrived)}/{tostring(state.summary)}`\n	end\n\n	if pushed[player] == digest then\n		return\n	end\n	pushed[player] = digest\n	HuntUpdatedRemote:FireClient(player, state)\nend\n\n-- Opens the next destination, or returns false when there is nothing left to open --\n-- either because the lesson has had its three, or because the town ran out of places that\n-- have not already been used.\nlocal function openStop(session: Session, from: Vector3): boolean\n	if session.closed >= session.stops then\n		return false\n	end\n	local place = drawStop(session, from)\n	if place == nil then\n		return false\n	end\n	session.used[place.id] = true\n	local at = place.part.Position\n	local gap = Ground.FlatDistance(from, at)\n	session.current = {\n		index = session.closed + 1,\n		id = place.id,\n		label = place.label,\n		at = at,\n		startGap = gap,\n		nearest = gap,\n		secondsLeft = HUNT.SecondsPerStop,\n	}\n	return true\nend\n\n-- Scores the destination in hand and puts it away. `found` decides which of the two ways\n-- it closes; both are worth something and neither ends the lesson.\nlocal function closeStop(session: Session, stop: Stop, found: boolean)\n	session.closed += 1\n	session.current = nil\n\n	if found then\n		session.found += 1\n		session.credit += 1\n		session.arrived = `Found it -- {stop.label}.`\n	else\n		-- The share of the original gap the player actually closed, capped well below what\n		-- arriving pays. Zero when they never got any nearer than they started, which is\n		-- the honest score for not having looked.\n		local closedShare = if stop.startGap > 0\n			then math.clamp(1 - stop.nearest / stop.startGap, 0, 1)\n			else 0\n		session.credit += closedShare * HUNT.MissedCreditCap\n		session.arrived = if closedShare >= 0.5\n			then `Time -- you were close. It was {stop.label}.`\n			else `Time. It was {stop.label}.`\n	end\n\n	session.arrivedLeft = HUNT.ArrivedSeconds\nend\n\n-- Ends the lesson and pays for it. `reason` changes the sentence but never the arithmetic.\n--\n-- The divisor is always the full three, never the number of stops that got as far as being\n-- handed out, and that is what makes walking away cost something: an errand abandoned after\n-- one find is a third of a lesson, not a whole lesson with one stop in it. The same rule a\n-- quiz and a lab run on -- leaving early is a way of getting the rest wrong.\nlocal function finish(player: Player, data: LifeData, session: Session, reason: string)\n	local stop = session.current\n	if stop ~= nil then\n		closeStop(session, stop, false)\n	end\n\n	local share = if session.stops > 0 then math.clamp(session.credit / session.stops, 0, 1) else 0\n\n	-- Graded through Report rather than against SCHOOL's thresholds directly, for the\n	-- reason Report is shared at all: a hunt, a lab and a quiz are three ways of spending\n	-- the same afternoon, and the day two of them disagreed about what a good one was would\n	-- be the day the report card and the closing line said different things about it.\n	local band = Report.BandFor(share)\n	local gained = Report.SmartsFor(band)\n\n	if gained ~= 0 then\n		StatService.AddStat(player, \"smarts\", gained)\n	end\n\n	-- Banked once, on the whole lesson, rather than per stop the way a lab banks per bench.\n	-- A bench is a self-contained procedure and a stop is not: three destinations are one\n	-- errand, and paying the ladder three times for it would make Geography climb at three\n	-- times the rate of every other subject.\n	local level = Mastery.Record(data, SUBJECT_ID, share)\n\n	-- Counted however it ended, including walked away from, for the reason a lesson is:\n	-- otherwise a player could start, leave, and start again until they drew a set of\n	-- destinations they liked the look of.\n	data.lessonsThisYear += 1\n	EventService.AwardAutonomy(player, 1)\n\n	-- The promotion is reported only when this lesson moved it -- a card line reading\n	-- \"Geography, level 3\" against an afternoon that began on that rung would read as\n	-- though the afternoon had earned it.\n	Report.RecordLesson(data, SUBJECT_ID, band, gained, if level > session.levelAtStart then level else nil)\n\n	session.level = level\n	session.passes = Mastery.PassesOf(data, SUBJECT_ID)\n\n	local percent = math.floor(share * 100 + 0.5)\n	local reward = if gained > 0 then `. +{gained} smarts.` else \".\"\n	local opening = if reason == \"left\" then \"You gave up on the errand.\" else \"Errand over.\"\n	session.summary = `{opening} {session.found} of {session.stops} found, {percent}%{reward}`\n	session.arrived = nil\n	session.arrivedLeft = 0\n	session.verdictLeft = SCHOOL.VerdictSeconds\n	push(player)\nend\n\n-- Why this player cannot be sent on an errand right now, or nil if they can. Only the\n-- things Geography itself refuses -- the age, the yearly cap and the door are School's,\n-- checked before this is ever called.\n--\n-- Takes the pool rather than working it out, so Begin walks the place graph exactly once.\n-- Three hundred and eighty-two parts is cheap but it is not free, and the version of this\n-- that scanned it twice was scanning it a second time only to count the same list.\nlocal function refusalFor(pool: { Place }): string?\n	if not enabled then\n		return \"There is no geography today.\"\n	end\n	if #pool < HUNT.Stops then\n		-- Named rather than a shrug. Too few places is a build problem -- an unbuilt town,\n		-- or a world whose place points are all route nodes -- and a developer who is told\n		-- the count can go and look at the right thing.\n		return `There is nowhere to send you: the town has {#pool} places in it and the errand needs {HUNT.Stops}.`\n	end\n	return nil\nend\n\n-- Starts a hunt from wherever the player is standing, which is the school. Returns false\n-- with a reason worth saying out loud.\n--\n-- Unlike a lab, this is genuinely started from the player's own feet, and it has to be:\n-- the first leg is measured from where they are, and the compass sector every later hint\n-- is phrased against is anchored there too. A harness that skips the walk to school\n-- therefore runs a real errand from wherever it was typed, which is the right thing for it\n-- to do.\nfunction GeographyService.Begin(player: Player, data: LifeData): (boolean, string?)\n	if sessions[player] ~= nil then\n		return false, \"You are already on an errand.\"\n	end\n	local origin = characterPosition(player)\n	if origin == nil then\n		return false, \"You are not standing anywhere yet.\"\n	end\n	local pool = eligiblePlaces(origin)\n	local refusal = refusalFor(pool)\n	if refusal ~= nil then\n		return false, refusal\n	end\n\n	local level = levelOf(data)\n	local session: Session = {\n		origin = origin,\n		pool = pool,\n		used = {},\n		stops = HUNT.Stops,\n		current = nil,\n		found = 0,\n		credit = 0,\n		closed = 0,\n		level = level,\n		passes = Mastery.PassesOf(data, SUBJECT_ID),\n		levelAtStart = level,\n		arrived = nil,\n		arrivedLeft = 0,\n		summary = nil,\n		verdictLeft = 0,\n	}\n\n	if not openStop(session, origin) then\n		-- Unreachable given the pool check above, which counts the same list this draws\n		-- from. Kept because \"the errand silently did not start\" is the one outcome that\n		-- would look like the school itself being broken.\n		return false, \"There is nowhere to send you from here.\"\n	end\n\n	sessions[player] = session\n	push(player)\n	return true, nil\nend\n\nlocal function tickPlayer(player: Player, elapsed: number)\n	local session = sessions[player]\n	if session == nil then\n		return\n	end\n\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return\n	end\n	local data = Lives.Active(profile.Data)\n\n	-- The closing line, held for a beat and then the hunt is gone. Checked first so nothing\n	-- below runs against a lesson that has already been scored.\n	if session.summary ~= nil then\n		session.verdictLeft -= elapsed\n		if session.verdictLeft <= 0 then\n			sessions[player] = nil\n			pushed[player] = nil\n			HuntUpdatedRemote:FireClient(player, nil)\n			return\n		end\n		push(player)\n		return\n	end\n\n	if not data.alive or not enabled then\n		finish(player, data, session, \"left\")\n		return\n	end\n\n	local position = characterPosition(player)\n	if position == nil then\n		-- Mid-respawn, so there is no body to be anywhere. The clock is deliberately held\n		-- rather than run down: a player with no character cannot walk, and charging them\n		-- for seconds they could not have used is charging them for the engine. Death is\n		-- caught above, so this cannot be used to park the lesson.\n		return\n	end\n\n	-- The beat after arriving, before the next name is given. Nothing else runs during it,\n	-- which is what makes reaching somewhere land as a moment rather than as a line\n	-- replaced mid-read.\n	if session.arrivedLeft > 0 then\n		session.arrivedLeft -= elapsed\n		if session.arrivedLeft <= 0 then\n			session.arrivedLeft = 0\n			session.arrived = nil\n			-- The next leg is measured from where the player is now rather than from the\n			-- place they were sent to, which are the same spot when they arrived and are\n			-- not when the clock ran out. Measuring from the missed destination would send\n			-- a lost player somewhere near a place they never found.\n			if not openStop(session, position) then\n				finish(player, data, session, \"over\")\n				return\n			end\n		end\n		push(player)\n		return\n	end\n\n	local stop = session.current\n	if stop == nil then\n		-- Nothing in hand and no beat running, which the two branches above should have\n		-- made impossible. Ending it cleanly rather than spinning: a hunt with no\n		-- destination is a lesson with nothing to do, and that is the stall this codebase\n		-- treats as the worst failure shape.\n		finish(player, data, session, \"over\")\n		return\n	end\n\n	local gap = Ground.FlatDistance(position, stop.at)\n	if gap < stop.nearest then\n		stop.nearest = gap\n	end\n\n	if gap <= HUNT.ArriveRadiusStuds then\n		closeStop(session, stop, true)\n		push(player)\n		return\n	end\n\n	stop.secondsLeft -= elapsed\n	if stop.secondsLeft <= 0 then\n		closeStop(session, stop, false)\n		push(player)\n		return\n	end\n\n	push(player)\nend\n\n-- Ends whatever is running and forgets this player entirely, without grading. The one\n-- place a hunt ends ungraded, because in every case that calls it there is nobody left to\n-- grade -- a player who left, or a life being started over.\nlocal function forget(player: Player)\n	sessions[player] = nil\n	pushed[player] = nil\nend\n\n-- Whether this player is mid-errand. Read by SchoolService, which has to know both that a\n-- player standing back on the school pad is not starting a second lesson and that a\n-- birthday landing mid-errand is a year they turned up for.\nfunction GeographyService.IsRunning(player: Player): boolean\n	return sessions[player] ~= nil\nend\n\n-- A new life. Nobody inherits an education, and the mastery ladder is per life for exactly\n-- the reason bonds and money are.\nfunction GeographyService.ResetForNewLife(player: Player)\n	forget(player)\n	local profile = DataService.GetProfile(player)\n	if profile ~= nil then\n		Mastery.Clear(Lives.Active(profile.Data), SUBJECT_ID)\n	end\n	HuntUpdatedRemote:FireClient(player, nil)\nend\n\n-- Studio harness: starts an errand from wherever the player is standing, skipping the walk\n-- to school but nothing else. The destinations are drawn from the real place graph around\n-- wherever that is, so this tests the errand that exists rather than one laid out for it.\nfunction GeographyService.ForceStart(player: Player): (boolean, string?)\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return false, \"no profile loaded\"\n	end\n	return GeographyService.Begin(player, Lives.Active(profile.Data))\nend\n\n-- Studio harness: counts the destination in hand as reached, without the walk.\n--\n-- The most useful command in this system by some distance, because the walk is thirty\n-- seconds and it is in front of everything else worth testing -- the arrival beat, the\n-- second leg being drawn from the right spot, the closing line, the report card row.\nfunction GeographyService.ForceFind(player: Player): boolean\n	local session = sessions[player]\n	if session == nil or session.summary ~= nil then\n		return false\n	end\n	local stop = session.current\n	if stop == nil then\n		return false\n	end\n	closeStop(session, stop, true)\n	push(player)\n	return true\nend\n\n-- Ends a hunt and grades it, exactly as running out of destinations would.\n--\n-- Refuses a lesson that has already been graded rather than grading it twice. Only\n-- reachable from the harness -- `/geo end` twice inside the verdict beat, which is easy to\n-- hit -- but grading is the one act in this verb that pays smarts and spends a lesson off\n-- the year's allowance, and a command that can be held down for free smarts is not a\n-- harness, it is a cheat.\nfunction GeographyService.ForceEnd(player: Player): boolean\n	local session = sessions[player]\n	local profile = DataService.GetProfile(player)\n	if session == nil or profile == nil or session.summary ~= nil then\n		return false\n	end\n	finish(player, Lives.Active(profile.Data), session, \"over\")\n	return true\nend\n\n-- Studio harness: sets the mastery level directly.\n--\n-- The other command worth having, because the thing mastery buys here is *the interface* --\n-- a sector, then an arrow, then a distance -- and the only other way to see the top of that\n-- ladder is to run eight good errands. Clamped rather than refused, so asking for level\n-- nine gets the top rung.\nfunction GeographyService.SetLevel(player: Player, level: number): boolean\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return false\n	end\n	local data = Lives.Active(profile.Data)\n	Mastery.Set(data, SUBJECT_ID, level)\n\n	-- Applied to a hunt in progress too, so the command can be run mid-walk and the arrow\n	-- appear on the next tick. That is the whole point of being able to set it.\n	local session = sessions[player]\n	if session ~= nil then\n		session.level = levelOf(data)\n		session.passes = Mastery.PassesOf(data, SUBJECT_ID)\n		push(player)\n	end\n	return true\nend\n\nfunction GeographyService.SetEnabled(value: boolean)\n	enabled = value\nend\n\nfunction GeographyService.IsEnabled(): boolean\n	return enabled\nend\n\n-- What the harness prints: whether the town can carry an errand at all, then who this\n-- player is to it, then what is actually running -- the same order SchoolService.Describe\n-- and ScienceService.Describe use, because somebody debugging one is usually about to debug\n-- another.\nfunction GeographyService.Describe(player: Player): string\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return \"geography: no profile loaded\"\n	end\n	local data = Lives.Active(profile.Data)\n\n	local origin = characterPosition(player)\n	local town: string\n	if origin == nil then\n		town = \"no character, so nothing can be measured\"\n	else\n		local all = #PlaceService.All()\n		town = `{#eligiblePlaces(origin)} places sendable of {all} tagged`\n	end\n\n	local level = levelOf(data)\n	local ladder = HUNT.RevealedByLevel\n	local shows = ladder[math.clamp(level, 1, #ladder)]\n	local mastery = `level {level}/{Mastery.Levels}, shows {shows}, {Mastery.PassesOf(data, SUBJECT_ID)}`\n		.. `/{Mastery.PassesPerLevel} passes`\n		.. if Mastery.IsTopped(data, SUBJECT_ID) then \" (topped out -- can skip)\" else \"\"\n\n	local running = \"no errand\"\n	local session = sessions[player]\n	if session ~= nil then\n		local stop = session.current\n		local where: string\n		if session.summary ~= nil then\n			where = \"graded\"\n		elseif stop == nil then\n			where = `between stops ({string.format(\"%.1f\", session.arrivedLeft)}s beat)`\n		else\n			local gap = if origin ~= nil then Ground.FlatDistance(origin, stop.at) else -1\n			where = `stop {stop.index} \"{stop.id}\" {math.floor(gap)} studs off,`\n				.. ` {string.format(\"%.1f\", stop.secondsLeft)}s left`\n		end\n		running = `{session.found}/{session.stops} found, {string.format(\"%.2f\", session.credit)} credit | {where}`\n	end\n\n	return string.format(\n		\"geography: %s | %s | age %d | %s | %s\",\n		if enabled then \"enabled\" else \"DISABLED\",\n		town,\n		ageYearsOf(data),\n		mastery,\n		running\n	)\nend\n\nfunction GeographyService:Start()\n	Players.PlayerRemoving:Connect(function(player: Player)\n		forget(player)\n	end)\n\n	task.spawn(function()\n		while true do\n			local elapsed = task.wait(HUNT.TickSeconds)\n			for _, player in Players:GetPlayers() do\n				local ok, err = pcall(tickPlayer, player, elapsed)\n				if not ok then\n					warn(`[AGES] geography tick failed for {player.Name}: {err}`)\n				end\n			end\n		end\n	end)\nend\n\nreturn GeographyService\n"
