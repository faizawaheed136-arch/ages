AGES_SOURCES["src/server/services/StatService.luau"] = "--!strict\n-- The four primary stats: clamping, decay, and pushing updates to clients.\n-- This is the only place stat values are ever written.\n\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Config = require(ReplicatedStorage:WaitForChild(\"Config\"))\nlocal Types = require(ReplicatedStorage:WaitForChild(\"Types\"))\nlocal Remotes = require(ReplicatedStorage:WaitForChild(\"Remotes\"))\nlocal Lives = require(ReplicatedStorage:WaitForChild(\"Lives\"))\n\nlocal DataService = require(script.Parent.DataService)\n\ntype Stats = Types.Stats\ntype StatName = Types.StatName\n\nlocal STAT_NAMES: { StatName } = { \"health\", \"happiness\", \"smarts\", \"looks\" }\n\nlocal StatService = {}\n\nlocal function clamp(value: number): number\n	return math.clamp(value, Config.Stats.Min, Config.Stats.Max)\nend\n\nlocal function pushStats(player: Player, stats: Stats)\n	Remotes.Get(\"StatsUpdated\"):FireClient(player, stats)\nend\n\nfunction StatService.GetStats(player: Player): Stats?\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return nil\n	end\n	local stats = Lives.Active(profile.Data).stats\n	return {\n		health = stats.health,\n		happiness = stats.happiness,\n		smarts = stats.smarts,\n		looks = stats.looks,\n	}\nend\n\n-- Every interaction in the game should call this at least once — if a\n-- choice doesn't move a stat, per the spec it should be cut.\nfunction StatService.AddStat(player: Player, statName: StatName, delta: number)\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return\n	end\n	local stats = Lives.Active(profile.Data).stats\n	stats[statName] = clamp(stats[statName] + delta)\n	pushStats(player, stats)\nend\n\nfunction StatService.SetStat(player: Player, statName: StatName, value: number)\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return\n	end\n	local stats = Lives.Active(profile.Data).stats\n	stats[statName] = clamp(value)\n	pushStats(player, stats)\nend\n\n-- Called once per in-game year by LifeService.\nfunction StatService.ApplyYearlyDecay(player: Player, ageYears: number)\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return\n	end\n	local data = Lives.Active(profile.Data)\n	local stats = data.stats\n	local multiplier = if ageYears >= Config.Stats.ElderDecayStartAge then Config.Stats.ElderDecayMultiplier else 1\n\n	for _, statName in STAT_NAMES do\n		local decay = Config.Stats.DecayPerYear[statName]\n		if decay ~= 0 then\n			stats[statName] = clamp(stats[statName] - decay * multiplier)\n		end\n	end\n\n	-- Being unwell costs more than an ordinary year does, and it is the kind of\n	-- drain that can end a life rather than merely dim one. Read straight off the\n	-- flag rather than through a service so this stays a leaf in the require graph:\n	-- the flag is the contract, and nothing here needs to know how it got set.\n	if data.flags.sick ~= nil then\n		stats.health = clamp(stats.health - Config.Health.SickHealthPerYear)\n		stats.happiness = clamp(stats.happiness - Config.Health.SickHappinessPerYear)\n	end\n\n	-- Debt is the one thing in the game that compounds against the player. The\n	-- flag was set by BillService the moment the balance went negative, and it\n	-- stays until the next birthday clears it — so a life that skips years\n	-- pays the drain for each skipped year the same way it pays each skipped\n	-- bill. Read the flag directly; StatService owns the drain and nothing\n	-- else writes it.\n	if data.flags[\"in_debt\"] ~= nil then\n		local debt = data.bills.debt\n		if debt > 0 then\n			-- Happiness drops proportionally to how deep in the red the life is,\n			-- capped so a maxed-out debt does not tank the bar in a single year.\n			-- Health drops a smaller flat amount: the body does not care about\n			-- status, only about the stress that keeps it up at night.\n			local stress = math.min(debt / Config.Bills.MaxDebt, 1)\n			stats.happiness = clamp(stats.happiness - math.floor(4 * stress))\n			stats.health = clamp(stats.health - 2)\n		end\n	end\n\n	pushStats(player, stats)\nend\n\nfunction StatService.PushStats(player: Player)\n	local profile = DataService.GetProfile(player)\n	if profile ~= nil then\n		pushStats(player, Lives.Active(profile.Data).stats)\n	end\nend\n\n-- `ResetToStarting` used to live here, and it is gone rather than kept. It wound a life's\n-- four bars back to `Config.Stats.Starting` for the rebirth that ran in place; a new life is\n-- now a fresh `Lives.New()` that starts there already, with whatever the create card spent on\n-- top -- see `LifeSetup.StartingStats`, which applies this same clamp.\n\nfunction StatService:Init() end\n\nfunction StatService:Start()\n	Players.PlayerAdded:Connect(function(player: Player)\n		task.spawn(function()\n			local profile = DataService.WaitForProfile(player)\n			if profile ~= nil then\n				pushStats(player, Lives.Active(profile.Data).stats)\n			end\n		end)\n	end)\nend\n\nreturn StatService\n"
table.insert(AGES_MANIFEST, "src/server/services/StatService.luau")
AGES_SOURCES["src/server/services/TerritoryService.luau"] = "--!strict\n-- Whose side of the map you are standing on, and what it costs to be standing there\n-- in the wrong colors.\n--\n-- Gangs.luau wrote down a `side` for each of the four bosses and said, in a comment,\n-- that nothing read it yet: \"territory is deferred until the map expansion... the seam\n-- is here; the districts hang off it when there are districts.\" This is that file. The\n-- districts are not authored anywhere -- a side is simply the ground nearer to that\n-- boss than to any other boss, which is computed in Shared/WorldMap from where the four\n-- bosses actually stand. Nothing here to keep in step with the world when it changes.\n--\n-- **The mechanic, in one paragraph.** Wearing your colors on a rival's side costs you\n-- standing with that rival, once, when you cross in. Getting back out pays standing with\n-- your own gang, once, scaled by the deepest you actually got. Take the band off and\n-- none of it applies -- which is the first time SetColors has been a decision rather\n-- than a preference.\n--\n-- **Nothing here pays for time, and that is the whole design.** Config.Gangs.Earn says\n-- of its largest award that escaping \"is the only line here that cannot be farmed by\n-- standing still and holding a button\". An award for dwelling in rival turf would have\n-- been exactly that button. So the award is a function of *depth* -- a maximum over the\n-- positions you occupied, never a sum over seconds -- and a player who walks in and\n-- stands there for an hour is paid precisely what a player who walked to the same spot\n-- and turned round is paid.\n\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Config = require(ReplicatedStorage:WaitForChild(\"Config\"))\nlocal Remotes = require(ReplicatedStorage:WaitForChild(\"Remotes\"))\nlocal Types = require(ReplicatedStorage:WaitForChild(\"Types\"))\nlocal WorldMap = require(ReplicatedStorage:WaitForChild(\"WorldMap\"))\nlocal MapShapes = require(ReplicatedStorage:WaitForChild(\"world\"):WaitForChild(\"MapShapes\"))\n\nlocal Gangs = require(script.Parent.Parent.content.Gangs)\nlocal GangService = require(script.Parent.GangService)\nlocal PlaceService = require(script.Parent.PlaceService)\n\ntype Player = Players.Player\ntype Site = WorldMap.Site\n\nlocal TerritoryService = {}\n\nlocal TERRITORY = Config.Territory\nlocal INCURSION = TERRITORY.Incursion\n\nlocal TERRITORY_UPDATED = Remotes.Get(\"TerritoryUpdated\")\nlocal MAP_DATA = Remotes.Get(\"MapData\")\nlocal NOTICE = Remotes.Get(\"Notice\")\n\n-- What a player is in the middle of. `deepest` is the furthest inside the rival side\n-- they have been on this trip, which is the only thing the award is computed from.\ntype Incursion = {\n	rivalId: string,\n	deepest: number,\n}\n\ntype Watch = {\n	region: string?,\n	incursion: Incursion?,\n}\n\nlocal watches: { [Player]: Watch } = {}\n\nlocal function watchFor(player: Player): Watch\n	local existing = watches[player]\n	if existing ~= nil then\n		return existing\n	end\n	local made: Watch = { region = nil, incursion = nil }\n	watches[player] = made\n	return made\nend\n\n-- The four points the sides are grown from.\n--\n-- Rebuilt until it succeeds rather than cached on first call: place points are tagged\n-- instances and the bosses' may not have streamed in when the first player joins, so a\n-- cache taken too early would pin an empty table for the life of the server. Once all\n-- four are found the answer cannot change, so it is cached then and not before.\nlocal cachedSites: { Site }? = nil\n\nlocal function sites(): { Site }\n	local ready = cachedSites\n	if ready ~= nil then\n		return ready\n	end\n\n	local found: { Site } = {}\n	for _, gang in Gangs.All do\n		local place = PlaceService.Find(gang.bossPlaceId)\n		if place ~= nil then\n			local position = place.part.Position\n			table.insert(found, { id = gang.id, x = position.X, z = position.Z })\n		end\n	end\n\n	if #found == #Gangs.All then\n		cachedSites = found\n	end\n	return found\nend\n\n-- The box the map is drawn in, measured from the places that exist.\n--\n-- Waypoints are excluded. They are routing nodes rather than destinations -- the\n-- `wp_` prefix is what Config calls them -- and a map that stretched to include the\n-- pathfinding scaffolding would be a map of the scaffolding.\nlocal cachedBounds: WorldMap.Bounds? = nil\n\nlocal function mapBounds(): WorldMap.Bounds?\n	local ready = cachedBounds\n	if ready ~= nil then\n		return ready\n	end\n\n	local points: { Vector3 } = {}\n	for _, place in PlaceService.All() do\n		if string.sub(place.id, 1, #Config.World.PlaceWaypointPrefix) == Config.World.PlaceWaypointPrefix then\n			continue\n		end\n		table.insert(points, place.part.Position)\n	end\n\n	-- The drawn world's own corners, thrown in with the doorways.\n	--\n	-- Place points sit at things you can walk into, and a coastline is not one -- so a\n	-- box measured from doorways alone stops short of the sea, the beach and the outer\n	-- ring road, and the map crops the edge of the world off. Two corners is enough:\n	-- `BoundsOf` only ever takes a minimum and a maximum.\n	local extent = MapShapes.Extent\n	table.insert(points, Vector3.new(extent.minX, 0, extent.minZ))\n	table.insert(points, Vector3.new(extent.maxX, 0, extent.maxZ))\n\n	local bounds = WorldMap.BoundsOf(points, Config.Map.EdgePadStuds)\n	if bounds ~= nil and #points >= Config.Map.MinPlacesForBounds then\n		cachedBounds = bounds\n	end\n	return bounds\nend\n\n-- Where the player's body is, flat. Nil whenever there is no body to ask, which is\n-- every frame between dying and respawning.\nlocal function positionOf(player: Player): Vector3?\n	local character = player.Character\n	if character == nil then\n		return nil\n	end\n	local root = character:FindFirstChild(\"HumanoidRootPart\")\n	if root == nil then\n		return nil\n	end\n	return (root :: BasePart).Position\nend\n\nlocal function gangName(gangId: string): string\n	local def = Gangs.ById[gangId]\n	return if def ~= nil then def.name else gangId\nend\n\n-- End the trip without paying for it.\n--\n-- Two things void a run, and both are the player ceasing to be the thing the award is\n-- for. Taking the band off mid-run is the obvious one: the reward is for being seen in\n-- the wrong colors, so a player who pockets them has stopped taking the risk and cannot\n-- keep the fee. Without this the exploit is complete and cheap -- cross the line wearing\n-- them, pay the entry cost once, immediately go grey, wander the whole side in safety,\n-- and collect on the way home for a walk nobody could see you take.\n--\n-- Dying is the other. The award is paid for *getting out*, and a player carried out is\n-- not one who got out; leaving it open would have made dying deep in rival ground pay\n-- exactly as well as walking home from it, which is the wrong lesson twice over.\nlocal function voidIncursion(watch: Watch)\n	watch.incursion = nil\nend\n\n-- Settle whatever trip the player was on and pay for it.\n--\n-- Paid on the way *out*, never on the way in and never while inside, so the award has\n-- a moment rather than a rate. A player who never leaves is never paid, which is the\n-- correct answer to standing still in enemy territory: it is not brave, it is just\n-- standing.\nlocal function settleIncursion(player: Player, watch: Watch)\n	local incursion = watch.incursion\n	if incursion == nil then\n		return\n	end\n	watch.incursion = nil\n\n	if incursion.deepest < INCURSION.MinDepthStuds then\n		return\n	end\n\n	local award = math.floor(math.min(incursion.deepest * INCURSION.PerStudDepth, INCURSION.MaxAward))\n	if award <= 0 then\n		return\n	end\n\n	GangService.Credit(player, award, `ran the {gangName(incursion.rivalId)} line`)\nend\n\n-- Called once per crossing, after the edge band has been cleared in the new side.\nlocal function onCrossing(player: Player, watch: Watch, into: string)\n	local previous = watch.region\n	watch.region = into\n\n	local gangId = GangService.GangOf(player)\n\n	-- Not in a gang, or carrying the band in a pocket. Territory is still reported to\n	-- the client -- knowing which side you are on is a fact about the map, not a reward\n	-- -- but nothing is charged and nothing is owed. Travelling with the colors off is\n	-- meant to be the safe way to cross the city, and this is the line that makes it so.\n	if gangId == nil or not GangService.IsWearing(player) then\n		settleIncursion(player, watch)\n		return\n	end\n\n	-- Leaving wherever we were settles it, including rival-to-rival: the trip that is\n	-- ending is the one that gets paid, and the next crossing opens a new one.\n	settleIncursion(player, watch)\n\n	if into == gangId then\n		return\n	end\n\n	watch.incursion = { rivalId = into, deepest = 0 }\n	GangService.ChargeIn(player, into, INCURSION.RivalCost, \"seen on their side\")\n\n	-- Silent on the very first crossing of a life, which is the one the player did not\n	-- make: it is the tick noticing where they already were. Every crossing after that\n	-- is a decision and gets told about.\n	if previous ~= nil then\n		NOTICE:FireClient(player, `You are on {gangName(into)}'s side, wearing someone else's colors.`)\n	end\nend\n\nlocal function pushState(player: Player, watch: Watch, depth: number)\n	local state: Types.TerritoryState = {\n		regionId = watch.region,\n		depthStuds = math.floor(depth),\n		onIncursion = watch.incursion ~= nil,\n		deepestStuds = if watch.incursion ~= nil then math.floor(watch.incursion.deepest) else 0,\n	}\n	TERRITORY_UPDATED:FireClient(player, state)\nend\n\n-- One player, one tick.\nlocal function step(player: Player)\n	local watch = watchFor(player)\n	local position = positionOf(player)\n	if position == nil then\n		return\n	end\n\n	local here = sites()\n	if #here == 0 then\n		return\n	end\n\n	local standing = WorldMap.StandingAt(here, position.X, position.Z)\n	local region = standing.id\n	if region == nil then\n		return\n	end\n\n	-- Checked every tick rather than only on a crossing, because taking the band off is\n	-- not a crossing -- it happens standing still, in the middle of somebody else's side,\n	-- and a run that is only re-examined at borders would never notice.\n	if watch.incursion ~= nil and not GangService.IsWearing(player) then\n		voidIncursion(watch)\n	end\n\n	-- Deepest-so-far is tracked every tick, but only ever by taking a maximum. Two\n	-- players standing in the same doorway for different lengths of time are owed the\n	-- same amount, because this line cannot accumulate.\n	local incursion = watch.incursion\n	if incursion ~= nil and region == incursion.rivalId then\n		incursion.deepest = math.max(incursion.deepest, standing.depthStuds)\n	end\n\n	-- Inside the band around the border, nothing is decided. A player pacing the line\n	-- would otherwise trip a crossing every tick in both directions and be charged for\n	-- each one; the band is what makes a boundary a place rather than an instant.\n	if standing.depthStuds < TERRITORY.EdgeBandStuds then\n		pushState(player, watch, standing.depthStuds)\n		return\n	end\n\n	if region ~= watch.region then\n		onCrossing(player, watch, region)\n	end\n\n	pushState(player, watch, standing.depthStuds)\nend\n\n-- The static half: where the map is, what is on it, and which color each side draws in.\n-- Sent once per join rather than per tick because none of it changes while the server\n-- is up.\nlocal function pushMapData(player: Player)\n	local bounds = mapBounds()\n	if bounds == nil then\n		return\n	end\n\n	local icons: { Types.MapIcon } = {}\n	for _, place in PlaceService.All() do\n		if string.sub(place.id, 1, #Config.World.PlaceWaypointPrefix) == Config.World.PlaceWaypointPrefix then\n			continue\n		end\n		local position = place.part.Position\n		local u, v = WorldMap.Normalize(bounds, position.X, position.Z)\n		table.insert(icons, { id = place.id, label = place.label, u = u, v = v })\n	end\n\n	local regions: { Types.MapRegion } = {}\n	for _, site in sites() do\n		local def = Gangs.ById[site.id]\n		if def == nil then\n			continue\n		end\n		local u, v = WorldMap.Normalize(bounds, site.x, site.z)\n		table.insert(regions, { id = site.id, name = def.name, color = def.color, u = u, v = v })\n	end\n\n	MAP_DATA:FireClient(player, {\n		minX = bounds.minX,\n		maxX = bounds.maxX,\n		minZ = bounds.minZ,\n		maxZ = bounds.maxZ,\n		icons = icons,\n		regions = regions,\n	} :: Types.MapData)\nend\n\n-- Which side a position is on, for anything else that wants to ask. Nil before the\n-- bosses have streamed in.\nfunction TerritoryService.RegionAt(position: Vector3): string?\n	return WorldMap.RegionAt(sites(), position)\nend\n\n-- Which side a player is on right now, as last decided by the tick. Deliberately the\n-- committed region rather than a fresh measurement, so a caller and the player's own\n-- HUD never disagree about which side they are standing on.\nfunction TerritoryService.RegionOf(player: Player): string?\n	local watch = watches[player]\n	return if watch ~= nil then watch.region else nil\nend\n\n-- Losing the body ends the run and forgets where it was.\n--\n-- Both halves matter. Voiding is what stops dying in rival ground paying the same as\n-- walking out of it. Clearing the region is what stops the respawn being read as a\n-- crossing: a player who dies on the east side and wakes up at home has not walked\n-- anywhere, and a stale region would make the tick charge them for a journey the\n-- ambulance made. Nil means \"wherever they turn out to be is simply where they are\",\n-- which is also why the first crossing of a life sends no notice.\nlocal function forget(player: Player)\n	local watch = watches[player]\n	if watch == nil then\n		return\n	end\n	voidIncursion(watch)\n	watch.region = nil\nend\n\nfunction TerritoryService:Init()\n	Players.PlayerAdded:Connect(function(player: Player)\n		player.CharacterRemoving:Connect(function()\n			forget(player)\n		end)\n	end)\n\n	Players.PlayerRemoving:Connect(function(player: Player)\n		watches[player] = nil\n	end)\nend\n\nfunction TerritoryService:Start()\n	Players.PlayerAdded:Connect(function(player: Player)\n		task.spawn(pushMapData, player)\n	end)\n	for _, player in Players:GetPlayers() do\n		task.spawn(pushMapData, player)\n	end\n\n	task.spawn(function()\n		while true do\n			task.wait(TERRITORY.TickSeconds)\n			for _, player in Players:GetPlayers() do\n				step(player)\n			end\n		end\n	end)\nend\n\nreturn TerritoryService\n"
table.insert(AGES_MANIFEST, "src/server/services/TerritoryService.luau")
AGES_SOURCES["src/server/services/TheftService.luau"] = "--!strict\n-- The take. One verb -- hold to empty the drawer -- and two things watching you do it.\n--\n-- The whole activity is the interference between the clerk's cycle and the camera's.\n-- Neither knows about the other and neither is aimed at the player: the clerk turns to\n-- the register and back on a short beat, the camera sweeps the room on a longer one, and\n-- the windows where neither is on the till open and close as the two drift past each\n-- other. Config.Crime.Theft explains the arithmetic; what matters here is the consequence,\n-- which is that this cannot be played by counting. It has to be watched.\n--\n-- Both cycles are computed from the clock rather than stored, and that is load-bearing in\n-- two ways. It means every player in a shop sees the same clerk in the same position, so\n-- two thieves at one counter are playing the same game rather than two private ones. And\n-- it means the camera part on the wall and the `cameraWatching` field on the panel are\n-- derived from one number, so they can never disagree -- which they would within a minute\n-- if either were allowed to drift.\n--\n-- **Being seen is never an arrest here and never ends the robbery.** It adds heat and\n-- reports a sighting, which hands the player to the pursuit half that is already built.\n-- That is deliberate to the point of being the reason this file exists in this shape: a\n-- theft mini-game that could be failed would be a mini-game with a lose screen, and what\n-- this is meant to produce is an afternoon that got complicated. See the soft-failure\n-- requirement in the activity law -- the multiplier here is how much heat you leave with,\n-- and it runs continuously from nothing to a manhunt.\n--\n-- What this file does not do: decide where a shop is (Till), decide what heat buys\n-- (BountyService), or put officers in the street (PoliceService). It takes money out of a\n-- drawer and tells the bounty when somebody watched it happen.\n\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Config = require(ReplicatedStorage:WaitForChild(\"Config\"))\nlocal Remotes = require(ReplicatedStorage:WaitForChild(\"Remotes\"))\nlocal Types = require(ReplicatedStorage:WaitForChild(\"Types\"))\n\nlocal BountyService = require(script.Parent.BountyService)\nlocal DataService = require(script.Parent.DataService)\nlocal GangService = require(script.Parent.GangService)\nlocal MoneyService = require(script.Parent.MoneyService)\nlocal NPCService = require(script.Parent.NPCService)\nlocal PlaceService = require(script.Parent.PlaceService)\n\nlocal Colors = require(script.Parent.Parent.world.Colors)\nlocal Public = require(script.Parent.Parent.content.Public)\nlocal Tills = require(script.Parent.Parent.content.Tills)\nlocal Till = require(script.Parent.Parent.world.Till)\n\ntype LifeData = Types.LifeData\ntype TheftState = Types.TheftState\ntype Visitor = NPCService.Visitor\ntype GangCrewMember = Types.GangCrewMember\n\nlocal TheftService = {}\n\nlocal THEFT = Config.Crime.Theft\n\nlocal TheftUpdatedRemote = Remotes.Get(\"TheftUpdated\")\nlocal RequestTillHoldRemote = Remotes.Get(\"RequestTillHold\")\nlocal RequestTillOpenRemote = Remotes.Get(\"RequestTillOpen\")\nlocal RequestTillCallCrewRemote = Remotes.Get(\"RequestTillCallCrew\")\n\n-- The clerk's whole cycle, and the camera's. Named because both are used in three places\n-- and a robbery that used a different period in the aiming code from the one it used in\n-- the state push would be a camera that lied.\nlocal CLERK_PERIOD = THEFT.ClerkLookSeconds + THEFT.ClerkAwaySeconds\nlocal CAMERA_PERIOD = THEFT.CameraSweepSeconds\n\n-- What is in a drawer right now, per shop rather than per player. A till emptied by one\n-- thief is empty for the next one, which is the only honest reading of a shared world and\n-- also the thing that makes a second player on the same street a rival rather than a\n-- duplicate.\ntype Drawer = {\n	left: number,\n	full: number,\n	-- When it is worth robbing again, on the same clock everything else here uses. Held as\n	-- a moment rather than counted down, so a shop nobody is standing in costs nothing.\n	refillAt: number,\n}\n\n-- One player, at one till.\ntype Session = {\n	place: string,\n	name: string,\n	-- Whether the client says the hands are in the drawer. Never trusted on its own: every\n	-- tick re-checks reach, the drawer's balance and whether the player is still alive, and\n	-- any of those failing takes the hands out regardless of what the client last said.\n	holding: boolean,\n	taken: number,\n	-- How long an attention has been on the till while holding. The undo window, counted up\n	-- rather than down because it resets to zero the instant the player lets go -- which is\n	-- the entire mechanic and is much harder to get wrong in this direction.\n	watchedFor: number,\n	spotted: boolean,\n	notice: string?,\n	noticeLeft: number,\n	clerk: Visitor?,\n	-- Set while a clerk rig is being built, which yields. Without it a player who walks in,\n	-- out and back in inside two seconds gets two clerks behind one counter.\n	spawningClerk: boolean,\n\n	-- The lookout: somebody's own crew, sent to watch the door instead of taking their\n	-- chances alone. Per session, not per shop -- unlike Bank's alarm seat, there is\n	-- nothing here for two robbers to share, so a lookout is exactly as private as the\n	-- clerk above already is.\n	lookout: Visitor?,\n	spawningLookout: boolean,\n	-- Whose crew this is, so a swap or a departure can find them again.\n	lookoutCrewId: string?,\n	lookoutName: string?,\n	-- Rolled once, from the nerve they had when they were called -- see Config.Gangs.Jobs.\n	lookoutFailChance: number,\n	-- Whether this session has already spent its one roll. Set the instant it is used, at\n	-- the first spotted transition below, and not reset by being spotted again: nerve buys\n	-- one shot at softening getting caught, not a standing discount on every one after it.\n	lookoutRolled: boolean,\n}\n\nlocal drawers: { [string]: Drawer } = {}\nlocal sessions: { [Player]: Session } = {}\nlocal pushed: { [Player]: string } = {}\nlocal enabled = true\n\nlocal function dataFor(player: Player): LifeData?\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return nil\n	end\n	return DataService.CurrentLife(profile)\nend\n\nlocal function characterPosition(player: Player): Vector3?\n	local character = player.Character\n	if character == nil then\n		return nil\n	end\n	local root = character:FindFirstChild(\"HumanoidRootPart\")\n	if root == nil then\n		return nil\n	end\n	return (root :: BasePart).Position\nend\n\n-- Where a shop's cycles are, right now.\n--\n-- Offset per shop by a hash of its id, so two shops on one street are never in step. Two\n-- synchronised clerks would teach the player a single rhythm that worked everywhere, which\n-- is the numbers-only version of this activity: the thing worth learning is that each shop\n-- has to be read on arrival.\nlocal function shopPhase(place: string): number\n	local sum = 0\n	for index = 1, #place do\n		sum += string.byte(place, index) * index\n	end\n	return sum % 1000 / 1000\nend\n\n-- True while the clerk is facing the till.\nlocal function clerkOnTill(place: string, now: number): boolean\n	local share = ((now / CLERK_PERIOD) + shopPhase(place)) % 1\n	return share * CLERK_PERIOD < THEFT.ClerkLookSeconds\nend\n\n-- Where the camera is through its sweep, 0 to 1, and whether it is pointed at the drawer.\n--\n-- The sweep is a triangle, so the middle of the travel is straight ahead -- at the till --\n-- and the camera crosses it twice per period: once on the way out and once on the way\n-- back. The two crossings are what stop the pattern reading as a metronome even before\n-- the clerk is folded in.\nlocal function cameraAt(place: string, now: number): (number, boolean)\n	local share = ((now / CAMERA_PERIOD) + shopPhase(place) * 0.5) % 1\n	local folded = if share < 0.5 then share * 2 else (1 - share) * 2\n	return share, math.abs(folded - 0.5) * 2 < THEFT.CameraOnTillShare\nend\n\nlocal function drawerFor(place: string, now: number): Drawer\n	local existing = drawers[place]\n	if existing ~= nil then\n		if existing.left <= 0 and now >= existing.refillAt then\n			existing.left = existing.full\n		end\n		return existing\n	end\n\n	local shop = Tills.Get(place)\n	local full = THEFT.TillFloat * (if shop ~= nil then shop.richness else 1)\n	local made: Drawer = { left = full, full = full, refillAt = 0 }\n	drawers[place] = made\n	return made\nend\n\nlocal function noticeFor(session: Session, text: string)\n	session.notice = text\n	session.noticeLeft = 4\nend\n\nlocal function stateFor(player: Player): TheftState?\n	local session = sessions[player]\n	if session == nil then\n		return nil\n	end\n	local now = os.clock()\n	local drawer = drawerFor(session.place, now)\n	local _, cameraOn = cameraAt(session.place, now)\n\n	-- A lookout is not a shared seat here, so it costs nothing to keep offering the panel\n	-- even while one is already out -- calling again with a different id swaps who is\n	-- standing there, same as CallCrew's own note.\n	local crewCallable: { GangCrewMember } = {}\n	local crew = GangService.CrewFor(player)\n	if #crew > 0 then\n		crewCallable = crew\n	end\n\n	return {\n		place = session.name,\n		tillLeft = drawer.left,\n		tillFull = drawer.full,\n		taken = session.taken,\n		holding = session.holding,\n		clerkWatching = clerkOnTill(session.place, now),\n		cameraWatching = cameraOn,\n		spotted = session.spotted,\n		crewCallable = crewCallable,\n		crewOnLookout = if session.lookout ~= nil then session.lookoutName else nil,\n		notice = session.notice,\n	}\nend\n\nlocal function push(player: Player)\n	local state = stateFor(player)\n	local digest: string\n	if state == nil then\n		digest = \"none\"\n	else\n		-- Money to the whole unit, because the drawer drains continuously and a panel\n		-- redrawn on every cent would be a packet every tick of every robbery for a number\n		-- nobody can read at that precision. Crew by id and nerve, not name, same reason as\n		-- the bank digest: two members can share a name and must never share a digest entry.\n		local crewBits = {}\n		for _, member in state.crewCallable do\n			table.insert(crewBits, `{member.id}:{math.floor(member.nerve)}`)\n		end\n		digest = `{state.place}/{math.floor(state.tillLeft)}/{math.floor(state.taken)}/`\n			.. `{tostring(state.holding)}/{tostring(state.clerkWatching)}/{tostring(state.cameraWatching)}/`\n			.. `{tostring(state.spotted)}/{table.concat(crewBits, \",\")}/{tostring(state.crewOnLookout)}/`\n			.. `{tostring(state.notice)}`\n	end\n\n	if pushed[player] == digest then\n		return\n	end\n	pushed[player] = digest\n	TheftUpdatedRemote:FireClient(player, state)\nend\n\n-- Somebody behind the counter, built once the player is standing at it.\n--\n-- A shop is not staffed until it is being robbed, which is a shortcut and worth naming as\n-- one: staffing forty storefronts permanently is forty rigs the server builds for nobody.\n-- What it costs is that a player who walks past an open door sees an empty shop, and the\n-- honest fix for that is the ambient population work rather than a clerk per shop here.\nlocal function spawnClerk(player: Player, session: Session)\n	if session.clerk ~= nil or session.spawningClerk then\n		return\n	end\n	local fitting = Till.Get(session.place)\n	if fitting == nil then\n		return\n	end\n	local spot = fitting.clerkSpot\n	if spot == nil then\n		-- No room behind this counter. The shop runs on its camera alone, which is easier\n		-- and is allowed to be: a robbery that refused to start because the furniture was\n		-- tight would be a door that does nothing for reasons nobody can see.\n		return\n	end\n\n	session.spawningClerk = true\n	task.spawn(function()\n		local member = Public.Someone()\n		local visitor = NPCService.Spawn(player, member, CFrame.new(spot, fitting.drawer))\n		session.spawningClerk = false\n		-- Everything below the spawn is re-checked, because Spawn yields on a web call and\n		-- the player may have walked out, died or been arrested while it ran.\n		if visitor == nil then\n			return\n		end\n		if sessions[player] ~= session then\n			visitor.destroy()\n			return\n		end\n		session.clerk = visitor\n	end)\nend\n\nlocal function despawnClerk(session: Session)\n	local clerk = session.clerk\n	if clerk ~= nil then\n		session.clerk = nil\n		if not clerk.gone() then\n			clerk.destroy()\n		end\n	end\nend\n\n-- Turns the clerk. Facing the till or facing the shelves, which is the same fact the\n-- panel's `clerkWatching` carries -- read off the same function, so the body and the\n-- readout cannot drift apart.\nlocal function aimClerk(session: Session, watching: boolean)\n	local clerk = session.clerk\n	if clerk == nil or clerk.gone() then\n		return\n	end\n	local fitting = Till.Get(session.place)\n	if fitting == nil then\n		return\n	end\n	if watching then\n		clerk.face(fitting.drawer)\n		return\n	end\n	-- Away means away from the drawer, along the line from it, so the turn is the full\n	-- hundred and eighty a player can read from the front of the counter rather than a\n	-- glance to one side that looks the same from where they are standing.\n	local from = clerk.at()\n	clerk.face(from + (from - fitting.drawer))\nend\n\n-- Sends a body home. Called both when its owner walks out and when the crew member they\n-- sent is no longer theirs to send -- dismissed off the gang panel while out on the job --\n-- so the door is never watched by somebody who is not actually there anymore.\nlocal function despawnLookout(session: Session)\n	local lookout = session.lookout\n	if lookout ~= nil then\n		session.lookout = nil\n		if not lookout.gone() then\n			lookout.destroy()\n		end\n	end\n	session.lookoutCrewId = nil\n	session.lookoutName = nil\n	session.lookoutFailChance = 0\n	session.lookoutRolled = false\nend\n\n-- How reliably a nerve rating covers a robbery once, the first time it is spotted. Same\n-- shape and the same reason as the bank's alarmFailChanceFor: linear between the two config\n-- ends, so the number on the crew panel is a promise rather than a suggestion.\nlocal function tillCoverFailChanceFor(nerve: number): number\n	local jobs = Config.Gangs.Jobs\n	local share = math.clamp(nerve / Config.Gangs.Crew.NerveMax, 0, 1)\n	return jobs.TillCoverFailChanceAtZeroNerve\n		+ (jobs.TillCoverFailChanceAtMaxNerve - jobs.TillCoverFailChanceAtZeroNerve) * share\nend\n\n-- Sends one of the player's own crew to watch the door. Per session rather than per shop,\n-- same as the clerk -- there is no seat here for a second robber to contest.\nlocal function spawnLookout(player: Player, session: Session, crew: GangCrewMember)\n	if session.lookout ~= nil or session.spawningLookout then\n		return\n	end\n	local fitting = Till.Get(session.place)\n	if fitting == nil then\n		return\n	end\n	local spot = fitting.lookoutSpot\n	if spot == nil then\n		-- No room by the door. The robbery runs without one, same reason the clerk can be\n		-- missing: a shop that refused a lookout for reasons invisible from outside it would\n		-- be worse than the role quietly being unavailable there.\n		return\n	end\n\n	session.spawningLookout = true\n	task.spawn(function()\n		local member = GangService.CastMemberFor(crew)\n		local visitor = NPCService.Spawn(player, member, CFrame.new(spot, fitting.lookoutFacing))\n		session.spawningLookout = false\n		-- Re-checked, because Spawn yields on a web call: the player may have walked out,\n		-- ended the session or called a different crew member while it ran.\n		if visitor == nil then\n			return\n		end\n		if sessions[player] ~= session or session.lookout ~= nil then\n			visitor.destroy()\n			return\n		end\n		session.lookout = visitor\n		session.lookoutCrewId = crew.id\n		session.lookoutName = crew.name\n		session.lookoutFailChance = tillCoverFailChanceFor(crew.nerve)\n		session.lookoutRolled = false\n		local color = GangService.ColorOf(player)\n		if color ~= nil and not Colors.Apply(visitor.model, color) then\n			warn(`[AGES] could not band {crew.name} -- they will look like anybody else`)\n		end\n		push(player)\n	end)\nend\n\n-- Keeps the lookout on their spot and drops them the instant they stop being crew. There is\n-- nothing else to tick: the one thing they do is the roll in tickPlayer, at the moment a\n-- robbery is first spotted, and that is not a per-tick action.\nlocal function tickLookout(player: Player, session: Session)\n	local lookout = session.lookout\n	if lookout == nil then\n		return\n	end\n	local crewId = session.lookoutCrewId\n	if lookout.gone() or crewId == nil then\n		despawnLookout(session)\n		return\n	end\n\n	-- Dismissed off the gang panel while out on this job. Checked every tick rather than\n	-- only on call, same reason as the bank's crew helper: the gang panel has nothing to do\n	-- with this till and must not have to know it exists.\n	local stillCrew = false\n	for _, member in GangService.CrewFor(player) do\n		if member.id == crewId then\n			stillCrew = true\n			break\n		end\n	end\n	if not stillCrew then\n		local name = session.lookoutName\n		despawnLookout(session)\n		noticeFor(session, `{name} isn't running with you anymore, and heads off.`)\n		return\n	end\n\n	local fitting = Till.Get(session.place)\n	if fitting ~= nil and fitting.lookoutSpot ~= nil then\n		lookout.moveTo(fitting.lookoutSpot)\n	end\nend\n\nlocal function endSession(player: Player)\n	local session = sessions[player]\n	if session == nil then\n		return\n	end\n	despawnClerk(session)\n	despawnLookout(session)\n	sessions[player] = nil\n	push(player)\nend\n\nlocal function tickPlayer(player: Player, elapsed: number)\n	local session = sessions[player]\n	if session == nil then\n		return\n	end\n\n	local data = dataFor(player)\n	if data == nil or not data.alive or not enabled then\n		endSession(player)\n		return\n	end\n\n	if session.noticeLeft > 0 then\n		session.noticeLeft -= elapsed\n		if session.noticeLeft <= 0 then\n			session.notice = nil\n			session.noticeLeft = 0\n		end\n	end\n\n	local now = os.clock()\n	local at = characterPosition(player)\n	if at == nil or not Till.InReach(session.place, at) then\n		-- Walking away is how you leave. There is no \"stop robbing\" button and there\n		-- should not be one: the exit from this activity is the door, which is the same\n		-- exit the player is going to want in a hurry a few seconds later.\n		endSession(player)\n		return\n	end\n\n	-- The camera is aimed by the town-wide sweep below, not from here. Asked for again at\n	-- this point only as a number, because what the player is judged on has to be read off\n	-- the same clock the part on the wall is turning to.\n	local _, cameraOn = cameraAt(session.place, now)\n\n	local clerkOn = clerkOnTill(session.place, now)\n	aimClerk(session, clerkOn)\n	tickLookout(player, session)\n\n	local drawer = drawerFor(session.place, now)\n\n	-- Hands out of the drawer the moment there is nothing in it, rather than leaving the\n	-- player holding an empty till while the clerk turns around. Being seen robbing\n	-- nothing is the one flavour of unfair this activity can actually produce.\n	if drawer.left <= 0 and session.holding then\n		session.holding = false\n		noticeFor(session, \"The drawer is empty.\")\n	end\n\n	local watched = clerkOn or cameraOn\n	if session.holding and watched then\n		session.watchedFor += elapsed\n		if session.watchedFor >= THEFT.GraceSeconds and not session.spotted then\n			session.spotted = true\n			local base = if clerkOn then \"The clerk looked up.\" else \"The camera is on you.\"\n\n			-- The lookout's whole job: one roll, spent here and never again this session\n			-- (see `lookoutRolled`), against the nerve they had when they were called --\n			-- see Config.Gangs.Jobs. It only ever touches this one heat addition. Being\n			-- spotted still happens and the notice still says so; the per-second heat\n			-- below for staying spotted is untouched, because staying is still your own\n			-- risk to run.\n			local covered = false\n			if session.lookout ~= nil and not session.lookoutRolled then\n				session.lookoutRolled = true\n				covered = math.random() >= session.lookoutFailChance\n			end\n\n			if covered then\n				noticeFor(session, `{base} {session.lookoutName} covers you -- no heat, this once.`)\n			else\n				-- Heat and a sighting together, because they are one event: a shop that\n				-- raised the number without reporting where would send the whole response\n				-- to wherever the player happened to be seen next, which for a player\n				-- standing still is nowhere. Seen rather than Add is also what makes a\n				-- second conviction cost more than the first, and this file does not have\n				-- to know that.\n				BountyService.Seen(player, THEFT.HeatOnSpotted, `Caught at the {session.name}`, at)\n				noticeFor(session, base)\n			end\n		end\n	else\n		session.watchedFor = 0\n		if not session.holding then\n			-- Letting go stops the bleeding but does not unsee anything. The heat already\n			-- taken stays taken, which is what makes the grace window a decision worth\n			-- making rather than a free retry.\n			session.spotted = false\n		end\n	end\n\n	if session.spotted and session.holding then\n		-- Re-reported every tick, because they are watching you right now: this is the one\n		-- place in the game where the police's belief about where you are is continuously\n		-- correct, and it is correct for exactly as long as you keep your hands in the till.\n		BountyService.Seen(player, THEFT.HeatPerSecondSpotted * elapsed, `Still at the {session.name}`, at)\n	end\n\n	if session.holding and drawer.left > 0 then\n		local amount = math.min(THEFT.TakePerSecond * elapsed, drawer.left)\n		drawer.left -= amount\n		session.taken += amount\n		MoneyService.Add(player, amount, `Taken from the {session.name}`)\n		-- Paid per dollar rather than per drawer emptied, so a till abandoned halfway still\n		-- counts for what came out of it. Deliberately small: money is already its own\n		-- reward, and a ladder that paid richly per dollar would make the richest route the\n		-- only route worth walking.\n		GangService.Credit(player, amount * Config.Gangs.Earn.PerMoneyStolen, `emptied the {session.name}`)\n		if drawer.left <= 0 then\n			drawer.refillAt = now + THEFT.RefillSeconds\n		end\n	end\n\n	push(player)\nend\n\n-- Clicking the dots. Puts the player at the till; it does not take anything.\nfunction TheftService.Open(player: Player, place: string): (boolean, string?)\n	if not enabled then\n		return false, \"The shop is closed.\"\n	end\n	local data = dataFor(player)\n	if data == nil or not data.alive then\n		return false, \"There is nobody to do it.\"\n	end\n	local shop = Tills.Get(place)\n	if shop == nil then\n		return false, \"There is nothing worth taking here.\"\n	end\n	local at = characterPosition(player)\n	if at == nil or not Till.InReach(place, at) then\n		return false, \"You are not close enough to the counter.\"\n	end\n\n	local existing = sessions[player]\n	if existing ~= nil then\n		if existing.place == place then\n			return true, nil\n		end\n		-- Two counters at once is not a state this has, and the newer one wins rather than\n		-- the older: the player is standing at this one.\n		endSession(player)\n	end\n\n	local session: Session = {\n		place = place,\n		name = shop.name,\n		holding = false,\n		taken = 0,\n		watchedFor = 0,\n		spotted = false,\n		notice = nil,\n		noticeLeft = 0,\n		clerk = nil,\n		spawningClerk = false,\n		lookout = nil,\n		spawningLookout = false,\n		lookoutCrewId = nil,\n		lookoutName = nil,\n		lookoutFailChance = 0,\n		lookoutRolled = false,\n	}\n	sessions[player] = session\n	spawnClerk(player, session)\n	push(player)\n	return true, nil\nend\n\n-- Hands in, hands out. Refused rather than corrected when the player is not at a till,\n-- because a hold that quietly did nothing would look exactly like the button being broken.\nfunction TheftService.SetHolding(player: Player, holding: boolean): boolean\n	local session = sessions[player]\n	if session == nil then\n		return false\n	end\n	if holding then\n		local drawer = drawerFor(session.place, os.clock())\n		if drawer.left <= 0 then\n			noticeFor(session, \"The drawer is empty.\")\n			push(player)\n			return false\n		end\n		local at = characterPosition(player)\n		if at == nil or not Till.InReach(session.place, at) then\n			return false\n		end\n	end\n	session.holding = holding\n	if not holding then\n		session.watchedFor = 0\n	end\n	push(player)\n	return true\nend\n\n-- Sends one of the player's own crew to watch the door. The till's answer to Bank's\n-- CallCrew, and the shape is different for the reason GangService's own note gives: there\n-- is no seat here to claim, so what this actually does is set this session's own lookout\n-- rather than a room's. Calling again with a different id swaps who is standing there;\n-- calling with the one already out is a no-op success rather than a second body.\nfunction TheftService.CallCrew(player: Player, place: string, crewId: string): (boolean, string?)\n	local session = sessions[player]\n	if session == nil or session.place ~= place then\n		return false, \"You are not at this till.\"\n	end\n	if session.lookout ~= nil and session.lookoutCrewId == crewId then\n		return true, nil\n	end\n\n	local chosen: GangCrewMember? = nil\n	for _, member in GangService.CrewFor(player) do\n		if member.id == crewId then\n			chosen = member\n			break\n		end\n	end\n	if chosen == nil then\n		return false, \"That's not your crew.\"\n	end\n\n	if session.lookout ~= nil then\n		despawnLookout(session)\n	end\n	spawnLookout(player, session, chosen)\n	return true, nil\nend\n\n-- Which till a player is currently at, for callers outside this file that need to name\n-- it -- the debug command, mainly, same reason BankService.PlaceOf exists.\nfunction TheftService.PlaceOf(player: Player): string?\n	local session = sessions[player]\n	return if session ~= nil then session.place else nil\nend\n\n-- Stands up every shop in the content list, once, and says which ones could not be built.\n--\n-- Done at startup rather than on arrival so that a missing place point is a line in the\n-- log on a developer's first boot rather than a door that does nothing on a player's\n-- fiftieth minute. It is also cheap: four shops' worth of parts.\nlocal function buildShops()\n	for _, shop in Tills.Shops do\n		local place = PlaceService.Find(shop.place)\n		if place == nil then\n			warn(\n				`[AGES] till shop \"{shop.place}\" has no place point in the built world, so it cannot be robbed. `\n					.. `Either the town no longer has that room or the id in content/Tills.luau is wrong.`\n			)\n			continue\n		end\n		if Till.Build(shop.place, place.part.CFrame, shop.name) == nil then\n			warn(`[AGES] could not stand up a till at \"{shop.place}\"; its place point has no heading.`)\n		end\n	end\nend\n\n-- Every drawer back to full, right now. The harness only.\n--\n-- Exists because the refill is five minutes and testing the *take* is the one thing a\n-- developer does twenty times in a row: without this the second run of a test plan is\n-- spent standing in an empty shop waiting for a timer that was tuned for a player who\n-- has a whole town to walk. It does not touch a live session -- a player holding the\n-- drawer when this fires simply keeps pulling, which is the honest behaviour for \"the\n-- till is full again\" and needs no special case.\nfunction TheftService.RefillAll()\n	for _, drawer in drawers do\n		drawer.left = drawer.full\n		drawer.refillAt = 0\n	end\n	for player in sessions do\n		push(player)\n	end\nend\n\nfunction TheftService.SetEnabled(value: boolean)\n	enabled = value\n	if not value then\n		for player in sessions do\n			endSession(player)\n		end\n	end\nend\n\nfunction TheftService.IsEnabled(): boolean\n	return enabled\nend\n\n-- For the harness, and phrased as the two questions a broken robbery raises: is the shop\n-- built, and where are its two attentions right now.\nfunction TheftService.Describe(player: Player): string\n	local session = sessions[player]\n	local now = os.clock()\n	if session == nil then\n		local lines = {}\n		for _, shop in Tills.Shops do\n			local built = Till.Get(shop.place) ~= nil\n			local drawer = drawers[shop.place]\n			local clerk = clerkOnTill(shop.place, now)\n			local _, camera = cameraAt(shop.place, now)\n			table.insert(\n				lines,\n				string.format(\n					\"%s: %s, %.0f left, clerk %s, camera %s\",\n					shop.place,\n					if built then \"built\" else \"NOT BUILT\",\n					if drawer ~= nil then drawer.left else THEFT.TillFloat * shop.richness,\n					if clerk then \"ON\" else \"away\",\n					if camera then \"ON\" else \"away\"\n				)\n			)\n		end\n		return `not at a till · {if enabled then \"on\" else \"off\"}\\n` .. table.concat(lines, \"\\n\")\n	end\n\n	local drawer = drawerFor(session.place, now)\n	local _, camera = cameraAt(session.place, now)\n	local lookout = \"none\"\n	if session.lookout ~= nil then\n		lookout = string.format(\n			\"%s (fail %.0f%%, %s)\",\n			session.lookoutName or \"?\",\n			session.lookoutFailChance * 100,\n			if session.lookoutRolled then \"spent\" else \"unspent\"\n		)\n	end\n	return string.format(\n		\"at %s · %.0f left of %.0f · taken %.0f · %s · clerk %s · camera %s · watched %.2fs of %.2f · %s · lookout %s\",\n		session.place,\n		drawer.left,\n		drawer.full,\n		session.taken,\n		if session.holding then \"HOLDING\" else \"hands out\",\n		if clerkOnTill(session.place, now) then \"ON\" else \"away\",\n		if camera then \"ON\" else \"away\",\n		session.watchedFor,\n		THEFT.GraceSeconds,\n		if session.spotted then \"SPOTTED\" else \"unseen\",\n		lookout\n	)\nend\n\nfunction TheftService:Init()\n	RequestTillOpenRemote.OnServerEvent:Connect(function(player: Player, place: any)\n		-- The id the dots were built with, and it is checked against the content list\n		-- rather than used: a client that sent \"bank\" would be asking to rob a room that\n		-- has no drawer in it, and Open answers that by name.\n		if typeof(place) ~= \"string\" then\n			return\n		end\n		TheftService.Open(player, place)\n	end)\n\n	RequestTillHoldRemote.OnServerEvent:Connect(function(player: Player, holding: any)\n		-- The one thing the client is allowed to say, and it is a boolean. Anything else\n		-- is dropped rather than coerced: a robbery that accepted a string would be a\n		-- robbery somebody could hold with a table.\n		if typeof(holding) ~= \"boolean\" then\n			return\n		end\n		TheftService.SetHolding(player, holding)\n	end)\n\n	RequestTillCallCrewRemote.OnServerEvent:Connect(function(player: Player, place: any, crewId: any)\n		if typeof(place) ~= \"string\" or typeof(crewId) ~= \"string\" then\n			return\n		end\n		TheftService.CallCrew(player, place, crewId)\n	end)\n\n	Players.PlayerRemoving:Connect(function(player: Player)\n		endSession(player)\n		pushed[player] = nil\n	end)\nend\n\n-- Every camera in town, turned, whether or not anybody is robbing anything.\n--\n-- Deliberately outside the per-player tick. The camera *is* the warning -- there is none on\n-- the HUD and there never will be -- so a player standing in the doorway deciding whether to\n-- walk up to the counter has to be able to watch it sweep before they commit to anything.\n-- Driven off the sessions instead, it would sit dead still until the moment it stopped\n-- mattering, and an unrobbed shop's camera would be frozen at whatever angle the last\n-- robber happened to leave it pointing. Four parts at 5 Hz.\nlocal function sweepCameras()\n	local now = os.clock()\n	for _, shop in Tills.Shops do\n		local share, onTill = cameraAt(shop.place, now)\n		-- Shops that failed to build are skipped inside AimCamera, so a town missing a\n		-- place point costs one table lookup a tick rather than a warning every 200ms.\n		Till.AimCamera(shop.place, share, onTill)\n	end\nend\n\nfunction TheftService:Start()\n	buildShops()\n\n	task.spawn(function()\n		while true do\n			local elapsed = task.wait(THEFT.TickSeconds)\n			sweepCameras()\n			for player in sessions do\n				local fine, problem = pcall(tickPlayer, player, elapsed)\n				if not fine then\n					warn(`[AGES] theft tick failed for {player.Name}: {problem}`)\n				end\n			end\n		end\n	end)\nend\n\nreturn TheftService\n"
table.insert(AGES_MANIFEST, "src/server/services/TheftService.luau")
AGES_SOURCES["src/server/services/VehicleService.luau"] = "--!strict\n-- Owning a car, and driving one. The dealership's other half: CarDealerService is\n-- the counter job -- customers, a queue, a tip -- and this is the showroom floor\n-- behind it, where the same building sells something a life actually keeps.\n--\n-- Ownership is content, not a minigame: buy a car, and it is yours until you sell\n-- it or a life ends. What is a minigame -- or as close as this game gets to one\n-- outside school and work -- is the driving itself, and that lives in\n-- world/VehicleChassis.luau. This file decides who owns what and where the car\n-- physically stands; the chassis decides how it moves once it is standing there.\n--\n-- One car spawned per life at a time, on the same reasoning HouseService caps\n-- ownership rather than letting a life sprawl across every suburb lot at once:\n-- a garage of cars nobody is driving is a number, and a street with everybody's\n-- whole fleet parked on it is a city that stops looking like anybody lives there.\n-- Buying a second car does not spawn a second one -- it goes in the garage, and\n-- switching which one is \"active\" despawns the old one before the new one\n-- appears, so there is never more than one of your cars in the world.\n--\n-- No coordinates are ever written to the profile. A car is parked wherever\n-- VehicleChassis.Build puts it this session, found fresh off the auto_dealer\n-- place point every time -- the same rule HANDOVER.md states for everything\n-- else in this game: place-point ids are stable, coordinates are not. A car\n-- that remembered its own parking spot across a server restart would be a\n-- Vector3 baked into a save file, which is exactly the thing this project's own\n-- rules exist to prevent.\n\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Config = require(ReplicatedStorage:WaitForChild(\"Config\"))\nlocal Money = require(ReplicatedStorage:WaitForChild(\"Money\"))\nlocal Remotes = require(ReplicatedStorage:WaitForChild(\"Remotes\"))\nlocal Types = require(ReplicatedStorage:WaitForChild(\"Types\"))\nlocal Lives = require(ReplicatedStorage:WaitForChild(\"Lives\"))\n\nlocal DataService = require(script.Parent.DataService)\nlocal MoneyService = require(script.Parent.MoneyService)\nlocal PlaceService = require(script.Parent.PlaceService)\n\nlocal Ground = require(script.Parent.Parent.world.Ground)\nlocal VehicleChassis = require(script.Parent.Parent.world.VehicleChassis)\nlocal Vehicles = require(script.Parent.Parent.content.Vehicles)\n\ntype LifeData = Types.LifeData\ntype VehicleState = Types.VehicleState\ntype Chassis = VehicleChassis.Chassis\n\nlocal VehicleService = {}\n\nlocal VEHICLES = Config.Vehicles\nlocal PLACE_ID = \"auto_dealer\"\n\n-- How often the idle-despawn check runs. Unrelated to the chassis's own\n-- per-frame drive tick -- see Config.Vehicles.TickSeconds -- this only ever\n-- reads whether a seat is occupied, which does not need frame-rate resolution.\nlocal IDLE_TICK_SECONDS = 2\n\nlocal VehicleUpdatedRemote = Remotes.Get(\"VehicleUpdated\")\nlocal RequestBuyVehicleRemote = Remotes.Get(\"RequestBuyVehicle\")\nlocal RequestSellVehicleRemote = Remotes.Get(\"RequestSellVehicle\")\nlocal RequestSpawnVehicleRemote = Remotes.Get(\"RequestSpawnVehicle\")\nlocal RequestStoreVehicleRemote = Remotes.Get(\"RequestStoreVehicle\")\n\n-- One car standing in the world for one player, and how long it has stood there\n-- with nobody in it. `idleFor` is what IdleDespawnSeconds is measured against;\n-- it resets to zero the instant anybody sits down, so a car somebody is actively\n-- driving can never time out from under them mid-drive.\ntype Spawned = {\n	chassis: Chassis,\n	idleFor: number,\n}\n\nlocal spawned: { [Player]: Spawned } = {}\nlocal spawning: { [Player]: boolean } = {}\nlocal pushed: { [Player]: string } = {}\nlocal enabled = true\n\nlocal function dataFor(player: Player): LifeData?\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return nil\n	end\n	return Lives.Active(profile.Data)\nend\n\nlocal function ownedCount(life: LifeData): number\n	local count = 0\n	for _ in life.vehicles.owned do\n		count += 1\n	end\n	return count\nend\n\n-- Forward declaration -- push is defined below stateFor, which reads `spawned`\n-- and `dataFor`, both already in scope. Declared here for the same reason\n-- GangService declares `push` ahead of `checkEscape`: a name used with no\n-- `local` in front of it compiles to a global read, which is legal Luau, builds\n-- clean, and dies the first time anybody actually buys a car.\nlocal push: (player: Player, notice: string?) -> ()\n\nlocal function stateFor(player: Player, notice: string?): VehicleState?\n	local life = dataFor(player)\n	if life == nil then\n		return nil\n	end\n	return {\n		catalog = Vehicles.All,\n		owned = life.vehicles.owned,\n		active = life.vehicles.active,\n		busy = spawning[player] == true,\n		notice = notice,\n	}\nend\n\nfunction push(player: Player, notice: string?)\n	local state = stateFor(player, notice)\n	local digest: string\n	if state == nil then\n		digest = \"none\"\n	else\n		local owned: { string } = {}\n		for id in state.owned do\n			table.insert(owned, id)\n		end\n		table.sort(owned)\n		digest = `{table.concat(owned, \",\")}|{tostring(state.active)}|{tostring(state.busy)}|{tostring(state.notice)}`\n	end\n	if pushed[player] == digest and notice == nil then\n		-- Renotified pushes always go out -- a notice is a one-off line for the\n		-- panel to show and clear, and suppressing a repeated one would mean a\n		-- second identical refusal (buying the same car twice in a row) reads\n		-- as the button having done nothing.\n		return\n	end\n	pushed[player] = digest\n	VehicleUpdatedRemote:FireClient(player, state)\nend\n\n-- Where to stand a car near the dealership. Searches a different arc from the\n-- one CarDealerService's own queue search uses -- see the header on\n-- CarDealerService for its own bearing, which is centred on world-south -- so a\n-- parked car does not land in the middle of the customer line. Wider clearance\n-- than a person's, because a car is bigger than a body.\nlocal function findParkSpot(station: Vector3): Vector3?\n	local ignore = Ground.IgnoreList()\n	-- A car's own nominal footprint, not a body's -- see Ground.BodyRadius for\n	-- why this is measured off the character elsewhere; there is no character\n	-- to measure here, so the widest car on the lot stands in for one.\n	local widest = 0\n	for _, kind in Vehicles.All do\n		widest = math.max(widest, kind.size.X, kind.size.Z)\n	end\n	local radius = widest / 2 + 1\n	local height = 4\n\n	local bearings = Ground.Bearings(VEHICLES.ParkArcDegrees, VEHICLES.ParkBearings)\n	for _, out in { VEHICLES.ParkStuds, VEHICLES.ParkStuds * VEHICLES.ParkRetryScale } do\n		for _, bearing in bearings do\n			-- Offset ninety degrees from world-south, which is the centre of the\n			-- queue's own arc -- see the header. A car parked to the side of the\n			-- counter rather than in front of it.\n			local direction = CFrame.Angles(0, math.rad(90 + bearing), 0) * Vector3.new(0, 0, -1)\n			local spot = Ground.SpotAt(station + direction * out, radius, height, ignore, station)\n			if spot ~= nil then\n				return spot\n			end\n		end\n	end\n	return nil\nend\n\nlocal function despawn(player: Player)\n	local current = spawned[player]\n	if current == nil then\n		return\n	end\n	spawned[player] = nil\n	current.chassis.destroy()\nend\n\n-- Puts the active car away and clears which one is active, both at once -- the\n-- two are the same fact seen from the profile's side and the world's side, and\n-- writing one without the other is how a save ends up claiming a car is out\n-- that nothing in the world can find.\nlocal function storeActive(player: Player)\n	despawn(player)\n	local life = dataFor(player)\n	if life ~= nil then\n		life.vehicles.active = nil\n	end\nend\n\n-- Builds and stands up a car the life already owns. Nothing in\n-- VehicleChassis.Build yields today -- it is built from primitives, the same\n-- reason PropModels and SubjectModels need nothing bought or uploaded to exist\n-- -- but the day a real mesh is dropped in and loaded through something\n-- web-backed, this stops being true without anybody having to remember to come\n-- back here. The re-check below costs nothing while it is unnecessary and is\n-- exactly what every other spawn in this game already does for the case where\n-- it is not.\nlocal function spawnActive(player: Player, vehicleId: string): boolean\n	if spawning[player] then\n		return false\n	end\n	local life = dataFor(player)\n	if life == nil or not life.alive then\n		return false\n	end\n	if life.vehicles.owned[vehicleId] ~= true then\n		return false\n	end\n	local kind = Vehicles.Get(vehicleId)\n	if kind == nil then\n		return false\n	end\n	local place = PlaceService.Find(PLACE_ID)\n	if place == nil then\n		return false\n	end\n\n	spawning[player] = true\n	push(player, nil)\n\n	local spot = findParkSpot(place.part.Position)\n	if spot == nil then\n		spawning[player] = false\n		push(player, \"There is nowhere to park it right now.\")\n		return false\n	end\n\n	-- Whatever was out comes in first, so there is never a moment with two of a\n	-- life's cars standing in the world at once.\n	despawn(player)\n\n	local facing = place.part.Position - spot\n	local flat = Vector3.new(facing.X, 0, facing.Z)\n	local look = if flat.Magnitude > 0.01 then flat.Unit else -Vector3.zAxis\n	local lift = kind.size.Y / 2 + VEHICLES.SuspensionLength + VEHICLES.WheelRadius + 0.5\n	local cframe = CFrame.lookAt(spot + Vector3.new(0, lift, 0), spot + Vector3.new(0, lift, 0) + look)\n\n	local chassis = VehicleChassis.Build(kind, cframe)\n	spawning[player] = false\n\n	-- Re-checked after the build: a life can end, sell the car, or request a\n	-- different one to spawn while this ran.\n	local stillWanted = life.alive and life.vehicles.owned[vehicleId] == true\n	if not stillWanted then\n		chassis.destroy()\n		return false\n	end\n\n	spawned[player] = { chassis = chassis, idleFor = 0 }\n	life.vehicles.active = vehicleId\n	push(player, nil)\n	return true\nend\n\n-- Buys a car outright. Returns whether it happened; a refusal is always said in\n-- the pushed notice, because a buy button that quietly did nothing is\n-- indistinguishable from the panel being broken.\nfunction VehicleService.Buy(player: Player, vehicleId: string): boolean\n	if not enabled then\n		return false\n	end\n	local life = dataFor(player)\n	if life == nil or not life.alive then\n		return false\n	end\n	local kind = Vehicles.Get(vehicleId)\n	if kind == nil then\n		push(player, \"That is not a car on this lot.\")\n		return false\n	end\n	if life.vehicles.owned[vehicleId] == true then\n		push(player, \"Already yours.\")\n		return false\n	end\n	if ownedCount(life) >= VEHICLES.MaxOwned then\n		push(player, `The garage only holds {VEHICLES.MaxOwned}. Sell one first.`)\n		return false\n	end\n	if not MoneyService.Spend(player, kind.price, `bought a {kind.name}`) then\n		push(player, `{Money.Format(kind.price)} for the {kind.name}.`)\n		return false\n	end\n\n	life.vehicles.owned[vehicleId] = true\n	push(player, `Bought the {kind.name}.`)\n\n	-- The first car a life owns is worth pulling straight out onto the forecourt\n	-- rather than leaving the player to find the second remote that does it --\n	-- the showroom floor is the world's own confirmation that the purchase\n	-- landed. A second or third car goes in the garage and stays there until\n	-- asked for, which is the ordinary case Spawn exists for.\n	if life.vehicles.active == nil then\n		task.spawn(spawnActive, player, vehicleId)\n	end\n	return true\nend\n\n-- Sells an owned car. Refuses the active one -- see Remotes.luau's note on why:\n-- selling the car you might be about to be told to drive needs an answer for\n-- what \"active\" now points at, and the honest UI move is to store it first.\nfunction VehicleService.Sell(player: Player, vehicleId: string): boolean\n	if not enabled then\n		return false\n	end\n	local life = dataFor(player)\n	if life == nil or not life.alive then\n		return false\n	end\n	if life.vehicles.owned[vehicleId] ~= true then\n		return false\n	end\n	if life.vehicles.active == vehicleId then\n		push(player, \"Put it away before you sell it.\")\n		return false\n	end\n	local kind = Vehicles.Get(vehicleId)\n	if kind == nil then\n		-- Content deleted out from under a save. Let it go for nothing rather\n		-- than leaving a life permanently unable to clear a phantom entry.\n		life.vehicles.owned[vehicleId] = nil\n		push(player, \"Sold.\")\n		return true\n	end\n\n	local refund = math.floor(kind.price * VEHICLES.ResaleFraction)\n	MoneyService.Add(player, refund, `sold a {kind.name}`)\n	life.vehicles.owned[vehicleId] = nil\n	push(player, `Sold the {kind.name} for {Money.Format(refund)}.`)\n	return true\nend\n\n-- Brings an owned car out of the garage.\nfunction VehicleService.Spawn(player: Player, vehicleId: string): boolean\n	if not enabled then\n		return false\n	end\n	local ok = spawnActive(player, vehicleId)\n	if not ok and spawning[player] ~= true then\n		push(player, \"Could not bring that one out.\")\n	end\n	return ok\nend\n\n-- Puts the active car away by hand, ahead of the idle timeout.\nfunction VehicleService.Store(player: Player): boolean\n	local life = dataFor(player)\n	if life == nil or life.vehicles.active == nil then\n		return false\n	end\n	storeActive(player)\n	push(player, \"Parked.\")\n	return true\nend\n\n-- Whether this player's driver seat currently has a body in it. Read by the\n-- idle tick, and the only reason a spawned car is ever left alone regardless of\n-- IdleDespawnSeconds -- a car cannot time out from under the person driving it.\nlocal function isOccupied(current: Spawned): boolean\n	return current.chassis.seat.Occupant ~= nil\nend\n\nlocal function tickPlayer(player: Player, current: Spawned, elapsed: number)\n	if current.chassis.model.Parent == nil then\n		-- The model left the world some other way -- a hot reload, a server\n		-- sweep. The table entry is stale either way and has to go, or the idle\n		-- clock keeps counting against a car that is not there to time out.\n		spawned[player] = nil\n		local life = dataFor(player)\n		if life ~= nil then\n			life.vehicles.active = nil\n		end\n		return\n	end\n\n	if isOccupied(current) then\n		current.idleFor = 0\n		return\n	end\n\n	current.idleFor += elapsed\n	if current.idleFor >= VEHICLES.IdleDespawnSeconds then\n		storeActive(player)\n		push(player, \"Nobody was using it, so it went back to the lot.\")\n	end\nend\n\n-- Called by LifeService at both ends of a life for the reason every other\n-- service with something standing in the world is called there: a car left\n-- running through a death or a rebirth is the worst frame this teardown\n-- discipline exists to prevent, one vehicle further out than the rest of it.\nfunction VehicleService.ResetForNewLife(player: Player)\n	despawn(player)\n	spawning[player] = nil\n	pushed[player] = nil\nend\n\nfunction VehicleService.SetEnabled(value: boolean)\n	enabled = value\n	if not value then\n		for player in spawned do\n			despawn(player)\n		end\n	end\nend\n\nfunction VehicleService.IsEnabled(): boolean\n	return enabled\nend\n\n-- For the harness: the garage, what is out, and how it is doing.\nfunction VehicleService.Describe(player: Player): string\n	local life = dataFor(player)\n	if life == nil then\n		return \"no profile loaded yet\"\n	end\n	local owned: { string } = {}\n	for id in life.vehicles.owned do\n		table.insert(owned, id)\n	end\n	table.sort(owned)\n\n	local current = spawned[player]\n	local out = \"nothing out\"\n	if current ~= nil then\n		out = string.format(\n			\"%s out, %.1f studs/s, idle %.0fs%s\",\n			current.chassis.kind.name,\n			VehicleChassis.SpeedOf(current.chassis.model.PrimaryPart :: BasePart),\n			current.idleFor,\n			if isOccupied(current) then \" (occupied)\" else \"\"\n		)\n	end\n	return string.format(\n		\"garage %d/%d: %s | %s | %s\",\n		#owned,\n		VEHICLES.MaxOwned,\n		if #owned > 0 then table.concat(owned, \", \") else \"empty\",\n		out,\n		if enabled then \"on\" else \"off\"\n	)\nend\n\nfunction VehicleService:Init()\n	RequestBuyVehicleRemote.OnServerEvent:Connect(function(player: Player, vehicleId: any)\n		if typeof(vehicleId) ~= \"string\" then\n			return\n		end\n		VehicleService.Buy(player, vehicleId)\n	end)\n\n	RequestSellVehicleRemote.OnServerEvent:Connect(function(player: Player, vehicleId: any)\n		if typeof(vehicleId) ~= \"string\" then\n			return\n		end\n		VehicleService.Sell(player, vehicleId)\n	end)\n\n	RequestSpawnVehicleRemote.OnServerEvent:Connect(function(player: Player, vehicleId: any)\n		if typeof(vehicleId) ~= \"string\" then\n			return\n		end\n		VehicleService.Spawn(player, vehicleId)\n	end)\n\n	RequestStoreVehicleRemote.OnServerEvent:Connect(function(player: Player)\n		VehicleService.Store(player)\n	end)\n\n	Players.PlayerAdded:Connect(function(player: Player)\n		task.spawn(function()\n			local profile = DataService.WaitForProfile(player)\n			if profile ~= nil then\n				push(player, nil)\n			end\n		end)\n	end)\n\n	Players.PlayerRemoving:Connect(function(player: Player)\n		despawn(player)\n		spawning[player] = nil\n		pushed[player] = nil\n	end)\nend\n\nfunction VehicleService:Start()\n	task.spawn(function()\n		while true do\n			local elapsed = task.wait(IDLE_TICK_SECONDS)\n			if enabled then\n				for player, current in spawned do\n					local ok, err = pcall(tickPlayer, player, current, elapsed)\n					if not ok then\n						warn(`[AGES] vehicle idle tick failed for {player.Name}: {err}`)\n					end\n				end\n			end\n		end\n	end)\nend\n\nreturn VehicleService\n"
table.insert(AGES_MANIFEST, "src/server/services/VehicleService.luau")
AGES_SOURCES["src/server/services/VerdictService.luau"] = "--!strict\n-- Computes a named ribbon for a life that has ended. Reads LifeData and scores\n-- every ribbon in content/Ribbons.luau against it, then picks the highest.\n--\n-- A life under Config.Verdict.MinAge gets no ribbon — childhood deaths are\n-- honest rather than forced into a category they did not earn.\n--\n-- The service has one public function. Everything else is private so the\n-- content file is the only place a new ribbon touches the system.\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Config = require(ReplicatedStorage:WaitForChild(\"Config\"))\nlocal Types = require(ReplicatedStorage:WaitForChild(\"Types\"))\nlocal Lives = require(ReplicatedStorage:WaitForChild(\"Lives\"))\nlocal DataService = require(script.Parent.DataService)\n\n-- content/, not services/. Ribbons is data and lives with the rest of the content\n-- the way Jobs and Flags do. Written as script.Parent.Ribbons this raised \"Ribbons\n-- is not a valid member of Folder ServerScriptService.Server.services\", and because\n-- a require propagates the throw to its caller, it took LifeService down and then\n-- the bootstrap: the game place loaded with no services in it at all.\nlocal Ribbons = require(script.Parent.Parent.content.Ribbons)\n\ntype Ribbon = Types.Ribbon\ntype RibbonMoment = Types.RibbonMoment\ntype LifeData = Types.LifeData\ntype MomentsFn = (LifeData, {\n	sinceMonths: number?,\n	untilMonths: number?,\n	maxCount: number?,\n	kinds: { string }?,\n}) -> { Types.Moment }\n\nlocal VerdictService = {}\n\nlocal momentsFn: MomentsFn? = nil\n\nfunction VerdictService.SetMoments(fn: MomentsFn)\n	momentsFn = fn\nend\n\n-- How close another ribbon's score must be to the winner to count as a near-miss.\n-- 15% is generous enough that a life that almost became something shows it, but\n-- tight enough that the game does not suggest every ribbon was within reach.\nlocal NEAR_MISS_THRESHOLD = 0.15\n\n-- Format a near-miss as prose. The scoreDelta tells us how far off the life was;\n-- the ribbonId tells us what it almost was.\nlocal function formatNearMiss(nearRibbon: Ribbon, scoreDelta: number, data: LifeData): string\n	local ageYears = data.ageMonths // 12\n	-- The template for near-miss prose is simple: name the ribbon and anchor it\n	-- to a concrete fact the life actually has.\n	local lead = nearRibbon.title\n	if nearRibbon.id == \"steadfast\" then\n		return `One more year at the office and you would have been {lead}.`\n	elseif nearRibbon.id == \"dropout\" then\n		return `You were one class away from finishing.`\n	elseif nearRibbon.id == \"broke\" then\n		return `One good year and you would not have been {lead}.`\n	elseif nearRibbon.id == \"lonely\" then\n		return `One close friend and you would not have been {lead}.`\n	elseif nearRibbon.id == \"convict\" then\n		return `One clean year and you would not have been {lead}.`\n	elseif nearRibbon.id == \"master\" then\n		return `A little further and you would have been {lead}.`\n	elseif nearRibbon.id == \"family\" then\n		return `One more bond and you would have been {lead}.`\n	elseif nearRibbon.id == \"athlete\" then\n		return `One more season and you would have been {lead}.`\n	else\n		return `You were close to being a {lead}.`\n	end\nend\n\nfunction VerdictService.Compute(player: Player): Ribbon?\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return nil\n	end\n	local data = Lives.Active(profile.Data)\n	if not data.alive then\n		return nil\n	end\n\n	local ageYears = data.ageMonths // 12\n	if ageYears < Config.Verdict.MinAge then\n		return nil\n	end\n\n	-- Score every ribbon and track the winner.\n	local bestScore = -1\n	local bestRibbon: Ribbon? = nil\n	local allScores: { [string]: number } = {}\n\n	for _, entry in Ribbons do\n		local score = entry.score(data)\n		allScores[entry.id] = score\n		if score > bestScore then\n			bestScore = score\n			bestRibbon = {\n				id = entry.id,\n				title = entry.title,\n				description = entry.description,\n				moments = {},\n				nearMisses = nil,\n			} :: Ribbon\n		end\n	end\n\n	if bestRibbon == nil then\n		return nil\n	end\n\n	-- Fill the three moments from the winner's template by delegating to the\n	-- shared query. The template only names kinds — the query walks the life's\n	-- data and FormatMoment turns each result into prose.\n	local templateKinds: { string } = {}\n	for _, slot in (Ribbons :: any)[bestRibbon.id].momentsTemplate do\n		local kind = slot.kind :: string\n		if not table.find(templateKinds, kind) then\n			table.insert(templateKinds, kind)\n		end\n	end\n	local moments = (momentsFn :: any)(data, {\n		sinceMonths = 0,\n		maxCount = 3,\n		kinds = templateKinds,\n	})\n	bestRibbon.moments = {}\n	for _, m in moments do\n		table.insert(bestRibbon.moments, {\n			age = m.ageMonths // Config.Time.MonthsPerYear,\n			line = m.line,\n		})\n	end\n\n	-- Compute near-misses: ribbons within 15% of the winning score, up to two.\n	local nearMisses: { string } = {}\n	for ribbonId, score in allScores do\n		if ribbonId ~= bestRibbon.id then\n			local threshold = bestScore * (1 - NEAR_MISS_THRESHOLD)\n			if score >= threshold then\n				local nearEntry = (Ribbons :: any)[ribbonId]\n				if nearEntry ~= nil then\n					local nearRibbon = {\n						id = ribbonId,\n						title = nearEntry.title,\n						description = nearEntry.description,\n						moments = {},\n						nearMisses = nil,\n					} :: Ribbon\n					table.insert(nearMisses, formatNearMiss(nearRibbon, bestScore - score, data))\n				end\n			end\n		end\n	end\n	if #nearMisses > 0 then\n		table.sort(nearMisses)\n		-- Keep at most two.\n		while #nearMisses > 2 do\n			table.remove(nearMisses)\n		end\n		bestRibbon.nearMisses = nearMisses\n	end\n\n	return bestRibbon\nend\n\nreturn VerdictService\n"
