AGES_SOURCES["src/server/world/DeliveryPresenters.luau"] = "--!strict\n-- What a staged delivery *looks like*. DeliveryService decides when something\n-- arrives and how long it waits; this decides what appears in the room.\n--\n-- Split out so the two can change independently: retiming the mail never touches\n-- the envelope, and swapping the envelope for a nicer model never touches the\n-- scheduler. It is also the seam a new mode lands on -- a mode is a builder\n-- function here plus a row in Delivery.luau, and nothing else.\n--\n-- A presenter returns the anchor the player has to reach, plus a dismiss that\n-- owns *all* of its teardown including the anchor itself. Owning teardown rather\n-- than having the anchor destroyed for it is what lets a presentation end\n-- gracefully: an NPC walks back out of the door instead of blinking away.\n--\n-- Presenters do not tag, own or register anything. DeliveryService does that to\n-- whatever anchor comes back, so a new presenter cannot forget to and quietly\n-- produce an object the player can never collect.\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Config = require(ReplicatedStorage:WaitForChild(\"Config\"))\nlocal Types = require(ReplicatedStorage:WaitForChild(\"Types\"))\n\nlocal NPCService = require(script.Parent.Parent.services.NPCService)\n\ntype LifeEvent = Types.LifeEvent\n-- Lives in Types rather than here because NPCService returns one too, and a\n-- shared type both modules require is what keeps them from having to require\n-- each other.\ntype DeliveryPresentation = Types.DeliveryPresentation\n\nlocal DeliveryPresenters = {}\n\nexport type Presenter = (player: Player, point: BasePart, event: LifeEvent) -> DeliveryPresentation?\n\n-- Cosmetic dimensions, not design tunables -- an envelope's thickness is not a\n-- number anyone balances the game with, so it stays out of Config where the\n-- numbers that *are* balanced would have to compete with it for attention.\nlocal LETTER_SIZE = Vector3.new(1.3, 0.07, 0.85)\nlocal LETTER_LIFT = 0.05 -- Clear of the mat, so it doesn't z-fight with it.\nlocal LETTER_YAW = -12 -- Degrees. Dropped mail is never square to the door.\nlocal LETTER_COLOR = Color3.fromRGB(244, 240, 228)\n\n-- Bright enough to find from the far side of a room without reading as a quest\n-- marker. Alpha is on the fill, not the outline, so the object keeps its shape.\nlocal HIGHLIGHT_FILL = 0.85\nlocal HIGHLIGHT_OUTLINE = 0.15\nlocal LETTER_ACCENT = Color3.fromRGB(245, 225, 160)\nlocal PHONE_ACCENT = Color3.fromRGB(150, 205, 245)\n\n-- The phone anchor is invisible: the thing to walk to is the phone that is\n-- already modeled there, and spawning a second visible object next to it would\n-- read as clutter rather than as a call.\nlocal PHONE_ANCHOR_SIZE = Vector3.new(1, 1, 1)\n\nlocal DELIVERIES_FOLDER = \"AgesDeliveries\"\n\n-- One folder for everything staged, so a leak is visible in the explorer rather\n-- than scattered through the house.\nlocal function deliveriesFolder(): Folder\n	local existing = workspace:FindFirstChild(DELIVERIES_FOLDER)\n	if existing ~= nil then\n		return existing :: Folder\n	end\n	local folder = Instance.new(\"Folder\")\n	folder.Name = DELIVERIES_FOLDER\n	folder.Parent = workspace\n	return folder\nend\n\n-- An empty asset id means one has not been picked in Studio yet. Returning nil\n-- rather than creating a Sound with an empty SoundId keeps the failure at\n-- \"silent for now\" instead of a runtime error on a made-up id.\nlocal function soundAt(parent: Instance, assetId: string, looped: boolean): Sound?\n	if assetId == \"\" then\n		return nil\n	end\n	local sound = Instance.new(\"Sound\")\n	sound.SoundId = assetId\n	sound.Looped = looped\n	sound.RollOffMaxDistance = 60\n	sound.Parent = parent\n	sound:Play()\n	return sound\nend\n\nlocal function highlightOn(adornee: Instance, color: Color3): Highlight\n	local highlight = Instance.new(\"Highlight\")\n	highlight.Adornee = adornee\n	highlight.FillColor = color\n	highlight.OutlineColor = color\n	highlight.FillTransparency = HIGHLIGHT_FILL\n	highlight.OutlineTransparency = HIGHLIGHT_OUTLINE\n	highlight.DepthMode = Enum.HighlightDepthMode.Occluded\n	highlight.Parent = adornee\n	return highlight\nend\n\n-- A delivery point is usually a marker inside the model it belongs to -- the\n-- phone part inside the phone -- so the thing worth outlining is the model, not\n-- the marker. Falls back to the point when it stands alone.\nlocal function highlightTarget(point: BasePart): Instance\n	local model = point:FindFirstAncestorOfClass(\"Model\")\n	if model ~= nil and model ~= workspace then\n		return model\n	end\n	return point\nend\n\nlocal function presentLetter(_player: Player, point: BasePart, _event: LifeEvent): DeliveryPresentation?\n	local envelope = Instance.new(\"Part\")\n	envelope.Name = \"Letter\"\n	envelope.Size = LETTER_SIZE\n	envelope.Color = LETTER_COLOR\n	envelope.Material = Enum.Material.SmoothPlastic\n	envelope.Anchored = true\n	-- Non-colliding on purpose: a toddler-height player should walk over the mat\n	-- to reach it, not trip on it or push it under the sofa.\n	envelope.CanCollide = false\n	envelope.CanQuery = false\n	envelope.TopSurface = Enum.SurfaceType.Smooth\n	envelope.BottomSurface = Enum.SurfaceType.Smooth\n	envelope.CFrame = point.CFrame * CFrame.new(0, LETTER_LIFT, 0) * CFrame.Angles(0, math.rad(LETTER_YAW), 0)\n	envelope.Parent = deliveriesFolder()\n\n	highlightOn(envelope, LETTER_ACCENT)\n	soundAt(envelope, Config.Assets.Sounds.LetterArrive, false)\n\n	return {\n		anchor = envelope,\n		dismiss = function(_collected: boolean)\n			envelope:Destroy()\n		end,\n	}\nend\n\nlocal function presentPhoneCall(_player: Player, point: BasePart, _event: LifeEvent): DeliveryPresentation?\n	local anchor = Instance.new(\"Part\")\n	anchor.Name = \"PhoneCall\"\n	anchor.Size = PHONE_ANCHOR_SIZE\n	anchor.Transparency = 1\n	anchor.Anchored = true\n	anchor.CanCollide = false\n	anchor.CanQuery = false\n	anchor.CFrame = point.CFrame\n	anchor.Parent = deliveriesFolder()\n\n	local target = highlightTarget(point)\n	local highlight = highlightOn(target, PHONE_ACCENT)\n	-- Parented to the anchor rather than the phone so the ring travels with the\n	-- object that gets destroyed; the phone itself is permanent house geometry\n	-- and must come out of this exactly as it went in.\n	local ring = soundAt(anchor, Config.Assets.Sounds.PhoneRing, true)\n\n	return {\n		anchor = anchor,\n		dismiss = function(_collected: boolean)\n			if ring ~= nil then\n				ring:Stop()\n			end\n			highlight:Destroy()\n			anchor:Destroy()\n		end,\n	}\nend\n\nlocal function presentNPCApproach(player: Player, point: BasePart, event: LifeEvent): DeliveryPresentation?\n	return NPCService.Arrive(player, point, event)\nend\n\n-- Closed record, matching the pattern used for delivery styles on the client:\n-- add an Ambient mode in Delivery.luau and this stops type-checking until it has\n-- been given something to look like.\nlocal PRESENTERS: {\n	Letter: Presenter,\n	PhoneCall: Presenter,\n	NPCApproach: Presenter,\n} = {\n	Letter = presentLetter,\n	PhoneCall = presentPhoneCall,\n	NPCApproach = presentNPCApproach,\n}\n\n-- Nil for the modes that have no world presence at all. Callers treat that as\n-- \"not stageable\" rather than as an error, because Memory and Direct reaching\n-- here would be a routing bug and Delivery.luau already prevents it.\nfunction DeliveryPresenters.For(delivery: Types.EventDelivery): Presenter?\n	return (PRESENTERS :: any)[delivery]\nend\n\nreturn DeliveryPresenters\n"
table.insert(AGES_MANIFEST, "src/server/world/DeliveryPresenters.luau")
AGES_SOURCES["src/server/world/Ground.luau"] = "--!strict\n-- \"Could a body be here, and could you get to it from there?\" — the three probes\n-- every system that puts something on the floor has to run before it does.\n--\n-- Extracted from EnactService, which asked these questions first and still asks\n-- them the most. SceneService asks the identical questions about a different kind\n-- of body, and two copies of a raycast whose *filter flags* carry the reasoning\n-- would drift the moment one of them was tuned. The comments below are the real\n-- payload of this file: each flag on each query is a decision that took a bug to\n-- find, and they belong in one place.\n--\n-- Everything here is a bounding-box or single-ray approximation, which errs\n-- toward rejecting a tight spot. That is the right way to be wrong for every\n-- caller so far: the cost of rejecting a good spot is a fallback, and the cost of\n-- accepting a bad one is something standing in a wall.\n\nlocal Players = game:GetService(\"Players\")\n\nlocal Ground = {}\n\n-- Distance ignoring height, which is the only distance this game ever actually means.\n--\n-- Every \"am I near it\" in the codebase is a question about the floor: the player standing\n-- on a stair one step above a task mark is *at* the task mark as far as anyone playing is\n-- concerned, and true 3D distance would say otherwise and refuse them the thing they are\n-- standing on. Reaches are tuned in studs across a room, never up it.\n--\n-- Which does mean this is knowingly wrong about one case, and callers should know it: the\n-- office sits directly above the shop floor, so a player upstairs measures as fifteen\n-- studs from a station downstairs, and by this function they are standing next to it.\n-- Left wrong rather than fixed with a height test, because the honest question there is\n-- not \"how far\" but \"could you walk it\" -- and `Reachable` already answers that, at the\n-- one moment it matters, without every reach check in the game paying for a raycast.\n--\n-- Here because it was written out by hand in nine files and open-coded inside the\n-- separation loops of two more, and one of the nine had already drifted to a different\n-- implementation of the same three lines. Nothing was broken by that yet -- which is\n-- exactly the problem, because the first thing that breaks would have been a reach that\n-- behaves differently in the gym than in the shop for no reason anybody wrote down.\nfunction Ground.FlatDistance(a: Vector3, b: Vector3): number\n	local dx = a.X - b.X\n	local dz = a.Z - b.Z\n	return math.sqrt(dx * dx + dz * dz)\nend\n\n-- A character mid-spawn can report an extents size of nearly zero, and a\n-- zero-sized clearance box finds nothing and therefore passes everything. These\n-- are the floor under that reading rather than tunables: roughly a crawling\n-- toddler, which is the smallest body the game actually has.\nlocal MIN_BODY_HEIGHT = 1.2\nlocal MIN_BODY_WIDTH = 1.0\n\n-- How far above a candidate the floor probe starts and how far below it gives\n-- up. Generous downward so a spot can land on a step or a slightly lower floor,\n-- bounded so it cannot find the storey below through a gap.\nlocal PROBE_UP = 6\nlocal PROBE_DOWN = 12\n\n-- Lifted off the floor before the box is swept, so the floor the body stands on\n-- is not itself counted as the thing blocking it.\nlocal CLEARANCE_LIFT = 0.2\n\nfunction Ground.BodyHeight(character: Model): number\n	return math.max(character:GetExtentsSize().Y, MIN_BODY_HEIGHT)\nend\n\n-- What has to fit, as opposed to what is drawn. A marker's disc may overhang a\n-- table leg -- the player stands in the middle of it, not on its edge -- so\n-- testing the whole disc for clearance would reject most of a furnished room for\n-- no reason. Taken from the character rather than fixed, so a crawling toddler\n-- can be offered spots an adult could not stand in, which is correct: they are a\n-- different size and the house is the same house.\nfunction Ground.BodyRadius(character: Model): number\n	local extents = character:GetExtentsSize()\n	return math.max(extents.X, extents.Z, MIN_BODY_WIDTH) / 2\nend\n\n-- Everything a probe must look straight through: every player's character, plus\n-- whatever the caller is in the middle of placing. Rebuilt per placement because\n-- the set of characters changes.\n--\n-- Characters are always excluded rather than optionally so. A probe that stopped\n-- on a body would report \"occupied\" for the one spot the asker is standing in,\n-- and every system here measures spots *around* a player.\nfunction Ground.IgnoreList(extra: { Instance }?): { Instance }\n	local ignore: { Instance } = {}\n	if extra ~= nil then\n		table.move(extra, 1, #extra, 1, ignore)\n	end\n	for _, other in Players:GetPlayers() do\n		local character = other.Character\n		if character ~= nil then\n			table.insert(ignore, character)\n		end\n	end\n	return ignore\nend\n\n-- The floor under a candidate, or nil if there isn't one. Returned rather than\n-- assumed because candidates are generated on a flat plane and the house is not\n-- flat: one can hang over a stairwell or off the edge of an upstairs floor, and\n-- something floating in the air is not where it was meant to be.\nfunction Ground.FloorUnder(candidate: Vector3, ignore: { Instance }): Vector3?\n	local params = RaycastParams.new()\n	params.FilterType = Enum.RaycastFilterType.Exclude\n	params.FilterDescendantsInstances = ignore\n	params.IgnoreWater = true\n	-- Rugs, mats and delivery markers are non-colliding, and a probe that stopped\n	-- on one would place whatever it is siting on the rug's *surface* rather than\n	-- on the floor it is lying on. Half a stud, but it is the difference between a\n	-- pad painted on the floor and one hovering over it.\n	params.RespectCanCollide = true\n\n	local from = candidate + Vector3.new(0, PROBE_UP, 0)\n	local result = workspace:Raycast(from, Vector3.new(0, -(PROBE_UP + PROBE_DOWN), 0), params)\n	if result == nil then\n		return nil\n	end\n	return result.Position\nend\n\n-- Whether a body of this size could actually stand at this spot, `at` being the\n-- point on the floor it would stand on.\nfunction Ground.Standable(at: Vector3, radius: number, height: number, ignore: { Instance }): boolean\n	local params = OverlapParams.new()\n	params.FilterType = Enum.RaycastFilterType.Exclude\n	params.FilterDescendantsInstances = ignore\n	-- Non-colliding parts are rugs, mats, delivery markers and the like: things a\n	-- body passes through, which is exactly what standing on them means. Skipped\n	-- by the query rather than filtered out of its results, so a room full of soft\n	-- furnishings costs nothing to sweep.\n	params.RespectCanCollide = true\n	-- One is all the answer needed: any collidable part in the box means no.\n	params.MaxParts = 1\n\n	local center = at + Vector3.new(0, CLEARANCE_LIFT + height / 2, 0)\n	local box = Vector3.new(radius * 2, height, radius * 2)\n	return #workspace:GetPartBoundsInBox(CFrame.new(center), box, params) == 0\nend\n\n-- The bearings to try, in the order to try them: straight ahead first, then\n-- alternating outward. So whatever is being placed turns up where the player is\n-- already looking whenever the room allows it, and only slides around the arc when\n-- it cannot.\n--\n-- Here rather than in either caller because both are the same question asked about\n-- different bodies -- where can the dog walk in from, where can a parent come from\n-- -- and a fan that tried its bearings in a different order in one of them would be\n-- a different feature wearing the same name. The arc is the caller's, because those\n-- genuinely differ: an animal arrives in front of you and a person may come from\n-- behind.\nfunction Ground.Bearings(arcDegrees: number, count: number): { number }\n	if count <= 1 then\n		return { 0 }\n	end\n\n	local step = arcDegrees / (count - 1)\n	local angles: { number } = {}\n	for index = 1, count do\n		table.insert(angles, -arcDegrees / 2 + (index - 1) * step)\n	end\n	table.sort(angles, function(a: number, b: number): boolean\n		-- Ties are the symmetric pair either side of straight ahead. Which of the two\n		-- is tried first does not matter, but the comparator has to be a strict order\n		-- or table.sort is entitled to throw, so the sign breaks the tie.\n		if math.abs(a) == math.abs(b) then\n			return a < b\n		end\n		return math.abs(a) < math.abs(b)\n	end)\n	return angles\nend\n\n-- Whether one floor point can be reached from another in a straight line. Not a\n-- path test -- a single ray at chest height, which is enough to catch the failure\n-- that actually matters: a spot on the far side of a wall, plainly visible and\n-- completely unreachable.\n--\n-- `height` is the body's, and the ray is cast at half of it, so the same call\n-- answers \"can the player walk there\" and \"can the dog walk here\" without either\n-- caller having to know how the other measures itself.\nfunction Ground.Reachable(from: Vector3, to: Vector3, height: number, ignore: { Instance }): boolean\n	local params = RaycastParams.new()\n	params.FilterType = Enum.RaycastFilterType.Exclude\n	params.FilterDescendantsInstances = ignore\n	params.IgnoreWater = true\n	params.RespectCanCollide = true\n\n	local lift = Vector3.new(0, height / 2, 0)\n	local start = from + lift\n	local finish = to + lift\n	return workspace:Raycast(start, finish - start, params) == nil\nend\n\n-- The three probes above, in the one order they are ever run, as a single question:\n-- \"is there a spot here a body this size could stand in and get to?\" Returns the floor\n-- point, or nil for any of the three ways a candidate can fail.\n--\n-- The order is load-bearing rather than incidental, which is the whole argument for this\n-- existing. `FloorUnder` has to be first because the other two take a point *on the\n-- floor* and a candidate is a point in the air; `Standable` before `Reachable` because a\n-- box query beats a raycast when most rejections are furniture rather than walls.\n-- Eighteen places wrote that sequence out by hand across nine files, and checking that\n-- any two of them agreed meant reading both.\n--\n-- `reachableFrom` is nil for the callers that genuinely do not ask -- a townsperson\n-- standing on a ring around their own doorstep is not walking there, they are simply\n-- there -- rather than a shortcut for the ones that forgot. There is no way to express\n-- \"I skipped the reachability test by accident\" in one optional argument, which is the\n-- point of it being one.\n--\n-- The ray always runs from `reachableFrom` out to the candidate, never inward, and the\n-- direction is fixed here so no caller has to decide it. It very nearly does not matter\n-- and not quite: a ray that starts inside a part registers no hit, so whichever end it\n-- starts from is the end whose own geometry is forgiven. Outward is right because the\n-- asker is the one standing somewhere known to be clear -- they are standing there --\n-- while the candidate is a guess that has not been stood in yet. Two callers used to\n-- cast inward; they now cast outward with everything else.\nfunction Ground.SpotAt(\n	candidate: Vector3,\n	radius: number,\n	height: number,\n	ignore: { Instance },\n	reachableFrom: Vector3?\n): Vector3?\n	local floor = Ground.FloorUnder(candidate, ignore)\n	if floor == nil then\n		return nil\n	end\n	if not Ground.Standable(floor, radius, height, ignore) then\n		return nil\n	end\n	if reachableFrom ~= nil and not Ground.Reachable(reachableFrom, floor, height, ignore) then\n		return nil\n	end\n	return floor\nend\n\n-- Whether a spot is at least `minStuds` from everything already placed.\n--\n-- The counterpart to `SpotAt` and the other half of every placement loop in the game:\n-- the floor will happily accept two marks a stud apart, and two marks a stud apart is a\n-- player clearing both without moving. Five copies of this loop, and two of them were\n-- open-coded flat-distance arithmetic inside the `if` rather than even a named call.\n--\n-- Strictly closer than, so `minStuds` is the closest two things may legally be rather\n-- than the closest they may not. One of the five copies read the comparison the other\n-- way; at exactly the boundary distance they disagreed, which is a difference no float\n-- ever actually lands on and nobody would have found on purpose.\nfunction Ground.Apart(at: Vector3, others: { Vector3 }, minStuds: number): boolean\n	for _, other in others do\n		if Ground.FlatDistance(at, other) < minStuds then\n			return false\n		end\n	end\n	return true\nend\n\n-- `Bearings`, then shuffled, for the searches that must not put their marks in the same\n-- corner of the same room every time.\n--\n-- The opposite of what `Bearings` is for, and both are right: a prop set or an animal\n-- should arrive where the player is already looking, and a shift's eighth task should\n-- not be in the spot the first seven were. Separate functions rather than a flag, so the\n-- call site says which of those two things it wants.\n--\n-- Fisher-Yates written once. It was written twice, identically, in two files that each\n-- said \"shuffled like the other one\" in a comment -- and a hand-rolled shuffle is a\n-- classic place to leave an off-by-one that biases the first element and is invisible\n-- for a year.\nfunction Ground.ScatteredBearings(arcDegrees: number, count: number): { number }\n	local bearings = Ground.Bearings(arcDegrees, count)\n	for index = #bearings, 2, -1 do\n		local swap = math.random(index)\n		bearings[index], bearings[swap] = bearings[swap], bearings[index]\n	end\n	return bearings\nend\n\n-- Deliberately not here: the search itself.\n--\n-- Seven systems run an arc search over these probes and it is tempting to read that as\n-- seven copies of one function. It is not. The dog needs two spots that can see each\n-- other, the toddler wants the *furthest* ring rather than the first hit and picks at\n-- random inside it, the prop set places a whole arrangement per bearing and fails as a\n-- unit, the shop walks out in steps and shuffles, the parent tries two distances and\n-- checks reachability in the opposite direction. The bearings, the ordering, the number\n-- of probes and what counts as success are all different, and all of them are that\n-- activity's design rather than plumbing.\n--\n-- A function taking all of that as arguments would need eight of them, most optional,\n-- and would turn five legible loops into five opaque option tables while still leaving\n-- two callers open-coded because they would not fit. The duplication worth removing is\n-- the part with no decisions in it, which is everything above this comment.\n\nreturn Ground\n"
table.insert(AGES_MANIFEST, "src/server/world/Ground.luau")
AGES_SOURCES["src/server/world/GymRoom.luau"] = "--!strict\n-- The town gym, as a room that exists.\n--\n-- The equipment in this game has always been *found* rather than built: GymService walks\n-- CollectionService for parts tagged AgesGymEquipment and reads a GymKind off each. That is\n-- a good design -- it means a builder can drag a treadmill into Studio and it works -- and\n-- none of it changes here. What it also meant is that on a fresh place there was no gym at\n-- all: four machines had to be hand-placed before the whole system existed.\n--\n-- So this lays a gym and tags what it lays. GymService cannot tell the difference; a bench\n-- built here and a bench dragged in by hand arrive down the same signal, and anything\n-- hand-placed keeps working exactly as it did. **Nothing in this file knows what a workout\n-- is** -- it puts iron on a floor and puts a tag on the iron.\n--\n-- Modelled on a powerlifting floor rather than a health club: racks on platforms down the\n-- back, benches in the middle, cardio along the glass, dumbbells on the mirrored wall. Dense\n-- on purpose. A gym reads as serious because every square foot has something heavy on it,\n-- and a sparse room with four machines in it reads as a showroom -- which is exactly what\n-- the old four-hand-placed-parts version looked like.\n--\n-- Laid around the gym place point, like every other room this codebase builds in code. There\n-- is not an absolute world coordinate in it.\n\nlocal CollectionService = game:GetService(\"CollectionService\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Config = require(ReplicatedStorage:WaitForChild(\"Config\"))\n\nlocal Kit = require(script.Parent.Kit)\nlocal StandDown = require(script.Parent.StandDown)\n\nlocal GymRoom = {}\n\nlocal GYM = Config.Gym\nlocal BUILD = GYM.Build\n\nlocal STAND_DOWN_KEY = \"TownGym\"\n\nlocal W = BUILD.WidthStuds\nlocal D = BUILD.DepthStuds\nlocal H = BUILD.HeightStuds\n\n-- The palette. A warehouse gym is concrete, brick and black rubber with the only colour in\n-- the room coming off the plates -- which is why the plates are worth their parts.\nlocal CONCRETE = Color3.fromRGB(188, 188, 190)\nlocal FLOOR = Color3.fromRGB(158, 158, 160)\nlocal BRICK = Color3.fromRGB(150, 92, 74)\nlocal RUBBER = Color3.fromRGB(30, 31, 34)\nlocal STEEL = Color3.fromRGB(198, 202, 208)\nlocal DARK = Color3.fromRGB(52, 55, 62)\nlocal GLASS_TINT = Color3.fromRGB(196, 220, 240)\n\nexport type Room = {\n	center: Vector3,\n}\n\nlocal room: Room? = nil\nlocal folder: Folder? = nil\n\nlocal function gymFolder(): Folder\n	local existing = folder\n	if existing ~= nil and existing.Parent ~= nil then\n		return existing\n	end\n	local made = Instance.new(\"Folder\")\n	made.Name = \"TownGym\"\n	made.Parent = workspace\n	folder = made\n	return made\nend\n\n-- Tags a part as equipment of a given kind.\n--\n-- The one function in this file GymService cares about, and the only place the tag and the\n-- attribute are written -- so a machine that is built but not registered, or registered\n-- under a kind nothing implements, is impossible by construction rather than by review.\nlocal function makeMachine(part: BasePart, kind: string)\n	part:SetAttribute(GYM.GymKindAttribute, kind)\n	CollectionService:AddTag(part, GYM.EquipmentTag)\nend\n\n-- Builds the gym around a centre point, once. Nil means it could not be laid, which the\n-- caller treats as \"there is no gym here\" -- hand-placed equipment elsewhere still works.\nfunction GymRoom.Build(center: Vector3): Room?\n	local existing = room\n	if existing ~= nil then\n		return existing\n	end\n\n	-- The town's own gym comes down first, and this one is **not** optional tidying.\n	--\n	-- `Workspace.Town.Gym` carries real GymKind attributes on four machines. Laying a second\n	-- gym on the same place point without moving it means GymService indexes both sets, and\n	-- half the equipment a player walks up to is standing inside a wall. This swaps one\n	-- complete set of four kinds for another rather than removing a capability -- which is the\n	-- only reason a model with attributes on it may be stood down at all.\n	StandDown.Hide(STAND_DOWN_KEY, { { parent = \"Town\", model = \"Gym\" } })\n\n	local parent = gymFolder()\n	local function at(x: number, y: number, z: number): Vector3\n		return center + Vector3.new(x, y, z)\n	end\n\n	local halfW = W / 2\n	local halfD = D / 2\n\n	-- The shell. Concrete floor, brick at the back, glass at the front, mirrors down one side.\n	Kit.Slab(parent, \"GymFloor\", at(0, 0.3, 0), W, D, 0.6, { color = FLOOR, material = Enum.Material.Concrete })\n	Kit.Wall(parent, \"GymBrick\", at(-halfW, 0.3, halfD), at(halfW, 0.3, halfD), H, 1.2, {\n		color = BRICK,\n		material = Enum.Material.Brick,\n	})\n	Kit.Wall(parent, \"GymEndL\", at(-halfW, 0.3, -halfD), at(-halfW, 0.3, halfD), H, 1.2, {\n		color = CONCRETE,\n		material = Enum.Material.Concrete,\n	})\n	Kit.GlassWall(parent, \"GymFront\", at(-halfW, 0.3, -halfD), at(halfW, 0.3, -halfD), H, 1.2, 0.66, CONCRETE, GLASS_TINT)\n	Kit.Slab(parent, \"GymRoof\", at(0, 0.3 + H, 0), W, D, 1.2, { color = CONCRETE, material = Enum.Material.Concrete })\n\n	-- The mirrored wall. Half of what a gym looks like, and the reason the right-hand side of\n	-- the room does not read as a blank slab.\n	local mirrorLength = D * BUILD.MirrorShare\n	Kit.Mirror(parent, \"GymMirror\", at(halfW - 0.8, 1.5, -mirrorLength / 2), at(halfW - 0.8, 1.5, mirrorLength / 2), H * 0.5)\n\n	-- The name on the brick, which is the one piece of graphic in the room.\n	local band = Kit.Block(parent, \"GymBand\", at(0, H * 0.62, halfD - 1.4), Vector3.new(W * 0.5, 7, 0.3), {\n		color = BRICK,\n		material = Enum.Material.Brick,\n	})\n	band.CastShadow = false\n	Kit.Sign(band, \"POWER LIFTERS\", W * 0.4, BUILD.LabelMaxDistanceStuds * 2, Color3.fromRGB(238, 158, 96))\n\n	-- Pendant lamps on a grid. Dozens of small hanging lights rather than a few panels is most\n	-- of why the reference reads as a warehouse rather than as an office.\n	for ax = 1, BUILD.LightsAcross do\n		for az = 1, BUILD.LightsAlong do\n			Kit.Pendant(\n				parent,\n				`GymLamp{ax}_{az}`,\n				at(-halfW + W * ((ax - 0.5) / BUILD.LightsAcross), 0.3 + H - 0.6, -halfD + D * ((az - 0.5) / BUILD.LightsAlong)),\n				4.5,\n				DARK\n			)\n		end\n	end\n\n	-- Squat racks on rubber platforms down the back. These are the room's silhouette: a row of\n	-- uprights with loaded bars in them is what a powerlifting floor looks like from the door.\n	--\n	-- Not tagged. There are four workout kinds and none of them is a squat, so a rack that\n	-- registered would either need a fifth kind nobody wrote or would have to lie about being\n	-- a bench. Decoration that is honest about being decoration.\n	for index = 1, BUILD.Racks do\n		local x = -halfW + W * ((index - 0.5) / BUILD.Racks)\n		local z = halfD - BUILD.PlatformDepthStuds / 2 - 6\n		Kit.Slab(parent, `Platform{index}`, at(x, 0.7, z), BUILD.PlatformWidthStuds, BUILD.PlatformDepthStuds, 0.4, {\n			color = RUBBER,\n			collide = false,\n		})\n		for side = -1, 1, 2 do\n			Kit.Column(parent, `RackPost{index}_{side}`, at(x + side * 3.4, 0.7, z), 9, 0.9, STEEL)\n			Kit.Block(parent, `RackFoot{index}_{side}`, at(x + side * 3.4, 1.1, z - 2.5), Vector3.new(1, 0.6, 6), { color = STEEL })\n		end\n		Kit.Block(parent, `RackTie{index}`, at(x, 9.4, z), Vector3.new(7.8, 0.7, 0.7), { color = STEEL })\n		Kit.Barbell(parent, `RackBar{index}`, at(x, 7.4, z - 0.4), 14, 3)\n	end\n\n	-- Flat benches through the middle, each with a bar over it. These are the \"bench\" machine.\n	for index = 1, BUILD.Benches do\n		local x = -halfW + W * ((index - 0.5) / BUILD.Benches)\n		local z = 2\n		Kit.Block(parent, `BenchLeg{index}`, at(x, 1.2, z), Vector3.new(1.6, 1.8, 9), { color = STEEL })\n		local pad = Kit.Block(parent, `Bench{index}`, at(x, 2.6, z), Vector3.new(3.4, 1, 10), {\n			color = RUBBER,\n			collide = true,\n		})\n		makeMachine(pad, \"bench\")\n		Kit.Sign(pad, \"Bench press\", 8, BUILD.LabelMaxDistanceStuds, Color3.fromRGB(240, 240, 244))\n		for side = -1, 1, 2 do\n			Kit.Column(parent, `BenchPost{index}_{side}`, at(x + side * 2.6, 0.7, z - 3.6), 5.5, 0.7, STEEL)\n		end\n		Kit.Barbell(parent, `BenchBar{index}`, at(x, 6.2, z - 3.6), 12, 2)\n	end\n\n	-- Cardio along the glass, facing out. Facing out matters: a treadmill against a blank wall\n	-- is a treadmill nobody would choose, and every gym in the world puts them at the window.\n	for index = 1, BUILD.Treadmills do\n		local x = -halfW + W * ((index - 0.5) / BUILD.Treadmills)\n		local z = -halfD + 8\n		Kit.Block(parent, `TreadBase{index}`, at(x, 1, z), Vector3.new(6, 1.4, 11), { color = DARK })\n		local belt = Kit.Block(parent, `Treadmill{index}`, at(x, 1.9, z + 1), Vector3.new(5, 0.5, 8), {\n			color = RUBBER,\n			collide = true,\n		})\n		makeMachine(belt, \"treadmill\")\n		Kit.Sign(belt, \"Treadmill\", 8, BUILD.LabelMaxDistanceStuds, Color3.fromRGB(240, 240, 244))\n		-- The console and the handrails.\n		Kit.Block(parent, `TreadConsole{index}`, at(x, 6, z - 4.4), Vector3.new(5, 3, 0.6), { color = Color3.fromRGB(24, 26, 34) })\n		Kit.Block(parent, `TreadScreen{index}`, at(x, 6.2, z - 4.8), Vector3.new(3.6, 1.8, 0.2), {\n			color = Color3.fromRGB(88, 150, 214),\n			material = Enum.Material.Neon,\n		}).CastShadow = false\n		for side = -1, 1, 2 do\n			Kit.Block(parent, `TreadRail{index}_{side}`, at(x + side * 2.6, 4.4, z - 2), Vector3.new(0.4, 0.4, 5), { color = STEEL })\n		end\n	end\n\n	-- Dumbbell racks along the mirrored side, in descending sizes.\n	for index = 1, BUILD.DumbbellRacks do\n		local z = -halfD + D * ((index - 0.5) / BUILD.DumbbellRacks)\n		local x = halfW - 7\n		Kit.Block(parent, `DbFrame{index}`, at(x, 1.6, z), Vector3.new(4, 2.6, 16), { color = DARK })\n		local rack = Kit.Block(parent, `Dumbbells{index}`, at(x, 3.4, z), Vector3.new(4.4, 1, 16), {\n			color = STEEL,\n			collide = true,\n		})\n		makeMachine(rack, \"dumbbells\")\n		Kit.Sign(rack, \"Dumbbells\", 8, BUILD.LabelMaxDistanceStuds, Color3.fromRGB(240, 240, 244))\n		for bell = 1, 8 do\n			local bz = z - 7 + bell * 1.7\n			local size = 1.9 - bell * 0.08\n			Kit.Block(parent, `Db{index}_{bell}`, at(x, 4.3, bz), Vector3.new(3.2, 0.5, 0.5), { color = STEEL }).CastShadow = false\n			for side = -1, 1, 2 do\n				Kit.Block(parent, `DbHead{index}_{bell}_{side}`, at(x + side * 1.3, 4.3, bz), Vector3.new(0.9, size, size), {\n					color = RUBBER,\n				}).CastShadow = false\n			end\n		end\n	end\n\n	-- The pull-up frame, in the corner where there is height for it.\n	local px = -halfW + 12\n	local pz = -halfD + D * 0.5\n	for side = -1, 1, 2 do\n		Kit.Column(parent, `PullPost{side}`, at(px + side * 5, 0.7, pz), 13, 1, STEEL)\n	end\n	local bar = Kit.Block(parent, \"PullupBar\", at(px, 13.5, pz), Vector3.new(11, 0.7, 0.7), {\n		color = STEEL,\n		collide = true,\n	})\n	makeMachine(bar, \"pullup\")\n	Kit.Sign(bar, \"Pull-up bar\", 9, BUILD.LabelMaxDistanceStuds, Color3.fromRGB(240, 240, 244))\n\n	-- Loose plates and a chalk stand, because a gym floor is never tidy and a perfectly clear\n	-- floor is the tell that a room was generated.\n	for index = 1, 6 do\n		local angle = (index / 6) * math.pi * 2\n		Kit.Block(parent, `LoosePlate{index}`, at(math.cos(angle) * (W * 0.28), 0.9, math.sin(angle) * (D * 0.2)), Vector3.new(3.4, 0.5, 3.4), {\n			color = if index % 2 == 0 then Color3.fromRGB(206, 66, 62) else Color3.fromRGB(56, 110, 196),\n		}).CastShadow = false\n	end\n	Kit.Block(parent, \"ChalkStand\", at(halfW - 16, 2, halfD - 14), Vector3.new(3, 3.4, 3), { color = Color3.fromRGB(236, 236, 240) })\n\n	local built: Room = { center = center }\n	room = built\n	return built\nend\n\nfunction GymRoom.Room(): Room?\n	return room\nend\n\n-- Takes the gym down. Every machine it laid goes with it, and CollectionService drops the\n-- tags on destroy, so GymService unregisters them on its own -- which is why this does not\n-- have to walk them.\nfunction GymRoom.Clear()\n	local existing = folder\n	if existing ~= nil then\n		existing:Destroy()\n	end\n	folder = nil\n	room = nil\n	-- And the town's own gym goes back, or clearing this one would leave the town with no gym\n	-- at all -- which is worse than the duplicate this replaced.\n	StandDown.Restore(STAND_DOWN_KEY)\nend\n\nreturn GymRoom\n"
table.insert(AGES_MANIFEST, "src/server/world/GymRoom.luau")
AGES_SOURCES["src/server/world/Kit.luau"] = "--!strict\n-- The building kit: the pieces every laid-in-code structure is made of.\n--\n-- Lab, Studio, Corridor and ReadingRoom each grew their own `buildBlock` and their own\n-- `buildLabel`, byte-identical apart from which folder they parented into. That was fine at\n-- four rooms and stops being fine at a three-storey building with an aquatic centre on the\n-- side: the fifth copy is the one where somebody fixes a surface property in four places and\n-- misses the fifth, and the symptom is one room in the school lit differently to the rest.\n--\n-- So this is the shared vocabulary. It knows nothing about schools -- it knows about slabs,\n-- glass, columns, light panels, signs and stairs, and anything laid in Luau can speak it.\n--\n-- **Nothing here is anchored to the world.** Every function takes the position it is given\n-- and the folder it is to live in. There is not an absolute world coordinate anywhere in\n-- this file, and there must never be one: the map still moves, and a kit that knew where\n-- anything was would move the wrong things when it did.\n--\n-- Everything is `Anchored` and almost everything is `CanCollide = false`. Collision is opt\n-- in, per piece, because the cost of a stray collidable prop in a corridor is a player stuck\n-- on a bench, and the cost of a non-collidable wall is a player walking through it -- the\n-- second is a bug you see immediately and the first is one you get a report about.\n\nlocal Kit = {}\n\n-- How often a glazed wall is divided, and how heavy the divisions are.\n--\n-- Eight studs is a bay a little wider than a doorway, which is what makes it work: the eye\n-- has a human-sized unit to measure the elevation against, and a wall that was one huge sheet\n-- becomes a legible count of bays. Wider than about twelve and the effect is lost; tighter\n-- than about six and a long elevation turns into a fence.\n-- Safe range: 6-12, 0.3-0.8, 8-16.\n-- **Bay width, and the reason it is not the real-world number.**\n--\n-- A real curtain wall mullion sits every 1.35-1.65m, which at 0.28m to the stud is about every\n-- five. At that spacing a 228-stud frontage carries 40-odd bars and reads as a barcode -- which\n-- is exactly what it did: 56 mullions across two floors, and the first thing anyone said about\n-- the building was that there were stripes everywhere.\n--\n-- Roblox is not built at real scale and the reference school is not either: its glazing is a\n-- few big panes with chunky frames, because that is what reads as a window from a distance you\n-- can actually see a whole building from. 18 studs gives about a dozen bays across the front,\n-- which is a curtain wall rather than a fence.\nlocal MULLION_SPACING_STUDS = 18\nlocal MULLION_WIDTH_STUDS = 0.5\nlocal MULLION_TRANSOM_MIN_HEIGHT = 11\n\n-- The material every painted surface uses unless told otherwise. SmoothPlastic rather than\n-- Plastic because Plastic carries a subtle noise texture that reads as dirt at the scale a\n-- school is built at, and it is the difference between \"clean modern building\" and \"old\".\nlocal DEFAULT_MATERIAL = Enum.Material.SmoothPlastic\n\nexport type BlockOptions = {\n	color: Color3,\n	material: Enum.Material?,\n	transparency: number?,\n	collide: boolean?,\n	-- Rotation about the vertical axis, in degrees. Everything in a building is either\n	-- square to the grid or turned about Y, so this is the only rotation the kit offers --\n	-- an arbitrary CFrame parameter would be an invitation to lay something at an angle no\n	-- other piece can line up with.\n	yawDegrees: number?,\n	-- Rotation about X, for the one thing yaw cannot do: tilt something along its length. A\n	-- stair's stringer and a ramp's soffit are diagonals, and stepping them out of little boxes\n	-- reads as stairs made of stairs. Defaults to zero, so nothing that does not ask for it moves.\n	pitchDegrees: number?,\n	reflectance: number?,\n}\n\n-- One rectangular piece, positioned by its **centre**.\n--\n-- Centre rather than by a corner or by its base, because every other thing in this file\n-- composes out of it and two conventions would mean converting between them at every call\n-- site -- which is exactly where an off-by-half-a-height error lives.\nfunction Kit.Block(parent: Instance, name: string, center: Vector3, size: Vector3, options: BlockOptions): BasePart\n	local part = Instance.new(\"Part\")\n	part.Name = name\n	part.Size = size\n	part.CFrame = CFrame.new(center)\n		* CFrame.Angles(0, math.rad(options.yawDegrees or 0), 0)\n		* CFrame.Angles(math.rad(options.pitchDegrees or 0), 0, 0)\n	part.Anchored = true\n	part.CanCollide = options.collide == true\n	part.Color = options.color\n	part.Material = options.material or DEFAULT_MATERIAL\n	part.Transparency = options.transparency or 0\n	part.Reflectance = options.reflectance or 0\n	part.TopSurface = Enum.SurfaceType.Smooth\n	part.BottomSurface = Enum.SurfaceType.Smooth\n	part.Parent = parent\n	return part\nend\n\n-- A floor or ceiling slab, positioned by the height of its **top surface**, which is the\n-- number anybody laying a storey actually has: a floor at y = 18 means you stand at 18.\nfunction Kit.Slab(\n	parent: Instance,\n	name: string,\n	center: Vector3,\n	width: number,\n	depth: number,\n	thickness: number,\n	options: BlockOptions\n): BasePart\n	local at = Vector3.new(center.X, center.Y - thickness / 2, center.Z)\n	local block = Kit.Block(parent, name, at, Vector3.new(width, thickness, depth), options)\n	-- Floors collide unless the caller says otherwise, which is the opposite of the default\n	-- and is the one place the inversion is right: a floor you fall through is not a floor.\n	block.CanCollide = if options.collide == nil then true else options.collide\n	return block\nend\n\n-- A wall, given the two ends of its base line and a height. Works out its own length and\n-- yaw, so a caller lays walls by naming corners rather than by doing trigonometry -- which\n-- is what makes a room a loop over four points instead of four hand-written blocks.\nfunction Kit.Wall(\n	parent: Instance,\n	name: string,\n	from: Vector3,\n	to: Vector3,\n	height: number,\n	thickness: number,\n	options: BlockOptions\n): BasePart?\n	local delta = to - from\n	local length = delta.Magnitude\n	if length < 0.05 then\n		-- Two corners in the same place. Refused rather than built as a zero-length sliver,\n		-- because a degenerate part is invisible in Studio and impossible to select.\n		return nil\n	end\n	local mid = from + delta * 0.5\n	local yaw = math.deg(math.atan2(-delta.X, -delta.Z))\n	local opts: BlockOptions = {\n		color = options.color,\n		material = options.material,\n		transparency = options.transparency,\n		collide = if options.collide == nil then true else options.collide,\n		yawDegrees = yaw,\n		reflectance = options.reflectance,\n	}\n	return Kit.Block(\n		parent,\n		name,\n		Vector3.new(mid.X, mid.Y + height / 2, mid.Z),\n		Vector3.new(thickness, height, length),\n		opts\n	)\nend\n\n-- A glazed wall: a sill, a head, and glass between them.\n--\n-- Three pieces rather than one transparent block, and that is the whole reason this\n-- function exists. A window wall in a real building has a solid band at the floor and\n-- another at the ceiling; without them glass reads as a *missing* wall rather than as a\n-- window, and the building looks unfinished in exactly the way a first pass always does.\nfunction Kit.GlassWall(\n	parent: Instance,\n	name: string,\n	from: Vector3,\n	to: Vector3,\n	height: number,\n	thickness: number,\n	glassShare: number,\n	frameColor: Color3,\n	glassColor: Color3\n)\n	local glassHeight = height * glassShare\n	local bandHeight = (height - glassHeight) / 2\n\n	Kit.Wall(parent, `{name}Sill`, from, to, bandHeight, thickness, { color = frameColor })\n\n	local glassBase = Vector3.new(from.X, from.Y + bandHeight, from.Z)\n	local glassTo = Vector3.new(to.X, to.Y + bandHeight, to.Z)\n	local pane = Kit.Wall(parent, `{name}Glass`, glassBase, glassTo, glassHeight, thickness * 0.5, {\n		color = glassColor,\n		material = Enum.Material.Glass,\n		transparency = 0.55,\n		-- Deliberately not collidable. A glazed elevation is mostly glass, and a player who\n		-- clips a pane while walking the corridor behind it would be stopped by something they\n		-- can see straight through -- which reads as the building being broken.\n		collide = false,\n		reflectance = 0.15,\n	})\n	if pane ~= nil then\n		pane.CastShadow = false\n	end\n\n	local headBase = Vector3.new(from.X, from.Y + bandHeight + glassHeight, from.Z)\n	local headTo = Vector3.new(to.X, to.Y + bandHeight + glassHeight, to.Z)\n	Kit.Wall(parent, `{name}Head`, headBase, headTo, bandHeight, thickness, { color = frameColor })\n\n	-- Mullions: the uprights that divide a glazed elevation into bays.\n	--\n	-- This is the single highest-value detail in the whole kit per part spent, and the reason\n	-- is scale rather than decoration. A ninety-stud pane of flat glass has nothing in it to\n	-- measure the building against, so the eye reads it as one enormous window and the whole\n	-- elevation loses its size -- which is exactly why the school looked toy-like next to a\n	-- town of small houses. Divide the same glass every eight studs and each bay is suddenly\n	-- door-sized, the building is legibly three storeys, and not one dimension has changed.\n	--\n	-- Every glazed wall in the school goes through this function -- the frontage, both wings,\n	-- the gym, the pool hall and every classroom elevation -- so the spacing here is the\n	-- glazing rhythm of the entire building.\n	local span = (to - from).Magnitude\n	if span > MULLION_SPACING_STUDS then\n		local bays = math.max(1, math.floor(span / MULLION_SPACING_STUDS + 0.5))\n		local direction = (to - from).Unit\n		for index = 1, bays - 1 do\n			local along = from + direction * (span * (index / bays))\n			local base = Vector3.new(along.X, from.Y + bandHeight, along.Z)\n			local bar = Kit.Block(\n				parent,\n				`{name}Mullion{index}`,\n				base + Vector3.new(0, glassHeight / 2, 0),\n				Vector3.new(MULLION_WIDTH_STUDS, glassHeight, thickness * 0.9),\n				{\n					color = frameColor,\n					-- Turned to stand square in the wall, the same way Kit.Wall turns its own\n					-- panels: a mullion at the wall's angle rather than the world's.\n					yawDegrees = -math.deg(math.atan2(direction.Z, direction.X)),\n				}\n			)\n			bar.CastShadow = false\n		end\n\n		-- A transom across the middle, which is what stops tall bays reading as slots. Only on\n		-- glazing tall enough to want one -- a low clerestory divided horizontally looks like\n		-- a mistake rather than a window.\n		if glassHeight > MULLION_TRANSOM_MIN_HEIGHT then\n			local transom = Kit.Wall(\n				parent,\n				`{name}Transom`,\n				Vector3.new(from.X, from.Y + bandHeight + glassHeight / 2, from.Z),\n				Vector3.new(to.X, to.Y + bandHeight + glassHeight / 2, to.Z),\n				MULLION_WIDTH_STUDS,\n				thickness * 0.9,\n				{ color = frameColor, collide = false }\n			)\n			if transom ~= nil then\n				transom.CastShadow = false\n			end\n		end\n	end\nend\n\n-- A structural column, by the centre of its base.\nfunction Kit.Column(parent: Instance, name: string, base: Vector3, height: number, thickness: number, color: Color3): BasePart\n	return Kit.Block(\n		parent,\n		name,\n		Vector3.new(base.X, base.Y + height / 2, base.Z),\n		Vector3.new(thickness, height, thickness),\n		{ color = color, material = Enum.Material.Concrete, collide = true }\n	)\nend\n\n-- A recessed ceiling light panel. Neon rather than a PointLight, and that is a performance\n-- decision rather than a look one: a school interior wants sixty of these and sixty real\n-- lights would cost more than the rest of the building put together. Neon is free and, at\n-- this scale, indistinguishable.\nfunction Kit.LightPanel(parent: Instance, name: string, center: Vector3, width: number, depth: number): BasePart\n	local panel = Kit.Block(parent, name, center, Vector3.new(width, 0.2, depth), {\n		color = Color3.fromRGB(255, 253, 244),\n		material = Enum.Material.Neon,\n	})\n	panel.CastShadow = false\n	return panel\nend\n\n-- A flat circular rug. The cheapest thing in the kit and, at a white tiled floor, close to\n-- the most effective: an unbroken tile plane reads as a warehouse, and two or three of these\n-- read as a room somebody furnished.\nfunction Kit.Rug(parent: Instance, name: string, center: Vector3, radius: number, color: Color3): BasePart\n	local rug = Instance.new(\"Part\")\n	rug.Name = name\n	rug.Shape = Enum.PartType.Cylinder\n	rug.Size = Vector3.new(0.12, radius * 2, radius * 2)\n	-- Turned on its side: a Roblox cylinder\\'s length runs along X, so a flat disc is a\n	-- quarter turn about Z rather than a short cylinder.\n	rug.CFrame = CFrame.new(center) * CFrame.Angles(0, 0, math.rad(90))\n	rug.Anchored = true\n	rug.CanCollide = false\n	rug.Color = color\n	rug.Material = Enum.Material.Fabric\n	rug.CastShadow = false\n	rug.Parent = parent\n	return rug\nend\n\n-- A planter with a hedge in it. Two blocks, and the reason it is worth a function is that\n-- the proportion between them is what makes it read as planting rather than as a green box\n-- on a white box.\nfunction Kit.Planter(parent: Instance, name: string, base: Vector3, width: number, height: number)\n	local potHeight = height * 0.32\n	Kit.Block(parent, `{name}Pot`, Vector3.new(base.X, base.Y + potHeight / 2, base.Z), Vector3.new(width, potHeight, width), {\n		color = Color3.fromRGB(238, 238, 240),\n	})\n	Kit.Block(\n		parent,\n		`{name}Hedge`,\n		Vector3.new(base.X, base.Y + potHeight + (height - potHeight) / 2, base.Z),\n		Vector3.new(width * 0.86, height - potHeight, width * 0.86),\n		{ color = Color3.fromRGB(104, 152, 84), material = Enum.Material.Grass }\n	)\nend\n\n-- A tree: trunk and two canopy blobs. Not a mesh, because the kit must not depend on an\n-- asset id -- a building that needs the catalog to be reachable is a building that does not\n-- lay on a fresh machine.\n-- A clipped conical topiary: the tall dark-green cone that lines the reference's forecourt.\n--\n-- It is a different plant from Kit.Tree and it is worth having both. A round canopy on a\n-- visible trunk reads as a park tree; these read as *landscaping* -- something a groundsman\n-- shapes -- and a row of them down an approach is most of why that frontage looks like a\n-- school somebody maintains rather than a building dropped on grass.\n--\n-- Built as a stack of tapering balls rather than one cone, because there is no cone primitive\n-- and a stack reads softer than the wedge that would otherwise be reached for -- these are\n-- clipped shrubs, not spikes.\nfunction Kit.Topiary(parent: Instance, name: string, base: Vector3, height: number, tiers: number)\n	local trunkHeight = height * 0.12\n	Kit.Block(parent, `{name}Trunk`, Vector3.new(base.X, base.Y + trunkHeight / 2, base.Z), Vector3.new(1.2, trunkHeight, 1.2), {\n		color = Color3.fromRGB(104, 78, 58),\n		material = Enum.Material.Wood,\n	})\n\n	local green = Color3.fromRGB(78, 128, 70)\n	for tier = 1, tiers do\n		local share = (tier - 1) / tiers\n		-- Width falls away faster than height climbs, which is what makes a cone rather than a\n		-- column. The top tier is deliberately small enough to read as a point.\n		local width = height * 0.36 * (1 - share * 0.82)\n		local tall = height * 0.9 / tiers * 1.25\n		local y = base.Y + trunkHeight + (height * 0.9) * (share + 0.5 / tiers)\n		local blob = Instance.new(\"Part\")\n		blob.Name = `{name}Tier{tier}`\n		blob.Shape = Enum.PartType.Ball\n		blob.Size = Vector3.new(width, tall, width)\n		blob.CFrame = CFrame.new(base.X, y, base.Z)\n		blob.Anchored = true\n		blob.CanCollide = false\n		blob.Color = green\n		blob.Material = Enum.Material.Grass\n		blob.CastShadow = tier == 1\n		blob.Parent = parent\n	end\nend\n\nfunction Kit.Tree(parent: Instance, name: string, base: Vector3, height: number)\n	local trunkHeight = height * 0.45\n	Kit.Block(parent, `{name}Trunk`, Vector3.new(base.X, base.Y + trunkHeight / 2, base.Z), Vector3.new(1.6, trunkHeight, 1.6), {\n		color = Color3.fromRGB(112, 84, 62),\n		material = Enum.Material.Wood,\n	})\n	local canopy = Instance.new(\"Part\")\n	canopy.Name = `{name}Canopy`\n	canopy.Shape = Enum.PartType.Ball\n	canopy.Size = Vector3.new(height * 0.5, height * 0.62, height * 0.5)\n	canopy.CFrame = CFrame.new(base + Vector3.new(0, trunkHeight + height * 0.28, 0))\n	canopy.Anchored = true\n	canopy.CanCollide = false\n	canopy.Color = Color3.fromRGB(96, 148, 82)\n	canopy.Material = Enum.Material.Grass\n	canopy.Parent = parent\nend\n\n-- A flight of stairs as a run of steps, from one landing to the next.\n--\n-- Real steps rather than a ramp with a texture, because a ramp is the thing that makes a\n-- three-storey building feel like a diagram: you glide up it. Roblox humanoids climb a step\n-- of up to 2 studs without help, so the rise per step is worked out from the count and\n-- checked against that -- a flight that is too steep is refused rather than laid, since the\n-- failure is a player who cannot reach the first floor and no error anywhere.\n-- A staircase that turns as it climbs: treads fanned around an arc rather than laid in a line.\n--\n-- Kit.Stairs makes a straight flight, and a straight flight in a lobby is a ramp with edges.\n-- The reference school's stair sweeps round as it rises, which does two things a straight run\n-- cannot: it presents its side to the room rather than its end, so you read the whole flight\n-- from the door; and it turns you toward the corridor as you arrive, so the building tells you\n-- where to go next without a sign.\n--\n-- **The tread is a wedge, approximated by a box.** A true winder tread is a sector -- narrow at\n-- the inside of the turn, wide at the outside -- and there is no sector primitive. A box set\n-- tangent to the arc at its own mid-radius is close enough at these sizes that the gap on the\n-- outside edge reads as the shadow line between treads, which is a thing real stairs have.\n--\n--   center      the point the stair turns around, at the foot's height\n--   radius      from that centre to the middle of the tread\n--   startAngle  radians; 0 is +X, increasing turns toward +Z\n--   sweep       radians of turn over the whole flight; negative turns the other way\n--   rise        total height climbed\n--\n-- Returns false if a step would be taller than a humanoid can climb, the same contract\n-- Kit.Stairs has, so a caller can fail loudly rather than build an unusable stair.\nfunction Kit.CurvedStairs(\n	parent: Instance,\n	name: string,\n	center: Vector3,\n	radius: number,\n	startAngle: number,\n	sweep: number,\n	rise: number,\n	steps: number,\n	width: number,\n	color: Color3\n): boolean\n	local perStep = rise / steps\n	if perStep > 2 then\n		return false\n	end\n\n	-- Arc length at the tread's mid-radius, divided by the step count, is how deep each tread\n	-- is. Measuring at mid-radius rather than at the inside edge is what keeps the going even\n	-- for somebody walking up the middle of the flight, which is where people walk.\n	local arc = math.abs(sweep) * radius\n	local depthPerStep = arc / steps\n\n	for index = 1, steps do\n		local share = (index - 0.5) / steps\n		local angle = startAngle + sweep * share\n		local topY = center.Y + perStep * index\n		local height = topY - center.Y\n		local px = center.X + math.cos(angle) * radius\n		local pz = center.Z + math.sin(angle) * radius\n\n		-- Tangent to the arc. The tread's depth runs along the direction of travel, so the box\n		-- is yawed to face along the tangent rather than along the radius.\n		local yaw = -math.deg(angle) - 90\n\n		-- **A tread and a riser, not a block down to the floor.**\n		--\n		-- Each step used to be a box running from the ground up to its own top surface, on the\n		-- reasoning that a flight of floating treads is one you can fall through. On a straight\n		-- flight those boxes hide behind each other and it reads fine. On a curved one they fan\n		-- out, and every step shows its full-height side to the room -- twenty solid slabs of\n		-- increasing height, which is what a platform under each stair looks like.\n		--\n		-- A tread with a riser board closes the flight just as completely: there is no gap to\n		-- fall through, and the stair reads as a stair from underneath as well as from the side.\n		Kit.Block(parent, `{name}Step{index}`, Vector3.new(px, topY - 0.35, pz), Vector3.new(depthPerStep * 1.15, 0.7, width), {\n			color = color,\n			collide = true,\n			yawDegrees = yaw,\n		})\n		Kit.Block(parent, `{name}Riser{index}`, Vector3.new(px - math.cos(angle) * depthPerStep * 0.5, topY - perStep / 2 - 0.2, pz - math.sin(angle) * depthPerStep * 0.5), Vector3.new(0.5, perStep, width), {\n			color = Color3.fromRGB(228, 232, 240),\n			collide = true,\n			yawDegrees = yaw,\n		}).CastShadow = false\n\n		-- The nosing, which is what makes a step read as a step rather than as a terrace.\n		local nose = Kit.Block(parent, `{name}Nose{index}`, Vector3.new(px, topY - 0.16, pz), Vector3.new(0.7, 0.32, width + 0.3), {\n			color = Color3.fromRGB(214, 218, 226),\n			yawDegrees = yaw,\n		})\n		nose.CastShadow = false\n	end\n\n	-- A stringer under the treads, following the same arc as it climbs. With the solid wedges\n	-- gone the flight needs something carrying it, or it reads as steps hanging in the air.\n	for side = -1, 1, 2 do\n		local edge = radius + side * (width / 2 - 0.4)\n		for index = 1, steps do\n			local share = (index - 0.5) / steps\n			local angle = startAngle + sweep * share\n			local px = center.X + math.cos(angle) * edge\n			local pz = center.Z + math.sin(angle) * edge\n			Kit.Block(parent, `{name}Stringer{side}_{index}`, Vector3.new(px, center.Y + perStep * index - 1.5, pz), Vector3.new(depthPerStep * 1.2, 2.2, 0.6), {\n				color = Color3.fromRGB(150, 156, 168),\n				yawDegrees = -math.deg(angle) - 90,\n			}).CastShadow = false\n		end\n	end\n\n	-- The balustrade, as a run of short posts following the same arc with a rail on top. A\n	-- curved stair cannot take a straight glass panel, so this is the one place the building\n	-- uses posts -- and a fanned run of them is what makes the curve legible from across the\n	-- lobby, more than the treads do.\n	for side = -1, 1, 2 do\n		local railRadius = radius + side * (width / 2)\n		local posts = math.max(4, math.floor(steps / 2))\n		for index = 0, posts do\n			local share = index / posts\n			local angle = startAngle + sweep * share\n			local px = center.X + math.cos(angle) * railRadius\n			local pz = center.Z + math.sin(angle) * railRadius\n			local y = center.Y + rise * share\n			Kit.Block(parent, `{name}Post{side}_{index}`, Vector3.new(px, y + 2.2, pz), Vector3.new(0.35, 4.4, 0.35), {\n				color = Color3.fromRGB(72, 76, 86),\n				material = Enum.Material.Metal,\n			}).CastShadow = false\n			-- A short rail segment bridging this post to the next, tilted to follow the climb.\n			if index < posts then\n				local nextShare = (index + 1) / posts\n				local nextAngle = startAngle + sweep * nextShare\n				local nx = center.X + math.cos(nextAngle) * railRadius\n				local nz = center.Z + math.sin(nextAngle) * railRadius\n				local ny = center.Y + rise * nextShare\n				local midY = (y + ny) / 2 + 4.4\n				local run = Vector3.new(nx - px, 0, nz - pz).Magnitude\n				local seg = Kit.Block(\n					parent,\n					`{name}Rail{side}_{index}`,\n					Vector3.new((px + nx) / 2, midY, (pz + nz) / 2),\n					Vector3.new(run + 0.4, 0.35, 0.35),\n					{\n						color = Color3.fromRGB(72, 76, 86),\n						material = Enum.Material.Metal,\n						yawDegrees = -math.deg(math.atan2(nz - pz, nx - px)),\n					}\n				)\n				seg.CastShadow = false\n			end\n		end\n	end\n	return true\nend\n\nfunction Kit.Stairs(\n	parent: Instance,\n	name: string,\n	base: Vector3,\n	top: Vector3,\n	width: number,\n	steps: number,\n	color: Color3\n): boolean\n	local rise = top.Y - base.Y\n	local perStep = rise / steps\n	if perStep > 2 then\n		return false\n	end\n\n	local run = Vector3.new(top.X - base.X, 0, top.Z - base.Z)\n	local runLength = run.Magnitude\n	if runLength < 0.05 then\n		return false\n	end\n	local direction = run.Unit\n	local yaw = math.deg(math.atan2(-direction.X, -direction.Z))\n	local depthPerStep = runLength / steps\n\n	for index = 1, steps do\n		-- Each tread is a block whose top is at that step\\'s height and which reaches all the\n		-- way down to the base. Solid rather than floating treads: a player who walks off the\n		-- side of a floating flight falls through the middle of the building.\n		local topY = base.Y + perStep * index\n		local centre = base + direction * (depthPerStep * (index - 0.5))\n		local height = topY - base.Y\n		Kit.Block(\n			parent,\n			`{name}Step{index}`,\n			Vector3.new(centre.X, base.Y + height / 2, centre.Z),\n			Vector3.new(width, height, depthPerStep),\n			{ color = color, collide = true, yawDegrees = yaw }\n		)\n\n		-- The nosing: a thin lighter lip along the front edge of each tread.\n		--\n		-- This is the whole difference between a flight that reads as stairs and one that reads\n		-- as a stack of boxes. A real stair has a shadow line at every step, and without one a\n		-- white flight against a white wall is a smooth ramp with faint seams -- which is exactly\n		-- what it looked like. One thin part per step, and it is the cheapest detail in the kit.\n		local nose = Kit.Block(\n			parent,\n			`{name}Nose{index}`,\n			Vector3.new(centre.X, topY - 0.16, centre.Z) + direction * (depthPerStep * 0.42),\n			Vector3.new(width + 0.3, 0.32, 0.7),\n			{ color = Color3.fromRGB(214, 218, 226), yawDegrees = yaw }\n		)\n		nose.CastShadow = false\n	end\n\n	-- Stringers down both sides: the raked beams a real flight is carried on. They close the\n	-- open edge, so the staircase has a side rather than showing the end grain of every tread.\n	for side = -1, 1, 2 do\n		local across = Vector3.new(-direction.Z, 0, direction.X) * (width / 2 + 0.25)\n		local mid = base + direction * (runLength / 2) + across * side\n		local stringer = Kit.Block(\n			parent,\n			`{name}Stringer{side}`,\n			Vector3.new(mid.X, base.Y + rise / 2, mid.Z),\n			Vector3.new(0.5, rise + 1.5, runLength),\n			{ color = Color3.fromRGB(226, 230, 238), yawDegrees = yaw }\n		)\n		stringer.CastShadow = false\n	end\n	return true\nend\n\n-- A guard rail along a line. Two posts and a top rail; the balusters are left out on\n-- purpose, because at the density a building needs them they cost hundreds of parts to say\n-- something the top rail has already said.\nfunction Kit.Railing(parent: Instance, name: string, from: Vector3, to: Vector3, height: number, color: Color3)\n	Kit.Wall(parent, `{name}Rail`, Vector3.new(from.X, from.Y + height, from.Z), Vector3.new(to.X, to.Y + height, to.Z), 0.35, 0.35, {\n		color = color,\n		material = Enum.Material.Metal,\n		collide = false,\n	})\n	Kit.Wall(parent, `{name}Panel`, from, to, height, 0.25, {\n		color = color,\n		material = Enum.Material.Glass,\n		transparency = 0.6,\n		collide = true,\n	})\nend\n\n-- A name over a thing, readable from across a room and no further.\nfunction Kit.Sign(part: BasePart, text: string, width: number, maxDistance: number, color: Color3): TextLabel\n	local gui = Instance.new(\"BillboardGui\")\n	gui.Name = \"Sign\"\n	gui.Adornee = part\n	gui.Size = UDim2.new(width, 0, width * 0.22, 0)\n	gui.StudsOffsetWorldSpace = Vector3.new(0, part.Size.Y / 2 + 1.6, 0)\n	gui.MaxDistance = maxDistance\n	gui.AlwaysOnTop = false\n	gui.Parent = part\n\n	local label = Instance.new(\"TextLabel\")\n	label.Name = \"Text\"\n	label.Size = UDim2.new(1, 0, 1, 0)\n	label.BackgroundTransparency = 1\n	label.Font = Enum.Font.GothamBold\n	label.TextScaled = true\n	label.TextColor3 = color\n	label.TextStrokeTransparency = 0.55\n	label.Text = text\n	label.Parent = gui\n	return label\nend\n\n-- A line of bunting between two points. Purely decorative and deliberately kept: it is the\n-- cheapest signal in the kit that a building is *used* rather than merely built, and the\n-- reference photographs are full of it.\nfunction Kit.Bunting(parent: Instance, name: string, from: Vector3, to: Vector3, flags: number, colors: { Color3 })\n	if #colors == 0 then\n		return\n	end\n	local delta = to - from\n	for index = 1, flags do\n		local share = (index - 0.5) / flags\n		-- A shallow sag, so the line hangs rather than being pulled taut between two nails.\n		local sag = math.sin(share * math.pi) * 1.4\n		local at = from + delta * share - Vector3.new(0, sag, 0)\n		local flag = Kit.Block(parent, `{name}{index}`, at, Vector3.new(1.4, 1.1, 0.08), {\n			color = colors[((index - 1) % #colors) + 1],\n			material = Enum.Material.Fabric,\n		})\n		flag.CastShadow = false\n	end\nend\n\n-- A balloon on a string. Two parts, and the string is the half that matters: a ball\n-- hanging in mid-air reads as a bug, and a ball with a line down to the floor reads as a\n-- party. It is the cheapest signal in the whole kit.\nfunction Kit.Balloon(parent: Instance, name: string, base: Vector3, height: number, color: Color3)\n	local ball = Instance.new(\"Part\")\n	ball.Name = `{name}Ball`\n	ball.Shape = Enum.PartType.Ball\n	ball.Size = Vector3.new(3.2, 3.8, 3.2)\n	ball.CFrame = CFrame.new(base + Vector3.new(0, height, 0))\n	ball.Anchored = true\n	ball.CanCollide = false\n	ball.Color = color\n	ball.Material = Enum.Material.SmoothPlastic\n	ball.CastShadow = false\n	ball.Parent = parent\n\n	Kit.Block(parent, `{name}String`, base + Vector3.new(0, height / 2, 0), Vector3.new(0.1, height, 0.1), {\n		color = Color3.fromRGB(238, 238, 242),\n	}).CastShadow = false\nend\n\n-- A bunch of them, fanned so no two are at the same height. Even heights read as a rack of\n-- balls; uneven ones read as balloons.\nfunction Kit.BalloonCluster(parent: Instance, name: string, base: Vector3, count: number, colors: { Color3 })\n	if #colors == 0 or count < 1 then\n		return\n	end\n	for index = 1, count do\n		local angle = (index / count) * math.pi * 2\n		local spread = 2.4\n		local at = base + Vector3.new(math.cos(angle) * spread, 0, math.sin(angle) * spread)\n		Kit.Balloon(parent, `{name}_{index}`, at, 9 + (index % 3) * 2.2, colors[((index - 1) % #colors) + 1])\n	end\nend\n\n-- An arch of them over a doorway. Odd counts put one balloon at the crown, which is what\n-- makes it read as an arch rather than as two columns.\nfunction Kit.BalloonArch(parent: Instance, name: string, center: Vector3, span: number, rise: number, count: number, colors: { Color3 })\n	if #colors == 0 or count < 3 then\n		return\n	end\n	for index = 1, count do\n		local share = (index - 1) / (count - 1)\n		local angle = math.pi * share\n		local at = center + Vector3.new(-math.cos(angle) * (span / 2), math.sin(angle) * rise, 0)\n		local ball = Instance.new(\"Part\")\n		ball.Name = `{name}{index}`\n		ball.Shape = Enum.PartType.Ball\n		ball.Size = Vector3.new(3.6, 4, 3.6)\n		ball.CFrame = CFrame.new(at)\n		ball.Anchored = true\n		ball.CanCollide = false\n		ball.Color = colors[((index - 1) % #colors) + 1]\n		ball.Material = Enum.Material.SmoothPlastic\n		ball.CastShadow = false\n		ball.Parent = parent\n	end\nend\n\n-- A streamer strung between two points, sagging in the middle. Same idea as Bunting but a\n-- continuous ribbon rather than flags, which is what a ceiling wants -- flags read as an\n-- outdoor fete and ribbons read as a hall somebody decorated.\nfunction Kit.Streamer(parent: Instance, name: string, from: Vector3, to: Vector3, segments: number, color: Color3)\n	local delta = to - from\n	for index = 1, segments do\n		local a = (index - 1) / segments\n		local b = index / segments\n		local pa = from + delta * a - Vector3.new(0, math.sin(a * math.pi) * 3.5, 0)\n		local pb = from + delta * b - Vector3.new(0, math.sin(b * math.pi) * 3.5, 0)\n		local seg = Kit.Wall(parent, `{name}{index}`, pa, pb, 0.45, 0.12, {\n			color = color,\n			material = Enum.Material.Fabric,\n			collide = false,\n		})\n		if seg ~= nil then\n			seg.CastShadow = false\n		end\n	end\nend\n\n-- A hanging pendant lamp: cord, shade, and a neon disc for the bulb.\n--\n-- Dozens of these rather than a few ceiling panels is most of the difference between a room\n-- that reads as a warehouse gym and one that reads as a school corridor, and it costs three\n-- parts each because the light itself is neon rather than a real PointLight -- sixty real\n-- lights in one room would cost more than the building.\nfunction Kit.Pendant(parent: Instance, name: string, ceiling: Vector3, drop: number, shadeColor: Color3)\n	Kit.Block(parent, `{name}Cord`, ceiling - Vector3.new(0, drop / 2, 0), Vector3.new(0.12, drop, 0.12), {\n		color = Color3.fromRGB(40, 42, 48),\n	}).CastShadow = false\n\n	Kit.Block(parent, `{name}Shade`, ceiling - Vector3.new(0, drop, 0), Vector3.new(2.6, 1.6, 2.6), {\n		color = shadeColor,\n		material = Enum.Material.Metal,\n	}).CastShadow = false\n\n	local bulb = Kit.Block(parent, `{name}Bulb`, ceiling - Vector3.new(0, drop + 0.9, 0), Vector3.new(2, 0.25, 2), {\n		color = Color3.fromRGB(255, 244, 214),\n		material = Enum.Material.Neon,\n	})\n	bulb.CastShadow = false\nend\n\n-- A coloured wash on the floor, for a room that is being lit for something. Flat, bright and\n-- non-collidable: it is a pool of light rather than an object, and anything the player can\n-- stand on would make the dance floor a step.\nfunction Kit.Spotlight(parent: Instance, name: string, at: Vector3, radius: number, color: Color3)\n	local pool = Kit.Rug(parent, name, at, radius, color)\n	pool.Material = Enum.Material.Neon\n	pool.Transparency = 0.55\n	return pool\nend\n\n-- A mirrored wall. High reflectance and a hair of transparency, which at Roblox's shading is\n-- what reads as glass with something behind it rather than as a grey panel.\nfunction Kit.Mirror(parent: Instance, name: string, from: Vector3, to: Vector3, height: number)\n	local pane = Kit.Wall(parent, name, from, to, height, 0.4, {\n		color = Color3.fromRGB(206, 216, 226),\n		material = Enum.Material.Glass,\n		transparency = 0.25,\n		reflectance = 0.75,\n		collide = true,\n	})\n	if pane ~= nil then\n		pane.CastShadow = false\n	end\n	return pane\nend\n\n-- A loaded barbell: the bar, and a stack of coloured plates at each end.\n--\n-- The plates are the whole point. A grey bar on a rack is a stick; competition plates are\n-- colour-coded by weight -- red, blue, yellow, green -- and a rack of them is instantly a\n-- gym. This is the single highest-value prop in the kit per part spent.\nfunction Kit.Barbell(parent: Instance, name: string, center: Vector3, length: number, plates: number)\n	Kit.Block(parent, `{name}Bar`, center, Vector3.new(length, 0.45, 0.45), {\n		color = Color3.fromRGB(196, 200, 206),\n		material = Enum.Material.Metal,\n	}).CastShadow = false\n\n	local plateColors = {\n		Color3.fromRGB(206, 66, 62),\n		Color3.fromRGB(56, 110, 196),\n		Color3.fromRGB(226, 194, 74),\n		Color3.fromRGB(86, 176, 108),\n	}\n	for side = -1, 1, 2 do\n		for index = 1, plates do\n			local offset = side * (length / 2 - 1.4 - (index - 1) * 0.9)\n			local plate = Instance.new(\"Part\")\n			plate.Name = `{name}Plate{side}_{index}`\n			plate.Shape = Enum.PartType.Cylinder\n			-- A Roblox cylinder runs along X, which is already the bar's axis, so a plate needs\n			-- no rotation at all -- unlike Rug, which has to be turned on its side.\n			plate.Size = Vector3.new(0.5, 3.6 - (index - 1) * 0.5, 3.6 - (index - 1) * 0.5)\n			plate.CFrame = CFrame.new(center + Vector3.new(offset, 0, 0))\n			plate.Anchored = true\n			plate.CanCollide = false\n			plate.Color = plateColors[((index - 1) % #plateColors) + 1]\n			plate.Material = Enum.Material.SmoothPlastic\n			plate.CastShadow = false\n			plate.Parent = parent\n		end\n	end\nend\n\nreturn Kit\n"
table.insert(AGES_MANIFEST, "src/server/world/Kit.luau")
AGES_SOURCES["src/server/world/Lab.luau"] = "--!strict\n-- The science lab, as a room that exists.\n--\n-- Everything about the Science verb is a journey between things, so the things have to\n-- be somewhere. This puts them there: a board on one side, a supply cupboard directly\n-- opposite it, the benches on the cross axis between the two, and the stations ringing\n-- the outside further out than any of them. That arrangement is the mechanic in\n-- physical form -- see the note on Config.School.Science.Build for why each fraction is\n-- what it is -- and it is the reason the room is laid out here rather than being tagged\n-- part by part in Studio: the distances between these five kinds of thing are load\n-- bearing, and a builder nudging a bench should not be able to quietly delete the walk\n-- that makes committing early a decision.\n--\n-- Split from ScienceService for the reason WorkSpots was split from WorkService: where\n-- a thing can stand and what happens when you reach it are different questions, and\n-- re-laying the room should never be able to touch the scoring.\n--\n-- Built once, shared, and never taken down. Two players in the lab stand in one room --\n-- the same way two players sit in one classroom -- because the furniture is a thing\n-- anybody walking past can see, and it is only what is *written* on it that is\n-- addressed to one person. The stack on a bench and the list on the board are pushed\n-- per player and drawn by their own client; nothing about a procedure is in the world.\n-- That is the rule Remotes.luau states, applied to a room instead of a sign.\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Config = require(ReplicatedStorage:WaitForChild(\"Config\"))\nlocal Types = require(ReplicatedStorage:WaitForChild(\"Types\"))\nlocal Interact = require(ReplicatedStorage:WaitForChild(\"world\"):WaitForChild(\"Interact\"))\nlocal Stations = require(ReplicatedStorage:WaitForChild(\"world\"):WaitForChild(\"Stations\"))\n\nlocal Ground = require(script.Parent.Ground)\n\ntype Procedure = Types.Procedure\n\nlocal Lab = {}\n\nlocal SCIENCE = Config.School.Science\nlocal BUILD = SCIENCE.Build\n\n-- What a built lab hands back. Positions rather than parts, because everything the\n-- service does with the room is a distance test -- the parts themselves are the\n-- client's business and the builder's, not the loop's.\nexport type LabRoom = {\n	center: Vector3,\n	board: Vector3,\n	cupboard: Vector3,\n	-- Indexed the way BenchState.index is, so bench 2 here and bench 2 on screen are the\n	-- same piece of furniture without anything having to map between them.\n	benches: { Vector3 },\n	-- Where each station ended up. A station that the floor refused is simply absent,\n	-- and callers must treat absence as \"this procedure cannot be run\" and say so by\n	-- name rather than offering a procedure with an unreachable step in it.\n	stations: { [string]: Vector3 },\n}\n\n-- The room, once it exists. Nil until Build succeeds; the whole module is a\n-- build-once, because a lab that re-laid itself would move a station out from under a\n-- player who was walking to it.\nlocal room: LabRoom? = nil\nlocal folder: Folder? = nil\n\n-- Stations the floor refused, kept so the refusal can name them. A warning at build\n-- time scrolls past; a player told \"the lab is missing its balance\" can go and look.\nlocal missing: { string } = {}\n\n-- Everything the lab puts in the world lives in one folder, so a Studio session can see\n-- at a glance what is standing and clear the lot if a test left something behind. The\n-- same arrangement school makes for its pads, and separate from it because these two\n-- get cleared for different reasons.\nlocal function labFolder(): Folder\n	local existing = folder\n	if existing ~= nil and existing.Parent ~= nil then\n		return existing\n	end\n	local made = Instance.new(\"Folder\")\n	made.Name = \"ScienceLab\"\n	made.Parent = workspace\n	folder = made\n	return made\nend\n\n-- A point on the room's circle. Bearing is degrees clockwise from world forward, which\n-- is the same convention Ground.Bearings uses, so a layout number here and a scatter\n-- there mean the same thing.\nlocal function onCircle(center: Vector3, bearing: number, share: number): Vector3\n	local direction = CFrame.Angles(0, math.rad(bearing), 0) * Vector3.new(0, 0, -1)\n	return center + direction * (SCIENCE.RoomRadiusStuds * share)\nend\n\n-- One piece of placeholder furniture. Anchored and non-collidable: a player who has to\n-- walk round a bench to reach a station is being charged for the room twice, and the\n-- whole point of the layout is that the *distances* cost something rather than the\n-- geometry.\nlocal function buildBlock(name: string, at: Vector3, size: Vector3, color: Color3): BasePart\n	local part = Instance.new(\"Part\")\n	part.Name = name\n	part.Size = size\n	-- Sat on the floor rather than centred on it, so a six-stud cupboard is six studs\n	-- tall standing up instead of three studs of it being underground.\n	part.CFrame = CFrame.new(at + Vector3.new(0, size.Y / 2, 0))\n	part.Anchored = true\n	part.CanCollide = false\n	part.Color = color\n	part.Material = Enum.Material.SmoothPlastic\n	part.TopSurface = Enum.SurfaceType.Smooth\n	part.BottomSurface = Enum.SurfaceType.Smooth\n	part.Parent = labFolder()\n	return part\nend\n\n-- The name over a piece of furniture. Built in the world rather than pushed, because\n-- what a station *is* is true for everybody in the room -- it is only what the\n-- procedure wants from it that is addressed to one player.\nlocal function buildLabel(part: BasePart, text: string)\n	local sign = Instance.new(\"BillboardGui\")\n	sign.Name = \"Label\"\n	sign.Adornee = part\n	sign.Size = UDim2.new(5, 0, 1.1, 0)\n	sign.StudsOffsetWorldSpace = Vector3.new(0, part.Size.Y / 2 + 1.2, 0)\n	sign.MaxDistance = BUILD.LabelMaxDistanceStuds\n	sign.AlwaysOnTop = true\n	sign.Parent = part\n\n	local label = Instance.new(\"TextLabel\")\n	label.Name = \"Text\"\n	label.Size = UDim2.new(1, 0, 1, 0)\n	label.BackgroundTransparency = 1\n	label.Font = Enum.Font.GothamMedium\n	label.TextScaled = true\n	label.TextColor3 = Color3.fromRGB(248, 246, 240)\n	label.TextStrokeTransparency = 0.4\n	label.Text = text\n	label.Parent = sign\nend\n\n-- Somewhere a station can stand: on the ring first, then nudged outward a ring at a\n-- time. Nil means the floor refused it everywhere tried, which the caller records by\n-- name rather than swallowing -- a station that is not in the room is a step that\n-- cannot be taken, and a procedure with one of those in it is unfinishable.\nlocal function stationSpot(center: Vector3, bearing: number, ignore: { Instance }, taken: { Vector3 }): Vector3?\n	local size = BUILD.StationSize\n	-- Probed as a body would be, because a station the player cannot get to the side of\n	-- is a station they cannot click. The gap wanted is its own width plus room to stand.\n	local radius = math.max(size.X, size.Z) / 2 + SCIENCE.StationRadiusStuds\n	for retry = 0, BUILD.StationRetries do\n		local share = BUILD.StationDistanceShare + BUILD.StationRetryShare * retry\n		local candidate = onCircle(center, bearing, share)\n		local floor = Ground.SpotAt(candidate, radius, size.Y, ignore, center)\n		if floor == nil then\n			continue\n		end\n		-- Two stations within reach of each other is one station as far as the player's\n		-- clicking is concerned, and it would make the wrong one answer for the right one.\n		if not Ground.Apart(floor, taken, SCIENCE.StationRadiusStuds * 2 + 1) then\n			continue\n		end\n		return floor\n	end\n	return nil\nend\n\n-- Builds the room around a centre point, once. Returns nil if the lab could not be\n-- laid at all, which is a different failure from a station or two going missing and is\n-- reported differently: no room means no Science anywhere, and the caller refuses at\n-- the door.\nfunction Lab.Build(center: Vector3): LabRoom?\n	local existing = room\n	if existing ~= nil then\n		return existing\n	end\n\n	local ignore = Ground.IgnoreList()\n\n	local board = onCircle(center, BUILD.BoardBearing, BUILD.BoardDistanceShare)\n	local cupboard = onCircle(center, BUILD.CupboardBearing, BUILD.CupboardDistanceShare)\n\n	local boardPart = buildBlock(\"Board\", board, BUILD.BoardSize, Color3.fromRGB(48, 58, 52))\n	buildLabel(boardPart, \"Procedure\")\n\n	local cupboardPart = buildBlock(\"Cupboard\", cupboard, BUILD.CupboardSize, Color3.fromRGB(150, 128, 96))\n	buildLabel(cupboardPart, \"Supplies\")\n\n	local benches: { Vector3 } = {}\n	for index = 1, SCIENCE.Benches do\n		local bearing = BUILD.FirstBenchBearing + BUILD.BenchBearingStep * (index - 1)\n		local at = onCircle(center, bearing, BUILD.BenchDistanceShare)\n		local part = buildBlock(`Bench{index}`, at, BUILD.BenchSize, Color3.fromRGB(96, 104, 118))\n		buildLabel(part, `Bench {index}`)\n		table.insert(benches, at)\n	end\n\n	-- Every station that any procedure names, laid in one even ring. All of them rather\n	-- than only the ones this player's mastery has unlocked: the room is shared, built\n	-- once, and cannot be re-laid per player -- so escalation is which stations a\n	-- *procedure* uses, not which ones are standing. A player at mastery one walks past\n	-- five stations they will not touch today, which is the correct thing for a school\n	-- lab to look like anyway.\n	local all = Stations.All\n	local bearings = Ground.Bearings(360, #all)\n	local stations: { [string]: Vector3 } = {}\n	local taken: { Vector3 } = {}\n	table.clear(missing)\n\n	for index, station in all do\n		local spot = stationSpot(center, bearings[index], ignore, taken)\n		if spot == nil then\n			table.insert(missing, station.id)\n			continue\n		end\n		table.insert(taken, spot)\n		stations[station.id] = spot\n\n		local part = buildBlock(`Station_{station.id}`, spot, BUILD.StationSize, station.color)\n		buildLabel(part, station.name)\n\n		-- The three dots. A station is a thing in the room you go to, which is exactly\n		-- what dots mean -- and it carries no price and opens no menu, because clicking\n		-- it *is* the answer. What it does to your procedure is written on the board\n		-- across the room, which is the whole verb.\n		--\n		-- Attached lit, and then turned down per player by the client -- see\n		-- client/world/LabDots.luau. It has to be done at that end: the lab is one room\n		-- shared by everybody in the school, so the server cannot dim a beaker for the\n		-- player with no lesson on without dimming it for the one who has.\n		--\n		-- Which leaves the *name* doing the work in between, and that is the reason this\n		-- reads as a room rather than as furniture appearing around you. The label built\n		-- on the line above is part of the fixture and never goes anywhere, so a lab out\n		-- of hours is still a legible room full of named equipment. It simply stops\n		-- promising that any of it can be used -- which is what three dots mean, and the\n		-- only thing they mean.\n		Interact.Attach(part, {\n			kind = \"Station\",\n			id = station.id,\n			actionText = \"Use\",\n			objectText = station.name,\n		})\n	end\n\n	local built: LabRoom = {\n		center = center,\n		board = board,\n		cupboard = cupboard,\n		benches = benches,\n		stations = stations,\n	}\n	room = built\n	return built\nend\n\n-- The room, or nil if nothing has built it yet. Never builds as a side effect: the\n-- caller that owns the place point is the one that decides the lab exists.\nfunction Lab.Room(): LabRoom?\n	return room\nend\n\n-- Station ids the floor refused, so a refusal can name them. Empty on a good build,\n-- which is the case worth optimising the sentence for.\nfunction Lab.Missing(): { string }\n	return missing\nend\n\n-- Whether every station a procedure needs is actually standing. Asked before a\n-- procedure is handed out rather than discovered part way through it: a player four\n-- steps into a procedure whose fifth station does not exist has lost the run to a build\n-- error, and no amount of soft failure makes that fair.\nfunction Lab.CanRun(procedure: Procedure): (boolean, string?)\n	local built = room\n	if built == nil then\n		return false, \"the lab has not been built yet\"\n	end\n	for _, step in procedure.steps do\n		if built.stations[step.station] == nil then\n			return false, `the lab has no {Stations.NameOf(step.station)} standing in it`\n		end\n	end\n	return true, nil\nend\n\nreturn Lab\n"
table.insert(AGES_MANIFEST, "src/server/world/Lab.luau")
AGES_SOURCES["src/server/world/MoneyPop.luau"] = "--!strict\n-- A number leaving the world. When money moves, the amount floats up off the spot\n-- it came from and fades out.\n--\n-- It exists because money has started arriving unasked. Everything that paid out\n-- before this was the answer to a prompt the player was already reading, so a\n-- balance moving needed no explanation -- they had just clicked the thing that\n-- moved it. Pocket money lands on a birthday with nothing else on screen, and a\n-- balance that changes in silence is the one thing an economy cannot do: the player\n-- either misses it entirely or notices later and has no way to find out why.\n--\n-- In the room rather than on the HUD, which is the whole rule the game is built on.\n-- A toast in the corner would be a small piece of UI announcing something that\n-- happened three feet in front of the player, and the point of putting it in the\n-- world is that it can be attached to whoever handed it over -- a parent's hands\n-- when one crossed the room, and the player's own head when nobody could, which is\n-- the visible difference between the two.\n--\n-- Cosmetic through and through, so every dimension below is a local rather than a\n-- Config entry, on the same rule ChoiceMarkers and DeliveryPresenters follow:\n-- nobody balances this game by adjusting how far a number drifts before it fades.\n\nlocal Debris = game:GetService(\"Debris\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal TweenService = game:GetService(\"TweenService\")\n\nlocal Money = require(ReplicatedStorage:WaitForChild(\"Money\"))\n\nlocal MoneyPop = {}\n\n-- One folder for all of them, so a leak shows up as a fat folder in the explorer\n-- rather than as debris scattered through the house.\nlocal POPS_FOLDER = \"AgesMoneyPops\"\n\n-- How far it drifts and how long it lives. Slow enough to read a four-figure sum,\n-- short enough that two payments close together do not stack up into a column.\nlocal RISE_STUDS = 2.4\nlocal HOLD_SECONDS = 0.5\nlocal FADE_SECONDS = 1.1\n-- Derived so the drift and the fade finish together: a number that stops moving and\n-- then hangs there fading reads as a UI element that got stuck.\nlocal LIFE_SECONDS = HOLD_SECONDS + FADE_SECONDS\n\n-- The same gold the price line on a choice marker is written in. Money has one\n-- color in this game and it was set there; a second one here would be a second\n-- currency as far as the player is concerned. Direction is carried by the sign in\n-- front of the figure, which is what will keep a payment and a purchase legible\n-- when there is something to buy.\nlocal AMOUNT_COLOR = Color3.fromRGB(245, 218, 150)\nlocal AMOUNT_STROKE = Color3.fromRGB(20, 18, 14)\nlocal AMOUNT_TEXT_SIZE = 22\nlocal AMOUNT_STROKE_THICKNESS = 2\n\nlocal LABEL_WIDTH_STUDS = 8\nlocal LABEL_HEIGHT_STUDS = 1.4\n-- Past this it is an unreadable smudge on the far side of the house. Well inside\n-- a choice label's range, because this one is about something that happened where\n-- the player already is.\nlocal LABEL_MAX_DISTANCE = 45\n\nlocal function popsFolder(): Folder\n	local existing = workspace:FindFirstChild(POPS_FOLDER)\n	if existing ~= nil then\n		return existing :: Folder\n	end\n	local folder = Instance.new(\"Folder\")\n	folder.Name = POPS_FOLDER\n	folder.Parent = workspace\n	return folder\nend\n\n-- Floats an amount up from a point in the world.\n--\n-- The sign is read off the amount rather than passed in, so the one function is\n-- already right for money going out -- and a zero shows nothing at all, because\n-- \"you have been paid nothing\" is a sentence no player should ever be shown.\nfunction MoneyPop.Show(at: Vector3, amount: number)\n	local whole = math.floor(math.abs(amount))\n	if whole == 0 then\n		return\n	end\n	local sign = if amount < 0 then \"-\" else \"+\"\n\n	-- An anchor part rather than a bare BillboardGui, because a gui needs something\n	-- to adorn and tweening the part is what carries the drift. Invisible, and deaf\n	-- to everything: it must never catch a raycast meant for the floor it is\n	-- standing over, and it must never be something a toddler can trip on.\n	local anchor = Instance.new(\"Part\")\n	anchor.Name = \"MoneyPop\"\n	anchor.Size = Vector3.new(0.1, 0.1, 0.1)\n	anchor.Transparency = 1\n	anchor.Anchored = true\n	anchor.CanCollide = false\n	anchor.CanQuery = false\n	anchor.CanTouch = false\n	anchor.CastShadow = false\n	anchor.CFrame = CFrame.new(at)\n	anchor.Parent = popsFolder()\n\n	local billboard = Instance.new(\"BillboardGui\")\n	billboard.Name = \"Amount\"\n	billboard.Size = UDim2.new(LABEL_WIDTH_STUDS, 0, LABEL_HEIGHT_STUDS, 0)\n	-- Drawn through whatever it is standing behind, for the reason a choice label is:\n	-- the moment this most needs to be readable is the moment the player is behind\n	-- the sofa and does not know why their balance moved.\n	billboard.AlwaysOnTop = true\n	billboard.MaxDistance = LABEL_MAX_DISTANCE\n	billboard.Parent = anchor\n\n	local text = Instance.new(\"TextLabel\")\n	text.Name = \"Text\"\n	text.Size = UDim2.fromScale(1, 1)\n	text.BackgroundTransparency = 1\n	text.Font = Enum.Font.GothamBold\n	text.TextSize = AMOUNT_TEXT_SIZE\n	text.TextColor3 = AMOUNT_COLOR\n	text.Text = `{sign}{Money.Format(whole)}`\n	text.Parent = billboard\n\n	local stroke = Instance.new(\"UIStroke\")\n	stroke.Color = AMOUNT_STROKE\n	stroke.Thickness = AMOUNT_STROKE_THICKNESS\n	stroke.Parent = text\n\n	local rise = TweenService:Create(\n		anchor,\n		TweenInfo.new(LIFE_SECONDS, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),\n		{ CFrame = anchor.CFrame + Vector3.new(0, RISE_STUDS, 0) }\n	)\n	-- Held solid before it starts going, so the figure is legible at full contrast\n	-- for long enough to actually be read. The delay is the tween's own rather than a\n	-- task.delay, so nothing has to survive the part being destroyed under it.\n	local fade = TweenInfo.new(FADE_SECONDS, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, 0, false, HOLD_SECONDS)\n	local fadeText = TweenService:Create(text, fade, { TextTransparency = 1 })\n	local fadeStroke = TweenService:Create(stroke, fade, { Transparency = 1 })\n\n	rise:Play()\n	fadeText:Play()\n	fadeStroke:Play()\n\n	-- Debris rather than a task.delay, so a server shutting down mid-flight does not\n	-- leave a thread holding a destroyed part. Nothing cancels the tweens: they die\n	-- with the instances they are running on, which happens here and only here.\n	Debris:AddItem(anchor, LIFE_SECONDS)\nend\n\n-- Clears any still in flight. Used at server start, where a Rojo sync mid-session\n-- can otherwise leave numbers hanging in the air with nothing left to remove them.\nfunction MoneyPop.ClearAll()\n	local folder = workspace:FindFirstChild(POPS_FOLDER)\n	if folder ~= nil then\n		folder:ClearAllChildren()\n	end\nend\n\nreturn MoneyPop\n"
table.insert(AGES_MANIFEST, "src/server/world/MoneyPop.luau")
AGES_SOURCES["src/server/world/MusicRoom.luau"] = "--!strict\n-- The music room, as a room that exists.\n--\n-- One thing in it: the stand you play at. Unlike the lab, the studio and the reading room,\n-- nothing here is a destination you walk between mid-lesson -- the whole piece happens where\n-- you are standing, because a rhythm you have to walk across a room to keep is not a rhythm.\n--\n-- So the room is deliberately the thinnest of the four. The four lane posts are there to\n-- say which lane is which *in the world* rather than only on the panel, which is the same\n-- reason the lab has a board on a wall: a player should be able to look up from the screen\n-- and still know where they are.\n--\n-- Split from MusicService for the reason Lab is split from ScienceService: where a thing\n-- stands and what happens when you reach it are different questions.\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Config = require(ReplicatedStorage:WaitForChild(\"Config\"))\n\nlocal Kit = require(script.Parent.Kit)\n\nlocal MusicRoom = {}\n\nlocal MUSIC = Config.School.Music\nlocal BUILD = MUSIC.Build\n\nexport type Room = {\n	center: Vector3,\n	stand: Vector3,\n}\n\nlocal room: Room? = nil\nlocal folder: Folder? = nil\n\nlocal function roomFolder(): Folder\n	local existing = folder\n	if existing ~= nil and existing.Parent ~= nil then\n		return existing\n	end\n	local made = Instance.new(\"Folder\")\n	made.Name = \"MusicRoom\"\n	made.Parent = workspace\n	folder = made\n	return made\nend\n\nlocal function onCircle(center: Vector3, bearing: number, share: number): Vector3\n	local direction = CFrame.Angles(0, math.rad(bearing), 0) * Vector3.new(0, 0, -1)\n	return center + direction * (BUILD.RoomRadiusStuds * share)\nend\n\n-- Builds the room around a centre point, once. Nil means it could not be laid, which the\n-- caller turns into Music refusing at the door with a reason.\nfunction MusicRoom.Build(center: Vector3): Room?\n	local existing = room\n	if existing ~= nil then\n		return existing\n	end\n\n	local parent = roomFolder()\n	local standAt = onCircle(center, BUILD.StandBearing, BUILD.StandDistanceShare)\n\n	local stand = Kit.Block(parent, \"MusicStand\", standAt + Vector3.new(0, 2.2, 0), Vector3.new(7, 4.4, 2.4), {\n		color = Color3.fromRGB(52, 56, 68),\n	})\n	Kit.Sign(stand, \"Stand here\", 8, BUILD.LabelMaxDistanceStuds, Color3.fromRGB(244, 246, 250))\n\n	-- One post per lane, in front of the stand and spread across it, so the lanes exist in the\n	-- room and not only in the panel. Coloured left to right in the same order the panel draws\n	-- them, which is the whole of what makes them worth building.\n	local colors = {\n		Color3.fromRGB(232, 106, 118),\n		Color3.fromRGB(238, 190, 96),\n		Color3.fromRGB(108, 196, 142),\n		Color3.fromRGB(104, 158, 232),\n	}\n	for lane = 1, MUSIC.Lanes do\n		local offset = (lane - (MUSIC.Lanes + 1) / 2) * 5\n		local post = Kit.Block(parent, `Lane{lane}`, standAt + Vector3.new(offset, 5, -7), Vector3.new(3.4, 10, 1.2), {\n			color = colors[((lane - 1) % #colors) + 1],\n			material = Enum.Material.Neon,\n		})\n		post.CastShadow = false\n	end\n\n	local built: Room = { center = center, stand = standAt }\n	room = built\n	return built\nend\n\nfunction MusicRoom.Room(): Room?\n	return room\nend\n\nfunction MusicRoom.Clear()\n	local existing = folder\n	if existing ~= nil then\n		existing:Destroy()\n	end\n	folder = nil\n	room = nil\nend\n\nreturn MusicRoom\n"
table.insert(AGES_MANIFEST, "src/server/world/MusicRoom.luau")
AGES_SOURCES["src/server/world/PropModels.luau"] = "--!strict\n-- What a prop looks like when it is standing in the room.\n--\n-- The same split, for the same reason, as SubjectModels/SceneService: this decides\n-- what turns up and PropService decides where it goes and what doing something to\n-- it means. Replacing every one of these with a bought model must not touch a line\n-- of the placement math, and retuning how far a rug slides must not touch its\n-- geometry.\n--\n-- Two sources, in the order they are tried, and the order matches SubjectModels\n-- exactly so there is one rule to remember:\n--\n--   A real Model named after the prop id, inside the ServerStorage folder\n--   Config.World.PropFolder names. Drop in a Model called \"rug\" and nothing in\n--   code moves.\n--\n--   Otherwise a shape built from the prop's own dimensions.\n--\n-- Unlike a subject, a prop has no rig and nothing to animate. It is one solid thing\n-- that gets slid around, so what comes back is a Model with a PrimaryPart and no\n-- limbs -- and a rug being pushed is that Model being moved, not a gait.\n--\n-- Anchored throughout and never collidable, which is the rule that took the longest\n-- to arrive at. The temptation with a pushable rug is to let the physics engine do\n-- it: make it unanchored, walk into it, watch it slide. That produces a rug that can\n-- be shoved through a wall, tipped on its side, launched by a player who jumps on\n-- it, and left in a place the next event then tries to stage a cookie inside. A prop\n-- that moves only when this game says it moves is not a limitation, it is the\n-- feature -- and it costs one lerp.\n--\n-- CanQuery off for the same reason SubjectModels turns it off: a prop that answered\n-- floor and clearance probes would be reported as furniture by Ground, including by\n-- the probes that run while it is still standing there deciding where its own\n-- neighbours go.\n\nlocal ServerStorage = game:GetService(\"ServerStorage\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Config = require(ReplicatedStorage:WaitForChild(\"Config\"))\nlocal Types = require(ReplicatedStorage:WaitForChild(\"Types\"))\n\ntype PropKind = Types.PropKind\n\nlocal PropModels = {}\n\n-- The root is a marker rather than a body, exactly as it is on a subject: it exists\n-- so the model's pivot sits at the centre of the prop's footprint on the floor,\n-- which is what lets a caller place it with one PivotTo onto a point the floor probe\n-- returned.\nlocal ROOT_SIZE = Vector3.new(0.2, 0.2, 0.2)\n\n-- A figure is a body and a head and that is all. Proportions rather than sizes, so\n-- the same two numbers make a toddler and a ten-year-old out of one authored height.\n-- Kept here rather than in Config for the reason SubjectModels gives: what fraction\n-- of a child is head is not a number anybody balances a life simulator with.\nlocal FIGURE_HEAD_FRACTION = 0.3 -- of total height; children are top-heavy and should look it\nlocal FIGURE_BODY_TAPER = 0.82 -- body width as a fraction of the declared width\n\nlocal function newPart(model: Model, name: string, size: Vector3, at: CFrame, color: Color3): Part\n	local part = Instance.new(\"Part\")\n	part.Name = name\n	part.Size = size\n	part.CFrame = at\n	part.Color = color\n	part.Material = Enum.Material.SmoothPlastic\n	part.Anchored = true\n	part.CanCollide = false\n	part.CanQuery = false\n	part.CanTouch = false\n	part.Parent = model\n	return part\nend\n\n-- Everything is built with its footprint centred on the origin and its underside at\n-- y = 0, so a caller places it by pivoting the model onto the floor point and adding\n-- the prop's own lift. Nothing here knows where in the house it is going.\nlocal function buildShape(model: Model, prop: PropKind)\n	local size = prop.size\n\n	if prop.shape == \"Ball\" then\n		local ball = newPart(model, \"Prop\", size, CFrame.new(0, size.Y / 2, 0), prop.color)\n		ball.Shape = Enum.PartType.Ball\n		return\n	end\n\n	if prop.shape == \"Cylinder\" then\n		-- A Roblox cylinder's circular face is in its local YZ plane and its axis is\n		-- local X, so a disc lying flat on the floor is one rotated a quarter turn\n		-- about Z. That rotation maps local X to world Y, so the part is built with\n		-- its authored height in X and its authored width in Y and comes out the\n		-- right way up with the right footprint. Easy to get backwards, and when it\n		-- is backwards the plate stands on its edge like a wheel.\n		local disc = newPart(\n			model,\n			\"Prop\",\n			Vector3.new(size.Y, size.X, size.Z),\n			CFrame.new(0, size.Y / 2, 0) * CFrame.Angles(0, 0, math.rad(90)),\n			prop.color\n		)\n		disc.Shape = Enum.PartType.Cylinder\n		return\n	end\n\n	if prop.shape == \"Figure\" then\n		local headSize = size.Y * FIGURE_HEAD_FRACTION\n		local bodyHeight = size.Y - headSize\n		newPart(\n			model,\n			\"Body\",\n			Vector3.new(size.X * FIGURE_BODY_TAPER, bodyHeight, size.Z),\n			CFrame.new(0, bodyHeight / 2, 0),\n			prop.color\n		)\n		-- The head takes the accent color, which on a figure is a skin tone rather\n		-- than a trim. That is the whole difference between a person and a bollard.\n		local head = newPart(\n			model,\n			\"Head\",\n			Vector3.new(headSize, headSize, headSize),\n			CFrame.new(0, bodyHeight + headSize / 2, 0),\n			prop.accentColor\n		)\n		head.Shape = Enum.PartType.Ball\n		return\n	end\n\n	-- Block. Two parts rather than one: a slab in the main color with a thin border\n	-- of the accent standing just proud of its edges. One extra part, and it is the\n	-- difference between a rug and a brown rectangle on the carpet -- at this\n	-- fidelity an edge is what tells the eye an object is an object.\n	newPart(model, \"Prop\", size, CFrame.new(0, size.Y / 2, 0), prop.color)\n	local trimInset = math.min(size.X, size.Z) * 0.12\n	newPart(\n		model,\n		\"Trim\",\n		Vector3.new(size.X - trimInset, size.Y * 0.6, size.Z - trimInset),\n		CFrame.new(0, size.Y * 0.8, 0),\n		prop.accentColor\n	)\nend\n\nlocal function authoredModel(propId: string): Model?\n	local folder = ServerStorage:FindFirstChild(Config.World.PropFolder)\n	if folder == nil then\n		return nil\n	end\n	local found = folder:FindFirstChild(propId)\n	if found == nil then\n		return nil\n	end\n	if not found:IsA(\"Model\") then\n		warn(`[AGES] \"{propId}\" in {Config.World.PropFolder} is a {found.ClassName}, not a Model; using the placeholder`)\n		return nil\n	end\n	return found\nend\n\n-- A hand-made model has its own idea of where its origin is, and it is rarely the\n-- middle of its own footprint. Rather than asking whoever drops one in to get that\n-- right, a root is added at the centre of the bottom of its bounding box -- so an\n-- adopted rug places identically to a built one and PropService never learns which\n-- it got.\nlocal function adoptModel(source: Model, propId: string): Model?\n	local model = source:Clone()\n\n	local ok, boxCFrame, boxSize = pcall(function()\n		return model:GetBoundingBox()\n	end)\n	if not ok or boxCFrame == nil or boxSize == nil then\n		warn(`[AGES] prop model \"{propId}\" has no parts to measure; using the placeholder instead`)\n		model:Destroy()\n		return nil\n	end\n\n	for _, descendant in model:GetDescendants() do\n		if descendant:IsA(\"BasePart\") then\n			descendant.Anchored = true\n			descendant.CanCollide = false\n			descendant.CanQuery = false\n			descendant.CanTouch = false\n		end\n	end\n\n	local root = Instance.new(\"Part\")\n	root.Name = \"PropRoot\"\n	root.Size = ROOT_SIZE\n	root.CFrame =\n		CFrame.new(Vector3.new(boxCFrame.Position.X, boxCFrame.Position.Y - boxSize.Y / 2, boxCFrame.Position.Z))\n	root.Transparency = 1\n	root.Anchored = true\n	root.CanCollide = false\n	root.CanQuery = false\n	root.CanTouch = false\n	root.CastShadow = false\n	root.Parent = model\n	model.PrimaryPart = root\n\n	return model\nend\n\n-- Builds the prop, unparented and unplaced, with its pivot at the centre of its\n-- underside. The caller pivots it onto a floor point and lifts it by the prop's own\n-- liftStuds.\nfunction PropModels.Build(prop: PropKind): Model\n	local authored = authoredModel(prop.id)\n	if authored ~= nil then\n		local adopted = adoptModel(authored, prop.id)\n		if adopted ~= nil then\n			adopted.Name = `Prop_{prop.id}`\n			return adopted\n		end\n	end\n\n	local model = Instance.new(\"Model\")\n	buildShape(model, prop)\n\n	local root = newPart(model, \"PropRoot\", ROOT_SIZE, CFrame.new(0, 0, 0), prop.color)\n	root.Transparency = 1\n	root.CastShadow = false\n	model.PrimaryPart = root\n\n	model.Name = `Prop_{prop.id}`\n	return model\nend\n\nreturn PropModels\n"
table.insert(AGES_MANIFEST, "src/server/world/PropModels.luau")
AGES_SOURCES["src/server/world/ProperSchool/Exterior.luau"] = "--!strict\n-- The exterior shell of the new school: three storeys, flat roof, glazed entrance bay.\n--\n-- **Everything here is derived from PLAN.** Not one coordinate below is written down twice, and\n-- none is a literal that means something. That is not tidiness for its own sake -- the last\n-- school was rebuilt six times because a number like \"the corridor is at z 53\" was true in one\n-- function and false in another after a change, and every one of those bugs was invisible until\n-- somebody walked into it. If a dimension moves here, everything that depends on it moves.\n\nlocal Engine = require(script.Parent.SchoolBuilderEngine)\nlocal Layout = require(script.Parent.Layout)\nlocal Tree = require(script.Parent.Tree)\n\nlocal Exterior = {}\n\n-- ---------------------------------------------------------------------------------------\n-- The plan\n-- ---------------------------------------------------------------------------------------\n\nlocal PLAN = {\n	WidthStuds = 200, -- along X, the frontage\n	DepthStuds = 120, -- along Z, front wall to back wall\n	FloorHeightStuds = 20,\n	Floors = 3,\n	WallThicknessStuds = 2,\n\n	-- The entrance bay: the whole centre of the front elevation, two storeys of it.\n	EntranceBayStuds = 40,\n	EntranceRecessStuds = 6, -- how far the doors sit back from the facade\n	CurtainWidthStuds = 30,\n	CurtainHeightStuds = 20,\n	DoorWidthStuds = 16, -- the pair together\n	DoorHeightStuds = 13,\n\n	-- Classroom glazing. One window per bay, and the bay count is what makes the rhythm read\n	-- as regular from outside -- see the note on windowedRun.\n	WindowWidthStuds = 12,\n	WindowHeightStuds = 10,\n	BaysLongWall = 8, -- across the 200-stud back\n	BaysShortWall = 5, -- along each 120-stud flank\n\n	ParapetHeightStuds = 2,\n	ParapetThicknessStuds = 1.5,\n	-- Two, not three. The base course wraps the wall rather than standing in front of it, so it\n	-- and the ground-floor sill band share the same studs -- at three it swallowed two thirds of\n	-- that sill. A base course is meant to be read as the bottom edge of the wall, not as the\n	-- bottom storey of it.\n	PlinthHeightStuds = 2,\n}\n\n-- **School v1's palette, because v1's exterior worked and this one did not.**\n--\n-- Cool gray and dark slate is a perfectly good scheme and it made a dull building, for a\n-- reason worth writing down: grey on grey has no figure. The eye needs one colour doing the\n-- describing, and the pale field has to be near-white for the accent to read as an accent\n-- rather than as the other half of a two-tone stripe.\n--\n-- So: white walls, and the school's blue on everything that marks a piece of structure -- base\n-- course, the band at every floor line, the parapet, the entrance frame. The blue is never\n-- decoration; it is always showing you where a floor is.\nlocal WHITE = Color3.fromRGB(242, 243, 246)\nlocal OFF_WHITE = Color3.fromRGB(228, 230, 235)\nlocal BLUE = Color3.fromRGB(58, 122, 206)\nlocal DEEP_BLUE = Color3.fromRGB(36, 84, 158)\nlocal GLASS_TINT = Color3.fromRGB(196, 220, 240)\nlocal DOOR_TIMBER = Color3.fromRGB(112, 78, 52)\n\n-- Kept under their old names so the rest of the file did not need rewriting to change colour.\nlocal COOL_GRAY = WHITE\nlocal DARK_SLATE = BLUE\n\nlocal WALL_MATERIAL = Enum.Material.SmoothPlastic\nlocal TRIM_MATERIAL = Enum.Material.SmoothPlastic\n\n-- How much of a storey is glass, and how far apart the uprights that divide it go. Both lifted\n-- from v1: 18 studs is about a door and a half, which is the spacing at which a glazed wall\n-- stops reading as one enormous window and starts reading as a building with floors in it.\nlocal GLASS_SHARE = 0.55\nlocal MULLION_SPACING = 18\n\n-- ---------------------------------------------------------------------------------------\n-- Derived\n-- ---------------------------------------------------------------------------------------\n\nlocal W = PLAN.WidthStuds\nlocal D = PLAN.DepthStuds\nlocal FH = PLAN.FloorHeightStuds\nlocal T = PLAN.WallThicknessStuds\nlocal TOTAL_H = FH * PLAN.Floors\n\nlocal HALF_W = W / 2\nlocal HALF_D = D / 2\n\n-- The height of a storey's floor level. Floor 1 stands on the ground the origin sits on.\nlocal function floorY(floor: number): number\n	return (floor - 1) * FH\nend\n\n-- Where the building's centre sits in the world.\n--\n-- Module-level rather than threaded through every helper, and set once at the top of Build.\n-- The alternative was to lay the whole shell at the world origin and translate it afterwards,\n-- which needs a staging folder and a second pass over every part -- and, more to the point,\n-- needs `Instance.new(\"Folder\")` and `FindFirstChild` to work, which is exactly what is not\n-- available when this module is run headless to bake an asset.\nlocal ORIGIN = Vector3.new(0, 0, 0)\n\n-- Every coordinate below is written as a dimension of the building; this is the one place it\n-- becomes a position in the map.\nlocal function place(x: number, y: number, z: number): Vector3\n	return Vector3.new(x + ORIGIN.X, y + ORIGIN.Y, z + ORIGIN.Z)\nend\n\n-- ---------------------------------------------------------------------------------------\n-- Wall runs\n-- ---------------------------------------------------------------------------------------\n\n-- A storey's worth of ribbon glazing along one elevation.\n--\n-- **This replaces punched windows, and that single change is most of what made the old facade\n-- dull.** Separate 12x10 holes in a wall read as a warehouse: the wall is the subject and the\n-- windows are absences in it. A continuous band -- sill, glass, head, repeated at every floor\n-- -- makes the *glazing* the subject and the solid parts into structure between it. It is the\n-- difference between a shed with windows and a building.\n--\n-- Four parts plus a mullion every 18 studs, against five parts per window before, so it is\n-- cheaper as well.\n--\n-- `axis` is \"x\" for a run along the frontage or \"z\" for one along a flank.\nlocal function ribbonRun(parent: Instance, axis: string, fixed: number, from: number, to: number, y: number)\n	local span = to - from\n	if span <= 0.05 then\n		return\n	end\n	local mid = (from + to) / 2\n	local glassH = FH * GLASS_SHARE\n	local bandH = (FH - glassH) / 2\n\n	local function slab(name: string, cy: number, h: number, thickness: number, colour: Color3, material: Enum.Material): Part\n		local position = if axis == \"x\" then place(mid, cy, fixed) else place(fixed, cy, mid)\n		local size = if axis == \"x\" then Vector3.new(span, h, thickness) else Vector3.new(thickness, h, span)\n		return Engine.CreateWall(position, size, Vector3.new(0, 0, 0), material, colour, parent)\n	end\n\n	slab(\"RibbonSill\", y + bandH / 2, bandH, T, WHITE, WALL_MATERIAL).Name = \"RibbonSill\"\n	local pane = slab(\"RibbonGlass\", y + bandH + glassH / 2, glassH, T * 0.5, GLASS_TINT, Enum.Material.Glass)\n	pane.Name = \"RibbonGlass\"\n	pane.Transparency = 0.5\n	pane.Reflectance = 0.12\n	slab(\"RibbonHead\", y + bandH + glassH + bandH / 2, bandH, T, OFF_WHITE, WALL_MATERIAL).Name = \"RibbonHead\"\n\n	-- The uprights. Without them a fifty-stud pane has nothing in it to measure the building\n	-- against, and the whole elevation loses its scale -- which is exactly why the old school\n	-- looked like a toy next to a town of small houses.\n	if span > MULLION_SPACING then\n		local bays = math.max(1, math.floor(span / MULLION_SPACING + 0.5))\n		for bay = 1, bays - 1 do\n			local along = from + span * (bay / bays)\n			local position = if axis == \"x\"\n				then place(along, y + bandH + glassH / 2, fixed - 0.4)\n				else place(fixed - 0.4, y + bandH + glassH / 2, along)\n			local size = if axis == \"x\" then Vector3.new(0.8, glassH, T) else Vector3.new(T, glassH, 0.8)\n			Engine.CreateWall(position, size, Vector3.new(0, 0, 0), TRIM_MATERIAL, WHITE, parent).Name = \"Mullion\"\n		end\n	end\nend\n\n-- ---------------------------------------------------------------------------------------\n-- The entrance\n-- ---------------------------------------------------------------------------------------\n\n-- The grand front door: a two-storey bay cut out of the middle of the facade, with the doors\n-- set back inside it and a glazed wall over them.\n--\n-- The recess is the part that makes it grand rather than merely large. A door flush with the\n-- facade is a hole in a wall; a door six studs back has a soffit over it, a reveal down each\n-- side, and a pool of shadow around it -- and those are what the eye reads as *entrance* from\n-- the far side of a car park.\nlocal function buildEntrance(parent: Instance)\n	local bay = PLAN.EntranceBayStuds\n	local recess = PLAN.EntranceRecessStuds\n	local faceZ = -HALF_D\n	local backZ = faceZ + recess\n\n	-- The two reveals, running back from the facade to the door wall.\n	for side = -1, 1, 2 do\n		Engine.CreateWall(\n			place(side * bay / 2, FH, faceZ + recess / 2),\n			Vector3.new(T, FH * 2, recess),\n			Vector3.new(0, 0, 0),\n			TRIM_MATERIAL,\n			DARK_SLATE,\n			parent\n		)\n	end\n\n	-- The soffit over the recess, at the head of storey two.\n	Engine.CreateFloor(\n		place(0, FH * 2 - 2, faceZ + recess / 2),\n		Vector3.new(bay, T, recess),\n		TRIM_MATERIAL,\n		DARK_SLATE,\n		parent\n	)\n\n	-- The door wall at the back of the recess, framed around the opening rather than cut --\n	-- the same reason CreateWindowCutout frames rather than cuts.\n	local doorW = PLAN.DoorWidthStuds\n	local doorH = PLAN.DoorHeightStuds\n	local pier = (bay - doorW) / 2\n	for side = -1, 1, 2 do\n		Engine.CreateWall(\n			place(side * (doorW + pier) / 2, FH / 2, backZ),\n			Vector3.new(pier, FH, T),\n			Vector3.new(0, 0, 0),\n			WALL_MATERIAL,\n			COOL_GRAY,\n			parent\n		)\n	end\n	Engine.CreateWall(\n		place(0, doorH + (FH - doorH) / 2, backZ),\n		Vector3.new(doorW, FH - doorH, T),\n		Vector3.new(0, 0, 0),\n		WALL_MATERIAL,\n		COOL_GRAY,\n		parent\n	)\n\n	-- The doors themselves. Timber, and that is a deliberate break from the palette: in an\n	-- elevation this pale, the one warm object is the way in, and it can be found from the road\n	-- without a sign.\n	for side = -1, 1, 2 do\n		local leaf = Engine.CreateWall(\n			place(side * doorW / 4, doorH / 2, backZ - 0.3),\n			Vector3.new(doorW / 2 - 0.3, doorH, 0.8),\n			Vector3.new(0, 0, 0),\n			Enum.Material.WoodPlanks,\n			DOOR_TIMBER,\n			parent\n		)\n		leaf.Name = `EntranceDoorLeaf{side}`\n\n		local bar = Engine.CreateWall(\n			place(side * doorW / 4, doorH * 0.45, backZ - 0.85),\n			Vector3.new(doorW / 2 - 4, 0.5, 0.5),\n			Vector3.new(0, 0, 0),\n			TRIM_MATERIAL,\n			Color3.fromRGB(214, 218, 226),\n			parent\n		)\n		bar.Name = `EntranceDoorBar{side}`\n	end\n\n	-- The curtain wall over the entrance, filling storey two of the bay.\n	local curtainW = PLAN.CurtainWidthStuds\n	local curtainH = PLAN.CurtainHeightStuds\n	local curtain = Engine.CreateWall(\n		place(0, floorY(2) + curtainH / 2, faceZ),\n		Vector3.new(curtainW, curtainH, T * 0.5),\n		Vector3.new(0, 0, 0),\n		Enum.Material.Glass,\n		GLASS_TINT,\n		parent\n	)\n	curtain.Name = \"EntranceCurtainWall\"\n	curtain.Transparency = 0.5\n	curtain.Reflectance = 0.1\n\n	-- Mullions. A 30-stud sheet of glass has nothing in it to measure the building against, so\n	-- the eye reads it as one enormous window and the whole facade loses its size. Divided into\n	-- door-width bays it is legibly two storeys tall, and not one dimension has changed.\n	for index = 1, 4 do\n		local mullion = Engine.CreateWall(\n			place(-curtainW / 2 + curtainW * (index / 5), floorY(2) + curtainH / 2, faceZ - 1.1),\n			Vector3.new(0.6, curtainH, 0.6),\n			Vector3.new(0, 0, 0),\n			TRIM_MATERIAL,\n			DARK_SLATE,\n			parent\n		)\n		mullion.Name = `EntranceMullion{index}`\n	end\n	Engine.CreateWall(\n		place(0, floorY(2), faceZ - 1.1),\n		Vector3.new(curtainW, 0.8, 0.8),\n		Vector3.new(0, 0, 0),\n		TRIM_MATERIAL,\n		DARK_SLATE,\n		parent\n	).Name = \"EntranceTransom\"\n\n	-- **A canopy over the way in.**\n	--\n	-- The thing v1's frontage had that this one did not. A recess alone gives you shadow; a\n	-- canopy gives you a horizontal line crossing the glazing at one storey, which is what\n	-- makes an entrance the biggest thing on an elevation rather than a gap in it. Set well\n	-- clear of the door head -- the mistake on v1 was a canopy at 14 over a 17-stud door, which\n	-- hid the thing it was sheltering.\n	local canopyY = PLAN.DoorHeightStuds + 6\n	local canopyOut = 12\n	Engine.CreateFloor(\n		place(0, canopyY, faceZ - canopyOut / 2),\n		Vector3.new(bay + 22, 1.4, canopyOut),\n		TRIM_MATERIAL,\n		WHITE,\n		parent\n	).Name = \"EntranceCanopy\"\n	Engine.CreateWall(\n		place(0, canopyY - 1.2, faceZ - canopyOut / 2),\n		Vector3.new(bay + 22, 1, canopyOut - 1),\n		Vector3.new(0, 0, 0),\n		TRIM_MATERIAL,\n		BLUE,\n		parent\n	).Name = \"EntranceCanopyBand\"\n	-- Two columns carrying its outer edge, clear of the doorway between them.\n	for side = -1, 1, 2 do\n		Engine.CreateWall(\n			place(side * (bay / 2 + 6), canopyY / 2, faceZ - canopyOut + 1.5),\n			Vector3.new(2.4, canopyY, 2.4),\n			Vector3.new(0, 0, 0),\n			TRIM_MATERIAL,\n			WHITE,\n			parent\n		).Name = `EntranceColumn{side}`\n	end\n\n	-- The bay is flanked full height by piers, so the composition has edges.\n	for side = -1, 1, 2 do\n		Engine.CreateWall(\n			place(side * (bay / 2 + 1.5), TOTAL_H / 2, faceZ - 0.6),\n			Vector3.new(3, TOTAL_H, 1.6),\n			Vector3.new(0, 0, 0),\n			TRIM_MATERIAL,\n			DARK_SLATE,\n			parent\n		).Name = `EntrancePier{side}`\n	end\nend\n\n-- ---------------------------------------------------------------------------------------\n-- Build\n-- ---------------------------------------------------------------------------------------\n\n-- Lays the shell. `origin` is where the building's centre sits in the world; everything above\n-- is written relative to it, so moving the school is one argument rather than a search.\nfunction Exterior.Build(origin: Vector3?, into: Instance?): Instance\n	ORIGIN = origin or Vector3.new(0, 0, 0)\n\n	-- `into` is taken as given when supplied, so the module can be run headless against a plain\n	-- folder to bake an asset. Left out, it builds the folder tree and uses the Exterior branch.\n	local staging: Instance\n	if into ~= nil then\n		staging = into\n	else\n		staging = Tree.Build().Exterior\n	end\n\n	-- ---- base course\n	for _, run in {\n		{ axis = \"x\", fixed = -HALF_D, from = -HALF_W, to = HALF_W },\n		{ axis = \"x\", fixed = HALF_D, from = -HALF_W, to = HALF_W },\n		{ axis = \"z\", fixed = -HALF_W, from = -HALF_D, to = HALF_D },\n		{ axis = \"z\", fixed = HALF_W, from = -HALF_D, to = HALF_D },\n	} do\n		local span = run.to - run.from\n		local mid = (run.from + run.to) / 2\n		local position = if run.axis == \"x\"\n			then place(mid, PLAN.PlinthHeightStuds / 2, run.fixed)\n			else place(run.fixed, PLAN.PlinthHeightStuds / 2, mid)\n		local size = if run.axis == \"x\"\n			then Vector3.new(span + T, PLAN.PlinthHeightStuds, T + 1)\n			else Vector3.new(T + 1, PLAN.PlinthHeightStuds, span + T)\n		Engine.CreateWall(position, size, Vector3.new(0, 0, 0), TRIM_MATERIAL, DARK_SLATE, staging).Name = \"Plinth\"\n	end\n\n	for floor = 1, PLAN.Floors do\n		local y = floorY(floor)\n\n		-- ---- floor plate, with the stairwells cut out of every level above the ground\n		--\n		-- **The openings come from Layout, the same table Interior builds the shaft walls\n		-- from.** That is the whole reason Layout exists: on the last school the corridor and\n		-- the hole in the floor above it were computed independently, disagreed by three studs,\n		-- and produced a corridor with no floor under it that nothing detected.\n		--\n		-- Ground floor is solid -- there is nothing under it to fall into.\n		-- **The plate hangs below its level, so `floorY(n)` is the surface you stand on.**\n		--\n		-- Centred *on* the level instead, its top surface sits half a thickness higher than the\n		-- number every other module works from -- so every interior wall is built a stud low and\n		-- anything short, like a locker plinth, ends up buried in the slab. Found exactly that\n		-- way: 44 plinths inside FloorPlate2Corridor.\n		if floor == 1 then\n			Engine.CreateFloor(place(0, y - T / 2, 0), Vector3.new(W, T, D), TRIM_MATERIAL, COOL_GRAY, staging).Name =\n				`FloorPlate{floor}`\n		else\n			-- Laid as strips around the shafts. Roblox cannot put a hole in a Part, so a floor\n			-- with a void in it is a ring of slabs -- the same constraint the window frames work\n			-- around, one storey up.\n			local westX = Layout.Stairwells[1].x2\n			local eastX = Layout.Stairwells[2].x1\n			local wellZ1, wellZ2 = Layout.CorridorZ1, Layout.CorridorZ2\n\n			-- In front of and behind the shafts, full width.\n			Engine.CreateFloor(\n				place(0, y - T / 2, (-HALF_D + wellZ1) / 2),\n				Vector3.new(W, T, wellZ1 + HALF_D),\n				TRIM_MATERIAL,\n				COOL_GRAY,\n				staging\n			).Name = `FloorPlate{floor}Front`\n			Engine.CreateFloor(\n				place(0, y - T / 2, (wellZ2 + HALF_D) / 2),\n				Vector3.new(W, T, HALF_D - wellZ2),\n				TRIM_MATERIAL,\n				COOL_GRAY,\n				staging\n			).Name = `FloorPlate{floor}Back`\n			-- And the corridor band between them, which is where the two holes are.\n			Engine.CreateFloor(\n				place((westX + eastX) / 2, y - T / 2, 0),\n				Vector3.new(eastX - westX, T, wellZ2 - wellZ1),\n				TRIM_MATERIAL,\n				COOL_GRAY,\n				staging\n			).Name = `FloorPlate{floor}Corridor`\n		end\n\n		-- ---- the three windowed elevations\n		ribbonRun(staging, \"z\", -HALF_W, -HALF_D, HALF_D, y)\n		ribbonRun(staging, \"z\", HALF_W, -HALF_D, HALF_D, y)\n		ribbonRun(staging, \"x\", HALF_D, -HALF_W, HALF_W, y)\n\n		-- ---- the front, which has the entrance bay in the middle of it\n		local bayHalf = PLAN.EntranceBayStuds / 2\n		if floor == 3 then\n			-- Above the entrance the frontage is continuous, so it takes the full rhythm.\n			ribbonRun(staging, \"x\", -HALF_D, -HALF_W, HALF_W, y)\n		else\n			-- Either side of the entrance bay. A ribbon needs no bay arithmetic -- it simply runs\n			-- the length it is given and puts a mullion every 18 studs, so the rhythm matches\n			-- the rest of the building without being told to.\n			ribbonRun(staging, \"x\", -HALF_D, -HALF_W, -bayHalf, y)\n			ribbonRun(staging, \"x\", -HALF_D, bayHalf, HALF_W, y)\n			if floor == 1 then\n				-- storey one of the bay is the recess, built below\n			else\n				-- storey two of the bay is the curtain wall, also below; nothing solid here\n			end\n		end\n\n		-- ---- the floor band, in the dark tone, wrapped round all four sides\n		if floor > 1 then\n			for _, band in {\n				{ position = place(0, y, -HALF_D - 0.4), size = Vector3.new(W + 2, 1.6, 1.2) },\n				{ position = place(0, y, HALF_D + 0.4), size = Vector3.new(W + 2, 1.6, 1.2) },\n				{ position = place(-HALF_W - 0.4, y, 0), size = Vector3.new(1.2, 1.6, D + 2) },\n				{ position = place(HALF_W + 0.4, y, 0), size = Vector3.new(1.2, 1.6, D + 2) },\n			} do\n				Engine.CreateWall(band.position, band.size, Vector3.new(0, 0, 0), TRIM_MATERIAL, DARK_SLATE, staging).Name =\n					`FloorBand{floor}`\n			end\n		end\n	end\n\n	buildEntrance(staging)\n\n	-- ---- flat roof and its parapet\n	Engine.CreateFloor(\n		place(0, TOTAL_H - T / 2, 0),\n		Vector3.new(W, T, D),\n		TRIM_MATERIAL,\n		Color3.fromRGB(122, 128, 138),\n		staging\n	).Name = \"Roof\"\n\n	local pt = PLAN.ParapetThicknessStuds\n	local ph = PLAN.ParapetHeightStuds\n	for _, wall in {\n		{ position = place(0, TOTAL_H + ph / 2, -HALF_D + pt / 2), size = Vector3.new(W, ph, pt) },\n		{ position = place(0, TOTAL_H + ph / 2, HALF_D - pt / 2), size = Vector3.new(W, ph, pt) },\n		{ position = place(-HALF_W + pt / 2, TOTAL_H + ph / 2, 0), size = Vector3.new(pt, ph, D - pt * 2) },\n		{ position = place(HALF_W - pt / 2, TOTAL_H + ph / 2, 0), size = Vector3.new(pt, ph, D - pt * 2) },\n	} do\n		Engine.CreateWall(wall.position, wall.size, Vector3.new(0, 0, 0), TRIM_MATERIAL, DEEP_BLUE, staging).Name = \"Parapet\"\n	end\n\n	return staging\nend\n\nExterior.Plan = PLAN\n\nreturn Exterior\n"
table.insert(AGES_MANIFEST, "src/server/world/ProperSchool/Exterior.luau")
AGES_SOURCES["src/server/world/ProperSchool/Furniture.luau"] = "--!strict\n-- Furniture for the rooms Interior walls off.\n--\n-- Two rules learned the hard way on this building, both worth stating before the code:\n--\n--   * **Anything sitting on a face clears that face by at least a grid unit.** Engine snaps\n--     every position to a quarter stud, so a detail offset by less than that can be rounded\n--     back through the surface it was meant to sit on. That bug has now been found three times\n--     -- locker vents, locker handles, stair nosings -- and it never throws, it just quietly\n--     buries the thing.\n--   * **A room's front is its -Z face**, and `facing` flips that for rooms on the other side of\n--     the corridor. A classroom whose board is behind the students is not obviously wrong from\n--     any single screenshot, which is exactly why it needs to be a parameter rather than an\n--     assumption.\n\nlocal Engine = require(script.Parent.SchoolBuilderEngine)\nlocal Layout = require(script.Parent.Layout)\nlocal Tree = require(script.Parent.Tree)\n\nlocal Furniture = {}\n\nlocal WOOD = Color3.fromRGB(148, 104, 66)\nlocal DARK_WOOD = Color3.fromRGB(96, 66, 44)\nlocal METAL = Color3.fromRGB(126, 132, 142)\nlocal CHAIR = Color3.fromRGB(58, 92, 158)\nlocal SLATE = Color3.fromRGB(44, 50, 60)\n\nlocal BOOK = {\n	Color3.fromRGB(158, 52, 52),\n	Color3.fromRGB(44, 78, 148),\n	Color3.fromRGB(72, 116, 72),\n	Color3.fromRGB(186, 148, 68),\n	Color3.fromRGB(104, 72, 132),\n}\n\nlocal SMOOTH = Enum.Material.SmoothPlastic\nlocal PLANKS = Enum.Material.WoodPlanks\nlocal METALLIC = Enum.Material.Metal\n\n-- Anything on a surface clears it by this much. One grid unit -- see the header.\nlocal CLEAR = 0.25\n\nlocal function block(parent: Instance, name: string, position: Vector3, size: Vector3, material: Enum.Material, colour: Color3, orientation: Vector3?): Part\n	local part = Engine.CreateWall(position, size, orientation or Vector3.new(0, 0, 0), material, colour, parent)\n	part.Name = name\n	return part\nend\n\n-- A disc lying flat. Roblox's cylinder runs along its own X, so a table top is a quarter turn\n-- about Z -- not about Y, which is the mistake that produces a wheel standing on its edge.\nlocal function disc(parent: Instance, name: string, position: Vector3, radius: number, thickness: number, material: Enum.Material, colour: Color3): Part\n	local part = block(parent, name, position, Vector3.new(thickness, radius * 2, radius * 2), material, colour, Vector3.new(0, 0, 90))\n	part.Shape = Enum.PartType.Cylinder\n	return part\nend\n\n-- A desk: a top on two leg panels. Three parts rather than five, because at this size a pair of\n-- panels reads better than four thin legs and costs two parts less across two hundred desks.\nlocal function desk(parent: Instance, tag: string, cx: number, cz: number, y: number, width: number, depth: number, height: number, topColour: Color3, topMaterial: Enum.Material)\n	block(parent, `{tag}Top`, Vector3.new(cx, y + height, cz), Vector3.new(width, 0.4, depth), topMaterial, topColour)\n	for side = -1, 1, 2 do\n		block(\n			parent,\n			`{tag}Leg{side}`,\n			Vector3.new(cx + side * (width / 2 - 0.8), y + height / 2, cz),\n			Vector3.new(0.6, height, depth - 0.8),\n			SMOOTH,\n			METAL\n		)\n	end\nend\n\nlocal function chair(parent: Instance, tag: string, cx: number, cz: number, y: number, facing: number)\n	block(parent, `{tag}Seat`, Vector3.new(cx, y + 1.9, cz), Vector3.new(2.6, 0.4, 2.6), SMOOTH, CHAIR)\n	block(parent, `{tag}Back`, Vector3.new(cx, y + 3.3, cz - facing * 1.3), Vector3.new(2.6, 3, 0.4), SMOOTH, CHAIR)\n	block(parent, `{tag}Leg`, Vector3.new(cx, y + 0.95, cz), Vector3.new(2, 1.9, 2), SMOOTH, METAL)\nend\n\n-- ---------------------------------------------------------------------------------------\n-- Rooms\n-- ---------------------------------------------------------------------------------------\n\n-- A classroom: board on the front wall, teacher's desk in front of it, and a grid of student\n-- desks facing both.\n--\n-- `facing` is which way the room's front is: -1 puts the board on the -Z wall, +1 on the +Z.\n-- Everything else -- which way the students face, which side of the desk a chair goes -- falls\n-- out of it, so the room cannot end up half-reversed.\nfunction Furniture.PopulateClassroom(roomCenter: Vector3, roomSize: Vector3, parent: Instance?, facing: number?)\n	local into = parent or Tree.Build().Furniture\n	local face = facing or -1\n	local y = roomCenter.Y\n	local halfD = roomSize.Z / 2\n	local frontZ = roomCenter.Z + face * (halfD - 1)\n	local tag = `Class{math.round(roomCenter.X)}_{math.round(roomCenter.Z)}`\n\n	-- The whiteboard: one large dark slate panel, framed, standing off the wall by more than\n	-- the grid so it cannot snap into it.\n	block(into, `{tag}BoardFrame`, Vector3.new(roomCenter.X, y + 9, frontZ - face * CLEAR), Vector3.new(26, 12, 0.5), SMOOTH, Color3.fromRGB(198, 202, 210))\n	block(into, `{tag}Board`, Vector3.new(roomCenter.X, y + 9, frontZ - face * (CLEAR + 0.5)), Vector3.new(24, 10.4, 0.4), SMOOTH, SLATE)\n	block(into, `{tag}BoardTray`, Vector3.new(roomCenter.X, y + 3.4, frontZ - face * (CLEAR + 0.9)), Vector3.new(24, 0.4, 1.2), SMOOTH, METAL)\n\n	-- The teacher's desk, set to one side of the board so it does not stand in front of it.\n	local teacherZ = roomCenter.Z + face * (halfD - 8)\n	desk(into, `{tag}Teacher`, roomCenter.X - 8, teacherZ, y, 11, 4.5, 3.2, DARK_WOOD, PLANKS)\n	chair(into, `{tag}TeacherChair`, roomCenter.X - 8, teacherZ + face * 3.4, y, -face)\n\n	-- **A 4 by 5 grid, sized to the room rather than pitched at a fixed spacing.**\n	-- The rows divide the space that is actually free -- back wall to the teacher's zone -- so\n	-- the grid stays a grid whatever the room's proportions are. Fixed pitch is what put desk\n	-- row five on top of the teacher's desk in the last school.\n	local cols, rows = 4, 5\n	local fieldFront = roomCenter.Z + face * (halfD - 16)\n	local fieldBack = roomCenter.Z - face * (halfD - 5)\n	local rowPitch = (fieldBack - fieldFront) / rows\n	local colPitch = (roomSize.X - 12) / cols\n\n	for row = 1, rows do\n		for col = 1, cols do\n			local dx = roomCenter.X - (roomSize.X - 12) / 2 + colPitch * (col - 0.5)\n			local dz = fieldFront + rowPitch * (row - 0.5)\n			local id = `{tag}D{row}_{col}`\n			desk(into, id, dx, dz, y, 6, 3, 2.8, WOOD, PLANKS)\n			-- The chair sits behind the desk, on the side away from the board.\n			chair(into, `{id}Chair`, dx, dz - face * 3, y, face)\n		end\n	end\nend\n\n-- The library: ranks of shelving down both flanks, reading tables through the middle.\n--\n-- Shelves are ranked rather than scattered for the same reason the window bays are even -- a\n-- regular rhythm reads as a designed room, and an irregular one reads as a mistake from the\n-- door. The middle is left clear because a library that is all stacks has nowhere to read.\nfunction Furniture.PopulateLibrary(roomCenter: Vector3, roomSize: Vector3, parent: Instance?)\n	local into = parent or Tree.Build().Furniture\n	local y = roomCenter.Y\n	local tag = \"Library\"\n	local spacing = 6\n	local shelfDepth = 3\n	local shelfHeight = 11\n	local halfW = roomSize.X / 2\n	local halfD = roomSize.Z / 2\n\n	-- The stacks: two blocks of ranks, one at each end, running across the room's depth.\n	local rankLength = roomSize.Z - 14\n	local blockWidth = halfW * 0.45\n	local index = 0\n	for side = -1, 1, 2 do\n		local blockStart = roomCenter.X + side * (halfW - 4)\n		local ranks = math.floor(blockWidth / spacing)\n		for rank = 1, ranks do\n			index += 1\n			local sx = blockStart - side * spacing * (rank - 0.5)\n			block(into, `{tag}Shelf{index}`, Vector3.new(sx, y + shelfHeight / 2, roomCenter.Z), Vector3.new(shelfDepth, shelfHeight, rankLength), PLANKS, DARK_WOOD)\n			-- Books on three tiers, and on **both faces** of the rank.\n			--\n			-- A single band drawn the full width of the carcass is 86% inside it: what shows is\n			-- a quarter-stud sliver down each edge, which from any distance is nothing. A shelf\n			-- is double-sided, so the books belong on the two faces, standing clear of the wood\n			-- by the usual grid unit. Six parts a rank instead of three, and the difference is\n			-- between a bookshelf and a brown box.\n			for tier = 1, 3 do\n				for face = -1, 1, 2 do\n					block(\n						into,\n						`{tag}Books{index}_{tier}_{face}`,\n						Vector3.new(sx + face * (shelfDepth / 2 + 0.6), y + tier * 3 - 0.6, roomCenter.Z),\n						Vector3.new(1.2, 2, rankLength - 1),\n						SMOOTH,\n						BOOK[(index + tier + face) % #BOOK + 1]\n					)\n				end\n			end\n		end\n	end\n\n	-- Round study tables down the centre, four chairs apiece.\n	local tables = 4\n	for t = 1, tables do\n		local tx = roomCenter.X - (roomSize.X * 0.4) / 2 + (roomSize.X * 0.4) * ((t - 0.5) / tables)\n		local tz = roomCenter.Z\n		disc(into, `{tag}Table{t}`, Vector3.new(tx, y + 3.2, tz), 5, 0.5, PLANKS, WOOD)\n		block(into, `{tag}TablePost{t}`, Vector3.new(tx, y + 1.6, tz), Vector3.new(1.2, 3.2, 1.2), SMOOTH, METAL)\n		disc(into, `{tag}TableFoot{t}`, Vector3.new(tx, y + 0.3, tz), 2.2, 0.5, SMOOTH, METAL)\n		for seat = 0, 3 do\n			local angle = math.rad(90 * seat)\n			chair(into, `{tag}T{t}C{seat}`, tx + math.cos(angle) * 7, tz + math.sin(angle) * 7, y, if math.sin(angle) >= 0 then -1 else 1)\n		end\n	end\nend\n\n-- The cafeteria: long refectory tables in rows, benches either side.\n--\n-- Bench tables rather than separate chairs, because that is what a school hall has and because\n-- a hundred loose chairs is a hundred parts that will all end up at odd angles.\nfunction Furniture.PopulateCafeteria(roomCenter: Vector3, roomSize: Vector3, parent: Instance?)\n	local into = parent or Tree.Build().Furniture\n	local y = roomCenter.Y\n	local tag = \"Cafe\"\n	local rows = 5\n	local tableLength = roomSize.Z - 16\n	local usable = roomSize.X - 20\n	local pitch = usable / rows\n\n	for row = 1, rows do\n		local tx = roomCenter.X - usable / 2 + pitch * (row - 0.5)\n		block(into, `{tag}Table{row}`, Vector3.new(tx, y + 3, roomCenter.Z), Vector3.new(7, 0.5, tableLength), PLANKS, WOOD)\n		for side = -1, 1, 2 do\n			block(into, `{tag}Leg{row}_{side}`, Vector3.new(tx, y + 1.5, roomCenter.Z + side * (tableLength / 2 - 3)), Vector3.new(6, 3, 0.8), SMOOTH, METAL)\n			block(into, `{tag}Bench{row}_{side}`, Vector3.new(tx + side * 6, y + 1.9, roomCenter.Z), Vector3.new(3.2, 0.4, tableLength - 2), PLANKS, DARK_WOOD)\n			block(into, `{tag}BenchLeg{row}_{side}`, Vector3.new(tx + side * 6, y + 0.95, roomCenter.Z), Vector3.new(2.6, 1.9, tableLength - 6), SMOOTH, METAL)\n		end\n	end\nend\n\n-- ---------------------------------------------------------------------------------------\n-- Administration\n-- ---------------------------------------------------------------------------------------\n--\n-- **These are baked, which is why they live here rather than in Interactive.**\n--\n-- Anything built in Interactive exists only once the server is running, so it is invisible in\n-- the editor. Geometry belongs in the bake and behaviour belongs at runtime, and the seam\n-- between them is the part name: Interactive finds `ReceptionChair`, `ExecChair`, `GuestChair*`\n-- and `Couch*` below and hangs a Seat and an L prompt on each. Rename one here and it stops\n-- being sittable, silently -- which is the cost of the split and worth knowing about.\n\n-- The reception desk, curved as a fan of straight segments. Roblox has no curved primitive, and\n-- seven chords across 110 degrees reads as a curve from anywhere a player stands.\nfunction Furniture.PopulateLobby(roomCenter: Vector3, roomSize: Vector3, parent: Instance?)\n	local into = parent or Tree.Build().Furniture\n	local y = roomCenter.Y\n	local cx = roomCenter.X\n	local cz = roomCenter.Z - roomSize.Z / 2 + 22\n	local radius = 13\n	local segments = 7\n	local sweep = math.rad(110)\n	local chord = radius * sweep / segments\n\n	for i = 1, segments do\n		local a = -sweep / 2 + sweep * ((i - 0.5) / segments)\n		local px = cx + math.sin(a) * radius\n		local pz = cz + math.cos(a) * radius\n		local turn = Vector3.new(0, -math.deg(a), 0)\n		block(into, `DeskBody{i}`, Vector3.new(px, y + 2, pz), Vector3.new(chord + 1, 4, 3), PLANKS, DARK_WOOD, turn)\n		block(into, `DeskTop{i}`, Vector3.new(px, y + 4.2, pz), Vector3.new(chord + 1.4, 0.5, 4), SMOOTH, Color3.fromRGB(226, 228, 232), turn)\n		-- The privacy screen is glass and stops at counter height plus three, so the desk\n		-- screens the paperwork without hiding the person behind it.\n		block(into, `DeskScreen{i}`, Vector3.new(px, y + 6, pz), Vector3.new(chord + 1, 3, 0.3), Enum.Material.Glass, Color3.fromRGB(196, 220, 240), turn)\n	end\n\n	block(into, \"Monitor\", Vector3.new(cx, y + 6, cz + radius - 1.5), Vector3.new(6, 3.6, 0.3), SMOOTH, SLATE)\n	block(into, \"MonitorScreen\", Vector3.new(cx, y + 6, cz + radius - 1.8), Vector3.new(5.4, 3, 0.1), Enum.Material.Neon, Color3.fromRGB(120, 180, 230))\n	block(into, \"MonitorStand\", Vector3.new(cx, y + 3.6, cz + radius - 1.5), Vector3.new(1, 1.6, 1), SMOOTH, METAL)\n	block(into, \"ReceptionChair\", Vector3.new(cx, y + 2, cz + radius + 3), Vector3.new(3, 0.4, 3), SMOOTH, SLATE)\n	block(into, \"ReceptionChairBack\", Vector3.new(cx, y + 4.2, cz + radius + 4.4), Vector3.new(3, 4, 0.4), SMOOTH, SLATE)\nend\n\nfunction Furniture.PopulateOffice(roomCenter: Vector3, roomSize: Vector3, parent: Instance?)\n	local into = parent or Tree.Build().Furniture\n	local y = roomCenter.Y\n	local cx, cz = roomCenter.X, roomCenter.Z\n\n	block(into, \"ExecDeskBody\", Vector3.new(cx, y + 2, cz), Vector3.new(16, 4, 7), PLANKS, Color3.fromRGB(58, 40, 28))\n	block(into, \"ExecDeskTop\", Vector3.new(cx, y + 4.3, cz), Vector3.new(17, 0.6, 8), PLANKS, Color3.fromRGB(74, 50, 34))\n	block(into, \"ExecChair\", Vector3.new(cx, y + 2.2, cz - 6), Vector3.new(4, 0.5, 4), SMOOTH, SLATE)\n	block(into, \"ExecChairBack\", Vector3.new(cx, y + 6, cz - 8), Vector3.new(4, 7, 0.6), SMOOTH, SLATE)\n\n	for side = -1, 1, 2 do\n		block(into, `GuestChair{side}`, Vector3.new(cx + side * 5, y + 2, cz + 7), Vector3.new(3, 0.4, 3), SMOOTH, CHAIR)\n		block(into, `GuestChairBack{side}`, Vector3.new(cx + side * 5, y + 4, cz + 8.4), Vector3.new(3, 4, 0.4), SMOOTH, CHAIR)\n	end\n\n	local cabX = roomCenter.X - roomSize.X / 2 + 6\n	block(into, \"FilingCabinet\", Vector3.new(cabX, y + 5, cz - 14), Vector3.new(5, 10, 4), METALLIC, METAL)\n	for drawer = 1, 3 do\n		block(into, `FilingDrawer{drawer}`, Vector3.new(cabX, y + 1.6 + drawer * 3, cz - 11.7), Vector3.new(4.4, 2.4, 0.4), METALLIC, Color3.fromRGB(158, 164, 174))\n	end\nend\n\nfunction Furniture.PopulateStaffRoom(roomCenter: Vector3, roomSize: Vector3, parent: Instance?)\n	local into = parent or Tree.Build().Furniture\n	local y = roomCenter.Y\n	local cx, cz = roomCenter.X, roomCenter.Z\n\n	block(into, \"BreakTableTop\", Vector3.new(cx, y + 3.2, cz + 6), Vector3.new(22, 0.6, 7), PLANKS, WOOD)\n	for side = -1, 1, 2 do\n		block(into, `BreakTableLeg{side}`, Vector3.new(cx + side * 9, y + 1.6, cz + 6), Vector3.new(1, 3.2, 6), SMOOTH, METAL)\n	end\n\n	local counterZ = roomCenter.Z - roomSize.Z / 2 + 4\n	block(into, \"KitchenBody\", Vector3.new(cx, y + 1.5, counterZ), Vector3.new(24, 3, 4.4), SMOOTH, Color3.fromRGB(242, 243, 246))\n	block(into, \"KitchenCounter\", Vector3.new(cx, y + 3.2, counterZ), Vector3.new(24, 0.6, 5), SMOOTH, Color3.fromRGB(216, 220, 228))\n	block(into, \"Sink\", Vector3.new(cx - 6, y + 3.1, counterZ), Vector3.new(5, 0.8, 3.4), METALLIC, Color3.fromRGB(198, 204, 214))\n	block(into, \"Tap\", Vector3.new(cx - 6, y + 4.8, counterZ - 1.6), Vector3.new(0.4, 2.4, 0.4), METALLIC, METAL)\n\n	-- The pair is spaced off the room's width, not a fixed eleven studs.\n	--\n	-- Two 12-stud couches with 6.2-stud arms need 35.6 studs between their outer edges, and the\n	-- staff room is 40 wide -- so a hard-coded offset put both outer arms through the side walls.\n	-- Derived, they sit clear whatever the room turns out to be.\n	local couchOffset = roomSize.X * 0.22\n	for index = -1, 1, 2 do\n		local sx = cx + index * couchOffset\n		local sz = cz + 16\n		block(into, `Couch{index}`, Vector3.new(sx, y + 2, sz), Vector3.new(12, 2.6, 5), Enum.Material.Fabric, Color3.fromRGB(96, 118, 168))\n		block(into, `CouchBack{index}`, Vector3.new(sx, y + 4.4, sz + 2.2), Vector3.new(12, 5, 1.2), Enum.Material.Fabric, Color3.fromRGB(84, 104, 152))\n		for arm = -1, 1, 2 do\n			block(into, `CouchArm{index}_{arm}`, Vector3.new(sx + arm * 6.2, y + 3.4, sz), Vector3.new(1.2, 3.4, 5), Enum.Material.Fabric, Color3.fromRGB(84, 104, 152))\n		end\n	end\nend\n\n-- ---------------------------------------------------------------------------------------\n-- Driver\n-- ---------------------------------------------------------------------------------------\n\n-- Walks every room on every floor and fills the ones there is furniture for.\n--\n-- The bounds come out of Layout, the same table the walls were built from, so a room's contents\n-- and the room itself cannot end up in different places. Nothing here writes a coordinate.\nfunction Furniture.Build(origin: Vector3?, parent: Instance?): ()\n	local into = parent or Tree.Build().Furniture\n	local at = origin or Vector3.new(0, 0, 0)\n\n	for floor = 1, Layout.Floors do\n		local y = Layout.FloorY(floor)\n		for _, room in Layout.RoomsOn(floor) do\n			local z1, z2 = Layout.BandZ(room.band)\n			local centre = Vector3.new((room.x1 + room.x2) / 2 + at.X, y + at.Y, (z1 + z2) / 2 + at.Z)\n			local size = Vector3.new(room.x2 - room.x1, Layout.FloorHeightStuds, z2 - z1)\n\n			-- A front-band room has the corridor on its +Z side, so its front -- the wall the\n			-- board goes on -- is -Z. A back-band room is the mirror of that.\n			local facing = if room.band == \"front\" then -1 else 1\n\n			if room.kind == \"classroom\" then\n				Furniture.PopulateClassroom(centre, size, into, facing)\n			elseif room.kind == \"library\" then\n				Furniture.PopulateLibrary(centre, size, into)\n			elseif room.kind == \"cafeteria\" then\n				Furniture.PopulateCafeteria(centre, size, into)\n			elseif room.kind == \"lobby\" then\n				Furniture.PopulateLobby(centre, size, into)\n			elseif room.kind == \"office\" then\n				Furniture.PopulateOffice(centre, size, into)\n			elseif room.kind == \"staff\" then\n				Furniture.PopulateStaffRoom(centre, size, into)\n			end\n		end\n	end\nend\n\nreturn Furniture\n"
table.insert(AGES_MANIFEST, "src/server/world/ProperSchool/Furniture.luau")
AGES_SOURCES["src/server/world/ProperSchool/Interactive.luau"] = "--!strict\n-- Turns the built school into a playable one: doors that open, lockers that open, light\n-- switches that work, seats you sit on, a lunch counter, admin furniture and spawn points.\n--\n-- **This runs at play time, and it has to.** Everything below is either an instance the asset\n-- bake cannot carry (ProximityPrompt, Seat, PointLight, SpawnLocation, Tool) or behaviour that\n-- needs a running server. The geometry it adds -- door panels, locker fronts, switches,\n-- reception furniture -- therefore appears when you press Play, not in the editor. If you want\n-- any of it visible in Studio, it moves into Furniture.luau and gets baked; the split is\n-- deliberate and is the only reason it is not there already.\n--\n-- Positions come from Layout, never from scanning geometry for coordinates. The one thing it\n-- does read off the world is where the building is, and it takes that from the Roof so there is\n-- no second copy of the site coordinate to fall out of date.\n\nlocal TweenService = game:GetService(\"TweenService\")\n\nlocal Layout = require(script.Parent.Layout)\nlocal Tree = require(script.Parent.Tree)\n\nlocal Interactive = {}\n\nlocal WHITE = Color3.fromRGB(242, 243, 246)\nlocal BLUE = Color3.fromRGB(58, 122, 206)\nlocal TIMBER = Color3.fromRGB(148, 104, 66)\nlocal METAL = Color3.fromRGB(126, 132, 142)\nlocal GLASS_TINT = Color3.fromRGB(196, 220, 240)\n\nlocal SMOOTH = Enum.Material.SmoothPlastic\nlocal PLANKS = Enum.Material.WoodPlanks\n\nlocal DOOR_SWING = TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)\nlocal AUTO_CLOSE_SECONDS = 4\nlocal LOCKER_SWING = TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)\n\nlocal T = Layout.WallThicknessStuds\nlocal DOOR_W = Layout.DoorWidthStuds\nlocal DOOR_H = Layout.DoorHeightStuds\n\n-- ---------------------------------------------------------------------------------------\n-- Helpers\n-- ---------------------------------------------------------------------------------------\n\nlocal function part(parent: Instance, name: string, cf: CFrame, size: Vector3, material: Enum.Material, colour: Color3): Part\n	local p = Instance.new(\"Part\")\n	p.Name = name\n	p.Size = size\n	p.CFrame = cf\n	p.Anchored = true\n	p.CastShadow = true\n	p.Material = material\n	p.Color = colour\n	p.TopSurface = Enum.SurfaceType.Smooth\n	p.BottomSurface = Enum.SurfaceType.Smooth\n	p.Parent = parent\n	return p\nend\n\n-- Every prompt in the building is made here, so the key, the hold and the distance cannot drift\n-- between one interaction and the next.\nlocal function promptOn(adornee: BasePart, action: string, object: string, key: Enum.KeyCode): ProximityPrompt\n	local prompt = Instance.new(\"ProximityPrompt\")\n	prompt.ActionText = action\n	prompt.ObjectText = object\n	prompt.KeyboardKeyCode = key\n	prompt.HoldDuration = 0\n	prompt.MaxActivationDistance = 12\n	prompt.RequiresLineOfSight = false\n	prompt.Parent = adornee\n	return prompt\nend\n\n-- A hinged panel that swings through `degrees` about one vertical edge and comes back.\n--\n-- **The hinge is an edge, not the centre.** Rotating a panel about its own middle spins it like\n-- a turnstile with half of it sweeping backwards through the wall. The move is: translate to\n-- the hinge edge, rotate there, translate back -- which is what a door does.\nlocal function hinge(panel: Part, degrees: number, side: number, info: TweenInfo, autoCloseSeconds: number?)\n	local shut = panel.CFrame\n	local halfWidth = panel.Size.X / 2\n	local pivot = shut * CFrame.new(side * halfWidth, 0, 0)\n	local open = pivot * CFrame.Angles(0, math.rad(-side * degrees), 0) * CFrame.new(-side * halfWidth, 0, 0)\n\n	local isOpen = false\n	local token = 0\n\n	local function set(target: boolean)\n		isOpen = target\n		TweenService:Create(panel, info, { CFrame = if target then open else shut }):Play()\n	end\n\n	return function()\n		set(not isOpen)\n		if isOpen and autoCloseSeconds ~= nil then\n			token += 1\n			local mine = token\n			task.delay(autoCloseSeconds, function()\n				-- Only close if nobody has touched it since. Without the token a door opened,\n				-- shut by hand and opened again slams itself on the first timer.\n				if mine == token and isOpen then\n					set(false)\n				end\n			end)\n		end\n	end\nend\n\n-- ---------------------------------------------------------------------------------------\n-- 1. Doors\n-- ---------------------------------------------------------------------------------------\n\nlocal function buildDoors(root: Instance, origin: Vector3, architecture: Instance)\n	local made = 0\n	for floor = 1, Layout.Floors do\n		for _, opening in Layout.DoorwaysOn(floor) do\n			local along = opening.axis == \"x\"\n			local centre = origin + Vector3.new(opening.x, opening.y + DOOR_H / 2, opening.z)\n\n			local model = Instance.new(\"Model\")\n			model.Name = `Door_{opening.id}_F{opening.floor}`\n			model.Parent = architecture\n\n			-- The frame: two jambs and a head, in the school's blue so an opening reads as one.\n			local jambSize = if along then Vector3.new(0.6, DOOR_H + 1, T * 1.8) else Vector3.new(T * 1.8, DOOR_H + 1, 0.6)\n			for side = -1, 1, 2 do\n				local off = if along then Vector3.new(side * (DOOR_W / 2 + 0.3), 0, 0) else Vector3.new(0, 0, side * (DOOR_W / 2 + 0.3))\n				part(model, `Jamb{side}`, CFrame.new(centre + off), jambSize, SMOOTH, BLUE)\n			end\n			local headSize = if along then Vector3.new(DOOR_W + 1.6, 1, T * 1.8) else Vector3.new(T * 1.8, 1, DOOR_W + 1.6)\n			part(model, \"Head\", CFrame.new(centre + Vector3.new(0, DOOR_H / 2 + 0.5, 0)), headSize, SMOOTH, BLUE)\n\n			-- The leaf. Built along its own X and then turned, so `hinge` can treat the hinge\n			-- edge as +/- half its width whichever way the door faces.\n			local facing = if along then CFrame.new(centre) else CFrame.new(centre) * CFrame.Angles(0, math.rad(90), 0)\n			local leaf = part(model, \"Leaf\", facing, Vector3.new(DOOR_W - 0.4, DOOR_H - 0.4, 0.5), PLANKS, TIMBER)\n			leaf.CanCollide = true\n\n			part(model, \"Vision\", facing * CFrame.new(0, DOOR_H * 0.2, -0.3), Vector3.new(3.5, 4, 0.2), Enum.Material.Glass, GLASS_TINT).CanCollide =\n				false\n			part(model, \"Handle\", facing * CFrame.new(DOOR_W * 0.32, 0, -0.45), Vector3.new(0.5, 1.6, 0.4), Enum.Material.Metal, METAL).CanCollide =\n				false\n\n			model.PrimaryPart = leaf\n\n			local toggle = hinge(leaf, 90, -1, DOOR_SWING, AUTO_CLOSE_SECONDS)\n			promptOn(leaf, \"Open/Close\", \"Door\", Enum.KeyCode.E).Triggered:Connect(toggle)\n			made += 1\n		end\n	end\n	return made\nend\n\n-- ---------------------------------------------------------------------------------------\n-- 2. Lockers\n-- ---------------------------------------------------------------------------------------\n\n-- Each baked locker is one solid box. This hangs a door on the front of it and hollows the\n-- box behind, so opening one shows a slot rather than a painted line.\nlocal function buildLockers(root: Instance, furniture: Instance)\n	local made = 0\n	for _, body in root:GetDescendants() do\n		if not body:IsA(\"BasePart\") or not body.Name:match(\"^Locker%d+$\") then\n			continue\n		end\n\n		local depth = body.Size.Z\n		local width = body.Size.X\n		local height = body.Size.Y\n\n		-- Which way the bank faces: away from the wall it is against, which is the side its\n		-- handle was put on. Read off the body rather than assumed, so both corridor runs work.\n		local handle = body.Parent and body.Parent:FindFirstChild(body.Name:gsub(\"Locker\", \"LockerHandle\"))\n		local facing = 1\n		if handle and handle:IsA(\"BasePart\") then\n			facing = if handle.Position.Z < body.Position.Z then -1 else 1\n		end\n\n		local model = Instance.new(\"Model\")\n		model.Name = `{body.Name}Unit`\n		model.Parent = furniture\n\n		-- The hollow: a dark recess set into the body's face.\n		part(\n			model,\n			\"Slot\",\n			CFrame.new(body.Position + Vector3.new(0, 0, facing * (depth / 2 - 0.9))),\n			Vector3.new(width - 0.8, height - 1.2, 1.4),\n			SMOOTH,\n			Color3.fromRGB(28, 32, 40)\n		).CanCollide = false\n\n		local leaf = part(\n			model,\n			\"LockerDoor\",\n			CFrame.new(body.Position + Vector3.new(0, 0, facing * (depth / 2 + 0.15))),\n			Vector3.new(width - 0.3, height - 0.6, 0.3),\n			Enum.Material.Metal,\n			body.Color\n		)\n		leaf.CanCollide = false\n		model.PrimaryPart = leaf\n\n		promptOn(leaf, \"Open/Close\", \"Locker\", Enum.KeyCode.E).Triggered:Connect(hinge(leaf, 45, -1, LOCKER_SWING, nil))\n		made += 1\n	end\n	return made\nend\n\n-- ---------------------------------------------------------------------------------------\n-- 3. Lighting and switches\n-- ---------------------------------------------------------------------------------------\n\n-- There were no lights in this building at all -- not one PointLight anywhere -- so the\n-- switches had nothing to switch. Fixtures come first, then the switch that owns them.\nlocal function buildLighting(origin: Vector3, lighting: Instance, architecture: Instance)\n	local fixtures, switches = 0, 0\n\n	for floor = 1, Layout.Floors do\n		local y = Layout.FloorY(floor)\n		local ceiling = y + Layout.FloorHeightStuds - 1.4\n\n		local zones: { { id: string, x1: number, x2: number, z1: number, z2: number, doorX: number, doorZ: number } } = {}\n		for _, room in Layout.RoomsOn(floor) do\n			local z1, z2 = Layout.BandZ(room.band)\n			local doorX, doorZ = (room.x1 + room.x2) / 2, z1\n			for _, opening in Layout.DoorwaysOn(floor) do\n				if opening.id == room.id then\n					doorX, doorZ = opening.x, opening.z\n				end\n			end\n			table.insert(zones, { id = room.id, x1 = room.x1, x2 = room.x2, z1 = z1, z2 = z2, doorX = doorX, doorZ = doorZ })\n		end\n		-- The corridor is a room for this purpose: it needs lights and a switch like any other.\n		table.insert(zones, {\n			id = \"corridor\",\n			x1 = Layout.CorridorX1,\n			x2 = Layout.CorridorX2,\n			z1 = Layout.CorridorZ1,\n			z2 = Layout.CorridorZ2,\n			doorX = Layout.CorridorX1 + 6,\n			doorZ = Layout.CorridorZ1,\n		})\n\n		for _, zone in zones do\n			local group = Instance.new(\"Folder\")\n			group.Name = `Lights_{zone.id}_F{floor}`\n			group.Parent = lighting\n\n			local cols = math.max(1, math.floor((zone.x2 - zone.x1) / 24))\n			local rows = math.max(1, math.floor((zone.z2 - zone.z1) / 24))\n			local owned: { PointLight } = {}\n\n			for col = 1, cols do\n				for row = 1, rows do\n					local fx = zone.x1 + (zone.x2 - zone.x1) * ((col - 0.5) / cols)\n					local fz = zone.z1 + (zone.z2 - zone.z1) * ((row - 0.5) / rows)\n					local panel = part(\n						group,\n						`Fixture{col}_{row}`,\n						CFrame.new(origin + Vector3.new(fx, ceiling, fz)),\n						Vector3.new(10, 0.4, 3),\n						Enum.Material.Neon,\n						Color3.fromRGB(250, 250, 244)\n					)\n					panel.CanCollide = false\n\n					local bulb = Instance.new(\"PointLight\")\n					bulb.Brightness = 1.6\n					bulb.Range = 42\n					bulb.Color = Color3.fromRGB(255, 250, 238)\n					bulb.Parent = panel\n					table.insert(owned, bulb)\n					fixtures += 1\n				end\n			end\n\n			-- The switch, on the wall beside that room's own door.\n			local plate = part(\n				architecture,\n				`LightSwitch_{zone.id}_F{floor}`,\n				CFrame.new(origin + Vector3.new(zone.doorX + DOOR_W / 2 + 2.5, y + 6, zone.doorZ)),\n				Vector3.new(1.6, 2.4, 0.4),\n				SMOOTH,\n				WHITE\n			)\n			plate.CanCollide = false\n			local toggle = part(\n				architecture,\n				`LightSwitchToggle_{zone.id}_F{floor}`,\n				plate.CFrame * CFrame.new(0, 0.3, -0.3),\n				Vector3.new(0.7, 1, 0.3),\n				SMOOTH,\n				BLUE\n			)\n			toggle.CanCollide = false\n\n			local on = true\n			promptOn(plate, \"Toggle Lights\", zone.id, Enum.KeyCode.E).Triggered:Connect(function()\n				on = not on\n				for _, bulb in owned do\n					bulb.Enabled = on\n				end\n				for _, fixture in group:GetChildren() do\n					if fixture:IsA(\"BasePart\") then\n						fixture.Material = if on then Enum.Material.Neon else SMOOTH\n					end\n				end\n				toggle.CFrame = plate.CFrame * CFrame.new(0, if on then 0.3 else -0.3, -0.3)\n			end)\n			switches += 1\n		end\n	end\n\n	return fixtures, switches\nend\n\n-- ---------------------------------------------------------------------------------------\n-- 4. Seating\n-- ---------------------------------------------------------------------------------------\n\n-- **An invisible Seat that cannot be touched, driven by a prompt.**\n--\n-- A Roblox Seat grabs any character that brushes it, which is the auto-sit the brief asks to be\n-- rid of, and there is no property that turns that off. `CanTouch = false` is the one that does:\n-- the seat stops firing its own touch handler entirely, so the only way onto it is `Seat:Sit`,\n-- which is what the prompt calls. The visible chair part is left exactly as built.\nlocal function makeSeat(surface: BasePart, seating: Instance): Seat\n	local seat = Instance.new(\"Seat\")\n	seat.Name = `{surface.Name}Seat`\n	seat.Size = Vector3.new(math.min(surface.Size.X, 3), 0.4, math.min(surface.Size.Z, 3))\n	seat.CFrame = surface.CFrame * CFrame.new(0, surface.Size.Y / 2 + 0.2, 0)\n	seat.Anchored = true\n	seat.CanCollide = false\n	seat.CanTouch = false\n	seat.Transparency = 1\n	seat.Parent = seating\n\n	promptOn(seat, \"Sit Down\", \"Seat\", Enum.KeyCode.L).Triggered:Connect(function(player: Player)\n		local character = player.Character\n		local humanoid = character and character:FindFirstChildOfClass(\"Humanoid\")\n		if humanoid then\n			seat:Sit(humanoid)\n		end\n	end)\n	return seat\nend\n\nlocal function buildSeating(root: Instance, furniture: Instance): number\n	local seating = Instance.new(\"Folder\")\n	seating.Name = \"Seating\"\n	seating.Parent = furniture\n\n	local made = 0\n	for _, surface in root:GetDescendants() do\n		if not surface:IsA(\"BasePart\") then\n			continue\n		end\n		-- Chair seats and cafeteria benches. Matched on the name the builders gave them, which\n		-- is the contract between Furniture.luau and this file.\n		if surface.Name:match(\"ChairSeat$\") or surface.Name:match(\"^CafeBench%d\") then\n			makeSeat(surface, seating)\n			made += 1\n		end\n	end\n	return made\nend\n\n-- ---------------------------------------------------------------------------------------\n-- 5. Lunch counter\n-- ---------------------------------------------------------------------------------------\n\nlocal function buildLunchCounter(origin: Vector3, furniture: Instance)\n	local kitchen\n	for _, room in Layout.RoomsOn(1) do\n		if room.kind == \"kitchen\" then\n			kitchen = room\n		end\n	end\n	if kitchen == nil then\n		return false\n	end\n\n	local z1 = Layout.BackBandZ1\n	local cx = (kitchen.x1 + kitchen.x2) / 2\n	local model = Instance.new(\"Model\")\n	model.Name = \"LunchCounter\"\n	model.Parent = furniture\n\n	local counter = part(\n		model,\n		\"Counter\",\n		CFrame.new(origin + Vector3.new(cx, 3, z1 + 6)),\n		Vector3.new(kitchen.x2 - kitchen.x1 - 16, 0.6, 5),\n		SMOOTH,\n		Color3.fromRGB(206, 212, 222)\n	)\n	part(\n		model,\n		\"CounterBody\",\n		CFrame.new(origin + Vector3.new(cx, 1.5, z1 + 6)),\n		Vector3.new(kitchen.x2 - kitchen.x1 - 16, 3, 4.4),\n		SMOOTH,\n		WHITE\n	)\n	part(\n		model,\n		\"SneezeGuard\",\n		CFrame.new(origin + Vector3.new(cx, 6.5, z1 + 4)),\n		Vector3.new(kitchen.x2 - kitchen.x1 - 16, 6, 0.3),\n		Enum.Material.Glass,\n		GLASS_TINT\n	).CanCollide = false\n	model.PrimaryPart = counter\n\n	-- The tool handed out. Built once and cloned, so two hundred lunches are one template.\n	local template = Instance.new(\"Tool\")\n	template.Name = \"School Lunch\"\n	template.CanBeDropped = true\n	local tray = Instance.new(\"Part\")\n	tray.Name = \"Handle\"\n	tray.Size = Vector3.new(3, 0.4, 2.2)\n	tray.Color = Color3.fromRGB(212, 96, 84)\n	tray.Material = SMOOTH\n	tray.TopSurface = Enum.SurfaceType.Smooth\n	tray.BottomSurface = Enum.SurfaceType.Smooth\n	tray.Parent = template\n\n	promptOn(counter, \"Get School Lunch\", \"Lunch Line\", Enum.KeyCode.E).Triggered:Connect(function(player: Player)\n		local backpack = player:FindFirstChildOfClass(\"Backpack\")\n		if backpack and backpack:FindFirstChild(\"School Lunch\") == nil then\n			template:Clone().Parent = backpack\n		end\n	end)\n	return true\nend\n\n-- ---------------------------------------------------------------------------------------\n-- 6. Administration -- seating only\n-- ---------------------------------------------------------------------------------------\n\n-- **The admin furniture is baked now, so this only makes it sittable.**\n--\n-- It used to be built here, which meant the reception desk, the principal's office and the\n-- staff room existed only while the server was running and the editor showed three empty\n-- rooms. Geometry moved to Furniture.luau; what is left is the half that genuinely cannot be\n-- baked -- a Seat and a prompt per sittable surface.\n--\n-- Matched on the names Furniture gives them. That is the seam between the two files and it is\n-- load-bearing: rename a chair there and it stops being sittable here, with no error.\nlocal ADMIN_SEATS = { \"ReceptionChair\", \"ExecChair\", \"GuestChair%-?1\", \"Couch%-?1\" }\n\nlocal function seatAdminFurniture(root: Instance, seating: Instance): number\n	local made = 0\n	for _, surface in root:GetDescendants() do\n		if not surface:IsA(\"BasePart\") then\n			continue\n		end\n		for _, pattern in ADMIN_SEATS do\n			if surface.Name:match(`^{pattern}$`) then\n				makeSeat(surface, seating)\n				made += 1\n				break\n			end\n		end\n	end\n	return made\nend\n\n-- ---------------------------------------------------------------------------------------\n-- 7. Spawns, and the stair check\n-- ---------------------------------------------------------------------------------------\n\nlocal function buildSpawns(origin: Vector3, props: Instance)\n	local lobby\n	for _, room in Layout.RoomsOn(1) do\n		if room.kind == \"lobby\" then\n			lobby = room\n		end\n	end\n	if lobby == nil then\n		return 0\n	end\n\n	local cx = (lobby.x1 + lobby.x2) / 2\n	for index = 1, 4 do\n		local spawn = Instance.new(\"SpawnLocation\")\n		spawn.Name = `LobbySpawn{index}`\n		spawn.Size = Vector3.new(6, 1, 6)\n		spawn.CFrame = CFrame.new(origin + Vector3.new(cx - 12 + (index - 1) * 8, 0.5, Layout.FrontBandZ1 + 12))\n		spawn.Anchored = true\n		spawn.CanCollide = false\n		spawn.Transparency = 1\n		spawn.Neutral = true\n		spawn.Parent = props\n		-- A SpawnLocation ships with a decal on it. Left on, four glowing pads sit in the middle\n		-- of a polished lobby floor.\n		for _, child in spawn:GetChildren() do\n			if child:IsA(\"Decal\") or child:IsA(\"Texture\") then\n				child:Destroy()\n			end\n		end\n	end\n	return 4\nend\n\n-- Are the flights actually there and reaching each floor? Measured, because the brief asks for\n-- backup teleports only *if* they are missing, and adding them regardless would be dead weight\n-- players can fall onto.\nlocal function stairsAreComplete(root: Instance): (boolean, string)\n	local tops: { [string]: number } = {}\n	for _, p in root:GetDescendants() do\n		if p:IsA(\"BasePart\") and p.Name:match(\"^Stair.+Arrival$\") then\n			tops[p.Name] = p.Position.Y + p.Size.Y / 2\n		end\n	end\n	local expected = #Layout.Stairwells * (Layout.Floors - 1)\n	local found = 0\n	for _ in tops do\n		found += 1\n	end\n	if found < expected then\n		return false, `only {found} of {expected} stair arrivals found`\n	end\n	return true, `{found} arrivals, all flights present`\nend\n\n-- ---------------------------------------------------------------------------------------\n-- Build\n-- ---------------------------------------------------------------------------------------\n\nfunction Interactive.Build(): ()\n	local root = workspace:FindFirstChild(\"ProperSchool\")\n	if root == nil then\n		warn(\"[ProperSchool] no ProperSchool model in Workspace -- nothing to make interactive\")\n		return\n	end\n\n	-- Where the building is, taken from the Roof rather than written down a second time. The\n	-- roof slab is centred on the plan and sits half a thickness under the top of the shell.\n	local roof\n	for _, p in root:GetDescendants() do\n		if p:IsA(\"BasePart\") and p.Name == \"Roof\" then\n			roof = p\n		end\n	end\n	if roof == nil then\n		warn(\"[ProperSchool] no Roof part -- cannot locate the building\")\n		return\n	end\n	local origin = Vector3.new(\n		roof.Position.X,\n		roof.Position.Y + roof.Size.Y / 2 - Layout.FloorHeightStuds * Layout.Floors,\n		roof.Position.Z\n	)\n\n	local tree = Tree.Build()\n	local props = tree.Props\n	local furniture = tree.Furniture\n	local architecture = tree.Architecture\n	local lighting = tree.Lighting\n\n	local seating = Instance.new(\"Folder\")\n	seating.Name = \"AdminSeating\"\n	seating.Parent = furniture\n\n	local doors = buildDoors(root, origin, architecture)\n	local lockers = buildLockers(root, furniture)\n	local fixtures, switches = buildLighting(origin, lighting, architecture)\n	local seats = buildSeating(root, furniture)\n	local lunch = buildLunchCounter(origin, furniture)\n	local adminSeats = seatAdminFurniture(root, seating)\n	local spawns = buildSpawns(origin, props)\n\n	local ok, note = stairsAreComplete(root)\n\n	print(\n		`[ProperSchool] interactive: {doors} doors, {lockers} lockers, {fixtures} light fixtures on `\n			.. `{switches} switches, {seats} seats, lunch counter {if lunch then \"up\" else \"missing kitchen\"}, `\n			.. `{spawns} spawns, {adminSeats} admin seats. Stairs: {note}.`\n	)\n	if not ok then\n		warn(`[ProperSchool] stairs incomplete ({note}) -- add backup teleport pads before shipping`)\n	end\nend\n\nreturn Interactive\n"
table.insert(AGES_MANIFEST, "src/server/world/ProperSchool/Interactive.luau")
AGES_SOURCES["src/server/world/ProperSchool/Interior.luau"] = "--!strict\n-- The interior walls of all three floors, built from Layout.\n--\n-- Every coordinate comes out of `Layout`; there are no dimensions written down here. See the\n-- header of that file for why that rule is absolute rather than tidy.\n\nlocal Engine = require(script.Parent.SchoolBuilderEngine)\nlocal Layout = require(script.Parent.Layout)\nlocal Tree = require(script.Parent.Tree)\n\nlocal Interior = {}\n\nlocal T = Layout.WallThicknessStuds\nlocal FH = Layout.FloorHeightStuds\nlocal DOOR_W = Layout.DoorWidthStuds\nlocal DOOR_H = Layout.DoorHeightStuds\n\nlocal PARTITION = Color3.fromRGB(228, 230, 235)\nlocal CORRIDOR_WALL = Color3.fromRGB(206, 211, 219)\nlocal TRIM = Color3.fromRGB(58, 64, 76)\nlocal GLASS_TINT = Color3.fromRGB(198, 220, 236)\nlocal COUNTER_TOP = Color3.fromRGB(52, 58, 68)\nlocal COUNTER_BODY = Color3.fromRGB(226, 228, 232)\n\n-- The two locker colours, alternating down the corridor.\nlocal ROYAL_BLUE = Color3.fromRGB(36, 78, 176)\nlocal CRIMSON = Color3.fromRGB(158, 34, 52)\n\nlocal ORIGIN = Vector3.new(0, 0, 0)\n\nlocal function place(x: number, y: number, z: number): Vector3\n	return Vector3.new(x + ORIGIN.X, y + ORIGIN.Y, z + ORIGIN.Z)\nend\n\n-- ---------------------------------------------------------------------------------------\n-- Wall helpers\n-- ---------------------------------------------------------------------------------------\n\n-- A straight partition. `axis` is which way it runs.\nlocal function partition(parent: Instance, axis: string, fixed: number, from: number, to: number, y: number, colour: Color3, height: number?)\n	local span = to - from\n	if span <= 0.05 then\n		return\n	end\n	local h = height or FH\n	local mid = (from + to) / 2\n	local position = if axis == \"x\" then place(mid, y + h / 2, fixed) else place(fixed, y + h / 2, mid)\n	local size = if axis == \"x\" then Vector3.new(span, h, T) else Vector3.new(T, h, span)\n	Engine.CreateWall(position, size, Vector3.new(0, 0, 0), Enum.Material.SmoothPlastic, colour, parent).Name = \"Partition\"\nend\n\n-- A partition with a doorway in it.\n--\n-- **Framed, not cut** -- the same constraint `CreateWindowCutout` works around, and the same\n-- answer: a pier each side and a header over the top. A doorway differs from a window only in\n-- having no sill, because the opening reaches the floor.\nlocal function doorway(parent: Instance, axis: string, fixed: number, from: number, to: number, y: number, at: number, colour: Color3)\n	local half = DOOR_W / 2\n	partition(parent, axis, fixed, from, at - half, y, colour)\n	partition(parent, axis, fixed, at + half, to, y, colour)\n\n	local headerH = FH - DOOR_H\n	if headerH > 0.05 then\n		local position = if axis == \"x\"\n			then place(at, y + DOOR_H + headerH / 2, fixed)\n			else place(fixed, y + DOOR_H + headerH / 2, at)\n		local size = if axis == \"x\" then Vector3.new(DOOR_W, headerH, T) else Vector3.new(T, headerH, DOOR_W)\n		Engine.CreateWall(position, size, Vector3.new(0, 0, 0), Enum.Material.SmoothPlastic, colour, parent).Name = \"DoorHeader\"\n	end\n\n	-- A frame round the opening, which is what stops a doorway reading as a missing panel.\n	for side = -1, 1, 2 do\n		local jambAt = at + side * (half + T / 2)\n		local position = if axis == \"x\" then place(jambAt, y + DOOR_H / 2, fixed) else place(fixed, y + DOOR_H / 2, jambAt)\n		local size = if axis == \"x\" then Vector3.new(T, DOOR_H, T * 1.6) else Vector3.new(T * 1.6, DOOR_H, T)\n		Engine.CreateWall(position, size, Vector3.new(0, 0, 0), Enum.Material.SmoothPlastic, TRIM, parent).Name = \"DoorJamb\"\n	end\nend\n\n-- A glazed partition: a low solid upstand with glass above it, divided by mullions. Used where\n-- a room should be visible from the corridor rather than shut off from it.\nlocal function glazedPartition(parent: Instance, axis: string, fixed: number, from: number, to: number, y: number, at: number)\n	local span = to - from\n	if span <= 0.05 then\n		return\n	end\n	local half = DOOR_W / 2\n\n	for _, piece in { { from, at - half }, { at + half, to } } do\n		local a, b = piece[1], piece[2]\n		local width = b - a\n		if width > 0.05 then\n			local mid = (a + b) / 2\n			-- The upstand, so the glass does not start at ankle height.\n			local upPos = if axis == \"x\" then place(mid, y + 1.5, fixed) else place(fixed, y + 1.5, mid)\n			local upSize = if axis == \"x\" then Vector3.new(width, 3, T) else Vector3.new(T, 3, width)\n			Engine.CreateWall(upPos, upSize, Vector3.new(0, 0, 0), Enum.Material.SmoothPlastic, PARTITION, parent).Name = \"GlazedUpstand\"\n\n			local glassH = DOOR_H - 3\n			local gPos = if axis == \"x\" then place(mid, y + 3 + glassH / 2, fixed) else place(fixed, y + 3 + glassH / 2, mid)\n			local gSize = if axis == \"x\" then Vector3.new(width, glassH, T * 0.4) else Vector3.new(T * 0.4, glassH, width)\n			local pane = Engine.CreateWall(gPos, gSize, Vector3.new(0, 0, 0), Enum.Material.Glass, GLASS_TINT, parent)\n			pane.Name = \"GlazedPane\"\n			pane.Transparency = 0.45\n			pane.Reflectance = 0.08\n\n			-- Mullions every six studs or so, for the same reason the entrance curtain wall has\n			-- them: undivided glass has no scale.\n			local bars = math.max(1, math.floor(width / 8))\n			for bar = 1, bars - 1 do\n				local bx = a + width * (bar / bars)\n				local mPos = if axis == \"x\" then place(bx, y + 3 + glassH / 2, fixed) else place(fixed, y + 3 + glassH / 2, bx)\n				local mSize = if axis == \"x\" then Vector3.new(0.5, glassH, T * 0.8) else Vector3.new(T * 0.8, glassH, 0.5)\n				Engine.CreateWall(mPos, mSize, Vector3.new(0, 0, 0), Enum.Material.SmoothPlastic, TRIM, parent).Name = \"GlazedMullion\"\n			end\n\n			-- The head, above the glass.\n			local headH = FH - DOOR_H\n			if headH > 0.05 then\n				local hPos = if axis == \"x\" then place(mid, y + DOOR_H + headH / 2, fixed) else place(fixed, y + DOOR_H + headH / 2, mid)\n				local hSize = if axis == \"x\" then Vector3.new(width, headH, T) else Vector3.new(T, headH, width)\n				Engine.CreateWall(hPos, hSize, Vector3.new(0, 0, 0), Enum.Material.SmoothPlastic, PARTITION, parent).Name = \"GlazedHead\"\n			end\n		end\n	end\n\n	local headerH = FH - DOOR_H\n	if headerH > 0.05 then\n		local position = if axis == \"x\"\n			then place(at, y + DOOR_H + headerH / 2, fixed)\n			else place(fixed, y + DOOR_H + headerH / 2, at)\n		local size = if axis == \"x\" then Vector3.new(DOOR_W, headerH, T) else Vector3.new(T, headerH, DOOR_W)\n		Engine.CreateWall(position, size, Vector3.new(0, 0, 0), Enum.Material.SmoothPlastic, PARTITION, parent).Name = \"DoorHeader\"\n	end\nend\n\n-- ---------------------------------------------------------------------------------------\n-- Fittings\n-- ---------------------------------------------------------------------------------------\n\n-- Lockers down a corridor wall, alternating colours.\n--\n-- Alternating rather than random: a repeating two-colour pattern reads as a decision from the\n-- end of a corridor, where a random one reads as a mistake. The run stops short of every\n-- doorway, which is what `skip` is for -- a locker across a classroom door is the same error as\n-- a column across an entrance.\nlocal function lockerRun(parent: Instance, z: number, facing: number, y: number, skips: { { number } })\n	local doorW = 4\n	local bankH = 11\n	local x = Layout.CorridorX1 + 2\n\n	local index = 0\n	while x + doorW <= Layout.CorridorX2 - 2 do\n		local blocked = false\n		for _, gap in skips do\n			if x + doorW > gap[1] and x < gap[2] then\n				blocked = true\n				x = gap[2] + 1\n				break\n			end\n		end\n		if not blocked then\n			index += 1\n			local colour = if index % 2 == 1 then ROYAL_BLUE else CRIMSON\n			local cx = x + doorW / 2\n			-- The outer face of the bank, computed rather than guessed at.\n			--\n			-- The handle and the vent were placed at a fixed 2.6 off the wall, which happens to\n			-- be the face itself -- so each one straddled it and sat 88% inside the locker. A\n			-- detail on a surface has to be offset by its own half-depth from that surface, and\n			-- the only way to get that right every time is to work it out from the body.\n			local faceZ = z + facing * (1.4 + 2.2 / 2)\n\n			Engine.CreateWall(\n				place(cx, y + 1 + bankH / 2, z + facing * 1.4),\n				Vector3.new(doorW, bankH, 2.2),\n				Vector3.new(0, 0, 0),\n				Enum.Material.Metal,\n				colour,\n				parent\n			).Name = `Locker{index}`\n			Engine.CreateWall(\n				place(cx, y + 0.5, z + facing * 1.4),\n				Vector3.new(doorW, 1, 2.6),\n				Vector3.new(0, 0, 0),\n				Enum.Material.Metal,\n				TRIM,\n				parent\n			).Name = `LockerPlinth{index}`\n			-- The two details that make a coloured box read as a locker: a handle at hand\n			-- height and a vent at the top.\n			Engine.CreateWall(\n				place(cx + doorW * 0.3, y + 1 + bankH * 0.5, faceZ + facing * 0.5),\n				Vector3.new(0.4, 1.6, 0.25),\n				Vector3.new(0, 0, 0),\n				Enum.Material.Metal,\n				Color3.fromRGB(232, 236, 244),\n				parent\n			).Name = `LockerHandle{index}`\n			Engine.CreateWall(\n				place(cx, y + 1 + bankH * 0.86, faceZ + facing * 0.5),\n				Vector3.new(doorW * 0.45, 0.8, 0.2),\n				Vector3.new(0, 0, 0),\n				Enum.Material.Metal,\n				TRIM,\n				parent\n			).Name = `LockerVent{index}`\n			x += doorW\n		end\n	end\nend\n\n-- A counter round the perimeter of a room, for the laboratories.\nlocal function perimeterCounter(parent: Instance, x1: number, x2: number, z1: number, z2: number, y: number, id: string)\n	local inset = 2.5\n	local runs = {\n		{ axis = \"x\", fixed = z1 + inset, from = x1 + inset, to = x2 - inset },\n		{ axis = \"x\", fixed = z2 - inset, from = x1 + inset, to = x2 - inset },\n		{ axis = \"z\", fixed = x1 + inset, from = z1 + inset, to = z2 - inset },\n		{ axis = \"z\", fixed = x2 - inset, from = z1 + inset, to = z2 - inset },\n	}\n	for index, run in runs do\n		local span = run.to - run.from\n		local mid = (run.from + run.to) / 2\n		local topPos = if run.axis == \"x\" then place(mid, y + 2.7, run.fixed) else place(run.fixed, y + 2.7, mid)\n		local topSize = if run.axis == \"x\" then Vector3.new(span, 0.5, 4) else Vector3.new(4, 0.5, span)\n		Engine.CreateWall(topPos, topSize, Vector3.new(0, 0, 0), Enum.Material.SmoothPlastic, COUNTER_TOP, parent).Name =\n			`{id}CounterTop{index}`\n\n		local bodyPos = if run.axis == \"x\" then place(mid, y + 1.3, run.fixed) else place(run.fixed, y + 1.3, mid)\n		local bodySize = if run.axis == \"x\" then Vector3.new(span, 2.6, 3.6) else Vector3.new(3.6, 2.6, span)\n		Engine.CreateWall(bodyPos, bodySize, Vector3.new(0, 0, 0), Enum.Material.SmoothPlastic, COUNTER_BODY, parent).Name =\n			`{id}CounterBody{index}`\n	end\nend\n\n-- ---------------------------------------------------------------------------------------\n-- Stairs\n-- ---------------------------------------------------------------------------------------\n\nlocal STAIR_TREAD = Color3.fromRGB(96, 102, 114)\nlocal STAIR_NOSING = Color3.fromRGB(214, 218, 226)\nlocal STAIR_RAIL = Color3.fromRGB(52, 58, 68)\n\n-- One storey of stair inside a shaft: two flights and a half-landing between them.\n--\n-- **A dog-leg, because a straight run does not fit.** A storey here is 20 studs, and a flight\n-- climbing 20 studs at a walkable pitch needs roughly 26 studs of floor to do it in. The shaft\n-- is 24 across. So the climb is split: half a storey out to a landing at the far wall, a turn,\n-- and half a storey back. Two flights of ten studs each need thirteen studs of run apiece,\n-- which fits twice over in the same shaft -- and it is what a real school stairwell is, for\n-- exactly this reason.\n--\n-- The two flights sit side by side across the shaft's depth, so the second passes back over\n-- open air rather than over the first.\nlocal function buildStairs(parent: Instance, shaft, floor: number)\n	local y0 = Layout.FloorY(floor)\n	local halfRise = FH / 2\n	local steps = 12\n	local stepRise = halfRise / steps\n\n	-- Which wall carries the door, and which way the first flight climbs away from it.\n	local fromDoor = shaft.x1 <= -Layout.HalfW\n	local doorX = if fromDoor then shaft.x2 else shaft.x1\n	local farX = if fromDoor then shaft.x1 else shaft.x2\n	local dir = if fromDoor then -1 else 1\n\n	local landingDepth = 5\n	local landingFar = farX + dir * -(T + landingDepth / 2)\n	local flightStartX = doorX + dir * 1\n	local flightEndX = farX + dir * -(T + landingDepth)\n	local runLen = math.abs(flightEndX - flightStartX)\n	local going = runLen / steps\n\n	-- The shaft's depth, split between the two flights with the balustrade on the join.\n	local zMid = (shaft.z1 + shaft.z2) / 2\n	local flightW = (shaft.z2 - shaft.z1 - T * 2) / 2 - 0.5\n	local zUp = zMid - flightW / 2 - 0.5\n	local zDown = zMid + flightW / 2 + 0.5\n\n	-- Each tread is solid from the flight's own base to its top surface. On a straight flight\n	-- the boxes hide behind one another and the result reads as a cast concrete stair, which is\n	-- what a school has. (The curved stairs on the old school could not do this -- their boxes\n	-- fanned out and every one showed its full height to the room.)\n	local function flight(baseY: number, z: number, startX: number, direction: number, tag: string)\n		for index = 1, steps do\n			local topY = baseY + stepRise * index\n			local cx = startX + direction * going * (index - 0.5)\n			Engine.CreateWall(\n				place(cx, (baseY + topY) / 2, z),\n				Vector3.new(going, topY - baseY, flightW),\n				Vector3.new(0, 0, 0),\n				Enum.Material.Concrete,\n				STAIR_TREAD,\n				parent\n			).Name = `Stair{tag}Step{index}`\n			-- **The nosing lies on top of the tread, not in its front face.**\n			--\n			-- A real nosing overhangs the riser, and there is no riser to overhang here: each\n			-- tread is solid from the flight's base, so the face below one tread is the *next*\n			-- tread's box. Set flush it is two-thirds inside its own step; pushed forward to fix\n			-- that it goes inside the step in front, which is worse. Laid on the surface it is a\n			-- contrast line along the edge of each tread -- which is all it was ever for -- and\n			-- it is inside nothing.\n			Engine.CreateWall(\n				place(cx + direction * going * 0.3, topY + 0.1, z),\n				Vector3.new(0.6, 0.2, flightW + 0.4),\n				Vector3.new(0, 0, 0),\n				Enum.Material.SmoothPlastic,\n				STAIR_NOSING,\n				parent\n			).Name = `Stair{tag}Nosing{index}`\n		end\n	end\n\n	local tag = `{shaft.id}F{floor}`\n	flight(y0, zUp, flightStartX, dir, `{tag}Up`)\n	flight(y0 + halfRise, zDown, flightEndX, -dir, `{tag}Down`)\n\n	-- The half-landing the first flight arrives on and the second leaves from.\n	Engine.CreateFloor(\n		place(landingFar, y0 + halfRise - 0.5, zMid),\n		Vector3.new(landingDepth, 1, shaft.z2 - shaft.z1 - T * 2),\n		Enum.Material.Concrete,\n		STAIR_TREAD,\n		parent\n	).Name = `Stair{tag}HalfLanding`\n\n	-- The arrival landing at the top, level with the floor it delivers you to. It reaches to\n	-- the shaft's inner wall so you step off it straight through the doorway; without this the\n	-- last tread hands you to the edge of the hole in the floor plate.\n	Engine.CreateFloor(\n		place(doorX + dir * 3.5, y0 + FH - 0.5, zDown),\n		Vector3.new(7, 1, flightW),\n		Enum.Material.Concrete,\n		STAIR_TREAD,\n		parent\n	).Name = `Stair{tag}Arrival`\n\n	-- A balustrade down the open side of each flight, on the line between them.\n	for _, run in {\n		{ z = zUp + flightW / 2, y = y0, tag = \"Up\" },\n		{ z = zDown - flightW / 2, y = y0 + halfRise, tag = \"Down\" },\n	} do\n		-- The run is inset at both ends rather than spanning 0..1. At the extremes a post lands\n		-- in the exterior wall at the top and in the doorway at the bottom -- a balustrade\n		-- should stop where the flight does, not carry on into the building.\n		local posts = 6\n		for index = 0, posts do\n			local share = 0.08 + (index / posts) * 0.84\n			local px = flightStartX + dir * runLen * (if run.tag == \"Up\" then share else 1 - share)\n			local py = run.y + halfRise * share + 2.2\n			Engine.CreateWall(\n				place(px, py, run.z),\n				Vector3.new(0.4, 4.4, 0.4),\n				Vector3.new(0, 0, 0),\n				Enum.Material.Metal,\n				STAIR_RAIL,\n				parent\n			).Name = `Stair{tag}{run.tag}Post{index}`\n		end\n	end\nend\n\n-- ---------------------------------------------------------------------------------------\n-- Build\n-- ---------------------------------------------------------------------------------------\n\nlocal function buildFloor(parent: Instance, floor: number)\n	local y = Layout.FloorY(floor)\n	local rooms = Layout.RoomsOn(floor)\n\n	-- ---- the shaft walls, on every floor, so a stairwell is a shaft rather than a hole\n	for _, shaft in Layout.Stairwells do\n		local inner = if shaft.x1 <= -Layout.HalfW then shaft.x2 else shaft.x1\n		-- **A doorway, not a wall.** This was solid on every floor, which made each shaft a\n		-- sealed box with a staircase in it and no way to reach the staircase. Worth stating\n		-- plainly because it is the kind of thing that looks completely finished from outside.\n		--\n		-- Stopped a wall-thickness short at each end too: run to the full corridor width and it\n		-- meets the corridor's own wall face-on and the two interpenetrate at the junction.\n		doorway(parent, \"z\", inner, shaft.z1 + T, shaft.z2 - T, y, 0, CORRIDOR_WALL)\n		partition(parent, \"x\", shaft.z1, shaft.x1, shaft.x2, y, CORRIDOR_WALL)\n		partition(parent, \"x\", shaft.z2, shaft.x1, shaft.x2, y, CORRIDOR_WALL)\n	end\n\n	-- ---- corridor walls and the rooms behind them\n	for _, room in rooms do\n		local bz1, bz2 = Layout.BandZ(room.band)\n		local corridorLine = if room.band == \"front\" then Layout.CorridorZ1 else Layout.CorridorZ2\n		local doorAt = (room.x1 + room.x2) / 2\n\n		-- The wall onto the corridor -- but only along the stretch that *is* corridor.\n		--\n		-- Where a room backs onto a stairwell the wall is plain, because there is nothing to\n		-- open onto or see into from inside a shaft. Skipping this put glazing bars from the\n		-- library's window wall inside the shaft partitions: the room band runs the full 200\n		-- studs, the corridor only the 152 between the two stairs, and a wall that ignores the\n		-- difference is a wall built through something.\n		local wx1 = math.max(room.x1, Layout.CorridorX1)\n		local wx2 = math.min(room.x2, Layout.CorridorX2)\n		partition(parent, \"x\", corridorLine, room.x1, wx1, y, CORRIDOR_WALL)\n		partition(parent, \"x\", corridorLine, wx2, room.x2, y, CORRIDOR_WALL)\n\n		if wx2 - wx1 > DOOR_W + 2 then\n			-- The door position comes from Layout.DoorwaysOn, which is also what hangs the door\n			-- panel and its prompt. Computed here as well they would agree today and drift the\n			-- first time a room moves.\n			local at = doorAt\n			for _, opening in Layout.DoorwaysOn(floor) do\n				if opening.id == room.id then\n					at = opening.x\n				end\n			end\n			if room.kind == \"library\" then\n				glazedPartition(parent, \"x\", corridorLine, wx1, wx2, y, at)\n			else\n				doorway(parent, \"x\", corridorLine, wx1, wx2, y, at, CORRIDOR_WALL)\n			end\n		else\n			partition(parent, \"x\", corridorLine, wx1, wx2, y, CORRIDOR_WALL)\n		end\n\n		-- The cross wall to the next room along. Only on the right-hand edge, so neighbours\n		-- share one wall rather than each building their own in the same place.\n		if room.x2 < Layout.HalfW - 0.05 then\n			partition(parent, \"z\", room.x2, bz1, bz2, y, PARTITION)\n		end\n\n		-- Fittings that belong to the room itself.\n		if room.kind == \"lab\" then\n			perimeterCounter(parent, room.x1, room.x2, bz1, bz2, y, room.id)\n		elseif room.kind == \"computers\" then\n			-- Benches in rows rather than round the walls: a computer lab is looked at from the\n			-- front, so the furniture faces one way.\n			for row = 1, 3 do\n				local rz = bz1 + (bz2 - bz1) * (row / 4)\n				Engine.CreateWall(\n					place((room.x1 + room.x2) / 2, y + 2.7, rz),\n					Vector3.new(room.x2 - room.x1 - 10, 0.5, 4),\n					Vector3.new(0, 0, 0),\n					Enum.Material.SmoothPlastic,\n					COUNTER_TOP,\n					parent\n				).Name = `ComputerBench{row}`\n			end\n		end\n	end\n\n	-- ---- the flights. Floors 1 and 2 each carry a storey of stair up to the floor above;\n	-- the top floor has nothing above it to climb to.\n	if floor < Layout.Floors then\n		for _, shaft in Layout.Stairwells do\n			buildStairs(parent, shaft, floor)\n		end\n	end\n\n	-- ---- lockers, on the teaching floor only\n	if floor == 2 then\n		local skips: { { number } } = {}\n		for _, room in rooms do\n			local doorAt = (room.x1 + room.x2) / 2\n			table.insert(skips, { doorAt - DOOR_W, doorAt + DOOR_W })\n		end\n		lockerRun(parent, Layout.CorridorZ1, 1, y, skips)\n		lockerRun(parent, Layout.CorridorZ2, -1, y, skips)\n	end\nend\n\n-- Lays every interior wall. `origin` is the building centre, the same one Exterior is given.\nfunction Interior.Build(origin: Vector3?, floors: { [number]: Instance }?): ()\n	ORIGIN = origin or Vector3.new(0, 0, 0)\n\n	local targets = floors\n	if targets == nil then\n		local tree = Tree.Build()\n		targets = { tree.Floor1, tree.Floor2, tree.Floor3 }\n	end\n\n	for floor = 1, Layout.Floors do\n		local parent = (targets :: { [number]: Instance })[floor]\n		if parent ~= nil then\n			buildFloor(parent, floor)\n		end\n	end\nend\n\nreturn Interior\n"
table.insert(AGES_MANIFEST, "src/server/world/ProperSchool/Interior.luau")
AGES_SOURCES["src/server/world/ProperSchool/Layout.luau"] = "--!strict\n-- The floor plan, as data. Nothing in here builds anything.\n--\n-- **This file exists because of a specific bug that cost days on the last school.** There, the\n-- corridor's position was computed in one function and the hole in the upper floor was computed\n-- in another. Both were correct in isolation; they disagreed by three studs; and the result was\n-- a corridor with no floor under it on the first storey and a bank of lockers embedded in a\n-- feature wall. Nothing errored, and it was only found by someone walking into it.\n--\n-- So the plan is written once, here, and every module that needs a coordinate reads it from\n-- this table. `Exterior` cuts its stairwell openings from `Layout.Stairwells`; `Interior` builds\n-- its shaft walls from the same rects. They cannot drift apart because there is only one of\n-- them.\n\nlocal Layout = {}\n\nLayout.WidthStuds = 200 -- along X\nLayout.DepthStuds = 120 -- along Z\nLayout.FloorHeightStuds = 20\nLayout.Floors = 3\nLayout.WallThicknessStuds = 1.5\n\nLayout.HalfW = Layout.WidthStuds / 2\nLayout.HalfD = Layout.DepthStuds / 2\n\n-- The corridor runs the length of the building, down the middle of its depth. Rooms sit in the\n-- two bands either side of it -- the front band toward the entrance, the back band behind.\nLayout.CorridorWidthStuds = 20\nLayout.CorridorZ1 = -Layout.CorridorWidthStuds / 2\nLayout.CorridorZ2 = Layout.CorridorWidthStuds / 2\n\nLayout.FrontBandZ1 = -Layout.HalfD\nLayout.FrontBandZ2 = Layout.CorridorZ1\nLayout.BackBandZ1 = Layout.CorridorZ2\nLayout.BackBandZ2 = Layout.HalfD\n\n-- Openings between a room and the corridor.\nLayout.DoorWidthStuds = 10\nLayout.DoorHeightStuds = 12\n\n-- **The two stairwells, at the ends of the corridor.**\n--\n-- At the ends rather than in the middle for the reason every school does it: a stair in the\n-- middle of a corridor splits the corridor, and a stair at the end closes it. They sit inside\n-- the corridor band so they are reached from the corridor and interrupt no room.\n--\n-- The same rects are what Exterior cuts out of every floor plate above the ground, which is\n-- what \"open ceilings for stairs\" means -- a shaft is a hole through the building, and a hole\n-- the walls know about but the floors do not is the bug this file exists to prevent.\nLayout.StairwellWidthStuds = 24\nLayout.Stairwells = {\n	{\n		id = \"West\",\n		x1 = -Layout.HalfW,\n		x2 = -Layout.HalfW + Layout.StairwellWidthStuds,\n		z1 = Layout.CorridorZ1,\n		z2 = Layout.CorridorZ2,\n	},\n	{\n		id = \"East\",\n		x1 = Layout.HalfW - Layout.StairwellWidthStuds,\n		x2 = Layout.HalfW,\n		z1 = Layout.CorridorZ1,\n		z2 = Layout.CorridorZ2,\n	},\n}\n\n-- The stretch of corridor that is actually corridor, between the two shafts.\nLayout.CorridorX1 = -Layout.HalfW + Layout.StairwellWidthStuds\nLayout.CorridorX2 = Layout.HalfW - Layout.StairwellWidthStuds\n\nexport type Room = {\n	id: string,\n	label: string,\n	band: string, -- \"front\" or \"back\"\n	x1: number,\n	x2: number,\n	kind: string,\n}\n\n-- Divides a band into n rooms of equal width. Equal by construction rather than by hand-written\n-- corners, so a change to the count cannot leave a gap or an overlap behind.\nlocal function split(band: string, entries: { { id: string, label: string, kind: string, share: number? } }): { Room }\n	local total = 0\n	for _, entry in entries do\n		total += entry.share or 1\n	end\n\n	local rooms: { Room } = {}\n	local cursor = -Layout.HalfW\n	for _, entry in entries do\n		local width = Layout.WidthStuds * ((entry.share or 1) / total)\n		table.insert(rooms, {\n			id = entry.id,\n			label = entry.label,\n			band = band,\n			x1 = cursor,\n			x2 = cursor + width,\n			kind = entry.kind,\n		})\n		cursor += width\n	end\n	return rooms\nend\n\nlocal function concat(a: { Room }, b: { Room }): { Room }\n	local out: { Room } = {}\n	for _, r in a do\n		table.insert(out, r)\n	end\n	for _, r in b do\n		table.insert(out, r)\n	end\n	return out\nend\n\n-- **Floor 1 -- public and admin.** Everything a visitor needs is on the ground and reachable\n-- without a stair: you come through the front door into the lobby, the office is beside it, and\n-- the cafeteria takes the whole back band because it is the one room the entire school is in at\n-- the same time.\n--\n-- Shares rather than coordinates: the lobby gets twice the frontage of an office because it is\n-- the room the building is entered through, and the numbers say that rather than a comment.\nLayout.Floor1 = concat(\n	split(\"front\", {\n		{ id = \"principal\", label = \"Principal's Office\", kind = \"office\", share = 1 },\n		{ id = \"staff\", label = \"Staff Room\", kind = \"staff\", share = 1 },\n		{ id = \"lobby\", label = \"Main Lobby\", kind = \"lobby\", share = 2 },\n		{ id = \"restroomM\", label = \"Restrooms\", kind = \"restroom\", share = 1 },\n		{ id = \"restroomF\", label = \"Restrooms\", kind = \"restroom\", share = 1 },\n	}),\n	split(\"back\", {\n		{ id = \"cafeteria\", label = \"Cafeteria\", kind = \"cafeteria\", share = 7 },\n		{ id = \"kitchen\", label = \"Kitchen\", kind = \"kitchen\", share = 3 },\n	})\n)\n\n-- **Floor 2 -- six identical classrooms, three a side.** Identical on purpose: a teaching floor\n-- is the one place repetition is correct, and a corridor of matching doors is what tells a\n-- player at a glance which floor they are on.\nLayout.Floor2 = concat(\n	split(\"front\", {\n		{ id = \"class1\", label = \"Classroom 1\", kind = \"classroom\" },\n		{ id = \"class2\", label = \"Classroom 2\", kind = \"classroom\" },\n		{ id = \"class3\", label = \"Classroom 3\", kind = \"classroom\" },\n	}),\n	split(\"back\", {\n		{ id = \"class4\", label = \"Classroom 4\", kind = \"classroom\" },\n		{ id = \"class5\", label = \"Classroom 5\", kind = \"classroom\" },\n		{ id = \"class6\", label = \"Classroom 6\", kind = \"classroom\" },\n	})\n)\n\n-- **Floor 3 -- the specialised rooms.** The library takes the whole front band as one volume,\n-- glazed to the corridor: a library you can see into is one people go into.\nLayout.Floor3 = concat(\n	split(\"front\", {\n		{ id = \"library\", label = \"Library & Media Centre\", kind = \"library\" },\n	}),\n	split(\"back\", {\n		{ id = \"lab1\", label = \"Science Laboratory 1\", kind = \"lab\" },\n		{ id = \"lab2\", label = \"Science Laboratory 2\", kind = \"lab\" },\n		{ id = \"computers\", label = \"Computer Lab\", kind = \"computers\" },\n	})\n)\n\nLayout.Floors_ = { Layout.Floor1, Layout.Floor2, Layout.Floor3 }\n\nfunction Layout.RoomsOn(floor: number): { Room }\n	return Layout.Floors_[floor] or {}\nend\n\nfunction Layout.FloorY(floor: number): number\n	return (floor - 1) * Layout.FloorHeightStuds\nend\n\n-- The z extent of a band, so callers never write -60 or 10 by hand.\nfunction Layout.BandZ(band: string): (number, number)\n	if band == \"front\" then\n		return Layout.FrontBandZ1, Layout.FrontBandZ2\n	end\n	return Layout.BackBandZ1, Layout.BackBandZ2\nend\n\n-- True where a stairwell shaft crosses this x on the corridor line -- the corridor's walls stop\n-- at the shafts rather than running through them.\nfunction Layout.InStairwell(x: number): boolean\n	for _, shaft in Layout.Stairwells do\n		if x >= shaft.x1 and x <= shaft.x2 then\n			return true\n		end\n	end\n	return false\nend\n\n-- **Where every doorway is, as one answer both the walls and the prompts read.**\n--\n-- Interior cuts its openings from this and Interactive hangs its door panels and prompts on it.\n-- Computed in two places instead, they would agree today and drift the first time a room moves\n-- -- which is the whole reason this file exists. See the header.\nexport type Doorway = { id: string, x: number, z: number, axis: string, y: number, floor: number }\n\nfunction Layout.DoorwaysOn(floor: number): { Doorway }\n	local out: { Doorway } = {}\n	local y = Layout.FloorY(floor)\n\n	-- One per room, on the corridor wall of its band.\n	for _, room in Layout.RoomsOn(floor) do\n		local corridorLine = if room.band == \"front\" then Layout.CorridorZ1 else Layout.CorridorZ2\n		local wx1 = math.max(room.x1, Layout.CorridorX1)\n		local wx2 = math.min(room.x2, Layout.CorridorX2)\n		if wx2 - wx1 > Layout.DoorWidthStuds + 2 then\n			local centre = (room.x1 + room.x2) / 2\n			local at = math.clamp(centre, wx1 + Layout.DoorWidthStuds, wx2 - Layout.DoorWidthStuds)\n			table.insert(out, { id = room.id, x = at, z = corridorLine, axis = \"x\", y = y, floor = floor })\n		end\n	end\n\n	-- And one into each stairwell, in its inner wall.\n	for _, shaft in Layout.Stairwells do\n		local inner = if shaft.x1 <= -Layout.HalfW then shaft.x2 else shaft.x1\n		table.insert(out, { id = `stair{shaft.id}`, x = inner, z = 0, axis = \"z\", y = y, floor = floor })\n	end\n\n	return out\nend\n\nreturn Layout\n"
