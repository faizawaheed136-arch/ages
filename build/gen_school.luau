local AGES_SOURCES = {}
local AGES_MANIFEST = {}
local AGES_PLACE = "game"
AGES_SOURCES["src/server/content/Bullies.luau"] = "--!strict\n-- Who is standing in the corridor, and what each of them is like to be stood in front of.\n--\n-- Content data, not system code. Adding somebody to the corridor is an entry in the list\n-- below; how the stare-down is scored is BullyService's business and deliberately not\n-- here, which is the same split Curriculum makes against the verbs it names.\n--\n-- The only load-bearing field is `drain`. Every one of these has the same one-key verb --\n-- hold, then let go -- so what makes one different to play against is the shape their\n-- patience falls in, and nothing else. That is the seventh requirement in the activity\n-- law taken literally: same input, different opponent, knowledge compounding across\n-- repetitions without a single button being added. A fourth bully with the same drain as\n-- one of these would be a reskin, and reskins are how a corridor stops teaching.\n--\n-- What is deliberately *not* here:\n--\n--   No slurs, no targeting, and nothing said about who anybody is. Every line below is\n--   about the toll or about the standing -- \"give it here\", \"you were not going to use\n--   it\" -- and never about the player. This game is 13+ and the corridor is the part of\n--   it most likely to be read over a shoulder; a bully who is frightening because of what\n--   they *want* needs nothing said about anybody to work, and a bully who is frightening\n--   because of what they call you is a different game that this one is not going to be.\n--\n--   No winning by being bigger. None of these can be beaten by having more of a stat --\n--   bullyNerve widens the window you are aiming at and never moves the bar for you, so a\n--   maxed life that releases badly still backs down. A corridor you outgrow rather than\n--   out-play is a corridor that stops being played.\n--\n-- The bodies are whole CastMembers rather than cast ids for the reason the type says: the\n-- cast is the handful of faces a life keeps meeting, and four interchangeable corridor\n-- kids in that list would dilute the one thing it is for. They carry ageOffset so they\n-- grow alongside the player -- a bully who was a head taller at eleven and exactly the\n-- same height at seventeen would be a prop rather than a person.\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Config = require(ReplicatedStorage:WaitForChild(\"Config\"))\nlocal Types = require(ReplicatedStorage:WaitForChild(\"Types\"))\n\ntype BullyArchetype = Types.BullyArchetype\n\nlocal Bullies = {}\n\nlocal BULLY = Config.School.Bully\n\n-- The corridor years, from Config rather than restated, so nobody can be written into a\n-- band the corridor does not run in. Someone whose band falls outside these never turns\n-- up, and a bully who silently never appears is the kind of content bug that reads as an\n-- engine bug.\nlocal MIN_AGE = BULLY.MinAge\nlocal MAX_AGE = BULLY.MaxAge\n\nlocal SOURCE: { BullyArchetype } = {\n	-- Steady, and the one the verb is learned on. Patience falls at one rate and the bar\n	-- never lies, so a player meeting the corridor for the first time can watch the two\n	-- numbers cross and understand what the release is for without being punished for\n	-- looking. Every other entry here is a departure from this one.\n	{\n		id = \"steady_toll\",\n		body = {\n			id = \"bully_steady\",\n			name = \"Griff\",\n			gender = \"male\",\n			skinColor = Color3.fromRGB(214, 168, 134),\n			-- A year older than you, and it stays a year for the whole of school. See the\n			-- note at the top about why nobody here is written as an absolute height.\n			ageOffset = 1,\n			heightScale = 1.06,\n			widthScale = 1.08,\n			headScale = 1,\n			proportionScale = 1,\n			bodyTypeScale = 0.7,\n			shirtAssetId = 0,\n			pantsAssetId = 0,\n			hairAssetId = 0,\n			shirtColor = Color3.fromRGB(92, 84, 78),\n			pantsColor = Color3.fromRGB(58, 58, 64),\n		},\n		patienceSeconds = 4.2,\n		drain = \"steady\",\n		demand = \"money\",\n		openingLine = \"Lunch money. Come on, you know how this goes.\",\n		standUpLine = \"Fine. Keep it.\",\n		backDownLine = \"Good. See you tomorrow.\",\n		minAge = MIN_AGE,\n		maxAge = MAX_AGE,\n	},\n\n	-- The bluffer, and the one with a technique in it. Patience falls fast enough that the\n	-- window looks like it is arriving early, then jumps back up once -- so releasing on\n	-- first sight loses, and waiting exactly one beat past the first opening wins.\n	--\n	-- This is the \"trivial verb with a discovered optimal technique\" the law asks for. The\n	-- input is identical to Griff's; what a player knows on the thirtieth corridor that\n	-- they did not on the first is that this one lies once, and only once.\n	{\n		id = \"bluffer_homework\",\n		body = {\n			id = \"bully_bluffer\",\n			name = \"Wren\",\n			gender = \"female\",\n			skinColor = Color3.fromRGB(176, 132, 104),\n			ageOffset = 1,\n			heightScale = 1.01,\n			widthScale = 0.96,\n			headScale = 1,\n			proportionScale = 1,\n			bodyTypeScale = 0.62,\n			shirtAssetId = 0,\n			pantsAssetId = 0,\n			hairAssetId = 0,\n			shirtColor = Color3.fromRGB(126, 76, 92),\n			pantsColor = Color3.fromRGB(48, 52, 62),\n		},\n		patienceSeconds = 3.6,\n		drain = \"bluffer\",\n		demand = \"homework\",\n		openingLine = \"That is due next period, is it not? Hand it over.\",\n		standUpLine = \"Whatever. It was not worth reading.\",\n		backDownLine = \"You were not going to use it anyway.\",\n		minAge = MIN_AGE,\n		maxAge = MAX_AGE,\n	},\n\n	-- The mirror, and the one that makes holding the wrong answer. Their patience falls in\n	-- proportion to how fast your nerve is rising, so the harder you lean the sooner they\n	-- are gone -- and the window has to be taken early, on a bar that has barely moved.\n	--\n	-- Every other opponent here rewards holding on. This one is why the verb is a release\n	-- rather than a race: a player who has only ever met Griff will hold through the window\n	-- out of habit and overcommit, which is the moment the corridor stops being one fight\n	-- repeated and starts being a thing you read.\n	{\n		id = \"mirror_seat\",\n		body = {\n			id = \"bully_mirror\",\n			name = \"Marlow\",\n			gender = \"male\",\n			skinColor = Color3.fromRGB(150, 110, 88),\n			ageOffset = 2,\n			heightScale = 1.09,\n			widthScale = 1.02,\n			headScale = 1,\n			proportionScale = 1,\n			bodyTypeScale = 0.68,\n			shirtAssetId = 0,\n			pantsAssetId = 0,\n			hairAssetId = 0,\n			shirtColor = Color3.fromRGB(64, 88, 96),\n			pantsColor = Color3.fromRGB(44, 46, 52),\n		},\n		patienceSeconds = 5.0,\n		drain = \"mirror\",\n		-- Wants nothing, which is the point of having one who does. A corridor where every\n		-- encounter has a price is a tax with faces on it; this one is only ever about who\n		-- moves first, so standing your ground here buys nothing but the standing.\n		demand = \"seat\",\n		openingLine = \"You are in my way.\",\n		standUpLine = \"...Go on, then.\",\n		backDownLine = \"Thought so.\",\n		minAge = MIN_AGE,\n		maxAge = MAX_AGE,\n	},\n\n	-- The long one, and the only one banded to the last years of school. Patience falls\n	-- slowly and steadily, so the encounter runs nearly twice as long as Griff's -- which\n	-- against the bell is the whole of the difference. Standing up to this one is a real\n	-- decision about being late, and it is the reason the second clock exists.\n	{\n		id = \"steady_long\",\n		body = {\n			id = \"bully_long\",\n			name = \"Bex\",\n			gender = \"female\",\n			skinColor = Color3.fromRGB(232, 196, 168),\n			ageOffset = 2,\n			heightScale = 1.04,\n			widthScale = 1.05,\n			headScale = 1,\n			proportionScale = 1,\n			bodyTypeScale = 0.72,\n			shirtAssetId = 0,\n			pantsAssetId = 0,\n			hairAssetId = 0,\n			shirtColor = Color3.fromRGB(104, 96, 60),\n			pantsColor = Color3.fromRGB(52, 50, 46),\n		},\n		patienceSeconds = 7.4,\n		drain = \"steady\",\n		demand = \"money\",\n		openingLine = \"I can do this all afternoon. Can you?\",\n		standUpLine = \"Huh. All right.\",\n		backDownLine = \"Told you.\",\n		-- The last three years only. A fourteen-year-old has not yet got anywhere to be that\n		-- costs them something to be late to, so the long stare would just be a long wait --\n		-- and a long wait with no decision in it is the dead time the law names first.\n		minAge = math.max(MIN_AGE, 15),\n		maxAge = MAX_AGE,\n	},\n}\n\n-- Validated at require time rather than found in play, and loudly, for the reason\n-- Curriculum states: a bully with a broken band does not error, they silently never turn\n-- up, and a corridor quietly missing somebody is close to invisible from inside the game.\nlocal byId: { [string]: BullyArchetype } = {}\nfor _, bully in SOURCE do\n	if byId[bully.id] ~= nil then\n		error(`[AGES content] duplicate bully id \"{bully.id}\"`)\n	end\n	if bully.minAge > bully.maxAge then\n		error(\n			`[AGES content] bully \"{bully.id}\" has minAge {bully.minAge} above maxAge {bully.maxAge}`\n				.. ` -- they would never turn up. Swap them.`\n		)\n	end\n	if bully.maxAge < MIN_AGE or bully.minAge > MAX_AGE then\n		error(\n			`[AGES content] bully \"{bully.id}\" stands between {bully.minAge} and {bully.maxAge},`\n				.. ` entirely outside the corridor years {MIN_AGE}-{MAX_AGE} -- they would never turn up.`\n				.. ` Widen their band or widen Config.School.Bully.MinAge/MaxAge.`\n		)\n	end\n	if bully.patienceSeconds <= 0 then\n		error(\n			`[AGES content] bully \"{bully.id}\" has patienceSeconds {bully.patienceSeconds}, which is not`\n				.. ` a length of time -- their patience would be gone before the bar was drawn.`\n		)\n	end\n	byId[bully.id] = bully\nend\n\n-- Every corridor year must have somebody in it. Without this a band edit can empty a\n-- year, and an empty year is a corridor that is simply a hallway -- which is not an error\n-- anybody would notice until they wondered where the system went.\nfor age = MIN_AGE, MAX_AGE do\n	local any = false\n	for _, bully in SOURCE do\n		if age >= bully.minAge and age <= bully.maxAge then\n			any = true\n			break\n		end\n	end\n	if not any then\n		error(\n			`[AGES content] no bully stands in the corridor at age {age}, so that whole year has`\n				.. ` nobody in it. Widen a band in content/Bullies.luau.`\n		)\n	end\nend\n\n-- Each drain has to be represented, or the corridor is one opponent wearing several\n-- names. This is the one check here that is about the *design* rather than about the\n-- data being well formed, and it is here because the failure it catches -- a corridor\n-- that stops teaching after the first encounter -- is invisible to every other check in\n-- the tree and reads as \"the system got boring\" rather than as a bug.\nfor _, drain in { \"steady\", \"bluffer\", \"mirror\" } do\n	local found = false\n	for _, bully in SOURCE do\n		if bully.drain == drain then\n			found = true\n			break\n		end\n	end\n	if not found then\n		error(\n			`[AGES content] no bully uses the \"{drain}\" drain, so the corridor has one fewer way`\n				.. ` of being played than it has archetypes. Give one of them that drain, or remove`\n				.. ` it from Types.BullyDrain.`\n		)\n	end\nend\n\n-- Who can turn up at this age, in declaration order. Empty is impossible inside the\n-- corridor years by the check above, and correct outside them.\nfunction Bullies.ForAge(age: number): { BullyArchetype }\n	local out: { BullyArchetype } = {}\n	for _, bully in SOURCE do\n		if age >= bully.minAge and age <= bully.maxAge then\n			table.insert(out, bully)\n		end\n	end\n	return out\nend\n\n-- Nil for an id that is not in the corridor. Callers holding an id from a live encounter\n-- must handle that: a bully removed from content is a bully a running stare-down may\n-- still be against, and erroring here would strand that player mid-hold.\nfunction Bullies.Get(id: string): BullyArchetype?\n	return byId[id]\nend\n\nBullies.All = SOURCE\n\nreturn Bullies\n"
table.insert(AGES_MANIFEST, "src/server/content/Bullies.luau")
AGES_SOURCES["src/server/content/Cast.luau"] = "--!strict\n-- The recurring people. Content data only -- no behavior lives here.\n--\n-- Deliberately a small fixed cast rather than generated strangers. A life is\n-- made of the same few faces turning up again and again, and the moment they are\n-- random that stops being true: the neighbor who knocks when you are nine has to\n-- be the neighbor who knocks when you are forty, or none of it means anything.\n-- It is also what makes relationship state possible later without a retrofit,\n-- since these ids are already stable and already referenced by events.\n--\n-- Every member is described by body scales and colors, which need no Roblox\n-- asset ids at all, so the cast reads as people from the first run. The asset id\n-- slots are polish: fill them from the Studio catalog and the same person gains\n-- clothes and hair without a line of logic moving. 0 means \"not chosen yet\",\n-- matching what HumanoidDescription itself uses for an empty slot.\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal Types = require(ReplicatedStorage:WaitForChild(\"Types\"))\n\nlocal Townsfolk = require(script.Parent.Townsfolk)\n\ntype CastMember = Types.CastMember\n\n-- Scales are *build*, not size: multipliers around 1 saying how far off average this\n-- person is. Age is applied on top by Config.Growth at the moment the rig is built, so\n-- an adult here at 1.0 towers over a two-year-old player without anybody having to\n-- write down that they tower -- and a peer stays a peer as the player grows.\nlocal Cast: { CastMember } = {\n	{\n		id = \"mom\",\n		name = \"Mom\",\n		gender = \"female\",\n		skinColor = Color3.fromRGB(232, 190, 160),\n		heightScale = 0.98,\n		widthScale = 0.92,\n		headScale = 1,\n		proportionScale = 1,\n		bodyTypeScale = 0.8,\n		shirtAssetId = 0,\n		pantsAssetId = 0,\n		hairAssetId = 0,\n	},\n	{\n		id = \"dad\",\n		name = \"Dad\",\n		gender = \"male\",\n		skinColor = Color3.fromRGB(226, 181, 150),\n		heightScale = 1.06,\n		widthScale = 1.05,\n		headScale = 1,\n		proportionScale = 1,\n		bodyTypeScale = 0.7,\n		shirtAssetId = 0,\n		pantsAssetId = 0,\n		hairAssetId = 0,\n	},\n	{\n		id = \"neighbor\",\n		name = \"Mr. Alderman\",\n		gender = \"male\",\n		skinColor = Color3.fromRGB(198, 152, 120),\n		heightScale = 1.02,\n		widthScale = 1.08,\n		headScale = 1,\n		proportionScale = 1,\n		bodyTypeScale = 0.75,\n		shirtAssetId = 0,\n		pantsAssetId = 0,\n		hairAssetId = 0,\n	},\n	{\n		-- The one peer in the authored cast, and so the one member with an ageOffset.\n		-- Rae used to be written at 0.9 height and 1.05 head, which was a way of saying\n		-- \"a child\" by hand -- and it was wrong twice: a shrunk adult with a normal head\n		-- is a short adult rather than a child, and a number written once meant Rae was\n		-- exactly as tall at seventeen as at six. The offset hands both jobs to\n		-- Config.Growth, so these three are back to being build: very slightly slight.\n		id = \"friend\",\n		name = \"Rae\",\n		gender = \"female\",\n		skinColor = Color3.fromRGB(168, 124, 96),\n		ageOffset = 0,\n		heightScale = 0.96,\n		widthScale = 0.95,\n		headScale = 1,\n		proportionScale = 1,\n		bodyTypeScale = 0.6,\n		shirtAssetId = 0,\n		pantsAssetId = 0,\n		hairAssetId = 0,\n	},\n	-- The four people who run the four gangs.\n	--\n	-- Here rather than in Public.luau, and that placement is forced by Public's own first\n	-- rule: nothing may reference one of those by id, and a gang boss is referenced by id\n	-- from content/Gangs.luau, holds a rung of yours, and has to be the same face the next\n	-- time you walk in. That is the definition of a cast member.\n	--\n	-- Built as adults with visibly different frames, because these four are the only\n	-- authored bodies a player will ever compare side by side -- the game points them at\n	-- all four during one decision -- and four strangers of identical build would make the\n	-- choice read as a menu of colors rather than of people.\n	{\n		id = \"gang_boss_north\",\n		name = \"Odile\",\n		gender = \"female\",\n		skinColor = Color3.fromRGB(142, 100, 74),\n		heightScale = 1.03,\n		widthScale = 0.94,\n		headScale = 1,\n		proportionScale = 1,\n		bodyTypeScale = 0.75,\n		shirtAssetId = 0,\n		pantsAssetId = 0,\n		hairAssetId = 0,\n	},\n	{\n		id = \"gang_boss_east\",\n		name = \"Bram\",\n		gender = \"male\",\n		skinColor = Color3.fromRGB(214, 172, 140),\n		heightScale = 1.11,\n		widthScale = 1.14,\n		headScale = 0.98,\n		proportionScale = 1,\n		bodyTypeScale = 0.55,\n		shirtAssetId = 0,\n		pantsAssetId = 0,\n		hairAssetId = 0,\n	},\n	{\n		id = \"gang_boss_south\",\n		name = \"Marisol\",\n		gender = \"female\",\n		skinColor = Color3.fromRGB(188, 140, 106),\n		heightScale = 0.93,\n		widthScale = 1.02,\n		headScale = 1.02,\n		proportionScale = 1,\n		bodyTypeScale = 0.9,\n		shirtAssetId = 0,\n		pantsAssetId = 0,\n		hairAssetId = 0,\n	},\n	{\n		id = \"gang_boss_west\",\n		name = \"Teodor\",\n		gender = \"male\",\n		skinColor = Color3.fromRGB(240, 205, 178),\n		heightScale = 1,\n		widthScale = 0.88,\n		headScale = 1,\n		proportionScale = 1,\n		bodyTypeScale = 0.65,\n		shirtAssetId = 0,\n		pantsAssetId = 0,\n		hairAssetId = 0,\n	},\n}\n\n-- The town's bodies, folded in behind the four. Everything downstream of this file looks\n-- a member up by id and does not care where it came from -- NPCService builds an avatar\n-- from a description either way -- so this is the whole of what it costs to have a\n-- generated population wearing real bodies.\n--\n-- Appended rather than merged in place, so `Default` stays the first authored member: the\n-- person the world sends when an event forgot to say who, and that should never be a\n-- stranger the game picked out of a hat.\nfor _, member in Townsfolk.Bodies do\n	table.insert(Cast, member)\nend\n\nlocal byId: { [string]: CastMember } = {}\nfor _, member in Cast do\n	if byId[member.id] ~= nil then\n		error(`[AGES content] duplicate cast id \"{member.id}\"`)\n	end\n	byId[member.id] = member\nend\n\nif #Cast == 0 then\n	error(\"[AGES content] the cast is empty, so no visitor event could ever be staged\")\nend\n\nreturn {\n	All = Cast,\n	ById = byId,\n	-- Who turns up when an event didn't say. Never nil: the check above\n	-- guarantees there is someone.\n	Default = Cast[1],\n}\n"
table.insert(AGES_MANIFEST, "src/server/content/Cast.luau")
AGES_SOURCES["src/server/content/Codes.luau"] = "--!strict\n-- The codes. What a player types into the box in the Codes pane, and what it pays them.\n--\n-- Content, not configuration, and the split matters. A code is a thing somebody writes on\n-- a specific day for a specific reason -- a launch, an apology for an outage, a number a\n-- video reads out -- and then retires. That is a list that gets edited constantly by hand,\n-- so it lives here beside the ribbons and the jobs rather than in `Config`, which is for\n-- numbers that tune how the game behaves.\n--\n-- Every entry has:\n--   id       the permanent key. Written into the save. **Never reuse or rename one.**\n--   code     what the player types, matched case-insensitively and space-insensitively.\n--   label    what the pane calls it afterwards, in the player's words.\n--   money    optional. Paid into the life being played.\n--   spins    optional. Added to the account.\n--   active   whether it can still be redeemed.\n--\n-- **`id` and `code` are two fields on purpose, and it is the single most important line in\n-- this file.** The save is keyed by `id`, so `code` stays editable: a code that shipped\n-- with a typo can be re-spelled tomorrow and the people who already redeemed it still\n-- cannot redeem it again. Key the save by the typed string instead and every correction\n-- ever made becomes free money for everybody who already had the old one.\n--\n-- **Retiring a code sets `active = false`; it does not delete the row.** The row is what\n-- lets the pane keep saying what a player already got out of it, and a redeemed id with no\n-- entry behind it would draw a receipt with the item missing. Deleting one is also how a\n-- code becomes redeemable twice, the day somebody adds a new entry and reaches for an id\n-- that \"is not being used any more\".\n\nexport type CodeEntry = {\n	id: string,\n	code: string,\n	label: string,\n	money: number?,\n	spins: number?,\n	active: boolean,\n}\n\nlocal Money = require(game:GetService(\"ReplicatedStorage\"):WaitForChild(\"Money\"))\n\nlocal Codes = {}\n\n-- The rewards here are deliberately small against what an hour of play pays. A code is a\n-- thank-you, not a shortcut: the moment one is worth more than a shift, the fastest way to\n-- play this game is to go and read a list of codes, and the work in it stops being the\n-- point. `AGESLAUNCH` is the largest and it is roughly one shift.\nlocal ENTRIES: { CodeEntry } = {\n	{\n		id = \"launch\",\n		code = \"AGESLAUNCH\",\n		label = \"Launch\",\n		money = 8000,\n		active = true,\n	},\n	{\n		id = \"welcome\",\n		code = \"WELCOME\",\n		label = \"Welcome\",\n		money = 2500,\n		active = true,\n	},\n	{\n		-- A spins code rather than a money one, so the pane has to render both shapes from\n		-- the first day. A reward kind that has never shipped is a reward kind that has\n		-- never been drawn, and the first one to try tends to find out in front of players.\n		id = \"firstspin\",\n		code = \"FIRSTSPIN\",\n		label = \"A pull on the house\",\n		spins = 1,\n		active = true,\n	},\n	{\n		id = \"thanks\",\n		code = \"THANKS\",\n		label = \"Thanks for playing\",\n		money = 1500,\n		spins = 1,\n		active = true,\n	},\n}\n\n-- Every code as one comparable string: uppercase, with all whitespace removed.\n--\n-- Whitespace removed rather than trimmed, because the two ways a code arrives wrong are a\n-- trailing space from a copy-paste and a space typed into the middle of one that was\n-- written with a gap in it. Trimming fixes the first and leaves the second, and the second\n-- is the one that makes a player certain the code is broken.\nfunction Codes.Normalize(input: string): string\n	return string.upper((string.gsub(input, \"%s\", \"\")))\nend\n\n-- Built once at require, so a lookup is a hash rather than a walk, and so a duplicate is\n-- caught at boot rather than by whichever of the two entries the loop happened to reach\n-- first. Two rows sharing a typed string is a content mistake that would otherwise be\n-- invisible: the code works, and one of the two rewards is simply unreachable forever.\nlocal BY_CODE: { [string]: CodeEntry } = {}\nlocal BY_ID: { [string]: CodeEntry } = {}\nfor _, entry in ENTRIES do\n	local normalized = Codes.Normalize(entry.code)\n	if normalized == \"\" then\n		error(`Codes: entry \"{entry.id}\" has an empty code. Give it something to type.`)\n	end\n	if BY_CODE[normalized] ~= nil then\n		error(\n			`Codes: \"{entry.code}\" is spelled by both \"{BY_CODE[normalized].id}\" and \"{entry.id}\". `\n				.. `One of them can never be redeemed -- change one of the strings.`\n		)\n	end\n	if BY_ID[entry.id] ~= nil then\n		error(`Codes: two entries share the id \"{entry.id}\". Ids are written into saves and must be unique.`)\n	end\n	if (entry.money or 0) <= 0 and (entry.spins or 0) <= 0 then\n		error(`Codes: \"{entry.id}\" pays nothing. Give it money, spins, or both, or delete it.`)\n	end\n	BY_CODE[normalized] = entry\n	BY_ID[entry.id] = entry\nend\n\n-- What the player typed, or nil. Takes the raw string and normalizes it here rather than\n-- asking the caller to, so there is exactly one definition of \"the same code\" in the tree.\nfunction Codes.Find(input: string): CodeEntry?\n	return BY_CODE[Codes.Normalize(input)]\nend\n\n-- By save key, for drawing the list of what an account has already used.\nfunction Codes.ById(id: string): CodeEntry?\n	return BY_ID[id]\nend\n\n-- What an entry pays, written out for a player. Lives here rather than on the client\n-- because the reward shapes are content: a code that starts paying something new should\n-- need one edit in this file, not one here and one in a pane.\nfunction Codes.Describe(entry: CodeEntry): string\n	local parts: { string } = {}\n	local money = entry.money or 0\n	if money > 0 then\n		table.insert(parts, Money.Format(money))\n	end\n	local spins = entry.spins or 0\n	if spins > 0 then\n		table.insert(parts, if spins == 1 then \"1 spin\" else `{spins} spins`)\n	end\n	return table.concat(parts, \" and \")\nend\n\n-- Exposed after the checks above have run, so nothing can hold a reference to a list that\n-- failed validation.\nCodes.Entries = ENTRIES\n\nreturn Codes\n"
table.insert(AGES_MANIFEST, "src/server/content/Codes.luau")
AGES_SOURCES["src/server/content/Countries.luau"] = "--!strict\n-- Where a life can begin. Authored, ordered, and validated at server start.\n--\n-- **What a country does today: it names you.** A life begun in Lagos is named from\n-- Lagos. That is the whole of it, and the floor is deliberate rather than unfinished.\n-- The obvious next step -- countries that hand out stat bonuses -- is one this game is\n-- not going to take: it would be AGES telling the player that people born in one place\n-- are smarter or better-looking than people born in another, which is both untrue and\n-- not a mechanic worth having. What a country is *for* later is content: the places you\n-- can go, the schools, the jobs, what money is worth. Every one of those is a fact about\n-- a society, and none of them is a modifier on a person.\n--\n-- So the names are the mechanic. They are not decoration either -- the name is the first\n-- thing the player sees about who they are, it is on the death screen at the end, and it\n-- is the one part of a life that is chosen before the life starts. A country that changes\n-- it is a country that has changed something real.\n--\n-- **Ten names per list, not fifty.** These are picked from by a shuffle button the player\n-- presses until they like the answer, so the list wants to be short enough that every\n-- entry is one somebody would actually want and long enough that pressing it twice rarely\n-- repeats. Common, current, unremarkable names on purpose: this is the name of the person\n-- the player is about to be, not a costume.\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Types = require(ReplicatedStorage:WaitForChild(\"Types\"))\n\ntype Country = Types.Country\ntype Gender = Types.Gender\n\n-- Ordered rather than a keyed map, because the menu steps through these with arrows and\n-- the order it steps in has to be a decision somebody made rather than whatever the hash\n-- happened to produce. Alphabetical by display name.\nlocal COUNTRIES: { Country } = {\n	{\n		id = \"br\",\n		name = \"Brazil\",\n		firstNamesMale = {\n			\"Bruno\", \"Caio\", \"Diego\", \"Felipe\", \"Gustavo\", \"Lucas\", \"Mateus\", \"Rafael\", \"Thiago\", \"Vinicius\",\n		},\n		firstNamesFemale = {\n			\"Amanda\", \"Beatriz\", \"Camila\", \"Fernanda\", \"Gabriela\", \"Juliana\", \"Larissa\", \"Mariana\", \"Rafaela\", \"Vitoria\",\n		},\n		lastNames = {\n			\"Almeida\", \"Barbosa\", \"Carvalho\", \"Ferreira\", \"Gomes\", \"Lima\", \"Oliveira\", \"Pereira\", \"Ribeiro\", \"Santos\",\n		},\n	},\n	{\n		id = \"fr\",\n		name = \"France\",\n		firstNamesMale = {\n			\"Antoine\", \"Bastien\", \"Clement\", \"Etienne\", \"Hugo\", \"Julien\", \"Mathis\", \"Olivier\", \"Raphael\", \"Theo\",\n		},\n		firstNamesFemale = {\n			\"Amelie\", \"Camille\", \"Chloe\", \"Elise\", \"Ines\", \"Juliette\", \"Lea\", \"Manon\", \"Noemie\", \"Sylvie\",\n		},\n		lastNames = {\n			\"Bernard\", \"Dubois\", \"Fournier\", \"Girard\", \"Lambert\", \"Leroy\", \"Marchand\", \"Moreau\", \"Petit\", \"Rousseau\",\n		},\n	},\n	{\n		id = \"in\",\n		name = \"India\",\n		firstNamesMale = {\n			\"Aditya\", \"Arjun\", \"Devan\", \"Ishaan\", \"Karthik\", \"Nikhil\", \"Rohan\", \"Sameer\", \"Varun\", \"Vikram\",\n		},\n		firstNamesFemale = {\n			\"Aisha\", \"Ananya\", \"Divya\", \"Ishita\", \"Kavya\", \"Meera\", \"Neha\", \"Priya\", \"Riya\", \"Sanya\",\n		},\n		lastNames = {\n			\"Banerjee\", \"Chopra\", \"Desai\", \"Iyer\", \"Kapoor\", \"Menon\", \"Nair\", \"Rao\", \"Sharma\", \"Verma\",\n		},\n	},\n	{\n		id = \"jp\",\n		name = \"Japan\",\n		firstNamesMale = {\n			\"Daiki\", \"Haruto\", \"Kenji\", \"Riku\", \"Ryo\", \"Sora\", \"Takumi\", \"Yuki\", \"Yuto\", \"Kaito\",\n		},\n		firstNamesFemale = {\n			\"Aoi\", \"Hana\", \"Mei\", \"Nanami\", \"Rin\", \"Sakura\", \"Yui\", \"Yuna\", \"Emi\", \"Hikari\",\n		},\n		lastNames = {\n			\"Fujita\", \"Hayashi\", \"Ishikawa\", \"Kobayashi\", \"Matsumoto\", \"Nakamura\", \"Sato\", \"Suzuki\", \"Tanaka\", \"Yamada\",\n		},\n	},\n	{\n		id = \"mx\",\n		name = \"Mexico\",\n		firstNamesMale = {\n			\"Alejandro\", \"Andres\", \"Diego\", \"Emiliano\", \"Javier\", \"Mateo\", \"Miguel\", \"Rodrigo\", \"Santiago\", \"Tomas\",\n		},\n		firstNamesFemale = {\n			\"Adriana\", \"Carmen\", \"Daniela\", \"Elena\", \"Guadalupe\", \"Isabel\", \"Lucia\", \"Regina\", \"Valeria\", \"Ximena\",\n		},\n		lastNames = {\n			\"Castillo\", \"Flores\", \"Garcia\", \"Hernandez\", \"Jimenez\", \"Morales\", \"Ramirez\", \"Reyes\", \"Torres\", \"Vargas\",\n		},\n	},\n	{\n		id = \"ng\",\n		name = \"Nigeria\",\n		firstNamesMale = {\n			\"Chidi\", \"Emeka\", \"Ifeanyi\", \"Kelechi\", \"Nnamdi\", \"Obinna\", \"Segun\", \"Tunde\", \"Uche\", \"Yemi\",\n		},\n		firstNamesFemale = {\n			\"Adaeze\", \"Amaka\", \"Chiamaka\", \"Folake\", \"Ifeoma\", \"Ngozi\", \"Nkechi\", \"Simisola\", \"Temitope\", \"Zainab\",\n		},\n		lastNames = {\n			\"Abiodun\", \"Adebayo\", \"Afolabi\", \"Chukwu\", \"Eze\", \"Nwachukwu\", \"Obi\", \"Okafor\", \"Okonkwo\", \"Oyelaran\",\n		},\n	},\n	{\n		id = \"uk\",\n		name = \"United Kingdom\",\n		firstNamesMale = {\n			\"Alfie\", \"Callum\", \"Declan\", \"Ewan\", \"Harry\", \"Liam\", \"Oliver\", \"Rhys\", \"Toby\", \"Zack\",\n		},\n		firstNamesFemale = {\n			\"Amelia\", \"Bethan\", \"Daisy\", \"Eleanor\", \"Freya\", \"Imogen\", \"Millie\", \"Niamh\", \"Poppy\", \"Sophie\",\n		},\n		lastNames = {\n			\"Ashworth\", \"Baxter\", \"Clarke\", \"Ellis\", \"Hughes\", \"Morgan\", \"Norris\", \"Pryce\", \"Whitfield\", \"Wren\",\n		},\n	},\n	{\n		id = \"us\",\n		name = \"United States\",\n		firstNamesMale = {\n			\"Andre\", \"Carter\", \"Dylan\", \"Elijah\", \"Isaiah\", \"Jonah\", \"Mason\", \"Nolan\", \"Tyler\", \"Wyatt\",\n		},\n		firstNamesFemale = {\n			\"Abigail\", \"Brooke\", \"Delaney\", \"Harper\", \"Jasmine\", \"Maya\", \"Nora\", \"Peyton\", \"Sierra\", \"Zoey\",\n		},\n		lastNames = {\n			\"Bennett\", \"Coleman\", \"Fletcher\", \"Grayson\", \"Hayes\", \"Mercer\", \"Parker\", \"Reyes\", \"Sullivan\", \"Winters\",\n		},\n	},\n}\n\nlocal Countries = {}\n\nCountries.All = COUNTRIES\n\nCountries.ById = {} :: { [string]: Country }\nfor _, country in COUNTRIES do\n	Countries.ById[country.id] = country\nend\n\n-- The country a menu opens on when the player has never picked one.\n--\n-- A real id rather than the first entry of the list, so that reordering the table above\n-- -- which is alphabetical and will be reordered the moment a country is added -- cannot\n-- silently move everybody's default somewhere else.\nCountries.DefaultId = \"us\"\n\n-- The list a name is drawn from. Public because the setup menu's shuffle, \"Surprise Me\"\n-- and the server's fallback name all have to draw from the *same* list, and three call\n-- sites each picking `if gender == \"male\" then a else b` is three chances to get it\n-- backwards.\nfunction Countries.FirstNames(country: Country, gender: Gender): { string }\n	return if gender == \"male\" then country.firstNamesMale else country.firstNamesFemale\nend\n\n-- A whole name, for the shuffle button and for anyone who declines to type one.\n--\n-- Unseeded, unlike the town: the town is a fact about the world and has to be identical\n-- for everybody, and this is one player pressing a button until they like the answer.\nfunction Countries.RollName(country: Country, gender: Gender): (string, string)\n	local firstNames = Countries.FirstNames(country, gender)\n	return firstNames[math.random(#firstNames)], country.lastNames[math.random(#country.lastNames)]\nend\n\n-- Run at server start rather than trusted, on the same rule as every other content file\n-- here: a country with an empty name list is a shuffle button that errors under the\n-- player's finger, and the id it happened to be is the only useful thing to say about it.\nlocal function validate()\n	if #COUNTRIES == 0 then\n		error(\"[AGES content] there are no countries, so no life can be started\")\n	end\n\n	local seen: { [string]: boolean } = {}\n	for _, country in COUNTRIES do\n		if country.id == \"\" then\n			error(`[AGES content] country \"{country.name}\" has an empty id`)\n		end\n		if seen[country.id] then\n			error(`[AGES content] two countries share the id \"{country.id}\"; ids are what saves store`)\n		end\n		seen[country.id] = true\n\n		if country.name == \"\" then\n			error(`[AGES content] country \"{country.id}\" has no display name`)\n		end\n\n		-- Named individually rather than checked as a group, because \"one of this\n		-- country's three name lists is empty\" sends whoever reads it back to count\n		-- three lists, and there is no reason for them to have to.\n		for label, list in\n			{\n				firstNamesMale = country.firstNamesMale,\n				firstNamesFemale = country.firstNamesFemale,\n				lastNames = country.lastNames,\n			} :: { [string]: { string } }\n		do\n			if #list == 0 then\n				error(`[AGES content] country \"{country.id}\" has an empty {label}, so it can never name anybody`)\n			end\n			for _, name in list do\n				if name == \"\" then\n					error(`[AGES content] country \"{country.id}\" has a blank entry in {label}`)\n				end\n			end\n		end\n	end\n\n	if Countries.ById[Countries.DefaultId] == nil then\n		error(\n			`[AGES content] the default country \"{Countries.DefaultId}\" is not in the list, `\n				.. `so the setup menu would open on nothing`\n		)\n	end\nend\n\nvalidate()\n\nreturn Countries\n"
table.insert(AGES_MANIFEST, "src/server/content/Countries.luau")
AGES_SOURCES["src/server/content/Curriculum.luau"] = "--!strict\n-- The timetable. Which subjects exist, what each one asks of you, and -- the only line\n-- here that is load-bearing -- which *verb* each one runs.\n--\n-- Content data, not system code. Adding a subject is an entry in the list below; giving\n-- an existing subject a real verb is one word changed on its row plus the service that\n-- implements the verb. That split is the whole point of the file: the timetable should\n-- not have to be rewritten every time a subject stops being a quiz.\n--\n-- The model is Bully's. A subject is not a topic with questions attached, it is a\n-- different thing you do with your hands, and two subjects that share a verb are the\n-- same activity wearing two names. That is a design failure, not a content gap, so\n-- every row still reading `verb = \"quiz\"` below is a debt with a date on it rather than\n-- a finished subject -- see the note on SchoolVerb in Types.\n--\n-- Not to be confused with content/Subjects.luau, which is animals and people an event\n-- can be about. Nothing here meets a dog.\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Config = require(ReplicatedStorage:WaitForChild(\"Config\"))\nlocal Types = require(ReplicatedStorage:WaitForChild(\"Types\"))\n\ntype SchoolSubject = Types.SchoolSubject\n\nlocal Curriculum = {}\n\n-- The school years, from Config rather than restated, so a subject can never be taught\n-- in a year school does not run. A subject whose band falls outside these is a subject\n-- that silently never appears, which is the kind of content bug that looks like an\n-- engine bug.\nlocal SCHOOL_START = Config.School.StartAge\nlocal SCHOOL_END = Config.School.EndAge\n\nlocal SOURCE: { SchoolSubject } = {\n	-- Science. The first subject with a verb of its own, and the reference for the rest:\n	-- a board names an ordered procedure, you walk the room clicking stations to stack\n	-- steps on a bench, and nothing is scored until you commit.\n	--\n	-- Starts at nine rather than six because the verb has a floor a six-year-old cannot\n	-- clear -- reading an ordered list off a board and holding three entries of it across\n	-- a room is the mechanic, and a player who cannot do that is not being challenged,\n	-- they are being excluded. The early years stay on the quiz path, which is the one\n	-- thing the quiz path is genuinely good at.\n	{\n		id = \"science\",\n		name = \"Science\",\n		verb = \"procedure\",\n		blurb = \"Read the procedure off the board, then walk it in order. Nothing counts until you commit the bench.\",\n		minAge = 9,\n		maxAge = SCHOOL_END,\n	},\n\n	-- Math. Kept on the quiz path deliberately and possibly forever: arithmetic under a\n	-- clock with one right answer is the one thing multiple choice models honestly, and\n	-- inventing a walking verb for it would be variety-as-fix -- a different room around\n	-- an identical decision. If it ever gets a verb it should be one where the *answer*\n	-- is a thing you build rather than pick.\n	{\n		id = \"math\",\n		name = \"Math\",\n		verb = \"quiz\",\n		blurb = \"Numbers, on a clock. Get them wrong early enough to still fix the lesson.\",\n		minAge = SCHOOL_START,\n		maxAge = SCHOOL_END,\n	},\n\n	-- Reading. The debt above is paid: the verb is *building* the word rather than knowing\n	-- it. Two words stand on the board with letters missing and there is one tray of tiles\n	-- between them, so a letter spent on one is a letter the other does not get -- which is\n	-- the whole subject. It is the only lesson here where the answer is assembled rather\n	-- than chosen, found or copied, and that is what keeps it from being one of the others\n	-- wearing a different name.\n	--\n	-- The note that used to stand here called this an unsolved problem, on the grounds that\n	-- \"a passage on the board and the answer somewhere in it\" is a quiz with more words. That\n	-- was correct about *that* shape and is left recorded because it is the trap: the way out\n	-- was not a better question, it was to stop asking one.\n	{\n		id = \"reading\",\n		name = \"Reading\",\n		verb = \"build\",\n		blurb = \"Two words, one tray of letters, and not enough of them to be careless.\",\n		minAge = SCHOOL_START,\n		maxAge = SCHOOL_END,\n	},\n\n	-- Art. Copy the study on the wall onto your canvas, one square of paint at a time,\n	-- while the study quietly changes behind your back. The only subject here that can be\n	-- soft-failed by degree without a right answer ever existing: a cell painted in the\n	-- nearest colour you were handed is worth most of a cell painted correctly, so the\n	-- score is a distance rather than a tally of rights and wrongs.\n	--\n	-- The only subject that starts at six, and the one place the mastery ladder is doing\n	-- the age-banding instead of the content. A six-year-old and a fourteen-year-old copy\n	-- the same harbour; what differs is how many tubes of paint they have been handed --\n	-- see Config.School.Art.PaletteByLevel -- so there is nothing here a small child cannot\n	-- attempt and nothing an older one has run out of.\n	{\n		id = \"art\",\n		name = \"Art\",\n		verb = \"copy\",\n		blurb = \"Copy the wall. It will not hold still, and you were not given every colour.\",\n		minAge = SCHOOL_START,\n		maxAge = 14,\n	},\n	-- Music, and the last verb this timetable owed. Four lanes, a chart you can see coming,\n	-- and one thing to be good at: being on time. It is the only subject here scored on *when*\n	-- you act rather than on what you choose, which is what keeps it from being any of the\n	-- other five with different furniture.\n	--\n	-- The band opens at eight for the reason Science opens at nine: holding a beat across four\n	-- lanes has a floor a six-year-old cannot clear, and a player who cannot is not being\n	-- challenged, they are being excluded. It runs to the end of school rather than stopping at\n	-- fourteen as it did as a stub -- there was never a reason for music to end, and that\n	-- ceiling was inherited from the placeholder rather than chosen.\n	{\n		id = \"music\",\n		name = \"Music\",\n		verb = \"keep\",\n		blurb = \"Four lanes and a downbeat. You can see it coming; that is not the hard part.\",\n		minAge = 8,\n		maxAge = SCHOOL_END,\n	},\n\n	-- PE. The join between school and sports, and the only subject on this list that does not\n	-- pay smarts.\n	--\n	-- `docs/school_and_sports.md` names it exactly: *\"PE -- a graded sports drill. Do not build\n	-- a separate PE minigame; this is the join between the two systems and it is what makes\n	-- school carry the childhood years.\"* So it awards **health into athletics**, and a good\n	-- report in PE is what a player takes with them into sport rather than into a career at a\n	-- desk. It was the one subject missing from the timetable entirely.\n	--\n	-- The verb is the golf three-click meter -- power, then placement, with an overswing zone\n	-- that buys power with time. See Config.School.PE, which holds it deliberately as a *sports*\n	-- primitive rather than a school one, because the soccer build takes the same numbers.\n	--\n	-- Runs the whole of school. Unlike Science and Music there is no floor here that a small\n	-- child cannot clear: the meter is three clicks, and being bad at it is legible at six in a\n	-- way that holding a beat across four lanes is not. It is the one subject that gets easier\n	-- to be *good* at as the character grows, because the window widens with health.\n	{\n		id = \"pe\",\n		name = \"PE\",\n		verb = \"drill\",\n		blurb = \"Power, then placement. The greedy swing is the one that costs you.\",\n		minAge = SCHOOL_START,\n		maxAge = SCHOOL_END,\n	},\n\n	-- Geography. The errand, and the one lesson where the game stops telling you where\n	-- things are: you are given a place's *name* and nothing else, and you walk. Every\n	-- other destination in AGES arrives as a lit disc with a beam over it and a distance\n	-- counting down, so taking that away is not a missing feature -- it is the entire\n	-- verb, and it is a verb no other subject can borrow because no other subject owns\n	-- the town.\n	--\n	-- Starts at eight rather than six for the same reason Science starts at nine: holding\n	-- a name in your head across a two-hundred-stud walk is the mechanic, and a player who\n	-- cannot yet read the name is not being challenged.\n	{\n		id = \"geography\",\n		name = \"Geography\",\n		verb = \"hunt\",\n		blurb = \"You get the name. You do not get the marker. Go and find it.\",\n		minAge = 8,\n		maxAge = SCHOOL_END,\n	},\n}\n\n-- Validated at require time rather than found in play, and loudly: a subject with a\n-- broken band does not error, it silently never gets taught, and a whole school year\n-- quietly missing a subject is close to invisible from inside the game.\nlocal byId: { [string]: SchoolSubject } = {}\nfor _, subject in SOURCE do\n	if byId[subject.id] ~= nil then\n		error(`[AGES content] duplicate school subject id \"{subject.id}\"`)\n	end\n	if subject.minAge > subject.maxAge then\n		error(\n			`[AGES content] school subject \"{subject.id}\" has minAge {subject.minAge} above maxAge {subject.maxAge}`\n				.. ` -- it would never be taught. Swap them.`\n		)\n	end\n	if subject.maxAge < SCHOOL_START or subject.minAge > SCHOOL_END then\n		error(\n			`[AGES content] school subject \"{subject.id}\" is taught between {subject.minAge} and {subject.maxAge},`\n				.. ` entirely outside the school years {SCHOOL_START}-{SCHOOL_END} -- it would never be taught.`\n				.. ` Widen the band or widen Config.School.StartAge/EndAge.`\n		)\n	end\n	byId[subject.id] = subject\nend\n\n-- Every school year must have something in it. Without this check a band edit can empty\n-- a year, and an empty year is a lesson that refuses at the door with no reason a player\n-- could act on.\nfor age = SCHOOL_START, SCHOOL_END do\n	local any = false\n	for _, subject in SOURCE do\n		if age >= subject.minAge and age <= subject.maxAge then\n			any = true\n			break\n		end\n	end\n	if not any then\n		error(\n			`[AGES content] no school subject is taught at age {age}, so that whole year has no lesson in it.`\n				.. ` Widen a subject's band in content/Curriculum.luau.`\n		)\n	end\nend\n\n-- The subjects a life of this age can be taught, in timetable order. Empty is\n-- impossible inside the school years by the check above, and correct outside them.\nfunction Curriculum.ForAge(age: number): { SchoolSubject }\n	local out: { SchoolSubject } = {}\n	for _, subject in SOURCE do\n		if age >= subject.minAge and age <= subject.maxAge then\n			table.insert(out, subject)\n		end\n	end\n	return out\nend\n\n-- Nil for an id that is not on the timetable. Callers that hold an id from a saved\n-- profile must handle that: a subject removed from content is a subject a live profile\n-- may still be part-way through, and erroring here would lock that life out of school.\nfunction Curriculum.Get(id: string): SchoolSubject?\n	return byId[id]\nend\n\nCurriculum.All = SOURCE\n\nreturn Curriculum\n"
table.insert(AGES_MANIFEST, "src/server/content/Curriculum.luau")
AGES_SOURCES["src/server/content/Fighters.luau"] = "--!strict\n-- The people who want a fight, and the only thing that makes them different.\n--\n-- Three archetypes, no moves between them. Every one of these is the same opponent\n-- running the same loop -- wait, wind up, strike, recover -- and what separates them is\n-- how long the wind-up lasts, how hard it lands and how often they answer with a guard\n-- instead. That is deliberate and it is the whole design: the player has three buttons\n-- and never gets a fourth, so the only place depth can come from is the opponent.\n--\n-- Read them as three different questions asked of the same control set:\n--\n--   The brawler asks \"can you wait?\" -- an enormous tell and an enormous punish window\n--   behind it, so the answer is to step around the big one and hit them while they are\n--   still recovering. A player who panics and blocks pays for it, because the brawler\n--   is the one opponent whose strike is big enough to hurt through a guard.\n--\n--   The scrapper asks \"can you stop waiting?\" -- half the tell, a third of the damage,\n--   and no rest between attacks. Sidestepping is a trap here: the window is too short\n--   to read and the stamina cost means two dodges leave you with nothing. The answer is\n--   to hold guard, let the flurry spend itself against it, and take the gap.\n--\n--   The boxer asks \"will you take the risk?\" -- they guard half the time, and a guard only\n--   breaks to a strike charged past GuardBreakShare, which sits *above* OverchargeShare by\n--   a rule the service refuses to boot without. So there is no way through a boxer's guard\n--   that does not also buy the near-second of recovery on the other side of it. There is no\n--   safe answer to a boxer, only a bet, and that is the whole point of having one.\n--\n-- Which is why the brawler is first and the boxer last. The first fight a player is\n-- ever offered should be the one whose tell is impossible to miss.\n--\n-- Bodies live here rather than in content/Cast.luau because the population you fight is\n-- not the population you befriend. Pointing at a cast id would eventually put a street\n-- tough and somebody's mother on the same rig, and the moment that happens the town\n-- stops being legible.\n--\n-- The four enforcers below are a fourth question asked of the same three archetypes\n-- above rather than a new one: one shared curve, the boxer's, because the thing that\n-- makes an enforcer a fight worth having is who they answer to, not a new tell the\n-- player has to learn. FightService tints the spawned body in the gang's color and\n-- charges the standing on the outcome; this file only says what an enforcer plays like.\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal Types = require(ReplicatedStorage:WaitForChild(\"Types\"))\n\ntype FighterDef = Types.FighterDef\n\n-- Nothing bought or uploaded, on the same reasoning the generated town uses: a fighter\n-- that needed a shopping trip before it existed would not exist.\nlocal NO_ASSETS = {\n	shirtAssetId = 0,\n	pantsAssetId = 0,\n	hairAssetId = 0,\n}\n\nlocal Fighters: { FighterDef } = {\n	{\n		id = \"brawler\",\n		name = \"Brawler\",\n		blurb = \"Winds up big and slow. Step around it and hit them while they are still swinging.\",\n		body = {\n			id = \"fighter_brawler\",\n			name = \"Deke\",\n			gender = \"male\" :: Types.Gender,\n			skinColor = Color3.fromRGB(197, 154, 118),\n			-- The one visibly large opponent in the set. Build is doing the signposting\n			-- here: you should be able to tell across a street which question is about to\n			-- be asked of you, and the heaviest hitter reading as the heaviest body is the\n			-- cheapest possible way to say it.\n			heightScale = 1.09,\n			widthScale = 1.12,\n			headScale = 1,\n			proportionScale = 1,\n			bodyTypeScale = 1,\n			shirtAssetId = NO_ASSETS.shirtAssetId,\n			pantsAssetId = NO_ASSETS.pantsAssetId,\n			hairAssetId = NO_ASSETS.hairAssetId,\n		},\n		ageYears = 31,\n		-- Tougher than the others, because the fight against him is long: the answer is\n		-- to wait for a slow tell, and waiting has to be worth doing more than twice.\n		footingScale = 1.25,\n		-- Enormous. Nobody should ever fail to see this coming, and a player who does see\n		-- it coming and still blocks should feel that they chose wrong rather than that\n		-- the game was quick.\n		windSeconds = 1.4,\n		-- The hardest hit in the file, and hard enough that GuardedFootingShare still\n		-- stings through a block. Blocking a brawler is survival, not an answer.\n		strikeFooting = 20,\n		-- The longest recovery, which is the reward for reading him. This number and\n		-- windSeconds are the same design decision seen from both ends.\n		recoverSeconds = 0.9,\n		-- Barely ever. He is here to be punished, and a defensive brawler would just be\n		-- a slower boxer.\n		guardChance = 0.1,\n		guardSeconds = 0.8,\n		restSeconds = 0.7,\n	},\n	{\n		id = \"scrapper\",\n		name = \"Scrapper\",\n		blurb = \"Fast and constant. Hold guard, let the flurry spend itself, then take the gap.\",\n		body = {\n			id = \"fighter_scrapper\",\n			name = \"Wex\",\n			gender = \"female\" :: Types.Gender,\n			skinColor = Color3.fromRGB(154, 116, 88),\n			heightScale = 0.94,\n			widthScale = 0.93,\n			headScale = 1,\n			proportionScale = 1,\n			bodyTypeScale = 1,\n			shirtAssetId = NO_ASSETS.shirtAssetId,\n			pantsAssetId = NO_ASSETS.pantsAssetId,\n			hairAssetId = NO_ASSETS.hairAssetId,\n		},\n		ageYears = 24,\n		-- Fragile. She has to be: an opponent this relentless who also took a long time\n		-- to put down would simply outlast the stamina bar, and the fight would be\n		-- decided by the pool rather than by the read.\n		footingScale = 0.8,\n		-- Half the brawler's tell. Deliberately inside the range where sidestepping is a\n		-- gamble rather than a plan -- there is time to press guard and not much more,\n		-- which is exactly the lesson.\n		windSeconds = 0.55,\n		-- Small enough that a guard turns the flurry into a stamina problem instead of a\n		-- footing one, which is the whole reason guard is the right answer to her.\n		strikeFooting = 8,\n		recoverSeconds = 0.35,\n		guardChance = 0.05,\n		guardSeconds = 0.6,\n		-- Almost none. The pressure is the personality.\n		restSeconds = 0.2,\n	},\n	{\n		id = \"boxer\",\n		name = \"Boxer\",\n		blurb = \"Guards half the time. Only a charge held past the mark will break it.\",\n		body = {\n			id = \"fighter_boxer\",\n			name = \"Ruiz\",\n			gender = \"male\" :: Types.Gender,\n			skinColor = Color3.fromRGB(120, 88, 66),\n			heightScale = 1.02,\n			widthScale = 1.01,\n			headScale = 1,\n			proportionScale = 1,\n			bodyTypeScale = 1,\n			shirtAssetId = NO_ASSETS.shirtAssetId,\n			pantsAssetId = NO_ASSETS.pantsAssetId,\n			hairAssetId = NO_ASSETS.hairAssetId,\n		},\n		ageYears = 28,\n		footingScale = 1,\n		-- Right in the middle, and that is the difficulty: there is enough time to\n		-- sidestep and enough time to guard, so neither is obviously correct and the\n		-- player has to decide rather than react.\n		windSeconds = 0.9,\n		strikeFooting = 13,\n		recoverSeconds = 0.5,\n		-- The high one. Half his answers are a guard, so half the time the player is\n		-- holding a charge into overcharge territory to break it -- and eating the near\n		-- second of recovery that costs if he drops the guard and steps in first.\n		guardChance = 0.5,\n		guardSeconds = 1.4,\n		restSeconds = 0.45,\n	},\n	{\n		id = \"enforcer_north\",\n		name = \"Ridge Enforcer\",\n		blurb = \"The Ridge sent somebody. Guards half the time, same as any boxer -- the colors are the only new thing here.\",\n		body = {\n			id = \"fighter_enforcer_north\",\n			name = \"Coyle\",\n			gender = \"male\" :: Types.Gender,\n			skinColor = Color3.fromRGB(183, 142, 108),\n			heightScale = 1.03,\n			widthScale = 1.04,\n			headScale = 1,\n			proportionScale = 1,\n			bodyTypeScale = 1,\n			shirtAssetId = NO_ASSETS.shirtAssetId,\n			pantsAssetId = NO_ASSETS.pantsAssetId,\n			hairAssetId = NO_ASSETS.hairAssetId,\n		},\n		ageYears = 29,\n		footingScale = 1,\n		windSeconds = 0.9,\n		strikeFooting = 13,\n		recoverSeconds = 0.5,\n		guardChance = 0.5,\n		guardSeconds = 1.4,\n		restSeconds = 0.45,\n		gangId = \"north\",\n	},\n	{\n		id = \"enforcer_east\",\n		name = \"Kestrel Enforcer\",\n		blurb = \"Kestrel sent somebody. Guards half the time, same as any boxer -- the colors are the only new thing here.\",\n		body = {\n			id = \"fighter_enforcer_east\",\n			name = \"Marsh\",\n			gender = \"female\" :: Types.Gender,\n			skinColor = Color3.fromRGB(140, 100, 76),\n			heightScale = 1.03,\n			widthScale = 1.04,\n			headScale = 1,\n			proportionScale = 1,\n			bodyTypeScale = 1,\n			shirtAssetId = NO_ASSETS.shirtAssetId,\n			pantsAssetId = NO_ASSETS.pantsAssetId,\n			hairAssetId = NO_ASSETS.hairAssetId,\n		},\n		ageYears = 29,\n		footingScale = 1,\n		windSeconds = 0.9,\n		strikeFooting = 13,\n		recoverSeconds = 0.5,\n		guardChance = 0.5,\n		guardSeconds = 1.4,\n		restSeconds = 0.45,\n		gangId = \"east\",\n	},\n	{\n		id = \"enforcer_south\",\n		name = \"Sable Row Enforcer\",\n		blurb = \"Sable Row sent somebody. Guards half the time, same as any boxer -- the colors are the only new thing here.\",\n		body = {\n			id = \"fighter_enforcer_south\",\n			name = \"Odum\",\n			gender = \"male\" :: Types.Gender,\n			skinColor = Color3.fromRGB(112, 79, 58),\n			heightScale = 1.03,\n			widthScale = 1.04,\n			headScale = 1,\n			proportionScale = 1,\n			bodyTypeScale = 1,\n			shirtAssetId = NO_ASSETS.shirtAssetId,\n			pantsAssetId = NO_ASSETS.pantsAssetId,\n			hairAssetId = NO_ASSETS.hairAssetId,\n		},\n		ageYears = 29,\n		footingScale = 1,\n		windSeconds = 0.9,\n		strikeFooting = 13,\n		recoverSeconds = 0.5,\n		guardChance = 0.5,\n		guardSeconds = 1.4,\n		restSeconds = 0.45,\n		gangId = \"south\",\n	},\n	{\n		id = \"enforcer_west\",\n		name = \"Old Line Enforcer\",\n		blurb = \"The Old Line sent somebody. Guards half the time, same as any boxer -- the colors are the only new thing here.\",\n		body = {\n			id = \"fighter_enforcer_west\",\n			name = \"Pruitt\",\n			gender = \"female\" :: Types.Gender,\n			skinColor = Color3.fromRGB(200, 166, 132),\n			heightScale = 1.03,\n			widthScale = 1.04,\n			headScale = 1,\n			proportionScale = 1,\n			bodyTypeScale = 1,\n			shirtAssetId = NO_ASSETS.shirtAssetId,\n			pantsAssetId = NO_ASSETS.pantsAssetId,\n			hairAssetId = NO_ASSETS.hairAssetId,\n		},\n		ageYears = 29,\n		footingScale = 1,\n		windSeconds = 0.9,\n		strikeFooting = 13,\n		recoverSeconds = 0.5,\n		guardChance = 0.5,\n		guardSeconds = 1.4,\n		restSeconds = 0.45,\n		gangId = \"west\",\n	},\n}\n\nlocal byId: { [string]: FighterDef } = {}\nfor _, def in Fighters do\n	if byId[def.id] ~= nil then\n		error(`[AGES content] duplicate fighter id \"{def.id}\"`)\n	end\n	-- A wind-up shorter than the client's own redraw is a tell nobody can see, and it\n	-- would present as an opponent who lands unavoidable hits rather than as a bad\n	-- number. Checked here because it is the one value in the file that can be wrong in\n	-- a way the fight cannot recover from.\n	if def.windSeconds <= 0 then\n		error(`[AGES content] fighter \"{def.id}\" has windSeconds {def.windSeconds}; it must be above zero or its strike lands with no tell`)\n	end\n	if def.footingScale <= 0 then\n		error(`[AGES content] fighter \"{def.id}\" has footingScale {def.footingScale}; it must be above zero or they start the fight already down`)\n	end\n	byId[def.id] = def\nend\n\nif #Fighters == 0 then\n	error(\"[AGES content] there are no fighters, so nobody could ever be squared up to\")\nend\n\nreturn {\n	All = Fighters,\n	ById = byId,\n	-- Who turns up when nothing said. The brawler, because their tell is the one that\n	-- teaches the mechanic, and the first fight a player is offered is a tutorial\n	-- whether or not it is labelled one.\n	Default = Fighters[1],\n}\n"
table.insert(AGES_MANIFEST, "src/server/content/Fighters.luau")
AGES_SOURCES["src/server/content/Flags.luau"] = "--!strict\n-- What a life remembers about itself.\n--\n-- A stat says how you are. A flag says what you did. The difference matters because\n-- stats are continuous and forgetful -- happiness decays, and by twenty nothing about\n-- the number says the dog was the reason -- while the interesting parts of a life are\n-- discrete and permanent: you either shouted at it or you knelt down, and either way\n-- that is still true forty years later.\n--\n-- This is the whole mechanism behind two things that were previously impossible to\n-- write: an event that only exists because of an earlier one, and a person who is in\n-- your life because you went and got them. Both are the same sentence -- \"because of\n-- what you did\" -- so both are the same field.\n--\n-- Every flag is declared here and nowhere else. Content refers to them by id and the\n-- loader refuses an id that is not in this table, which is the only defence against the\n-- failure this system would otherwise have by design: a mistyped `requires` is an event\n-- that is never selected, and an event that is never selected looks exactly like an\n-- event that was simply unlucky. There is no runtime symptom to notice, so the mistake\n-- has to be impossible to make rather than possible to find.\n--\n-- Flags are per life, cleared with the seen list on a new one. A friendship you earned\n-- as a child belongs to that child.\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal Types = require(ReplicatedStorage:WaitForChild(\"Types\"))\n\ntype FlagDef = Types.FlagDef\ntype FlagSet = Types.FlagSet\n\n-- Ids are lowercase words joined by underscores, checked below. Not style for its own\n-- sake: these are written by hand in six content files and compared as strings, so\n-- \"DogLover\" and \"dog_lover\" being two different flags that mean the same thing is a\n-- bug nobody would ever see, because both halves would work perfectly on their own.\nlocal ID_PATTERN = \"^[a-z][a-z0-9_]*$\"\n\nlocal SOURCE: { FlagDef } = {\n	-- Childhood. These are the first decisions a life makes and they are made before\n	-- the player understands they are deciding anything, which is exactly right: the\n	-- things that turn out to have shaped you were not presented as forks at the time.\n	{\n		id = \"dog_loved\",\n		meaning = \"Knelt down to the dog rather than backing away from it\",\n	},\n	{\n		id = \"dog_feared\",\n		meaning = \"Was frightened by the dog and has not forgotten it\",\n	},\n	{\n		id = \"climbed_stairs\",\n		meaning = \"Went up the stairs alone before anybody said it was allowed\",\n	},\n	{\n		id = \"stayed_put\",\n		meaning = \"Looked at the stairs and did not go up them\",\n	},\n	{\n		id = \"broke_it_owned_up\",\n		meaning = \"Broke something and said so\",\n	},\n	{\n		id = \"broke_it_hid_it\",\n		meaning = \"Broke something and put the pieces back together facing the wall\",\n	},\n	{\n		id = \"wandered_off\",\n		meaning = \"Went through the gap in the hedge to see what was past it\",\n	},\n\n	-- People. Set by an offer rather than by an event, which is the same sentence said\n	-- from the other end: an answer the player gave, to somebody, at a bond they had to\n	-- earn first. This one exists because the favour is the sort of thing a life carries\n	-- around afterwards -- somebody else's name is on it, and the person who would want\n	-- to hear about it is not the person who did it.\n	{\n		id = \"had_a_word_put_in\",\n		meaning = \"Had somebody put a word in for them about work\",\n	},\n\n	-- The body. Not a memory like the others but a state: this one is set by the\n	-- health loop and cleared at the next birthday rather than kept for life, and it\n	-- is declared here for the same reason the memories are -- content refers to it\n	-- by id and the loader refuses an id that is not in this table, so an illness\n	-- event with a mistyped flag is impossible rather than merely unlikely.\n	{\n		id = \"sick\",\n		meaning = \"Is unwell, and will stay that way until the next birthday\",\n	},\n\n	-- The gym. Set by a choice that amounts to actually starting to go, so later\n	-- events that presuppose a membership (\"the direct debit keeps going out\")\n	-- only fire for a life that has one. A memory, like the others: once you have\n	-- joined, you have joined.\n	{\n		id = \"gym_joined\",\n		meaning = \"Started going to the gym, whether the habit lasted\",\n	},\n\n	-- Debt. The one number in the game that compounds against the player. Flags\n	-- here let content react to a life being in the red rather than letting the\n	-- number sit invisible and only punishing.\n	{\n		id = \"in_debt\",\n		meaning = \"Owes money on monthly bills, and the interest is still running\",\n	},\n	{\n		id = \"loan_shark_deal\",\n		meaning = \"Took a loan shark up on an offer when bills became too much\",\n	},\n	{\n		id = \"debt_relief\",\n		meaning = \"Had debt cleared or reduced by something other than working it off\",\n	},\n\n	-- Careers. Set the first time a life steps into a job category, so later\n	-- events can branch off what the life has already done rather than only\n	-- what the life is doing right now. Cleared on death with the rest of the\n	-- flag set, because a new life has not earned any of these.\n	{\n		id = \"career_shop\",\n		meaning = \"Worked the shop floor at some point, which is where most careers start\",\n	},\n	{\n		id = \"career_office\",\n		meaning = \"Worked upstairs in the office, past the stairs that separate the two worlds\",\n	},\n	{\n		id = \"career_bakery\",\n		meaning = \"Worked the bakery, early mornings and flour in the hair\",\n	},\n	{\n		id = \"career_trades\",\n		meaning = \"Worked with your hands outside a shop or office — garage, site, warehouse\",\n	},\n	{\n		id = \"career_retired\",\n		meaning = \"Left the workforce deliberately, not because something pushed you out\",\n	},\n\n	-- The park. Set by choices that make the park a regular part of a life, so\n	-- later events can treat it as a place the life already knows rather than\n	-- somewhere they are visiting for the first time.\n	{\n		id = \"park_regular\",\n		meaning = \"Visits the park often enough that it is a real place in their life\",\n	},\n	{\n		id = \"park_first_swings\",\n		meaning = \"Went on the swings as a small child and liked it\",\n	},\n	{\n		id = \"park_confession\",\n		meaning = \"Had an important conversation at the park that changed something\",\n	},\n	{\n		id = \"park_gang_untouched\",\n		meaning = \"Was near the west gang at the park and walked away clean\",\n	},\n\n	-- Crime. The mechanical systems (theft, bounty, police, gangs) track their own\n	-- state; these flags are the narrative hooks that let life events react to what\n	-- the player has done rather than only what they are doing right now. A flag set\n	-- here is the difference between \"you got caught\" as a number and as a memory.\n	{\n		id = \"first_crime\",\n		meaning = \"Stole something for the first time, small and stupid, before knowing it had a name\",\n	},\n	{\n		id = \"busted\",\n		meaning = \"Was caught red-handed while trying to steal, and the memory is fresh\",\n	},\n	{\n		id = \"convicted\",\n		meaning = \"Was found guilty and spent time in custody; the record does not go away\",\n	},\n	{\n		id = \"on_parole\",\n		meaning = \"Recently released from custody and still subject to supervision\",\n	},\n	{\n		id = \"gang_recruited\",\n		meaning = \"A gang member approached you after you showed you could cause trouble\",\n	},\n	{\n		id = \"escalated_to_big_crime\",\n		meaning = \"Took the offer to move beyond petty theft, and the consequences grew with it\",\n	},\n}\n\nlocal byId: { [string]: FlagDef } = {}\nfor _, def in SOURCE do\n	if not string.match(def.id, ID_PATTERN) then\n		error(`[AGES content] flag id \"{def.id}\" must be lowercase words joined by underscores`)\n	end\n	if byId[def.id] ~= nil then\n		error(`[AGES content] duplicate flag id \"{def.id}\"`)\n	end\n	if def.meaning == \"\" then\n		error(`[AGES content] flag \"{def.id}\" has no meaning written against it`)\n	end\n	byId[def.id] = def\nend\n\nlocal Flags = {\n	All = SOURCE,\n	ById = byId,\n}\n\n-- Refuses a list of flag ids that content has referred to. `where` is said back in the\n-- error because by the time this throws the author is looking at six content files and\n-- the useful half of the message is which line to open.\nfunction Flags.AssertKnown(ids: { string }?, where: string)\n	if ids == nil then\n		return\n	end\n	if #ids == 0 then\n		error(`[AGES content] {where} has an empty flag list; leave it out rather than writing none`)\n	end\n	local seen: { [string]: boolean } = {}\n	for _, id in ids do\n		if byId[id] == nil then\n			error(`[AGES content] {where} refers to flag \"{id}\", which is not declared in Flags.luau`)\n		end\n		if seen[id] then\n			error(`[AGES content] {where} lists flag \"{id}\" twice`)\n		end\n		seen[id] = true\n	end\nend\n\n-- The one flag id two lists must never share, said in whichever words fit the pair.\n-- Taking the sentence as an argument rather than hardcoding it is not decoration: the two\n-- callers below are different mistakes -- one is content that can never be reached, the\n-- other is two intentions written in one place -- and an error that described the wrong\n-- one would send the author looking in the wrong file.\nlocal function assertDisjoint(a: { string }?, b: { string }?, where: string, complaint: string)\n	if a == nil or b == nil then\n		return\n	end\n	local inB: { [string]: boolean } = {}\n	for _, id in b do\n		inB[id] = true\n	end\n	for _, id in a do\n		if inB[id] then\n			error(`[AGES content] {where} {complaint} flag \"{id}\"`)\n		end\n	end\nend\n\n-- Refuses a requires/forbids pair that can never be satisfied. Written as its own check\n-- because the two lists are authored separately and a flag in both is not a strict rule,\n-- it is a piece of content that has been switched off in a way that leaves no trace.\nfunction Flags.AssertSatisfiable(requires: { string }?, forbids: { string }?, where: string)\n	assertDisjoint(requires, forbids, where, \"both requires and forbids\")\nend\n\n-- Refuses an answer that sets and clears the same flag. Not resolved by documenting a\n-- winner, because a documented winner is a rule somebody has to already know to read the\n-- content correctly.\nfunction Flags.AssertNotBoth(sets: { string }?, clears: { string }?, where: string)\n	assertDisjoint(sets, clears, where, \"both sets and clears\")\nend\n\n-- The single gate, used by events, by people and by what people offer. One function\n-- rather than three, so a rule can never mean one thing for an event and another for the\n-- person the event is about.\n--\n-- Requires is all of them, not any: two flags named together read as one condition with\n-- two halves, and \"any\" is spelled by writing two pieces of content.\nfunction Flags.Meets(held: FlagSet, requires: { string }?, forbids: { string }?): boolean\n	if requires ~= nil then\n		for _, id in requires do\n			if held[id] == nil then\n				return false\n			end\n		end\n	end\n	if forbids ~= nil then\n		for _, id in forbids do\n			if held[id] ~= nil then\n				return false\n			end\n		end\n	end\n	return true\nend\n\nreturn Flags\n"
table.insert(AGES_MANIFEST, "src/server/content/Flags.luau")
AGES_SOURCES["src/server/content/Gangs.luau"] = "--!strict\n-- The four gangs. Content only -- no behavior lives here.\n--\n-- One to a side of the city, which is a promise this file makes and cannot yet keep:\n-- territory is deferred until the map expansion, so `side` is written down and read by\n-- nothing. That is deliberate rather than sloppy. Deciding four gangs' identities is a\n-- one-way door -- their colors and their names are what players will call them for the\n-- life of the game -- and doing it later, against streets that already exist, would mean\n-- re-deciding it under pressure from geometry. The seam is here; the districts hang off\n-- it when there are districts.\n--\n-- **On the colors.** These four do the most work of anything in this file. They are the\n-- band on every member's head and the only thing that tells a mixed room of players and\n-- NPCs apart at distance, so they are chosen against each other and against the world:\n-- roughly ninety degrees apart on the wheel, all saturated, none of them a color the town\n-- already uses in bulk (asphalt grey, grass green, brick red, the warm gold of a choice\n-- marker). A fifth gang would have to fit in the gaps, which is one of two reasons there\n-- are four.\n--\n-- The other reason is the boss. Each of these needs a person standing somewhere with dots\n-- over their head, and four is the point where a player can plausibly go and meet all of\n-- them before choosing rather than picking the first one they tripped over.\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal Types = require(ReplicatedStorage:WaitForChild(\"Types\"))\n\nlocal Cast = require(script.Parent.Cast)\n\ntype GangDef = Types.GangDef\n\nlocal ID_PATTERN = \"^[a-z][a-z0-9_]*$\"\n\n-- How far apart two gang colors have to be before they count as different colors.\n--\n-- This was plain RGB distance with a floor of 180, and the comment above it said it had\n-- been \"tuned so the four below pass with room\". They did not pass. Two pairs were under\n-- the floor, this file threw at require time, and because `init.server.luau` requires it\n-- on the boot path with no pcall around it, the symptom was not a color warning -- it was\n-- a game that loaded with no services in it at all.\n--\n-- The reflex fix is to move a color until the number goes green. That would have been\n-- wrong, because the number was measuring the wrong thing. Raw RGB distance does not\n-- order these four the way an eye does, and the proof is in the pairs it was ranking:\n--\n--   east/south   RGB 155.9 -- REJECTED -- but 96.2 apart perceptually\n--   north/west   RGB 208.0 -- accepted -- and only 95.0 apart perceptually\n--\n-- It rejected a pair that is *further* apart to look at than a pair it let through. A\n-- threshold laid over a metric that misorders its own inputs cannot mean what it claims,\n-- so no value of it would have been correct and moving a color to satisfy it would have\n-- been moving a color to satisfy a broken ruler.\n--\n-- So the ruler is replaced, not the colors. CIE76 in L*a*b* below, which is a real\n-- perceptual space, and the floor is measured off both ends rather than picked:\n--\n--   * The failure being guarded against is a fifth gang added in a shade of an existing\n--     one. Shading each of the four (15% darker, 12% lighter, 11 degrees of hue, 12% less\n--     saturated) tops out at 23.1. A floor has to sit above that or it catches nothing.\n--   * The four real colors' closest pair is 87.8. A floor has to sit below that or it\n--     rejects a palette that is already fine.\n--\n-- 50 is between them with room on both sides: 2.2x the worst near-shade, and 1.8x below\n-- the tightest real pair. For scale, 2.3 in this space is \"just noticeable\".\n--\n-- Note that shared/world/Pigments deliberately keeps raw RGB for its own color guard, and\n-- that is not an inconsistency to tidy up. There the distance feeds a *score* the player\n-- is paid on, so it has to be near in the plainest sense of near. Here nobody is scored;\n-- the only question is whether two bandanas read as two gangs across a street.\nlocal MIN_COLOR_DIFFERENCE = 50\n\n-- sRGB -> CIE L*a*b*, D65. Color3 channels are already 0-1, so there is no /255 here.\nlocal function toLab(color: Color3): (number, number, number)\n	local function linear(channel: number): number\n		if channel <= 0.04045 then\n			return channel / 12.92\n		end\n		return ((channel + 0.055) / 1.055) ^ 2.4\n	end\n\n	local r, g, b = linear(color.R), linear(color.G), linear(color.B)\n\n	-- Divided through by the D65 white point, which is what makes the result relative to\n	-- \"white under daylight\" rather than to an absolute the numbers below would not match.\n	local x = (0.4124 * r + 0.3576 * g + 0.1805 * b) / 0.95047\n	local y = (0.2126 * r + 0.7152 * g + 0.0722 * b)\n	local z = (0.0193 * r + 0.1192 * g + 0.9505 * b) / 1.08883\n\n	-- The cube root is what bends the linear numbers into even perceptual steps. The\n	-- straight-line piece below the knee keeps it from going vertical near black.\n	local function bend(t: number): number\n		if t > 0.008856 then\n			return t ^ (1 / 3)\n		end\n		return 7.787 * t + 16 / 116\n	end\n\n	x, y, z = bend(x), bend(y), bend(z)\n	return 116 * y - 16, 500 * (x - y), 200 * (y - z)\nend\n\nlocal function colorDifference(a: Color3, b: Color3): number\n	local aL, aA, aB = toLab(a)\n	local bL, bA, bB = toLab(b)\n	return math.sqrt((aL - bL) ^ 2 + (aA - bA) ^ 2 + (aB - bB) ^ 2)\nend\n\nlocal SOURCE: { GangDef } = {\n	{\n		id = \"north\",\n		name = \"The Ridge\",\n		-- Cyan. Reads coldest of the four and holds up best at dusk, which matters because\n		-- this is the color a player sees first: the north boss is the one nearest the\n		-- civic end of the city where a young life already has reasons to be.\n		color = Color3.fromRGB(64, 220, 232),\n		side = \"north\",\n		bossPlaceId = \"cinema\",\n		bossCastId = \"gang_boss_north\",\n		pitch = \"We were here before the towers. Keep your head, and the north keeps you.\",\n	},\n	{\n		id = \"east\",\n		name = \"Kestrel\",\n		-- Orange. The warmest of the four, and about as far from the game's gold accent as a\n		-- warm color can get: measured against Config.Guide.Color, this sits 42.5 away and\n		-- the best any warm color manages is 46.6. Warmth is boxed in on both sides -- the\n		-- gold marker sits at hue 41 and the heat meter's red at hue 2 -- so this is close\n		-- to the ceiling rather than a free choice, and it is why a Kestrel band is told\n		-- from a choice marker by being fabric on a body rather than by hue alone.\n		color = Color3.fromRGB(255, 138, 40),\n		side = \"east\",\n		bossPlaceId = \"gas_station\",\n		bossCastId = \"gang_boss_east\",\n		pitch = \"Everything on this side moves through us. Move with it or move.\",\n	},\n	{\n		id = \"south\",\n		name = \"Sable Row\",\n		-- Magenta. There is nothing in the generated world this color, which is exactly\n		-- why it is here -- the south gang is the one whose members are visible against the\n		-- park and the greenfield blocks, where every other palette is green.\n		color = Color3.fromRGB(236, 72, 180),\n		side = \"south\",\n		bossPlaceId = \"garage\",\n		bossCastId = \"gang_boss_south\",\n		pitch = \"Nobody down here is asking permission. Neither should you.\",\n	},\n	{\n		id = \"west\",\n		name = \"The Old Line\",\n		-- Lime. The only one of the four that sits near a natural color, and it is pushed\n		-- far enough toward yellow that it separates from grass at fifty studs. Checked on\n		-- purpose: the west runs back toward the suburb, which is the greenest ground on\n		-- the map.\n		color = Color3.fromRGB(178, 246, 60),\n		side = \"west\",\n		bossPlaceId = \"park\",\n		bossCastId = \"gang_boss_west\",\n		pitch = \"The town was ours when it was a town. It is still ours.\",\n	},\n}\n\nlocal byId: { [string]: GangDef } = {}\nlocal seenSide: { [string]: string } = {}\nlocal seenPlace: { [string]: string } = {}\n\nfor _, def in SOURCE do\n	if not string.match(def.id, ID_PATTERN) then\n		error(`[AGES content] gang id \"{def.id}\" must be lowercase words joined by underscores`)\n	end\n	if byId[def.id] ~= nil then\n		error(`[AGES content] duplicate gang id \"{def.id}\"`)\n	end\n	if def.name == \"\" then\n		error(`[AGES content] gang \"{def.id}\" has no name, so it would show as a blank line on the panel`)\n	end\n	if def.pitch == \"\" then\n		error(`[AGES content] gang \"{def.id}\" has no pitch; the panel that offers to let you in would be a blank box`)\n	end\n\n	-- Two gangs on one side is not a content error the day it is written -- it is a\n	-- territory map with a hole in it, months later, when the districts land.\n	local sideTaken = seenSide[def.side]\n	if sideTaken ~= nil then\n		error(`[AGES content] gangs \"{sideTaken}\" and \"{def.id}\" both hold the {def.side} side; one gang to a side`)\n	end\n	seenSide[def.side] = def.id\n\n	-- Two bosses at one place point would stand inside each other, and whichever spawned\n	-- second would be the only one a player could ever talk to.\n	local placeTaken = seenPlace[def.bossPlaceId]\n	if placeTaken ~= nil then\n		error(\n			`[AGES content] gangs \"{placeTaken}\" and \"{def.id}\" both post their boss at \"{def.bossPlaceId}\"; `\n				.. `they would spawn on the same spot`\n		)\n	end\n	seenPlace[def.bossPlaceId] = def.id\n\n	-- A boss with no body is a gang that can be joined by nobody, and the symptom is a\n	-- place point with nothing standing at it rather than an error anybody would connect\n	-- back to this file.\n	if Cast.ById[def.bossCastId] == nil then\n		error(\n			`[AGES content] gang \"{def.id}\" is run by cast member \"{def.bossCastId}\", `\n				.. `which is not declared in Cast.luau`\n		)\n	end\n\n	byId[def.id] = def\nend\n\n-- Every pair, checked against every other pair. Six comparisons for four gangs, once, at\n-- require time -- and the alternative is discovering in a playtest that two gangs are\n-- indistinguishable from across a street, which is the one thing the colors exist to\n-- prevent.\nfor i = 1, #SOURCE do\n	for j = i + 1, #SOURCE do\n		local difference = colorDifference(SOURCE[i].color, SOURCE[j].color)\n		if difference < MIN_COLOR_DIFFERENCE then\n			error(\n				`[AGES content] gangs \"{SOURCE[i].id}\" and \"{SOURCE[j].id}\" wear colors only `\n					.. `{string.format(\"%.1f\", difference)} apart perceptually; at least {MIN_COLOR_DIFFERENCE} `\n					.. `is needed to tell two bands apart across a street. Move one of the two colors in `\n					.. `server/content/Gangs rather than lowering the floor -- the floor is set from measurement `\n					.. `(a near-shade of an existing gang scores about 23, the four real colors' closest pair `\n					.. `scores 88) and lowering it is how a fifth gang ends up wearing a fourth gang's color.`\n			)\n		end\n	end\nend\n\nif #SOURCE == 0 then\n	error(\"[AGES content] there are no gangs, so nothing could ever be joined\")\nend\n\n-- Names a crew member is given on recruitment. One flat pool shared by all four gangs\n-- rather than one list per gang -- a recruit's *name* is not doing the identity work\n-- the color already does, so splitting the pool four ways would only mean a smaller\n-- pool per gang for no player-visible benefit.\n--\n-- Deliberately not run through Townsfolk's name generator. That generator builds a\n-- first name and a surname to fit a whole town's census; a crew member is a nickname\n-- somebody picked up, said once, by the boss who is handing them to you -- closer to\n-- how Cast.luau's own hand-authored names read than to a generated resident. Kept\n-- short for the same reason: `GangUI` and the boss panel both set this beside a nerve\n-- number in a fixed-width column, and \"Marisol Adeyemi-Whitfield, nerve 40\" wraps a\n-- row a plain \"Deja, nerve 40\" never has to.\nlocal CREW_NAMES: { string } = {\n	\"Roach\", \"Nudge\", \"Marsh\", \"Coop\", \"Deja\", \"Boone\", \"Frankie\", \"Vale\",\n	\"Odette\", \"Trick\", \"Sable\", \"Wick\", \"Posey\", \"Junior\", \"Lena\", \"Crick\",\n	\"Mabel\", \"Denny\", \"Church\", \"Iggy\", \"Reeve\", \"Bijou\", \"Tarn\", \"Osei\",\n}\n\ndo\n	local seenName: { [string]: boolean } = {}\n	for _, name in CREW_NAMES do\n		if name == \"\" then\n			error(\"[AGES content] gangs content has a blank crew name\")\n		end\n		if seenName[name] then\n			error(`[AGES content] crew name \"{name}\" is listed twice; a recruit's name would collide with itself`)\n		end\n		seenName[name] = true\n	end\nend\n\nlocal Gangs = {}\n\nGangs.All = SOURCE\nGangs.ById = byId\nGangs.CrewNames = CREW_NAMES\n\n-- The gang whose boss stands at this place point, or nil for the overwhelming majority of\n-- places, which have no boss at all. The reverse of the content table, so GangService can\n-- answer \"whose dots are these\" without walking four entries on every prompt.\nfunction Gangs.AtPlace(placeId: string): GangDef?\n	local id = seenPlace[placeId]\n	return if id ~= nil then byId[id] else nil\nend\n\nreturn Gangs\n"
table.insert(AGES_MANIFEST, "src/server/content/Gangs.luau")
AGES_SOURCES["src/server/content/Hideouts.luau"] = "--!strict\n-- Where in town you can change your clothes.\n--\n-- Content, and a short list for the same reason Tills is a short list -- but the argument\n-- here is the stronger one. A disguise deletes the police's belief about where you are, and\n-- a verb that powerful has to cost a walk. If you could change anywhere the answer to being\n-- wanted would be \"duck behind the nearest van\", which is one decision made once and is the\n-- thing this system exists to avoid. Four marks across the map means the answer is instead\n-- \"which of these can I reach from here, through a town that is looking for me\" -- and that\n-- question has a different answer every time, because the search ring is somewhere new.\n--\n-- Every id has to be a place point in the built world, the same ones PlaceService indexes,\n-- because the mark is stood up relative to one. DisguiseService checks the whole list at\n-- startup and names anything that does not resolve, rather than leaving a hideout that\n-- quietly is not there -- which the player would experience as running to a corner of the\n-- map during the worst thirty seconds of their afternoon and finding nothing.\n--\n-- The clothing store is on this list *and* on Tills, and that is the best accident in the\n-- whole system: the place you most want to be able to run to is a place you may already\n-- have robbed. Nothing enforces the tension -- the shop does not lock you out -- but a\n-- player who has just emptied its drawer and is now standing in it changing their shirt\n-- while the clerk watches is playing a better game than one who never noticed.\n\nlocal Hideouts = {}\n\n-- One place you can change.\nexport type Spot = {\n	-- The place id, which is what the mark is built against.\n	place: string,\n	-- What the mark says on it, in the world. Short, because it is read at a run.\n	label: string,\n}\n\nlocal Spots: { Spot } = {\n	-- Home. Free of any tension and deliberately so: the first time a player is wanted they\n	-- should have one obvious answer, even if it is the longest walk on the list. Learning\n	-- that the other three exist is the progression.\n	{ place = \"home\", label = \"Change\" },\n\n	-- The one you already know, because you may have robbed it.\n	{ place = \"clothing_store\", label = \"Change\" },\n\n	-- Mid-map, off the main street, and the one that makes a spree survivable: without it\n	-- the middle of town has no answer at all and every chase resolves as a run for the\n	-- edges, which is the same route every time.\n	{ place = \"gym\", label = \"Change\" },\n\n	-- The civic end, which is to say the wrong end -- a mark within sight of the police\n	-- station. It is on the list because the best escape in the game should sometimes be\n	-- the one nobody sane would take, and a player who makes it work has done something.\n	{ place = \"library\", label = \"Change\" },\n}\n\n-- Loud at require time rather than at the moment somebody sprints into a room, which is the\n-- standing rule for content in this tree and matters more here than anywhere: this list is\n-- read under pressure and a mistake in it surfaces at the least recoverable moment.\nlocal seen: { [string]: boolean } = {}\nfor index, spot in Spots do\n	if spot.place == \"\" then\n		error(`[AGES content] Hideouts[{index}] has no place id. Every hideout must name a place point.`)\n	end\n	if seen[spot.place] then\n		error(\n			`[AGES content] two hideouts claim the place \"{spot.place}\". `\n				.. `A place point can only hold one mark -- remove one of them from Hideouts.luau.`\n		)\n	end\n	seen[spot.place] = true\n	if spot.label == \"\" then\n		error(\n			`[AGES content] hideout \"{spot.place}\" has no label. `\n				.. `A mark with nothing written on it is a mark nobody runs to.`\n		)\n	end\nend\n\nHideouts.Spots = Spots\n\n-- Nil for a place with no mark in it, which is almost every place in town.\nfunction Hideouts.Get(place: string): Spot?\n	for _, spot in Spots do\n		if spot.place == place then\n			return spot\n		end\n	end\n	return nil\nend\n\nreturn Hideouts\n"
table.insert(AGES_MANIFEST, "src/server/content/Hideouts.luau")
AGES_SOURCES["src/server/content/JobTasks.luau"] = "--!strict\n-- What you are asked to do while you are on shift.\n--\n-- Content, and the reason this is a table rather than code: a shift is four real\n-- minutes and it needs eight or nine things to happen in it, so the thing that has to\n-- be cheap is *writing another one*. Adding a task here is one entry with a sentence\n-- and two numbers, and it never touches the loop that runs it.\n--\n-- Almost every task is the same mechanic -- walk onto the lit marks, in order, before\n-- the clock runs out -- and the variety is mostly in the words. That is a deliberate\n-- limit, not a first pass. The shop assistant restocking a shelf and the clerk\n-- carrying a file to the cabinet are doing exactly the same thing, and dressing them\n-- as different systems would cost a lot of code to produce a difference the player's\n-- hands cannot feel. What their hands can feel is the difference between one mark and\n-- two, and between twelve seconds and twenty.\n--\n-- The knobs that actually matter per task:\n--\n--   `spots` is the shape. One mark is \"go there and deal with it\". Two is \"fetch\n--   this and bring it back\", which is the only thing in this game that makes a\n--   workplace feel like it has a layout rather than a spot you stand on.\n--\n--   `rush` is the one exception to the paragraph above -- the only field that buys a\n--   genuinely different shape rather than a different sentence. It is one round trip\n--   per person in a queue, back to a counter that does not move, so the thing\n--   measuring the player is a line of people getting shorter rather than a bar getting\n--   emptier. One per job, on purpose: a shift made entirely of rushes is a shift with\n--   no room in it to be somewhere.\n--\n--   `customer` is who it is for, and it is the one field that changes what a task\n--   feels like without changing a single rule of it. A person walks in, stands\n--   across the last mark, and looks at you until you get there. Used sparingly on\n--   purpose -- see the note on the print run.\n--\n--   `seconds` is the pressure, and it is per task rather than global because a task\n--   with two marks in it plainly needs longer than one with a single mark. As a rule\n--   of thumb the walk is a couple of seconds a mark, so these are generous by half --\n--   the failure this loop wants is \"I got distracted\", never \"I could not physically\n--   get there\".\n--\n-- Reaching a mark no longer finishes the task by itself -- see Config.Interact's\n-- PickupKeyboardKey. It arms a prompt, and the player presses the universal pickup\n-- key to actually do the thing. That is what buys a job whose real verb is\n-- \"stretching dough\" or \"timing an oven\" its own feel without needing a bespoke panel\n-- to say so: the difference between forty-eight jobs and one job with forty-eight\n-- labels was never the marks, it was whether arriving felt like doing something.\n--\n-- Nothing here says *where*. The marks are found around wherever the player clocked\n-- on, so a job gets tasks the moment it exists, no part in Studio has to be tagged,\n-- and no author can accidentally send somebody into a wall in a room they never saw.\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Config = require(ReplicatedStorage:WaitForChild(\"Config\"))\nlocal Types = require(ReplicatedStorage:WaitForChild(\"Types\"))\n\ntype JobTask = Types.JobTask\n\nlocal JobTasks = {}\n\n-- Read by the validator below and nowhere else. These are sanity bounds on the\n-- authoring, not tuning: a task with no marks or no clock is a typo, and the point of\n-- catching it here is that the alternative symptom is a shift that quietly stops\n-- having anything in it.\nlocal MAX_SPOTS = 3\nlocal MIN_SECONDS = 4\n-- Read from Config rather than restated, so the authoring limit and the limit the\n-- shift actually enforces can never drift apart: a task authored for five people in a\n-- game that seats four is a clock scaled for work the player is never asked to do.\nlocal MAX_QUEUE = Config.Work.Customers.MaxQueue\n\n-- Written in the second person and the present tense, because the HUD shows them\n-- while the player is walking and \"Restock the shelves\" reads as an instruction where\n-- \"Restocking shelves\" reads as a status. The mark under the words is shorter still:\n-- it is read at a glance, across a room, past somebody's shoulder.\nlocal SOURCE: { [string]: { JobTask } } = {\n	shop_assistant = {\n		{\n			id = \"restock\",\n			label = \"Restock the shelves\",\n			mark = \"Restock\",\n			spots = 1,\n			seconds = 14,\n		},\n		{\n			id = \"stockroom\",\n			label = \"Fetch a box from the stockroom\",\n			mark = \"Fetch the box\",\n			handMark = \"Put it away\",\n			-- Two, and it is the first task in this game with a there-and-back shape.\n			-- The second mark is painted only once the first is reached, so the shop\n			-- floor stops being a place you stand and becomes a place you cross.\n			spots = 2,\n			seconds = 22,\n		},\n		{\n			id = \"till\",\n			label = \"Serve the customer at the till\",\n			mark = \"Serve\",\n			-- The tightest clock in the shop, on purpose, and now the only one with a\n			-- face attached to it. Being slow here is a thing you can picture because\n			-- you can see the person you are being slow to.\n			spots = 1,\n			seconds = 11,\n			customer = \"Just these, thanks.\",\n		},\n		{\n			id = \"sweep\",\n			label = \"Sweep up the aisle\",\n			mark = \"Sweep\",\n			spots = 1,\n			seconds = 15,\n		},\n		{\n			id = \"delivery\",\n			label = \"Bring the delivery in and sign for it\",\n			mark = \"Get the box\",\n			handMark = \"Sign for it\",\n			spots = 2,\n			seconds = 24,\n			-- Waiting at the *second* mark, which is where a customer always stands: the\n			-- one you have to reach to finish. On a two-mark task that means you pick the\n			-- box up and carry it to somebody, which is a better shape than being handed\n			-- it and walking away -- and it is the reason the two marks are worded in\n			-- that order rather than the other one.\n			customer = \"Delivery — sign here?\",\n		},\n		{\n			id = \"rush\",\n			label = \"Get through the queue\",\n			mark = \"Fetch it\",\n			handMark = \"Hand it over\",\n			-- The only task in the shop with a shape of its own rather than a sentence of\n			-- its own. Three people are lined up at the counter and each of them wants\n			-- something from a different part of the shop, so it is fetch, hand over,\n			-- fetch, hand over -- and the queue in front of you gets shorter every time\n			-- you make it back.\n			--\n			-- What it is for is that the other nine tasks are all \"go somewhere before a\n			-- number runs out\", and the player is looking at the number. Here they are\n			-- looking at three people, and the number is a thing they can feel without\n			-- reading. It is deliberately the only one of its kind in the shop: a shift\n			-- made entirely of rushes is a shift with no room in it to be somewhere.\n			spots = 2,\n			rush = 3,\n			-- The tightest clock per thing-done in the game, which is the whole point --\n			-- five seconds a leg against the eleven the till gets for one. Still nearly\n			-- three times what the walking actually costs, because the failure this wants\n			-- is \"I lost track\", never \"I could not physically get there\".\n			seconds = 30,\n			customer = \"Three of these, please.\",\n		},\n		{\n			id = \"display\",\n			label = \"Arrange the window display\",\n			mark = \"Set it up\",\n			spots = 1,\n			seconds = 16,\n		},\n		{\n			id = \"register\",\n			label = \"Count the register at close\",\n			mark = \"Count it\",\n			spots = 1,\n			seconds = 18,\n		},\n		{\n			id = \"find_item\",\n			label = \"Help a customer find something\",\n			mark = \"Find it\",\n			handMark = \"Bring it back\",\n			spots = 2,\n			seconds = 20,\n			customer = \"Do you have this in stock?\",\n		},\n		{\n			id = \"fetch_bag\",\n			label = \"Fetch and bag the order\",\n			mark = \"Get it\",\n			handMark = \"Bag it\",\n			-- The corner shop's signature rhythm: the customer has already chosen, the\n			-- till is idle, and the only thing between them and their purchase is you\n			-- walking the shelf and the bag. Two marks that each say something different\n			-- about what your hands are doing — get, then bag — is what makes a corner\n			-- shop feel like a place rather than a line of numbers.\n			spots = 2,\n			seconds = 18,\n			customer = \"I'll need a bag for those, please.\",\n			fetchBag = true,\n		},\n		{\n			id = \"bag\",\n			label = \"Bag the purchases\",\n			mark = \"Bag them\",\n			spots = 1,\n			seconds = 12,\n			-- A single-mark bagging task for when the player is already at the counter.\n			-- It exists so the shift is not always asking the player to leave the till,\n			-- and so a customer who has been ringing items up can hand them over without\n			-- a second walk: the bag is the last step, not the first.\n			customer = \"All done?\",\n		},\n	},\n\n	office_clerk = {\n		{\n			id = \"filing\",\n			label = \"File the morning's paperwork\",\n			mark = \"File it\",\n			spots = 1,\n			seconds = 14,\n		},\n		{\n			id = \"printer\",\n			label = \"Collect the print run\",\n			mark = \"Collect\",\n			spots = 1,\n			seconds = 12,\n			-- Not every task gets a person and this one nearly did not. A colleague\n			-- hovering by the printer is the office's version of the queue at the till,\n			-- and an office where nobody else works is a strange place to be promoted\n			-- into. The rest of the list is deliberately left empty: if every task had\n			-- somebody standing over it, having somebody standing over you would stop\n			-- meaning anything.\n			customer = \"Are these mine?\",\n		},\n		{\n			id = \"courier\",\n			label = \"Take the envelope down to the courier\",\n			mark = \"Get the envelope\",\n			handMark = \"Hand it over\",\n			spots = 2,\n			seconds = 22,\n			customer = \"For the two o'clock run?\",\n		},\n		{