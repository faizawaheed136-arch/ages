AGES_SOURCES["src/server/services/GymService.luau"] = "--!strict\n-- Gym: the room where effort becomes something you can read.\n--\n-- The loop:\n--\n--   You walk to a machine and the server notices you are there. A panel offers\n--   a workout; you press Start. A sweep bar travels left to right; you press\n--   PUSH while it is in the sweet zone. Quality is graded by how close to\n--   centre the hit lands. Ten reps or an empty stamina bar ends the session.\n--\n-- The gym is a room of machines that exist in the world as tagged parts. Nothing\n-- here builds the room -- the world is built by hand and this finds it, so\n-- replacing a machine means swapping a part in Studio and keeping the tag.\n-- A machine is a thing you stand at, not a question you sit for, which is\n-- why there are four of them in the same room and the school has one door.\n--\n-- Stats gained: health and looks. The only two a gym can move honestly --\n-- effort makes you fitter and it makes you look it, and nothing in a weight\n-- room makes you smarter. Both are capped by the per-machine yearly limit\n-- so a session is a meaningful investment rather than a button you can hammer.\n\nlocal Players = game:GetService(\"Players\")\nlocal CollectionService = game:GetService(\"CollectionService\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Config = require(ReplicatedStorage:WaitForChild(\"Config\"))\nlocal Remotes = require(ReplicatedStorage:WaitForChild(\"Remotes\"))\nlocal Types = require(ReplicatedStorage:WaitForChild(\"Types\"))\nlocal Lives = require(ReplicatedStorage:WaitForChild(\"Lives\"))\nlocal Sweep = require(ReplicatedStorage:WaitForChild(\"Sweep\"))\n\nlocal DataService = require(script.Parent.DataService)\nlocal StatService = require(script.Parent.StatService)\nlocal SkillService = require(script.Parent.SkillService)\nlocal Ground = require(script.Parent.Parent.world.Ground)\nlocal GymRoom = require(script.Parent.Parent.world.GymRoom)\nlocal PlaceService = require(script.Parent.PlaceService)\n\ntype LifeData = Types.LifeData\ntype WorkoutState = Types.WorkoutState\n\nlocal GymService = {}\n\nlocal WorkoutUpdatedRemote = Remotes.Get(\"WorkoutUpdated\")\nlocal RequestStartWorkoutRemote = Remotes.Get(\"RequestStartWorkout\")\nlocal RequestRepRemote = Remotes.Get(\"RequestRep\")\nlocal NoticeRemote = Remotes.Get(\"Notice\")\n\nlocal GYM = Config.Gym\nlocal GYM_PLACE_ID = \"gym\"\n\n-- Whether the room has been laid. Separate from GymRoom.Room() because a failed lookup has\n-- to be retried and a successful build must not be repeated.\nlocal roomBuilt = false\n\n-- Lays the gym once its place point has streamed in.\n--\n-- Retried rather than given up on, for the reason the school building is: the place point may\n-- not exist on the first tick, and a room that gave up immediately would never appear. Costs\n-- one table lookup per tick after it succeeds.\n--\n-- Nothing here touches the equipment index. GymRoom tags what it builds and CollectionService\n-- fires the added signal Start() is already listening on, so the machines register themselves\n-- through exactly the path a hand-placed one does.\nlocal function ensureRoom(): boolean\n	if roomBuilt then\n		return true\n	end\n	local place = PlaceService.Find(GYM_PLACE_ID)\n	if place == nil then\n		return false\n	end\n	roomBuilt = true\n	return GymRoom.Build(place.part.Position) ~= nil\nend\nlocal SKILL_AWARDS = Config.Skills.Awards\nlocal KINDS = GYM.Kinds\n\n-- The sweet zone for a machine, widened by how fit the character is.\n--\n-- Returns half-widths, because every caller wants distance-from-centre. Health is\n-- read live rather than cached on the session so that the health earned during a\n-- workout widens the window for the reps still to come -- the player watches their\n-- own margin grow inside the activity that is growing it, which is the one thing\n-- the old fixed-width bar could never show.\nlocal function windowFor(machine: string, health: number): (number, number)\n	local kind = KINDS[machine]\n	local fitness = math.clamp(health / Config.Stats.Max, 0, 1)\n	local widen = 1 + GYM.HealthWindowBonus * fitness\n	return (kind.sweetFraction * widen) / 2, (kind.perfectFraction * widen) / 2\nend\n\n-- Health, or zero if the profile is not loaded yet. Zero rather than a default,\n-- because a missing profile should hand out the narrowest window rather than a free\n-- one -- and in practice the panel that would use it is not on screen yet either.\nlocal function healthOf(player: Player): number\n	local stats = StatService.GetStats(player)\n	return if stats ~= nil then stats.health else 0\nend\n\n-- -------------------------------------------------------------------\n-- Machine index: tagged parts grouped by their kind attribute.\n-- -------------------------------------------------------------------\n\ntype MachineEntry = {\n	part: BasePart,\n	kind: string,\n}\n\nlocal allMachines: { MachineEntry } = {}\nlocal machinesByKind: { [string]: { MachineEntry } } = {}\n\nlocal function registerMachine(part: BasePart)\n	if not part:IsA(\"BasePart\") then\n		return\n	end\n	local raw = part:GetAttribute(GYM.GymKindAttribute)\n	if raw == nil or type(raw) ~= \"string\" or raw == \"\" then\n		warn(`[AGES] gym equipment \"{part:GetFullName()}\" has no \"{GYM.GymKindAttribute}\" attribute`)\n		return\n	end\n	if KINDS[raw] == nil then\n		warn(`[AGES] gym equipment \"{part:GetFullName()}\" has unknown kind \"{raw}\"`)\n		return\n	end\n	local entry = { part = part, kind = raw }\n	table.insert(allMachines, entry)\n	local list = machinesByKind[raw]\n	if list == nil then\n		list = {}\n		machinesByKind[raw] = list\n	end\n	table.insert(list, entry)\nend\n\nlocal function unregisterMachine(part: BasePart)\n	for i = #allMachines, 1, -1 do\n		if allMachines[i].part == part then\n			table.remove(allMachines, i)\n			break\n		end\n	end\n	for _, list in machinesByKind do\n		for i = #list, 1, -1 do\n			if list[i].part == part then\n				table.remove(list, i)\n				break\n			end\n		end\n	end\nend\n\n-- -------------------------------------------------------------------\n-- Distance and position helpers.\n-- -------------------------------------------------------------------\n\n\nlocal function characterPosition(player: Player): Vector3?\n	local character = player.Character\n	if character == nil then\n		return nil\n	end\n	local root = character:FindFirstChild(\"HumanoidRootPart\")\n	if root == nil or not root:IsA(\"BasePart\") then\n		return nil\n	end\n	return root.Position\nend\n\n-- Which machine kind, if any, the player is standing next to. Returns nil\n-- if the player is near no machine or has no character. When multiple machines\n-- are within reach the closest one wins, so a player between a treadmill and\n-- a bench gets whichever is nearer rather than whichever was indexed first.\nlocal function machineNear(player: Player): (string?, Vector3?)\n	local position = characterPosition(player)\n	if position == nil then\n		return nil, nil\n	end\n	local bestKind: string? = nil\n	local bestAt: Vector3? = nil\n	local bestDist = math.huge\n	for _, entry in allMachines do\n		local dist = Ground.FlatDistance(position, entry.part.Position)\n		if dist <= GYM.ReachStuds and dist < bestDist then\n			bestDist = dist\n			bestKind = entry.kind\n			bestAt = entry.part.Position\n		end\n	end\n	return bestKind, bestAt\nend\n\n-- -------------------------------------------------------------------\n-- Session state: one per player, at most one at a time.\n-- -------------------------------------------------------------------\n\ntype Session = {\n	-- The machine kind this session uses. Immutable once the session starts.\n	machine: string,\n	-- The machine part's world position at the start of the session. Locked\n	-- because the player's radius is checked against this rather than against\n	-- the live part position -- the session belongs to the spot it started at,\n	-- not to wherever the part might have been dragged in Studio.\n	at: Vector3,\n	-- Rep counter. Starts at 1, increments after each verdict beat.\n	rep: number,\n	-- Total reps attempted so far (set at start from Config).\n	reps: number,\n	-- Session-local stamina. Starts at MaxStamina, drains per rep.\n	stamina: number,\n	-- Running totals of gains, for the client to display and for the final\n	-- notice to report.\n	healthGained: number,\n	looksGained: number,\n	-- Seconds of live sweep elapsed in the current rep. The needle position is\n	-- derived from this through the machine's curve every tick rather than being\n	-- advanced in place, so the clock and the needle cannot drift apart.\n	sweptSeconds: number,\n	-- Current needle position 0-1, authoritative. Derived from sweptSeconds; held\n	-- here because the push digest and the grade both need the value the player\n	-- actually saw, not one recomputed a tick later.\n	progress: number,\n	-- Countdown for the verdict beat. While > 0 the sweep is frozen and the\n	-- client shows the grade.\n	verdictLeft: number,\n	-- The grade the last hit earned: \"Perfect\", \"Good\", or \"Miss\". Set by\n	-- answer() and cleared when the verdict beat ends.\n	grade: string?,\n	-- Guard against double-finish from tickPlayer + PlayerRemoving racing.\n	ending: boolean,\n}\n\nlocal sessions: { [Player]: Session } = {}\n\n-- Dedup push: the state is pushed on every tick, but the client only redraws\n-- when the digest changes. Named for every field the client reads.\nlocal pushed: { [Player]: string } = {}\n\n-- -------------------------------------------------------------------\n-- Refusal guards. The player standing at a machine they cannot use sees a\n-- one-time notice per machine; walking away and coming back re-tells.\n-- -------------------------------------------------------------------\n\nlocal toldRefused: { [Player]: string? } = {}\n\n-- -------------------------------------------------------------------\n-- Harness switch.\n--\n-- Declared here, above every reader, and that placement is the whole point:\n-- a `local` declared *below* a function that names it is a plain global read\n-- inside that function, not an upvalue. That is exactly how `Describe` came\n-- to report \"DISABLED\" forever while the gym was running fine.\n--\n-- The gym does not build anything into the world -- the room is authored in\n-- Studio and found by tag -- so there is no room-construction gate here.\n-- -------------------------------------------------------------------\n\nlocal enabled = true\n\n-- -------------------------------------------------------------------\n-- State construction and push.\n-- -------------------------------------------------------------------\n\n-- The client only redraws when the digest changes. A state whose only change\n-- is the sweep advancing by one tick must still be sent; one whose only change\n-- is nothing at all must not. The digest names every field drawn by the client.\nlocal function stateFor(player: Player): WorkoutState?\n	local health = healthOf(player)\n\n	local session = sessions[player]\n	if session ~= nil then\n		local kind = KINDS[session.machine]\n		local sweetHalf, perfectHalf = windowFor(session.machine, health)\n		return {\n			phase = if session.verdictLeft > 0 then \"verdict\" else \"rep\",\n			machine = session.machine,\n			machineLabel = kind.label,\n			rep = session.rep,\n			reps = session.reps,\n			progress = session.progress,\n			sweetCenter = kind.sweetCenter,\n			sweetHalf = sweetHalf,\n			perfectHalf = perfectHalf,\n			sweepSeconds = kind.sweepSeconds,\n			curve = kind.curve,\n			elapsedShare = math.min(1, session.sweptSeconds / kind.sweepSeconds),\n			stamina = session.stamina,\n			maxStamina = GYM.MaxStamina,\n			grade = if session.verdictLeft > 0 then session.grade else nil,\n			healthGained = session.healthGained,\n			looksGained = session.looksGained,\n		}\n	end\n\n	-- No session: check whether the player is standing near a machine. This\n	-- drives the offer panel on the client.\n	--\n	-- The offer carries the machine's real centre, width and rep count, so the panel\n	-- shows what this machine is going to ask of you before you commit to it. Walking\n	-- between the four and reading their bars is how a player learns the room without\n	-- being told, and it is the only tutorial the gym needs.\n	local machine = machineNear(player)\n	if machine ~= nil then\n		local kind = KINDS[machine]\n		local sweetHalf, perfectHalf = windowFor(machine, health)\n		return {\n			phase = \"offer\",\n			machine = machine,\n			machineLabel = kind.label,\n			rep = 0,\n			reps = kind.reps,\n			progress = 0,\n			sweetCenter = kind.sweetCenter,\n			sweetHalf = sweetHalf,\n			perfectHalf = perfectHalf,\n			sweepSeconds = kind.sweepSeconds,\n			curve = kind.curve,\n			elapsedShare = 0,\n			stamina = GYM.MaxStamina,\n			maxStamina = GYM.MaxStamina,\n			grade = nil,\n			healthGained = 0,\n			looksGained = 0,\n		}\n	end\n\n	return nil\nend\n\nlocal function push(player: Player)\n	local state = stateFor(player)\n	-- sweetHalf is in the digest because it is no longer a constant: it widens as\n	-- health climbs, including mid-session, and a widening the client never redraws\n	-- is a widening the player never sees -- which would defeat the entire point of\n	-- making it move.\n	local digest = if state == nil\n		then \"none\"\n		else `{state.phase}|{state.machine}|{state.rep}/{state.reps}|{state.stamina}`\n			.. `|{math.floor(state.progress * 50)}|{tostring(state.grade)}`\n			.. `|{state.healthGained}|{state.looksGained}`\n			.. `|{math.floor(state.sweetHalf * 1000)}|{state.sweetCenter}`\n	if pushed[player] == digest then\n		return\n	end\n	pushed[player] = digest\n	WorkoutUpdatedRemote:FireClient(player, state)\nend\n\n-- -------------------------------------------------------------------\n-- Refusal check.\n-- -------------------------------------------------------------------\n\nlocal function refusalFor(data: LifeData, machine: string): string?\n	if not data.alive then\n		return \"The gym is closed.\"\n	end\n\n	local used = data.workoutsThisYear[machine]\n	if used ~= nil and used >= GYM.WorkoutsPerYear then\n		local label = KINDS[machine].label\n		return `You have worked the {label} {GYM.WorkoutsPerYear} time(s) this year. Come back next year.`\n	end\n\n	return nil\nend\n\n-- -------------------------------------------------------------------\n-- Grade scoring. The sweep bar is 0-1; the sweet zone is centred at 0.5.\n-- A hit lands wherever the needle was when the player pressed. Perfect is\n-- the inner band, good is the outer band, miss is outside both.\n-- -------------------------------------------------------------------\n\nlocal function gradeFor(machine: string, progress: number, health: number): (string, number, number)\n	local kind = KINDS[machine]\n	local sweetHalf, perfectHalf = windowFor(machine, health)\n	-- Distance from the machine's own centre, which is not 0.5 on three of the four.\n	local dist = math.abs(progress - kind.sweetCenter)\n	if dist <= perfectHalf then\n		return \"Perfect\", kind.healthPerPerfect, kind.looksPerPerfect\n	elseif dist <= sweetHalf then\n		return \"Good\", kind.healthPerGood, kind.looksPerGood\n	else\n		return \"Miss\", 0, 0\n	end\nend\n\n-- -------------------------------------------------------------------\n-- Session lifecycle.\n-- -------------------------------------------------------------------\n\nlocal function answer(player: Player, session: Session, pushedRep: boolean)\n	local grade: string\n	local health, looks: number\n	if pushedRep then\n		grade, health, looks = gradeFor(session.machine, session.progress, healthOf(player))\n	else\n		grade, health, looks = \"Miss\", 0, 0\n	end\n\n	session.grade = grade\n	session.healthGained += health\n	session.looksGained += looks\n\n	-- Stamina cost. A miss costs extra: the whole rep plus the penalty,\n	-- so pushing at the wrong moment is actively worse than waiting. The rep cost is\n	-- the machine's own, which is what makes the bench a seven-rep workout and the\n	-- treadmill a twelve-rep one out of the same hundred-point bar.\n	local cost = KINDS[session.machine].repStamina\n	if grade == \"Miss\" then\n		cost += GYM.MissStamina\n	end\n	session.stamina = math.max(0, session.stamina - cost)\n\n	-- Stat gains are granted immediately rather than batched at the end,\n	-- so the player's bars move on each hit and the reward feedback is\n	-- instantaneous -- the same pace school uses for right answers.\n	if health > 0 then\n		StatService.AddStat(player, \"health\", health)\n	end\n	if looks > 0 then\n		StatService.AddStat(player, \"looks\", looks)\n	end\n\n	-- Athletics, on the grade and nothing else. Not on the rep, not on the session, and\n	-- not on the time spent on the machine: the sweep is the only thing the gym asks the\n	-- player to get right, and a rep that missed it was a rep spent rather than earned.\n	if grade == \"Perfect\" then\n		SkillService.Award(player, \"athletics\", SKILL_AWARDS.GymPerfect, \"perfect sweep\")\n	elseif grade == \"Good\" then\n		SkillService.Award(player, \"athletics\", SKILL_AWARDS.GymGood, \"good sweep\")\n	end\n\n	session.verdictLeft = GYM.VerdictSeconds\n	push(player)\nend\n\n-- Takes no LifeData: everything a finish reports lives on the session itself.\n-- Keeping the profile out of the signature is what lets the harness switch and\n-- the birthday hook close a session without first proving a profile is loaded.\nlocal function finish(player: Player, session: Session, reason: string)\n	if session.ending then\n		return\n	end\n	session.ending = true\n	sessions[player] = nil\n\n	local label = KINDS[session.machine].label\n	local reps = math.max(0, session.rep - 1)\n	local gains = `+{session.healthGained} health, +{session.looksGained} looks`\n	local line = if reason == \"left\"\n		then `You left the {label}. {reps} reps, {gains}.`\n		else `Workout over on the {label}. {reps} reps, {gains}.`\n\n	NoticeRemote:FireClient(player, line)\n	push(player)\nend\n\nlocal function begin(player: Player, data: LifeData, machine: string, at: Vector3)\n	-- Counted at start on the school's precedent: turning up is what the\n	-- cap counts, and a player who starts, walks away, restarts should not\n	-- be able to re-roll the sweep.\n	local used = data.workoutsThisYear[machine] or 0\n	data.workoutsThisYear[machine] = used + 1\n\n	local session: Session = {\n		machine = machine,\n		at = at,\n		rep = 1,\n		reps = KINDS[machine].reps,\n		stamina = GYM.MaxStamina,\n		healthGained = 0,\n		looksGained = 0,\n		sweptSeconds = 0,\n		progress = 0,\n		verdictLeft = 0,\n		grade = nil,\n		ending = false,\n	}\n	sessions[player] = session\n	push(player)\nend\n\n-- -------------------------------------------------------------------\n-- Remote handlers.\n-- -------------------------------------------------------------------\n\nlocal function onStartRequested(player: Player, kind: unknown)\n	if not enabled then\n		NoticeRemote:FireClient(player, \"The gym is closed.\")\n		return\n	end\n	if type(kind) ~= \"string\" then\n		return\n	end\n\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return\n	end\n	local data = Lives.Active(profile.Data)\n\n	-- Already in a session? Refuse silently rather than interrupting a\n	-- workout the player is mid-way through.\n	if sessions[player] ~= nil then\n		return\n	end\n\n	if KINDS[kind] == nil then\n		NoticeRemote:FireClient(player, \"That machine is not set up yet.\")\n		return\n	end\n\n	-- Must still be standing next to the machine. A panel can be opened\n	-- by walking to a machine, then answered after walking away.\n	local nearKind, at = machineNear(player)\n	if nearKind ~= kind or at == nil then\n		NoticeRemote:FireClient(player, \"Step up to the machine to start.\")\n		return\n	end\n\n	local refusal = refusalFor(data, kind)\n	if refusal ~= nil then\n		NoticeRemote:FireClient(player, refusal)\n		return\n	end\n\n	begin(player, data, kind, at)\nend\n\nlocal function onRepRequested(player: Player)\n	local session = sessions[player]\n	if session == nil or session.verdictLeft > 0 then\n		return\n	end\n	-- Only the live sweep can be pushed. A push that arrives during the\n	-- verdict beat or after the session has ended gains nothing.\n	answer(player, session, true)\nend\n\n-- -------------------------------------------------------------------\n-- Tick: drives the sweep and enforces session boundaries.\n-- -------------------------------------------------------------------\n\nlocal function tickPlayer(player: Player, elapsed: number)\n	-- The harness switch is honoured here rather than around the loop so that a\n	-- session already running when the gym is switched off is closed out and\n	-- reported, instead of being abandoned mid-rep with its yearly slot already\n	-- spent and the client left holding a rep counter that never advances.\n	if not enabled then\n		local running = sessions[player]\n		if running ~= nil then\n			finish(player, running, \"over\")\n		end\n		return\n	end\n\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return\n	end\n	local data = Lives.Active(profile.Data)\n	local position = characterPosition(player)\n\n	local session = sessions[player]\n\n	if session == nil then\n		-- No session running. If the player is near a machine with no\n		-- session, stateFor returns an offer. If refused, the refusal\n		-- fires once and the offer is suppressed until they leave.\n		local machine = machineNear(player)\n		if machine == nil then\n			-- Cleared away from any machine: re-offer next time.\n			if toldRefused[player] ~= nil then\n				toldRefused[player] = nil\n			end\n			push(player)\n			return\n		end\n\n		local refusal = refusalFor(data, machine)\n		if refusal ~= nil then\n			if toldRefused[player] ~= machine then\n				toldRefused[player] = machine\n				NoticeRemote:FireClient(player, refusal)\n			end\n			return\n		end\n\n		-- Offer state is returned by stateFor; push it.\n		push(player)\n		return\n	end\n\n	-- From here a session exists. Every way it can end is checked before\n	-- anything is asked of the player.\n	if not data.alive then\n		finish(player, session, \"left\")\n		return\n	end\n	if position == nil or Ground.FlatDistance(position, session.at) > GYM.RoomRadiusStuds then\n		finish(player, session, \"left\")\n		return\n	end\n\n	-- Verdict beat: the sweep is frozen, the grade is shown, and we wait\n	-- for the beat to expire before advancing to the next rep.\n	if session.verdictLeft > 0 then\n		session.verdictLeft -= elapsed\n		if session.verdictLeft > 0 then\n			push(player)\n			return\n		end\n\n		-- Verdict over. Advance to the next rep, or finish.\n		session.verdictLeft = 0\n		session.grade = nil\n		session.rep += 1\n\n		if session.rep > session.reps or session.stamina < KINDS[session.machine].repStamina then\n			finish(player, session, \"over\")\n			return\n		end\n\n		-- New rep: reset the sweep.\n		session.sweptSeconds = 0\n		session.progress = 0\n		push(player)\n		return\n	end\n\n	-- Live sweep. The clock advances evenly; the needle does not. Where it actually\n	-- sits is the machine's curve applied to how much of the sweep has run, which is\n	-- what makes the bench creep-then-rush and the dumbbells rush-then-crawl out of\n	-- one shared tick.\n	local kind = KINDS[session.machine]\n	session.sweptSeconds += elapsed\n	local elapsedShare = math.min(1, session.sweptSeconds / kind.sweepSeconds)\n	session.progress = Sweep.At(kind.curve, elapsedShare)\n\n	-- The sweep ran out without a push. The player did not press in time,\n	-- which counts as a miss with the same consequences as a deliberate\n	-- miss -- the game does not distinguish laziness from failure, because\n	-- from the character's perspective both look the same.\n	-- Tested on the clock rather than on the needle: every curve lands on 1 at the\n	-- same moment, but only the clock does it without floating-point slack, and a\n	-- sweep that expires a tick late is a free rep on the quickening machines.\n	if elapsedShare >= 1 then\n		session.progress = 1\n		answer(player, session, false)\n		return\n	end\n\n	push(player)\nend\n\n-- -------------------------------------------------------------------\n-- Cleanup.\n-- -------------------------------------------------------------------\n\nlocal function forget(player: Player)\n	local session = sessions[player]\n	if session ~= nil then\n		sessions[player] = nil\n	end\n	pushed[player] = nil\n	toldRefused[player] = nil\nend\n\n-- -------------------------------------------------------------------\n-- Public API: birthday hooks, studio harness, diagnostics.\n-- -------------------------------------------------------------------\n\n-- A birthday. The per-machine yearly caps reset. A session in progress is\n-- ended first so it is graded on the year it started in, exactly as a\n-- lesson is.\nfunction GymService.OnAgeUp(player: Player)\n	-- Closed unconditionally. The old shape dropped the session outright when\n	-- no profile was loaded, which skipped the notice and the push and left the\n	-- client showing a rep counter for a workout that no longer existed.\n	local session = sessions[player]\n	if session ~= nil then\n		finish(player, session, \"over\")\n	end\n\n	-- Clear the yearly counters. The old year's count is already spent; a\n	-- player who turned up to every machine gets a clean slate.\n	local profile = DataService.GetProfile(player)\n	if profile ~= nil then\n		local data = Lives.Active(profile.Data)\n		table.clear(data.workoutsThisYear)\n	end\n	push(player)\nend\n\n-- A new life. Nobody inherits a workout session or a machine record.\nfunction GymService.ResetForNewLife(player: Player)\n	forget(player)\n	local profile = DataService.GetProfile(player)\n	if profile ~= nil then\n		table.clear(Lives.Active(profile.Data).workoutsThisYear)\n	end\n	push(player)\nend\n\n-- Studio harness: starts a workout wherever the player is standing, on the\n-- nearest machine kind.\nfunction GymService.ForceStart(player: Player): (boolean, string?)\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return false, \"no profile loaded\"\n	end\n	if sessions[player] ~= nil then\n		return false, \"already in a workout\"\n	end\n\n	local machine, at = machineNear(player)\n	if machine == nil or at == nil then\n		return false, \"not near any machine\"\n	end\n\n	local data = Lives.Active(profile.Data)\n	local refusal = refusalFor(data, machine)\n	if refusal ~= nil then\n		return false, refusal\n	end\n\n	begin(player, data, machine, at)\n	return true, nil\nend\n\nfunction GymService.ForceEnd(player: Player): boolean\n	local session = sessions[player]\n	if session == nil then\n		return false\n	end\n	finish(player, session, \"over\")\n	return true\nend\n\nfunction GymService.Describe(player: Player): string\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return \"gym: no profile loaded\"\n	end\n	local data = Lives.Active(profile.Data)\n\n	local machineCount = #allMachines\n	local health = healthOf(player)\n\n	-- The window is the thing worth printing: it is per-machine AND scales with health,\n	-- so \"the bar felt wrong\" is only diagnosable if the numbers the grader used are\n	-- visible next to the machine they came from.\n	local nearKind = machineNear(player)\n	local nearLine = \"not near any machine\"\n	if nearKind ~= nil then\n		local sweetHalf, perfectHalf = windowFor(nearKind, health)\n		nearLine = string.format(\n			\"near %s (%s, %.1fs, centre %.2f, sweet ±%.3f, perfect ±%.3f at health %d)\",\n			KINDS[nearKind].label,\n			KINDS[nearKind].curve,\n			KINDS[nearKind].sweepSeconds,\n			KINDS[nearKind].sweetCenter,\n			sweetHalf,\n			perfectHalf,\n			health\n		)\n	end\n\n	local running = \"no workout\"\n	local session = sessions[player]\n	if session ~= nil then\n		running = `{session.machine} rep {session.rep}/{session.reps}, stamina {session.stamina}, progress {string.format(\"%.2f\", session.progress)}`\n	end\n\n	local caps: { string } = {}\n	for kind, def in KINDS do\n		local used = data.workoutsThisYear[kind] or 0\n		table.insert(caps, `{def.label} {used}/{GYM.WorkoutsPerYear}`)\n	end\n	-- `for ... in` over a hash table has no defined order, and a debug line that\n	-- reshuffles between two calls is a debug line you have to read twice.\n	table.sort(caps)\n\n	return string.format(\n		\"gym: %d machines | %s | %s | %s | %s\",\n		machineCount,\n		nearLine,\n		running,\n		table.concat(caps, \", \"),\n		if enabled then \"enabled\" else \"DISABLED\"\n	)\nend\n\nfunction GymService.SetEnabled(value: boolean)\n	enabled = value\nend\n\nfunction GymService.IsEnabled(): boolean\n	return enabled\nend\n\n-- -------------------------------------------------------------------\n-- Start: wire up signals and the tick loop.\n-- -------------------------------------------------------------------\n\nfunction GymService:Start()\n	-- Index tagged equipment. Uses the same CollectionService pattern as\n	-- PlaceService: listen for additions and removals so Studio edits take\n	-- effect without a restart.\n	local tag = GYM.EquipmentTag\n\n	CollectionService:GetInstanceAddedSignal(tag):Connect(function(instance: Instance)\n		registerMachine(instance :: BasePart)\n	end)\n	CollectionService:GetInstanceRemovedSignal(tag):Connect(function(instance: Instance)\n		unregisterMachine(instance :: BasePart)\n	end)\n	for _, instance in CollectionService:GetTagged(tag) do\n		registerMachine(instance :: BasePart)\n	end\n\n	-- Push once the profile exists on join.\n	Players.PlayerAdded:Connect(function(player: Player)\n		task.spawn(function()\n			if DataService.WaitForProfile(player) ~= nil then\n				push(player)\n			end\n		end)\n	end)\n\n	Players.PlayerRemoving:Connect(function(player: Player)\n		forget(player)\n	end)\n\n	RequestStartWorkoutRemote.OnServerEvent:Connect(function(player: Player, kind: unknown)\n		local ok, err = pcall(onStartRequested, player, kind)\n		if not ok then\n			warn(`[AGES] gym start failed for {player.Name}: {err}`)\n		end\n	end)\n\n	RequestRepRemote.OnServerEvent:Connect(function(player: Player)\n		local ok, err = pcall(onRepRequested, player)\n		if not ok then\n			warn(`[AGES] gym rep failed for {player.Name}: {err}`)\n		end\n	end)\n\n	-- Lay the room. Tried once here so a gym is standing before the first player can walk\n	-- into it, and retried on the tick below if the place point has not arrived yet.\n	pcall(ensureRoom)\n\n	task.spawn(function()\n		while true do\n			local elapsed = task.wait(GYM.TickSeconds)\n			if not roomBuilt then\n				pcall(ensureRoom)\n			end\n			for _, player in Players:GetPlayers() do\n				local ok, err = pcall(tickPlayer, player, elapsed)\n				if not ok then\n					warn(`[AGES] gym tick failed for {player.Name}: {err}`)\n				end\n			end\n		end\n	end)\nend\n\nreturn GymService\n"
table.insert(AGES_MANIFEST, "src/server/services/GymService.luau")
AGES_SOURCES["src/server/services/HouseService.luau"] = "--!strict\n-- House ownership. A life can buy a suburb home, sell it, and link a work-from-home\n-- job to it. The property data sits on LifeData, resetting on death so a new life\n-- starts with nothing -- just like money and bonds.\n--\n-- No special integration with WorkService is needed: stationAtHand() already\n-- resolves any placeId through PlaceService.Find(), so a job whose placeId points\n-- to a suburb house works the same way any other job does. HouseService only\n-- manages ownership and the home-job link.\n\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Config = require(ReplicatedStorage:WaitForChild(\"Config\"))\nlocal Remotes = require(ReplicatedStorage:WaitForChild(\"Remotes\"))\nlocal Types = require(ReplicatedStorage:WaitForChild(\"Types\"))\n\nlocal DataService = require(script.Parent.DataService)\nlocal Lives = require(ReplicatedStorage:WaitForChild(\"Lives\"))\nlocal MoneyService = require(script.Parent.MoneyService)\nlocal MilestoneService = require(script.Parent.MilestoneService)\nlocal GossipService = require(script.Parent.GossipService)\n\ntype LifeData = Types.LifeData\ntype Player = Players.Player\n\nlocal HouseService = {}\n\nlocal HOUSE = Config.House\nlocal HOUSE_UPDATED = Remotes.Get(\"HouseUpdated\")\nlocal REQUEST_BUY = Remotes.Get(\"RequestBuyHouse\")\nlocal REQUEST_SELL = Remotes.Get(\"RequestSellHouse\")\nlocal REQUEST_SET_JOB = Remotes.Get(\"RequestSetHomeJob\")\n\n-- Check whether a house id is a known suburb place in the walkable list.\nlocal function isValidHouseId(houseId: string): boolean\n	return table.find(Config.Places.Walkable, houseId) ~= nil\n		and string.find(houseId, \"^suburb_\") == 1\nend\n\n-- Get the life data for a player, nil if no profile or no active life.\nlocal function lifeDataFor(player: Player): LifeData?\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return nil\n	end\n	return Lives.Active(profile.Data)\nend\n\n-- Build the list of unowned suburb houses a player can buy.\nlocal function buildAvailable(): { [string]: number }\n	local available: { [string]: number } = {}\n	for _, houseId in Config.Places.Walkable do\n		if string.find(houseId, \"^suburb_\") == 1 then\n			available[houseId] = HOUSE.BuyPrice\n		end\n	end\n	return available\nend\n\n-- Push the full house state to a player's client.\nlocal function pushHouseStatus(player: Player, life: LifeData)\n	local houses = life.houses :: { owned: { [string]: boolean }, homeJob: { [string]: string } }\n	HOUSE_UPDATED:FireClient(player, {\n		owned = houses.owned,\n		homeJob = houses.homeJob,\n		available = buildAvailable(),\n	})\nend\n\n-- Buy a suburb house.\n-- Returns (\"ok\", houseId) on success, (\"error\", reason) on failure.\nfunction HouseService.BuyHouse(player: Player, houseId: string): (boolean, string?)\n	if typeof(houseId) ~= \"string\" then\n		return false, \"Invalid house id\"\n	end\n	if not isValidHouseId(houseId) then\n		return false, \"Unknown house\"\n	end\n\n	local life = lifeDataFor(player)\n	if life == nil then\n		return false, \"No active life\"\n	end\n\n	local houses = life.houses :: { owned: { [string]: boolean }, homeJob: { [string]: string } }\n\n	if houses.owned[houseId] == true then\n		return false, \"Already own this house\"\n	end\n\n	local ownedCount = 0\n	for _ in houses.owned do\n		ownedCount = ownedCount + 1\n	end\n	if ownedCount >= HOUSE.MaxPerPlayer then\n		return false, \"Already own the maximum number of houses\"\n	end\n\n	local spent = MoneyService.Spend(player, HOUSE.BuyPrice, \"bought \" .. houseId)\n	if not spent then\n		return false, \"Not enough money\"\n	end\n\n	houses.owned[houseId] = true\n	-- Clear any stale home job for this house (shouldn't happen, but be safe).\n	houses.homeJob[houseId] = nil\n	pushHouseStatus(player, life)\n\n	-- Track milestones and gossip around home ownership.\n	if ownedCount == 0 then\n		MilestoneService.OnFirstHouse(player)\n	end\n	GossipService.OnHousePurchase(player, houseId)\n\n	return true, houseId\nend\n\n-- Sell a suburb house.\n-- Returns (\"ok\", amount) on success, (\"error\", reason) on failure.\nfunction HouseService.SellHouse(player: Player, houseId: string): (boolean, string?)\n	if typeof(houseId) ~= \"string\" then\n		return false, \"Invalid house id\"\n	end\n	if not isValidHouseId(houseId) then\n		return false, \"Unknown house\"\n	end\n\n	local life = lifeDataFor(player)\n	if life == nil then\n		return false, \"No active life\"\n	end\n\n	local houses = life.houses :: { owned: { [string]: boolean }, homeJob: { [string]: string } }\n\n	if houses.owned[houseId] ~= true then\n		return false, \"Do not own this house\"\n	end\n\n	-- Clear any linked home job first.\n	houses.homeJob[houseId] = nil\n\n	local refund = math.floor(HOUSE.BuyPrice * HOUSE.ResaleFraction)\n	MoneyService.Add(player, refund, \"sold \" .. houseId)\n\n	houses.owned[houseId] = nil\n	pushHouseStatus(player, life)\n\n	GossipService.OnHouseSale(player, houseId)\n\n	return true, tostring(refund)\nend\n\n-- Link a home job to an owned house.\n-- Returns (\"ok\", jobId) on success, (\"error\", reason) on failure.\nfunction HouseService.SetHomeJob(player: Player, houseId: string, jobId: string): (boolean, string?)\n	if typeof(houseId) ~= \"string\" or typeof(jobId) ~= \"string\" then\n		return false, \"Invalid arguments\"\n	end\n\n	local life = lifeDataFor(player)\n	if life == nil then\n		return false, \"No active life\"\n	end\n\n	local houses = life.houses :: { owned: { [string]: boolean }, homeJob: { [string]: string } }\n\n	if houses.owned[houseId] ~= true then\n		return false, \"Do not own this house\"\n	end\n\n	-- Look up the job and verify it exists and its placeId matches.\n	local Jobs = require(script.Parent.Parent.content.Jobs)\n	local job = Jobs.ById[jobId]\n	if job == nil then\n		return false, \"Unknown job\"\n	end\n	if job.placeId ~= houseId then\n		return false, \"Job does not match this house\"\n	end\n\n	if not Config.Work.HomeJobAllowed then\n		return false, \"Work-from-home jobs are disabled\"\n	end\n\n	houses.homeJob[houseId] = jobId\n	pushHouseStatus(player, life)\n\n	return true, jobId\nend\n\nfunction HouseService:Init()\n	REQUEST_BUY.OnServerEvent:Connect(function(player: Player, houseId: any)\n		if typeof(houseId) ~= \"string\" then\n			return\n		end\n		local ok, err = HouseService.BuyHouse(player, houseId)\n		if not ok then\n			warn(`[AGES] BuyHouse failed for {player.Name}: {err}`)\n		end\n	end)\n\n	REQUEST_SELL.OnServerEvent:Connect(function(player: Player, houseId: any)\n		if typeof(houseId) ~= \"string\" then\n			return\n		end\n		local ok, err = HouseService.SellHouse(player, houseId)\n		if not ok then\n			warn(`[AGES] SellHouse failed for {player.Name}: {err}`)\n		end\n	end)\n\n	REQUEST_SET_JOB.OnServerEvent:Connect(function(player: Player, houseId: any, jobId: any)\n		if typeof(houseId) ~= \"string\" or typeof(jobId) ~= \"string\" then\n			return\n		end\n		local ok, err = HouseService.SetHomeJob(player, houseId, jobId)\n		if not ok then\n			warn(`[AGES] SetHomeJob failed for {player.Name}: {err}`)\n		end\n	end)\n\n	Players.PlayerRemoving:Connect(function(player: Player)\n		-- No persistent state to clean up beyond the life data, which is\n		-- managed by DataService.\n	end)\nend\n\nfunction HouseService:Start()\n	-- No background tick needed. House state only changes on player action.\nend\n\nreturn HouseService\n"
table.insert(AGES_MANIFEST, "src/server/services/HouseService.luau")
AGES_SOURCES["src/server/services/LifeService.luau"] = "--!strict\n-- Aging is player-driven. There is no wall clock advancing the world: a year\n-- ends when the player presses Age Up, or when they have banked enough active\n-- session time that the safety net advances them anyway. Both routes run the\n-- same code path so decay, stage transitions and the death roll can never\n-- drift apart between them.\n\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Config = require(ReplicatedStorage:WaitForChild(\"Config\"))\nlocal Types = require(ReplicatedStorage:WaitForChild(\"Types\"))\nlocal Remotes = require(ReplicatedStorage:WaitForChild(\"Remotes\"))\nlocal Lives = require(ReplicatedStorage:WaitForChild(\"Lives\"))\n\nlocal DataService = require(script.Parent.DataService)\nlocal StatService = require(script.Parent.StatService)\nlocal PocketMoneyService = require(script.Parent.PocketMoneyService)\nlocal EventService = require(script.Parent.EventService)\nlocal BodyService = require(script.Parent.BodyService)\nlocal DeliveryService = require(script.Parent.DeliveryService)\nlocal WorkService = require(script.Parent.WorkService)\nlocal SchoolService = require(script.Parent.SchoolService)\nlocal GymService = require(script.Parent.GymService)\nlocal FightService = require(script.Parent.FightService)\nlocal PeopleService = require(script.Parent.PeopleService)\nlocal VehicleService = require(script.Parent.VehicleService)\nlocal BillService = require(script.Parent.BillService)\nlocal SavingsService = require(script.Parent.SavingsService)\nlocal MilestoneService = require(script.Parent.MilestoneService)\nlocal ChildhoodService = require(script.Parent.ChildhoodService)\nlocal SetupService = require(script.Parent.SetupService)\nlocal ReturnService = require(script.Parent.ReturnService)\n-- Used by Init (SetMoments) and by the verdict at the end of a life. This require was\n-- missing, so `VerdictService` was a global read -- nil -- and `LifeService:Init()` threw\n-- on the nil index. init.server.luau calls the Inits unguarded, so nothing after line 92\n-- ever initialised and no service was ever Started: the place came up with nothing in it.\n--\n-- The comment at the SetMoments call says requiring it here would close a cycle. It does\n-- not: VerdictService reaches only DataService and Ribbons, and neither reaches back here.\n-- SetMoments is still needed -- it threads the moments *query* in -- but that is a\n-- different problem from the require, and conflating the two is what lost the require.\nlocal VerdictService = require(script.Parent.VerdictService)\n\ntype LifeStageId = Types.LifeStageId\ntype AgeUpCause = Types.AgeUpCause\ntype ManualAgeUpState = Types.ManualAgeUpState\ntype LifeData = Types.LifeData\ntype Moment = Types.Moment\n\nlocal AgeUpdatedRemote = Remotes.Get(\"AgeUpdated\")\nlocal AgeUpProgressRemote = Remotes.Get(\"AgeUpProgress\")\nlocal RequestAgeUpRemote = Remotes.Get(\"RequestAgeUp\")\nlocal PlayerDiedRemote = Remotes.Get(\"PlayerDied\")\nlocal LifeStageChangedRemote = Remotes.Get(\"LifeStageChanged\")\nlocal NoticeRemote = Remotes.Get(\"Notice\")\nlocal ChapterBreakRemote = Remotes.Get(\"ChapterBreak\")\n\nlocal LifeService = {}\n\nlocal function stageForAge(ageYears: number): LifeStageId\n	for _, stage in Config.LifeStages do\n		if ageYears >= stage.minAge and ageYears <= stage.maxAge then\n			return stage.id :: LifeStageId\n		end\n	end\n	return \"Elder\"\nend\n\n-- ChancePerYear = min(MaxChancePerYear, BaseChancePerYear * (age - RampStartAge) ^ Exponent)\nlocal function rollNaturalDeath(ageYears: number): boolean\n	local deathConfig = Config.Death\n	if ageYears < deathConfig.RampStartAge then\n		return false\n	end\n	local yearsPast = ageYears - deathConfig.RampStartAge\n	local chance = math.min(deathConfig.MaxChancePerYear, deathConfig.BaseChancePerYear * (yearsPast ^ deathConfig.Exponent))\n	return math.random() < chance\nend\n\n-- The birthday chance of falling ill, given the health the new year begins on.\n-- Zero at and above the line -- illness is the tax on being run down, not a lottery\n-- everyone is in -- and rising in a straight line to the ceiling at zero health, so\n-- every point of health below the line is a little more of the body failing to hold.\nlocal function illnessChanceAt(health: number): number\n	local healthConfig = Config.Health\n	if health >= healthConfig.RiskHealth then\n		return 0\n	end\n	local fall = (healthConfig.RiskHealth - health) / healthConfig.RiskHealth\n	return healthConfig.BaseIllnessChance + fall * (healthConfig.MaxIllnessChance - healthConfig.BaseIllnessChance)\nend\n\n-- One birthday's worth of sickness, run in the right order: whatever the year had\n-- is over first, then the new year gets its own chance to begin one. Recovery\n-- restoring less than a sick year took is the whole shape of the loop -- a life that\n-- falls ill pays a little each time until it either gets well or runs out of the\n-- middle of the bar, and a life that keeps dropping faces a worse chance every year.\n--\n-- The flag is read and written here and nowhere else. StatService and WorkService\n-- read it straight off the record to tax the year and the shifts -- they stay leaves\n-- in the require graph -- while this is the only place it is ever set or cleared.\nlocal function progressSickness(player: Player, data: LifeData)\n	local healthConfig = Config.Health\n\n	if data.flags.sick ~= nil then\n		data.flags.sick = nil\n		StatService.AddStat(player, \"health\", healthConfig.RecoverHealth)\n		NoticeRemote:FireClient(player, \"You got over it. Whatever it was, it's behind you now.\")\n	end\n\n	if math.random() < illnessChanceAt(data.stats.health) then\n		data.flags.sick = data.ageMonths // Config.Time.MonthsPerYear\n		NoticeRemote:FireClient(player, \"You're coming down with something. You feel hollow and feverish, and it isn't going anywhere fast.\")\n	end\nend\n\nlocal function ageYearsOf(data: LifeData): number\n	return data.ageMonths // Config.Time.MonthsPerYear\nend\n\n-- Whether the given age falls inside one of the configured chapter bands.\nlocal function bandIndexOf(ageYears: number): number\n	for i, band in Config.Life.ChapterBands do\n		if ageYears >= band[1] and ageYears <= band[2] then\n			return i\n		end\n	end\n	return #Config.Life.ChapterBands\nend\n\n-- Turn a moment into readable prose, anchored to the life's data.\n--\n-- Called by both the verdict (which wants up to three) and the chapter reel\n-- (which wants all of them). Same function, same output — the spec calls it\n-- the \"single source\" precisely because the two consumers must never diverge.\nfunction LifeService.FormatMoment(moment: Moment, data: LifeData): string\n	local ageYears = moment.ageMonths // Config.Time.MonthsPerYear\n	if moment.kind == \"flag\" then\n		return `At age {ageYears}, you {moment.id}`\n	elseif moment.kind == \"bond\" then\n		return `At age {ageYears}, you and {moment.id} grew close`\n	elseif moment.kind == \"grade\" then\n		return `At age {ageYears}, you did well in school`\n	elseif moment.kind == \"standing\" then\n		return `At age {ageYears}, you earned respect at {moment.id}`\n	elseif moment.kind == \"mastery\" then\n		return `At age {ageYears}, you mastered {moment.id}`\n	elseif moment.kind == \"job\" then\n		return `At age {ageYears}, you worked as a {moment.id}`\n	elseif moment.kind == \"house\" then\n		return `At age {ageYears}, you bought a home`\n	elseif moment.kind == \"gangRank\" then\n		return `At age {ageYears}, you rose in a gang`\n	elseif moment.kind == \"visit\" then\n		return `At age {ageYears}, you visited {moment.id}`\n	elseif moment.kind == \"confrontation\" then\n		return `At age {ageYears}, {moment.id}`\n	elseif moment.kind == \"age\" then\n		return `At age {ageYears}, you reached age {ageYears}`\n	else\n		return `At age {ageYears}, {moment.id}`\n	end\nend\n\n-- The shared \"what happened\" query. One function feeds the chapter reel and the\n-- end-of-life verdict; the two consumers pass different opts but the walk is the\n-- same.\n--\n-- `sinceMonths` defaults to 0 (whole life) rather than nil, because a stored life\n-- that predates the field gets reconciled to 0 and 0 means \"start from birth\" here.\n-- `maxCount` and `kinds` gate the output; nil means \"unlimited\" / \"all kinds\".\nfunction LifeService.Moments(data: LifeData, opts: {\n	sinceMonths: number?,\n	untilMonths: number?,\n	maxCount: number?,\n	kinds: { string }?,\n}): { Moment }\n	local sinceMonths = opts.sinceMonths or 0\n	local untilMonths = opts.untilMonths or data.ageMonths\n	local maxCount = opts.maxCount\n	local allowedKinds = opts.kinds\n\n	local results: { Moment } = {}\n\n	local function emit(ageMonths: number, kind: string, id: string)\n		if allowedKinds ~= nil and not table.find(allowedKinds, kind) then\n			return\n		end\n		if ageMonths < sinceMonths then\n			return\n		end\n		if ageMonths > untilMonths then\n			return\n		end\n		local moment: Moment = {\n			ageMonths = ageMonths,\n			kind = kind,\n			id = id,\n			line = \"\",\n		}\n		moment.line = LifeService.FormatMoment(moment, data)\n		table.insert(results, moment)\n		if maxCount ~= nil and #results >= maxCount then\n			return\n		end\n	end\n\n	-- Flags: age is the value stored in the flag set.\n	if not table.find(allowedKinds or {}, \"flag\") or allowedKinds == nil then\n		for flagId, flagAgeMonths in data.flags do\n			emit(flagAgeMonths, \"flag\", flagId)\n		end\n	end\n\n	-- Bonds: age is the last-visited year for bonds >= 50.\n	if allowedKinds == nil or table.find(allowedKinds, \"bond\") then\n		for personId, bond in data.bonds do\n			if bond >= 50 then\n				local visit = data.visits[personId]\n				local bondAgeMonths = visit ~= nil and ((visit.lastYear or 0) * Config.Time.MonthsPerYear) or data.ageMonths\n				emit(bondAgeMonths, \"bond\", personId)\n			end\n		end\n	end\n\n	-- School grades: best and worst per year.\n	if allowedKinds == nil or table.find(allowedKinds, \"grade\") then\n		for _, year in data.schoolGrades do\n			local ageMonths = (year.ageYears or 0) * Config.Time.MonthsPerYear\n			if year.grade == \"A\" or year.grade == \"B\" then\n				emit(ageMonths, \"grade\", \"school\")\n			end\n		end\n	end\n\n	-- Job standing: any standing at or above the band threshold.\n	if allowedKinds == nil or table.find(allowedKinds, \"standing\") then\n		for jobId, standing in data.jobStanding do\n			emit(data.ageMonths, \"standing\", jobId)\n		end\n	end\n\n	-- Subject mastery: level 5 mastery.\n	if allowedKinds == nil or table.find(allowedKinds, \"mastery\") then\n		for subject, level in data.subjectMastery do\n			if level >= 5 then\n				emit(data.ageMonths, \"mastery\", subject)\n			end\n		end\n	end\n\n	-- Current job.\n	if allowedKinds == nil or table.find(allowedKinds, \"job\") then\n		if data.jobId ~= nil then\n			emit(data.ageMonths, \"job\", data.jobId)\n		end\n	end\n\n	-- Houses owned.\n	if allowedKinds == nil or table.find(allowedKinds, \"house\") then\n		for houseId in data.houses.owned do\n			emit(data.ageMonths, \"house\", houseId)\n		end\n	end\n\n	-- Gang rank.\n	if allowedKinds == nil or table.find(allowedKinds, \"gangRank\") then\n		if data.gangRankId ~= nil then\n			emit(data.ageMonths, \"gangRank\", data.gangRankId)\n		end\n	end\n\n	-- Visits: proximity-driven NPC news, one per person.\n	if allowedKinds == nil or table.find(allowedKinds, \"visit\") then\n		for personId, visit in data.visits do\n			local visitAgeMonths = (visit.lastYear or 0) * Config.Time.MonthsPerYear\n			emit(visitAgeMonths, \"visit\", personId)\n		end\n	end\n\n	-- Age milestones: every integer age.\n	if allowedKinds == nil or table.find(allowedKinds, \"age\") then\n		local startAge = sinceMonths // Config.Time.MonthsPerYear\n		local endAge = untilMonths // Config.Time.MonthsPerYear\n		for age = startAge, endAge do\n			emit(age * Config.Time.MonthsPerYear, \"age\", tostring(age))\n		end\n	end\n\n	-- Sort by age ascending.\n	table.sort(results, function(a, b)\n		return a.ageMonths < b.ageMonths\n	end)\n\n	return results\nend\n\n-- Whether there is a life here to run at all.\n--\n-- Gated on age rather than life stage: the player takes the wheel partway\n-- through Childhood, at the point they could plausibly be choosing things for\n-- themselves, not at the stage boundary years later.\nlocal function isSelfDirected(data: LifeData): boolean\n	return ageYearsOf(data) >= Config.ManualAgeUpMinAge\nend\n\n-- The earliest years run on a shorter timer because there is nothing for the\n-- player to decide while they pass. Thresholds are authored in game hours and\n-- converted here, so the day length is the only dial that moves them.\nlocal function autoThresholdSeconds(data: LifeData): number\n	local gameHours = if isSelfDirected(data) then Config.AutoAgeUpGameHours else Config.ChildAutoAgeUpGameHours\n	return gameHours * Config.Time.RealSecondsPerGameHour\nend\n\n-- Single source of truth for the manual gate. The HUD renders whatever this\n-- returns rather than re-deriving the rule, so the button can never offer an\n-- action the server would refuse.\n-- `livesLived` is passed in rather than read off the life, because it is the one thing this\n-- rule needs that is a fact about the *player* rather than the person: how many lives have\n-- been finished across every save slot. Threading it as an argument keeps this function\n-- pure and testable, and keeps the account/life split visible at the call site instead of\n-- buried behind a lookup.\nlocal function manualState(data: LifeData, livesLived: number): ManualAgeUpState\n	-- Unborn reads as Hidden exactly like dead does. The client hides the whole HUD behind\n	-- the setup menu anyway, so this is the belt to that braces: a client that failed to\n	-- hide it is holding a button the server will refuse rather than one that works.\n	if not data.alive or not Lives.HasBegun(data) then\n		return \"Hidden\"\n	end\n\n	if not isSelfDirected(data) then\n		-- Once childhood has been lived at least once, skipping the rest of it\n		-- in one action becomes the player's call. No cooldown applies: the\n		-- counter is at zero on a fresh life, which is exactly when a\n		-- returning player wants this button, and it takes priority over the\n		-- per-year one below -- somebody who has already chosen \"skip\" is not\n		-- also asking to click through five separate years to get there.\n		if livesLived >= Config.SkipChildhoodMinLives then\n			return \"SkipChildhood\"\n		end\n		-- Below the manual age is still played, not skipped -- see\n		-- ChildManualAgeUpCooldownSeconds -- but there is no shift or lesson to\n		-- sit through in these years, so a player who is done with a toddler\n		-- year is not made to wait out the same clock a working adult does.\n		if data.secondsSinceAgeUp < Config.ChildManualAgeUpCooldownSeconds then\n			return \"ChildCooldown\"\n		end\n		return \"ChildReady\"\n	end\n\n	if data.secondsSinceAgeUp < Config.ManualAgeUpCooldownSeconds then\n		return \"Cooldown\"\n	end\n	return \"Ready\"\nend\n\nlocal function pushProgress(player: Player, data: LifeData)\n	-- Looked up here rather than added to this function's signature, so that all eight call\n	-- sites stay as they were: every one of them already had the player, and none of them\n	-- had any business knowing that the skip-childhood rule reads an account-level counter.\n	--\n	-- Falls back to zero if the profile has gone, which is the safe direction -- zero lives\n	-- lived hides the skip button, and a player whose profile has unloaded mid-push should\n	-- not be handed a control that acts on a life the server can no longer see.\n	local profile = DataService.GetProfile(player)\n	local livesLived = if profile ~= nil then profile.Data.livesLived else 0\n	AgeUpProgressRemote:FireClient(\n		player,\n		data.secondsSinceAgeUp,\n		autoThresholdSeconds(data),\n		manualState(data, livesLived)\n	)\nend\n\nfunction LifeService.GetAgeYears(player: Player): number?\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return nil\n	end\n	return ageYearsOf(Lives.Active(profile.Data))\nend\n\n-- Public so the Studio debug harness can force a death without waiting on a\n-- mortality roll. Safe to call on an already-dead player: the alive check\n-- makes it a no-op, so a retried call cannot queue a second trip to the lobby\n-- or count the same life twice in `livesLived`.\nfunction LifeService.Die(player: Player)\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return\n	end\n	local dying = Lives.Active(profile.Data)\n	if not dying.alive then\n		return\n	end\n\n	dying.alive = false\n	dying.stage = \"Death\"\n	-- On the profile, not the life: it counts what the *player* has been through, and a life\n	-- that reset its own counter would put every player permanently on their first.\n	--\n	-- Incremented here rather than at the start of the next life, which is where it used to\n	-- sit, because there is no \"next life\" in this place any more. The lobby reads this number\n	-- to say which life a card is about to be, and the lobby is where the player is going.\n	profile.Data.livesLived += 1\n	-- Whatever the world was holding out for this person goes with them, rather\n	-- than sitting in the house through the death screen waiting for a collector\n	-- who is never coming.\n	DeliveryService.ResetForNewLife(player)\n	-- And they stop working, for the plainest reason available. Before the death\n	-- screen rather than with the rest of the reset below, because a shift left\n	-- running would go on paying a corpse for the length of the respawn delay.\n	WorkService.ResetForNewLife(player)\n	-- Likewise, and for the sharper version of the same reason: a lesson left running\n	-- would leave three answer pads breathing on a classroom floor through the death\n	-- screen, waiting on somebody who is not coming back to them.\n	SchoolService.ResetForNewLife(player)\n	-- Likewise: a workout in progress would leave a sweep bar frozen on\n	-- a dead body and a PUSH button that did nothing, so end it and clear\n	-- the yearly caps.\n	GymService.ResetForNewLife(player)\n	-- And the fight, which is the sharpest case of the lot. A bout left running would keep\n	-- ticking against a dead player -- an opponent still winding up, still landing strikes,\n	-- still taking footing off somebody who has no footing to lose -- and the death screen\n	-- would come up with three live buttons under it. The opponent leaves with everything\n	-- else; nothing is paid out, because the fight was not finished, it was interrupted.\n	FightService.ResetForNewLife(player)\n	-- And the room empties. Not for a mechanical reason -- nothing is left running --\n	-- but because the death screen is read over the world behind it, and a mother\n	-- standing in the doorway through her child's death would be the single worst frame\n	-- this game could draw.\n	PeopleService.ResetForNewLife(player)\n	-- And whatever was parked outside waiting for them. A dead life driving itself\n	-- around is the same frame as the room emptying above, one system further out:\n	-- the car goes back to the lot rather than sitting in the street with nobody\n	-- ever coming back to it.\n	VehicleService.ResetForNewLife(player)\n	-- And whatever was lying across the room waiting to be crawled to. Same reasoning\n	-- as the room emptying: a lit pad still inviting a dead child somewhere is a worse\n	-- frame than an empty floor.\n	ChildhoodService.ResetForNewLife(player)\n	-- And whoever was walking pocket money across the room to this person, who is no longer\n	-- there to take it. This call used to sit in the rebirth below, clearing the ledger for a\n	-- newborn; the ledger no longer needs clearing -- a new life is a new `Lives.New()` with an\n	-- empty one -- but the delivery in flight still does, and a parent finishing a walk to a\n	-- corpse is exactly the frame the rest of this teardown exists to prevent.\n	PocketMoneyService.ResetForNewLife(player)\n	pushProgress(player, dying)\n	local ribbon = VerdictService.Compute(player)\n	dying.verdict = ribbon\n	PlayerDiedRemote:FireClient(player, ageYearsOf(dying), ribbon)\n\n	-- And then they go back to the menu.\n	--\n	-- **The rebirth that used to live here is gone, and this is the change part 3 is for.**\n	-- It wound this same life back to age zero, re-rolled its gender, reset six services and\n	-- cleared `setup` so the character menu would draw itself over the town -- which meant a\n	-- player had one life at a time, ever, and the moment it ended it was overwritten by the\n	-- next one. There was no way to look back at who you had been, because nothing was kept.\n	--\n	-- Nothing is reset now. The dead life stays exactly as it died, in the slot it was lived\n	-- in, and the lobby draws it on a card as a person with a name and an age they got to --\n	-- the player deletes it when they are ready to use the slot for somebody else. All the\n	-- resets that used to run here have moved to where a life actually begins, which is the\n	-- lobby writing a new one into an empty slot: `Lives.New()` is the whole of it, because\n	-- a brand-new life has nothing to clear.\n	--\n	-- The delay is the same one it always was: long enough to read the summary. What comes\n	-- after it is a teleport instead of a newborn.\n	task.delay(Config.Death.RespawnDelaySeconds, function()\n		-- Bail out if the player's profile changed identity (e.g. rejoined), or if they have\n		-- already pressed the button on the death screen themselves. Both leave the trip to\n		-- somebody else; ReturnService's own in-flight stamp makes the second harmless anyway,\n		-- but a refusal fired at a player mid-teleport is a message onto a screen that is\n		-- already going away.\n		if DataService.GetProfile(player) ~= profile or player.Parent ~= Players then\n			return\n		end\n		ReturnService.Send(player)\n	end)\nend\n\n-- Health reaching zero is lethal the moment it happens rather than at the next\n-- birthday, otherwise a fatal injury could sit harmless for half an hour.\nlocal function killIfOutOfHealth(player: Player): boolean\n	local stats = StatService.GetStats(player)\n	if stats ~= nil and stats.health <= 0 then\n		LifeService.Die(player)\n		return true\n	end\n	return false\nend\n\n-- The one and only way age advances. Public so the debug harness drives the\n-- real path instead of a shortcut that could diverge from it.\nfunction LifeService.AgeUp(player: Player, cause: AgeUpCause)\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return\n	end\n\n	local data = Lives.Active(profile.Data)\n	if not data.alive then\n		return\n	end\n\n	-- Banked time is spent before anything else can yield: a duplicate request\n	-- arriving behind this one fails its cooldown check, so a retry (or a\n	-- client firing the remote twice) cannot buy two years for one year's wait.\n	data.secondsSinceAgeUp = 0\n	data.ageMonths += Config.Time.MonthsPerYear\n\n	local ageYears = ageYearsOf(data)\n\n	-- Chapter break: the band changed. Compute moments since the last break and\n	-- push them to the client so the reel can roll. A zero-moment break is still\n	-- fired — the client suppresses the screen when the list is empty.\n	local newBand = bandIndexOf(ageYears)\n	local lastBreakYears = data.lastChapterBreakMonths // Config.Time.MonthsPerYear\n	local lastBreakBand = bandIndexOf(lastBreakYears)\n	if newBand ~= lastBreakBand then\n		local moments = LifeService.Moments(data, {\n			sinceMonths = data.lastChapterBreakMonths,\n			maxCount = nil,\n		})\n		ChapterBreakRemote:FireClient(player, {\n			ageMonths = data.ageMonths,\n			moments = moments,\n		})\n		data.lastChapterBreakMonths = data.ageMonths\n		data.pendingEventCountInChapter = 0\n		-- Reset the world/modal ratio trackers for the new chapter, so the\n		-- 70/30 budget is enforced per chapter rather than over the whole life.\n		data.worldEventsThisChapter = 0\n		data.modalEventsThisChapter = 0\n		-- Reset autonomy points so the new chapter starts fresh: the player has\n		-- to earn every ambient event again, which is the whole point of the gate.\n		data.autonomyPoints = 0\n	end\n\n	StatService.ApplyYearlyDecay(player, ageYears)\n\n	local newStage: LifeStageId = stageForAge(ageYears)\n	if newStage ~= data.stage then\n		data.stage = newStage\n		LifeStageChangedRemote:FireClient(player, newStage)\n	end\n\n	-- A birthday is a change of body as much as a change of number: through\n	-- childhood each year buys speed, height and eventually the ability to jump.\n	BodyService.Apply(player)\n\n	-- Anything the world was still holding out belonged to the year that just\n	-- ended, so it goes with it -- and this is also what refills the year's\n	-- allowance of ambient deliveries.\n	DeliveryService.OnAgeUp(player)\n\n	-- A new year of work to be had. Deliberately does not interrupt a shift in\n	-- progress: a birthday at work is still a day at work.\n	WorkService.OnAgeUp(player)\n\n	-- And a new year of school, on the same terms -- except that this one also looks\n	-- back. A school year nobody turned up to is charged for here, because not going\n	-- is not something that happens at a place: it is something that turns out to have\n	-- happened once the year is over, and a birthday is when a year is over.\n	--\n	-- After WorkService rather than before it for no reason beyond reading order: the\n	-- two touch nothing in common, and a player cannot be at both.\n	SchoolService.OnAgeUp(player)\n\n	-- A new year of machines: the per-machine yearly caps reset, and any\n	-- workout in progress is graded on the year it started in.\n	GymService.OnAgeUp(player)\n\n	-- And a year of everybody you did not go and see. Last of the three because it is\n	-- the only one that looks purely backwards: work and school each hand out a fresh\n	-- year's allowance as well, and this hands out nothing -- it just settles up.\n	PeopleService.OnAgeUp(player)\n\n	AgeUpdatedRemote:FireClient(player, ageYears, cause)\n	pushProgress(player, data)\n\n	-- A birthday is payday too, for as long as somebody else is doing the paying.\n	--\n	-- After the age has gone out, so the balance moves against a HUD already showing\n	-- the new year -- being handed a ten-year-old's allowance while the screen still\n	-- says nine is a small lie about why the number went up. Before the death rolls,\n	-- because the birthday happened: a year that turns out to be your last still had\n	-- a birthday in it, and if it does kill you the money is cleared with everything\n	-- else a moment later anyway.\n	--\n	-- Runs on skipped years as well, and deliberately. A skipped year passes unlived\n	-- and so offers no event, but it is still a birthday, and pocket money is not a\n	-- prompt -- a childhood skipped for the second time should not also be a\n	-- childhood unpaid.\n	PocketMoneyService.OnAgeUp(player)\n\n	-- Bills are due every birthday. They run after pocket money so a life that\n	-- cannot afford them falls into debt rather than being patched over by\n	-- childhood allowance.\n	-- rather than being patched over by childhood allowance.\n	BillService.Charge(player)\n	SavingsService.CreditInterest(player)\n\n	-- Milestone age checks run after the age has moved and bills are settled, so a\n	-- life that died from debt cannot also score the longevity bonus.\n	MilestoneService.OnAgeUp(player, ageYears)\n\n	if killIfOutOfHealth(player) then\n		return\n	end\n	if rollNaturalDeath(ageYears) then\n		LifeService.Die(player)\n		return\n	end\n\n	-- One birthday's worth of sickness: recovery, then a roll for the new year. Runs\n	-- on skipped years too, and for the same reason decay does -- a skipped year is\n	-- still a year the body lives, and skipping should not let a life dodge the\n	-- recovery that is its only way off the tax.\n	progressSickness(player, data)\n\n	-- Last, so a year that killed the player never also hands them a prompt.\n	-- Skipped years pass unlived by definition, so they don't offer one either.\n	if cause == \"Skip\" then\n		return\n	end\n\n	if cause == \"Event\" then\n		-- This birthday was caused by answering an event, so offering the next\n		-- one immediately would chain prompt straight into prompt. Wait, and let\n		-- the player be a child for a moment. OfferForAge re-reads the profile,\n		-- so dying, leaving or rejoining inside the gap all resolve correctly.\n		task.delay(Config.Childhood.NextEventDelaySeconds, function()\n			-- Re-read rather than closing over ageYears: a death and respawn, or\n			-- the auto safety net, can move the age inside the gap, and the offer\n			-- has to match the age the player actually is when it lands.\n			local current = DataService.GetProfile(player)\n			if current == nil then\n				return\n			end\n			EventService.OfferForAge(player, ageYearsOf(Lives.Active(current.Data)))\n		end)\n	else\n		EventService.OfferForAge(player, ageYears)\n	end\nend\n\n-- Crosses the yearless early years in one action, for players who have already\n-- lived them at least once. It runs the ordinary per-year path rather than\n-- writing ageMonths directly, so the skipped years still decay stats and cross\n-- stage boundaries exactly as if they had been played. Bounded by construction:\n-- at most one iteration per year being skipped.\nlocal function skipChildhood(player: Player, data: LifeData)\n	for _ = 1, Config.ManualAgeUpMinAge do\n		if not data.alive or isSelfDirected(data) then\n			break\n		end\n		LifeService.AgeUp(player, \"Skip\")\n	end\n\n	-- Anything offered at the start of this life belonged to the years just\n	-- skipped, so it goes with them.\n	EventService.ClearPending(player)\n	pushProgress(player, data)\n\n	if data.alive then\n		EventService.OfferForAge(player, ageYearsOf(data))\n	end\nend\n\n-- Only time spent in the server counts toward the safety net, and the counter\n-- lives in the profile, so leaving mid-year banks progress rather than losing\n-- or farming it.\nlocal function bankPlaytime(elapsedSeconds: number)\n	for _, player in Players:GetPlayers() do\n		local profile = DataService.GetProfile(player)\n		-- The gate. A player still choosing their name banks nothing -- not a partial\n		-- second, not a health check -- so the menu can be read at whatever speed the\n		-- player reads at. This is the line that makes setup a decision rather than a\n		-- timed one.\n		if profile == nil then\n			continue\n		end\n\n		local data = Lives.Active(profile.Data)\n		if not data.alive or not Lives.HasBegun(data) then\n			continue\n		end\n		data.secondsSinceAgeUp += elapsedSeconds\n\n		if killIfOutOfHealth(player) then\n			continue\n		end\n\n		if data.secondsSinceAgeUp >= autoThresholdSeconds(data) then\n			LifeService.AgeUp(player, \"Auto\")\n		else\n			pushProgress(player, data)\n		end\n	end\nend\n\nlocal function onAgeUpRequested(player: Player)\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		-- Fired before the profile finished loading, or after it was released.\n		-- There is nothing to validate against, so refuse rather than guess.\n		return\n	end\n\n	local data = Lives.Active(profile.Data)\n	-- livesLived threaded from the profile exactly as pushProgress does it: manualState\n	-- takes it as an argument, and the account-level counter lives on the profile we\n	-- already hold here. Passing it (rather than leaving it nil) is the whole fix -- the\n	-- skip-childhood branch compares livesLived against a number, so a nil argument threw\n	-- and every age-up request died silently, stranding a freshly skipped life at age 0.\n	local state = manualState(data, profile.Data.livesLived)\n\n	if state == \"SkipChildhood\" then\n		skipChildhood(player, data)\n		return\n	end\n\n	if state ~= \"Ready\" and state ~= \"ChildReady\" then\n		-- Refused: dead, or inside whichever cooldown applies to this age.\n		-- Re-push the authoritative state so a desynced or hostile client's\n		-- button immediately snaps back to what the server actually allows.\n		pushProgress(player, data)\n		return\n	end\n\n	LifeService.AgeUp(player, \"Manual\")\nend\n\n-- The moment a life actually starts: the setup is written, so everything that was waiting\n-- on it goes.\n--\n-- Lives here rather than in SetupService because it is the tail of what a rebirth used to\n-- do inline, and splitting a life's first moment across two files by *where the trigger*\n-- came from would mean a life begun on join and a life begun after a death screen opened\n-- differently. SetupService calls it through a handler for the same reason EventService\n-- gets its age-up handler that way: requiring back the other direction closes a cycle.\nlocal function beginLife(player: Player)\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return\n	end\n	local data = Lives.Active(profile.Data)\n	local ageYears = ageYearsOf(data)\n\n	-- Re-applied even though the rebirth already did it, because the *other* way into this\n	-- function is a fresh join, where nothing has applied a body at all.\n	BodyService.Apply(player)\n	AgeUpdatedRemote:FireClient(player, ageYears, \"Sync\" :: AgeUpCause)\n	LifeStageChangedRemote:FireClient(player, data.stage)\n	pushProgress(player, data)\n\n	-- A new life opens on its first moment rather than on an empty year. This is the line\n	-- that moved out of the rebirth block: the first decision of a life now arrives after\n	-- the player has decided whose life it is.\n	EventService.OfferForAge(player, ageYears)\nend\n\nlocal function pushInitialState(player: Player)\n	local profile = DataService.WaitForProfile(player)\n	if profile == nil then\n		return\n	end\n	local data = Lives.Active(profile.Data)\n	-- Nothing to describe. A slot with no setup in it is not a life yet, and ReturnService is\n	-- already sending this player back to the lobby to fill one -- pushing an age and a stage\n	-- at them on the way out would raise a HUD over a world they are leaving.\n	if not Lives.HasBegun(data) then\n		return\n	end\n	local ageYears = ageYearsOf(data)\n	AgeUpdatedRemote:FireClient(player, ageYears, \"Sync\" :: AgeUpCause)\n	LifeStageChangedRemote:FireClient(player, data.stage)\n	pushProgress(player, data)\n\n	-- **The first moment of a life created in the lobby, and the one thing arriving here does\n	-- that a rejoin must not.** Before part 3 this line was not needed: every life was born in\n	-- this place, so `beginLife` always ran and always offered age zero. A life is now written\n	-- on the other side of a teleport, so the player walks in already begun and the opening\n	-- event has nobody to offer it.\n	--\n	-- Gated on having seen nothing and having nothing pending, which is what makes it safe to\n	-- run on *every* arrival: a player rejoining at forty has a seen list behind them, so this\n	-- does nothing, and one who disconnected mid-decision has that decision still pending and\n	-- gets it back rather than a second one. Only a life that has genuinely not started yet\n	-- passes both tests, and it can only pass them once.\n	if data.pendingEventId == nil and next(data.seenEventIds) == nil then\n		EventService.OfferForAge(player, ageYears)\n	end\nend\n\nfunction LifeService:Init()\n	RequestAgeUpRemote.OnServerEvent:Connect(onAgeUpRequested)\n	-- Handed over rather than required the other way around: EventService cannot\n	-- require this module without closing a dependency cycle.\n	EventService.SetAgeUpHandler(LifeService.AgeUp)\n	-- Same device, same reason. SetupService writes the setup and this runs the moment\n	-- after, which is the moment a life starts.\n	SetupService.SetBeginHandler(beginLife)\n	-- VerdictService needs the shared moments query but requiring it here would\n	-- close a cycle. The setter below threads it in after both modules are loaded.\n	VerdictService.SetMoments(LifeService.Moments)\nend\n\nfunction LifeService:Start()\n	Players.PlayerAdded:Connect(function(player: Player)\n		task.spawn(pushInitialState, player)\n	end)\n\n	for _, player in Players:GetPlayers() do\n		task.spawn(pushInitialState, player)\n	end\n\n	task.spawn(function()\n		while true do\n			-- task.wait returns the time that actually elapsed, so a hitching\n			-- server banks real seconds instead of drifting behind.\n			local elapsed = task.wait(Config.AgeUpProgressTickSeconds)\n			bankPlaytime(elapsed)\n		end\n	end)\nend\n\nreturn LifeService\n"
table.insert(AGES_MANIFEST, "src/server/services/LifeService.luau")
AGES_SOURCES["src/server/services/MilestoneService.luau"] = "--!strict\n-- Milestone tracking. A life crosses named thresholds -- first job, first house,\n-- ten shifts, age thirty, and so on -- and the game fires a one-time celebration\n-- with a money bonus. Each milestone is tracked in LifeData.milestones so it\n-- fires exactly once per life, resetting on death.\n--\n-- The client sees a brief flash and a banner; the server owns the trigger and\n-- the bonus. No remote is fired for the trigger itself: milestones are checked\n-- at natural decision points (age-up, shift end, house purchase) rather than\n-- on a polling loop.\n\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Config = require(ReplicatedStorage:WaitForChild(\"Config\"))\nlocal Remotes = require(ReplicatedStorage:WaitForChild(\"Remotes\"))\nlocal Types = require(ReplicatedStorage:WaitForChild(\"Types\"))\n\nlocal DataService = require(script.Parent.DataService)\nlocal Lives = require(ReplicatedStorage:WaitForChild(\"Lives\"))\nlocal MoneyService = require(script.Parent.MoneyService)\nlocal NoticeRemote = Remotes.Get(\"Notice\")\n\ntype LifeData = Types.LifeData\ntype Player = Players.Player\n\nlocal MilestoneService = {}\n\nlocal MILESTONES = Config.Milestones\nlocal MILESTONE_ACHIEVED = Remotes.Get(\"MilestoneAchieved\")\n\n-- Get the life data for a player, nil if no profile or no active life.\nlocal function lifeDataFor(player: Player): LifeData?\n	local profile = DataService.GetProfile(player)\n	if profile == nil then\n		return nil\n	end\n	return Lives.Active(profile.Data)\nend\n\n-- Check and fire a milestone if it has not been achieved this life.\n-- Returns true if the milestone was newly achieved.\nlocal function checkAndFire(player: Player, milestoneId: string, label: string, bonus: number): boolean\n	local life = lifeDataFor(player)\n	if life == nil then\n		return false\n	end\n	if life.milestones[milestoneId] == true then\n		return false\n	end\n	life.milestones[milestoneId] = true\n	MoneyService.Add(player, bonus, milestoneId .. \" milestone\")\n	NoticeRemote:FireClient(player, label .. \"! +\" .. tostring(bonus) .. \" credits\")\n	MILESTONE_ACHIEVED:FireClient(player, {\n		milestone = milestoneId,\n		label = label,\n		bonus = bonus,\n	})\n	return true\nend\n\n-- Check age milestones on birthday.\nfunction MilestoneService.OnAgeUp(player: Player, ageYears: number)\n	checkAndFire(player, \"Age30\", \"Thirty\", MILESTONES.Age30.bonus)\n	checkAndFire(player, \"Age50\", \"Fifty\", MILESTONES.Age50.bonus)\n	checkAndFire(player, \"Age80\", \"Long Life\", MILESTONES.Age80.bonus)\nend\n\n-- Check first-job milestone.\nfunction MilestoneService.OnFirstJob(player: Player, jobId: string)\n	checkAndFire(player, \"FirstJob\", \"First Job\", MILESTONES.FirstJob.bonus)\nend\n\n-- Check house purchase milestone.\nfunction MilestoneService.OnFirstHouse(player: Player)\n	checkAndFire(player, \"FirstHouse\", \"Homeowner\", MILESTONES.FirstHouse.bonus)\nend\n\n-- Check shift count milestones. Called from WorkService after a shift completes.\nfunction MilestoneService.OnShiftComplete(player: Player, totalShifts: number)\n	local life = lifeDataFor(player)\n	if life == nil then\n		return\n	end\n	life.bills.shiftsCompleted = totalShifts\n	if totalShifts >= 10 then\n		checkAndFire(player, \"TenShifts\", \"Steady Worker\", MILESTONES.TenShifts.bonus)\n	end\n	if totalShifts >= 50 then\n		checkAndFire(player, \"FiftyShifts\", \"Dedicated\", MILESTONES.FiftyShifts.bonus)\n	end\nend\n\n-- Check standing milestone. Called when standing reaches the max band.\nfunction MilestoneService.OnMaxStanding(player: Player, jobId: string)\n	checkAndFire(player, \"MaxStanding\", \"Top Performer\", MILESTONES.MaxStanding.bonus)\nend\n\nfunction MilestoneService:Init()\n	Players.PlayerAdded:Connect(function(player: Player)\n		-- No state to push on join; milestones are silent achievements.\n	end)\nend\n\nfunction MilestoneService:Start()\n	-- No background tick needed.\nend\n\nreturn MilestoneService\n"
