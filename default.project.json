{
  "name": "ages",
  "globIgnorePaths": [
    "**/*.tmp.*"
  ],
  "tree": {
    "$className": "DataModel",
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "ServerStorage": {
      "$className": "ServerStorage",
      "ProfileStore": {
        "$path": "vendor/ProfileStore"
      }
    },
    "ReplicatedStorage": {
      "$path": "src/shared"
    },
    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Technology": "Future",
        "GlobalShadows": true,
        "ClockTime": 15.5,
        "GeographicLatitude": 41.7,
        "Brightness": 2.4,
        "ExposureCompensation": 0.42,
        "Ambient": [
          0.243,
          0.247,
          0.267
        ],
        "OutdoorAmbient": [
          0.42352,
          0.43921,
          0.47843
        ],
        "EnvironmentDiffuseScale": 1,
        "EnvironmentSpecularScale": 0.85,
        "FogEnd": 4000
      },
      "Atmosphere": {
        "$className": "Atmosphere",
        "$properties": {
          "Density": 0.32,
          "Offset": 0.15,
          "Haze": 1.2,
          "Glare": 0.25,
          "Color": [
            0.79607,
            0.80784,
            0.8196
          ],
          "Decay": [
            0.42352,
            0.44705,
            0.50196
          ]
        }
      },
      "Bloom": {
        "$className": "BloomEffect",
        "$properties": {
          "Intensity": 0.5,
          "Size": 20,
          "Threshold": 1.6
        }
      },
      "SunRays": {
        "$className": "SunRaysEffect",
        "$properties": {
          "Intensity": 0.06,
          "Spread": 0.7
        }
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "Workspace": {
      "$properties": {
        "StreamingEnabled": true
      },
      "House": {
        "$path": "assets/House.rbxmx"
      },
      "Furniture": {
        "$path": "assets/Furniture.rbxmx"
      },
      "Street": {
        "$path": "assets/Street.rbxmx"
      },
      "SchoolFurniture": {
        "$path": "assets/SchoolFurniture.rbxmx"
      },
      "Town": {
        "$path": "assets/Town.rbxmx"
      },
      "City": {
        "$path": "assets/City.rbxmx"
      },
      "SpawnLocation": {
        "$className": "SpawnLocation",
        "$properties": {
          "Anchored": true,
          "Locked": true,
          "Transparency": 1,
          "CanCollide": false,
          "Position": [
            8,
            1.14,
            -21.5
          ],
          "Size": [
            4,
            0.2,
            4
          ]
        }
      },
      "Baseplate": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "Locked": true,
          "Color": [
            0.38823,
            0.37254,
            0.38823
          ],
          "Position": [
            0,
            -10,
            0
          ],
          "Size": [
            2048,
            20,
            2048
          ]
        }
      },
      "School": {
        "$path": "assets/School.rbxmx"
      },
      "Versailles": {
        "$path": "assets/Versailles.rbxmx"
      },
      "ProperSchool": {
        "$path": "assets/ProperSchool.rbxmx"
      },
      "SchoolV1Copy": {
        "$path": "assets/SchoolV1Copy.rbxmx"
      }
    }
  }
}
